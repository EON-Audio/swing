  dock_face_mode == 2 ? ( dock_face_user = 1; ) : (
    // AUTO. The dock rig, while it is running, knows which FX's canvas it
    // captured and sets slider42 on that exact instance -- a real per-instance
    // answer where the window shape only correlates with one. Gated on the
