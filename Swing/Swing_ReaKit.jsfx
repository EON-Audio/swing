// Inbound per-instance command mailboxes (IN direction, Increment D). External
// writers (bridge TCP mirror, browser, Pad-FX) post pad color/name commands
// HERE — never into the owner-published bands above. Payload first, flag LAST;
// this instance consumes in @block by zeroing the flag. Flag 1 = adopt
// silently (writer owns the undo point), 2 = adopt + mark_dirty_pad.
INST_INCMD_BASE   = 26100000;  // slot*INST_INCMD_STRIDE + region offsets
INST_INCMD_STRIDE = 1024;      // 16 slots -> 26100000..26116383 (free gap)
INCMD_COLOR_OFF   = 0;         // + pad*2: [0]=flag, [1]=hue payload 0..1
INCMD_NAME_OFF    = 64;        // + pad*34: [0]=flag(LAST), [1]=gen, [2..33]=chars
INCMD_NAME_FIELDS = 34;
// Mute/solo SET commands (Increment E): absolute 0/1 payloads. Four regions of
// 32 (16 pads * [flag,val]) starting at INCMD_MUTE_OFF, in this order:
// +0 bridge mute, +32 bridge solo, +64 sequencer mute, +96 sequencer solo —
// separate writer-origin regions keep every cell single-writer.
INCMD_MUTE_OFF     = 640;
INCMD_SOLO_OFF     = 672;
INCMD_SEQ_MUTE_OFF = 704;
INCMD_SEQ_SOLO_OFF = 736;
// P4 — note/output/reverse cells (browser-origin; every writer is a user
// action so flag is always 2 = adopt + mark_dirty_pad). REVERSE is the one
// TOGGLE-semantics cell (payload ignored): reverse has no published band
// field to diff a SET against, and a lost toggle is visible + re-clickable.
INCMD_NOTE_OFF = 768;   // + pad*2: [0]=flag, [1]=MIDI note 0..127
INCMD_OUT_OFF  = 800;   // + pad*2: [0]=flag, [1]=output pair 0..15
INCMD_REV_OFF  = 832;   // + pad*2: [0]=flag, [1]=unused (toggle)
// SFZ-import fidelity: SET per-pad params the CMD-63 audio load doesn't carry.
INCMD_TUNE_OFF = 864;   // + pad*2: [0]=flag, [1]=semitones -24..24
INCMD_GAIN_OFF = 896;   // + pad*2: [0]=flag, [1]=linear gain 0..8
INCMD_PAN_OFF  = 928;   // + pad*2: [0]=flag, [1]=pan -1..1
INCMD_LMODE_OFF= 960;   // + pad*2: [0]=flag, [1]=layer mode 0..3 (RS5k import)
// Lane color ownership view cells (per-slot, NOT per-pad; source of truth is
// P_EXT on the track, bridge-owned — nothing serialized here):
//   PUB (bridge->us, republished each identity pass): 0=unpublished,
//       1=swing 2=reaper 3=none. REQ (us->bridge): [+0]=flag LAST, [+1]=mode.
INCMD_LANEPOL_PUB = 992;
INCMD_LANEPOL_REQ = 994;
KIT_GMEM_INSTANCE_NEXT = 94;  // monotonic counter for new instance_id allocation
                              // (replaces time_precise() which had a 10µs collision window)
KIT_COPY_CHUNK       = 200000; // samples per frame during audio copy
