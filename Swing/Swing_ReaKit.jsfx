  cat_ov_pad >= 0 ? swing_catov_draw() :
  pk_ov_pad >= 0 ? swing_notepick_draw() :
  big_view_id == VIEW_CONSOLE ? swing_panels_draw_mixer_big() :
  big_view_id == VIEW_MAPPING ? swing_mapping_draw() :
  big_view_id == VIEW_COLORS ? swing_ui_colors_draw() :
  big_view_id == VIEW_OUTPUTS ? swing_ui_outputs_draw() :
  big_view_id == VIEW_EQ ? swing_panels_draw_eq_big() :
