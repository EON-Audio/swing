  swing_pne_draw();

  // ── Right-click macro assign result (caller 35) ──
  // The menu was opened by swing_lcd_kmac_open_assign with the pending
  // target in kmac_asn_pad/pid; result 1..8 = the picked macro. Default
  // range = [current value .. full-scale end] (spec §2), same as ADD.
  swing_popup_result > 0 && swing_popup_result <= KMAC_N &&
  swing_popup_caller_id == SP_POPUP_CALLER_MACRO_ASSIGN ? (
    kmac_nmap[swing_popup_result - 1] < KMAC_MAX_MAP ? (
      swing_macroed_pid_range(kmac_asn_pid);
      swing_macroed_add_map(swing_popup_result - 1, kmac_asn_pad, kmac_asn_pid,
        swing_macroed_get(max(0, kmac_asn_pad), kmac_asn_pid), kmac_ed_pmax);
      macro_sel = swing_popup_result - 1; slider_automate(2^40);
      mark_dirty_kit();
      kmac_force = 1;
    );
    swing_popup_result = 0;  // mark consumed
  );

  // ── Bank tab menu (Pad Banks step 4c; opened by swing_banktabs_input on a tab right-click) ──
  // Rows: 1 header, 2 load a kit into this bank (the kits view with an INTO target), 3 save this bank as a
  // one-bank kit (GS_KIT_EXPORT_ONLY before the same CMD 10 the SAVE menu posts), 4 clear this bank (select it,
  // then the CLEAR confirm), 5 clear all four banks (the CLEAR confirm with _undo_clear_banks up).
  swing_popup_result > 0 && swing_popup_caller_id == SP_POPUP_CALLER_BANK_TAB ? (
    resp = swing_popup_result;
    swing_popup_result = 0;
    _btb = banktabs_menu_bank;
    _btb >= 0 && _btb < NUM_BANKS ? (
      resp == 2 ? ( swing_kitsview_open(); kv_into = _btb + 1; );
      resp == 3 ? (
        (kit_busy || gmem[KIT_GMEM_CMD] != 0 || gmem[GS_KIT_LOAD_REQ] == 2 || gmem[KIT_GMEM_BRIDGE_ALIVE] <= 0) ? (
          kit_bridge_warn = 1;
        ) : (
          gmem[GS_KIT_EXPORT_ONLY] = _btb + 1;
          kit_export_only = _btb + 1;   // audit S7: the name and the completion are this bank's, not the instrument's
          gmem[KIT_GMEM_LOCK] = instance_id;
          gmem[KIT_GMEM_CMD]  = 10;
          kit_export_state = 10;
          kit_busy = 1;
        );
      );
      resp == 4 ? (
        swing_banktabs_select(_btb); _undo_clear_banks = 0;
        swing_popup_open(mx, my, "Clear this bank's 16 pads (keep kit name + FX)?", SP_POPUP_CALLER_CLEAR_PADS);
      );
      resp == 5 ? (
        _undo_clear_banks = 1;
        swing_popup_open(mx, my, "Clear ALL FOUR banks -- 64 pads (keep kit name + FX)?", SP_POPUP_CALLER_CLEAR_PADS);
      );
    );
    banktabs_menu_bank = -1;
  );
  swing_popup_result == -1 && swing_popup_caller_id == SP_POPUP_CALLER_BANK_TAB ? (
    swing_popup_result = 0; banktabs_menu_bank = -1;
  );

  // ── Rack-header popup results: SAVE menu + MULTI build menu ─────────────
  // The rack face opens these from swing_ui_draw_rack_header; the results
  // are consumed HERE — after every import — so swing_panels_multiout_prep
  // resolves at definition time and the picks work in BOTH faces. In the
  // full UI, rk_swing_ui_panels_controls' identical consumers run earlier in
  // the frame and zero the result before this point. KEEP the two sites IN
  // STEP with rk_swing_ui_panels_controls (SAVE_KIT ~:372, DM_BUILD ~:1364).
  swing_popup_result > 0 && swing_popup_caller_id == SP_POPUP_CALLER_SAVE_KIT ? (
    resp = swing_popup_result;
    swing_popup_result = 0;
    (kit_busy || gmem[KIT_GMEM_CMD] != 0 || gmem[GS_KIT_LOAD_REQ] == 2) ? (
      kit_bridge_warn = 1;
      resp = 0;
    );
    resp == 1 ? (
      gmem[KIT_GMEM_LOCK] = instance_id;
      gmem[KIT_GMEM_CMD]  = 10;
      kit_export_state = 10;
      kit_busy = 1;
    );
    resp == 2 ? (
      gmem[KIT_GMEM_LOCK] = instance_id;
      gmem[KIT_GMEM_CMD]  = 15;
      kit_export_state = 10;
      kit_busy = 1;
    );
    resp == 3 ? (
      gmem[KIT_GMEM_LOCK] = instance_id;
      gmem[KIT_GMEM_CMD]  = 19;
      kit_export_state = 10;
      kit_busy = 1;
    );
    resp == 4 ? (
      gmem[KIT_GMEM_LOCK] = instance_id;
      gmem[KIT_GMEM_CMD]  = 21;
      kit_export_state = 10;
      kit_busy = 1;
    );
  );
  swing_popup_result == -1 && swing_popup_caller_id == SP_POPUP_CALLER_SAVE_KIT ? (
    swing_popup_result = 0;
  );
  swing_popup_result > 0 && swing_popup_caller_id == SP_POPUP_CALLER_DM_BUILD ? (
    resp = swing_popup_result;
    swing_popup_result = 0;
    resp == 1 ? (
      gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? (
        gmem[KIT_GMEM_CMD] == 0 ? ( gmem[KIT_GMEM_LOCK] = instance_id; gmem[KIT_GMEM_CMD] = 77; );
      ) : ( kit_bridge_warn = 1; );
    );
    resp == 2 ? (
      gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? (
        gmem[KIT_GMEM_CMD] == 0 ? ( gmem[KIT_GMEM_LOCK] = instance_id; gmem[KIT_GMEM_CMD] = 73; );
      ) : ( kit_bridge_warn = 1; );
    );
    resp == 3 ? (
      gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? (
        gmem[KIT_GMEM_LOCK] == 0 || gmem[KIT_GMEM_LOCK] == instance_id ? (
          swing_panels_multiout_prep();
          gmem[KIT_GMEM_CMD] = 40; kit_import_state = 1; kit_busy = 1;
        ) : ( kit_bridge_warn = 2; );
      ) : ( kit_bridge_warn = 1; );
    );
    resp == 4 ? (
      gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? (
        gmem[KIT_GMEM_LOCK] == 0 || gmem[KIT_GMEM_LOCK] == instance_id ? (
          swing_panels_multiout_prep();
          gmem[KIT_GMEM_CMD] = 74; kit_import_state = 1; kit_busy = 1;
        ) : ( kit_bridge_warn = 2; );
      ) : ( kit_bridge_warn = 1; );
    );
  );
  swing_popup_result == -1 && swing_popup_caller_id == SP_POPUP_CALLER_DM_BUILD ? (
    swing_popup_result = 0;
  );

  // ── Custom popup menu (rk_swing_popup.jsfx-inc) ──
  // Drawn LAST so it sits above everything else, including the tooltip.
  // Reads _raw_lmb_down / _raw_LMB preserved by swing_ui_modal_gate.
  thm_draw();      // THEME menu panel — under its own open row list, over the content
  swing_popup_tick();
  rkth_overlay_draw();   // EON theme dropdown (shared widget) — painted last, above everything
);

// Release GUI-held pad on mouse-up. The raw button (swing_ui_modal_gate keeps
// _raw_LMB every frame), not the gated copy: under a modal the gate zeroes LMB, so
// a pad held into a popup never released (D-5).
gui_held_pad >= 0 && !_raw_LMB && time_precise() >= seq_ui_tap_until ? (   // seq_ui_tap_until: a step-menu "hear the pad" holds the pad ~120 ms (rk_seq_ui)
  // When effective one-shot is OFF (gate mode), release voices on mouse-up
  _eos = p_oneshot[gui_held_pad];
  (_eos == 0 || (_eos < 0 && !oneshot_global)) ? (
    // Posted, not performed: @block ends the pad's voices at the block's end
    // (swing_block_gt_release), so the UI thread writes no voice cell (A-9b).
    // The loop this replaces once shared the bare `i` with @sample's channel
    // loops and overran _xf_prev into udo_fs (A-8, Audit A 2026-09-14).
    swing_gt_post_release(gui_held_pad);
  );
  p_held[gui_held_pad] = 0;
  gui_held_pad = -1;
);

frame_wheel = 0;
// Internal PARAM undo: mouse-UP edge (prev_LMB still holds last frame here) —
// push one undo entry per pad edited during the just-finished gesture. The raw
// button again (D-5): a gesture that ends under a modal committed nothing.
(prev_LMB && !_raw_LMB) ? undo_commit_gesture();
// The wheel / right-button bracket commits once 0.3 s pass without a notch (D-9).
_udo_nl_t > 0 && !_raw_LMB && time_precise() - _udo_nl_t > 0.3 ? ( undo_commit_gesture(); _udo_nl_t = 0; );

// Per-surface press latches (D-3): mouse_cap goes back into THIS pass's
// surface latch, and into prev_LMB / prev_RMB as before.
swing_srf_store();
last_mouse_cap = mouse_cap;


); // end gfx_frame_count > 2 guard
