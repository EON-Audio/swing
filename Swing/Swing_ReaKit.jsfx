GS_TRACK_NUM      = 1442;     // bridge → browser: 1-based track number of Swing instance
GS_TARGET_FX_IDX  = 1438;     // bridge → browser: 0-based FX-chain index, disambiguates stacked Swings on the same track (note: 1438 was previously unused — slot between BROWSE_PAD and PATH_LEN)
GS_PAD_TRIGGER    = 1443;     // browser → JSFX: trigger pad playback (-1 = none)
