desc: Swing
tags: instrument, sampler, drums
author: EON Studios
// version: STAYS "3.0" in source on purpose -- deploy.sh stamps the PUBLISHED
// copy from index.xml (release_index.py --print-version), cross-checks
// EON_UpdateCheck.lua's CURRENT_VERSION and aborts on a mismatch. index.xml is
// the single source of truth; a hand-edit here is overwritten at deploy. Three
// external auditors have read source-vs-index as version drift -- it is not.
version: 3.0.19

slider1:root_note=36<0,127,1>-Base Note
slider2:master_db=0<-48,12,0.1>-Master Volume (dB)
// slider3 + slider6..slider21 are hidden COUNTERS that increment on
// every parameter change. REAPER captures the FX chunk for undo only
// when a slider VALUE actually changes; coalesces multiple changes to
// the SAME slider within ~1s into one undo entry. Different sliders
// → separate undo entries even when rapid.
//
// Architecture:
//   slider3        → global / master / non-pad changes (master VOL,
//                     repeat division, master FX, color palette, etc.)
//   slider6..21    → one per pad (pad 1 → slider6, pad 16 → slider21).
//                     Mute pad 1 + solo pad 3 + vol pad 12 = three
//                     different sliders → three separate undo entries.
//
// The mark_dirty() / mark_dirty_pad(idx) wrappers in
// rk_swing_core.jsfx-inc do the increment + slider_automate.
slider3:changed=0<0,1000000,1>-Dirty: Global (internal)
slider4:instance_id=0<0,99999999,1>-Instance ID (internal)
slider5:hi_quality_interp=1<0,1,1>-High-Quality Interp (cubic)
slider6:dirty_p1=0<0,1000000,1>-Dirty: Pad 1 (internal)
slider7:dirty_p2=0<0,1000000,1>-Dirty: Pad 2 (internal)
slider8:dirty_p3=0<0,1000000,1>-Dirty: Pad 3 (internal)
slider9:dirty_p4=0<0,1000000,1>-Dirty: Pad 4 (internal)
slider10:dirty_p5=0<0,1000000,1>-Dirty: Pad 5 (internal)
slider11:dirty_p6=0<0,1000000,1>-Dirty: Pad 6 (internal)
slider12:dirty_p7=0<0,1000000,1>-Dirty: Pad 7 (internal)
slider13:dirty_p8=0<0,1000000,1>-Dirty: Pad 8 (internal)
slider14:dirty_p9=0<0,1000000,1>-Dirty: Pad 9 (internal)
slider15:dirty_p10=0<0,1000000,1>-Dirty: Pad 10 (internal)
slider16:dirty_p11=0<0,1000000,1>-Dirty: Pad 11 (internal)
slider17:dirty_p12=0<0,1000000,1>-Dirty: Pad 12 (internal)
slider18:dirty_p13=0<0,1000000,1>-Dirty: Pad 13 (internal)
slider19:dirty_p14=0<0,1000000,1>-Dirty: Pad 14 (internal)
slider20:dirty_p15=0<0,1000000,1>-Dirty: Pad 15 (internal)
slider21:dirty_p16=0<0,1000000,1>-Dirty: Pad 16 (internal)
slider22:midi_thru=0<0,1,1>-MIDI Pass-Through (forward notes to next FX)
slider23:map_override_locked=0<0,1,1>-MAP Override Locked Pads (internal; persists via FX chunk, no @serialize touch)
slider24:fx_returns=0<0,1,1>-Multi-out FX Returns (internal; set by bridge build; persists via FX chunk, no @serialize touch)
slider25:pad_icon_mode=0<0,1,1>-Pad Face (internal; 0=waveform 1=category icon; persists via FX chunk, no @serialize touch)
slider26:embed_show_icons=0<0,1,1>-Embedded Icons (internal; embedded view = glyph-only when on; EMBED menu toggle; persists via FX chunk, no @serialize touch)
slider27:pad_vol_style=0<0,18,1>-Pad VOL Knob Style (internal; 0=follow theme; persists via FX chunk, no @serialize touch)
slider28:pad_vol_appear=0<0,9,1>-Pad VOL Knob Colour (internal; 0=theme 1..6=preset 7=follow pad 8=black 9=white; persists via FX chunk, no @serialize touch)
slider29:pad_pan_style=0<0,18,1>-Pad PAN Knob Style (internal; 0=follow theme; persists via FX chunk, no @serialize touch)
slider30:pad_pan_appear=0<0,9,1>-Pad PAN Knob Colour (internal; 0=theme 1..6=preset 7=follow pad 8=black 9=white; persists via FX chunk, no @serialize touch)
slider31:adsr_3node=0<0,1,1>-ADSR 3-Node Display (internal; hides the S node, D node carries sustain on its Y axis; display-only — all four engine params stay live; persists via FX chunk, no @serialize touch)
// Kit macros (Spec_Swing_Macro_System §1). Hidden from the slider UI per
// house rule but full host params: automatable, MIDI-learnable, hardware-
// mappable. "Macro 1".."Macro 8" are the STABLE host-param API — display
// names live in the mapping model, never here. Resolve BY NAME on any
// external path (sparse-slider hazard). Values 0..1; each mapping scales
// into its target's native units. macro_morph/macro_sel are inert until the
// snapshot slice lands.
slider32:macro1=0<0,1,0.001>-Macro 1
slider33:macro2=0<0,1,0.001>-Macro 2
slider34:macro3=0<0,1,0.001>-Macro 3
slider35:macro4=0<0,1,0.001>-Macro 4
slider36:macro5=0<0,1,0.001>-Macro 5
slider37:macro6=0<0,1,0.001>-Macro 6
slider38:macro7=0<0,1,0.001>-Macro 7
slider39:macro8=0<0,1,0.001>-Macro 8
slider40:macro_morph=0<0,7,0.001>-Macro Morph
slider41:macro_sel=0<0,7,1>-Macro Select (internal; strip/editor focus; persists via FX chunk, no @serialize touch)
slider43:patch_on=0<0,1,1>-Wired (internal; the Patchbay loopback mode, set by the bridge; persists via FX chunk, no @serialize touch)
slider44:patch_tap=0<0,1,1>-Wired tap point (internal; 0 = on the channel: a pad leaves pre-pan, pan and sends applied on return; 1 = on the bus: post-pan, what a child track hears; a pad on a bank pair is post-pan either way; persists via FX chunk)
slider42:0<0,1,1{Free,Docked}>--EON Rig Docked (set by the dock rig script, not by hand; only honoured while GS_RIG_ALIVE is fresh)
slider45:name_bar=0<0,1,1>-Name bar (internal; the THEME menu's NAME BAR row; 0 = borderless embed, house rule 1; persists via FX chunk, no @serialize touch)
slider46:hover_mode=0<0,3,1>-Knob hover (internal; the THEME menu's HOVER row; the LIBRARY's encoding, not the menu's -- 0 = Normal, 1 = None, 2 = Moderate, 3 = Dramatic; persists via FX chunk, no @serialize touch)
slider47:bank_col_set=1<0,5,1>-Bank Colours (internal; the THEME menu's BANK COLOURS row; 0 = Off, 1 = Classic, 2 = Hardware, 3 = Warm to cool, 4 = Studio muted, 5 = Neon; persists via FX chunk, no @serialize touch)

// options:gmem=Swing_Media_Transfer is REQUIRED — the Lua bridge plus
// a dozen Drum Matrix / Sample Browser scripts all call
// reaper.gmem_attach("Swing_Media_Transfer") and depend on Swing JSFX
// writing to that exact named segment. Removing it breaks kit loading,
// browser sync, multi-out build, and everything else the bridge does.
//
// C++ Extension side: the earlier Lua-vs-C++ gmem "different views" problem
// (Lua saw JSFX writes, C++ didn't) was the eel_gmem_attach vs public
// gmem_attach API mismatch — RESOLVED by moving the Extension onto the public
// gmem_attach/read/write API (2026-05-25). The Part B pitch bridge is now LIVE:
// the Extension reads the SP_* bands and drives élastique (Repitch/Tuned/
// Stretch). Plugin-alone (no DLL) still works fully — all three modes collapse
// to today's resident-buffer resampler, settings persist, UI is unchanged.
// maxmem NOTE, corrected 2026-09-23. It sat at 72000000 from 2026-06-29 because
// writes above ~72M seemed to vanish between frames under an 80M or 128M request.
// They vanished because they were written PAST THE GRANT: the July test aimed at
// the 134M clamp while asking for less, and EEL2 hands every address past the
// grant one shared dummy cell that reads back in the same frame and is gone at
// the next write. The Sept probe (f87d688c, EON_Probe_PageBacking) measured the
// 128M grant itself: 29 of 29 pages from 72M to 128M survive to frame 500. So
// the request is 128000000 and the pad-audio pool is AUDIO_AREA = 104M (116M
// until the undo backup grew with the 45 s layers, the same day); what
// stands is the RULE -- nothing may live above the backed top, and EEL2's memcpy
// silently stops at the first unbacked cell -- and Swing now measures that top
// itself at @init (rk_swing_alloc swing_alloc_backing_scan): a machine that
// cannot back the grant gets a smaller pool and an LCD notice, not silent pads.
// want_all_kb (2026-08-04, in-place pad rename): NOT a hard keyboard grab —
// it only PRE-CHECKS the per-instance "Send all keyboard input to plug-in"
// FX-menu toggle (the WAK chunk line) on fresh inserts. Saved projects keep
// their own WAK state, so nothing changes for existing sessions; new inserts
// get space + ctrl-combos delivered to the rename editor. Measured matrix:
// .dev_tests/kbprobe_default.jsfx header.
options:gmem=Swing_Media_Transfer,maxmem=128000000,no_meter,gfx_hz=60,gfx_idle,want_all_kb

