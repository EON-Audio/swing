// order 0 BG, 1 PANEL, 2 TEXT, 3 TEXT_DIM, 4 ACCENT, 5 ACCENT2, 6 GRID, 7 BORDER.
GS_THEME_ID   = 2649;
GS_THEME_BASE = 2650;
GS_THEME_REQ  = 2674;  // theme selector → bridge: 0 none; 1 eon,2 dark,3 light,4 reaper
GS_THEME_CUR  = 2675;  // bridge → selector: active theme index (1..4) for highlight
GS_THEME_KNOB_P = 2676; // active theme knob-style index (Swing pad knobs morph to it; master stays native)
GS_THEME_KNOB_REQ = 2696; // KNOB button → bridge: 0 none; else (style_index+1). Bridge writes eon_knob_<theme> ExtState + republishes GS_THEME_KNOB_P. Free gap above role band (2678..2695), below StepSeq M/S (2700)
GS_DM_PAINT = 2697; // bridge → JSFX: Drum Matrix paint-mode state (1=on) mirrored from ExtState EON_DRUM_MATRIX/paint_mode; PAINT button reads it for its lit state
GS_DM_OVERLAY = 2698; // bridge → JSFX: Drum Matrix overlay running (1=singleton lock fresh); GRID button reads it for its lit state
GS_TOOLBAR_OPEN = 2699; // bridge → JSFX: EON toolbar open (1=open); header TOOLBAR chip reads it for its lit colour
GS_DOCK_LAYOUT_REQ = 2645; // wordmark menu → bridge: dock-rig layout pick, 1-based index into EON Dock Layout.lua's LAYOUTS (consume-to-0, GS_THEME_REQ pattern)
// ── DOCK RIG LIVENESS ───────────────────────────────────────────────────────
// GS_RIG_ALIVE: the pane scripts (EON Swing Dock.lua / EON Steppa Dock.lua)
// stamp time_precise() here every tick while they are running. Claimed 2026-08-26
// out of the retired 2626-2644 run (old FX pub, moved to 26090000).
//
// It exists to gate the PER-INSTANCE flag, not to carry it. The pane script sets
// a slider on the exact FX whose canvas it captured, which is the only signal
// that can distinguish "this instance is in the dock" from "some instance is" --
// but a slider lives in the FX chunk, so a REAPER crash mid-capture would leave
// a floated window pinned to the dock face forever. Honouring that flag only
// while the rig is demonstrably alive makes the stale case impossible: no
// script, no heartbeat, no dock face.
GS_RIG_ALIVE = 2626;
// ⚠️ ...except 2626 means "SOME pane is up" -- the Steppa pane stamps it too.
// So the stale case above was NOT impossible: with Steppa's pane running and
// ours not, a slider42 left at 1 read as docked, the wordmark posted POP to a
// pane that was not there, and the click did nothing at all (2026-08-30, from
// an EON Dock Debug trace carrying only Steppa lines). GS_RIG_ALIVE_SWING is
// stamped ONLY by EON Swing Dock.lua, so it answers "is OUR pane up". Every
// slider42 gate reads this one; 2626 keeps its documented meaning.
// Protocol row 2633, claimed 2026-08-30 out of the retired 2635-2644 run.
GS_RIG_ALIVE_SWING = 2633;
// Dock toggle relay (2026-08-26; .refs protocol doc rows 2627-2632). POP is
// consumed by EON Swing Dock.lua (it just re-shows our float; its handoff
// watcher restores the canvas and closes the pane); REDOCK by the bridge
// (eon_redock_tick), which selects our track and launches/reuses the pane.
// The ID payload is written BEFORE the REQ bump (mailbox rule).
GS_POP_REQ_SWING    = 2627;
GS_REDOCK_REQ_SWING = 2629;
GS_REDOCK_ID_SWING  = 2630;
GS_SSWIN_BASE   = 26030000; // StepSeq courier SYNC band base (shared gmem map with EON_StepSeq.jsfx)
GS_SSWIN_STRIDE = 64;       //   per registry slot; field 52 = bridge-published "this track's StepSeq
GS_SSWIN_OPEN   = 52;       //   float window is open" — the STEP SEQ button reads it for its lit state
GS_AUDIO_REPAIR_REQ = 1434;  // JSFX → bridge: instance_id needs sidecar reload (audio truncated by chunk size limit on Undo/chunk restore); 0 = no request
GS_WINDOW_W       = 1435;
GS_WINDOW_H       = 1436;
GS_BROWSE_PAD     = 1437;
GS_BROWSER_PATH_LEN = 1439;   // browser sample path length (chars)
GS_BROWSE_LAYER   = 1441;     // layer index for CMD 64 (browser layer load)
GS_PAD_SELECT_REQ = 1440;     // browser → JSFX: pad selection request (-1 = none)
GS_TRACK_NUM      = 1442;     // bridge → browser: 1-based track number of Swing instance
GS_TARGET_FX_IDX  = 1438;     // bridge → browser: 0-based FX-chain index, disambiguates stacked Swings on the same track (note: 1438 was previously unused — slot between BROWSE_PAD and PATH_LEN)
GS_PAD_TRIGGER    = 1443;     // browser → JSFX: trigger pad playback (-1 = none)
GS_KIT_LOAD_REQ   = 1444;     // browser kit load: 0=idle, 1=request, 2=data ready
GS_BROWSE_NAME_ADOPT = 2249;  // requester → CMD-63: adopt the staged PADNAME as the pad
                              // name (consume-once; ④ FILL kit-name display). 2248..2255
                              // gap verified free 2026-07-24 (GS_KIT_LOAD_MODE=2248).
gmem[GS_PAD_SELECT_REQ] = -1;  // no pending pad selection from browser
gmem[GS_PAD_TRIGGER]    = -1;  // no pending pad trigger from browser
GS_BROWSER_PATH   = 1450;     // browser sample path chars (260 max: 1450–1709)
GS_BROWSER_PATH_MAX = 260;
GS_COMPANION_CMD  = 1710;     // companion script command (0=idle, 3=toggle lock, 4=new kit, 5=adopt multi-out, 6=leave multi-out)
GS_COMPANION_TARGET = 2250;   // instance_id the companion cmd is FOR; 0 = broadcast (legacy
                              // writers). The consumer gates on it — without this, the cmd is
