// Companion / update system
GS_SWING_ALIVE      = 1711;     // heartbeat counter (Lua detects changes)
GS_UPDATE_REQUEST   = 1712;     // JSFX → Lua: 1=check now, 2=open download URL
GS_UPDATE_STATE     = 1713;     // Lua → JSFX: 0=idle, 1=checking, 3=update available
// 1714-1718 free since 2026-09-20 (a 5-char version band, never read here).
GS_MEDIA_EXPLORER_OPEN = 1719;  // bridge → JSFX: 1 if REAPER Media Explorer is open

// Audio-only reload flag — bridge → JSFX. Set to 1 by the bridge for a
// project-open sidecar auto-load OR an Undo/chunk-restore audio-repair
// reload (both run AFTER @serialize has already restored the live per-pad
// state). When 1, the kit-import state machine snapshots the live params on
// entry and restores them after the audio copy, so the kit file's stored
// values (e.g. Tuned tune=0, kit-author globals) can't clobber the user's
// session. Cleared to 0 by the JSFX at end of import and defaulted to 0 by
// the bridge for normal user-initiated loads.
// RELOCATED 2026-07-08 from 2274: that "free gap" cell doubles as the old
// SP_PITCH_DIAG_TICK_COUNT, and the deployed extension build still
// increments it every audio block — the flag read PERMANENTLY nonzero, so
// every kit load on a deserialized instance silently became a preserve
// reload: pre-load params (incl. poisoned/stale pad state from the project
// chunk) were restored OVER the freshly imported kit. That is the bug-B
// stickiness (pad-0 mute=1/out=52 surviving every clean load). New home =
// the verified-free 2609xxxx gap, after GS_PAD_RANGE_BASE (26090200-215).
// Keep in sync with rk_lua_core.lua GMEM.GS_KIT_PRESERVE_LIVE.
GS_KIT_PRESERVE_LIVE = 26090216;

// Undo/redo button state (bridge polls REAPER's Undo_CanUndo2/CanRedo2
// and publishes here; JSFX reads for tooltip display + button enable).
GS_UNDO_DESC      = 2276;       // 128-char string: next-undo description
GS_UNDO_DESC_LEN  = 128;
GS_REDO_DESC      = 2406;       // 128-char string: next-redo description
GS_REDO_DESC_LEN  = 128;
GS_UNDO_AVAIL     = 2536;       // 1 = undo available, 0 = stack empty
GS_REDO_AVAIL     = 2537;       // 1 = redo available, 0 = stack empty

// Live per-pad effective-mute state (mute OR (any_solo && !solo)). JSFX
// writes from @gfx every frame; browser reads to dim muted pads. 16 slots,
// one per pad: 1 = muted-effective, 0 = audible.
GS_PAD_MUTED_BASE = 2538;       // 2538..2553

// Pending kit-load target — set by the requesting instance when firing
// CMD 22, so the GS_KIT_LOAD_REQ=2 receive handler routes the kit data
// only to that instance. Decoupled from KIT_GMEM_INSTANCE (browser
// target) so an auto-load on a freshly-inserted instance can't hijack
// the user's browser-target pick.
GS_PENDING_LOAD_INST = 2554;

// B1b — per-instance Tuned injection selector. The bridge writes the TARGET
// registry slot here right before firing a pad-audio swap (CMD 65) for a baked
// WAV; we consume the swap only when _reg_my_slot matches, so several live
// instances can run Tuned without grabbing each other's staged audio.
GS_PENDING_PITCH_INST = 2555;

// ─── Instance Registry ────────────────────────────────────────────────
// Each Swing instance owns a slot here, written EVERY @block. Two
// purposes: (1) fresh instances detect inst_id collisions at @init by
// checking who's already registered with a recent heartbeat — fixes the
// FX-duplicate case where slider4 carries over from the source. (2) The
// browser reads this list to know which Swings are alive, then does its
// own one-shot track scan to map inst_id → track/fx for display.
//
// JSFX cannot query its own track number or FX-chain index, so those
// stay browser-side. The registry holds only data the JSFX itself can
// produce: id, heartbeat, and self-reported display fields.
//
// Layout: 16 slots × 4 floats = 64 floats (2556..2619)
//   +0  inst_id    (slider4 of the owning instance)
//   +1  heartbeat  (time_precise() — staleness detection)
//   +2  pad_count  (count of pads with audio — display)
//   +3  kit_hash   (cheap kit-name hash — display refresh trigger)
GS_INST_REG_BASE   = 2556;
GS_INST_REG_STRIDE = 4;
// Pad Banks step 5a: the bank on screen (0..3), one cell per registry slot -- the companions' way to know
// which bank the sixteen-wide bands carry. The registry's four cells are all taken and the band is packed
// against its neighbour, so it has its own home right after the command bus. Written by @block with the
// registry fields, and at once by swing_banktabs_select / swing_select_pad (a build posted in the same
// frame as a switch must not read the old bank).
GS_INST_BANK_CUR   = 26090352;   // + slot, 16 cells (26090352..26090367)
GS_INST_REG_MAX    = 16;
GS_INST_REG_TIMEOUT = 3.0;   // seconds — slots silent longer than this are reused
GS_INST_REG_SETTLE  = 0.05;  // seconds an @block claim's id must survive before the slot is used

// ─── EON_DRAG: browser drag-over, BROADCAST + self-identifying CLAIM ─────
// Synthetic drag from Swing_Browser onto the pad grid (an ImGui drag never
// becomes an OLE drop, so gfx_getdropfile can't see it — the browser tracks
// the gesture itself and mails the cursor here instead).
//
// v2 inverts the identification. v1 asked Lua "which instance owns the window
// under the cursor?", answerable only via TrackFX_GetFloatingWindow — so an
// instance sitting in the FX CHAIN (what you get the moment you insert one)
// could never be a drop target. Now the browser BROADCASTS the cursor's
// client position once and every instance answers "is that me?" from its own
// mouse_x/mouse_y. Probe-measured 2026-07-31: those keep tracking the cursor
// OUTSIDE the window (observed mouse_y = -56), and @gfx runs for a
// chain-hosted FX — so a non-hovered instance can reliably stay silent.
// Same OS cursor + same client rect ⇒ the true window's mouse_x/mouse_y
// EQUAL the broadcast coords; an overlapping window at a different origin
// gets different values and does not claim.
//   BROADCAST (browser→all): +1 x, +2 y (client px), +3 w, +4 h, +5 count,
//                            +6 mode, THEN +0 stamp (time_precise) LAST.
//   CLAIM (instance→browser, at CLAIM_BASE + own registry slot × 4):
//                            +0 pad (-1 none), +1 instance_id,
//                            THEN +2 stamp echo LAST.
//
// Two modes, because an EMBEDDED instance (TCP/MCP) cannot be matched on
// coordinates at all: its mouse_x/mouse_y are relative to the embed rect and
// gfx_w/gfx_h ARE that rect, neither of which the browser can compute — an
// embedded UI is painted into REAPER's own panel, it owns no window.
//   MODE_PRECISE: the cursor is over a real jsfx_gfx surface; the browser
//     sends its client coords + size and only the instance whose own
//     mouse_x/y and gfx_w/h match claims. Floating / FX-chain.
//   MODE_BLIND:   the cursor is over REAPER but not over any jsfx_gfx window;
//     x/y/w/h are meaningless. An EMBEDDED instance claims purely on its own
//     pointer being in bounds. Embedded strips never overlap, so exactly one
//     answers. ⚠️the browser must confirm the cursor is over REAPER first —
//     an embedded instance's mouse_x/y track the screen even when occluded,
//     so a blind broadcast while hovering another app would let a hidden
//     instance claim.
EON_DRAG_BASE       = 26251264;  // broadcast block, 16 cells reserved
EON_DRAG_OFF_STAMP  = 0;
EON_DRAG_OFF_X      = 1;
EON_DRAG_OFF_Y      = 2;
EON_DRAG_OFF_W      = 3;
EON_DRAG_OFF_H      = 4;
EON_DRAG_OFF_COUNT  = 5;
EON_DRAG_OFF_MODE   = 6;
EON_DRAG_MODE_PRECISE = 0;
EON_DRAG_MODE_BLIND   = 1;
EON_DRAG_CLAIM_BASE = 26251520;  // = BASE + 256; slot × 4, 16 slots
EON_DRAG_CLAIM_STRIDE = 4;

// ─── Per-pad action channel: RETIRED (P4) ───────────────────────────────
// The shared GS_PAD_ACTION channel (2620-2622) is gone — the browser posts
// pad mute/solo/note/reverse to the target instance's INCMD mailboxes
// (adopted in @block with identical side effects, per-instance and
// undo-correct). Swing Lite still has its own dormant reader for the old
// slots; nothing writes them anymore. Slots 2620-2622 stay reserved.

// JSFX → bridge: select the multi-out child track for this pad in REAPER's
// TCP/MCP. Value: 1-indexed pad (1..16); 0 = no request. Bridge consumes by
// writing 0 back. Gated in JSFX by the pad_click_selects_track preference
// (serialized at ser_ver >= 41, default 0 = off — opt-in via Colors menu).
// JSFX → bridge: project-dirty signal (Phase 1B). Set to 1 on any Swing state
// change; the bridge polls, calls reaper.MarkProjectDirty(0), then clears it.
// Replaces the slider_automate undo-capture trick so Swing edits no longer mint
// REAPER global-undo points — global Ctrl+Z can't restore a stale Swing chunk.
// Save still works: REAPER serializes all FX on project save regardless. Uses
// one of the reserved 2620-2622 slots (retired GS_PAD_ACTION region).
GS_PROJ_DIRTY = 2620;
gmem[GS_PROJ_DIRTY] = 0;

GS_PAD_TRACK_SELECT  = 2623;
gmem[GS_PAD_TRACK_SELECT] = 0;

// Swing_Browser.lua → JSFX: set to 1 when the user clicked BROWSE but
// ReaImGui isn't installed. JSFX shows a banner overlay in the LCD area
// (same overlay path as kit_bridge_warn). Cleared back to 0 by the browser
// on a successful launch (i.e. after the user installs ReaImGui and tries
// again). Persists across instances within a REAPER session.
GS_REAIMGUI_MISSING  = 2624;
// Kit Bridge preflight -> JSFX (2026-09-08): bitfield of extensions NOT
// installed (bit0 ReaImGui, bit1 js_ReaScriptAPI, bit2 SWS); 0 = all present.
// Written once per bridge boot; the LCD "Extension missing" rung reads it.
GS_EXT_MISSING       = 2635;
// ⭐ What the RUNNING bridge can do (2026-09-09). A ReaPack sync swaps the files
// but the bridge already running in memory keeps running until REAPER restarts, so
// a new JSFX routinely talks to an old bridge. The 3.0.2 bridge had no Wired
// handler at all: WIRED raised CMD 41 into silence, the bus sat blocked for the
// bridge's ~10 s stale-CMD fuse, and the button just looked broken (reported on a
// portable install). The bridge now stamps its level here every tick and 0 at exit.
// A bridge OLDER than 3.0.5 does not write the cell at all, so 0 means BOTH "no
// bridge" and "a bridge that cannot tell us what it supports" -- and those deserve
// the same answer, because we must not raise a command into a bridge that may not
// know it. KIT_GMEM_BRIDGE_ALIVE separates the two for the banner ladder.
GS_BRIDGE_LEVEL      = 2636;
BRIDGE_LEVEL_WIRED   = 305;  // the level that first PUBLISHES a level, so it is the
                             // floor for every bridge command we gate from here on
BRIDGE_LEVEL_PRINT_OWNER = 319;  // the small-things round: the bridge that writes EON_SEQ_PRINT_OWNER before it raises
                                 // a print (CMD 96 / 53). Below it (an older bridge still running) every instance walks
                                 // the print on state 1, as before the round (rk_seq_core seq_block_tick)

// ─── Pad FX panel channel (Swing JSFX ↔ external ReaImGui "Pad FX" window) ──
// A standalone Lua/ReaImGui window edits the SELECTED pad's per-pad FX. The
// browser-target instance publishes the FX-focused pad + that pad's live FX
// params here (read by the panel), and consumes param writes coming back —
// applying each exactly like the overlay's own edits (recalc_fx + mark_dirty_pad)
// so changes are audible immediately and persist via @serialize + undo.
// Supersedes the earlier tentative 2630–2632 "FX write-back" reservation.
//   GS_FX_SEL_PAD : JSFX→panel  FX-focused pad (overlay_pad if open, else sel_pad); -1 = none
//   GS_FX_PUB_BASE: JSFX→panel  18 live FX params for that pad (GS_FX_PUB_BASE + FX_PID_*)
//   GS_FX_PUB_PAD : JSFX→panel  handshake — which pad the band currently describes
//   GS_FX_ACTION_*: panel→JSFX  single-shot write; PAD written LAST, -1 = idle, consumed after use
GS_FX_SEL_PAD      = 2625;
// Publish band RELOCATED 2026-06-10 from the legacy 2626..2643 box (no room
// to grow) to 26040000, then RELOCATED again 2026-07-02: 26040000 collided
// with EON_StepSeq's EON_SS_XFER pattern-transfer buffer (header+data at
// 26040000..26041031) — a live FX-focus publish clobbered pattern syncs. Now
// in the verified-free gap between the GS_STRIP band end (..26080719) and
// INST_INCMD_BASE (26100000). 64 slots reserved:
// 26090000..26090062 params, 26090063 handshake. Old 2626..2644 slots retired.
GS_FX_PUB_BASE     = 26090000;  // params at base + FX_PID_*
GS_FX_PUB_COUNT    = 28;        // ids 0..22 + smash send at 27 (23..26 published
                                // as zeros — they are strip-band cells, not pids);
                                // band reserved through +62. MUST match rk_lua_core.lua.
GS_FX_PUB_PAD      = 26090063;  // handshake — which pad the band describes
GS_FX_ACTION_PAD   = 2646;
GS_FX_ACTION_PARAM = 2647;
GS_FX_ACTION_VALUE = 2648;
// Param ids — MUST match rk_lua_core.lua FX_PID_* and the publish-band order.
// Append-only: the Lua panel mirrors these by value.
FX_PID_HPF_FREQ   = 0;  FX_PID_LPF_FREQ    = 1;  FX_PID_RESO       = 2;
FX_PID_EQ_LO      = 3;  FX_PID_EQ_MID      = 4;  FX_PID_EQ_HI      = 5;
FX_PID_EQ_LO_FREQ = 6;  FX_PID_EQ_MID_FREQ = 7;  FX_PID_EQ_HI_FREQ = 8;
FX_PID_CMP_AMT    = 9;  FX_PID_CMP_MODE    = 10; FX_PID_BC_RATE    = 11;
FX_PID_BC_BITS    = 12; FX_PID_SAT_DRV     = 13; FX_PID_DRV_MODE   = 14;
FX_PID_SND_DLY    = 15; FX_PID_SND_RVB     = 16;
// v46: 4th EQ band (second bell, "hi-mid") + per-bell Q (wheel over node)
FX_PID_EQ_MID2      = 17;
FX_PID_EQ_MID2_FREQ = 18;
FX_PID_EQ_MID_Q     = 19;
FX_PID_EQ_MID2_Q    = 20;
gmem[GS_FX_ACTION_PAD] = -1;  // start idle (last-writer-wins across instances is fine)
gmem[GS_FX_SEL_PAD]    = -1;
gmem[GS_FX_PUB_PAD]    = -1;

// ─── Strip-sync band (Path B) — per-instance, registry-slot strided ──────
// EON_Swing_Strip_Sync.lua (defer companion) reads the FULL per-pad FX state
// here, mirrors it onto each multi-out child track's "EON Drum Strip" JSFX,
// and writes strip edits back through the command mailbox. Layout MUST match
// rk_lua_core.lua. Every instance publishes its own slot (no browser-target
// gate — each instance owns its child tracks).
//   header: SEQ (JSFX bumps per publish) · MULTIOUT · LUA_HB (Lua bumps once
//           per defer tick, ~30 Hz; still for STRIP_HB_STALE_S of Swing's own
//           clock while the transport is stopped ⇒ takeover off, internal FX
//           resume — failsafe if the script dies) · CMD_SEQ/PAD/PID/VAL (Lua
//           bumps SEQ last; JSFX consumes)
//   pads:   GS_STRIP_PADS + pad*GS_STRIP_PAD_STRIDE + FX_PID_*
GS_STRIP_BASE         = 26050000;
GS_STRIP_STRIDE       = 1024;     // per registry slot → 26050000..26080719
GS_STRIP_OFF_SEQ      = 0;
GS_STRIP_OFF_MULTIOUT = 1;
GS_STRIP_OFF_LUA_HB   = 2;
GS_STRIP_OFF_VIEW_REQ = 3;     // Swing→Lua: header STRIPS selector → (mode+1), companion pushes to strips
GS_STRIP_OFF_VU_REQ   = 600;   // Swing→Lua: header VU selector → (style+2); past the per-pad region (8..519)
GS_STRIP_OFF_CMD_SEQ  = 4;
GS_STRIP_OFF_CMD_PAD  = 5;
GS_STRIP_OFF_CMD_PID  = 6;
GS_STRIP_OFF_CMD_VAL  = 7;
GS_STRIP_PADS         = 8;
GS_STRIP_PAD_STRIDE   = 32;
_strip_hb_prev        = -1;    // -1 = unbaselined; see the @block heartbeat read
_strip_hb_row         = -1;    // the band the baseline was taken on
_strip_hb_t           = -1000; // Swing's wall clock of the last move, or of the last held block while playing
_strip_hb_mv_t        = -1000; // Swing's wall clock when LUA_HB last really MOVED (the play-start re-arm)
_strip_play_prev      = 0;     // play_state & 1 on the previous block
STRIP_HB_STALE_S      = 1.0;   // no movement for this long, transport stopped = the script is gone
STRIP_HB_REARM_S      = 30.0;  // heard from this recently = a play / render start puts the strips back in charge
// Free per-pad slots past the FX_PID block (ids 0..22): the FX-return viewer
// (EON_FX_Return_View.jsfx) reads these to show which pads feed the verb/delay
// bus + a live "hitting" glow. PEAK = per-pad meter (max L/R), HUE = effective
// pad hue. Within the 32-float per-pad stride, so no band growth.
GS_STRIP_PAD_OFF_PEAK = 23;
GS_STRIP_PAD_OFF_HUE  = 24;
// One-Mixer console tie: live p_gain/p_pan published for the strip-sync
// companion, which two-way-mirrors them onto the child track's D_VOL/D_PAN
// (write-back arrives via the existing INCMD_GAIN/PAN mailboxes, not the
// strip CMD mailbox). Still within the 32-float per-pad stride (25..31 free).
// MUST match rk_lua_core.lua GS_STRIP_PAD_OFF_VOL/PAN.
GS_STRIP_PAD_OFF_VOL  = 25;
GS_STRIP_PAD_OFF_PAN  = 26;
// Band-level tie capability flag (band offsets 0..7 all taken; pad region ends
// at 519; 600 = VU_REQ; 601 free). Written =1 by the publisher so the companion
// only runs the console tie against builds that (a) publish VOL/PAN and
// (b) carry the gain/pan DSP XOR — an old Swing leaves it 0 → tie fully inert
// (no double-gain from a mixed-version deploy).
GS_STRIP_OFF_TIE_VER  = 601;
GS_STRIP_OFF_ALIVE_MASK = 602; // Lua→Swing: bit i = pad i has a live Drum Strip (per-pad takeover)
// Mask DIALECT flag. 0 = a script that predates the mask, so ALIVE_MASK 0 means
// "no information" and widens to all sixteen (the pre-mask behaviour). 1 = the
// writer publishes an explicit mask, so 0 means NO pad has a live strip.
// MUST match rk_lua_core.lua GS_STRIP_OFF_MASK_VER.
GS_STRIP_OFF_MASK_VER = 603;
// Pad Banks Outputs step 2: what plays where, for the bridge's bank and split-pad tracks (Swing -> Lua, every
// publish). OUT_GEN is the block's generation: odd while Swing writes it, even (2, 4, ...) once it is whole -- the
// bridge takes the block only when it reads the same even value before and after (an older Swing leaves 0: no bank
// tracks for it).
// OUT_USE + p = how many PLAYABLE slots play on pair p (swing_out_pair, whatever multi_out says), p 0..31.
// OUT_OWN + k = the lowest playable slot on split pair OUT_PAIR_SPLIT + k, plus 1 (0 = none), k 0..9.
// BKNAME + 32 * (b - 1) = bank b's name (B, C, D), char codes, 0-terminated. Free cells 700..863 (pads end 519,
// VU / TIE / MASK 600..603, BUS 610..623, RACK 640..641). MUST match rk_lua_core.lua.
// Step 3: OUT_PAIR + slot = the pair each slot plays on (swing_out_pair, 0..63; the FX picker aims a pad through it),
// inside the same generation. OUT_TRK + k (Lua -> Swing, the bridge's write, NOT under OUT_GEN) = the slot + 1 whose
// track the bridge holds for split pair OUT_PAIR_SPLIT + k, 0 = none: Swing's "Own output" prefers a pad's own
// track (swing_out_split_pick).
// Step 4, the mixer panel (plan 6): MIX_STATE (Lua -> Swing) = 0 not the theme that narrows the panel / no bridge, 1
// not asked yet, 2 full width (Swing's strip on Layout B), 3 leave the theme alone -- the gear menu's entry;
// MIX_REQ (Swing -> Lua, the bridge consumes it to 0) = 1 use Layout B, 2 leave it; EMB_W / EMB_HB (Swing -> Lua) =
// the panel's width while an embedded face draws, and a count that moves while it does.
// Step 5, the FX picker: OUT_WPAIR + slot (Swing -> Lua, under OUT_GEN) = the pair the slot's audio rides under
// WIRED, plus 1 (swing_out_wpair: bank A's 0..15, the bank / split pairs 19..31; 0 = an older Swing that does not
// write it). It differs from OUT_PAIR beside an old Patchbay (the old layout: every slot on a bank A pair). Off
// Wired in stereo it says where the switch-on WILL put the slot (swing_out_wpair_next: the reset's value in the new
// layout), so a plugin added before Wired is on lands where the audio will go (2026-10-22); off Wired in multi-out,
// where Wired would put the slot as it stands. 938, 939, 1008..1023 free.
GS_STRIP_OFF_OUT_GEN  = 700;
GS_STRIP_OFF_OUT_USE  = 704;   // ..735
GS_STRIP_OFF_OUT_OWN  = 736;   // ..745
GS_STRIP_OFF_BKNAME   = 768;   // ..863
GS_STRIP_BKNAME_LEN   = 32;
GS_STRIP_OFF_OUT_PAIR = 864;   // ..927
GS_STRIP_OFF_OUT_TRK  = 928;   // ..937
// A person's output choices, counted (Swing -> Lua, under OUT_GEN; 2026-10-16, the user: "the output returns to the
// bank but undo does not remove the track"): swing_out_touched bumps it on every choice a person makes; the bridge
// gives each one a REAPER undo point -- with the track it makes, when it makes one -- so Ctrl+Z takes the choice and
// the track back together. Swing's own UNDO leaves output choices alone (UDO_K_OUT).
GS_STRIP_OFF_OUT_UREQ = 938;
// Bank colours (2026-10-15; the user: "give the tabs some color ... line up to the bank parent color when in multi
// output mode"). Lua -> Swing, the bridge writes, NOT under OUT_GEN: BANK_COL + b (b 0..3) = the colour of bank b's
// track (bank A's folder, B..D's bank tracks) as 0xRRGGBB + 1, 0 = no such track or no custom colour (the tab then
// wears the bank's default, swing_grid_bank_rgb). The bridge paints a bank track with that default when it has none.
GS_STRIP_OFF_BANK_COL = 746;   // ..749
// The bank colour set (2026-10-15; the THEME menu's BANK COLOURS row). Swing -> Lua, every strip publish: BANK_SET =
// the set + 1 (1 = Off; 0 = an older Swing, which never writes it -- the bridge then keeps its own defaults);
// BANK_DEF + b = bank b's colour in that set as 0xRRGGBB + 1 (0 with Off). The bridge paints each bank's track with
// it while the track has no colour or still wears the one it painted, and takes it off again on Off.
GS_STRIP_OFF_BANK_DEF = 750;   // ..753
GS_STRIP_OFF_BANK_SET = 754;
// Banks B..D's Drum Strips (2026-10-15; the user: "link bank B to D pads to their Drum Strips the way bank A works").
// A B..D pad has a track of its own only while it is split out (pairs OUT_PAIR_SPLIT..OUT_PAIRS - 1, ten), so a split
// pair's strip belongs to its OWNER, the lowest playable slot on the pair (OUT_OWN). Its own band, per registry slot,
// because the strip band above has no room for ten more records:
//   + k * GS_STRIP_PAD_STRIDE    the owner's record, the pad records' layout (FX_PID_*, VOL, PAN): Swing -> Lua, every
//                                publish, under the strip band's SEQ
//   + GS_SPLIT_OFF_OWNER + k     the slot that record holds, plus 1 (0 = nobody plays on the pair)
//   + GS_SPLIT_OFF_MASK          Lua -> Swing: bit k = split pair k's track carries a live Drum Strip
//   + GS_SPLIT_OFF_VER           Swing -> Lua: 1 = this Swing publishes the records and honours the mask (an older one
//                                leaves 0, and the strip sync then puts no strip on a split track)
//   + GS_SPLIT_OFF_TIE + k * 4   Lua -> Swing, the console tie for the owner (bank A's rides INCMD_GAIN / PAN): gain
//                                slot + 1, gain, pan slot + 1, pan; Swing takes each while that slot still owns the pair
//                                and zeroes its slot cell
// A split strip's edits come through the strip band's CMD mailbox, CMD_PAD = the owner's absolute slot.
// MUST match rk_lua_core.lua GS_SPLIT_*.
GS_SPLIT_BASE      = 26080720;
GS_SPLIT_STRIDE    = 512;      // per registry slot -> 26080720..26088911
GS_SPLIT_OFF_OWNER = 320;      // ..329
GS_SPLIT_OFF_MASK  = 330;
GS_SPLIT_OFF_VER   = 331;
GS_SPLIT_OFF_TIE   = 332;      // ..371
GS_STRIP_OFF_MIX_STATE = 940;
GS_STRIP_OFF_MIX_REQ  = 941;
GS_STRIP_OFF_EMB_W    = 942;
GS_STRIP_OFF_EMB_HB   = 943;
GS_STRIP_OFF_OUT_WPAIR = 944;   // ..1007

// v48: per-band shelf Q
FX_PID_EQ_LO_Q = 21;
FX_PID_EQ_HI_Q = 22;
// Smash send (parallel-comp bus). ⚠️ 23–26 are BURNED as strip-band per-pad
// cells (PEAK/HUE/VOL/PAN share the 32-float stride with the pids) — 27 is the
// first legal new pid and 27..31 are the last free ones. MUST match
// rk_lua_core.lua / EON_Swing_Strip_Sync.lua ("Smash Send") / the viewers.
FX_PID_SND_SMASH = 27;

// Bus-global param ids (FX-return viewer deck → strip CMD mailbox). Range 64+
// stays clear of the per-pad ids (0..22) and any near-term growth; pad is
// ignored for these. MUST match EON_FX_Return_View.jsfx.
FX_PID_BUS_RVB_SIZE     = 64;
FX_PID_BUS_RVB_DAMP     = 65;
FX_PID_BUS_RVB_WIDTH    = 66;
FX_PID_BUS_RVB_PREDELAY = 67;
FX_PID_BUS_RVB_HPF      = 68;
FX_PID_BUS_RVB_MIX      = 69;
FX_PID_BUS_DLY_DIV      = 70;
FX_PID_BUS_DLY_FB       = 71;
FX_PID_BUS_DLY_HPF      = 72;
FX_PID_BUS_DLY_LPF      = 73;
FX_PID_BUS_DLY_PING     = 74;
FX_PID_BUS_DLY_MIX      = 75;
// Bus enables (ser_ver 57). Appended AFTER the existing 64..75 block so the
// FX-return viewer's k = pid - 64 indexing keeps working unchanged.
FX_PID_BUS_RVB_ON       = 76;
FX_PID_BUS_DLY_ON       = 77;
// Published bus-param echo for the viewer deck (band offsets: pad region ends
// at 519, 600 = VU_REQ, 601 = TIE_VER; 610..623 claimed, stride is 1024).
// Order = the FX_PID_BUS_* ids above minus 64, so the two enables echo at
// 622/623. MUST match EON_FX_Return_View.jsfx.
GS_STRIP_OFF_BUS_BASE = 610;

// Set one per-pad FX param + rebuild coefficients — the value half of an
// edit, WITHOUT mark_dirty. Callers: swing_fx_apply (adds the dirty = a
// real user edit) and the kit-macro engine (kmac_apply — macro motion is
// performance/automation and must never create undo points or dirty the
// kit; Spec_Swing_Macro_System §3). Pad must be pre-validated 0..NUM_SLOTS-1
// (the macro engine reaches all four banks).
// Value-only FX write. Split out of swing_fx_set so a macro pass can write
// many targets and recalc each PAD once, instead of once per mapping.
//
// Now an ELSE-CHAIN. It used to be 24 separate statements, so every pid
// comparison ran on every call however early the match; a macro move paid all
// 24 per target write. Behaviour is identical -- the pids are mutually
// exclusive -- it just stops after the hit.
//
// Returns the recalc the write needs, as a BIT so callers can OR several
// together: 1 = recalc_fx. Unknown pid returns 0 and writes nothing, which is
// also how a foreign kit's junk pid lands here harmlessly.
function swing_fx_setv(_fa_pad, _fa_pid, _fa_val) (
  _fa_pid == FX_PID_HPF_FREQ    ? ( fx_hpf_freq[_fa_pad]    = _fa_val; 1; ) :
  _fa_pid == FX_PID_LPF_FREQ    ? ( fx_lpf_freq[_fa_pad]    = _fa_val; 1; ) :
  _fa_pid == FX_PID_RESO        ? ( fx_reso[_fa_pad]        = _fa_val; 1; ) :
  _fa_pid == FX_PID_EQ_LO       ? ( fx_eq_lo[_fa_pad]       = _fa_val; 1; ) :
  _fa_pid == FX_PID_EQ_MID      ? ( fx_eq_mid[_fa_pad]      = _fa_val; 1; ) :
  _fa_pid == FX_PID_EQ_HI       ? ( fx_eq_hi[_fa_pad]       = _fa_val; 1; ) :
  _fa_pid == FX_PID_EQ_LO_FREQ  ? ( fx_eq_lo_freq[_fa_pad]  = _fa_val; 1; ) :
  _fa_pid == FX_PID_EQ_MID_FREQ ? ( fx_eq_mid_freq[_fa_pad] = _fa_val; 1; ) :
  _fa_pid == FX_PID_EQ_HI_FREQ  ? ( fx_eq_hi_freq[_fa_pad]  = _fa_val; 1; ) :
  _fa_pid == FX_PID_CMP_AMT     ? ( fx_cmp_amt[_fa_pad]     = _fa_val; 1; ) :
  _fa_pid == FX_PID_CMP_MODE    ? ( fx_cmp_mode[_fa_pad]    = (_fa_val | 0); 1; ) :
  _fa_pid == FX_PID_BC_RATE     ? ( fx_bc_rate[_fa_pad]     = _fa_val; 1; ) :
  _fa_pid == FX_PID_BC_BITS     ? ( fx_bc_bits[_fa_pad]     = floor(_fa_val + 0.5); 1; ) :
  _fa_pid == FX_PID_SAT_DRV     ? ( fx_sat_drv[_fa_pad]     = _fa_val; 1; ) :
  _fa_pid == FX_PID_DRV_MODE    ? ( fx_drv_mode[_fa_pad]    = (_fa_val | 0); 1; ) :
  _fa_pid == FX_PID_SND_DLY     ? ( fx_snd_dly[_fa_pad]     = _fa_val; 1; ) :
  _fa_pid == FX_PID_SND_RVB     ? ( fx_snd_rvb[_fa_pad]     = _fa_val; 1; ) :
  _fa_pid == FX_PID_SND_SMASH   ? ( fx_snd_smash[_fa_pad]   = _fa_val; 1; ) :
  _fa_pid == FX_PID_EQ_MID2      ? ( fx_eq_mid2[_fa_pad]      = _fa_val; 1; ) :
  _fa_pid == FX_PID_EQ_MID2_FREQ ? ( fx_eq_mid2_freq[_fa_pad] = _fa_val; 1; ) :
  _fa_pid == FX_PID_EQ_MID_Q     ? ( fx_eq_mid_q[_fa_pad]     = _fa_val; 1; ) :
  _fa_pid == FX_PID_EQ_MID2_Q    ? ( fx_eq_mid2_q[_fa_pad]    = _fa_val; 1; ) :
  _fa_pid == FX_PID_EQ_LO_Q      ? ( fx_eq_lo_q[_fa_pad]      = _fa_val; 1; ) :
  _fa_pid == FX_PID_EQ_HI_Q      ? ( fx_eq_hi_q[_fa_pad]      = _fa_val; 1; )
  : 0;   // nothing matched: no value changed, so no recalc is owed either.
         // ⚠ This `: 0` is the chain's ELSE arm, which makes the chain the
         // function's value. Until 2026-09-14 it was a separate `0;` statement
         // AFTER the chain's `;`, so the function returned 0 for EVERY pid and
         // swing_fx_set never recalculated: kit macros, the Pad FX window and
         // the strip mailbox changed the stored value but not the sound (audit
         // A-1, shipped in 3.0.10; rig EON_Probe_FxSetv). Each arm reports for
         // ITSELF -- a contiguous-pid-range test would silently drop a recalc
         // the day someone inserts a pid out of order.
);

// Value + coefficients, the shape every existing caller expects.
function swing_fx_set(_fa_pad, _fa_pid, _fa_val) (
  swing_fx_setv(_fa_pad, _fa_pid, _fa_val) ? recalc_fx(_fa_pad);
);

// Apply one (pad, pid, value) FX edit exactly like the overlay's own edits:
// set the array value, rebuild coefficients, mark the pad dirty (undo +
// @serialize persistence). Shared by the Pad FX panel consumer and the
// strip-sync mailbox consumer (both @block). Per-pad value+recalc now lives
// in swing_fx_set above; this adds the dirty marking of a real edit.
// Pad Banks: any slot. The Pad FX window follows the selection into banks B..D
// and posts the ABSOLUTE pad it shows; a sixteen-wide guard here dropped every
// such edit after the panel consumer had already taken the cell. The strip
// mailbox stays bank A's -- its call site hands anything past bank A in as -1.
function swing_fx_apply(_fa_pad, _fa_pid, _fa_val) (
  // Bus-global params (pad ignored) — from the FX-return viewer's deck. Clamps
  // and recalc pairing mirror the LCD FX panel exactly: rvb recalcs all but MIX;
  // dly recalcs only DIV/HPF/LPF (FB/PING/MIX are read live by the DSP).
  _fa_pid >= FX_PID_BUS_RVB_SIZE && _fa_pid <= FX_PID_BUS_DLY_ON ? (
    _fa_pid == FX_PID_BUS_RVB_SIZE     ? ( rvb_size     = max(0, min(1, _fa_val));       rvb_recalc(); );
    _fa_pid == FX_PID_BUS_RVB_DAMP     ? ( rvb_damp     = max(0, min(1, _fa_val));       rvb_recalc(); );
    _fa_pid == FX_PID_BUS_RVB_WIDTH    ? ( rvb_width    = max(0, min(1, _fa_val));       rvb_recalc(); );
    _fa_pid == FX_PID_BUS_RVB_PREDELAY ? ( rvb_predelay = max(0, min(250, _fa_val));     rvb_recalc(); );
    _fa_pid == FX_PID_BUS_RVB_HPF      ? ( rvb_hpf      = max(0, min(500, _fa_val));     rvb_recalc(); );
    _fa_pid == FX_PID_BUS_RVB_MIX      ? ( rvb_mix      = max(0, min(1, _fa_val)); );
    _fa_pid == FX_PID_BUS_DLY_DIV      ? ( dly_div      = max(1, min(RPT_NUM_DIVS, _fa_val | 0)); dly_recalc(); );
    _fa_pid == FX_PID_BUS_DLY_FB       ? ( dly_fb       = max(0, min(0.95, _fa_val)); );
    _fa_pid == FX_PID_BUS_DLY_HPF      ? ( dly_hpf_hz   = max(20, min(2000, _fa_val));   dly_recalc(); );
    _fa_pid == FX_PID_BUS_DLY_LPF      ? ( dly_lpf_hz   = max(1000, min(20000, _fa_val)); dly_recalc(); );
    _fa_pid == FX_PID_BUS_DLY_PING     ? ( dly_ping     = _fa_val >= 0.5; );
    _fa_pid == FX_PID_BUS_DLY_MIX      ? ( dly_mix      = max(0, min(1, _fa_val)); );
    _fa_pid == FX_PID_BUS_RVB_ON       ? ( rvb_on       = _fa_val >= 0.5; );
    _fa_pid == FX_PID_BUS_DLY_ON       ? ( dly_on       = _fa_val >= 0.5; );
    mark_dirty_kit();
  ) :
  _fa_pad >= 0 && _fa_pad < NUM_SLOTS ? (   // any slot: the Pad FX window follows every bank
    swing_fx_set(_fa_pad, _fa_pid, _fa_val);
    mark_dirty_pad(_fa_pad);
    // last-touched tap for the macro assign shortcuts — this funnel carries
    // every PadFX-panel, strip and viewer edit with its (pad, pid).
    kmac_lt_pad = _fa_pad; kmac_lt_pid = _fa_pid; kmac_lt_t = time_precise();
  );
);

// Banks B..D's Drum Strips (2026-10-15): slot s's strip record at pb, the cells bank A's records carry (the strip
// publish in @block writes those inline): the FX chain, and the gain / pan of the console tie -- gain -1 for a slot
// with nothing to play, so the companion leaves that fader alone. Written for each split pair's owner.
function swing_strip_rec_put(pb, s) (
  gmem[pb + FX_PID_HPF_FREQ]     = fx_hpf_freq[s];
  gmem[pb + FX_PID_LPF_FREQ]     = fx_lpf_freq[s];
  gmem[pb + FX_PID_RESO]         = fx_reso[s];
  gmem[pb + FX_PID_EQ_LO]        = fx_eq_lo[s];
  gmem[pb + FX_PID_EQ_MID]       = fx_eq_mid[s];
  gmem[pb + FX_PID_EQ_HI]        = fx_eq_hi[s];
  gmem[pb + FX_PID_EQ_LO_FREQ]   = fx_eq_lo_freq[s];
  gmem[pb + FX_PID_EQ_MID_FREQ]  = fx_eq_mid_freq[s];
  gmem[pb + FX_PID_EQ_HI_FREQ]   = fx_eq_hi_freq[s];
  gmem[pb + FX_PID_CMP_AMT]      = fx_cmp_amt[s];
  gmem[pb + FX_PID_CMP_MODE]     = fx_cmp_mode[s];
  gmem[pb + FX_PID_BC_RATE]      = fx_bc_rate[s];
  gmem[pb + FX_PID_BC_BITS]      = fx_bc_bits[s];
  gmem[pb + FX_PID_SAT_DRV]      = fx_sat_drv[s];
  gmem[pb + FX_PID_DRV_MODE]     = fx_drv_mode[s];
  gmem[pb + FX_PID_SND_DLY]      = fx_snd_dly[s];
  gmem[pb + FX_PID_SND_RVB]      = fx_snd_rvb[s];
  gmem[pb + FX_PID_SND_SMASH]    = fx_snd_smash[s];
  gmem[pb + FX_PID_EQ_MID2]      = fx_eq_mid2[s];
  gmem[pb + FX_PID_EQ_MID2_FREQ] = fx_eq_mid2_freq[s];
  gmem[pb + FX_PID_EQ_MID_Q]     = fx_eq_mid_q[s];
  gmem[pb + FX_PID_EQ_MID2_Q]    = fx_eq_mid2_q[s];
  gmem[pb + FX_PID_EQ_LO_Q]      = fx_eq_lo_q[s];
  gmem[pb + FX_PID_EQ_HI_Q]      = fx_eq_hi_q[s];
  gmem[pb + GS_STRIP_PAD_OFF_VOL] = pad_is_playable(s) ? p_gain[s] : -1;
  gmem[pb + GS_STRIP_PAD_OFF_PAN] = p_pan[s];
);

// ─── Kit-macro engine (slice 1, Spec_Swing_Macro_System §3) ───────────────
// Shape one macro value through a mapping's curve. Negative curve inverts
// the response (1-v) at |curve|; exponent 1 short-circuits to linear so
// trivial mappings pay nothing. pow is @block-only — never @sample.
function kmac_shape(_kmc_v, _kmc_c) local(_kmc_e) (
  _kmc_c < 0 ? ( _kmc_v = 1 - _kmc_v; );
  _kmc_e = abs(_kmc_c);
  _kmc_e > 0 && _kmc_e != 1 ? ( _kmc_v = pow(_kmc_v, _kmc_e); );
  _kmc_v;
);

// Core-param setter — the macro-safe write path for virtual pids ≥100.
// Each case mirrors the corresponding LCD PAD-tab knob exactly (value
// write + the SAME recalc that knob runs); clamps are the knob ranges.
// No mark_dirty, same contract as swing_fx_set.
function swing_kmac_core_setv(_kc_pad, _kc_pid, _kc_val) (
  _kc_pid == KMAC_PID_TUNE ? (
    p_tune[_kc_pad] = max(-24, min(24, _kc_val)); 2;
  ) :
  _kc_pid == KMAC_PID_PAN ? (
    _kc_val = max(-1, min(1, _kc_val));
    p_pan[_kc_pad]  = _kc_val;
    p_panL[_kc_pad] = min(1.0, 1.0 - _kc_val);
    p_panR[_kc_pad] = min(1.0, 1.0 + _kc_val);
    0;                        // pan writes its own coefficients above
  ) :
  _kc_pid == KMAC_PID_DECAY ? (
    p_decay[_kc_pad] = max(1, min(2000, _kc_val)); 2;
  ) :
  _kc_pid == KMAC_PID_ATTACK ? (
    p_attack[_kc_pad] = max(0, min(500, _kc_val)); 2;
  ) :
  // Engine knobs: no recalc at all -- rk_syn_reset reads ps_mac* at TRIGGER,
  // so a move shapes the next hit and leaves ringing voices alone. That is how
  // a real drum machine's decay knob behaves, and it means a macro sweep can
  // never glitch a note already sounding.
  _kc_pid >= KMAC_PID_SYN_BASE && _kc_pid < KMAC_PID_SYN_BASE + KMAC_PID_SYN_N ? (
    _syn_mac_set(_kc_pad, _kc_pid - KMAC_PID_SYN_BASE, max(0, min(1, _kc_val))); 0;
  ) : 0;
);

// NOTE: swing_kmac_core_set / swing_kmac_target_set -- the "write one target
// and recalc immediately" pair -- were removed when kmac_apply moved to the
// _setv + per-pad-settle path below and left them with no callers at all.
// (swing_fx_set survives: swing_fx_apply still uses it.) If something ever
// wants that shape back it is two lines -- call the _setv and act on the bits
// it returns.

// Value-only dispatch. Returns the recalc owed as BITS -- 1 = recalc_fx,
// 2 = recalc_pad -- so a macro pass can OR them per pad and settle up once.
function swing_kmac_target_setv(_kt_pad, _kt_pid, _kt_val) (
  _kt_pid >= KMAC_PID_CORE_BASE ? swing_kmac_core_setv(_kt_pad, _kt_pid, _kt_val)
                                : swing_fx_setv(_kt_pad, _kt_pid, _kt_val);
);

// Apply macro _kmc_m at value _kmc_v (0..1) to every one of its mappings:
// target = lo + (hi-lo) * shape(v). Absolute-within-range — the macro OWNS
// a mapped param while mapped (a manual edit holds only until the next
// macro move). Writes go through swing_fx_set: same value+recalc as a real
// edit, no dirty, no undo.
function kmac_apply(_kmc_m, _kmc_v) local(_kmc_j _kmc_b _kmc_pad _kmc_val _kmc_p) (
  _kmc_b = _kmc_m * KMAC_MAX_MAP;
  _kmc_j = 0;
  loop(min(kmac_nmap[_kmc_m], KMAC_MAX_MAP),
    _kmc_val = kmac_lo[_kmc_b + _kmc_j]
             + (kmac_hi[_kmc_b + _kmc_j] - kmac_lo[_kmc_b + _kmc_j])
               * kmac_shape(_kmc_v, kmac_curve[_kmc_b + _kmc_j]);
    _kmc_pad = kmac_pad[_kmc_b + _kmc_j];
    // Kit macros reach all four banks (Plan_Swing_Pad_Banks_Macros, 2026-09-24): ALL = every one of the
    // NUM_SLOTS pads, SEL = the selected pad in whichever bank it sits, a concrete pad = its absolute slot.
    _kmc_pad == -2 ? (
      _kmc_p = 0;
      loop(NUM_SLOTS,
        kmac_rcp[_kmc_p] |= swing_kmac_target_setv(_kmc_p, kmac_pid[_kmc_b + _kmc_j], _kmc_val);
        _kmc_p += 1;
      );
    ) : (
      _kmc_pad == -1 ? ( _kmc_pad = sel_pad; );
      _kmc_pad >= 0 && _kmc_pad < NUM_SLOTS ? (
        kmac_rcp[_kmc_pad] |= swing_kmac_target_setv(_kmc_pad, kmac_pid[_kmc_b + _kmc_j], _kmc_val);
      );
    );
    _kmc_j += 1;
  );
);

// @block tick: gather the 8 macro sliders, change-detect, apply movers.
// The FIRST block only primes the last-value snapshot — a project open or
// kit load applies nothing until the user actually moves a macro, so a
// mapped kit never has its saved FX state silently overwritten at load.
// kmac_force = one-shot full re-apply for later slices (mapping edits,
// factory-macro kit loads).
function kmac_tick() local(_kmc_k, _kmc_f, _kmc_fr, _kmc_g, _kmc_p) (
  // ── morph engine (slice 4, spec §4) ── macro_morph is THE automatable
  // morph param. When it moves, lerp the 8 values along the snapshot chain
  // (integer part = "from" slot, fraction = blend to the next) and write
  // them as the macro values; knobs move COSMETICALLY via sliderchange —
  // no automation events, so a READ-mode lane on macro_morph never fights
  // the 8 knobs (the researched write-back trap). Gated on BOTH chain ends
  // being captured — an empty snapshot never zeroes a performance.
  // ⭐The lerp runs on MACRO POSITIONS (0..1, unitless), never on target
  // values, so the dB-collapse hazard (spec §4 gain-domain rule) is
  // structurally impossible here: a morph is the same trajectory as
  // turning the knob by hand. Anyone rearchitecting this to blend TARGET
  // values must read that spec section first.
  kmac_primed && macro_morph != kmac_morph_last ? (
    kmac_morph_last = macro_morph;
    _kmc_f  = max(0, min(KMAC_NSNAP - 1, macro_morph));
    _kmc_fr = _kmc_f - (_kmc_f | 0);
    _kmc_f  = _kmc_f | 0;
    _kmc_g  = min(KMAC_NSNAP - 1, _kmc_f + 1);
    kmac_snap_has[_kmc_f] && kmac_snap_has[_kmc_g] ? (
      _kmc_f = _kmc_f * KMAC_N; _kmc_g = _kmc_g * KMAC_N;
      macro1 = kmac_snap[_kmc_f + 0] + (kmac_snap[_kmc_g + 0] - kmac_snap[_kmc_f + 0]) * _kmc_fr;
      macro2 = kmac_snap[_kmc_f + 1] + (kmac_snap[_kmc_g + 1] - kmac_snap[_kmc_f + 1]) * _kmc_fr;
      macro3 = kmac_snap[_kmc_f + 2] + (kmac_snap[_kmc_g + 2] - kmac_snap[_kmc_f + 2]) * _kmc_fr;
      macro4 = kmac_snap[_kmc_f + 3] + (kmac_snap[_kmc_g + 3] - kmac_snap[_kmc_f + 3]) * _kmc_fr;
      macro5 = kmac_snap[_kmc_f + 4] + (kmac_snap[_kmc_g + 4] - kmac_snap[_kmc_f + 4]) * _kmc_fr;
      macro6 = kmac_snap[_kmc_f + 5] + (kmac_snap[_kmc_g + 5] - kmac_snap[_kmc_f + 5]) * _kmc_fr;
      macro7 = kmac_snap[_kmc_f + 6] + (kmac_snap[_kmc_g + 6] - kmac_snap[_kmc_f + 6]) * _kmc_fr;
      macro8 = kmac_snap[_kmc_f + 7] + (kmac_snap[_kmc_g + 7] - kmac_snap[_kmc_f + 7]) * _kmc_fr;
      sliderchange(KMAC_SLMASK);
    );
  );

  kmac_val[0] = macro1; kmac_val[1] = macro2;
  kmac_val[2] = macro3; kmac_val[3] = macro4;
  kmac_val[4] = macro5; kmac_val[5] = macro6;
  kmac_val[6] = macro7; kmac_val[7] = macro8;
  kmac_primed ? (
    _kmc_k = 0;
    loop(KMAC_N,
      (kmac_val[_kmc_k] != kmac_last[_kmc_k] || kmac_force) ? (
        kmac_last[_kmc_k] = kmac_val[_kmc_k];
        kmac_nmap[_kmc_k] > 0 ? ( kmac_apply(_kmc_k, kmac_val[_kmc_k]); );
      );
      _kmc_k += 1;
    );
    // ── settle the recalcs, once per PAD ────────────────────────────────
    // Was once per MAPPING: a morph on 9T9 ran 150 recalc_fx a block where 16
    // pads exist, because several mappings land on the same pad and each one
    // rebuilt all six of its filters. Deduping ACROSS macros too, not just
    // within one, since a morph moves all eight at once.
    // Cheap to run unconditionally -- NUM_SLOTS iterations of a mask test. An ALL mapping flags all four
    // banks, so a moving macro can owe one recalc per pad for up to 64 pads in a block; every flagged pad settles.
    _kmc_p = 0;
    loop(NUM_SLOTS,
      kmac_rcp[_kmc_p] ? (
        kmac_rcp[_kmc_p] & 1 ? recalc_fx(_kmc_p);
        kmac_rcp[_kmc_p] & 2 ? recalc_pad(_kmc_p);
        kmac_rcp[_kmc_p] = 0;
      );
      _kmc_p += 1;
    );
    kmac_force = 0;
  ) : (
    _kmc_k = 0;
    loop(KMAC_N, kmac_last[_kmc_k] = kmac_val[_kmc_k]; _kmc_k += 1;);
    kmac_morph_last = macro_morph;  // never morph-apply on the prime frame —
                                    // a project restoring morph≠0 must not
                                    // stomp the knobs at open (same contract
                                    // as the value prime above).
    kmac_primed = 1;
  );
);

// Identity-palette defaults: macro k wears palette colour k. The MACRO tab
// reads kmac_color (not k) so per-macro recolouring later is a data change.
// A ser_ver >= 54 read overwrites these with the saved colours.
// (The slice-1 TEMP test mapping that lived here was RETIRED when the
// assign UI + persistence landed — fresh instances start with 8 empty
// macros; factory mappings arrive with kits, not @init.)
_kmc_i = 0; loop(KMAC_N, kmac_color[_kmc_i] = _kmc_i; _kmc_i += 1;);

// SP_PITCH_* protocol constants + heartbeat state + @block worker now live
// in libs/rk_swing_block_pitch.jsfx-inc (imported at file top). Per-pad
// freemem arrays (sp_pitch_mode, sp_pitch_algo) stay below in
// this @init since they need NUM_PADS defined.

heartbeat_counter    = 0;

// _auto_load_attempted: serialized at ser_ver >= 36, so DO NOT initialize
// here. EEL2 zeros uninitialized variables on fresh-instance creation,
// which is the value we want for "auto-load 808 has not yet fired".
// Resetting to 0 in @init would re-fire auto-load on every sample-rate
// change (which re-runs @init but not @serialize) — clobbering whatever
// kit the user has currently loaded.
update_dot_alpha     = 0;
update_dot_dir       = 1;

gmem[GS_UPDATE_REQUEST] = 1;    // ask companion to check on first load

kit_export_state = 0;  // 0=idle 1=ask_name 10=wait_name 11=write_meta 2=copy_audio 3=wait_lua
kit_export_only  = 0;  // b + 1 while a "save bank b as a kit" runs (Pad Banks audit S7): the bridge consumes GS_KIT_EXPORT_ONLY at its name prompt, so the JSFX keeps its own
kit_import_state = 0;  // 0=idle 1=wait_lua 2=read_meta 3=copy_audio 4=recalc
kit_bridge_warn  = 0;  // 1 = show "bridge not running" warning
// LCD banner for a promotion cut (swing_pad_promote, rk_swing_core): the pad
// whose sample was cut to LAYER_SIZE when a layer >= 1 landed on it (-1 =
// none), the banner's expiry, and the lengths in seconds for its text.
// Session-volatile. Spec_Swing_Long_Pad_Layer_Cap §4.2.
pad_cut_warn_pad    = -1;
pad_cut_warn_until  = 0;
pad_cut_warn_before = 0;
pad_cut_warn_after  = 0;
// LCD banner for a load trimmed at the cap (swing_ldr_finish, rk_swing_core;
// Spec_Swing_Pad_Banks §5.4 / §8.1): the pad (-1 = none), the layer (-1 = the pad's own
// sample), the cap in seconds at the file's rate, that rate, and the expiry. Session-
// volatile; the pad face's mark is derived from the lengths and needs no state.
pad_trim_warn_pad   = -1;
pad_trim_warn_layer = -1;
pad_trim_warn_secs  = 0;
pad_trim_warn_sr    = 0;
pad_trim_warn_until = 0;
_kd_t0 = time_precise();  // TEMP DIAGNOSTIC anchor: instance start time
kit_saved_at     = 0;  // time_precise() of the last save ack (export CMD 99) —
                       // drives the transient "SAVED" flash on the SAVE button.
                       // 0 = never saved this session. Session-volatile.
// Undo queue: defer destructive actions until bridge opens undo block.
// Codes:
//   0  = none / idle
//   1  = clear all pads
//   2  = clear pad
//   3  = clear layer
//   5  = swap pads
//   6  = new kit (full reset)
// (Codes 8-11 reserved for the v2 internal undo system. Drag-drop and
// browser-load currently run synchronously and rely on the bridge's
// leak-timer to close the undo block — full audio-buffer restore is
// pending the v2 rewrite.)
_undo_pending = 0;
_undo_pad = -1;         // target pad for pending action
_undo_pad2 = -1;        // second pad (for swap)
_undo_layer = -1;       // target layer (for clear layer)
kit_copy_pad    = 0;
kit_copy_retry  = 0;   // per-pad file-open retry counter (state-3 VER-201 loop)
// Bounded per-pad file-open retry budget (2026-07-19): a transient Windows
// AV/indexer read-lock makes file_open miss a VALID store WAV, leaving the pad
// blank ("different pads empty each load, second load fixes it"). The state-3
// loop re-attempts the SAME pad on successive @blocks up to this many times
// before giving up to the bridge-level failbits retry. ~150 blocks ≈ several
// hundred ms of spread-out attempts — beats typical AV holds, RT-safe (each
// retry is one cheap file_open, no @sample stall).
KIT_OPEN_RETRY_MAX = 150;
kit_copy_layer  = 0;
kit_copy_pos    = 0;
kit_audio_off   = 0;   // running gmem offset for audio
kit_total_audio = 0;   // total samples to copy (for progress)
kit_copied_audio = 0;  // samples copied so far (for progress)
strcpy(#kit_name, "");
kit_name_gmem_dirty = 1; // sync to gmem on first frame
audiolen_gmem_dirty = 1; // sync pad audio lengths to gmem on first frame
pad_colors_gmem_dirty = 1; // sync pad colors to gmem on first frame
pad_names_gmem_dirty = 1;  // sync pad names to gmem on first frame
kit_busy = 0;          // 1 during export/import (blocks other interaction)
_al_settle_smp = 0;    // audio-samples elapsed since @init; gates the 808 auto-load
                       // until @serialize is_read has had time to run (blank-pads
                       // reopen race — see the auto-load block below). Transient,
                       // not serialized, so unconditional @init reset is correct.
// embed_show_knobs: serialized at ser_ver >= 33; same reasoning as
// _auto_load_attempted above — EEL2 default 0 is "knobs hidden", which
// is the same as the legacy default. Initializing in @init would reset
// the user's preference on every sample-rate change.

// Precomputed coefficients
_sat_drv_sm = 0;  // smoothed master drive amount (chases gfx_sat_drv)
_vol_sm = 1.0;    // smoothed master volume (chases global_vol, prevents zipper)
// global_vol is the LINEAR amplitude derived from the master_db slider
// in @slider. Init here so fresh instances (before any @slider fires)
// don't multiply audio by 0. Default master_db = 0 dB → unity = 1.0.
global_vol = 1.0;

// Filter state (stereo)
gfx_hpf_stL = 0; gfx_hpf_stR = 0;
gfx_lpf_stL = 0; gfx_lpf_stR = 0;

// ─── Master limiter runtime state (params set by swing_apply_defaults_fx) ──
gfx_lim_rel_c = exp(-1.0 / max(1, gfx_lim_rel * 0.001 * srate));
gfx_lim_env   = 1.0;      // current gain envelope (1.0 = no reduction)
_mlim_thr_s   = -1;       // the ceiling the sample path limits to: seated from gfx_lim_thr on the first sample, then glided (click fix 2026-10-14)
gfx_lim_gr    = 1.0;      // GR meter (min of frame, reset in @gfx)

// Init master biquad filters
recalc_global_fx();

// ─── Global send FX: Delay + Reverb + Compressor ────────────────────────
// Params set by swing_apply_defaults_fx() above; @serialize backfills old
// presets via `is_read && ser_ver < N` clauses.

// Init delay + reverb + compressor buffers (placed after s_audio_start in high memory)
// Each _init returns the next free memory address
_send_fx_mem = _fx_base;   // (see the backing self-check beside the allocator init)
_send_fx_mem = dly_init(_send_fx_mem);
_send_fx_mem = rvb_init(_send_fx_mem);
_send_fx_mem = cmp_init(_send_fx_mem);
// The Anvil voice's tables (~0.34M): same region, same cursor, so they sit
// right after the comp's buffers and ahead of the undo backup, under the backed
// top. anv_engine_init also runs Anvil's ground-truth self-check.
_send_fx_mem = anv_engine_init(_send_fx_mem);
_cmp_voice_seen = -1;   // the first @block records the voice, never resets on it
_anv_rested = 0;

cmp_vu.rk_vu_init_gr();   // the master comp's GR needle (Weld's card on the COMP page)
dly_recalc();
rvb_recalc();
cmp_recalc();

// ─── Send-bus enable: gate glide + tail ring-out state ──────────────────
// rvb_on / dly_on are the real on/off (kit state, ser_ver 57). OFF does NOT
// hard-gate the engine - that chops the tail mid-decay, which is the click
// the old `rvb_size > 0.001` / `dly_div > 0` gates produced. Instead OFF
// glides the INPUT to zero and lets the tail ring out, then stands the
// engine down once the wet has been under BUS_TAIL_FLOOR for _bus_tail_hold
// consecutive samples. Pulling the send is what "off" should sound like.
// srate-derived, like dly_sm_c: ext_noinit = 1.0 makes @init one-shot, so
// swing_block_handle_srate_change re-derives both after a rate change (A-6).
_bus_gate_c    = exp(-1 / (0.008 * srate));  // 8 ms TIME CONSTANT (~55 ms to
                                             // -60 dB) on the input mute
_bus_tail_hold = (0.5 * srate) | 0;          // 500 ms of proven silence
_rvb_gate = 1; _dly_gate = 1;                // start open (both buses default ON)
_rvb_tail_n = 0; _dly_tail_n = 0;

// Pad-swap scratch: ONE SWAP_CHUNK-cell piece, not a whole slot. swap_pads()
// (rk_drumkit_dsp) moves pad audio through it in SWAP_CHUNK pieces, and the
// ADSR analyzer (rk_swing_core) borrows its first ~200 cells as RMS scratch.
// It sits BEFORE the undo slot, under everything else the plugin addresses, so
// it can never reach the range above the backed top. The old whole-slot
// scratch lived ABOVE the undo slot (~70-74M) on the theory that same-frame
// use was safe there; it is not: EEL2's memcpy stops copying the moment either
// pointer leaves backed memory, so a swap whose used region crossed the
// ceiling silently dropped the tail of the longer sample (2026-09-07 audit).
_swap_tmp_buf = _send_fx_mem;
_send_fx_mem += SWAP_CHUNK;

// Command-undo: one-pad audio backup buffer (UDO_VSLOT = MAX_LAYERS * LAYER_SIZE, the virtual
// slot of one pad's worst case; one SLOT_SIZE until layers grew to pad length). Full-slot copy on
// a per-pad structural op; restored to that pad only on undo. This buffer must
// PERSIST across frames, so it is the top of the addressed range and
// _udo_ready proves it sits fully under the backed ceiling (see the maxmem
// note at the top). It previously sat after the whole-slot swap buffer
// (~70-74M) and its tail crossed the ceiling, silently truncating backups of
// very large samples.
udo_s2_audio = _send_fx_mem;
_send_fx_mem += UDO_VSLOT;
_udo_ready = (udo_s2_audio + UDO_VSLOT <= _mbk_top) ? 1 : 0;   // under the BACKED top, not the reported grant (2026-09-23)
// Headroom = what is left above the TOP of everything (see the budget note at
// s_audio_start). It used to be taken there as pads + undo slot only, which
// skipped the send FX and the swap chunk between them, so the readout showed
// more room than there was (2026-09-13 audit). Same test as _udo_ready, as a count.
_mem_head = _mbk_top - _send_fx_mem;   // headroom under the backed top (negative = the FX outgrew SEND_FX_RESERVE on a short machine)
_send_fx_mem - _fx_base > SEND_FX_RESERVE ? alloc_backed = 0;   // the reserve is a promise: the FX + swap + undo must fit it (~1.2-1.4M of FX by the inits' constants, plus the 16M backup: ~17.4M of 19M)
_mem_fits = _mem_head >= 0 ? 1 : 0;

// ─── Pad colors: HSL hue system ──────────────────────────────────────────
// p_color[i] = hue (0.0–1.0), rendered with fixed S=0.75, L=0.55
// pc[] array kept for v16→v17 migration (maps old palette index → hue)
PAD_COLOR_S = 0.75;  // saturation for pad face colors
PAD_COLOR_L = 0.55;  // lightness for pad face colors

// Legacy palette → hue mapping (for deserialize migration)
// Index:  0=red  1=orange  2=yellow  3=green  4=teal  5=blue
//         6=indigo 7=purple 8=magenta 9=crimson 10=brown
//         11=sage 12=slate 13=gold 14=violet 15=cyan
pc[0]=0.00;   // red
pc[1]=0.07;   // orange
pc[2]=0.14;   // yellow
pc[3]=0.33;   // green
pc[4]=0.47;   // teal
pc[5]=0.58;   // blue
pc[6]=0.67;   // indigo
pc[7]=0.78;   // purple
pc[8]=0.89;   // magenta
pc[9]=0.97;   // crimson
pc[10]=0.08;  // brown
pc[11]=0.38;  // sage
pc[12]=0.60;  // slate blue
pc[13]=0.12;  // gold
pc[14]=0.75;  // violet
pc[15]=0.52;  // cyan

// Core functions now in rk_swing_core.jsfx-inc:
//   get_name_slot, get_path_slot, get_cname_slot, auto_name_from_file,
//   sync_note_names, clear_layer, clear_pad, load_from_path,
//   load_layer_from_path, build_wv_cache, launch_voices_for_pad

// Init custom name strings to empty (must be after get_cname_slot definition)
i = 0; loop(NUM_SLOTS, strcpy(get_cname_slot(i), ""); i += 1;);   // every bank (audit batch 7; was bank A only)

// ─── Build 128-note menu string (flat list, no submenus) ────────────────
// gfx_showmenu returns 1-based index matching item order exactly.
// Flat list: item 1 = MIDI note 0, item 128 = MIDI note 127.
strcpy(#note_menu, "");
_nmi = 0;
loop(128,
  _nms = _nmi % 12;
  _oct = (_nmi / 12 | 0) - 1;
  _nms==0?strcpy(#_nm_tmp,"C"):_nms==1?strcpy(#_nm_tmp,"C#"):
  _nms==2?strcpy(#_nm_tmp,"D"):_nms==3?strcpy(#_nm_tmp,"D#"):
  _nms==4?strcpy(#_nm_tmp,"E"):_nms==5?strcpy(#_nm_tmp,"F"):
  _nms==6?strcpy(#_nm_tmp,"F#"):_nms==7?strcpy(#_nm_tmp,"G"):
  _nms==8?strcpy(#_nm_tmp,"G#"):_nms==9?strcpy(#_nm_tmp,"A"):
  _nms==10?strcpy(#_nm_tmp,"A#"):strcpy(#_nm_tmp,"B");
  _nmi > 0 ? strcat(#note_menu, "|");
  sprintf(#_nm_entry, "%s%d (%d)", #_nm_tmp, _oct, _nmi);
  strcat(#note_menu, #_nm_entry);
  _nmi += 1;
);

// DSP functions defined in rk_drumkit_dsp.jsfx-inc:
//   freq_to_norm, norm_to_freq, apply_vel_curve, get_rpt_interval,
//   recalc_pad, recalc_fx, recalc_global_fx

// ─── Init DSP coefficients ──────────────────────────────────────────────
i = 0; loop(NUM_SLOTS, recalc_pad(i); i += 1;);
i = 0; loop(NUM_SLOTS, recalc_fx(i); i += 1;);
recalc_global_fx();
// Snap SVF filters to their freshly computed targets — @init must not
// glide up from the unity reset above (silent/wrong EQ on load).
i = 0; loop(NUM_SLOTS * SVF_PER_PAD,
  svf_snap(svf_pad + i * SVF_STEREO_SIZE);
  i += 1;
);
i = 0; loop(SVF_MST_COUNT, svf_snap(svf_master + i * SVF_STEREO_SIZE); i += 1;);
_last_root = root_note;
_last_gvol = global_vol;

// Pre-render col_rgba so the pad face has valid colors from frame 0.
// Without this, an FX window opened before the first @gfx tick (or
// before col_dirty=1 from @serialize triggers a rebuild) showed pads
// as dark gray (col_rgba zeroed by swing_color_init's memset). The
// chunk reload still sets col_dirty=1 in @serialize, so the next
// @gfx tick will re-render with saved kit values; this is just the
// safety floor.
swing_color_rebuild();

// ─── Instance registry — claim slot at @init (transport-independent) ────
// Originally lived in @block, but @block doesn't fire reliably until
// audio starts flowing through the FX chain (REAPER's silence detection
// + transport-stopped behavior). That left _reg_my_slot at -1 on a
// fresh open with no audio item on the track — and
// swing_block_pitch_tick()'s publish path gates on _reg_my_slot == 0.
// Result: Tuned mode silently no-op'd until the user pressed play, which
// is the symptom we chased on 2026-05-27/28.
//
// Moved to @init because:
//   * @init runs exactly once per instance (the ext_noinit = 1.0 set at
//     the top of @init
//     suppresses the documented "transport-start re-init" behavior).
//   * time_precise() and gmem[] are both available in @init per the docs.
//   * The claim survives transport state transitions because it lives
//     in gmem, not in re-zeroed instance memory.
//   * @slider always fires after @init, so the very next user
//     interaction publishes immediately via the existing
//     swing_block_pitch_tick() call at the bottom of @slider.
//
// Belt-and-suspenders: also fires one swing_block_pitch_tick() at the
// end of @init so a fresh-load-restored-state path (kit + Tuned mode
// already set via @serialize, nothing for @slider to react to) still
// publishes its initial protocol seed without waiting for user input.
// Atomic registry claim — writes our instance_id + heartbeat the instant a
// slot is chosen (swing_registry_claim, rk_swing_block_pitch.jsfx-inc), so a
// peer instance opening at the same time sees the slot taken. Closes the
// TOCTOU gap that let 2+ instances claim the SAME slot on project-open →
// multi-instance Tuned bake thrash. (Was an inline scan that set the slot but
// deferred the id/heartbeat write to @block.)
// _reg_claim_now: @init claims are taken on the spot (no interleaving on the
// main thread); only @block re-claims wait out GS_INST_REG_SETTLE.
_reg_claim_now = 1;
swing_registry_claim();
_reg_claim_now = 0;

// The spot map's epoch and identity seed (rk_swing_block_pitch.jsfx-inc; the arrays are allocated above with
// sp_src_gen). Before the publisher below, which reads pr_pad / sp_pub_gen.
swing_spot_init();

// Belt-and-suspenders publish-from-@init — see note above. Safe to call
// here because @init has finished setting up freemem arrays + constants,
// the registry claim above has run, and swing_block_pitch_tick reads
// only constants + gmem + freemem state that is fully initialised by
// this point.
swing_block_pitch_tick();

// ─── Slider recalc ────────────────────────────────────────────────────────
@slider
// Convert master_db (slider unit: dB, range -48..+12) to global_vol
// (linear amplitude, used directly in @sample). exp(x * 0.11512925465) =
// pow(10, x / 20) — EEL has no log10/pow10 so we use the ln equivalent.
// At -48 dB or below (knob minimum), snap to true silence.
global_vol = master_db <= -48 ? 0 : exp(master_db * 0.11512925465);

// Only do full recalc when root_note or global_vol actually change.
// slider3 (changed flag) is toggled by every UI interaction — running
// recalc_pad × 16 + recalc_fx × 16 on each one tanks the frame rate.
// Per-pad callers already call recalc_pad(i) themselves.
root_note != _last_root || global_vol != _last_gvol ? (
  i = 0; loop(NUM_SLOTS, recalc_pad(i); recalc_fx(i); i += 1;);
  steal_coeff = exp(-1.0 / max(1, 0.005 * srate));
  syn_quiet_n = 0.06 * srate;

  recalc_global_fx();
  _last_root = root_note;
  _last_gvol = global_vol;
);

// @slider invocation of the v3 declarative publisher. One of the four
// publish contexts (@init/@slider/@block/@gfx-idle) — together they keep the
// per-pad bands fresh in every transport / window state.
// It reads the spot map (pr_pad, sp_pub_gen, sp_row) as @block last left it, on purpose: the map has one writer,
// @block's swing_spot_tick, and @block's own publish runs BEFORE that tick too, so this republish is never staler
// than @block's (section_order_check flags it as "read in @slider, written only in @block"; accepted 2026-10-12).
// The same for sp_swap_done (the publish holds while a pad swap waits for that tick): @block's last value is the point.
swing_block_pitch_tick();


// ─── Block: MIDI + DSP dirty ──────────────────────────────────────────────
@block
// EON_DIAG: arm state + block-entry stamp. The PREVIOUS block's cost is closed
// out at the publish site near the end of @block (its last @sample stamped
// diag_t1). Unarmed: one gmem read, one branch.
diag_t0_prev = diag_t0;
diag_armed = gmem[EON_DIAG_BASE] > 0.5;
diag_armed ? diag_t0 = time_precise();

// Sliced loader budget for this block (cells). Re-read every block so a
// device buffer change is followed immediately.
ldr_budget = min(LDR_BUDGET_MAX, max(LDR_BUDGET_MIN, samplesblock * LDR_CELLS_PER_SPL));
// Sliced undo-capture budget (cells), same treatment: re-read every block so a
// device buffer change is followed immediately.
_udo_cow_budget = min(UDO_COW_MAX, max(UDO_COW_MIN, samplesblock * UDO_COW_PER_SPL));
// The pad-audio compaction job (rk_swing_alloc, banks step 2a): one locked step per block
// while a load is waiting for room that only packing the area can free.
alc_req ? swing_alloc_compact_tick();
// The backing self-check's second pass (rk_swing_alloc): at block 10 re-read the pool pages no
// allocation has reached; a marker that did not survive the frames lowers the pool's top.
alc_bk_frame < 10 ? ( alc_bk_frame += 1; alc_bk_frame == 10 ? swing_alloc_backing_recheck(); );

// The UI thread's recalc requests, performed here before anything launches or
// publishes this block (A-9a; the request counters are described at kmac_rcp).
swing_block_rcp_settle();

// ─── Master comp voice ─────────────────────────────────────────────────────
// A change between ENGINES starts the incoming one clean (Weld's bypass path
// proved the pattern: a stale capacitor charge is a thump). Black <-> Blue is
// not an engine change -- Anvil walks that with its own 4 ms crossfade -- so
// it only re-pushes. The first block after load records and pushes, no reset.
cmp_voice != _cmp_voice_seen ? (
  _cmp_voice_seen >= 0 && (cmp_voice > 0) != (_cmp_voice_seen > 0) ? (
    cmp_voice > 0 ? anv_engine_reset() : cmp_reset();
  );
  _cmp_voice_seen = cmp_voice;
  swing_comp_anvil_push();
);
cmp_voice > 0 ? anv_engine_block();   // srate follow, pot inertia, recalc requests

// The registry latch is re-validated BEFORE the slot-keyed publishers below (the
// master link, the stretch control, the patch ring, the strip band): an instance
// waking from a background project tab otherwise wrote one block into the new
// owner's bands and consumed the new owner's Drum Strip edit (C-3, audit C
// 2026-09-14). swing_registry_claim() further down still runs it first and
// re-acquires a slot the way it did.
swing_registry_check_owner();

// ── Master link: publish the output stage for EON Output (Multi-Out) ──
// Every block, five cells, heartbeat last. Standalone-cheap; Output reads it
// only when it has our instance id baked in by the bridge.
_reg_my_slot >= 0 ? (
  _ml_b = EON_MASTER_LINK + _reg_my_slot * EON_MASTER_LINK_STRIDE;
  gmem[_ml_b + 1] = master_db;
  gmem[_ml_b + 2] = gfx_lim_on;
  gmem[_ml_b + 3] = gfx_lim_thr;
  gmem[_ml_b + 4] = gfx_lim_rel;
  // +5..+12: the eight macros, for the EON Macros relays on the pad tracks
  // (REAPER parameter links only join plugins on one track). +13..+31 are the
  // LEARN mailbox (face/bridge) and are never written here.
  gmem[_ml_b + 5]  = macro1; gmem[_ml_b + 6]  = macro2;
  gmem[_ml_b + 7]  = macro3; gmem[_ml_b + 8]  = macro4;
  gmem[_ml_b + 9]  = macro5; gmem[_ml_b + 10] = macro6;
  gmem[_ml_b + 11] = macro7; gmem[_ml_b + 12] = macro8;
  _ml_hb += 1;
  gmem[_ml_b + 0] = _ml_hb;   // LAST
);

// ── Comp link: watch the audio-bus Weld's row (the READ half) ───────────────
// Liveness is the heartbeat MOVING, not the heartbeat being nonzero. gmem
// persists across plugin reloads and project switches, so a row left behind by
// a deleted Audio folder reads "alive" forever on a value test — the same trap
// the strip takeover answers with a moving-heartbeat test, and the same shape here.
// The GR cell is foreign memory. A NaN passes every comparison in EEL2, so both
// guards are written in the POSITIVE form: require the good case, the way the
// kit loader's lua_len guard does, instead of testing for the bad ones.
_reg_my_slot >= 0 ? (
  _bcl_b  = GS_BC_LINK_BASE + (_reg_my_slot + GS_BC_LINK_ROW_BUS) * GS_BC_LINK_STRIDE;
  // The row moved under us -- a slot re-claim after an id collision. The
  // baseline below belongs to the OLD row, and a new row measured against it
  // reads as movement, which is the same false-life bug by another door. Go
  // back to unbaselined. EON_Tone.jsfx clears _tn_cmd_inited on a slot change
  // for this reason; this is that idiom on the reading side.
  _bcl_b != _bcl_row_last ? ( _bcl_row_last = _bcl_b; _bcl_hb_prev = -1; _bcl_stall = 1000; );
  _bcl_hb = gmem[_bcl_b + BCL_OFF_HB];
  _bcl_hb != _bcl_hb ? _bcl_hb = _bcl_hb_prev;   // NaN reads as "changed" forever
  // ⚠️⚠️ THE FIRST READING IS A BASELINE, NOT A SIGN OF LIFE. _bcl_hb_prev
  // starts at -1, so the opening read of an UNTOUCHED row (0) differed from it
  // and reset the stall -- declaring an empty row live for the ~100 blocks it
  // takes to expire again. That is long enough for the adopt below to fire and
  // pull nine zeroes into the master compressor: threshold 0, ratio 1, mix 0,
  // voice reset -- and mark_dirty_kit() then lights SAVE over the wreckage, so
  // the next save writes it to disk. Nor is it only the no-Weld case: on a cold
  // start gmem is zeroed and this runs upstream of the Audio folder, so the
  // INTENDED rig can read the row before Weld's first @block too.
  // Take the reading, leave the stall where it is, and wait for the value to
  // MOVE -- only a running Weld can do that. Weld writes its echo before its
  // heartbeat, so one movement is enough: the values beside it are already real.
  // -1 is a safe sentinel -- Weld bumps a counter up from 0 and never writes it.
  _bcl_hb != _bcl_hb_prev ? (
    _bcl_hb_prev == -1 ? _bcl_hb_prev = _bcl_hb                  // baseline only
                       : ( _bcl_hb_prev = _bcl_hb; _bcl_stall = 0; );
  ) : ( _bcl_stall < 1000 ? _bcl_stall += 1 );
  // ⚠️⚠️ !patch_live IS LOad-BEARING, not defensive. Under Wired the pads are
  // shifted up one bus and channels 0/1 carry the loopback SUM, so the master
  // section there is processing the whole instrument and is exactly where it
  // belongs. Gating only on multi_out would take the master compressor out of
  // Wired entirely and hand the needle a folder's reading while Swing's own
  // comp was the one working.
  bcl_live = multi_out && !patch_live && _bcl_stall < 100 ? 1 : 0;
  bcl_live ? (
    // Prefer the DEEPEST reduction in the block over the snapshot beside it.
    // +9 is written in @block, so it holds whatever the last sample happened to
    // be doing: on a fast transient the real depth is over before Weld's @block
    // looks, and this needle read shallower than Weld's own. +13 is the minimum
    // tracked across the block, and it is already linear, so no conversion.
    // ⚠ The dialect cell is what makes the fallback safe. A missing +13 reads as
    // gmem's zero, and zero means TOTAL reduction — the needle would slam and
    // stay there against an older Weld. Same lesson as the strip band's mask
    // version: publish the dialect, never infer it from the value.
    gmem[_bcl_b + BCL_OFF_GRVER] >= 1 ? (
      _bcl_gl = gmem[_bcl_b + BCL_OFF_GRMIN];
      !(_bcl_gl >= 0 && _bcl_gl <= 1) ? _bcl_gl = 1;
      bcl_gr_lin = _bcl_gl;
    ) : (
      _bcl_db = gmem[_bcl_b + BCL_OFF_GR];
      !(_bcl_db <= 0 && _bcl_db >= -60) ? _bcl_db = 0;
      // dB -> linear ONCE per block. exp() is banned in @sample; the needle is
      // fed this as a constant across the block, which is what it wants anyway
      // (rk_vu_sample_gr keeps the deepest reading per decimation window).
      bcl_gr_lin = exp(_bcl_db * 0.11512925465);
    );
  ) : ( bcl_gr_lin = 1; );

  // What the bridge says is on the folder. Its scan has its own heartbeat, on
  // the same moving-not-nonzero test as above, so a stale cell from a project
  // that is no longer open cannot masquerade as a live report.
  _rck_b  = GS_STRIP_BASE + _reg_my_slot * GS_STRIP_STRIDE;
  _rck_hb  = gmem[_rck_b + GS_STRIP_OFF_RACK_HB];
  _rck_now = time_precise();
  _rck_hb != _rck_hb ? _rck_hb = _rck_hb_prev;
  // ⚠️⚠️ WALL CLOCK, NOT A BLOCK COUNT. This expired after 300 @blocks, chosen
  // as "about three of the bridge's ~1 s scans" -- but a block is not a fixed
  // slice of time. At 44.1k/512 the guess holds (3.5 s); at 48k/64 there are
  // 750 blocks in a second, so 300 was 0.4 s and the rack expired BETWEEN two
  // perfectly healthy scans. bcl_foreign then flapped at about 1 Hz, and every
  // time it fell Swing's own compressor switched back into circuit on OUT 1 --
  // and since the bypass branch reseats both engines on the way out, each
  // re-entry started from clean capacitors. The comment already reasoned in
  // seconds; this makes the code do the same. time_precise() is legal here
  // (@block -- it is @sample that is barred).
  // The first reading is a BASELINE, the same rule as the link heartbeats
  // above: stamp the clock only once the value has actually MOVED, or an
  // untouched cell would read fresh for the whole first RCK_STALE_S.
  // No row-change guard here, unlike the two links: the ENG cell beside this
  // is re-read every block, so a slot re-claim costs at most one optimistic
  // window and the next real scan corrects it.
  // ⚠️ HELD WHILE THE TRANSPORT RUNS, as the strip takeover is (2026-10-23):
  // the bridge's scan is a defer script and none runs in a render (wiki 7.6),
  // so RCK_STALE_S into every bounce Swing's own compressor came back on OUT 1
  // behind the folder's. A rack seen while playing stays seen until a stop, and
  // a play / render start re-arms it when a scan really moved in the last
  // STRIP_HB_REARM_S (the render's own preparation stalls the main thread; the
  // strip read below has the story).
  _rck_hb != _rck_hb_prev ? (
    _rck_hb_prev == -1 ? _rck_hb_prev = _rck_hb                  // baseline only
                       : ( _rck_hb_prev = _rck_hb; _rck_t = _rck_now; _rck_mv_t = _rck_now; );
  ) : (
    (play_state & 1) && (bcl_foreign || (!_rck_play_prev && _rck_now - _rck_mv_t < STRIP_HB_REARM_S)) ? _rck_t = _rck_now;
  );
  _rck_play_prev = play_state & 1;
  // A rack is present, and it is not answering our link: a stock comp, an FX
  // chain, an Anvil, or something dropped in by hand. Our own compressor is
  // just as wrong here as it is with a Weld — in Multi-Out it only ever reaches
  // the pad on OUT 1 — but there is no gain reduction to borrow, so the needle
  // rests and the page says so instead of implying it is in charge.
  // ⚠ Engine 0 means the folder has NO comp: that is the build where the bus
  // compressor box was left unticked, and there Swing's own stage is the only
  // one there is. It keeps running, exactly as it always has.
  // ⚠ Seconds here, blocks for Weld above, and the difference is the point:
  // Weld bumps its heartbeat every @block, so a hundred blocks of silence is
  // a hundred of ITS missed turns however long they took -- same clock, so a
  // count is the honest unit. The bridge scans on a wall-clock timer that
  // knows nothing about the buffer, so measuring it in blocks compares two
  // different clocks. That is what broke at small buffers.
  bcl_foreign = multi_out && !patch_live && _rck_now - _rck_t < RCK_STALE_S &&
                gmem[_rck_b + GS_STRIP_OFF_RACK_ENG] >= 1 && !bcl_live ? 1 : 0;
) : ( bcl_live = 0; bcl_gr_lin = 1; bcl_foreign = 0; );

// ── Comp link: the COMP page drives the audio-bus Weld ──────────────────────
// One param per block, round-robin over the nine. Weld consumes exactly one
// mailbox edit per block, so posting faster would only be dropped and posting
// slower would lag a drag.
//
// ⭐ THE POST CONDITION IS "THE ECHO DOES NOT AGREE", not "the value changed".
// That one choice removes a whole class of bugs and needs no bookkeeping at all:
//   · Weld ADOPTS the first seq it ever sees WITHOUT acting on it — a stale
//     mailbox must never fire — so a fire-and-forget first post is swallowed in
//     silence. Here the echo simply stays wrong and the next pass asks again.
//   · A command dropped for any other reason retries by itself.
//   · A Weld arriving with its own settings (inserted by hand, or riding in on
//     a track template) is pulled into line without anyone detecting "new".
//   · Nothing is ever resent once it agrees, which matters because Weld calls
//     slider_automate on every value it consumes: a needless resend writes an
//     automation point and an undo step, per block, for as long as the link is up.
// Agreement is judged within the param's OWN step, because Weld's sliders
// quantize what they are handed and an exact compare would repost for ever.
// Written in the positive form, so a NaN echo reads as "not agreed" and asks
// again rather than passing as agreement.
// ⛔ No give-up timeout. Strip_Sync's comment says why: a timeout that lets the
// unconfirmed side win is how a control appears to "revert on its own" later.
bcl_live ? (
  // ⚠️ WHILE LINKED THE VOICE IS WELD. An INVARIANT asserted every block, not a
  // one-shot: the forcing below runs only on first sight, and _bcl_primed is
  // session-scoped ON PURPOSE (see its comment -- re-arming it on the heartbeat
  // returning would let a rack that went quiet for a moment stomp the page).
  // That left a trap. Link up, leave Multi-Out, pick BLACK or BLUE while the
  // chips are live, come back: first sight has already happened, so the page
  // keeps the Anvil voice, and the chips are gated on !bcl_live
  // (rk_swing_ui_panels_lcd.jsfx-inc:939) so WELD cannot be picked back. A page
  // of knobs writing cmp_anv_*, which this link does not carry and nothing on
  // the bus reads, and the only escape was to leave Multi-Out -- which nothing
  // said. Asserting it costs one compare a block and cannot stomp anything: the
  // nine VALUES are untouched, and while linked the user has no way to have set
  // this deliberately. Gated on _bcl_primed so first sight still does it once,
  // in one dirty tag, instead of tagging twice in the same block.
  // Delta audit 2026-09-20.
  _bcl_primed && cmp_voice != 0 ? (
    cmp_voice = 0;
    swing_rcp_post_cmp();
    _kd_site = 8; mark_dirty_kit();   // NOT a gesture, same as first sight
  );
  !_bcl_primed ? (
    // ── FIRST SIGHT: the rack wins, once ──────────────────────────────────
    // Somebody who dialled the Weld on their folder by hand — before this link
    // existed, or through its mixer embed — must not have it overwritten the
    // instant Swing notices it. So the first connection reads the folder and
    // adopts it wholesale, and only then does the page take ownership.
    // Scoped to the SESSION, deliberately NOT to the heartbeat returning: if a
    // stall re-armed this, a rack that went quiet for a moment would stomp the
    // page every time it came back. Weld writes its echo before its heartbeat,
    // so seeing the heartbeat move means the echo beside it is already real.
    _bcl_i = 1;
    loop(9,
      _bcl_ec = gmem[_bcl_b + bcl_eoff(_bcl_i)];
      abs(_bcl_ec) <= 100000 ? bcl_set(_bcl_i, _bcl_ec);   // positive form: NaN skipped
      _bcl_eprev[_bcl_i] = _bcl_ec;
      _bcl_lprev[_bcl_i] = bcl_get(_bcl_i);
      _bcl_wait[_bcl_i]  = 0;
      _bcl_i += 1;
    );
    // The VOICE is adopted too, by the same rule and for a harder reason than
    // the nine values: what is in circuit on the folder is a Weld, because Weld
    // is the only comp that can follow this link at all. A page left showing an
    // Anvil voice would draw the Anvil face and the Anvil knob set, and every
    // knob turned on it would write cmp_anv_* — parameters this link does not
    // carry and nothing on the bus reads. The chips are inert while linked for
    // the same reason. ⭐ Both go away when Weld carries the three voices
    // itself (decided 2026-09-20) and the voice becomes another posted value.
    cmp_voice = 0;
    _bcl_primed = 1;
    swing_rcp_post_cmp();
    _kd_site = 8; mark_dirty_kit();   // NOT a gesture -- tag it, or _kd_src reads 1000
  ) : (
    _bcl_p  = _bcl_tx + 1;
    _bcl_ep = bcl_eps(_bcl_p);
    _bcl_ec = gmem[_bcl_b + bcl_eoff(_bcl_p)];
    _bcl_lv = bcl_get(_bcl_p);

    _bcl_wait[_bcl_p] ? (
      // ── A post of ours is out and unconfirmed ───────────────────────────
      // While it is, the row is NEVER allowed to drive this page. Forward-
      // pushing here is exactly what yanked a fader backwards mid-drag in the
      // strip sync: during a drag we post a chain of values and the echo trails
      // the newest one, so an echo read as an edit is our own past.
      !(abs(_bcl_lv - _bcl_sent[_bcl_p]) <= _bcl_ep) ? (
        // Still moving — refresh the payload rather than waiting on a stale one.
        _bcl_sent[_bcl_p] = _bcl_lv;
        _bcl_lprev[_bcl_p] = _bcl_lv;
        gmem[_bcl_b + BCL_OFF_VAL]   = _bcl_lv;
        gmem[_bcl_b + BCL_OFF_PARAM] = _bcl_p;
        _bcl_seq += 1;
        gmem[_bcl_b + BCL_OFF_SEQ]   = _bcl_seq;   // LAST
      ) : abs(_bcl_ec - _bcl_sent[_bcl_p]) <= _bcl_ep ? (
        _bcl_wait[_bcl_p]  = 0;                    // landed
        _bcl_eprev[_bcl_p] = _bcl_ec;
      ) : (
        // Not landed. Ask again — Weld ADOPTS the first seq it ever sees
        // without acting on it, so the opening post of a link is always
        // swallowed, and any other drop deserves the same treatment.
        // ⛔ No give-up timeout: one that lets the unconfirmed side win is how
        // a control appears to "revert on its own" minutes later.
        // ⚠️⚠️ REWRITE THE PAYLOAD, NOT JUST THE SEQ. PARAM and VAL are ONE
        // mailbox shared by all nine, and the round-robin has visited up to
        // eight other params since this one posted. A seq-only bump re-sends
        // whoever wrote the mailbox LAST -- so the dropped edit never lands,
        // its wait flag never clears, and because a pending wait also bars the
        // row from driving this page, that control is locked one-way for good.
        // With no give-up timeout there is nothing downstream to catch it.
        gmem[_bcl_b + BCL_OFF_VAL]   = _bcl_sent[_bcl_p];
        gmem[_bcl_b + BCL_OFF_PARAM] = _bcl_p;
        _bcl_seq += 1;
        gmem[_bcl_b + BCL_OFF_SEQ]   = _bcl_seq;   // LAST
      );
    ) : (
      // ── Nothing outstanding: whoever moved since the last look wins ──────
      _bcl_em = !(abs(_bcl_ec - _bcl_eprev[_bcl_p]) <= _bcl_ep);   // the folder moved
      _bcl_lm = !(abs(_bcl_lv - _bcl_lprev[_bcl_p]) <= _bcl_ep);   // this page moved
      _bcl_em ? (
        // ADOPT. On a genuine tie — both moved inside the same window — the
        // rack wins, deterministically, and the page converges next pass. The
        // guarantee worth having is determinism, not a verdict on who was right.
        bcl_set(_bcl_p, _bcl_ec);
        _bcl_eprev[_bcl_p] = _bcl_ec;
        _bcl_lprev[_bcl_p] = bcl_get(_bcl_p);
        swing_rcp_post_cmp();
        _kd_site = 8; mark_dirty_kit();   // a rack edit is a kit edit: undoable, lights SAVE
      ) : _bcl_lm ? (
        gmem[_bcl_b + BCL_OFF_VAL]   = _bcl_lv;
        gmem[_bcl_b + BCL_OFF_PARAM] = _bcl_p;
        _bcl_seq += 1;
        gmem[_bcl_b + BCL_OFF_SEQ]   = _bcl_seq;   // LAST
        _bcl_sent[_bcl_p]  = _bcl_lv;
        _bcl_wait[_bcl_p]  = 1;
        _bcl_lprev[_bcl_p] = _bcl_lv;
      );
    );
    _bcl_tx += 1; _bcl_tx >= 9 ? _bcl_tx = 0;
  );
) : ( _bcl_tx = 0; );

// ── EON Tone link: the EQ and drive pages drive the Audio folder ────────────
// The same machinery as the comp link above — thirteen params instead of nine,
// and a contiguous echo run with no GR cell interrupting it. Everything the
// long comment up there explains about liveness being MOVEMENT, the echo being
// the only confirm, never letting the row drive while a post is outstanding,
// first sight belonging to the rack, and the absence of a give-up timeout
// applies here word for word. The recalc request is the master one rather than
// the comp one, because these thirteen feed the five-band SVF and the saturator.
_reg_my_slot >= 0 ? (
  _tnl_b  = GS_STRIP_BASE + _reg_my_slot * GS_STRIP_STRIDE;
  _tnl_b != _tnl_row_last ? ( _tnl_row_last = _tnl_b; _tnl_hb_prev = -1; _tnl_stall = 1000; );
  _tnl_hb = gmem[_tnl_b + TNL_OFF_HB];
  _tnl_hb != _tnl_hb ? _tnl_hb = _tnl_hb_prev;
  // ⚠️⚠️ Baseline, not life -- the comp link's copy of this carries the full
  // reasoning. Worse here than there: thirteen zeroes through tnl_set() put the
  // master LPF at its floor of 1 kHz with meq_bypass off, so an empty row does
  // not quietly flatten the compressor, it drops a blanket over the instrument.
  _tnl_hb != _tnl_hb_prev ? (
    _tnl_hb_prev == -1 ? _tnl_hb_prev = _tnl_hb                  // baseline only
                       : ( _tnl_hb_prev = _tnl_hb; _tnl_stall = 0; );
  ) : ( _tnl_stall < 1000 ? _tnl_stall += 1 );
  tnl_live = multi_out && !patch_live && _tnl_stall < 100 ? 1 : 0;
  tnl_live ? (
    !_tnl_primed ? (
      _tnl_i = 1;
      loop(TNL_NPARAM,
        _tnl_ec = gmem[_tnl_b + tnl_eoff(_tnl_i)];
        tnl_echo_ok(_tnl_i, _tnl_ec) ? tnl_set(_tnl_i, _tnl_ec);
        _tnl_eprev[_tnl_i] = _tnl_ec;   // baselined even when refused, so a peer
                                        // that STARTS publishing Q later still
                                        // reads as a move and gets adopted
        _tnl_lprev[_tnl_i] = tnl_get(_tnl_i);
        _tnl_wait[_tnl_i]  = 0;
        _tnl_i += 1;
      );
      _tnl_primed = 1;
      swing_rcp_post_master();
      _kd_site = 9; mark_dirty_kit();   // NOT a gesture -- tag it, or _kd_src reads 1000
    ) : (
      _tnl_p  = _tnl_tx + 1;
      _tnl_ep = tnl_eps(_tnl_p);
      _tnl_ec = gmem[_tnl_b + tnl_eoff(_tnl_p)];
      _tnl_lv = tnl_get(_tnl_p);
      _tnl_wait[_tnl_p] ? (
        !(abs(_tnl_lv - _tnl_sent[_tnl_p]) <= _tnl_ep) ? (
          _tnl_sent[_tnl_p]  = _tnl_lv;
          _tnl_lprev[_tnl_p] = _tnl_lv;
          gmem[_tnl_b + TNL_OFF_VAL]   = _tnl_lv;
          gmem[_tnl_b + TNL_OFF_PARAM] = _tnl_p;
          _tnl_seq += 1;
          gmem[_tnl_b + TNL_OFF_SEQ]   = _tnl_seq;
        ) : abs(_tnl_ec - _tnl_sent[_tnl_p]) <= _tnl_ep ? (
          _tnl_wait[_tnl_p]  = 0;
          _tnl_eprev[_tnl_p] = _tnl_ec;
        ) : _tnl_p >= 14 && _tnl_wait[_tnl_p] >= TNL_Q_TRIES ? (
          // A Q param pushed TNL_Q_TRIES times with no echo: this peer predates ser_ver 75 and will never echo
          // 14..18 (tnl_echo_ok's rule, on the push side too; 2026-10-16). Stop asking: the five Q values stay
          // Swing's own until an echo arrives after all or the peer changes (a heartbeat gap clears _tnl_noq).
          _tnl_wait[_tnl_p] = 0;
          _tnl_noq = 1;
        ) : (
          // ⚠️⚠️ Rewrite the payload too -- the comp link's copy of this branch
          // carries the reasoning. One mailbox, THIRTEEN params round-robining
          // through it, so the window for a seq-only retry to re-send someone
          // else's value is wider here than there.
          gmem[_tnl_b + TNL_OFF_VAL]   = _tnl_sent[_tnl_p];
          gmem[_tnl_b + TNL_OFF_PARAM] = _tnl_p;
          _tnl_seq += 1;
          gmem[_tnl_b + TNL_OFF_SEQ]   = _tnl_seq;   // LAST
          _tnl_wait[_tnl_p] += 1;   // the retry count (1 = the push itself); only the Q params act on it
        );
      ) : (
        _tnl_em = !(abs(_tnl_ec - _tnl_eprev[_tnl_p]) <= _tnl_ep);
        _tnl_lm = !(abs(_tnl_lv - _tnl_lprev[_tnl_p]) <= _tnl_ep);
        _tnl_em ? (
          // ⚠️ _tnl_eprev is updated OUTSIDE the adopt, or a refused echo leaves
          // _tnl_em true and this param spins on a value we will never take.
          tnl_echo_ok(_tnl_p, _tnl_ec) ? (
            tnl_set(_tnl_p, _tnl_ec);
            _tnl_lprev[_tnl_p] = tnl_get(_tnl_p);
            swing_rcp_post_master();
            _kd_site = 9; mark_dirty_kit();   // a rack edit is a kit edit: undoable, lights SAVE
            _tnl_p >= 14 ? _tnl_noq = 0;      // the peer speaks Q after all
          );
          _tnl_eprev[_tnl_p] = _tnl_ec;
        ) : _tnl_lm ? (
          _tnl_noq && _tnl_p >= 14 ? (
            _tnl_lprev[_tnl_p] = _tnl_lv;   // a peer that does not speak Q: Swing's own value stands, nothing is sent
          ) : (
            gmem[_tnl_b + TNL_OFF_VAL]   = _tnl_lv;
            gmem[_tnl_b + TNL_OFF_PARAM] = _tnl_p;
            _tnl_seq += 1;
            gmem[_tnl_b + TNL_OFF_SEQ]   = _tnl_seq;
            _tnl_sent[_tnl_p]  = _tnl_lv;
            _tnl_wait[_tnl_p]  = 1;
            _tnl_lprev[_tnl_p] = _tnl_lv;
          );
        );
      );
      _tnl_tx += 1; _tnl_tx >= TNL_NPARAM ? _tnl_tx = 0;
    );
  ) : ( _tnl_tx = 0; _tnl_noq = 0; );   // a heartbeat gap (a new Tone, a bypass) starts the Q question over
) : ( tnl_live = 0; );

// Master limiter release: the face writes gfx_lim_rel (ms); the one-pole
// coefficient is derived HERE, once per change, never on the gfx thread.
// (It used to be computed only at srate changes -- the value had no knob.)
gfx_lim_rel != _lim_rel_seen ? (
  _lim_rel_seen = gfx_lim_rel;
  gfx_lim_rel_c = exp(-1.0 / max(1, gfx_lim_rel * 0.001 * srate));
);

// ── Swing Pitch (Part B): heartbeat + per-pad gmem writes ──
// See libs/rk_swing_block_pitch.jsfx-inc. Runs FIRST so subsequent code
// can rely on sp_pitch_ext_alive being current for this audio cycle.
// Mirrored from @slider above — that's the transport-independent path; this
// one is the audio-rate cadence for heartbeat + PDC target snapshot.
swing_block_pitch_tick();
// The spot handshake with the Kit Bridge: the map, the answer, the SRCGEN order and the Stretch hold
// (Plan_Swing_Pad_Banks_Tuned §5A.5, §5A.3; step 3). @block only -- the map has one writer.
swing_spot_tick();

// Instant-tune one-shot: on the first @block after load, treat the current
// (restored) buffer as baked at the live p_tune so the residual starts at 0.
// Thereafter sp_baked_tune is updated only when a buffer arrives (CMD-65 swap)
// — so any p_tune move shows up immediately as a varispeed residual in the
// voice loop, instead of waiting ~70 ms for the next bake to be delivered.
_baked_tune_synced == 0 ? (
  _bt_i = 0;
  loop(NUM_SLOTS,
    // Every layer of the restored buffer is baked at the saved p_tune, so seed
    // all MAX_LAYERS anchors — otherwise layers 1+ would residual-repitch the
    // already-pitched restored audio on the first trigger after load.
    // Only a pad in TUNED can hold a bake, and only one whose audio has not come through the loader
    // since @init (sp_src_gen is zeroed at @init and bumped at the end of every loader pad load): an
    // embedded @serialize read restores what was saved -- a Tuned pad's bake -- while a path reload
    // (the no-embed marker save) and every pad out of Tuned hold the ORIGINAL. Seeding those too (until
    // 2026-10-01) marked original audio as baked: CMD 66 refused a layered pad's capture (a Stretch
    // pad's source never came back after a reopen) and a Tuned pad played it unpitched (the step A
    // self-audit; EON_Probe_PitchA RO). An unseeded pad keeps @init's 0.
    swing_pitch_eff(_bt_i) == SP_PITCH_MODE_TUNED && sp_src_gen[_bt_i] == 0 ? (
      _bt_l = 0;
      loop(MAX_LAYERS,
        sp_baked_tune[_bt_i * MAX_LAYERS + _bt_l] = p_tune[_bt_i];
        _bt_l += 1;
      );
    );
    _bt_i += 1;
  );
  _baked_tune_synced = 1;
);

// Step 4: PDC declaration. swing_block_pitch_tick() above publishes the
// target into sp_pitch_pdc_target (Extension-written budget when any pad
// is in Mode=Stretch; 0 otherwise or when ext_alive is stale). We apply
// the assignment HERE in @block — the .jsfx-inc cannot host pdc_* writes
// per audit-jsfx, and one assignment per actual change keeps REAPER from
// buffer-flushing every tick. Channel range pdc_bot_ch=0, pdc_top_ch=2
// covers the main stereo bus; pdc_midi=1 compensates incoming MIDI too
// so triggers stay phase-aligned with the audible output.
// Patchbay liveness, folded in before the PDC decision below because the
// loopback's buffer only counts while a Patchbay is actually returning audio.
// ⚠️ The registry slot is claimed LOWER DOWN in @block than this runs, so on the
// block a slot is first claimed _reg_my_slot is still the old value here. Left
// unguarded that is not merely stale: slot 0's ring belongs to a DIFFERENT
// Swing, and this would drain that instance's pads into ours for a block.
// Recompute only on a real slot, and treat a slot change as a fresh producer.
_reg_my_slot >= 0 ? (
  _patch_slot_now = swing_patch_base(_reg_my_slot);
  _patch_slot_now != _patch_base ? (
    _patch_base     = _patch_slot_now;
    _patch_rpos     = 0;
    _patch_hb_prev  = -1;
    _patch_hb_stall = PATCH_HB_STALL_MAX;
  );
);
_patch_hb = _reg_my_slot >= 0 ? gmem[_patch_base + PATCH_OFF_HB] : _patch_hb_prev;
// The producer ran the last block ON THIS RING: its heartbeat moved since our last reading of the same ring (the
// first reading after a slot change has no previous one: -1). The re-aim and the drain below need this.
_patch_hb_ran = (_patch_hb_prev >= 0 && _patch_hb != _patch_hb_prev) ? 1 : 0;
// ...and MORE than the one block since: the producer ran blocks this plugin did not. Swing bypassed -- its @block
// stops, and with ext_noinit its re-enable re-runs nothing -- while the Patchbay runs on: its write cursor walked
// on, ours stood, so draining on would play the whole kit that many blocks late until the next restart. A
// re-aim (the trigger below; 2026-10-12, the user: "Yes fix what you found as well").
_patch_hb_skip = (_patch_hb_ran && (_patch_hb | 0) - (_patch_hb_prev | 0) > 1) ? 1 : 0;
_patch_hb != _patch_hb_prev ? ( _patch_hb_prev = _patch_hb; _patch_hb_stall = 0; )
                            : ( _patch_hb_stall < PATCH_HB_STALL_MAX ? _patch_hb_stall += 1; );
// The ring's LAYOUT (Outputs step 5), named by the producer in the header's NCH cell every block: PATCH_CHANS =
// the new layout; PATCH_CHANS_V1, or 0 from a Patchbay too old to stamp it, = the old one, drained as before with
// the old routing (swing_out_wired v2 = 0). Anything else is a layout this build does not know: not live, so a
// mismatched pair can never read each other's channels as pads. A block the ring in force cannot hold would let
// the producer lap the read cursor inside one block: not live either, Swing sums internally (the Patchbay drops
// to the deeper old layout on its own when a block outgrows the new one, so this is the last guard).
_patch_nch = _reg_my_slot >= 0 ? (gmem[_patch_base + PATCH_OFF_NCH] | 0) : 0;
// ...and the new layout only from the Patchbay beating now: it writes its heartbeat into NCH_HB with HB every block.
// An older Patchbay bumps HB alone, so a 62 another Patchbay left in NCH cannot stand for it (review 2026-10-12).
_patch_v2_now = (_patch_nch == PATCH_CHANS
                 && (gmem[_patch_base + PATCH_OFF_NCH_HB] | 0) == (_patch_hb | 0)) ? 1 : 0;
// A 62 its NCH_HB does not vouch for is a stamp an earlier, newer Patchbay left on this ring: the producer beating now
// stamps no layout of its own (older than step 5's), so it rings the old one -- drained as such, not refused as an
// unknown layout (Codex audit 2026-10-13: Swing summed internally and the inserts went silent). A step-5 Patchbay
// writes NCH, HB and NCH_HB together every block, so a 62 of its own always matches.
_patch_known = _patch_v2_now || _patch_nch == PATCH_CHANS_V1 || _patch_nch == 0 || _patch_nch == PATCH_CHANS;
_patch_v2_now != patch_v2 ? ( patch_v2 = _patch_v2_now; _patch_layout_chg = 1; );
patch_cols_live = patch_v2 ? PATCH_PCOLS  : PATCH_PCOLS_V1;
patch_stride    = patch_v2 ? PATCH_CHANS  : PATCH_CHANS_V1;
patch_depth     = patch_v2 ? PATCH_FRAMES : PATCH_FRAMES_V1;
patch_live = (patch_on && _reg_my_slot >= 0 && _patch_hb_stall < PATCH_HB_STALL_MAX && _patch_known
              && samplesblock <= patch_depth) ? 1 : 0;

// ── Re-aim the read cursor: a fresh producer, or our own draining resuming ──
// The two cursors are private and neither reads the other (see PATCH_OFF_GEN),
// so they hold their one-block spacing only while BOTH keep advancing. Ours
// advances only while patch_live; the producer's advances whenever the Patchbay
// runs. Any gap therefore leaves us a permanent, arbitrary distance behind --
// wrong latency or stale audio for as long as Wired stays on, with PDC still
// declaring one block. Both triggers below mean "the distance is now unknown":
//   - the producer's incarnation changed (a new Patchbay -- which is what Wired
//     off/on does, the bridge deletes and re-adds it -- or a relink), or
//   - we were not draining last block and are now (a heartbeat stall coming
//     back, the switch toggled with the Patchbay left in place, engine pauses).
// Re-aiming takes ONE block: hold this one (the return is silent for about a
// buffer -- what a Wired transition sounds like anyway, and far better than
// replaying whatever stale ring content we would otherwise land on), then aim.
// Except when the producer restarted while we were draining and has ALREADY
// written its first whole block since (below): then we aim at once.
_patch_gen_now = _reg_my_slot >= 0 ? (gmem[_patch_base + PATCH_OFF_GEN] | 0) : 0;
//   - the ring's layout changed (step 5: the Patchbay moved between the old and the new layout);
//   - the producer ran blocks we did not (_patch_hb_skip: Swing itself was bypassed);
// A change of BLOCK LENGTH is no trigger: the read window is anchored on the producer's cursor every block (below).
patch_live && (!_patch_live_prev || _patch_gen_now != _patch_gen_seen || _patch_layout_chg || _patch_hb_skip) ? (
  _patch_gen_seen = _patch_gen_now;
  _patch_lat = 0;   // this incarnation's latency starts over at the length of the block it is aimed on
  // Aim at once (1) when we were draining last block, the producer ran it on this ring (_patch_hb_ran), the ring's
  // layout is the one we read last block, and the producer has already written this incarnation's first whole
  // block: a restart puts WPOS back to 0, so WPOS >= samplesblock means [WPOS - samplesblock, WPOS) is all new.
  // That is PLAY START: REAPER re-runs the Patchbay's @init at every play start (wiki 3.2), and runs it AFTER this
  // plugin has processed the first block, so holding here dropped exactly the first block played -- a hit on the
  // play cursor lost its start, and its sends with it (measured 2026-10-12, EON_Probe_WiredBanks Z; older than
  // step 5). Otherwise hold one block (2), as before: our own draining resuming, a producer that has not written
  // a block yet, and a LAYOUT change -- the block before it left this plugin routed for the other layout (under
  // the old one channels 38..63 are not cleared, so their input would be drained onto the bus), and a layout
  // read from another Patchbay's stamp would drain the block at the wrong stride; the hold gives the producer a
  // block to re-stamp it (review 2026-10-12). A skip holds too: the producer's last block rang what passed through
  // the bypassed Swing (the track's input), not Swing's output; the next block aims at Swing's first block back.
  _patch_prime = (_patch_live_prev && _patch_hb_ran && !_patch_layout_chg && !_patch_hb_skip
                  && (gmem[_patch_base + PATCH_OFF_WPOS] | 0) >= samplesblock) ? 1 : 2;
  _patch_layout_chg = 0;
);
_patch_live_prev = patch_live;
// Only on a block the producer ran (else wait in 1): a stalled producer's WPOS ends frames written blocks ago.
_patch_prime == 1 && _patch_hb_ran ? _patch_prime = 0 : _patch_prime == 2 ? _patch_prime = 1;
// ...and only on a block the producer ran: no frames came in while its heartbeat stood still (the Patchbay
// bypassed -- REAPER stops its @block -- or gone), so draining walked the read cursor past the stopped write
// cursor into frames a ring's depth old: a few blocks of stale audio replayed for as long as patch_live held
// (PATCH_HB_STALL_MAX), and, had the producer come back without a restart, the two cursors a wrong distance apart
// for good. Frozen instead: those blocks return silence and the distance holds (2026-10-12, the user: "Fix it").
patch_drain = (patch_live && !_patch_prime && _patch_hb_ran) ? 1 : 0;
// The read window, anchored on the producer's cursor EVERY block (2026-10-16): [WPOS - lat, WPOS - lat + samplesblock),
// the frames the producer wrote `lat` frames ago, where lat is the longest block seen since the aim (the device's,
// in practice) and the latency pdc_delay declares below. Until today the cursor was aimed once, at WPOS minus that
// block's length, and then walked on its own: the two cursors kept their spacing in frames of the block the aim was
// made on, while the claim followed the length of the block of the moment. REAPER DOES hand the chain odd-length
// blocks at a loop wrap (measured, EON_Probe_WiredBlk, REAPER 7.82: 63 blocks of 8..1016 frames among 383 through
// thirty wraps of a 11.27-block loop -- and none at all in the run before on the same loop, so the condition is
// not known; the Codex audit of 2026-10-13 had asked for the measurement). Each odd block moved the claim, REAPER
// answered every move with a re-plan of its delay compensation, and the kit sat a part-block off the beat while it
// did. Anchored here the reads stay contiguous across any length, and the claim is the one number `lat`. A block
// longer than lat (never seen; a device change is a restart and re-aims) raises lat and moves the claim once.
patch_drain ? (
  samplesblock > _patch_lat ? _patch_lat = samplesblock;
  _patch_rpos = (gmem[_patch_base + PATCH_OFF_WPOS] | 0) - _patch_lat;
  _patch_rpos < 0 ? _patch_rpos += patch_depth;
  _patch_rpos = max(0, min(patch_depth - 1, _patch_rpos));
);
// Publish the read cursor. The protocol has always documented this cell as
// "consumer (Swing) writes" and nothing ever did -- which is the same omission
// as the bug above, stated in the header. One write per block, from @block (the
// CONS_HB precedent right below). Nothing consumes it yet; it is what makes the
// cursor distance observable, so a probe can prove the loop is one block deep
// instead of assuming it (.dev_tests/EON_Probe_WiredRing_probe.lua).
_reg_my_slot >= 0 ? gmem[_patch_base + PATCH_OFF_RPOS] = _patch_rpos;
// Tell the Patchbay we are reading (its "Swing is reading the ring" lamp):
// a counter in the ring header, bumped every block the loopback is live.
// The same counter into PATCH_OFF_CONS_V2 (step 5): the proof a new Patchbay waits for before it rings the new
// layout. An older Swing writes CONS_HB only, and its Patchbay keeps the old layout.
patch_live ? ( _patch_cons_hb += 1; gmem[_patch_base + PATCH_OFF_CONS_HB] = _patch_cons_hb;
               gmem[_patch_base + PATCH_OFF_CONS_V2] = _patch_cons_hb; );

// A LIVE switch-on points every pad at its own bus, exactly as the multi-out
// build does when it adopts (p_output[i] = i). Only on a real 0->1 edge seen
// while running: the first @block after a load just records the value, so a
// project restoring patch_on=1 keeps whatever routing it saved. No mark_dirty,
// for the same reason the multi-out adopt has none (user policy 2026-08-11:
// session routing is not a kit-content edit).
_patch_on_seen < 0 ? (
  _patch_on_seen = patch_on;
) : (
  patch_on && !_patch_on_seen ? (
    _po_i = 0; loop(NUM_SLOTS, p_output[_po_i] = swing_out_default(_po_i); _po_i += 1;);   // step 2b: bus = position in the bank (a bank-track / split choice stays: Outputs step 2)
  );
  _patch_on_seen = patch_on;
);

// The loopback is exactly ONE buffer of round trip -- measured, not assumed
// (.dev_tests/EON_Probe_ChainRT_*, 2026-09-06: max delay equalled max block
// size to the sample). Undeclared it would make the whole kit play a buffer
// late against everything else in the project. Added to the Stretch budget
// rather than replacing it: a kit can be running both at once.
_pdc_want = sp_pitch_pdc_target + (patch_live ? max(_patch_lat, samplesblock) : 0);   // lat: the anchored window's depth (above); the block's length until the first aim
// The claim reaches every channel a pad or a send can leave on: 64 under the new layout (measured 2026-10-12:
// claimed, a pair above 38 comes back in one block like bank A's; left outside the claim it came back a second
// block late), 38 under the old one, 0..1 outside Wired.
_pdc_top_want = patch_live ? (patch_v2 ? 64 : 38) : 2;
// ...and whenever REAPER's copy differs from it: a change of the track's channel count while Swing runs resets this
// plugin's pdc_* to 0 (measured 2026-10-12, EON_Probe_WiredBanks test 5: pdc_delay and pdc_top_ch read 0 after the
// track grew 38 -> 44, and the kit played a block late until Wired was switched off and on). The cache above
// alone never saw it.
_pdc_want != sp_pitch_pdc_applied || _pdc_top_want != _pdc_top_applied
  || pdc_delay != _pdc_want || pdc_top_ch != _pdc_top_want ? (
  pdc_delay   = _pdc_want;
  pdc_bot_ch  = 0;
  // Channels OUTSIDE the declared range are "synchronized by the host": REAPER
  // delays them by pdc_delay to line up with the ones the plugin delays. In
  // Wired that would delay the pad pairs on their way OUT to the inserts, so
  // the return came back two buffers late while one was declared and the kit
  // played a buffer behind the project. Under Wired every channel is claimed:
  // the pairs never reach the output anyway (the Patchbay zeroes them), and
  // the main bus really is one buffer late. Stereo and Multi-Out keep 0..1.
  pdc_top_ch  = _pdc_top_want;
  pdc_midi    = 1;
  sp_pitch_pdc_applied = _pdc_want; _pdc_top_applied = _pdc_top_want;
);

// ── Audio-engine gap detector — see rk_swing_block.jsfx-inc ──
swing_block_gap_flush();

// Detect sample-rate change and recompute coefficients
swing_block_handle_srate_change();
// Lazy FX recalc when any tracked param drifted — see rk_swing_block.jsfx-inc
swing_block_sync_fx_params();

// Reverb block-rate LFO update
rvb_tick();

// Delay block-rate tempo follow. ⚠️ Without this the send delay keeps whatever
// tempo was current the last time a delay parameter moved — dly_recalc() reads
// `tempo` but was only ever called from the param handlers and @init, so a
// project tempo change silently left the delay mistimed (fixed 2026-08-26).
dly_tick();

// Recompute any_solo
any_solo = 0;
i = 0; loop(NUM_SLOTS, p_solo[i] ? any_solo = 1; i += 1;);   // step 2b: solo is global across the banks (Spec_Swing_Pad_Banks 4.3)

// Mute and solo take effect NOW, not at the next trigger (user, 2026-09-23: "mute
// should mute instantly"; until then a muted one-shot finished playing). The block a
// pad becomes effectively muted -- its own M, or someone else's S, from any surface
// (pad, console, a companion's INCMD, a kit load) -- its sounding voices go to a fast
// release and a Stretch pad's drain fades, the way a choke does. Un-muting resumes
// nothing: a one-shot already cut stays cut; the next trigger plays.
_mute_i = 0; loop(NUM_SLOTS,
  _mute_eff = (p_mute[_mute_i] || (any_solo && !p_solo[_mute_i])) ? 1 : 0;
  _mute_eff && !_mute_eff_prev[_mute_i] ? swing_voice_silence_pad(_mute_i);
  _mute_eff_prev[_mute_i] = _mute_eff;
  _mute_i += 1;
);

// The pad high-water mark (banks step 2b). The per-pad FX loop in @sample runs to pad_hi, not
// to NUM_SLOTS, so an idle instrument pays for the pads that sound, not for four banks. A pad
// is AWAKE while a voice of its is live (set here from the voice table, and by
// launch_voices_for_pad_ofs the moment one starts, so a hit in this block is heard in this
// block), while it is a Stretch pad (the ring drain feeds it), and until process_pad_fx finds it
// silent -- that clears the flag in @sample, after the FX tail has rung out.
// A pad asleep at the start of the block is not visited in @sample at all (the awake list, built at the end of
// @block): its meter falls here at block rate (the same curve) and pad_fx_snap puts its pan and drive smoothers on
// their targets. Before 2026-10-11 only the pads @sample still visited were snapped, so a pan or drive moved while a
// pad slept above the mark swept across the first ~8 ms of its next hit when that hit landed at a block start (a
// click, a trigger): measured right/left 0.589 on a hard-left pad (EON_Probe_SwingSound).
// ...and the VOICE high-water mark (step 2c): the @sample voice loop runs to v_hi, not V_SLOTS
// (the steal-fade slots included). Set here from the table -- a voice retired in @sample lowers
// it next block -- and raised at once where a voice starts (the two v_stage = 1 gates in
// rk_swing_core) and where a stolen voice is parked in a fade slot, before the gate opens.
v_hi = 0;
_ph_i = 0; loop(V_SLOTS,
  v_stage[_ph_i] > 0 ? (
    v_hi = _ph_i + 1;
    // ...and the voice's block constants (phase V): the buffer pointer, the trim bounds and the sum gate follow
    // the pad / layer tables once per block here, not once per sample in the loop (swing_voice_prep).
    v_slot[_ph_i] >= 0 ? ( pad_awake[v_slot[_ph_i]] = 1; swing_voice_prep(_ph_i); );
  );
  _ph_i += 1;
);
// sixteen: the Stretch rings are the spots' -- each spot's owner, any bank, kept awake while it is a Stretch pad (the
// ring drain in @sample feeds it, and its audio lands a block after the trigger, by when process_pad_fx has put the
// pad back to sleep). The same test as the drain and _any_stretch. Until 2026-10-15 this was bank A's sixteen by index
// (4a.1), left so when Pad Banks step 4 (3409dd01) lent the spots to every bank: a bank B..D pad playing through a
// lent spot fell asleep after its trigger block and its stretched audio was never heard (EON_Probe_BanksUI note 55,
// silent on HEAD since then).
_ph_i = 0; loop(NUM_PADS, _ph_p = pr_pad[_ph_i]; _ph_p >= 0 && sp_pitch_mode[_ph_p] == SP_PITCH_MODE_STRETCH ? pad_awake[_ph_p] = 1; _ph_i += 1;);   // sixteen: one per spot, its owner any bank
pad_hi = 0; _ph_i = 0; loop(NUM_SLOTS, pad_awake[_ph_i] ? pad_hi = _ph_i + 1; _ph_i += 1;);
_pmd_blk = pow(_pad_meter_decay, samplesblock);
_ph_i = 0; loop(NUM_SLOTS,
  !pad_awake[_ph_i] ? ( pad_meterL[_ph_i] *= _pmd_blk; pad_meterR[_ph_i] *= _pmd_blk; pad_fx_snap(_ph_i, samplesblock); );   // a block of comp release too (H18)
  _ph_i += 1;
);

// ── Idle smoother snap ──
// When no audio is playing, snap master-volume + saturator-drive smoothers
// directly to their slider targets so the first hit doesn't get attenuated
// by a 22ms _sm_coeff ramp. Without this, a fresh JSFX insert (or a render
// that starts cold with global_vol != 1.0) plays its first kick through a
// rising master-volume ramp — visible as a smaller transient on hit 1 in
// the rendered waveform vs hits 2..N. Smoothers only resume during active
// audio (voices alive or crossfade running) where the ramp prevents
// zipper noise on live slider moves.
voices_alive == 0 && !_xf_active ? (
  _vol_sm     = global_vol;
  _sat_drv_sm = gfx_sat_drv;
);

// Clear per-pad dedup flags (prevents double-triggers within the same @block)
memset(_blk_trig, 0, NUM_SLOTS);
// The voice schedule (chokes, note-off releases) starts empty, before this block's first
// launch or note-off (rk_swing_core).
swing_voice_sched_flush();
memset(_blk_off,  0, NUM_SLOTS);
memset(_blk_last_off, 0, NUM_SLOTS);

// Decrement transport grace counter (blocks note-offs for 2 blocks after transport start)
_transport_grace > 0 ? _transport_grace -= 1;

// Reset held state on transport start (prevents stale repeats from previous playback)
_prev_play_state != play_state && (play_state & 1) && !(_prev_play_state & 1) ? (
  memset(p_held, 0, NUM_SLOTS);
  rpt_counter = 0;
  _transport_grace = 2;  // suppress note-offs for 2 blocks after transport start
);
// Release all voices on transport stop (ext_tail_size = -1 keeps DSP alive,
// so voices in sustain/attack/decay would hold forever without this).
_prev_play_state != play_state && !(play_state & 1) && (_prev_play_state & 1) ? (
  memset(p_held, 0, NUM_SLOTS);
  rpt_counter = 0;
  i = 0; loop(V_SLOTS,
    v_stage[i] > 0 && v_stage[i] < 4 ? v_stage[i] = 4;
    i += 1;
  );
);
_prev_play_state = play_state;

// Retrigger lockout window for duplicate-kill inside launch_voices_for_pad.
// Only used for voice cleanup, NOT as a note-on gate.
_retrig_lockout = max(samplesblock * 2, (srate * 0.01)|0);

// 2C "chance" controller: Steppa writes its probability lane into the item as CC 119
// (the last undefined controller) on the step, ahead of that step's notes. One CC =
// one roll, shared by every note-on at the same sample offset -- Steppa's own die is
// per STEP, not per pad, and this matches it. Reset per block so a stale roll can
// never reach a later block's notes.
// ⭐ Consumed ONLY when it gated a pad note (2026-09-13, Design_CC119_Probability_Carrier
// option A). It used to be eaten always, so a controller or recorded automation on
// CC119 never reached the next plugin. Now it is HELD: a pad note-on at the same
// offset marks it used; before the first event at a later offset, and after the loop,
// an unused one is forwarded at its own offset (output stays in offset order). With
// midi_thru everything is forwarded at once, as before.
_prob_off = -1;
_prob_held = 0;

while(midirecv(offset, msg1, msg2, msg3)) (
  status = msg1 & 0xF0;
  _midi_consumed = 0;  // track whether Swing eats this event
  _seq_echo = 0;       // S6: the step sequencer's drum mirror coming back (a loopback send): swallowed whole, never a pad nor THRU
  // Settle a held CC119 once the events have moved past its offset (or before a
  // second CC119 at the same offset replaces it).
  _prob_held && (offset != _prob_off || (status == 0xB0 && msg2 == 119)) ? (
    !_prob_used ? midisend(_prob_off, _prob_msg1, 119, _prob_val);
    _prob_held = 0;
  );
  status == 0xB0 && msg2 == 119 ? (
    _prob_off  = offset;
    _prob_skip = rand(127) > msg3;   // Steppa plays a step when rand(127) <= its value
    _midi_consumed = 1;
    !midi_thru ? ( _prob_held = 1; _prob_used = 0; _prob_msg1 = msg1; _prob_val = msg3; );
  );
  status == 0x90 && msg3 > 0 ? (
    // The drum mirror's own echo (S6): a note on the mirror's channel within a quarter second of its mirror going out
    // is the loopback of that mirror -- swallowed, or a send back into Swing would double every hit
    _seq_echo = (msg1 & 0x0F) == (seq_opt_midich | 0) - 1 && seq_echo_is(1, msg2, offset); _seq_echo ? _midi_consumed = 1;
    // The step sequencer's MIDI trigger (rk_seq_core seq_trig_note; S3): a note in the trigger range picks a
    // pattern and is eaten here, before the pad lookup -- it never plays a pad (a pending LEARN takes the note first).
    _seq_trig_hit = midi_learn_pad < 0 && !_seq_echo && seq_trig_note(msg2, offset);
    _seq_trig_hit ? _midi_consumed = 1;
    // MIDI learn: assign note to pad. The learned note becomes the pad's ROOT;
    // the range offsets (p_rng_lo/hi) are relative to it, so the range
    // auto-re-centers — no extra work needed here.
    midi_learn_pad >= 0 && !_seq_echo ? (
      p_note[midi_learn_pad] = msg2;
      p_note_lock[midi_learn_pad] = 1;
      mark_dirty_kit();
      midi_learn_pad = -1;
      _midi_consumed = 1;
    );
    // Find pad by note — specificity-first (see Spec_Pad_Note_Ranges §3.1):
    // Pass 1 prefers an exact single-note (drum) pad (no range offsets);
    // Pass 2 falls through to the first range (chromatic) pad whose
    // [p_note-lo, p_note+hi] contains the note. The pad<0 guard keeps
    // lowest-index-wins as the same-class tiebreaker. When every pad has
    // 0/0 offsets (default), Pass 1 == today's single equality check.
    // Banks (step 2b, Spec_Swing_Pad_Banks 4.3): both passes run over every slot of every
    // bank, and a pad that is NOT PLAYABLE claims no note -- so an empty bank-B pad on 52
    // cannot shadow a bank-A range that reaches 52. A note aimed only at empty pads passes
    // downstream like any unmapped note (the lookup used to consume it, then block it).
    pad = -1;
    !_seq_trig_hit && !_seq_echo ? (
      i = 0; loop(NUM_SLOTS,
        pad < 0 && p_rng_lo[i] == 0 && p_rng_hi[i] == 0 && p_note[i] == msg2 && pad_is_playable(i) ? pad = i;
        i += 1;
      );
      pad < 0 ? (
        i = 0; loop(NUM_SLOTS,
          pad < 0 && msg2 >= p_note[i] - p_rng_lo[i] && msg2 <= p_note[i] + p_rng_hi[i] && pad_is_playable(i) ? pad = i;
          i += 1;
        );
      );
    );
    pad >= 0 ? (
      _midi_consumed = 1;  // this note belongs to a Swing pad — eat it
      _prob_off == offset ? _prob_used = 1;   // 2C: the roll gated a pad note -- keep it consumed
      _blk_last_off[pad] = 0;  // last event for this pad this block is now a note-ON (held)
      // Playable, not audio: an enabled SYN slot triggers from MIDI too
      blocked = p_mute[pad] || (any_solo && !p_solo[pad]) || !pad_is_playable(pad) || s_skip[pad]
                || (_prob_off == offset && _prob_skip);   // 2C: this step's chance roll said no
      // Dedup (_blk_trig): a pad's first trigger in the block always plays. A later one
      // plays too when it starts LATER in the block -- a flam or a ratchet inside one
      // buffer used to be dropped whole (measured 2026-09-30: every same-block pair lost
      // its second hit, at 64 and at 1024) -- except on a Stretch pad, whose Extension
      // services one trigger per buffer. The same sample again is a duplicate: dropped.
      // Cross-block duplicates: the duplicate-kill in the choke pass, which runs at the
      // new hit's own sample (swing_voice_choke_at).
      !blocked && (!_blk_trig[pad] || (offset > _blk_trig_ofs[pad] && swing_pitch_eff(pad) != SP_PITCH_MODE_STRETCH)) ? (
        // Start ON the note: `offset` samples into the block, the negative-v_pos wait
        // note repeat already uses. Launched at 0, every MIDI hit sounded early by its
        // offset -- up to a whole buffer, a different amount each hit (measured
        // 2026-09-30). 8192 is note repeat's cap too: the renderer's pending test
        // stops at v_pos -9999.
        launch_voices_for_pad_ofs(pad, msg2, msg3, 8, min(offset, 8192));
        p_held[pad] = 1; p_held_vel[pad] = msg3; p_held_note[pad] = msg2;
        // Seed pressure from the strike. At 0 a controller that sends no
        // aftertouch would collapse every repeat to velocity 1 the moment
        // PRESSURE was turned up; seeded, it is simply a no-op.
        p_press[pad] = msg3;
        _blk_trig[pad] = 1;
        _blk_trig_ofs[pad] = offset;
      );
    );
  );
  // Channel pressure ($xD0, value in msg2) and poly aftertouch ($xA0, note in
  // msg2 / value in msg3) feed the repeat velocity when PRESSURE is up -- lean
  // on a held pad and the roll swells. Observed only, never consumed, so
  // anything downstream still sees them.
  status == 0xD0 ? (
    i = 0; loop(NUM_SLOTS, p_held[i] ? p_press[i] = msg2; i += 1;);
  );
  status == 0xA0 ? (
    i = 0; loop(NUM_SLOTS,
      p_held[i] && msg2 >= p_note[i] - p_rng_lo[i] && msg2 <= p_note[i] + p_rng_hi[i] ?
        p_press[i] = msg3;
      i += 1;
    );
  );

  // Note-off: trigger release (skip for one-shot pads)
  (status == 0x80 || (status == 0x90 && msg3 == 0)) ? (
    _seq_echo = (msg1 & 0x0F) == (seq_opt_midich | 0) - 1 && seq_echo_is(0, msg2, offset); _seq_echo ? _midi_consumed = 1;   // S6: the mirror's note-off back
    // A trigger note's note-off is eaten too (S3): it releases no pad and goes nowhere downstream.
    _seq_trig_off = seq_trig_in_range(msg2);
    _seq_trig_off ? _midi_consumed = 1;
    // Match note to pads, clear held state, record note-off (single pass).
    // Range-aware: any pad whose [lo,hi] contains the released note clears its
    // held state. No early-exit — overlapping pads each track their own state.
    // The per-VOICE release below matches v_note==msg2 (v_note now holds the
    // PLAYED note, set in launch_voices_for_pad), so a chord on a chromatic
    // pad releases the right voice, not all of them.
    i = 0; loop(NUM_SLOTS,
      !_seq_trig_off && !_seq_echo && msg2 >= p_note[i] - p_rng_lo[i] && msg2 <= p_note[i] + p_rng_hi[i] ? (
        // eaten only by a pad that would have taken the note-on (a PLAYABLE one, as the note-on lookup): an empty
        // pad's note-on passes downstream, and eating its note-off left the note hanging there (the audit, 2026-10-22)
        pad_is_playable(i) ? _midi_consumed = 1;
        !_blk_trig[i] && _transport_grace == 0 ? ( p_held[i] = 0; );
        _transport_grace == 0 ? ( _blk_off[i] = 1; _blk_last_off[i] = 1; );  // last event for this pad this block is now a note-OFF
      );
      i += 1;
    );
    // Release voices — but skip pads in one-shot mode, and ignore note-offs while the
    // transport has just started (_transport_grace): REAPER may send chase note-offs in the
    // first 1-2 blocks after play starts.
    // The release happens AT the note-off's sample (swing_voice_release_at), and it takes
    // exactly the voices that exist when the note-off is read: a note begun earlier -- in an
    // earlier block, or earlier in this one and still waiting for its own offset -- sounds
    // until here; a note-on read after this note-off (a step sequencer's off-then-on at one
    // tick) is untouched. It used to act at the block's first sample, and a pad triggered
    // in this block (_blk_trig) was left to the deferred release below, which put a note
    // that began and ended inside one block into release before its first sample: gate-mode
    // notes shorter than a buffer were silent, longer ones were cut up to a buffer short.
    // A note that starts ON this note-off's sample is not ended by it either
    // (swing_voice_started_before): a note-on can reach the plugin just ahead of the
    // previous note's note-off on the same sample.
    i = 0; loop(V_SLOTS,
      !_seq_trig_off && !_seq_echo && v_note[i] == msg2 && v_stage[i] > 0 && v_stage[i] < 4 && swing_voice_started_before(i, offset) ? (
        _eos = p_oneshot[v_slot[i]];
        (_eos == 0 || (_eos < 0 && !oneshot_global)) && _transport_grace == 0 ? (
          swing_voice_release_at(i, offset);
        );
      );
      i += 1;
    );
  );
  // Only forward MIDI that Swing did not consume (CC, pitchbend, non-pad notes).
  // When midi_thru (slider22) is on, forward EVERYTHING — including pad-mapped
  // notes — so a downstream Swing on the same FX chain can layer the same hit.
  (!_midi_consumed || midi_thru) && !_seq_echo ? midisend(offset, msg1, msg2, msg3);   // S6: the mirror's echo goes nowhere
);
// 2C: a CC119 still held at the end of the block gated nothing -- pass it on.
_prob_held && !_prob_used ? midisend(_prob_off, _prob_msg1, 119, _prob_val);
_prob_held = 0;

// ─── Browser pad trigger: play pad from browser click ──────────────────
// Gate on _is_browser_target() so a pad click in the browser fires only
// the targeted instance — not every Swing on every track that happens to
// be reading the same gmem slot. Without this, clicking pad 1 in the
// browser made pad 1 fire on every Swing in the project.
// ─── Browser per-pad actions: RETIRED (P4) ─────────────────────────────
// The browser now posts mute/solo/note/reverse to this instance's INCMD
// mailboxes (consumed in the adopt block above with identical side
// effects), so pad actions are per-instance and undo-correct without the
// browser-target gate or the shared 2620-2622 slots.

// ─── Pad FX panel: FX param write-back (external ReaImGui window → JSFX) ────
// Mirrors the per-pad action channel above but for continuous FX params.
// Applies one (pad, param, value) write per consume, then rebuilds coefs and
// marks the pad dirty exactly like the overlay's own FX edits — so the change
// is audible immediately and persists via @serialize + undo. Browser-target
// instance only (single writer/consumer; avoids multi-instance races).
_is_browser_target() ? (
  _fa_pad = gmem[GS_FX_ACTION_PAD] | 0;
  _fa_pad >= 0 && _fa_pad < NUM_SLOTS ? (   // the picker echoes GS_FX_SEL_PAD: an absolute pad (step 4a)
    swing_fx_apply(_fa_pad, gmem[GS_FX_ACTION_PARAM] | 0, gmem[GS_FX_ACTION_VALUE]);
    gmem[GS_FX_ACTION_PAD] = -1;  // consume
  );
);

// ─── Kit-macro engine tick (slice 1) ──────────────────────────────────────
// After the Pad-FX mailbox consume, before strip publish, so a macro move
// lands in this block's strip mirror. Change-detected inside — idle cost is
// eight compares. See kmac_* in @init.
kmac_tick();

// ─── Strip-sync (Path B): publish, mailbox, takeover ──────────────────────
// Per-instance band at GS_STRIP_BASE + slot*STRIDE (see @init for layout).
// No browser-target gate — each instance owns its own child tracks. Guarded
// on a claimed registry slot (-1 until the claim/reclaim path runs).
_reg_my_slot >= 0 ? (
_strip_b = GS_STRIP_BASE + _reg_my_slot * GS_STRIP_STRIDE;

// Lua heartbeat freshness: the sync script bumps LUA_HB once per defer tick
// (~30 Hz) while it runs. Still for STRIP_HB_STALE_S ⇒ takeover off ⇒ internal
// per-pad FX resume — the failsafe when the script is closed/crashed.
// ⚠️⚠️ WALL CLOCK, NOT A BLOCK COUNT (the rack read above has the story). This
// was `100 blocks`: 33 ms at 48k/16, 9 s at 44.1k/4096, so at small buffers an
// ordinary main-thread stall dropped takeover and every pad ran its FX, gain and
// pan twice (Swing's, then the strip's).
// ⚠️⚠️ HELD WHILE THE TRANSPORT RUNS. No defer script runs during ANY render
// (wiki 7.6), and a render reads play_state 1 like playback, so to Swing every
// render looks like a dead script: about 0.1-2 s into each bounce the pads took
// their FX back while the strips kept theirs. The user's call (2026-10-23):
// the strips stay in charge while playing, recording or rendering, and Swing
// takes the pads back only after a stop, once the script has really gone quiet.
// A live takeover restamps the clock every block while play_state & 1; a
// takeover that is off stays off until the heartbeat moves -- except at the
// START of playback: a render begins with the transport stopped and the main
// thread busy preparing it (no defer runs), and the rig measured that gap past
// 1 s on a loaded machine (EON_Probe_G1 A.4, 2026-10-23), so the takeover fell
// just before the bounce and the whole render ran with Swing's own FX on top of
// the strips'. So a play / render start re-arms when the script was really heard
// from (a MOVE, not a held block) in the last STRIP_HB_REARM_S; a script quiet
// for longer stays given up. (Whether REAPER runs defer scripts while its own
// Render dialog is open is not measured; a user who sits in it past
// STRIP_HB_REARM_S starts the render with Swing's FX.)
// The first reading is a BASELINE (wiki 5.8): a cell left behind by a script
// that has since closed must not read fresh, so only a MOVE stamps the clock.
// A new registry row re-baselines, as the links do.
_strip_b != _strip_hb_row ? ( _strip_hb_row = _strip_b; _strip_hb_prev = -1; );
_strip_hb = gmem[_strip_b + GS_STRIP_OFF_LUA_HB];
_strip_hb != _strip_hb ? _strip_hb = _strip_hb_prev;   // NaN reads as "changed" forever
_strip_now = time_precise();
_strip_play = play_state & 1;
_strip_hb != _strip_hb_prev ? (
  _strip_hb_prev == -1 ? _strip_hb_prev = _strip_hb                  // baseline only
                       : ( _strip_hb_prev = _strip_hb; _strip_hb_t = _strip_now; _strip_hb_mv_t = _strip_now; );
) : (
  _strip_play && (strip_takeover || (!_strip_play_prev && _strip_now - _strip_hb_mv_t < STRIP_HB_REARM_S)) ?
    _strip_hb_t = _strip_now;
);
_strip_play_prev = _strip_play;
strip_takeover_new = multi_out && _strip_now - _strip_hb_t < STRIP_HB_STALE_S;
strip_takeover_new != strip_takeover ? (
  strip_takeover = strip_takeover_new;
  // Toggling takeover instantly reroutes the FX chain: clear the residual
  // trackers so pad-sleep detection doesn't hold pads awake on stale state.
  _sp_i = 0; loop(NUM_PADS,   // bank A: the Drum Strips are bank A's lanes (Pad Banks step 5a)
    _sp_i_s = _sp_i;
    fx_hpf_stL[_sp_i_s] = 0; fx_hpf_stR[_sp_i_s] = 0;
    fx_lpf_stL[_sp_i_s] = 0; fx_lpf_stR[_sp_i_s] = 0;
    _sp_i += 1;
  );
);

// PER-PAD takeover. A pad whose Drum Strip the user replaced keeps its FX,
// gain and pan INSIDE Swing while the other pads stay on their strips; the
// sync script publishes the live-strip mask (bit i = pad i).
// A pad whose bit flips gets its filter residue cleared, as the global toggle does.
//
// ⚠⚠ 0 IS AMBIGUOUS WITHOUT THE DIALECT FLAG. A script that predates the mask
// never wrote the cell, so 0 there means "no information" and has to widen to
// all sixteen or every pad's strip stops being honoured. But the current script
// writes 0 to mean "NO pad has a live strip" -- delete every Drum Strip and it
// says so honestly. Widening THAT handed all sixteen pads to strips that do not
// exist, so they ran unprocessed until the stale-heartbeat failsafe caught it
// later (and, since the transport hold, not before a stop). MASK_VER >= 1 says the writer speaks the explicit dialect;
// only below that is 0 widened.
_strip_mask = gmem[_strip_b + GS_STRIP_OFF_ALIVE_MASK] | 0;
_strip_mask == 0 && gmem[_strip_b + GS_STRIP_OFF_MASK_VER] < 1 ? _strip_mask = 65535;
// ⚠ Bit i is the strip fed from OUTPUT PAIR i (strip sync maps Swing's sends by source channel), not pad i's
// strip. A pad hands its chain, pan and gain over only while it plays through its OWN strip: a bank A pad on its
// own pair (Pad Banks Outputs 5a). Pointed at another pad's pair or a bank track, its own strip never hears it,
// and handing over took its effects away -- or ran it through the other lane's settings. Such a pad keeps them
// inside Swing; sharing a pair still means passing through that pair's strip as well.
// Banks B..D (2026-10-15): the same rule for the ten split pairs -- a split pair's owner hands over while it plays on
// that pair and the pair's track carries a live strip (the split band's mask). Worked out first, so the bank A loop
// below takes it in for a bank A pad that owns a split pair, and the loop after it for the other banks' slots.
memset(strip_spl_want, 0, NUM_SLOTS);
_ssb = GS_SPLIT_BASE + _reg_my_slot * GS_SPLIT_STRIDE;
_ss_mask = gmem[_ssb + GS_SPLIT_OFF_MASK] | 0;
_ss_k = 0; _ss_bit = 1;
loop(OUT_PAIRS - OUT_PAIR_SPLIT,
  _ss_o = strip_spl_own[_ss_k];
  strip_takeover && _ss_o >= 0 && (_ss_mask & _ss_bit) && swing_out_pair(_ss_o) == OUT_PAIR_SPLIT + _ss_k ?
    strip_spl_want[_ss_o] = 1;
  _ss_k += 1; _ss_bit *= 2;
);
_sp_i = 0; _sp_bit = 1;
loop(NUM_PADS,   // bank A: the strips' dry mask is bank A's pads (step 5a) -- B..D pads hand over through a split pair only
  _sp_i_s = _sp_i;
  _sp_tk = (strip_takeover && (_strip_mask & _sp_bit) && swing_out_pair(_sp_i_s) == _sp_i) ? 1 : 0;
  strip_spl_want[_sp_i_s] ? _sp_tk = 1;   // a bank A pad that owns a split pair, on it
  _sp_tk != strip_tk[_sp_i_s] ? (
    strip_tk[_sp_i_s] = _sp_tk;
    fx_hpf_stL[_sp_i_s] = 0; fx_hpf_stR[_sp_i_s] = 0;
    fx_lpf_stL[_sp_i_s] = 0; fx_lpf_stR[_sp_i_s] = 0;
  );
  _sp_i += 1; _sp_bit *= 2;
);
// ...and banks B..D's slots, which hand over through a split pair only (filter residue cleared on a flip, as above)
_ss_s = NUM_PADS;
loop(NUM_SLOTS - NUM_PADS,
  strip_spl_want[_ss_s] != strip_tk[_ss_s] ? (
    strip_tk[_ss_s] = strip_spl_want[_ss_s];
    fx_hpf_stL[_ss_s] = 0; fx_hpf_stR[_ss_s] = 0;
    fx_lpf_stL[_ss_s] = 0; fx_lpf_stR[_ss_s] = 0;
  );
  _ss_s += 1;
);

// Band-change re-adopt (pad-0 stomp, bug A): _reg_my_slot can change at runtime
// (collision reconciler vacates it → swing_registry_claim may hand back a
// DIFFERENT slot; mirrors the sp_ring_alloc_slot guard below). When _strip_b
// jumps, strip_cmd_last still holds the OLD band's counter, so the mismatch
// test below would consume the NEW band's (often 0,0,0) CMD cells — decoding to
// swing_fx_apply(pad 0, FX_PID_HPF_FREQ=0, 0) and stomping pad 0 every time.
// Re-adopt: force the first-seq adopt path so we sync to the new band's counter
// instead of applying a command never addressed to us.
_strip_b != strip_b_last ? (
  strip_b_last = _strip_b;
  strip_cmd_inited = 0;
);

// Consume one strip edit per block. Adopt (don't apply) the first seq seen —
// gmem persists across plugin reloads, so a stale mailbox must not fire.
_sc_seq = gmem[_strip_b + GS_STRIP_OFF_CMD_SEQ];
strip_cmd_inited ? (
  // Sentinel: a virgin band's CMD_SEQ is 0 (Lua's first real write is 1), so
  // never fire on 0 — guards the untouched-band case even if adopt was missed.
  _sc_seq != strip_cmd_last && _sc_seq != 0 ? (
    strip_cmd_last = _sc_seq;
    // Bank A's mailbox (the Drum Strips are bank A's lanes, step 5a): swing_fx_apply takes any slot since the
    // Pad FX window follows every bank, so a pad past bank A goes in as -1 -- the per-pad arm refuses it and
    // the bus arm ignores the pad (the FX-return deck posts its bus params on pad 0).
    _sc_pad = gmem[_strip_b + GS_STRIP_OFF_CMD_PAD] | 0;
    // Banks B..D (2026-10-15): a split pair's strip posts its owner's absolute slot -- taken while that slot still
    // owns a split pair; any other slot past bank A is still refused, as before.
    _sc_own = 0;
    _sc_pad >= NUM_PADS ? ( _ss_k = 0; loop(OUT_PAIRS - OUT_PAIR_SPLIT, strip_spl_own[_ss_k] == _sc_pad ? _sc_own = 1; _ss_k += 1; ); );
    _sc_own ? (
      swing_fx_apply(_sc_pad, gmem[_strip_b + GS_STRIP_OFF_CMD_PID] | 0, gmem[_strip_b + GS_STRIP_OFF_CMD_VAL]);
    ) : (
    swing_fx_apply(_sc_pad < NUM_PADS ? _sc_pad : -1,   // bank A
                   gmem[_strip_b + GS_STRIP_OFF_CMD_PID] | 0,
                   gmem[_strip_b + GS_STRIP_OFF_CMD_VAL]);
    );
  ) : (
    // Mismatch suppressed (band change mid-flight, or virgin 0) — count it so
    strip_cmd_last = _sc_seq;
  );
) : (
  strip_cmd_last = _sc_seq;
  strip_cmd_inited = 1;
);

// Banks B..D's console tie (2026-10-15): a split track's fader / pan, posted for its pair's owner (bank A's ride
// INCMD_GAIN / PAN). Adopted like those -- clamp, set, mark_dirty_pad (undoable) -- only while the posted slot still
// owns that pair; the slot cell is zeroed either way (consumed).
_ss_k = 0; loop(OUT_PAIRS - OUT_PAIR_SPLIT,
  _ss_t = _ssb + GS_SPLIT_OFF_TIE + _ss_k * 4;
  _ss_o = (gmem[_ss_t] | 0) - 1;
  _ss_o >= 0 ? (
    _ss_o == strip_spl_own[_ss_k] ? ( p_gain[_ss_o] = max(0, min(8, gmem[_ss_t + 1])); mark_dirty_pad(_ss_o); );
    gmem[_ss_t] = 0;
  );
  _ss_o = (gmem[_ss_t + 2] | 0) - 1;
  _ss_o >= 0 ? (
    _ss_o == strip_spl_own[_ss_k] ? (
      _ss_v = max(-1, min(1, gmem[_ss_t + 3]));
      p_pan[_ss_o]  = _ss_v;
      p_panL[_ss_o] = 1.0 - max(0.0, _ss_v);
      p_panR[_ss_o] = 1.0 + min(0.0, _ss_v);
      mark_dirty_pad(_ss_o);
    );
    gmem[_ss_t + 2] = 0;
  );
  _ss_k += 1;
);

// Publish the full per-pad FX state every 4th block (~23 Hz at 512/48k).
strip_pub_div += 1;
strip_pub_div >= 4 ? (
  strip_pub_div = 0;
  gmem[_strip_b + GS_STRIP_OFF_MULTIOUT] = multi_out;
  gmem[_strip_b + GS_STRIP_OFF_TIE_VER]  = 1;  // this build publishes VOL/PAN + carries the XOR
  // Pad Banks step 5a: the band is bank A's, whatever bank is shown -- a view click must not load another bank's
  // pad FX into the strips bank A plays through (the strip -> Swing edit below was always bank A's pad).
  _sp_i = 0; loop(NUM_PADS,   // bank A: the Drum Strips are bank A's lanes
    _sp_i_s = _sp_i;
    _sp_pb = _strip_b + GS_STRIP_PADS + _sp_i * GS_STRIP_PAD_STRIDE;
    gmem[_sp_pb + FX_PID_HPF_FREQ]     = fx_hpf_freq[_sp_i_s];
    gmem[_sp_pb + FX_PID_LPF_FREQ]     = fx_lpf_freq[_sp_i_s];
    gmem[_sp_pb + FX_PID_RESO]         = fx_reso[_sp_i_s];
    gmem[_sp_pb + FX_PID_EQ_LO]        = fx_eq_lo[_sp_i_s];
    gmem[_sp_pb + FX_PID_EQ_MID]       = fx_eq_mid[_sp_i_s];
    gmem[_sp_pb + FX_PID_EQ_HI]        = fx_eq_hi[_sp_i_s];
    gmem[_sp_pb + FX_PID_EQ_LO_FREQ]   = fx_eq_lo_freq[_sp_i_s];
    gmem[_sp_pb + FX_PID_EQ_MID_FREQ]  = fx_eq_mid_freq[_sp_i_s];
    gmem[_sp_pb + FX_PID_EQ_HI_FREQ]   = fx_eq_hi_freq[_sp_i_s];
    gmem[_sp_pb + FX_PID_CMP_AMT]      = fx_cmp_amt[_sp_i_s];
    gmem[_sp_pb + FX_PID_CMP_MODE]     = fx_cmp_mode[_sp_i_s];
    gmem[_sp_pb + FX_PID_BC_RATE]      = fx_bc_rate[_sp_i_s];
    gmem[_sp_pb + FX_PID_BC_BITS]      = fx_bc_bits[_sp_i_s];
    gmem[_sp_pb + FX_PID_SAT_DRV]      = fx_sat_drv[_sp_i_s];
    gmem[_sp_pb + FX_PID_DRV_MODE]     = fx_drv_mode[_sp_i_s];
    gmem[_sp_pb + FX_PID_SND_DLY]      = fx_snd_dly[_sp_i_s];
    gmem[_sp_pb + FX_PID_SND_RVB]      = fx_snd_rvb[_sp_i_s];
    gmem[_sp_pb + FX_PID_SND_SMASH]    = fx_snd_smash[_sp_i_s];
    gmem[_sp_pb + FX_PID_EQ_MID2]      = fx_eq_mid2[_sp_i_s];
    gmem[_sp_pb + FX_PID_EQ_MID2_FREQ] = fx_eq_mid2_freq[_sp_i_s];
    gmem[_sp_pb + FX_PID_EQ_MID_Q]     = fx_eq_mid_q[_sp_i_s];
    gmem[_sp_pb + FX_PID_EQ_MID2_Q]    = fx_eq_mid2_q[_sp_i_s];
    gmem[_sp_pb + FX_PID_EQ_LO_Q]      = fx_eq_lo_q[_sp_i_s];
    gmem[_sp_pb + FX_PID_EQ_HI_Q]      = fx_eq_hi_q[_sp_i_s];
    // FX-return viewer feed: per-pad peak (live "hitting") + effective hue.
    gmem[_sp_pb + GS_STRIP_PAD_OFF_PEAK] = max(pad_meterL[_sp_i_s], pad_meterR[_sp_i_s]);
    gmem[_sp_pb + GS_STRIP_PAD_OFF_HUE]  = col_auto_mode_id > 0 ? col_auto_hue[_sp_i] : p_color[_sp_i_s];
    // One-Mixer console tie: mixer VOL/PAN for the child-track fader mirror.
    // Blank pads publish VOL = -1 (impossible gain; p_gain >= 0): the
    // companion goes fully hands-off — a blank pad's fader is the user's
    // business (same rule as the M/S legs).
    gmem[_sp_pb + GS_STRIP_PAD_OFF_VOL]  = pad_is_playable(_sp_i_s) ? p_gain[_sp_i_s] : -1;
    gmem[_sp_pb + GS_STRIP_PAD_OFF_PAN]  = p_pan[_sp_i_s];
    _sp_i += 1;
  );
  // Bus-param echo for the FX-return viewer's control deck (order = FX_PID_BUS_* − 64).
  gmem[_strip_b + GS_STRIP_OFF_BUS_BASE]      = rvb_size;
  gmem[_strip_b + GS_STRIP_OFF_BUS_BASE + 1]  = rvb_damp;
  gmem[_strip_b + GS_STRIP_OFF_BUS_BASE + 2]  = rvb_width;
  gmem[_strip_b + GS_STRIP_OFF_BUS_BASE + 3]  = rvb_predelay;
  gmem[_strip_b + GS_STRIP_OFF_BUS_BASE + 4]  = rvb_hpf;
  gmem[_strip_b + GS_STRIP_OFF_BUS_BASE + 5]  = rvb_mix;
  gmem[_strip_b + GS_STRIP_OFF_BUS_BASE + 6]  = dly_div;
  gmem[_strip_b + GS_STRIP_OFF_BUS_BASE + 7]  = dly_fb;
  gmem[_strip_b + GS_STRIP_OFF_BUS_BASE + 8]  = dly_hpf_hz;
  gmem[_strip_b + GS_STRIP_OFF_BUS_BASE + 9]  = dly_lpf_hz;
  gmem[_strip_b + GS_STRIP_OFF_BUS_BASE + 10] = dly_ping;
  gmem[_strip_b + GS_STRIP_OFF_BUS_BASE + 11] = dly_mix;
  gmem[_strip_b + GS_STRIP_OFF_BUS_BASE + 12] = rvb_on;
  gmem[_strip_b + GS_STRIP_OFF_BUS_BASE + 13] = dly_on;
  // Pad Banks Outputs step 2: what plays where, for the bridge's bank / split-pad tracks. Counted in local scratch
  // and written once per cell, so a reader between two publishes never sees a pair go to 0 and back.
  out_gen += 1; gmem[_strip_b + GS_STRIP_OFF_OUT_GEN] = out_gen * 2 - 1;   // odd: being written
  memset(out_use_tmp, 0, OUT_PAIRS + OUT_PAIRS - OUT_PAIR_SPLIT);
  _so_i = 0; loop(NUM_SLOTS,
    _so_p = swing_out_pair(_so_i);
    gmem[_strip_b + GS_STRIP_OFF_OUT_PAIR + _so_i] = _so_p;   // step 3: every slot, playable or not
    gmem[_strip_b + GS_STRIP_OFF_OUT_WPAIR + _so_i] = (patch_on || multi_out ? swing_out_wpair(_so_i, patch_live ? patch_v2 : 1) : swing_out_wpair_next(_so_i)) + 1;   // step 5; off Wired in stereo: the pair the switch-on will give the slot (PadPick, 2026-10-22)
    pad_is_playable(_so_i) ? (
      out_use_tmp[_so_p] += 1;
      _so_p >= OUT_PAIR_SPLIT && out_use_tmp[OUT_PAIRS + _so_p - OUT_PAIR_SPLIT] == 0 ?
        out_use_tmp[OUT_PAIRS + _so_p - OUT_PAIR_SPLIT] = _so_i + 1;
    );
    _so_i += 1;
  );
  _so_p = 0; loop(OUT_PAIRS, gmem[_strip_b + GS_STRIP_OFF_OUT_USE + _so_p] = out_use_tmp[_so_p]; _so_p += 1;);
  _so_p = 0; loop(OUT_PAIRS - OUT_PAIR_SPLIT, gmem[_strip_b + GS_STRIP_OFF_OUT_OWN + _so_p] = out_use_tmp[OUT_PAIRS + _so_p]; _so_p += 1;);
  gmem[_strip_b + GS_STRIP_OFF_OUT_UREQ] = out_ureq;   // a person's output choices so far (swing_out_touched); never reset by @init
  // the bank colour set, for the bridge's bank tracks (GS_STRIP_OFF_BANK_SET / BANK_DEF above)
  // read through slider(47), the host-owned cell (the THEME menu writes bank_col_set in @gfx; the slider is the one
  // value both threads may share). Not `slider47`: a slider declared with a variable name keeps its value in that
  // name, and the bare sliderN reads 0 -- the first cut published Off for every set (BanksTracks T1C / T1D RED).
  _bs_s = max(0, min(BANK_COL_SETS, slider(47) | 0));
  gmem[_strip_b + GS_STRIP_OFF_BANK_SET] = _bs_s + 1;
  _bs_b = 0; loop(NUM_BANKS,
    _bs_i = (_bs_s - 1) * 12 + _bs_b * 3;
    gmem[_strip_b + GS_STRIP_OFF_BANK_DEF + _bs_b] = _bs_s >= 1 ?
      bank_set_rgb[_bs_i] * 65536 + bank_set_rgb[_bs_i + 1] * 256 + bank_set_rgb[_bs_i + 2] + 1 : 0;
    _bs_b += 1;
  );
  // Banks B..D's Drum Strips: each split pair's owner and its record (GS_SPLIT_*), under this publish's SEQ
  gmem[_ssb + GS_SPLIT_OFF_VER] = 1;
  _ss_k = 0; loop(OUT_PAIRS - OUT_PAIR_SPLIT,
    _ss_o = out_use_tmp[OUT_PAIRS + _ss_k] - 1;
    strip_spl_own[_ss_k] = _ss_o;
    gmem[_ssb + GS_SPLIT_OFF_OWNER + _ss_k] = _ss_o + 1;
    _ss_o >= 0 ? ( swing_strip_rec_put(_ssb + _ss_k * GS_STRIP_PAD_STRIDE, _ss_o); )
               : ( gmem[_ssb + _ss_k * GS_STRIP_PAD_STRIDE + GS_STRIP_PAD_OFF_VOL] = -1; );
    _ss_k += 1;
  );
  _so_b = 1; loop(NUM_BANKS - 1,   // banks B, C, D: their tracks are named after them
    _so_n = min(strlen(BKNAME_STR_BASE + _so_b), GS_STRIP_BKNAME_LEN - 1);
    _so_c = 0; loop(_so_n,
      gmem[_strip_b + GS_STRIP_OFF_BKNAME + (_so_b - 1) * GS_STRIP_BKNAME_LEN + _so_c] = str_getchar(BKNAME_STR_BASE + _so_b, _so_c, 'cu');
      _so_c += 1;
    );
    gmem[_strip_b + GS_STRIP_OFF_BKNAME + (_so_b - 1) * GS_STRIP_BKNAME_LEN + _so_n] = 0;
    _so_b += 1;
  );
  gmem[_strip_b + GS_STRIP_OFF_OUT_GEN] = out_gen * 2;      // even: whole
  gmem[_strip_b + GS_STRIP_OFF_SEQ] += 1;
);
) : (
  // No registry slot yet → never take over (internal FX keep processing).
  strip_takeover = 0;
  // Every slot: bank A's sixteen through the mask above, banks B..D's through a split pair (2026-10-15). (Until
  // 2026-09 this cleared the bank on SCREEN, so with bank B shown a lost slot left bank A's pads on strips that no
  // longer answer.)
  memset(strip_tk, 0, NUM_SLOTS);
);

_is_browser_target() ? (
  _trig_pad = gmem[GS_PAD_TRIGGER] | 0;
  _trig_pad >= 0 && _trig_pad < NUM_PADS ? (   // bank-relative by protocol: the browser's tiles (step 4a)
    gmem[GS_PAD_TRIGGER] = -1;  // consume
    _trig_s = swing_bp(_trig_pad);
    !swing_pad_blocked(_trig_s) && !_blk_trig[_trig_s] ? (   // mute / solo / playable / skip, like every other trigger source
      launch_voices_for_pad(_trig_s, p_note[_trig_s], 100, 0);
      _blk_trig[_trig_s] = 1;
    );
  );
);

// Pad clicks from the UI thread, launched here beside the bridge's trigger (A-9b;
// the rings are described at GT_RING in @init).
swing_block_gt_consume();

// ─── Deferred held state: same-block note-on + note-off ─────────────────
// If a pad got both note-on and note-off in the same block, the note-off
// left p_held alone (the note repeat and pressure state). Clear it now — but ONLY
// when the pad's LAST event this block was the note-off (an on→off short
// note that genuinely ended). When the last event was a note-ON, the pair
// was an off→on RETRIGGER (e.g. step-sequencer subdivisions emit
// off(prev subdiv)+on(cur subdiv), same note, same block at every internal
// boundary): the pad is still held.
// The VOICES are no longer released here: each note-off releases the voices it
// found, at its own sample (the note-off above). Releasing a pad's voices here, at
// the block's first sample, is what silenced a gate-mode note that began and ended
// inside one block -- it went into release before it had sounded.
i = 0; loop(NUM_SLOTS,
  _blk_trig[i] && _blk_off[i] && _blk_last_off[i] ? p_held[i] = 0;
  i += 1;
);

// ─── The step sequencer's walker (rk_seq_core; Spec_Swing_Seq_View 9: MIDI parse -> SEQ -> note repeat).
// Its hits go through the same gate and launcher as MIDI, marked in _blk_trig, so the repeat below never
// doubles a pad the sequencer hit this block.
seq_kit_pub_ack != seq_kit_pub_req ? seq_kit_publish();   // S3c: the kit record for a save, this thread's (rk_seq_core)
seq_kit_adopt_req ? seq_kit_adopt();                       // S3c: a loaded kit's patterns, before the walk
seq_block_tick();

// ─── Note repeat (tempo-synced; global overrides per-pad) — see rk_swing_block.jsfx-inc
swing_block_process_note_repeat();

// ─── Heartbeat — Lua companion + Extension both detect this counter
//     changing. atomic_set instead of plain assignment because cross-context
//     gmem reads (Extension's NSEEL VM, Lua's gmem_attach) require an
//     atomic write to see the new value — Justin Frankel: "gmem isn't a
//     FIFO or buffered queue — anything access-critical needs the atomic
//     instructions." See REAPER's Atomic Variable Access docs.
heartbeat_counter += 1;
heartbeat_counter > 1000000 ? heartbeat_counter = 1;
atomic_set(gmem[GS_SWING_ALIVE], heartbeat_counter);

// ─── Instance registry heartbeat ────────────────────────────────────────
// Cached slot finder: _reg_my_slot is claimed at the END of @init now
// (transport-independent). See the relocation comment near the bottom
// of @init for the rationale. From here on we just write to the cached
// slot every block — no scan, no per-block cost beyond a few writes.
//
// If our slot ever gets stolen (e.g. another instance overwrites because
// we went silent), the periodic collision check below picks a new slot
// without re-doing the initial scan.

// ─── Browser sample-load dispatch (window-closed safe) ────────────
// CMD 63 (single-pad) and CMD 64 (layer) used to dispatch only from @gfx,
// which left the sample sitting in gmem unloaded whenever the Swing FX
// window was closed — colors didn't update because the load itself
// hadn't happened. Dispatching from @block here means a browser drag
// lands instantly regardless of UI state. Both handlers clear
// gmem[KIT_GMEM_CMD] mid-function so a stale @gfx dispatch on the next
// frame is a guaranteed no-op (CMD already 0). Handlers are pure data:
// voice arming + clear_pad + load_from_path + sync_note_names — no
// gfx_* state touched, same thread-safety contract as the @block
// kit-import state machine that already runs here.
// !kit_busy: a browser drop landing mid-kit-import would interleave with the
// import's per-pad load/re-apply. Deferring costs one poll tick (CMD stays
// set; the bridge leaves the staged sample in gmem) and closes the window.
// _bl_blkctr: engine heartbeat for the @gfx dispatch fallback (see @gfx site).
// !_bl_inflight: the @gfx fallback could pick a CMD up right as the engine
// resumes — never enter a handler that is already executing on this thread's
// twin (2026-07-27 double-dispatch fix; the FILL name-adopt consume-once flag
// exposed the twin entry: entrant #2 found the flag consumed and its
// auto-basename push landed LAST, undoing the adopted kit name).
_bl_blkctr += 1;
// A CMD-63/64 load still in flight (sliced across blocks) whose command was
// cleared under it (bridge watchdog, a browser re-bind to another instance)
// is dropped here so it can never wedge the block job bank or leak the
// handler's undo bracket.
_bl_job_pending && gmem[KIT_GMEM_CMD] != _bl_job_cmd ? (
  swing_ldr_abort(ldr_job0);
  undo_cap_end();
  _bl_job_pending = 0;
);
// EON_PADPCM adopter (rk_swing_padpcm.jsfx-inc): copies a bounded slice of the
// bridge's decoded-PCM stream per block. Route 1 = the preview; independent of
// kit_busy (it lands in _prv_buf, never in pad state).
swing_padpcm_tick();

gmem[KIT_GMEM_CMD] == 63 && !kit_busy && !_bl_inflight ? swing_browser_load_pad();
gmem[KIT_GMEM_CMD] == 64 && !kit_busy && !_bl_inflight ? swing_browser_load_layer();

// CMD 69 — the mini browser's PREVIEW load. @block ONLY: it reads a file, and
// the twin dispatch in @gfx must never do that. Gated on the same instance
// check as 63/64, and it clears the command itself because nothing downstream
// knows about it.
// 2026-09-08: this file read is the OLD path. A level-204 bridge consumes CMD 69
// itself and streams the PCM; swing_padpcm_tick above adopts it and acks the CMD
// at LAST. 2026-09-10 (plan Phase B): _bridge_state, decided in that same tick,
// splits the rest -- a bridge that is running but predates this JSFX (every
// ReaPack sync, until REAPER restarts) gets a REFUSAL and an LCD line saying
// restart, not a file read on the audio thread for something a restart cures;
// only NO bridge at all falls through to the read. A preview is not a pad load,
// so the no-bridge case says nothing here -- the "not running" banner already
// covers the state, and a line per browser click would be noise.
// A saved sample whose length was corrupt loaded EMPTY (the @serialize guard, _ser_bad): say so on the LCD, once per
// read (2026-10-16; the flag had been set since 2026-07 and never read -- the pad went blank in silence).
_ser_bad > 0 && !_ser_bad_told ? ( swing_ldr_bridge_notice(2); _ser_bad_told = 1; );
gmem[KIT_GMEM_CMD] == 69 && !kit_busy && !_bl_inflight && _bridge_state != 2 ? (
  gmem[KIT_GMEM_INSTANCE] == instance_id ? (
    _bridge_state == 1 ? (
      swing_ldr_bridge_notice(1);
    ) : (
      _prv_pl = gmem[GS_BROWSER_PATH_LEN] | 0;
      _prv_pl > 0 && _prv_pl < GS_BROWSER_PATH_MAX ? (
        strcpy(#_prv_path, "");
        _prv_ci = 0;
        loop(_prv_pl, str_setchar(#_prv_path, _prv_ci, gmem[GS_BROWSER_PATH + _prv_ci]); _prv_ci += 1;);
        str_setlen(#_prv_path, _prv_pl);
        // Open + riff here; the read is pumped below, a budget of cells per
        // block, so an audition click cannot stall the audio thread.
        swing_fb_prv_begin(#_prv_path);
        _pp_prv_job = -1;   // no stream job holds the ring: the file read owns it from 0
      );
    );
    gmem[KIT_GMEM_CMD] = 0;
  );
);

// Pump a sliced preview read. Same per-block cell budget the pad loader uses,
// so the two cost the same per block. Audition means "let me hear it" -- the
// load landing IS the request to play, which is why the transport starts here
// rather than at the CMD-69 site that began it.
// ⚠️ ...unless a STOP arrived while it was still landing. This site is the THIRD
// completion path for a preview and was the one that did not ask. The two
// streamed ones both do (rk_swing_padpcm.jsfx-inc, `!_prv_on && !_prv_stopped`,
// tagged D-7) -- the file-read path was simply missed, and the comment eight
// lines below already promised the latch it was not honouring.
// STOP is not only the STOP button: closing the browser sends cmd 2
// (rk_swing_ui_minibrowser.jsfx-inc), and so does a @gfx idle transition down at
// the bottom of this file -- and an open window stops the embed's @gfx, which is
// routine. Symptom: audition something long, close the browser, and it starts
// playing with no face left to stop it.
_prv_loading ? (
  swing_fb_prv_step(ldr_budget) ? ( !_prv_stopped ? swing_prv_arm(); );
);

// Face -> engine transport. @gfx must not own the read position, so it asks
// here and @block sets the state that @sample reads.
// STOP latches _prv_stopped so a stream still landing cannot restart the audition;
// PLAY and every new preview clear it (D-7).
// STOP no longer clears _prv_on here -- it asks for the release and @sample
// ends the voice when the envelope reaches zero. Clearing it outright is what
// made the click.
// A STOP also marks every audition request minted so far as cancelled (the queued audition, 2026-10-14):
// _prv_cancel_through = the bridge's latest identity; the CMD 69 edge (rk_swing_padpcm) lets through only a
// request minted after this moment, so a preview queued behind a pad load cannot play after the close.
// The ring (Spec_Swing_Preview_Ring): PLAY takes a landed job the player has not started, else restarts;
// STOP also cancels a LONG stream still landing (swing_padpcm_prv_cancel: the bridge finishes it quietly).
fb_prv_cmd == 1 ? ( swing_padpcm_prv_play(); fb_prv_cmd = 0; ) :
fb_prv_cmd == 2 ? ( swing_prv_release(); _prv_stopped = 1; _prv_cancel_through = gmem[EON_PADPCM_HDR + PP_AUD_ISSUED] | 0; swing_padpcm_prv_cancel(); fb_prv_cmd = 0; );
gmem[KIT_GMEM_CMD] == 65 && _reg_my_slot == gmem[GS_PENDING_PITCH_INST] && !kit_busy && !_bl_inflight ? swing_pad_audio_swap();  // !kit_busy: defer Tuned bake while a kit-import restore is populating pad buffers (blank-pads race)
gmem[KIT_GMEM_CMD] == 66 && _reg_my_slot == gmem[GS_PENDING_PITCH_INST] && !kit_busy && !_bl_inflight ? swing_pad_audio_export();  // !kit_busy (Phase 3): 66 writes KIT_GMEM_AUDIO offset 0, where VER-201 stages pad 0 path string
gmem[KIT_GMEM_CMD] == 67 && _reg_my_slot == gmem[GS_PENDING_PITCH_INST] && !kit_busy && !_bl_inflight ? swing_pad_layer_audio_swap();  // !kit_busy (Phase 3): same shared-band defer as CMD 65

// ─── Color rebuild + publish when window is closed ────────────────
// swing_color_rebuild() updates the internal col_auto_hue[] + col_rgba[]
// arrays and publishes GS_COL_EFFECTIVE_S/L to gmem, BUT it does NOT
// publish per-pad META+12 (the hue every external consumer reads).
// That publish lives only in @gfx's col_dirty block at the bottom of
// this file — which doesn't run while the Swing FX window is closed.
// And because swing_color_rebuild() clears col_dirty internally,
// calling it here alone would silently disable the @gfx publish too
// (col_dirty==0 → @gfx block skipped).
//
// So we mirror the FULL @gfx col_dirty block here: rebuild + per-pad
// META+12 publish, ungated by _is_browser_target() so single-Swing
// setups don't need the browser open for hues to propagate. Whichever
// section (this @block or @gfx) sees col_dirty first runs the rebuild;
// the other becomes a no-op via the now-cleared flag — same end state.
// Placed AFTER the CMD 63/64 dispatch above so a same-block sample
// drop's col_dirty=1 is picked up immediately. Pure data (string
// matches + math + gmem writes; no gfx_* calls).
col_dirty ? (
  swing_color_rebuild();
  _hue_pi = 0;
  // The rebuild is ours; the META+12 band is shared (swing_shared_bands_free).
  swing_shared_bands_free() ? loop(NUM_PADS,
    _hue_pi_s = swing_bp(_hue_pi);
    gmem[KIT_GMEM_META + _hue_pi * KIT_GMEM_META_PP + 12] =
      col_auto_mode_id > 0 ? col_auto_hue[_hue_pi] : p_color[_hue_pi_s];
    _hue_pi += 1;
  );
);

// ─── Per-pad AUDIO-LENGTH publish (UNGATED, every @block) ─────────
// The blank signal every consumer reads — gmem[KIT_GMEM_AUDIOLEN + pad] —
// must stay current for ALL instances, not only the browser-target one.
// @gfx publishes hue and the @block mirror below publishes AUDIOLEN only
// when _is_browser_target(), so a pad emptied by a kit load on a
// non-target (or UI-closed) instance keeps reading >0. Consumers (Kit
// Bridge multi-out coloring, Drum Matrix lane sync) then leave the
// previous kit's color on the track — symptom: blank tracks stay purple
// instead of REAPER default. @block runs continuously while Swing is
// active, so publishing here keeps the signal fresh with the FX window
// closed AND the Drum Matrix not running.
// ⚠⚠ THIS BAND IS SHARED AND UNKEYED, and the old note here ("Single-Swing
// today → no writer conflict") stopped being true the moment multi-instance
// shipped: EVERY instance rewrites all sixteen cells every block, so the values
// belong to whichever one wrote last. What is CORRECT today is that the things
// that must not be wrong no longer read it — pad-presence for the change map,
// FILL and the save guard all ask the per-instance IDENT band at a resolved
// registry slot instead. What still reads it is the coarse stuff (multi-out
// colouring, Drum Matrix lane sync) plus the save path's LENGTH snapshot, which
// is a deliberate call: the path-less pad capture needs lengths and IDENT
// carries presence, not size.
// ⇒ Do not add a new CORRECTNESS consumer of this band. Kit saves read lengths
// from META s_len, which the saving instance stages itself in export state 11
// (write_kit_v5's shared-band fallback was removed 2026-09-13), and nobody but
// the LOCK holder writes here during a save or load (swing_shared_bands_free).
_aud_pi = 0;
swing_shared_bands_free() ? loop(NUM_PADS,
  _aud_pi_s = swing_bp(_aud_pi);
  gmem[KIT_GMEM_AUDIOLEN + _aud_pi] =
    s_len[_aud_pi_s] > 0 ? s_len[_aud_pi_s] : (pad_has_audio(_aud_pi_s) ? 1 : 0);
  _aud_pi += 1;
);

// @block re-claim: if the collision reconciler below vacated our slot
// (_reg_my_slot = -1), reclaim a free one here instead of going silent
// forever. swing_registry_claim() no-ops when we already hold a slot. (The
// old "force re-claim on next @block" comment had NO actual re-claim code —
// the @block heartbeat block was gated _reg_my_slot >= 0, so a vacated
// instance stayed silent. This is the missing re-claim.)
swing_registry_claim();
// Registry-full latch for the LCD banner (rk_swing_ui_state 1c): the moment
// this instance found no free slot; cleared the block it gets one.
_reg_my_slot < 0 ? ( _regfull_since == 0 ? _regfull_since = time_precise(); ) : ( _regfull_since = 0; );

_reg_my_slot >= 0 ? (
  // B1c: allocate this instance's Stretch ring blocks once the registry
  // slot settles (re-runs if we re-claim a different slot after a collision).
  sp_ring_alloc_slot != _reg_my_slot ? (
    swing_stretch_alloc_ring(_reg_my_slot);
    sp_ring_alloc_slot = _reg_my_slot;
  );
  _reg_base = GS_INST_REG_BASE + _reg_my_slot * GS_INST_REG_STRIDE;
  // The id cell is written ONLY by the claim. Re-stamping it here every block
  // let a collision loser keep writing its id back over the winner's.
  gmem[_reg_base + 1] = time_precise();
  // Self-reported display fields (cheap, recomputed every block).
  _reg_pad_count = 0;
  _reg_pi = 0;
  loop(NUM_SLOTS,   // step 2b: pads with a sound, across every bank (Spec_Swing_Pad_Banks 9)
    pad_is_playable(_reg_pi) ? _reg_pad_count += 1;
    _reg_pi += 1;
  );
  gmem[_reg_base + 2] = _reg_pad_count;
  _reg_kn_hash = 0;
  _reg_pi = 0;
  loop(strlen(#kit_name),
    _reg_kn_hash += str_getchar(#kit_name, _reg_pi);
    _reg_pi += 1;
  );
  // Step 5a: the kit hash folds in the bank on screen, so every companion that refreshes on a kit change
  // (Drum Matrix, the Browser) refreshes on a tab switch too; the bank itself is published beside it.
  gmem[_reg_base + 3] = _reg_kn_hash + bank_cur * 8192;
  gmem[GS_INST_BANK_CUR + _reg_my_slot] = bank_cur;

  // ─── Inbound command adopt (IN direction, Increment D) ─────────────────
  // Consume external pad edits BEFORE the publish below, so an adopted value
  // republishes in this same block (consumers converge in one pass). Mailbox
  // protocol: writer posted payload then flag; we consume by zeroing the flag
  // only. Held entirely while kit_busy — a kit import owns pad state, and the
  // mailbox keeps the command for the next block.
  // COLOR: a manual color wins over auto-color — adopting switches
  // col_auto_mode_id off, exactly like the in-app color picker does on every
  // manual pad-color edit (rk_swing_ui_grid_overlay). Only blank pads drop
  // (consume without adopting) — the bridge forward-snap restores their
  // default track color.
  !kit_busy ? (
    _inc_b = INST_INCMD_BASE + _reg_my_slot * INST_INCMD_STRIDE + INCMD_COLOR_OFF;
    _inc_pi = 0;
    loop(NUM_PADS,   // active bank: the INCMD cells are bank-relative (step 4 maps them through swing_bp)
      _inc_pi_s = swing_bp(_inc_pi);
      _inc_f = gmem[_inc_b + _inc_pi * 2];
      _inc_f >= 1 ? (
        _inc_v = gmem[_inc_b + _inc_pi * 2 + 1];
        pad_is_playable(_inc_pi_s) && _inc_v >= 0 && _inc_v <= 1 ? (
          p_color[_inc_pi_s] = _inc_v;
          swing_color_manualize(_inc_pi);
          col_dirty = 1;
          _inc_f >= 2 ? mark_dirty_pad(_inc_pi_s);
        );
        gmem[_inc_b + _inc_pi * 2] = 0;  // consume LAST
      );
      _inc_pi += 1;
    );
    // NAME commands (D-2): multi-word payload, so the writer stamps a gen
    // word second-to-last and we copy to a scratch string, then re-check the
    // gen — a torn read leaves the flag set and retries next block. Commit
    // mirrors the CMD-51 rename handler (cname + sync_note_names + col_dirty
    // so auto-color re-derives). Blank pads consume-and-drop.
    _inc_nb = INST_INCMD_BASE + _reg_my_slot * INST_INCMD_STRIDE + INCMD_NAME_OFF;
    _inc_pi = 0;
    loop(NUM_PADS,
      _inc_pi_s = swing_bp(_inc_pi);
      _inc_nc = _inc_nb + _inc_pi * INCMD_NAME_FIELDS;
      _inc_f = gmem[_inc_nc];
      _inc_f >= 1 ? (
        _inc_g = gmem[_inc_nc + 1];
        str_setlen(#inc_nametmp, 0);
        _inc_cj = 0; _inc_cl = 0;
        loop(INST_PADNAME_PAD_LEN,
          _inc_cc = gmem[_inc_nc + 2 + _inc_cj] | 0;
          _inc_cc > 0 ? ( str_setchar(#inc_nametmp, _inc_cj, _inc_cc); _inc_cl = _inc_cj + 1; );
          _inc_cj += 1;
        );
        str_setlen(#inc_nametmp, _inc_cl);
        gmem[_inc_nc + 1] == _inc_g ? (
          _inc_cl > 0 && pad_is_playable(_inc_pi_s) ? (
            strcpy(get_cname_slot(_inc_pi_s), #inc_nametmp);
            sync_note_names();
            col_dirty = 1;
            _inc_f >= 2 ? mark_dirty_pad(_inc_pi_s);
          );
          gmem[_inc_nc] = 0;  // consume LAST (clean read only)
        );
      );
      _inc_pi += 1;
    );
    // MUTE/SOLO SET commands (Increment E): four regions (bridge mute/solo,
    // sequencer mute/solo) at INCMD_MUTE_OFF + r*32, even r -> p_mute, odd r ->
    // p_solo. Absolute 0/1 payloads. any_solo self-heals next block (it is
    // recomputed every @block), and the mute/solo edge pass at the top of @block
    // silences a pad the block it becomes muted (2026-09-23). Blank pads consume-and-drop.
    _inc_r = 0;
    loop(4,
      _inc_b = INST_INCMD_BASE + _reg_my_slot * INST_INCMD_STRIDE + INCMD_MUTE_OFF + _inc_r * 32;
      _inc_tgt = (_inc_r & 1) ? p_solo : p_mute;
      _inc_pi = 0;
      loop(NUM_PADS,   // active bank: the mailbox is bank-relative, the write goes to swing_bp's slot
        _inc_pi_s = swing_bp(_inc_pi);
        _inc_f = gmem[_inc_b + _inc_pi * 2];
        _inc_f >= 1 ? (
          _inc_v = gmem[_inc_b + _inc_pi * 2 + 1];
          (_inc_v == 0 || _inc_v == 1) && pad_is_playable(_inc_pi_s) ? (
            _inc_tgt[_inc_pi_s] = _inc_v;   // the slot: the cells are bank-relative (Pad Banks audit S1)
            _inc_f >= 2 ? mark_dirty_pad(_inc_pi_s);
          );
          gmem[_inc_b + _inc_pi * 2] = 0;  // consume LAST
        );
        _inc_pi += 1;
      );
      _inc_r += 1;
    );
    // NOTE / OUTPUT / REVERSE commands (P4): byte-mirrors of the retired
    // GS_PAD_ACTION handler's side effects, per-instance and always
    // undo-marked (every writer is a user action).
    _inc_b = INST_INCMD_BASE + _reg_my_slot * INST_INCMD_STRIDE + INCMD_NOTE_OFF;
    _inc_pi = 0;
    loop(NUM_PADS,   // active bank: INCMD, bank-relative -- unless the flag names a bank (swing_incmd_slot)
      _inc_f = gmem[_inc_b + _inc_pi * 2];
      _inc_pi_s = swing_incmd_slot(_inc_pi, _inc_f);
      _inc_f >= 1 ? (
        _inc_v = gmem[_inc_b + _inc_pi * 2 + 1];
        _inc_v >= 0 && _inc_v <= 127 ? (
          p_note[_inc_pi_s] = _inc_v | 0;
          p_note_lock[_inc_pi_s] = 1;  // user explicitly assigned — don't auto-rotate
          mark_dirty_pad(_inc_pi_s);
          sync_note_names();
        );
        gmem[_inc_b + _inc_pi * 2] = 0;  // consume LAST
      );
      _inc_pi += 1;
    );
    _inc_b = INST_INCMD_BASE + _reg_my_slot * INST_INCMD_STRIDE + INCMD_OUT_OFF;
    _inc_pi = 0;
    loop(NUM_PADS,   // active bank: INCMD, bank-relative
      _inc_pi_s = swing_bp(_inc_pi);
      _inc_f = gmem[_inc_b + _inc_pi * 2];
      _inc_f >= 1 ? (
        _inc_v = gmem[_inc_b + _inc_pi * 2 + 1];
        _inc_v >= 0 && _inc_v < 16 ? (
          p_output[_inc_pi_s] = _inc_v | 0;
          mark_dirty_pad(_inc_pi_s);
        );
        gmem[_inc_b + _inc_pi * 2] = 0;  // consume LAST
      );
      _inc_pi += 1;
    );
    _inc_b = INST_INCMD_BASE + _reg_my_slot * INST_INCMD_STRIDE + INCMD_REV_OFF;
    _inc_pi = 0;
    loop(NUM_PADS,   // active bank: INCMD, bank-relative
      _inc_pi_s = swing_bp(_inc_pi);
      gmem[_inc_b + _inc_pi * 2] >= 1 ? (
        p_reverse[_inc_pi_s] = !p_reverse[_inc_pi_s];
        recalc_pad(_inc_pi_s); s_dirty[_inc_pi_s] = 1;
        mark_dirty_pad(_inc_pi_s);
        gmem[_inc_b + _inc_pi * 2] = 0;  // consume LAST
      );
      _inc_pi += 1;
    );
    // TUNE / GAIN / PAN (SFZ-import fidelity): SET per-pad playback params the
    // per-pad CMD-63 audio load doesn't carry. Posted by the browser AFTER the
    // load lands, so they win over any load-time reset. p_tune republishes to
    // the pitch host on the next block tick; pan recomputes panL/panR inline
    // (recalc_pad would clobber an unlocked p_note, which we don't want here).
    _inc_b = INST_INCMD_BASE + _reg_my_slot * INST_INCMD_STRIDE + INCMD_TUNE_OFF;
    _inc_pi = 0;
    loop(NUM_PADS,   // active bank: INCMD, bank-relative -- unless the flag names a bank (swing_incmd_slot)
      _inc_pi_s = swing_incmd_slot(_inc_pi, gmem[_inc_b + _inc_pi * 2]);
      gmem[_inc_b + _inc_pi * 2] >= 1 ? (
        p_tune[_inc_pi_s] = max(-24, min(24, gmem[_inc_b + _inc_pi * 2 + 1]));
        mark_dirty_pad(_inc_pi_s);
        gmem[_inc_b + _inc_pi * 2] = 0;  // consume LAST
      );
      _inc_pi += 1;
    );
    _inc_b = INST_INCMD_BASE + _reg_my_slot * INST_INCMD_STRIDE + INCMD_GAIN_OFF;
    _inc_pi = 0;
    loop(NUM_PADS,   // active bank: INCMD, bank-relative -- unless the flag names a bank (swing_incmd_slot)
      _inc_pi_s = swing_incmd_slot(_inc_pi, gmem[_inc_b + _inc_pi * 2]);
      gmem[_inc_b + _inc_pi * 2] >= 1 ? (
        p_gain[_inc_pi_s] = max(0, min(8, gmem[_inc_b + _inc_pi * 2 + 1]));
        mark_dirty_pad(_inc_pi_s);
        gmem[_inc_b + _inc_pi * 2] = 0;  // consume LAST
      );
      _inc_pi += 1;
    );
    _inc_b = INST_INCMD_BASE + _reg_my_slot * INST_INCMD_STRIDE + INCMD_PAN_OFF;
    _inc_pi = 0;
    loop(NUM_PADS,   // active bank: INCMD, bank-relative -- unless the flag names a bank (swing_incmd_slot)
      _inc_pi_s = swing_incmd_slot(_inc_pi, gmem[_inc_b + _inc_pi * 2]);
      gmem[_inc_b + _inc_pi * 2] >= 1 ? (
        _inc_v = max(-1, min(1, gmem[_inc_b + _inc_pi * 2 + 1]));
        p_pan[_inc_pi_s]  = _inc_v;
        p_panL[_inc_pi_s] = 1.0 - max(0.0, _inc_v);
        p_panR[_inc_pi_s] = 1.0 + min(0.0, _inc_v);
        mark_dirty_pad(_inc_pi_s);
        gmem[_inc_b + _inc_pi * 2] = 0;  // consume LAST
      );
      _inc_pi += 1;
    );
    // LAYER MODE (RS5k import): after the browser stacks a pad's layers via
    // CMD 64, set how they play (vel-split / RR / sum). Vel-split auto-assigns
    // even velocity ranges, matching RS5k's own even multi-sample distribution.
    _inc_b = INST_INCMD_BASE + _reg_my_slot * INST_INCMD_STRIDE + INCMD_LMODE_OFF;
    _inc_pi = 0;
    loop(NUM_PADS,   // active bank: INCMD, bank-relative -- unless the flag names a bank (swing_incmd_slot)
      _inc_pi_s = swing_incmd_slot(_inc_pi, gmem[_inc_b + _inc_pi * 2]);
      gmem[_inc_b + _inc_pi * 2] >= 1 ? (
        swing_layer_set_mode(_inc_pi_s, max(0, min(3, gmem[_inc_b + _inc_pi * 2 + 1]|0)));
        mark_dirty_pad(_inc_pi_s);
        gmem[_inc_b + _inc_pi * 2] = 0;  // consume LAST
      );
      _inc_pi += 1;
    );
  );

  // ─── Per-instance IDENTITY band publish (unified source of truth, P1) ──
  // Write THIS instance's per-pad identity to its registry-slot region. Single
  // floats (hue/mute/solo/note/output/icon) are word-atomic → write every block.
  // The 32-char NAME is rewritten + bumps the per-pad VER only when it CHANGES,
  // so VER stays a stable signal a torn-read-safe reader can seqlock against.
  _id_ib = INST_IDENT_BASE   + _reg_my_slot * INST_IDENT_INST_STRIDE;
  _id_nb = INST_PADNAME_BASE + _reg_my_slot * INST_PADNAME_INST_STRIDE;
  _id_mb = INST_PADMIX_BASE  + _reg_my_slot * INST_PADMIX_INST_STRIDE;
  // Heal block (A O-3): the band itself is compared, as it was every block until Phase 4,
  // so a foreign write to the band (or a fresh slot's stale cells) is put right within a
  // second; every other block trusts the per-pad shadow of what was last published.
  // Step 4a: a bank switch republishes the ACTIVE bank's bands -- the IDENT / name heal, the colour band
  // (col_dirty), the path band (CMD 87 on paths_gen); AUDIOLEN, the browser mirror and the strip mask
  // re-evaluate every block or frame on their own. bank_cur is @gfx-owned; one scalar, read whole.
  // Step 5a: and the root-note band is the bank on screen's too -- ask the bridge to re-analyse (not on the
  // first block, which only takes the baseline). Here, so swing_lcd_rootnote_reqseq keeps its one writer (@block).
  bank_cur != _bank_pub_last ? ( _bank_pub_last >= 0 ? swing_lcd_rootnote_request(-1);
                                 _bank_pub_last = bank_cur; _id_pub_slot = -1; col_dirty = 1; paths_gen += 1; );
  _id_heal = _id_pub_slot != _reg_my_slot || (_bl_blkctr & 63) == 0;
  _id_pub_slot = _reg_my_slot;
  _reg_pi = 0;
  loop(NUM_PADS,
    _reg_pi_s = swing_bp(_reg_pi);
    _id_pb = _id_ib + _reg_pi * INST_IDENT_PAD_FIELDS;
    // Playable = sample OR enabled synth. This flag + the hue sentinel drive
    // EVERY identity consumer (bridge child-track names/colors, piano-roll
    // note names, StepSeq lane tiles, DM reader) — audio-only here was the
    // "multiout + StepSeq treat synth pads as blank" bug (2026-07-29).
    _id_has = pad_is_playable(_reg_pi_s);
    // Blank hue sentinel -2 kept for old consumers, but it COLLIDES with the
    // manual-BLACK color (also -2) — the explicit AUDIO flag below is the
    // authoritative blank signal for flag-aware readers.
    gmem[_id_pb + IDENT_OFF_HUE]    = _id_has ? (col_auto_mode_id > 0 ? col_auto_hue[_reg_pi] : p_color[_reg_pi_s]) : -2;
    gmem[_id_pb + IDENT_OFF_MUTE]   = p_mute[_reg_pi_s];
    gmem[_id_pb + IDENT_OFF_SOLO]   = p_solo[_reg_pi_s];
    gmem[_id_pb + IDENT_OFF_NOTE]   = p_note[_reg_pi_s];
    gmem[_id_pb + IDENT_OFF_OUTPUT] = p_output[_reg_pi_s];
    gmem[_id_pb + IDENT_OFF_ICON]   = 0;   // P5: per-pad icon override (0 = auto for now)
    gmem[_id_pb + IDENT_OFF_AUDIO]  = _id_has ? 1 : -1;
    // MIX publish — unconditional (not gated on _id_has): a blank pad still has
    // a gain/pan a remote knob may be resting on, and the AUDIO flag above is
    // already the authoritative "is there anything here" signal for consumers.
    gmem[_id_mb + _reg_pi * 2 + PADMIX_OFF_GAIN] = p_gain[_reg_pi_s];
    gmem[_id_mb + _reg_pi * 2 + PADMIX_OFF_PAN]  = p_pan[_reg_pi_s];
    _reg_pi == 0 ? (   // per-instance, not per-pad — publish once per pass
      gmem[_id_mb + PADMIX_OFF_VOL_STYLE]  = pad_vol_style;
      gmem[_id_mb + PADMIX_OFF_VOL_APPEAR] = pad_vol_appear;
      gmem[_id_mb + PADMIX_OFF_PAN_STYLE]  = pad_pan_style;
      gmem[_id_mb + PADMIX_OFF_PAN_APPEAR] = pad_pan_appear;
    );
    _id_nbp = _id_nb + _reg_pi * INST_PADNAME_PAD_LEN;
    _id_cn  = get_cname_slot(_reg_pi_s);
    _id_sh  = get_idname_slot(_reg_pi);
    // One strcmp against the shadow (Phase 4, A O-3) in place of 32 gmem reads per pad
    _id_changed = strcmp(_id_cn, _id_sh) != 0;
    _id_heal && !_id_changed ? (
      _id_cl = strlen(_id_cn); _id_cj = 0;
      loop(INST_PADNAME_PAD_LEN,
        (gmem[_id_nbp + _id_cj] != (_id_cj < _id_cl ? str_getchar(_id_cn, _id_cj) : 0)) ? _id_changed = 1;
        _id_cj += 1;
      );
    );
    _id_changed ? (
      _id_cl = strlen(_id_cn); _id_cj = 0;
      loop(INST_PADNAME_PAD_LEN,
        gmem[_id_nbp + _id_cj] = _id_cj < _id_cl ? str_getchar(_id_cn, _id_cj) : 0;
        _id_cj += 1;
      );
      strcpy(_id_sh, _id_cn);
      gmem[_id_pb + IDENT_OFF_VER] = gmem[_id_pb + IDENT_OFF_VER] + 1;
    );
    _reg_pi += 1;
  );

  // ─── All-bank IDENTITY + name publish (2026-10-22): the MIDI editor names every bank's pads ──
  // Sixty-four pads (bank x 16 + pad) with the sixteen-pad band's eight fields and 32-char names. What the editor's
  // names need -- NOTE, the AUDIO flag and the name -- is compared EVERY block (the name against a shadow string per
  // pad, the A O-3 way, so a rename or a kit landing reaches the band on the next block); the other fields, and the
  // band's own name cells, on the heal blocks (every 64th, half a cycle from the sixteen-pad heal). Rewritten only
  // where it differs: a pad that changed bumps its VER; a pass that changed a NOTE, an AUDIO flag or a name bumps
  // GEN (LAST), any other field FGEN. The bank on screen plays no part, so a tab switch changes nothing in the editor
  // (the user: "all pad banknames in and to change iff the kit changes"). The HUE is the pad's own colour (the auto
  // colour is the bank on screen's; these bands' readers want names, not paint). One writer, this thread, no flag:
  // a dirty word set by mark_dirty_pad would be written from @gfx too (gfx_race).
  _id64_heal = (_bl_blkctr & 63) == 32 || _id64_slot != _reg_my_slot;
  _id64_slot = _reg_my_slot;
  _id64_ib = INST_IDENT64_BASE   + _reg_my_slot * INST_IDENT64_INST_STRIDE;
  _id64_nb = INST_PADNAME64_BASE + _reg_my_slot * INST_PADNAME64_INST_STRIDE;
  _id64_any = 0; _id64_fany = 0; _id64_s = 0;
  loop(NUM_SLOTS,
    _id64_pb = _id64_ib + INST_IDENT64_HDR + _id64_s * INST_IDENT_PAD_FIELDS;
    _id64_has = pad_is_playable(_id64_s);
    _id64_ch = 0; _id64_fch = 0;
    gmem[_id64_pb + IDENT_OFF_NOTE] != p_note[_id64_s] ? ( gmem[_id64_pb + IDENT_OFF_NOTE] = p_note[_id64_s]; _id64_ch = 1; );
    _id64_v = _id64_has ? 1 : -1;
    gmem[_id64_pb + IDENT_OFF_AUDIO] != _id64_v ? ( gmem[_id64_pb + IDENT_OFF_AUDIO] = _id64_v; _id64_ch = 1; );
    _id64_cn = get_cname_slot(_id64_s); _id64_sh = get_id64name_slot(_id64_s);
    (_id64_heal || strcmp(_id64_cn, _id64_sh) != 0) ? (
      _id64_cl = strlen(_id64_cn); _id64_np = _id64_nb + _id64_s * INST_PADNAME_PAD_LEN; _id64_j = 0;
      loop(INST_PADNAME_PAD_LEN,
        _id64_c = _id64_j < _id64_cl ? str_getchar(_id64_cn, _id64_j) : 0;
        gmem[_id64_np + _id64_j] != _id64_c ? ( gmem[_id64_np + _id64_j] = _id64_c; _id64_ch = 1; );
        _id64_j += 1;
      );
      strcpy(_id64_sh, _id64_cn);
    );
    _id64_heal ? (
      _id64_v = _id64_has ? p_color[_id64_s] : -2;
      gmem[_id64_pb + IDENT_OFF_HUE] != _id64_v ? ( gmem[_id64_pb + IDENT_OFF_HUE] = _id64_v; _id64_fch = 1; );
      gmem[_id64_pb + IDENT_OFF_MUTE] != p_mute[_id64_s] ? ( gmem[_id64_pb + IDENT_OFF_MUTE] = p_mute[_id64_s]; _id64_fch = 1; );
      gmem[_id64_pb + IDENT_OFF_SOLO] != p_solo[_id64_s] ? ( gmem[_id64_pb + IDENT_OFF_SOLO] = p_solo[_id64_s]; _id64_fch = 1; );
      gmem[_id64_pb + IDENT_OFF_OUTPUT] != p_output[_id64_s] ? ( gmem[_id64_pb + IDENT_OFF_OUTPUT] = p_output[_id64_s]; _id64_fch = 1; );
      gmem[_id64_pb + IDENT_OFF_ICON] != 0 ? ( gmem[_id64_pb + IDENT_OFF_ICON] = 0; _id64_fch = 1; );
    );
    (_id64_ch || _id64_fch) ? gmem[_id64_pb + IDENT_OFF_VER] = gmem[_id64_pb + IDENT_OFF_VER] + 1;
    _id64_ch ? _id64_any = 1;
    _id64_fch ? _id64_fany = 1;
    _id64_s += 1;
  );
  _id64_heal ? ( gmem[_id64_ib + IDENT64_OFF_PUBS] = gmem[_id64_ib + IDENT64_OFF_PUBS] + 1; gmem[_id64_ib + IDENT64_OFF_STAMP] = 1; );
  _id64_fany ? gmem[_id64_ib + IDENT64_OFF_FGEN] = gmem[_id64_ib + IDENT64_OFF_FGEN] + 1;
  _id64_any ? gmem[_id64_ib + IDENT64_OFF_GEN] = gmem[_id64_ib + IDENT64_OFF_GEN] + 1;   // LAST

  // ─── Browser kit-name + per-pad metadata mirror ──────────────────
  // The browser reads kit_name + per-pad notes from gmem for its title
  // and the pad-info strip. @gfx writes most of this when the FX window
  // is open, but when the targeted instance's window is closed @gfx
  // doesn't run and the browser would see stale data. Mirror from
  // @block so the browser stays in sync with the picked instance even
  // with all FX windows closed. Never while ANOTHER instance holds LOCK:
  // these are the bands a save or load is staging (swing_shared_bands_free).
  _is_browser_target() && swing_shared_bands_free() ? (
    // Kit name (16 chars at GS_KIT_NAME_BASE) — browser title
    _kn_len = strlen(#kit_name);
    _kn_i = 0;
    loop(16,
      gmem[GS_KIT_NAME_BASE + _kn_i] = _kn_i < _kn_len ? str_getchar(#kit_name, _kn_i) : 0;
      _kn_i += 1;
    );
    // Per-pad fields the browser pad grid + info strip read every frame.
    // Writing them all here keeps the browser perfectly in sync with the
    // targeted instance — switch the picker, the next audio block flips
    // the entire pad-grid display to the new instance's state.
    // The note, hue and name cells are ALSO the kit-transfer staging cells, so
    // those three are mirrored only while no import / rename / browser load is
    // in flight:
    //   kit_busy  — the bridge is writing kit data to gmem (CMD=2 is
    //               still active, pad names already written but CMD=3
    //               hasn't landed yet), or a save's dump is staged for it.
    //   CMD 3     — bridge finished writing; import hasn't read yet.
    //   CMD 50/51 — rename dialog in flight.
    //   CMD 63/64 — browser sample/layer load in flight.
    // Only the name had this gate. The note and hue did not, and the import
    // reads them later in this same block (swing_ui_import_tick runs after this
    // mirror): a load took the OUTGOING kit's notes and hues, and since step 3b
    // adds the pass's bank offset, a load with bank B..D shown shifted every
    // note by that bank's offset -- a chop into D put every pad on 127 (Pad
    // Banks audit M5). A save's dump was rewritten the same way before the
    // bridge read it.
    _bm_idle = !kit_busy &&
      gmem[KIT_GMEM_CMD] != 3 &&
      gmem[KIT_GMEM_CMD] != 50 && gmem[KIT_GMEM_CMD] != 51 &&
      gmem[KIT_GMEM_CMD] != 63 && gmem[KIT_GMEM_CMD] != 64;
    _bm_pi = 0;
    loop(NUM_PADS,
      _bm_pi_s = swing_bp(_bm_pi);
      _bm_idle ? (   // the note and hue are staging cells too (audit M5)
        // p_note (META +10) — pad-info strip + Set Trigger Note menu
        gmem[KIT_GMEM_META + _bm_pi * KIT_GMEM_META_PP + 10] = p_note[_bm_pi_s];
        // Effective pad hue (META +12) — when auto-color is active the JSFX
        // pad face uses col_auto_hue[i] (drum-type / output / folder detection),
        // NOT the manual p_color[i]. Mirror the same source so the browser
        // reflects auto-color changes the moment the user toggles them.
        gmem[KIT_GMEM_META + _bm_pi * KIT_GMEM_META_PP + 12] =
          col_auto_mode_id > 0 ? col_auto_hue[_bm_pi] : p_color[_bm_pi_s];
      );
      // audio_len — non-layered pads write the ACTUAL sample count (s_len)
      // so the bridge can stream pad audio out of gmem for Choppa-applied
      // pads that have no disk source. Layered pads write sentinel 1 — they
      // always use disk-source streaming in write_kit_v4, so exact length
      // doesn't matter, only that empty-kit detection sees a non-zero.
      gmem[KIT_GMEM_AUDIOLEN + _bm_pi] =
        s_len[_bm_pi_s] > 0 ? s_len[_bm_pi_s] :
        (pad_has_audio(_bm_pi_s) ? 1 : 0);
      // Effective mute (own mute OR muted-by-solo) — browser dims muted pads
      gmem[GS_PAD_MUTED_BASE + _bm_pi] =
        (p_mute[_bm_pi_s] || (any_solo && !p_solo[_bm_pi_s])) ? 1 : 0;
      // Pad name (32 chars at KIT_GMEM_PADNAMES + pad*32). Only mirror
      // when no import/rename/browser-load is in flight (_bm_idle, above).
      // Without this, the mirror clobbers kit names during the audio-write
      // phase.
      _bm_idle ? (
        _bm_cn = get_cname_slot(_bm_pi_s);
        _bm_cnl = strlen(_bm_cn);
        _bm_cnl > 0 ? (
          _bm_cj = 0;
          loop(KIT_GMEM_PADNAME_LEN,
            gmem[KIT_GMEM_PADNAMES + _bm_pi * KIT_GMEM_PADNAME_LEN + _bm_cj] =
              _bm_cj < _bm_cnl ? str_getchar(_bm_cn, _bm_cj) : 0;
            _bm_cj += 1;
          );
        );
      );
      _bm_pi += 1;
    );
  );

  // ─── Periodic collision reconciliation (~1 Hz) ────────────────────
  // Runs after the heartbeat write so other instances see our id.
  // If another slot holds our exact id, it is ONE of two things and they
  // need opposite handling (identity rollout, 2026-07-08):
  //   LIVE DUPLICATE (copied track / pasted FX) — its heartbeat ADVANCES
  //     between passes. Duel as before: lower slot index keeps the id,
  //     higher re-mints. Convergence: N duplicates take N-1 cycles.
  //   GHOST (our own dead incarnation after a reload/recompile — registry
  //     cells persist in gmem) — its heartbeat is FROZEN. Freshness alone
  //     cannot tell it from a live dup for TIMEOUT seconds, and conceding
  //     to a ghost is how instances silently re-minted their id and
  //     orphaned every client that had cached it (kit loads mistargeted
  //     forever = the run6 load wedge). Clear ghosts instead.
  // Two-sighting rule: only classify on a slot's SECOND consecutive
  // sighting (_coll_hb_prev > 0), so a single stale read never triggers a
  // duel. A backgrounded project tab's instance also freezes (@block
  // stops); if it gets cleared as a ghost, its own @block heartbeat
  // re-registers the slot on the first block after the tab foregrounds.
  _coll_now = time_precise();
  (_coll_now - _coll_last_check) > 1.0 ? (
    _coll_last_check = _coll_now;
    _coll_other_slot = -1;
    _coll_si = 0;
    loop(GS_INST_REG_MAX,
      _coll_base = GS_INST_REG_BASE + _coll_si * GS_INST_REG_STRIDE;
      _coll_id_check = gmem[_coll_base];
      _coll_hb_check = gmem[_coll_base + 1];
      (_coll_si != _reg_my_slot && _coll_id_check == instance_id &&
       _coll_hb_check > 0) ? (
        (_coll_hb_prev[_coll_si] > 0 &&
         _coll_hb_check != _coll_hb_prev[_coll_si] &&
         (_coll_now - _coll_hb_check) < GS_INST_REG_TIMEOUT) ? (
          _coll_other_slot = _coll_si;         // advancing heartbeat = live duplicate
        ) : (_coll_hb_prev[_coll_si] > 0 &&
             _coll_hb_check == _coll_hb_prev[_coll_si]) ? (
          // Frozen across two sightings = ghost carrying our id. Clear it so
          // it can never duel us or block slot reuse.
          gmem[_coll_base]     = 0;
          gmem[_coll_base + 1] = 0;
        );
      );
      _coll_hb_prev[_coll_si] = _coll_hb_check;
      _coll_si += 1;
    );
    (_coll_other_slot >= 0 && _coll_other_slot < _reg_my_slot) ? (
      // We're the duplicate; vacate our slot, then mint a fresh id. Vacate only
      // while the cell still holds the id we are giving up: a peer that took
      // the slot in the meantime keeps it.
      gmem[GS_INST_REG_BASE + _reg_my_slot * GS_INST_REG_STRIDE] == instance_id ? (
        gmem[GS_INST_REG_BASE + _reg_my_slot * GS_INST_REG_STRIDE]     = 0;
        gmem[GS_INST_REG_BASE + _reg_my_slot * GS_INST_REG_STRIDE + 1] = 0;
      );
      gmem[KIT_GMEM_INSTANCE_NEXT] += 1;
      slider4 = gmem[KIT_GMEM_INSTANCE_NEXT];
      instance_id = slider4;
      _reg_my_slot = -1;  // force re-claim on next @block
    );
  );
);

// ── Auto-load default 808 kit on first run (was @gfx-gated; moved to
//    @block so it fires when the FX window is closed too). Same logic
//    as the @gfx-side block at line ~2041 was — preserved here verbatim
//    so collapsed FX chains on project reopen don't strand the bridge
//    waiting for an @gfx tick that never comes.
//    Secondary guard: skip if any pad already has audio. On hot-reload
//    (source file change), REAPER zeros all variables before @serialize
//    restores them — _auto_load_attempted is momentarily 0 and @block
//    can fire in that window, clobbering the user's current kit. Checking
//    s_len catches that case: a truly fresh instance has empty pads.
// Suppress the 808 auto-load on PROJECT REOPEN. A reopen restores its kit via
// @serialize (+ the bridge preserve-live sidecar reload); firing the default
// auto-load in that same window stages a SECOND kit whose incremental state-3
// copy collides with the restore → scattered blank pads. Isolation test 2026-
// 07-06 confirmed: reopen blanks, fresh-insert (auto-load only) + manual load
// (manual only) are clean → it is the two-load collision, not a copy bug.
// Two guards close it:
//   * !_has_deserialized — set by @serialize is_read; a reopen has it, a truly
//     fresh insert never does, so this fires only for genuine fresh inserts.
//   * _al_settle_smp — wait ~250ms of audio first, because is_read can lag the
//     first @block on re-instantiation (reference_jsfx_reinstantiation_coldstart),
//     which is the very window that let the auto-load slip through before.
_al_settle_smp < srate ? _al_settle_smp += samplesblock;
!_auto_load_attempted && _al_settle_smp >= srate * 0.25 && !_has_deserialized &&
  gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 &&
  gmem[KIT_GMEM_CMD] == 0 && gmem[KIT_GMEM_LOCK] == 0 ? (
  // Bail if any pad already has audio (hot-reload guard)
  _al_has_audio = 0;
  _al_i = 0; loop(NUM_SLOTS,
    s_len[_al_i] > 0 ? _al_has_audio = 1;
    _al_i += 1;
  );
  !_al_has_audio ? (
    gmem[KIT_GMEM_LOCK]        = instance_id;
    gmem[GS_PENDING_LOAD_INST] = instance_id;  // legacy want (old-bridge compat)
    gmem[GS_LOAD_WANT]         = instance_id;  // Phase 1b request-want channel
    gmem[KIT_GMEM_CMD]         = 22;
  );
  _auto_load_attempted       = 1;
);

// ── Bridge-driven kit-load delivery gate (moved from @gfx). Fires when
//    the bridge has staged a kit for THIS instance via Path B
//    (drive_load_queue → load_swing_dispatch → CMD=3 + GS_KIT_LOAD_REQ=2
//    + PENDING_LOAD_INST=instance_id). Without this in @block, project
//    reopen with FX chains collapsed never enters kit_import_state=1 and
//    the bridge stalls on its per-instance timeout.
//    PENDING is the ONLY arm condition (exclusive delivery, Phase 1
//    2026-07-17): the old `|| _is_browser_target()` OR-arm let TWO
//    instances qualify for one staged kit (PENDING=B while the browser
//    bound gmem[INSTANCE]=A) — whichever @block ran first stole the
//    load, non-deterministically. Every producer now names its consumer
//    via PENDING (browser f9acac9; queue pop; chop dispatch/retry;
//    CMD-82 undo; CMD-22 auto-load), so the browser-binding arm was
//    pure race surface. Mirrored in Swing_Lite.jsfx.
//    Phase 1b — EPOCH is the primary arm signal: the bridge stamps
//    GS_LOAD_EPOCH LAST at dispatch (after staging + PENDING), so an
//    epoch the instance hasn't seen + PENDING match = a complete staged
//    delivery, immune to the REQ cell's value collisions (a rapid next
//    click writes REQ=1 over the in-flight data-ready 2 and orphaned the
//    dispatch for the full 30s timeout — kitpipe storm catch). The
//    REQ==2 arm remains as the STALE-BRIDGE compat path (an old bridge
//    never stamps the epoch). kit_load_epoch = last epoch ARMED; echoed
//    ±epoch from the import state machine as the completion ack.
//    CMD==3 is REQUIRED (Phase 1b fix, 2026-07-17): it means a kit is
//    actually STAGED. Without it, the epoch-change branch armed on
//    PENDING match alone — but the health/REB paths (CMD 86/87/88) also
//    write PENDING to target an instance, and GS_LOAD_EPOCH is a GLOBAL
//    cell, so once ANY instance had loaded, a health-tick PENDING write
//    spuriously armed kit-import with no kit staged and wedged CMD=87
//    (kitpipe_multi 7/8 fail). CMD is the staging latch the bridge holds
//    through delivery and is NOT touched by request traffic, so it cannot
//    reintroduce the REQ value-collision the epoch trigger exists to dodge.
//    EDGE trigger, not level (Phase 1b fix #2): kit_epoch_seen tracks the
//    global epoch cell EVERY block, so the epoch branch fires only when
//    the cell CHANGES between blocks — i.e., only after the bridge's
//    final post-staging stamp. Comparing against the last ARMED epoch
//    instead (level trigger) let a never-armed instance treat the STALE
//    global value as "new" and arm mid-staging, importing a half-written
//    kit (kitpipe multi/retrykill stalls at cmd=0 req=2). Phase 1's
//    REQ==2 test was this barrier implicitly — REQ was written last.
//    kit_load_epoch (the ack echo) still records the epoch ARMED on.
kit_import_state == 0 && !kit_busy &&
  gmem[GS_PENDING_LOAD_INST] == instance_id &&
  gmem[KIT_GMEM_CMD] == 3 &&
  (gmem[GS_LOAD_EPOCH] != kit_epoch_seen || gmem[GS_KIT_LOAD_REQ] == 2) ? (
  kit_import_state = 1;
  kit_busy = 1;
  kit_load_epoch = gmem[GS_LOAD_EPOCH];
  // This gate only fires on the post-staging epoch edge / REQ==2 stamp, so
  // the delivery is complete by definition — tell state 1 it may advance
  // immediately (it consumed our REQ/epoch signals, so it needs this flag).
  kit_stage_ready = 1;
  gmem[GS_KIT_LOAD_REQ] == 2 ? gmem[GS_KIT_LOAD_REQ] = 0;  // never eat a fresh request (1)
  gmem[GS_PENDING_LOAD_INST] = 0;
);
kit_epoch_seen = gmem[GS_LOAD_EPOCH];  // track ALWAYS → next block sees only fresh stamps

// ── DEV HOOK (kitsview probe): synthetic pick through the REAL emitter.
//    EON_KITLIST header cell +7 (in-band, reserved), consumed here in @block
//    so headless probes exercise swing_kitsview_emit_pick (path assembly +
//    gate + CMD 24) end-to-end — the @gfx view can't run headless.
//    Hardened 2026-08-03; an emit here is a FULL kit load that replaces the
//    customer's pads, so the trigger has to be collision-proof:
//    * value = KV_DEVPICK_MAGIC + record index + 1. A bare small integer no
//      longer fires — a stray count/index/instance_id landing in this cell
//      draws in the magic window's range check and is dropped instead.
//    * the cell clears on EVERY consume, success or not. The old
//      consume-on-success retry meant one out-of-range value re-ran the
//      failed emit every audio block forever; probes re-post on failure now.
_kv_devpick = gmem[EON_KITLIST_BASE + 7] | 0;
_kv_devpick != 0 ? (
  gmem[EON_KITLIST_BASE + 7] = 0;   // consume FIRST — never retry, never wedge
  _kv_devpick >= KV_DEVPICK_MAGIC && _kv_devpick < KV_DEVPICK_MAGIC + 100000 ?
    swing_kitsview_emit_pick(_kv_devpick - KV_DEVPICK_MAGIC - 1);
  // anything outside the magic window is a stray write: dropped, never acted on
);

// ── P3 migration: CMD-86 path-rewrite handshake (strings only, NO reload).
//    The bridge copied unsaved-store chop WAVs into the project store and
//    staged the corrected paths in the DEDICATED band (GS_MIGR_PAD_CELLS /
//    GS_MIGR_LAYER_CELLS — payload FIRST, CMD 86 LAST, PENDING_LOAD_INST
//    targets us). The band moved off the KIT_GMEM_AUDIO cells 2026-07-12:
//    those are a scratch bus (block_pitch PCM streaming stomped the staged
//    paths before this consume ran → ack with zero adoptions, rewrites
//    never reached the chunk). Adopt: strcpy pad/layer path slots from any
//    NON-EMPTY cell (empty = leave that slot alone), echo how many cells
//    were adopted into GS_MIGR_ADOPTED (bridge presets -1 and retries a
//    short echo), mark project dirty so the next save persists the
//    rewritten paths, ack with CMD=0. Audio buffers untouched — the old
//    paths still resolve (files are COPIED, never moved), so a crash
//    between save and re-save loses nothing.
//    Scratch _pr86_* is @block-only (never referenced in @gfx) per the
//    gfx/block concurrency rule; string build mirrors the INCMD NAME consume.
gmem[KIT_GMEM_CMD] == 86 && !kit_busy &&
  gmem[GS_PENDING_LOAD_INST] == instance_id ? (
  _pr86_adopted = 0;
  _pr86_ki = 0;
  loop(NUM_PADS,
    _pr86_ki_s = swing_bp(_pr86_ki);
    // pad-main path cell
    _pr86_pb  = GS_MIGR_PAD_CELLS + _pr86_ki * 260;
    _pr86_len = gmem[_pr86_pb] | 0;
    _pr86_len > 0 && _pr86_len < 259 ? (
      _pr86_sp = get_path_slot(_pr86_ki_s);
      str_setlen(_pr86_sp, 0);
      _pr86_ci = 0;
      loop(_pr86_len,
        str_setchar(_pr86_sp, _pr86_ci, gmem[_pr86_pb + 1 + _pr86_ci] | 0);
        _pr86_ci += 1;
      );
      str_setlen(_pr86_sp, _pr86_len);
      _pr86_adopted += 1;
    );
    // per-layer path cells
    _pr86_lj = 0;
    loop(MAX_LAYERS,
      _pr86_pb  = GS_MIGR_LAYER_CELLS +
                  (_pr86_ki * MAX_LAYERS + _pr86_lj) * 260;
      _pr86_len = gmem[_pr86_pb] | 0;
      _pr86_len > 0 && _pr86_len < 259 ? (
        _pr86_sp = LPATH_STR_BASE + _pr86_ki * MAX_LAYERS + _pr86_lj;
        str_setlen(_pr86_sp, 0);
        _pr86_ci = 0;
        loop(_pr86_len,
          str_setchar(_pr86_sp, _pr86_ci, gmem[_pr86_pb + 1 + _pr86_ci] | 0);
          _pr86_ci += 1;
        );
        str_setlen(_pr86_sp, _pr86_len);
        _pr86_adopted += 1;
      );
      _pr86_lj += 1;
    );
    _pr86_ki += 1;
  );
  paths_gen += 1;                    // P4 step 3: path mutation → invalidate bridge publish cache
  gmem[GS_MIGR_ADOPTED] = _pr86_adopted;  // echo BEFORE the ack (bridge reads it on CMD==0)
  gmem[GS_PROJ_DIRTY] = 1;           // next save persists the rewritten paths
  gmem[GS_PENDING_LOAD_INST] = 0;
  gmem[KIT_GMEM_CMD] = 0;            // ack — bridge advances to next instance
);

// ── P4 step 3: CMD-87 path publish (bridge-requested). Copies this
//    instance's LIVE pad/layer path strings + lengths + layer counts + the
//    pad_fail_bits bitmap into the REB publish band (see const block for
//    why the bridge has no other trustworthy source on a cold reopen).
//    Payload first, GS_REB_PUB_ACK second (bridge presets 0), CMD ack LAST.
//    Worst case ~21k gmem writes in one @block — bounded, and only on an
//    explicit bridge request (rebase audit / health refresh / relink).
gmem[KIT_GMEM_CMD] == 87 && !kit_busy &&
  gmem[GS_PENDING_LOAD_INST] == instance_id ? (
  diag_armed ? diag_p87_t0 = time_precise();   // EON_DIAG +15 (armed only)
  _pr87_cnt = 0; _pr87_skip = 0;
  // the bank selector (see GS_REB_PUB_BANK): 0 keeps the old publish exactly. Clean sample store asks for each
  // bank in turn -- it used to see only the bank on screen and bank A's layers, and deleted the rest's samples.
  _pr87_bs = gmem[GS_REB_PUB_BANK] | 0;
  (_pr87_bs < 1 || _pr87_bs > NUM_BANKS) ? _pr87_bs = 0;
  _pr87_ki = 0;
  loop(NUM_PADS,
    _pr87_ki_s = _pr87_bs ? (_pr87_bs - 1) * NUM_PADS + _pr87_ki : swing_bp(_pr87_ki);
    _pr87_sp  = get_path_slot(_pr87_ki_s);
    _pr87_len = strlen(_pr87_sp);
    _pr87_pb  = GS_REB_PAD_CELLS + _pr87_ki * 260;
    _pr87_len > 258 ? ( gmem[_pr87_pb] = 0; _pr87_skip += 1; ) : (
      gmem[_pr87_pb] = _pr87_len;
      _pr87_ci = 0;
      loop(_pr87_len,
        gmem[_pr87_pb + 1 + _pr87_ci] = str_getchar(_pr87_sp, _pr87_ci);
        _pr87_ci += 1;
      );
      gmem[_pr87_pb + 1 + _pr87_len] = 0;
      _pr87_len > 0 ? _pr87_cnt += 1;
    );
    gmem[GS_REB_SLEN + _pr87_ki]     = s_len[_pr87_ki_s];
    gmem[GS_REB_LAYERCNT + _pr87_ki] = p_layer_cnt[_pr87_ki_s];
    _pr87_lj = 0;
    loop(MAX_LAYERS,
      _pr87_lx  = _pr87_ki * MAX_LAYERS + _pr87_lj;   // the band position
      _pr87_ls  = (_pr87_bs ? _pr87_ki_s : _pr87_ki) * MAX_LAYERS + _pr87_lj;   // the slot's layer (selector 0: bank A's, as before)
      _pr87_sp  = LPATH_STR_BASE + _pr87_ls;
      _pr87_len = strlen(_pr87_sp);
      _pr87_pb  = GS_REB_LAYER_CELLS + _pr87_lx * 260;
      _pr87_len > 258 ? ( gmem[_pr87_pb] = 0; _pr87_skip += 1; ) : (
        gmem[_pr87_pb] = _pr87_len;
        _pr87_ci = 0;
        loop(_pr87_len,
          gmem[_pr87_pb + 1 + _pr87_ci] = str_getchar(_pr87_sp, _pr87_ci);
          _pr87_ci += 1;
        );
        gmem[_pr87_pb + 1 + _pr87_len] = 0;
        _pr87_len > 0 ? _pr87_cnt += 1;
      );
      gmem[GS_REB_LLEN + _pr87_lx] = l_len[_pr87_ls];
      _pr87_lj += 1;
    );
    _pr87_ki += 1;
  );
  gmem[GS_REB_FAIL_BITS]   = pad_fail_bits;
  gmem[GS_REB_PUB_COUNT]   = _pr87_cnt;
  gmem[GS_REB_SKIPPED]     = _pr87_skip;
  gmem[GS_REB_RESTORE_GEN] = _reb_restore_gen;
  gmem[GS_REB_PUB_BANK_ECHO] = _pr87_bs;        // the selector honoured (a producer presets it to -1)
  gmem[GS_REB_PUB_BANK] = 0;                    // one-shot: the next producer gets the old publish unless it asks
  gmem[GS_REB_PUB_ACK] = gmem[GS_REB_PUB_REQ];  // echo the request nonce (producer presets ACK=0)
  gmem[GS_PENDING_LOAD_INST] = 0;
  gmem[KIT_GMEM_CMD] = 0;              // ack LAST
  diag_armed ? diag_p87_last = time_precise() - diag_p87_t0;
);

// ── P4 step 3: CMD-88 adopt + reload-blank (auto-rebase / relink repair).
//    Same staging band + adoption loop as CMD 86, PLUS an audio reload for
//    adopted pads whose buffers are blank (the marker-reload casualties).
//    NOT CMD 63/64: swing_browser_load_pad clear_pad()s first — that wipes
//    the pad's chunk-restored FX/mix state; here only audio + path change.
//    Reloads are chunked ONE PAD PER @BLOCK (VER-201 state-3 precedent:
//    bounded disk-read burst on the audio thread) with kit_busy held and
//    CMD held at 88; echo + refreshed fail bits land BEFORE the CMD=0 ack.
//    _pr88_* state is @block-only (gfx/block concurrency rule).
gmem[KIT_GMEM_CMD] == 88 && !kit_busy && !_pr88_active &&
  gmem[GS_PENDING_LOAD_INST] == instance_id ? (
  _pr88_adopted = 0;
  _pr88_ki = 0;
  loop(NUM_PADS,
    _pr88_ki_s = swing_bp(_pr88_ki);
    _pr88_pb  = GS_MIGR_PAD_CELLS + _pr88_ki * 260;
    _pr88_len = gmem[_pr88_pb] | 0;
    _pr88_len > 0 && _pr88_len < 259 ? (
      _pr88_sp = get_path_slot(_pr88_ki_s);
      str_setlen(_pr88_sp, 0);
      _pr88_ci = 0;
      loop(_pr88_len,
        str_setchar(_pr88_sp, _pr88_ci, gmem[_pr88_pb + 1 + _pr88_ci] | 0);
        _pr88_ci += 1;
      );
      str_setlen(_pr88_sp, _pr88_len);
      _pr88_adopted += 1;
    );
    _pr88_lj = 0;
    loop(MAX_LAYERS,
      _pr88_pb  = GS_MIGR_LAYER_CELLS +
                  (_pr88_ki * MAX_LAYERS + _pr88_lj) * 260;
      _pr88_len = gmem[_pr88_pb] | 0;
      _pr88_len > 0 && _pr88_len < 259 ? (
        _pr88_sp = LPATH_STR_BASE + _pr88_ki * MAX_LAYERS + _pr88_lj;
        str_setlen(_pr88_sp, 0);
        _pr88_ci = 0;
        loop(_pr88_len,
          str_setchar(_pr88_sp, _pr88_ci, gmem[_pr88_pb + 1 + _pr88_ci] | 0);
          _pr88_ci += 1;
        );
        str_setlen(_pr88_sp, _pr88_len);
        _pr88_adopted += 1;
      );
      _pr88_lj += 1;
    );
    _pr88_ki += 1;
  );
  paths_gen += 1;
  _pr88_active = 1;   // reload pump below takes over (1 pad per @block)
  _pr88_pad = 0;
  _pr88_pass_pad = -1; _pr88_done = 0;   // sliced loads: per-pad done bits (see the pump)
  kit_busy = 1;       // exclusive: defers 63/64/65/86/87 + bake swaps
  // Suppress per-pad undo captures for the pump's reloads — the structural
  // undo engine (single s2 entry + single shared name buffer) is @gfx-era
  // machinery; bulk @block loads must not mint captures (kit imports set
  // exactly this suppression during state 1-4). A bridge-driven repair
  // reload is not a user edit — nothing to undo to.
  _udo_cap_depth = 1;
);
// CMD-88 reload pump — runs while the consume above is in flight.
_pr88_active ? (
  gmem[KIT_GMEM_CMD] == 88 ? (
    // Reload rules mirror the ser-51 marker reload (see @serialize):
    //   staged layer cell + no layer audio      → load_layer_from_path
    //   staged pad-main + legacy pad, no audio  → load_from_path
    //   staged pad-main + promoted-single (no layer cells staged, no layer
    //   audio at all)                           → load_from_path fallback
    // Sliced loads: a pad's reloads may span several @blocks. Done bits per
    // (pad) pass remember which loads already ran (a failed load must not be
    // retried every block, and re-beginning it would drop the job in flight);
    // a load still in flight makes the pump YIELD — no advance, re-enter next
    // block and pump it again.
    _pr88_pass_pad != _pr88_pad ? ( _pr88_pass_pad = _pr88_pad; _pr88_done = 0; );
    _pr88_yield = 0;
    _pr88_pmst = gmem[GS_MIGR_PAD_CELLS + _pr88_pad * 260] | 0;
    _pr88_pmst = _pr88_pmst > 0 && _pr88_pmst < 259;
    _pr88_anyst = 0;
    _pr88_lj = 0;
    loop(MAX_LAYERS,
      _pr88_lx  = _pr88_pad * MAX_LAYERS + _pr88_lj;
      _pr88_len = gmem[GS_MIGR_LAYER_CELLS + _pr88_lx * 260] | 0;
      _pr88_len > 0 && _pr88_len < 259 ? (
        _pr88_anyst = 1;
        !_pr88_yield && !(_pr88_done & 2^_pr88_lj) && l_len[_pr88_lx] <= 0 ? (
          swing_ldr_step_layer(_pr88_pad, _pr88_lj, LPATH_STR_BASE + _pr88_lx) ?
            ( _pr88_done |= 2^_pr88_lj; ) : ( _pr88_yield = 1; );
        );
      );
      _pr88_lj += 1;
    );
    !_pr88_yield && _pr88_pmst ? (
      !(_pr88_done & 256) && p_layer_cnt[_pr88_pad] == 0 && s_len[_pr88_pad] <= 0 ? (
        swing_ldr_step_pad(_pr88_pad, get_path_slot(_pr88_pad)) ?
          ( _pr88_done |= 256; ) : ( _pr88_yield = 1; );
      );
      !_pr88_yield && !(_pr88_done & 512) && p_layer_cnt[_pr88_pad] > 0 && !_pr88_anyst ? (
        _pr88_anyl = 0;
        _pr88_lj = 0;
        loop(MAX_LAYERS,
          l_len[_pr88_pad * MAX_LAYERS + _pr88_lj] > 0 ? _pr88_anyl = 1;
          _pr88_lj += 1;
        );
        !_pr88_anyl ? (
          swing_ldr_step_pad(_pr88_pad, get_path_slot(_pr88_pad)) ?
            ( _pr88_done |= 512; ) : ( _pr88_yield = 1; );
        ) : ( _pr88_done |= 512; );
      );
    );
    !_pr88_yield ? (
    _pr88_pad += 1;
    _pr88_pad >= NUM_PADS ? (
      gmem[GS_MIGR_ADOPTED]  = _pr88_adopted;   // echo BEFORE the ack
      gmem[GS_REB_FAIL_BITS] = pad_fail_bits;   // post-reload outcome for the bridge
      gmem[GS_PROJ_DIRTY] = 1;                  // next save persists rewrites
      gmem[GS_PENDING_LOAD_INST] = 0;
      _pr88_active = 0;
      kit_busy = 0;
      _udo_cap_depth = 0;                       // release capture suppression
      gmem[KIT_GMEM_CMD] = 0;                   // ack LAST
    );
    );  // close the !_pr88_yield gate (sliced loads)
  ) : (
    // CMD cleared externally mid-flight (bridge timeout / stale-CMD
    // watchdog) — abandon cleanly; adopted strings stay (harmless), audio
    // reload resumes on the bridge's re-dispatch. A load in flight is dropped.
    swing_ldr_abort(ldr_job0);
    _pr88_active = 0;
    kit_busy = 0;
    _udo_cap_depth = 0;
  );
);

// ── Transfer-capability advertisement: tells the bridge which kit-load
//    protocols this build understands (26 = per-pad gmem handshake,
//    201 = per-layer PATH import, 202 = CMD-86 dedicated staging band +
//    adopted-count echo, 203 = CMD-87 path publish + CMD-88 adopt-and-
//    reload + REB bands). Bridge checks >= threshold, so one cell covers
//    all. A stale build never writes this → bridge falls back to the
//    packed VER-24 layout (and to legacy CMD-86 cells below 202).
//    204 = EON_PADPCM: the bridge may stream decoded PCM (rk_swing_padpcm).
//    205 = PAD BANKS (step 3b, 2026-09-23): GS_KIT_EXPORT_BANK / GS_KIT_LOAD_BANK honoured.
//    206 = CMD 87's bank selector (GS_REB_PUB_BANK + its echo, 2026-10-23): Clean sample store refuses below it.
gmem[KIT_HS_CAP] = 206;
// ⚠️ The new-id counter follows every RESTORED id (2026-10-23, H11). gmem is empty after a REAPER restart, and
// @init mints before the saved id is back (see the mint), so the counter only counted the instances loaded: with ids
// that have gaps (a Swing deleted, a project of several sessions) a fresh insert soon minted an id a loaded Swing
// holds -- its 808 auto-load landed on the OLD Swing (every bridge lookup resolves an id to the first Swing in track
// order), renamed its folder and rewrote its kit source until the duel told them apart. instance_id is the saved
// id from the @serialize read on; that read raises the counter first (it runs with the audio stopped too), this line
// keeps it raised (a race between two instances' reads self-heals here). One read and one compare per block.
instance_id > gmem[KIT_GMEM_INSTANCE_NEXT] ? gmem[KIT_GMEM_INSTANCE_NEXT] = instance_id;
// P4 step 3: publish this instance's path-mutation counter into its
// registry slot every @block (rewritten continuously = self-heals across
// reg-slot re-adopt). The bridge invalidates its cached CMD-87 publish +
// disk-health verdict whenever this moves.
_reg_my_slot >= 0 ? ( gmem[GS_REB_SLOT_BASE + _reg_my_slot * 8] = paths_gen; );

// ── EON_DIAG publish (armed only): close out the previous block's cost, then
//    write this slot's record with SEQ last. Layout at the EON_DIAG_* constants.
diag_armed ? (
  gmem[EON_DIAG_BASE + 1] != diag_reset_seen ? (
    diag_reset_seen = gmem[EON_DIAG_BASE + 1];
    diag_blocks = 0; diag_stall_n = 0; diag_pause_n = 0; diag_gap_max = 0;
    diag_cost_last = 0; diag_cost_max = 0; diag_cost_ema = 0; diag_ratio_max = 0;
    diag_overrun_n = 0; diag_bema = 0; diag_sema = 0; diag_p87_last = 0;
  );
  // A full previous block (armed at its entry, all its samples stamped).
  diag_t0_prev > 0 && diag_t1 > diag_t0_prev && diag_spl >= samplesblock ? (
    diag_cost_last = diag_t1 - diag_t0_prev;
    _dg_ratio = diag_cost_last * srate / samplesblock;
    diag_cost_last > diag_cost_max ? diag_cost_max = diag_cost_last;
    _dg_ratio > diag_ratio_max ? diag_ratio_max = _dg_ratio;
    _dg_ratio > 1 ? diag_overrun_n += 1;
    diag_cost_ema = diag_blocks > 0 ? diag_cost_ema + (diag_cost_last - diag_cost_ema) / 32 : diag_cost_last;
    // Split at the first-@sample stamp: @block entry -> first sample = the @block pass,
    // first sample -> last sample = the sample loop.
    diag_ts > diag_t0_prev && diag_t1 > diag_ts ? (
      diag_bema = diag_blocks > 0 ? diag_bema + ((diag_ts - diag_t0_prev) - diag_bema) / 32 : diag_ts - diag_t0_prev;
      diag_sema = diag_blocks > 0 ? diag_sema + ((diag_t1 - diag_ts) - diag_sema) / 32 : diag_t1 - diag_ts;
    );
    diag_blocks += 1;
  );
  _reg_my_slot >= 0 && _reg_my_slot < EON_DIAG_SLOT_MAX ? (
    _dg = EON_DIAG_SLOT_BASE + _reg_my_slot * EON_DIAG_SLOT_STRIDE;
    gmem[_dg + 1]  = samplesblock;    gmem[_dg + 2]  = srate;
    gmem[_dg + 3]  = diag_stall_n;    gmem[_dg + 4]  = diag_pause_n;   gmem[_dg + 5]  = diag_gap_max;
    gmem[_dg + 6]  = diag_cost_last;  gmem[_dg + 7]  = diag_cost_max;  gmem[_dg + 8]  = diag_cost_ema;
    gmem[_dg + 9]  = diag_ratio_max;  gmem[_dg + 10] = diag_reset_seen; gmem[_dg + 11] = diag_overrun_n;
    gmem[_dg + 12] = diag_blocks;
    gmem[_dg + 13] = diag_bema;       gmem[_dg + 14] = diag_sema;
    gmem[_dg + 15] = diag_p87_last;
    gmem[_dg] = _bl_blkctr;   // SEQ, written LAST
  );
);
diag_spl = 0;   // the coming block's @sample count


// ── Run the kit-import state machine in @block so it runs whether the
//    FX UI is visible or not. swing_ui_import_tick() doesn't touch
//    gfx_* state — it's pure data shuffling (gmem reads, str_*, memset,
//    DSP recalc, audio buffer copy). Removed from @gfx (was at line
//    ~1987) to avoid running it on both threads concurrently — state 3
//    has incremental kit_copy_pad/layer/pos counters that would race.
swing_ui_import_tick();

// Gate-mode releases from the UI thread (A-9b), at the block's end: a press and
// its release posted within one block still give the voice this block.
swing_block_gt_release();

// ── Output routing (Pad Banks Outputs step 1), after every launch site of the block: the channel each awake pad
//    writes in @sample (pad_bus), and out_nch, how far multi-out / Wired clear, guard and crossfade there -- the
//    38 of before unless an awake pad plays on a bank track or a split pair, so an instance that never uses the
//    new pairs pays nothing for them. A pad that falls asleep in @sample keeps its channel until the next pass.
//    p_output is @gfx's: read here, a change is heard from the next block (the old per-sample read: mid-block).
// Under Wired's new layout every channel to 64 is CLEARED whether a pad plays there or not (out_clr): the Patchbay
// rings 2..63 into the main bus, and an output channel a JSFX never writes passes its input through, so a receive
// on those channels would otherwise be heard. The guard and the crossfade stay on the channels in use (out_nch).
// (Multi-out clears 38: a pass-through there goes to pins nothing is routed from.)
out_nch = OUT_CH_BASE;
out_clr = patch_live && patch_v2 ? 64 : OUT_CH_BASE;
_ob_i = 0; loop(pad_hi,
  _ob_c = patch_live ? swing_out_wired(_ob_i, patch_v2) : multi_out ? swing_out_pair(_ob_i) * 2 : 0;
  pad_bus[_ob_i] = _ob_c;
  // Wired (step 5): how the pad leaves -- 2 on a bank pair (post-pan; its sends ride 34..37), 1 pre-pan under the
  // channel tap (the drain pans it on the way back), 0 post-pan (the bus tap, or not Wired).
  pad_wmode[_ob_i] = !patch_live ? 0 : (patch_v2 && _ob_c >= OUT_PAIR_BANK * 2 && _ob_c < OUT_PAIR_SPLIT * 2) ? 2 : patch_tap ? 0 : 1;
  _ob_c + 2 > out_nch ? out_nch = _ob_c + 2;
  _ob_i += 1;
);
out_nch > out_clr ? out_clr = out_nch;
// Wired (step 5): the slot each ring pair column answers to on the way back. The drain of the NEXT block reads it
// (patch_own_prev): the audio it drains left under this block's routing. Bank A's sixteen as always (the slot in
// that position; two pads deliberately pointed at one pair share its pan and sends, as before); a split pair its
// one owner (the slot that chose it, playable or not; swing_out_split_pick keeps them unique); the send columns
// and the bank pairs nobody (-1: a whole bank mixed and already panned, its sends on their own columns).
patch_live ? (
  memcpy(patch_own_prev, patch_own, PATCH_PCOLS);
  _ob_k = 0; loop(PATCH_PCOLS, patch_own[_ob_k] = _ob_k < PATCH_BANKA_PAIRS ? _ob_k : -1; _ob_k += 1;);
  patch_v2 ? (
    _ob_i = 0; loop(NUM_SLOTS,
      // The route this block's departure used: pad_bus, read once above (its pair is the channel / 2 for a split
      // pair). Re-reading @gfx's p_output here let a route changed between the two reads leave a split pad on its
      // pair with no owner for a block -- its pan and sends lost on the way back (Codex audit 2026-10-13). A slot
      // past pad_hi plays nothing this block: its stored choice, as before.
      _ob_v = _ob_i < pad_hi ? (pad_bus[_ob_i] / 2) | 0 : p_output[_ob_i] | 0;
      _ob_v >= OUT_PAIR_SPLIT && _ob_v < OUT_PAIRS ? patch_own[swing_patch_col(_ob_v)] = _ob_i;
      _ob_i += 1;
    );
  );
);

// ── Master idle gate (Phase 4, A O-1): decided here, after every launch site of the
//    block, read by @sample together with this sample's voices_alive. Idle means nothing
//    can reach the bus: no voice slot in any stage, no preview, no Wired drain, no
//    crossfade, no Stretch pad (its ring outlives the local voice), a second of proven
//    quiet, both send engines stood down (their own counters, in @sample), the limiter
//    and the master comp at rest. Measured before this gate: an idle instance cost
//    ~2.8 us per sample (audit A, O-1), most of it the master SVFs, the comp and the
//    two send engines running on silence.
_any_stretch = 0; _mst_pi = 0;
loop(NUM_PADS, pr_pad[_mst_pi] >= 0 && sp_pitch_mode[pr_pad[_mst_pi]] == SP_PITCH_MODE_STRETCH ? _any_stretch = 1; _mst_pi += 1;);   // sixteen: the Stretch rings are the spots' (Pad Banks step 4: each owner, any bank; bank A's sixteen before), whatever bank is shown (audit M2)
_mst_live = _prv_on || patch_drain || _xf_active || _any_stretch;
!_mst_live ? ( _mst_pi = 0; loop(V_SLOTS, v_stage[_mst_pi] > 0 ? _mst_live = 1; _mst_pi += 1;); );
_mst_quiet_n = _mst_live ? 0 : min(_mst_quiet_n + samplesblock, 4 * srate);
_mst_idle_want = !_mst_live && _mst_quiet_n >= srate
  && _dly_tail_n >= dly_len_s + _bus_tail_hold && _rvb_tail_n >= rvb_pre_samps + _bus_tail_hold
  && (!gfx_lim_on || gfx_lim_env >= 0.999)
  && (cmp_bypass || (cmp_voice > 0 ? anv_gr_lin >= 0.999 : cmp_last_lin >= 0.999));
_mst_idle_want && !_mst_idle ? (
  // The idle edge: settle what the skipped section would have settled over the next
  // few hundred milliseconds. The limiter's last 0.1 % of release, the master SVFs'
  // integrators (a second of silence has decayed them past denormal), the crossfade's
  // previous-output snapshot (nothing is sounding, so it is zero).
  gfx_lim_env = 1.0;
  memset(_xf_prev, 0, OUT_PAIRS * 2);
  _mst_pi = 0; loop(SVF_MST_COUNT, svf_flush_state(svf_master + _mst_pi * SVF_STEREO_SIZE); _mst_pi += 1;);
);
!_mst_idle_want && _mst_idle ? (
  // Wake: a coefficient glide or a bus gate that moved while idle would have completed
  // on silence -- snap them, so the first sample after the rest is what a running
  // section would have produced.
  _mst_pi = 0; loop(SVF_MST_COUNT, svf_snap(svf_master + _mst_pi * SVF_STEREO_SIZE); _mst_pi += 1;);
  _dly_gate = dly_on ? 1 : 0;
  _rvb_gate = rvb_on ? 1 : 0;
);
_mst_idle = _mst_idle_want;

// ─── The awake list: the pads @sample visits this block (2026-10-11) ─────
// Built LAST, after every launch of the block (MIDI, triggers, clicks, note repeat), and fixed for the whole block.
// The per-pad loop and the accumulator clears walk only these instead of every slot below pad_hi: one sound on a
// bank D pad used to walk the 48 slots below it every sample (11.6 % of a 1024 block against bank A's 4.6 %; a list
// measured 5.3 %, Swing_Speed_Checks_Plan_2026-10-11.md B5). The list must NOT follow pad_awake sample by sample: a
// pad launched with a sample offset finds no signal until its voice starts, the quiet branch clears its flag in those
// samples, and a loop that skipped it then lost the start of every mid-block hit (measured: an onset 9.3 ms late). A
// pad on the list stays visited for the whole block; the next @block marks it awake again from its live voice.
pad_n = 0; _ph_i = 0;
loop(pad_hi, pad_awake[_ph_i] ? ( pad_list[pad_n] = _ph_i; pad_n += 1; ); _ph_i += 1;);

// ─── Sample: full ADSR per-voice ──────────────────────────────────────────
@sample
// EON_DIAG: stamp the FIRST @sample of the block (armed only) -- splits the block's
// cost into the @block pass and the sample loop. diag_spl is zeroed in @block.
diag_armed && diag_spl == 0 ? diag_ts = time_precise();

// ─── Anti-pop crossfade ramp after deserialize ──────────────────────────
// Skip the ramp on first sample if there's no previous audio to fade from
// (cold start / fresh kit load with silent prev output). Without this
// short-circuit, the 20ms ramp 0→1 attenuates the first hit's transient
// — symptom: first kick after kit load plays quieter than subsequent ones.
_xf_active ? (
  _xf_pos == 0 && abs(_xf_prev[0]) + abs(_xf_prev[1]) < 0.0001 ? (
    _xf_active = 0;
  ) : (
    _xf_pos += 1;
    _xf_pos >= _xf_len ? ( _xf_active = 0; );
  );
);

// ─── Clear output channels ───────────────────────────────────────────────
// out_nch channels in multi-out (@block's routing pass): 16 stereo buses (0..31) + verb
// return (32/33) + delay return (34/35) + SMASH return (36/37) -- 38, as always -- and
// further only while an awake pad plays on a bank track or a split pair (38..63, Pad
// Banks Outputs); under Wired's new layout always 64 (step 5). Returns are routed to dedicated pins when
// fx_returns is on.
(multi_out || patch_live) ? (
  _xs_i = 0; loop(out_clr, spl(_xs_i) = 0; _xs_i += 1;);   // out_clr >= out_nch (the end of @block)
) : (
  spl(0) = 0; spl(1) = 0;
);

// ─── Clear per-pad accumulators ──────────────────────────────────────────
// Only the pads on the awake list are summed into: every live voice's pad and every Stretch pad is awake at the end
// of @block, where the list is built. Nothing launches a voice in @sample (a hit with a sample offset was launched,
// and its pad woken, in @block; the SYNTH view's audition goes through the click ring too).
_awk = 0; loop(pad_n, _awp = pad_list[_awk]; pad_accL[_awp] = 0; pad_accR[_awp] = 0; _awk += 1;);

// ─── Chokes and note-off releases due at this sample ───────────────────
// A hit that starts inside the block queued its choke / duplicate-kill pass for its own
// sample, and a gate-mode note-off its releases (swing_voice_choke_at / _release_at). Run
// before the voice loop: the voices they cut stop HERE, and a voice still waiting for this
// very sample is not among them.
ckq_i < ckq_n ? swing_voice_sched_due(ckq_spl);
ckq_spl += 1;

// ─── Voice loop: sum into per-pad accumulators ──────────────────────────
voices_alive = 0;
vi = 0; loop(v_hi,   // step 2c: to the voice high-water mark (see @block), not V_SLOTS
  // Phase V, pass 2 (2026-10-14): every per-voice cell the loop needs is read ONCE per sample into a
  // _vl_* local (position, stage, age, kind, increment) and the stage the ADSR moves to is tracked in
  // _vl_new, so the steal-fade test and the end condition compare a local instead of re-reading the
  // table. The writes stay where they were, so nothing changes for a @gfx reader; the null rig renders
  // the same bytes. Per sounding voice the loop used to read v_pos five times, v_stage four, v_kind
  // four, v_age twice, v_inc twice.
  _vl_pos = v_pos[vi];
  _vl_stg = v_stage[vi];
  // Advance waiting voices (negative v_pos = delayed start from loose sum mode)
  _vl_pos < 0 && _vl_pos > -9999 && _vl_stg > 0 ? (
    _vl_pos += 1;
    // When wait expires, restore to saved start position (respects trim + reverse)
    _vl_pos >= 0 ? _vl_pos = v_startpos[vi];
    v_pos[vi] = _vl_pos;
  );
  _vl_pos >= 0 && _vl_stg > 0 ? (
    voices_alive += 1;
    si    = v_slot[vi];
    // Buffer pointer and interleaved trim bounds: the voice's block constants (swing_voice_prep,
    // phase V) -- resolved at launch and once per block from the pad / layer tables, not here
    // every sample (SYN voices carry zeros: they render from their engine state, no buffer).
    bptr    = v_bptr[vi];
    a_start = v_astart[vi];
    a_end   = v_aend[vi];
    _vl_kind = v_kind[vi];
    _vl_age  = v_age[vi];

    // ADSR envelope
    stage = _vl_stg;
    _vl_new = stage;   // the stage after this sample's step (the table is written at the same places as before)
    env   = v_env[vi];
    // Safety net: force envelope to zero on first sample of a new voice.
    // Prevents stale v_env from skipping the attack ramp (cross-thread race).
    _vl_age == 0 ? env = 0;

    stage == 1 ? (  // Attack
      env = 1.0 - (1.0 - env) * p_att_c[si];
      env >= 0.999 ? (env = 1.0; v_stage[vi] = 2; _vl_new = 2;);
    ) : stage == 2 ? (  // Decay → sustain level
      _vl_sus = p_sustain[si];
      env = _vl_sus + (env - _vl_sus) * p_dec_c[si];
      env = max(_vl_sus, env);
      env <= _vl_sus + 0.001 ? (env = _vl_sus; v_stage[vi] = 3; _vl_new = 3;);
    ) : stage == 3 ? (  // Sustain
      env = p_sustain[si];
      env < 0.005 ? ( v_stage[vi] = 4; _vl_new = 4; );  // effectively silent — skip to release
    ) : stage == 4 ? (  // Release
      env *= p_rel_c[si];
      v_decay_ct[vi] += 1;
    );
    (vi >= MAX_VOICES || v_fastrel[vi]) && _vl_new == 4 ? (   // a steal-fade slot (A-2), or a voice cut by mute: ~5 ms on top of the release
      env *= steal_coeff;
    );

    v_env[vi] = env;

    g    = v_gain[vi] * v_sg[vi] * env;

    _vl_kind ? (
      // ── SYN voice: engine renders mono; pad ADSR gates on top (spec §1).
      // A synth has no sample end, so something else has to retire the slot.
      // The 3 s age cap used to be that something — and on a kit whose pads
      // carry no `sustain` the ADSR never falls, so EVERY hit sat on a slot
      // for ~2.8 s after going silent. 16 slots, so 16 hits in 3 s emptied
      // the pool and everything after that stole a live voice.
      // Retire on measured silence instead, and keep the age cap as the
      // backstop for an engine that never decays that far.
      // Post-gain, so a quiet voice retires sooner than a loud one; hold and
      // threshold are both generous because a clap is several bursts with
      // gaps between them, and truncating one would be far worse than
      // freeing a slot late.
      sL = sR = rk_syn_tick(v_syn_state + vi * RK_SYN_STATE_SIZE);
      abs(sL * g) < SYN_QUIET_T ? ( v_quiet[vi] += 1; ) : ( v_quiet[vi] = 0; );
      (v_quiet[vi] > syn_quiet_n || _vl_age > 3 * srate) && _vl_new < 4 ? (
        v_stage[vi] = 4; _vl_new = 4;
      );
    ) : (
    // Linear interpolation playback
    idx  = _vl_pos|0; idx -= idx & 1;
    frac = (_vl_pos - idx) * 0.5;
    _vl_inc = v_inc[vi];

    // End-of-sample fade: squared curve over last END_FADE positions.
    // Squared (quadratic) reaches zero with zero slope — no step discontinuity.
    _vl_inc >= 0 ? (
      _remaining = a_end - _vl_pos;
      _remaining < END_FADE ? (
        _fade = max(0, _remaining / END_FADE);
        g *= _fade * _fade;  // squared: smooth approach to zero
      );
    ) : (
      _remaining = _vl_pos - a_start;   // reverse: the fade lands at the trim's start (a_start = the same product the tables gave)
      _remaining < END_FADE ? (
        _fade = max(0, _remaining / END_FADE);
        g *= _fade * _fade;
      );
    );

    // Sample interpolation: cubic (Catmull-Rom) when the 4-point window fits,
    // linear at buffer boundaries. hi_quality_interp slider gates cubic globally;
    // future Machine Character modes (SP-1200 / MPC60 / Linn) flip it off to
    // model the cheaper interp those drum machines actually used.
    hi_quality_interp && idx >= ((a_start|0) + 2) && (idx + 4) < (a_end + SILENCE_T) ? (
      // 4-point Catmull-Rom: y = 0.5 * (2*y1 + (-y0+y2)*t + (2*y0-5*y1+4*y2-y3)*t² + (-y0+3*y1-3*y2+y3)*t³)
      _t = frac;
      _t2 = _t * _t;
      _t3 = _t2 * _t;
      // L channel: indices idx-2, idx, idx+2, idx+4
      _y0 = bptr[idx-2]; _y1 = bptr[idx];   _y2 = bptr[idx+2]; _y3 = bptr[idx+4];
      sL = 0.5 * (2*_y1 + (-_y0+_y2)*_t + (2*_y0-5*_y1+4*_y2-_y3)*_t2 + (-_y0+3*_y1-3*_y2+_y3)*_t3);
      // R channel: indices idx-1, idx+1, idx+3, idx+5
      _y0 = bptr[idx-1]; _y1 = bptr[idx+1]; _y2 = bptr[idx+3]; _y3 = bptr[idx+5];
      sR = 0.5 * (2*_y1 + (-_y0+_y2)*_t + (2*_y0-5*_y1+4*_y2-_y3)*_t2 + (-_y0+3*_y1-3*_y2+_y3)*_t3);
    ) : (
      // Linear fallback (boundary case + when cubic disabled)
      sL = bptr[idx]   + (bptr[idx+2] - bptr[idx])   * frac;
      sR = bptr[idx+1] + (bptr[idx+3] - bptr[idx+1]) * frac;
    );

    // L↔R channel swap (pre-pan, pre-FX). Useful for stereo files where
    // the L/R were captured backwards. Reuse _t (already declared in
    // local() for the cubic block — saves declaring another swap-temp).
    p_swapLR[si] ? ( _t = sL; sL = sR; sR = _t; );
    );  // end sample-voice branch (v_kind == 0)

    // Sum into per-pad accumulator (pre-pan, pre-FX).
    // Mode=Stretch pads get their audio from the Extension's élastique
    // ring drain below — the local Repitch sampler must NOT also sum
    // into the same accumulator, or every Stretch trigger doubles
    // (one hit at native rate from here, one stretched hit from the
    // Extension). The voice's ADSR/v_pos still advance above so the
    // voice ends and recycles correctly; only the audio sum is gated.
    // SYN voices always sum (their audio never comes from the Extension ring;
    // launch excludes synth on Stretch pads, but a live voice must survive a
    // mid-note mode flip without muting).
    // v_stfb: a Stretch pad that had no registry slot at launch played LOCALLY, so
    // there is no Extension audio to double against and this voice must be summed.
    // Without it the fallback launched correctly and was silenced right here.
    // v_sum: that gate, decided per block by swing_voice_prep (SYN, a fallback, a B..D pad -- never Stretch (4a.1) --
    // or a pad not in Stretch mode); a mode flip reaches a sounding voice at the next block.
    v_sum[vi] ? (
      pad_accL[si] += sL * g;
      pad_accR[si] += sR * g;
    );

    v_age[vi] = _vl_age + 1;

    // End condition
    _vl_kind ? (
      // SYN voice: no sample end — dies on release-envelope floor (or steal fade)
      env < 0.005 && (_vl_new == 4 || vi >= MAX_VOICES) ? (
        v_pos[vi] = -1; v_env[vi] = 0; v_stage[vi] = 0; v_kind[vi] = 0;
      );
    ) : (
    _vl_pos += _vl_inc; v_pos[vi] = _vl_pos;   // the sample voice advances (a SYN voice's position stays)
    // a_start / a_end: the voice's block constants, read once at the top of this iteration
    ((_vl_inc >= 0 && _vl_pos >= a_end) ||
     (_vl_inc < 0 && _vl_pos <= a_start) ||
     (env < 0.005 && (_vl_new == 4 || vi >= MAX_VOICES))) ? (
      v_pos[vi] = -1; v_env[vi] = 0; v_stage[vi] = 0;
    );
    );
  );
  vi += 1;
);

// ─── Step 3b: Stretch ring drain — for pads in Mode=Stretch, read one
//              stereo frame from the Extension-written per-pad SPSC ring
//              and sum into the same pad_accL/R accumulators the local
//              voice loop uses. Pads NOT in Stretch mode have nothing
//              in their ring (Extension only writes when MODE=Stretch
//              and a trigger fired) so the empty-ring check naturally
//              skips them.
//
// SPSC invariants: producer (Extension) writes write_pos; consumer
// (this code) writes read_pos. Ring empty when write_pos == read_pos.
// At cold start both pointers are 0 → reads silence until the
// audio_hook starts writing.
// ────────────────────────────────────────────────────────────────────
_reg_my_slot >= 0 && _any_stretch ? (   // _any_stretch: decided per block in @block (Phase 4, A O-1)
// Pad Banks step 4 (2026-10-09): one ring per SPOT; spot _sr_r plays into its owner pad _pi (pr_pad), any bank.
// The read cursor is the ring's (stretch_read_pos[spot]); the hold, the choke and the gain are the pad's.
_sr_r = 0; loop(NUM_PADS,   // sixteen: the Stretch rings, one per spot
  _pi = pr_pad[_sr_r];
  _pi >= 0 && sp_pitch_mode[_pi] == SP_PITCH_MODE_STRETCH ? (
    _sr_base   = STRETCH_AUDIO_BASE + _reg_my_slot * STRETCH_INST_AUDIO_STRIDE + _sr_r * STRETCH_PAD_STRIDE;
    _sr_write  = atomic_get(gmem[_sr_base + STRETCH_OFF_WRITE_POS])|0;
    _sr_read   = stretch_read_pos[_sr_r]|0;
    _sr_write != _sr_read ? (
      // Sub-block start for a Stretch pad. The Extension only services a trigger
      // on its NEXT audio_hook, so the new audio always turns up at a buffer
      // boundary however precisely the step was scheduled -- the offset cannot
      // be applied at the trigger the way a local voice's can. Burning it HERE
      // instead, once there is audio to hold back rather than from the trigger,
      // puts every onset the same distance past its own buffer. The Extension's
      // own round-trip latency is unchanged, but it is now CONSTANT, so the
      // spacing between repeats comes out exact. The ring holds 16382 frames,
      // so parking a buffer's worth costs nothing.
      stretch_hold[_pi] > 0 ? stretch_hold[_pi] -= 1 : (
      stretch_choked[_pi] >= 2 ? (
        // choked and faded out (A-7): discard what the Extension still writes for this
        // hit -- park the read cursor at the write cursor until the pad's next trigger
        _sr_read = _sr_write;
        stretch_read_pos[_sr_r] = _sr_read;
        atomic_set(gmem[_sr_base + STRETCH_OFF_READ_POS], _sr_read);
      ) : (
      _sr_data = _sr_base + STRETCH_HEADER_SLOTS + _sr_read * 2;
      pad_accL[_pi] += gmem[_sr_data] * stretch_gain[_pi];
      pad_accR[_pi] += gmem[_sr_data + 1] * stretch_gain[_pi];
      // a choked pad drains behind a short fade (steal_coeff, ~5 ms), then parks
      stretch_choked[_pi] == 1 ? (
        stretch_gain[_pi] *= steal_coeff;
        stretch_gain[_pi] < 0.005 ? stretch_choked[_pi] = 2;
      );
      _sr_read = (_sr_read + 1) % STRETCH_PAD_DATA_FRAMES;
      stretch_read_pos[_sr_r] = _sr_read;
      atomic_set(gmem[_sr_base + STRETCH_OFF_READ_POS], _sr_read);
      );
      );
    );
  );
  _sr_r += 1;
);
);

// ─── Per-pad FX chain + send accumulation + routing ─────────────────────
// Clear send bus accumulators
snd_dly_accL[0] = 0; snd_dly_accR[0] = 0;
snd_rvb_accL[0] = 0; snd_rvb_accR[0] = 0;
snd_sms_accL[0] = 0; snd_sms_accR[0] = 0;
// Smash is returns-only (the compressor lives ON the return track as EON Weld —
// with no return there is no effect, and folding the dry send into Main would
// just be a per-pad volume boost). Hoisted here so the pad loop can skip the
// accumulate entirely outside multi-out+returns.
// Never under Wired (step 5): the returns' pins are ring channels there -- 32/33 is bank A pad 16's pair in both
// layouts, 34..37 the bank pairs' sends in the new one -- so a return written onto them would be rung back into the
// bus and the sends. (multi_out can still read 1 for a moment after a switch to Wired.)
_fx_ret_pins = multi_out && fx_returns && !patch_live;

// ─── Patchbay loopback drain ────────────────────────────────────────────
// One frame per sample out of the ring the EON Patchbay filled at the end of
// the chain a block ago: pad N's audio AFTER the user's own plugin ran on it.
// Summed into the main bus HERE, which is upstream of the master EQ /
// saturation / compressor / limiter -- the whole reason the loopback exists.
//
// Sends are fed from the RETURNED audio rather than from _pfx_send* below.
// Two reasons, and the first is not optional: _pfx_send* is this block's dry
// signal while the return is a block old, so tapping both would put the reverb
// a whole buffer AHEAD of the dry hit -- an audible pre-echo on anything with a
// transient. Feeding from the return also means a pad's compressor is heard by
// its reverb, which is what a real insert does.
//
// TAP POINT (patch_tap). Where the pad left the channel decides what comes back:
//   0  ON THE CHANNEL (default) -- the pad left PRE-pan (_pfx_send*), so the
//      return is still unpanned. Sends take it as-is (pre-pan, the normal path)
//      and the pad's pan is applied HERE on the way to the main bus. A console
//      insert: the plugin sees the pad centred, the pan pot places it after.
//   1  ON THE BUS -- the pad left POST-pan (_pfx*), exactly what a child track
//      receives under multi-out. Nothing is re-applied. Sends are post-pan in
//      this mode, which is the one behavioural difference and the reason the
//      mode exists at all: a plugin moved between a child track and a pad
//      insert lands at the identical point in the signal and sounds the same.
// The pan uses the bus index as the pad index -- see the bus-walk note below;
// strip_takeover is honoured the same way process_pad_fx honours it (no pan).
patch_drain ? (   // patch_live AND the cursor is aimed (see the re-aim in @block)
  _pt_row = _patch_base + PATCH_HEADER_SLOTS + _patch_rpos * patch_stride;
  // ⚠️ This walks RING PAIR COLUMNS, not pads. A column holds whatever p_output
  // pointed at that pair, and two pads can share a pair, so the mapping is not
  // invertible. The bridge sets p_output[i] = i when it builds the loopback, which
  // makes bank A's column i exactly pad i and the send amounts below exact. If the
  // user re-points pads by hand the AUDIO is still correct -- it is all summed into
  // the main bus regardless -- but a shared pair takes its send level from the
  // column's slot rather than from each pad, because by this point the two pads
  // are one signal and there is nothing left to weigh them apart.
  // Outputs step 5: patch_own_prev[c] (the map the drained audio left under) is
  // that slot -- bank A's sixteen as before, a split pair its owner, a bank pair -1:
  // a whole bank mixed and already panned, nothing re-applied. Its pads' sends come
  // back on their own two columns (channels 34..37) and go straight to the buses.
  _pc = 0; loop(patch_cols_live,   // 16 in the old layout, 31 in the new one
    _pt_l = gmem[_pt_row + _pc * 2];
    _pt_r = gmem[_pt_row + _pc * 2 + 1];
    // Belt and braces behind the Patchbay's own guard: these values come from
    // third-party plugins, and everything below is stateful (sends into the
    // delay and reverb, then the master chain). The output guard cannot clean a
    // filter that has already eaten a NaN. A Patchbay older than this build --
    // the ring outlives a ReaPack sync until REAPER restarts -- guards nothing.
    !(abs(_pt_l) <= 8) ? _pt_l = 0;
    !(abs(_pt_r) <= 8) ? _pt_r = 0;
    patch_retL[_pc] = _pt_l;
    patch_retR[_pc] = _pt_r;

    patch_v2 && (_pc == PATCH_SEND_PC || _pc == PATCH_SEND_PC + 1) ? (
      // the bank pairs' pads' sends, summed per pad at its own amounts before they left (the pad loop below)
      _pc == PATCH_SEND_PC ? ( snd_dly_accL[0] += _pt_l; snd_dly_accR[0] += _pt_r; )
                           : ( snd_rvb_accL[0] += _pt_l; snd_rvb_accR[0] += _pt_r; );
    ) : (
      _pi = patch_own_prev[_pc];
      (_pi >= 0 && !patch_tap && !strip_tk[_pi]) ? (
        spl(0) += _pt_l * p_panL[_pi];
        spl(1) += _pt_r * p_panR[_pi];
      ) : (
        spl(0) += _pt_l;
        spl(1) += _pt_r;
      );

      _pi >= 0 ? (
        fx_snd_dly[_pi] > 0.005 ? (
          snd_dly_accL[0] += _pt_l * fx_snd_dly[_pi];
          snd_dly_accR[0] += _pt_r * fx_snd_dly[_pi];
        );
        fx_snd_rvb[_pi] > 0.005 ? (
          snd_rvb_accL[0] += _pt_l * fx_snd_rvb[_pi];
          snd_rvb_accR[0] += _pt_r * fx_snd_rvb[_pi];
        );
        _fx_ret_pins && fx_snd_smash[_pi] > 0.005 ? (
          snd_sms_accL[0] += _pt_l * fx_snd_smash[_pi];
          snd_sms_accR[0] += _pt_r * fx_snd_smash[_pi];
        );
      );
    );
    _pc += 1;
  );

  _patch_rpos += 1;
  _patch_rpos >= patch_depth ? _patch_rpos = 0;
);

_awk = 0; loop(pad_n,   // the awake list (end of @block), not every slot below pad_hi
  _pi = pad_list[_awk];
  // process_pad_fx sets _pfxL/_pfxR (post-pan output)
  // and _pfx_sendL/_pfx_sendR (post-FX, pre-pan for sends), and returns 0 for a silent
  // pad (no signal, no filter residual: every output 0). A silent pad skips the routing,
  // the sends and the meter compare below; its meters keep falling (Phase 4, A O-1).
  process_pad_fx(_pi) ? (

  // Route to output bus: pad_bus[], set at the end of @block (swing_out_pair / swing_out_wired).
  // In loopback bank A's pairs are shifted up by one bus: channels 0/1 are what
  // the drained ring is summed INTO, and a pad sharing them would reach the master
  // section undelayed and flam against the others that made the round trip. The
  // bank and split pairs ride their multi-out channels, 38..63 (step 5).
  // p_output still chooses the pair, so two pads deliberately pointed at the
  // same bus share one insert -- both toms through one compressor.
  bus_idx = pad_bus[_pi];
  // Wired with the tap ON THE CHANNEL sends the pad out PRE-pan (_pfx_send*);
  // the drain above applies the pan on the way back. Every other path -- the
  // bus tap, a bank pair (step 5: a whole bank shares it, so each pad leaves
  // panned), multi-out, stereo -- sends the panned signal as before.
  pad_wmode[_pi] == 1 ? (
    spl(bus_idx)     += _pfx_sendL;
    spl(bus_idx + 1) += _pfx_sendR;
  ) : (
    spl(bus_idx)     += _pfxL;
    spl(bus_idx + 1) += _pfxR;
  );

  // Accumulate into send buses (pre-pan, post-FX).
  // Skipped under the loopback: the drain above already fed these from the
  // returned audio, and doing it here as well would send each pad twice, once
  // a buffer early.
  !patch_live && fx_snd_dly[_pi] > 0.005 ? (
    snd_dly_accL[0] += _pfx_sendL * fx_snd_dly[_pi];
    snd_dly_accR[0] += _pfx_sendR * fx_snd_dly[_pi];
  );
  !patch_live && fx_snd_rvb[_pi] > 0.005 ? (
    snd_rvb_accL[0] += _pfx_sendL * fx_snd_rvb[_pi];
    snd_rvb_accR[0] += _pfx_sendR * fx_snd_rvb[_pi];
  );
  !patch_live && _fx_ret_pins && fx_snd_smash[_pi] > 0.005 ? (
    snd_sms_accL[0] += _pfx_sendL * fx_snd_smash[_pi];
    snd_sms_accR[0] += _pfx_sendR * fx_snd_smash[_pi];
  );
  // A bank pair's pad under Wired (step 5): its delay / reverb sends, at its own amounts, onto the send channels
  // 34..37. They travel the chain beside the bank pair and come back through the ring with it, so a latent
  // insert or a change of block size delays both alike; the drain feeds them to the buses. The tap point picks
  // the signal as it does for every Wired pad: pre-pan on the channel, post-pan on the bus. (No smash: it is
  // multi-out's, with the returns on their own pins.)
  pad_wmode[_pi] == 2 ? (
    fx_snd_dly[_pi] > 0.005 ? (
      spl(PATCH_SEND_CH)     += (patch_tap ? _pfxL : _pfx_sendL) * fx_snd_dly[_pi];
      spl(PATCH_SEND_CH + 1) += (patch_tap ? _pfxR : _pfx_sendR) * fx_snd_dly[_pi];
    );
    fx_snd_rvb[_pi] > 0.005 ? (
      spl(PATCH_SEND_CH + 2) += (patch_tap ? _pfxL : _pfx_sendL) * fx_snd_rvb[_pi];
      spl(PATCH_SEND_CH + 3) += (patch_tap ? _pfxR : _pfx_sendR) * fx_snd_rvb[_pi];
    );
  );

  // Peak tracking for per-pad meters (smooth decay)
  _absL = abs(_pfxL); _absR = abs(_pfxR);
  _absL > pad_meterL[_pi] ? pad_meterL[_pi] = _absL : pad_meterL[_pi] *= _pad_meter_decay;
  _absR > pad_meterR[_pi] ? pad_meterR[_pi] = _absR : pad_meterR[_pi] *= _pad_meter_decay;

  ) : (   // silent pad: only the meters move -- and it goes to sleep (step 2b): the next @block
          // leaves it off the list unless a voice of its is live; its accumulators are zeroed so a later wake starts clean
    pad_meterL[_pi] *= _pad_meter_decay;
    pad_meterR[_pi] *= _pad_meter_decay;
    pad_awake[_pi] = 0; pad_accL[_pi] = 0; pad_accR[_pi] = 0;
  );

  _awk += 1;
);

// ─── Process send FX returns ────────────────────────────────────────────
// Same internal DSP in both modes (stereo + multi-out) so the wet is identical;
// only the EXIT POINT changes. In multi-out with fx_returns ON, the wet lands on
// dedicated output pairs (verb 32/33, delay 34/35) so it feeds its own return
// tracks instead of leaking into the Main bus / child-track 0. Otherwise the
// returns mix into the Main stereo bus (spl 0/1) exactly as before.
// (_fx_ret_pins hoisted above the pad loop — the smash accumulate needs it.)
// Delay - gated by dly_on (the bus enable), NOT by dly_div. The division is
// kit state you get back when you switch the bus on again; the old
// `dly_div > 0` gate made "off" mean "throw the division away", and it cut
// the repeats dead mid-tail. OFF now glides the input shut and rings out.
_dly_gate += ((dly_on ? 1 : 0) - _dly_gate) * (1 - _bus_gate_c);
_dly_gate < BUS_TAIL_FLOOR ? _dly_gate = 0;
// The engine stands down while ON as well as OFF (Phase 4, A O-1): once its input has
// been exactly zero and its output under the floor for one delay length plus
// _bus_tail_hold, nothing audible is left in the line (a pending repeat would have
// come out above the floor within a delay length and reset the counter). Any input
// wakes it on that sample. Until Phase 4 an ON delay -- the kit default -- ran on every
// sample of an idle instance.
_dly_inL = snd_dly_accL[0] * _dly_gate; _dly_inR = snd_dly_accR[0] * _dly_gate;
(_dly_inL != 0 || _dly_inR != 0) ? _dly_tail_n = 0;
(_dly_tail_n < dly_len_s + _bus_tail_hold) ? (
  dly_process(_dly_inL, _dly_inR);
  // Denormal protection on delay tail
  abs(dly_outL) < DENORM_THR ? dly_outL = 0;
  abs(dly_outR) < DENORM_THR ? dly_outR = 0;
  // Ring-out bookkeeping: counts only CONSECUTIVE sub-floor samples with a silent
  // input, so a still-audible repeat resets it.
  (abs(dly_outL) + abs(dly_outR) < BUS_TAIL_FLOOR) ? _dly_tail_n += 1 : _dly_tail_n = 0;
  _fx_ret_pins ? (
    spl(34) += dly_outL * dly_mix;
    spl(35) += dly_outR * dly_mix;
  ) : (
    spl(0) += dly_outL * dly_mix;
    spl(1) += dly_outR * dly_mix;
  );
) : (
  // Stood down. Keep the write head moving and lay zeros behind it: a frozen
  // head leaves the ring buffer holding the old tail, and switching the bus
  // back on would replay it as a burst of stale audio. Four ops a sample buys
  // a buffer that is always clean by the time it is read again.
  dly_bufL[dly_wpos] = 0; dly_bufR[dly_wpos] = 0;
  dly_wpos += 1; dly_wpos >= DLY_BUF_MAX ? dly_wpos = 0;
  dly_outL = 0; dly_outR = 0;
);

// Reverb - gated by rvb_on, NOT by rvb_size. Same reasoning as the delay: the
// old `rvb_size > 0.001` gate made "off" mean "destroy the SIZE you want back",
// and crossing the threshold on a drag chopped the tail. rvb_recalc handles
// size 0 fine (scale floors at 0.35x), so the engine is happy to run there.
_rvb_gate += ((rvb_on ? 1 : 0) - _rvb_gate) * (1 - _bus_gate_c);
_rvb_gate < BUS_TAIL_FLOOR ? _rvb_gate = 0;
// Stands down while ON too (Phase 4, A O-1; the delay above has the reasoning): the
// hold covers the pre-delay line, so nothing is still on its way into the tank.
_rvb_inL = snd_rvb_accL[0] * _rvb_gate; _rvb_inR = snd_rvb_accR[0] * _rvb_gate;
(_rvb_inL != 0 || _rvb_inR != 0) ? _rvb_tail_n = 0;
(_rvb_tail_n < rvb_pre_samps + _bus_tail_hold) ? (
  rvb_process(_rvb_inL, _rvb_inR);
  // Denormal protection on reverb tail
  abs(rvb_outL) < DENORM_THR ? rvb_outL = 0;
  abs(rvb_outR) < DENORM_THR ? rvb_outR = 0;
  (abs(rvb_outL) + abs(rvb_outR) < BUS_TAIL_FLOOR) ? _rvb_tail_n += 1 : _rvb_tail_n = 0;
  _fx_ret_pins ? (
    spl(32) += rvb_outL * rvb_mix;
    spl(33) += rvb_outR * rvb_mix;
  ) : (
    spl(0) += rvb_outL * rvb_mix;
    spl(1) += rvb_outR * rvb_mix;
  );
) : (
  rvb_outL = 0; rvb_outR = 0;
);

// Smash (parallel-comp send) — RAW summed sends out to the return pair; the
// EON Weld on the return track does the compression and the return fader is the
// blend. No else-fold and no mix scale: outside multi-out+returns the
// accumulate above never ran (returns-only by design).
_fx_ret_pins ? (
  spl(36) += snd_sms_accL[0];
  spl(37) += snd_sms_accR[0];
);

// ─── Master idle gate (Phase 4, A O-1) ───────────────────────────────────
// _mst_idle is decided once per block at the end of @block (nothing reached the bus
// for a second, both send engines stood down, the limiter and comp at rest, no preview,
// no Wired drain, no crossfade, no Stretch pad). voices_alive is THIS sample's count,
// so a pad clicked in @gfx mid-block wakes the section on the sample its voice first
// sounds. spl(0)/spl(1) are already the zeros the clear at the top wrote; idle costs
// two meter decays and the GR needle's fall to rest.
_mst_idle && voices_alive == 0 ? (
  (cmp_vu.pos > 0 || cmp_vu.hold > 0) ? cmp_vu.rk_vu_sample_gr(1);
  master_meterL *= _mst_meter_decay; master_meterR *= _mst_meter_decay;
) : (

// ─── Global FX on main stereo bus (SVF filters) ─────────────────────────
_gL = spl(0); _gR = spl(1);

// ⭐ Stands down with the comp when EON Tone is driving the Audio folder:
// same argument, same gate. In Multi-Out these five filters only ever reached
// the pad on OUT 1, and Tone runs the identical chain on the folder from the
// identical values, so leaving this in would EQ one drum twice.
(!meq_bypass && !tnl_live) ? (
  // All 5 filters ALWAYS processed (no engage gates): a gate that bypassed
  // instantly when a drag crossed the HPF/LPF threshold would skip the SVF's
  // bypass glide — an audible click on the bus. Off filters carry unity-dry
  // glide targets (svf_set_bypass in recalc_global_fx), so always-processing
  // is click-free; at 0 dB the EQ bands are transparent. svf_tick advances
  // the one-pole coefficient glide once per filter before the L/R pair.
  _bq = svf_master + SVF_MST_HPF * SVF_STEREO_SIZE;
  svf_tick(_bq); _gL = svf_process_L(_bq, _gL); _gR = svf_process_R(_bq, _gR);
  _bq = svf_master + SVF_MST_LPF * SVF_STEREO_SIZE;
  svf_tick(_bq); _gL = svf_process_L(_bq, _gL); _gR = svf_process_R(_bq, _gR);
  _bq = svf_master + SVF_MST_LO * SVF_STEREO_SIZE;
  svf_tick(_bq); _gL = svf_process_L(_bq, _gL); _gR = svf_process_R(_bq, _gR);
  _bq = svf_master + SVF_MST_MID * SVF_STEREO_SIZE;
  svf_tick(_bq); _gL = svf_process_L(_bq, _gL); _gR = svf_process_R(_bq, _gR);
  _bq = svf_master + SVF_MST_HI * SVF_STEREO_SIZE;
  svf_tick(_bq); _gL = svf_process_L(_bq, _gL); _gR = svf_process_R(_bq, _gR);
);

// Global saturation (wet/dry mix — drive knob blends clean → saturated).
// Routes the master through the shared per-character curve bank so the
// master DRIVE offers the same 5 types as per-pad (SOFT/TUBE/TAPE/FUZZ/CLIP,
// selected by gfx_drv_mode). drive_process writes _doL/_doR. Mirrors the
// per-pad blend in rk_drumkit_fx.jsfx-inc (8x gain into the curve, then mix).
_sat_drv_sm += (gfx_sat_drv - _sat_drv_sm) * _sm_coeff;
// Drive follows the EQ, for the same reason — Tone carries the saturator too.
// The smoother above keeps running, so a link dropping mid-drive glides back in
// rather than stepping.
(_sat_drv_sm > 0.01 && !tnl_live) ? (
  drive_process(_gL * 8.0, _gR * 8.0, gfx_drv_mode | 0);
  _gL += (_doL - _gL) * _sat_drv_sm;
  _gR += (_doR - _gR) * _sat_drv_sm;
  // TUBE is asymmetric and emits DC; see the per-pad blocker in
  // rk_drumkit_fx.jsfx-inc for why the "HPF downstream" its curve comment
  // promised does not exist. Same one-pole here so the MASTER curve cannot
  // push an offset into the limiter and the meters.
  (gfx_drv_mode | 0) == 1 ? (
    _mdc_yL = _gL - _mdc_x1L + _dc_r * _mdc_y1L;
    _mdc_x1L = _gL; _mdc_y1L = _mdc_yL; _gL = _mdc_yL;
    _mdc_yR = _gR - _mdc_x1R + _dc_r * _mdc_y1R;
    _mdc_x1R = _gR; _mdc_y1R = _mdc_yR; _gR = _mdc_yR;
  ) : (
    // Same park-on-mode-change as the per-pad blocker (rk_drumkit_fx.jsfx-inc):
    // the branch below only fires when the whole saturator goes idle, so TUBE ->
    // TAPE with the drive still up froze this state and returning to TUBE
    // resumed off it. On the master that offset lands in the limiter and the
    // meters.
    _mdc_x1L != 0 || _mdc_y1L != 0 || _mdc_x1R != 0 || _mdc_y1R != 0 ? (
      _mdc_x1L = 0; _mdc_y1L = 0; _mdc_x1R = 0; _mdc_y1R = 0;
    );
  );
) : (
  _mdc_x1L != 0 || _mdc_y1L != 0 || _mdc_x1R != 0 || _mdc_y1R != 0 ? (
    _mdc_x1L = 0; _mdc_y1L = 0; _mdc_x1R = 0; _mdc_y1R = 0;
  );
);

// ─── Master compressor (after EQ + saturation, before volume + limiter) ──
// ⭐ STANDS DOWN when the audio-bus Weld is answering (Multi-Out, not Wired).
// It has to: in Multi-Out this stage only ever sees the pad routed to OUT 1 --
// pads write to spl(p_output*2) and this chain reads spl(0)/spl(1) -- so it was
// compressing the kick and nothing else, and once the COMP page drives the
// folder that pad was being compressed TWICE, here and again on the bus.
// The condition routes into the bypass branch below, which is exactly right and
// not a coincidence: that branch already feeds the needle, and already reseats
// both engines ONCE on the way out of circuit, so re-engaging when the link
// drops starts from silence instead of a stale capacitor charge.
(!cmp_bypass && !bcl_live && !bcl_foreign) ? (
  cmp_voice > 0 ? (
    // Anvil voice: the FET circuit from rk_anvil, Swing's controls pushed in
    // from @block. Only this branch or the one below runs, never both.
    anv_process(_gL, _gR);
    _gL = anv_outL;
    _gR = anv_outR;
    cmp_vu.rk_vu_sample_gr(anv_gr_lin);
    _anv_rested = 0;
  ) : (
    cmp_process(_gL, _gR);
    _gL = cmp_outL;
    _gR = cmp_outR;
    cmp_vu.rk_vu_sample_gr(cmp_last_lin);   // GR needle: linear gain in, no transcendental
  );
  // ⛔ Do NOT reach for bcl_gr_lin in here. Both needle calls above used to
  // read `bcl_live ? bcl_gr_lin : ...`, which this branch's own guard makes
  // unreachable -- fcdb280 added them so the needle would follow the bus, then
  // 5a3c1da put !bcl_live in the condition above and left two compares per
  // sample that can never be true. The bus reading belongs in the ELSE branch,
  // which is exactly where a live link now sends us, and it is there already.
) : (
  // The needle follows the compressor that is actually working on the signal.
  // In Multi-Out with a bus Weld answering, that is the one on the Audio folder
  // — including here, where OUR comp is bypassed and the old code let the
  // needle fall to rest: resting would have said "nothing is compressing" while
  // the folder was doing exactly that. bcl_gr_lin is a per-block constant.
  bcl_live ? cmp_vu.rk_vu_sample_gr(bcl_gr_lin)
           : ((cmp_vu.pos > 0 || cmp_vu.hold > 0) ? cmp_vu.rk_vu_sample_gr(1));   // out of circuit: needle AND hold needle fall to rest, then the branch is inert
  // Bypassed master comp costs nothing — but a re-engage must start from
  // CLEAN state, not a stale capacitor charge (audit 2026-08-24). One
  // compare per sample while bypassed; reset fires once, then both caps
  // read zero and the branch is inert.
  (cmp_v1 || cmp_v2) ? cmp_reset();
  // Same discipline for the Anvil voice: reseat once on the way out of
  // circuit, so re-engaging starts from silence. One compare per sample.
  cmp_voice > 0 && !_anv_rested ? ( anv_engine_reset(); _anv_rested = 1; );
);

// ─── Master volume (BEFORE limiter so limiter sees final level) ──────
_vol_sm += (global_vol - _vol_sm) * _sm_coeff;
_gL *= _vol_sm;
_gR *= _vol_sm;

// ─── Mini-browser preview voice ─────────────────────────────────────────
// Mixed in AFTER master volume and BEFORE the limiter: an audition is not part
// of the instrument, so it skips the pad chain entirely, but it still gets peak
// protection and a level of its own. Linear interpolation only -- @sample
// forbids transcendentals and this needs none.
// _prv_len > 1, not > 0: the release below holds the read head on frame
// _prv_len - 2 (the last one the 2-point interpolator can address), so a
// degenerate one-frame buffer has nowhere to hold and just ends.
_prv_on && _prv_len > 1 ? (
  _prv_i = _prv_pos | 0;
  _prv_i >= _prv_len - 1 ? (
    // The landed length reached. If the stream has ENDED (_prv_eos): LOOP wraps a file that
    // fits the ring (frame 0 is still there; a LONG file loops through the bridge instead,
    // which simply keeps the stream coming so this branch is not reached); otherwise RELEASE
    // and hold the read head on the last addressable frame so the fade has something to
    // decay from. If the stream has NOT ended, the data is late (the ring, Spec_Swing_
    // Preview_Ring): HOLD on the last frame, no release -- counted for the probes.
    _prv_eos ? (
      (fb_prv_loop && !_prv_long) ? ( _prv_pos = 0; _prv_i = 0; )
                                  : ( swing_prv_release(); _prv_i = _prv_len - 2; _prv_pos = _prv_i; );
    ) : ( _prv_i = _prv_len - 2; _prv_pos = _prv_i; _prv_hold_n += 1; );
  );
  _prv_on ? (
    // Envelope advanced BEFORE the read, so the first sample of a new audition
    // is already above zero and the last one of a release is already below the
    // level that would step. Folded into the knob gain, so the reads below cost
    // exactly what they did before.
    _prv_tgt > _prv_env ? ( _prv_env = min(_prv_tgt, _prv_env + _prv_fade_step); )
                        : ( _prv_env = max(_prv_tgt, _prv_env - _prv_fade_step); );
    _prv_g = fb_prv_gain * _prv_env;
    _prv_f = _prv_pos - _prv_i;
    _prv_ch == 2 ? (
      // the ring: frame i sits at (base + i*2) mod FB_PRV_MAX, and the next frame may wrap
      // (the old file-read path has base 0 and never passes the end, so this is the same read)
      _prv_ri  = (_prv_ring_base + _prv_i * 2) % FB_PRV_MAX;
      _prv_ri2 = _prv_ri + 2; _prv_ri2 >= FB_PRV_MAX ? _prv_ri2 -= FB_PRV_MAX;
      _prv_a = _prv_buf[_prv_ri];
      _prv_b = _prv_buf[_prv_ri2];
      _gL += (_prv_a + (_prv_b - _prv_a) * _prv_f) * _prv_g;
      _prv_a = _prv_buf[_prv_ri + 1];
      _prv_b = _prv_buf[_prv_ri2 + 1];
      _gR += (_prv_a + (_prv_b - _prv_a) * _prv_f) * _prv_g;
    ) : (
      _prv_a = _prv_buf[_prv_i];
      _prv_b = _prv_buf[_prv_i + 1];
      _prv_s = (_prv_a + (_prv_b - _prv_a) * _prv_f) * _prv_g;
      _gL += _prv_s; _gR += _prv_s;
    );
    // The voice ends HERE, when the release has actually reached zero -- not at
    // the STOP command and not at the end of the buffer. Both of those now only
    // ask for it.
    _prv_env <= 0 && _prv_tgt <= 0 ? ( _prv_on = 0; ) : ( _prv_pos = _prv_pos + _prv_rate; );
  );
);

// ─── Master limiter (feed-forward, instant attack, auto-release) ────────
// The ceiling GLIDES (click fix 2026-10-14, the mirror of EON_Output's): with an
// instant attack a ceiling that drops in one sample drops the gain in one sample.
// Chased at the master volume's 4.5 ms (_sm_coeff); seated on the first sample
// (-1 from @init; @serialize lands gfx_lim_thr after @init), so a load is no fade.
_mlim_thr_s < 0 ? _mlim_thr_s = gfx_lim_thr : _mlim_thr_s += (gfx_lim_thr - _mlim_thr_s) * _sm_coeff;
gfx_lim_on ? (
  _peak = max(abs(_gL), abs(_gR));
  _peak > _mlim_thr_s ? (
    _lim_gain = _mlim_thr_s / _peak;
    gfx_lim_env = min(gfx_lim_env, _lim_gain);  // instant attack
  );
  // Apply BEFORE releasing. Releasing first raised the gain this peak needed,
  // so it left above the ceiling: at the fastest (10 ms) release, +0.06 dB
  // under 12 dB of reduction and +0.29 dB under 24 dB (simulated 2026-09-12).
  _gL *= gfx_lim_env;
  _gR *= gfx_lim_env;
  // GR metering for display
  gfx_lim_gr = min(gfx_lim_gr, gfx_lim_env);
  // Smooth release for the NEXT sample (one-pole: coeff near 1.0 = slow).
  // env approaches 1.0 asymptotically, never above it (rel_c in (0,1)).
  gfx_lim_env += (1.0 - gfx_lim_env) * (1.0 - gfx_lim_rel_c);
);

// ─── Output guard (2026-09-08) ────────────────────────────────────────────
// An Inf (or an absurd > +18 dBFS) from any voice/FX path must never reach the
// host or the meters: !(abs(x) <= 8) catches Inf and the impossible -- two
// compares per sample on the master, and the same sweep over the pad buses only
// in multi-out / patchbay mode. It does NOT catch a NaN: measured on REAPER 7.79
// (EON_Probe_NanSem, A-11) EEL2 comparisons are NaN-blind in both forms. A NaN
// needs no catching here -- EEL2 arithmetic flushes it to 0 on first use, and a
// NaN written to spl renders as 0 at the host boundary (wiki 7.8).
!(abs(_gL) <= 8) ? _gL = 0;
!(abs(_gR) <= 8) ? _gR = 0;
spl(0) = _gL; spl(1) = _gR;
(multi_out || patch_live) ? (
  _xs_i = 2; loop(out_nch - 2, !(abs(spl(_xs_i)) <= 8) ? spl(_xs_i) = 0; _xs_i += 1;);
);

// Anti-pop crossfade: blend from previous output to current output after deserialize.
// All out_nch channels whenever pads leave on them: multi-out, and Wired, where every
// pad pair rides channels 2..33 to the inserts and back through the ring (A-5:
// a pair blended on 0/1 only stepped to zero at the kill and the step came back
// after the blend had ended). Same test as the clear loop in @block.
_xf_active ? (
  _xf_t = _xf_pos / _xf_len;            // 0→1 over crossfade duration
  _xf_t = _xf_t * _xf_t * (3 - 2 * _xf_t);  // smoothstep for click-free curve
  _xf_w = 1.0 - _xf_t;                  // weight of old signal (1→0)
  (multi_out || patch_live) ? (
    _xs_i = 0; loop(out_nch,
      spl(_xs_i) = spl(_xs_i) * _xf_t + _xf_prev[_xs_i] * _xf_w;
      _xs_i += 1;
    );
  ) : (
    spl(0) = spl(0) * _xf_t + _xf_prev[0] * _xf_w;
    spl(1) = spl(1) * _xf_t + _xf_prev[1] * _xf_w;
  );
) : (
  // Only track output when crossfade is NOT active (freeze _xf_prev during crossfade)
  (multi_out || patch_live) ? (
    _xs_i = 0; loop(out_nch, _xf_prev[_xs_i] = spl(_xs_i); _xs_i += 1;);
  ) : (
    _xf_prev[0] = spl(0); _xf_prev[1] = spl(1);
  );
);

// Master output metering (smooth peak-hold)
_moL = abs(_gL); _moR = abs(_gR);
_moL > master_meterL ? master_meterL = _moL : master_meterL *= _mst_meter_decay;
_moR > master_meterR ? master_meterR = _moR : master_meterR *= _mst_meter_decay;

);   // end of the master section (its idle branch is at the gate above)

// EON_DIAG: stamp the LAST @sample of the block (armed only; one branch unarmed).
diag_armed ? (
  diag_spl += 1;
  diag_spl >= samplesblock ? diag_t1 = time_precise();
);

// ─── Serialize ────────────────────────────────────────────────────────────
@serialize
// is_read FIRST — every backfill guard and the !is_read embed computation
// below depend on it. It previously sat mid-stream (~line 3511), so guards
// above it read the PREVIOUS pass's value: a read following a write pass
// skipped backfills, and the first write after a project open took the read
// branch of the embed policy (sweep finding 2026-07-29; the old line remains
// below as a harmless idempotent re-set).
is_read = file_avail(0) >= 0;
// H11: by this read REAPER has put the saved id back into instance_id (measured; @init saw 0): raise the new-id
// counter to it now, before any later insert mints (the @block line beside KIT_HS_CAP keeps it raised).
is_read && instance_id > gmem[KIT_GMEM_INSTANCE_NEXT] ? gmem[KIT_GMEM_INSTANCE_NEXT] = instance_id;
// Version tag for forward-compat
ser_ver = 83;   // 83 = the side slot's dragged width, side_w (its width handle, 2026-10-22). 82 = the pad editor placed below the pads: fx_h (its height there) and pfx_page (the panel's page) (2026-10-22). 81 = the browser's height below the pads, fb_h (round two J's swap, 2026-10-22). 80 = the side slot's second panel: pfx_open + side_front (round two J, 2026-10-22; gate 80 at the tail). 79 = the step sequencer's TAGGED stream (P0a, 2026-10-20, Spec_Swing_Seq_View decision 23: tag / length
                // sections, unknown tags skipped; a 78 file is read by its own body and converted). 78 = the first sequencer
                // gate (2026-10-19, S1), written only by the user's own test projects.
                //      at the tail -- the settings header, the song chain, then the patterns sparsely (an unused
                //      pattern one flag, a lane its switched-on steps as packed triples). Reading < 78 clears it.
                // 77 = PAD BANKS step 4b (2026-09-23): the four bank names after the 76 tail (BKNAME_STR_BASE + b).
                // 76 = PAD BANKS (step 3a, 2026-09-23; Spec_Swing_Pad_Banks 7): the slot count the
                //      file carries + bank_cur right before the per-pad walk, the walk over every
                //      slot (64) with the record layout untouched, and the SYN slot for slots 16..63
                //      at the tail. A 75 file reads as sixteen pads into bank A. Sequencer = 77.
                // 75 = master EQ Q per mode (gfx_eq_lo_sq/_bq, _mid_q, _hi_sq/_bq), wheel over a node.
                // 74 = console: show/hide the house plugins in the pad insert rows (con_ins_house).
                // 71 = rpt_grid: note repeat locked to the project grid.
                // 70 = cmp_auto: the master comp's AUTO release (Weld's card on the COMP page)
                // 69 = dock_want: the wordmark's "dock me" intent, so a closed
                // and reopened Swing goes back to its pane.
                // 68 = the rail/list SPLITTER width, as an offset from 150.
                // 67 = mini browser FOLDER TREE rail. 66 = strip state (open / subfolders / LCD skin /
                // font). 54 = kit macros (mappings + snapshots) · 55 = macro custom
                // NAMES · 56 = dock-face view override · 57 = reverb/delay bus
                // enables · 58 = console strip sections · 59 = fader well
                // fill · 60 = FX LCD track-number display · 61 = picker vendor
                // column · 62 = rail categories folded · 63 = REAPER's
                // category group folded · 64 = folders group folded. Gates
                // land in SHIP order — the parked transient shaper moves
                // to 65.
file_var(0, ser_ver);
file_var(0, multi_out);

// ver 51 (Phase 4, no-embed): per-project audio-embed policy. EEL2 zero-init
// = 0 = EMBED_MODE_AUTO, which is the desired default, so NO backfill block is
// needed (old projects load as AUTO). This gate is no-embed-ONLY — future
// per-pad fields (link groups, env shape, vel sens, sampling prefs) take 52+.
ser_ver >= 51 ? file_var(0, embed_mode);

// ver 51: embed_written — the per-SAVE decision on whether kit audio bytes are
// embedded in this chunk (1) or dropped for a disk-reload marker (0). WRITE side
// computes it from the projected blob (4 B × Σ interleaved samples) vs the mode
// + thresholds; READ side reads it back so the per-pad audio loop below branches
// IDENTICALLY (skips file_mem when 0 → stream stays aligned). Old projects
// (< 51) always embedded → backfill 1. The verify-recoverable guard that keeps
// a marker from stranding path-less pads is applied when computing it (below).
!is_read ? (
  _emb_proj = 0;      // projected embed size, in interleaved samples
  _emb_norec = 0;     // 1 if any audio-bearing pad has NO disk path (unrecoverable)
  _emb_pi = 0;
  loop(NUM_SLOTS,   // step 3a: embed is per INSTANCE (spec 7) -- every bank's pads count
    p_layer_cnt[_emb_pi] > 0 ? (
      // A layered pad reloads per-layer from LPATH; but a promoted single (CMD 63
      // / VER-200 load: p_layer_cnt=1, audio in layer 0, LPATH empty) reloads from
      // the pad-main path instead. So a pad-main path makes the pad recoverable
      // even when a layer's LPATH is blank — mirror the reload's fallback below.
      _emb_padpath = strlen(get_path_slot(_emb_pi)) > 0;
      _emb_lj = 0;
      loop(MAX_LAYERS,
        _emb_lidx = _emb_pi * MAX_LAYERS + _emb_lj;
        _emb_proj += l_len[_emb_lidx];
        // audio layer with NO LPATH and NO pad-path fallback → unrecoverable
        l_len[_emb_lidx] > 0 && strlen(LPATH_STR_BASE + _emb_lidx) < 1 && !_emb_padpath ? _emb_norec = 1;
        _emb_lj += 1;
      );
    ) : (
      _emb_proj += s_len[_emb_pi];
      s_len[_emb_pi] > 0 && strlen(get_path_slot(_emb_pi)) < 1 ? _emb_norec = 1;
    );
    _emb_pi += 1;
  );
  // P4 step 3d: bridge-published disk health. The JSFX floor above only
  // checks that a path STRING exists — the bridge additionally verifies the
  // files on disk (exists + WAV self-consistency) and publishes a per-pad
  // unhealthy bitmap into this instance's registry-slot band. Trust the
  // verdict only when it was computed against the CURRENT paths_gen and is
  // fresh (<60 s); absent/stale/mismatched health = the JSFX-only floor,
  // i.e. exactly the pre-3d behavior (fail-open). FORCE-EMBED direction
  // only — health can never turn an embed into a marker.
  // Sidecar verdict rides the same slot band (+6, same stamp/gen window):
  // the bridge's health tick verifies (and re-copies when possible) the
  // project sidecar every pass. Unlike health, this one is fail-CLOSED:
  // absent/stale verdict leaves _emb_sc_ok=0 and the marker is refused.
  _emb_sc_ok = 0;
  _reg_my_slot >= 0 ? (
    _emb_hb = GS_REB_SLOT_BASE + _reg_my_slot * 8;
    gmem[_emb_hb + 3] == paths_gen && (time() - gmem[_emb_hb + 2]) < 60 ? (
      (gmem[_emb_hb + 1] | 0) != 0 ? ( _emb_norec = 1; );
      _emb_sc_ok = gmem[_emb_hb + 6] > 0.5;
    );
  );
  // Decide. NEVER drops audio; ALWAYS keeps it up to the hard cap; AUTO drops
  // above the threshold. BUT the recoverability guard overrides a drop: if any
  // audio pad lacks a disk source (or the bridge verified one missing on
  // disk), embed anyway (up to the cap) rather than lose it — better a big
  // chunk than silent data loss.
  // AUTO (2026-09-08): a project sidecar the bridge verified this minute makes
  // the embed redundant at ANY size -- the pads reload from their disk paths on
  // open and the sidecar backstops any that cannot -- so AUTO writes the marker
  // whenever one exists. Without one (untitled project, bridge not running) it
  // embeds up to the threshold as before. The floor below still wins: a pad
  // with no disk source keeps the whole kit embedded, sidecar or not.
  embed_written =
    embed_mode == EMBED_MODE_NEVER  ? 0 :
    embed_mode == EMBED_MODE_ALWAYS ? (_emb_proj <= EMBED_CAP_SAMPLES ? 1 : 0) :
    _emb_sc_ok                      ? 0 :
                                      (_emb_proj <= EMBED_AUTO_SAMPLES ? 1 : 0);
  // Recoverability floor: never drop the embed if a pad would be unrecoverable,
  // UNLESS embedding would itself truncate (over cap) — then a marker is the
  // lesser evil (partial truncation loses audio too; at least the marker is
  // honest and the sidecar/relink UX can recover it).
  _emb_norec && _emb_proj <= EMBED_CAP_SAMPLES ? ( embed_written = 1; );
  // Spec §4 verify-before-marker: a marker-only save is allowed ONLY when the
  // bridge verified a project sidecar this minute. Without one, the chunk is
  // the kit's last copy — keep embedding (up to the cap) even in NEVER/AUTO-
  // drop. Same over-cap lesser-evil exception as the floor above.
  embed_written == 0 && !_emb_sc_ok && _emb_proj <= EMBED_CAP_SAMPLES ? ( embed_written = 1; );
) : (
  embed_written = 1;  // read side: overwritten by file_var below when ser_ver>=51
);
ser_ver >= 51 ? file_var(0, embed_written);
is_read && ser_ver < 51 ? ( embed_written = 1; );  // pre-51 projects always embedded

// ver 52: SYN slot — per-pad synth layer (Spec_Swing_Synth_Layer §4). Fresh
// gate, immutability rule respected (nothing appended to 51). 14 arrays ×
// NUM_PADS, static bounds, file_mem whole-array (stream length is constant).
// Metadata only — the synth writes no audio frames, embed logic unaffected.
ser_ver >= 52 ? (
  file_mem(0, ps_enable,   NUM_PADS);
  file_mem(0, ps_engine,   NUM_PADS);
  file_mem(0, ps_level,    NUM_PADS);
  file_mem(0, ps_vel_lo,   NUM_PADS);
  file_mem(0, ps_vel_hi,   NUM_PADS);
  file_mem(0, ps_rr_order, NUM_PADS);
  file_mem(0, ps_mac0, NUM_PADS);
  file_mem(0, ps_mac1, NUM_PADS);
  file_mem(0, ps_mac2, NUM_PADS);
  file_mem(0, ps_mac3, NUM_PADS);
  file_mem(0, ps_mac4, NUM_PADS);
  file_mem(0, ps_mac5, NUM_PADS);
  file_mem(0, ps_mac6, NUM_PADS);
  file_mem(0, ps_mac7, NUM_PADS);
);
is_read && ser_ver < 52 ? (
  // pre-52 chunks: synth off everywhere, neutral macros — bit-identical audio
  _srz_ps = 0;
  loop(NUM_PADS,
    ps_enable[_srz_ps] = 0; ps_engine[_srz_ps] = 0; ps_level[_srz_ps] = 1;
    ps_vel_lo[_srz_ps] = 0; ps_vel_hi[_srz_ps] = 1; ps_rr_order[_srz_ps] = MAX_LAYERS;
    ps_mac0[_srz_ps] = 0.5; ps_mac1[_srz_ps] = 0.5; ps_mac2[_srz_ps] = 0.5; ps_mac3[_srz_ps] = 0.5;
    ps_mac4[_srz_ps] = 0.5; ps_mac5[_srz_ps] = 0.5; ps_mac6[_srz_ps] = 0.5; ps_mac7[_srz_ps] = 0.5;
    _srz_ps += 1;
  );
);

// ver 54: KIT MACROS (Spec_Swing_Macro_System §7; gate claimed by user
// decision 2026-08-20). The complete model: per-macro meta, the 8×8
// mapping table, snapshots, armed slot. STATIC bounds only — never
// file_avail inside the stream (feedback_jsfx_file_avail_serialize).
// Macro slider VALUES (macro1..8, morph, sel) ride slider state for free.
// ⛔ IMMUTABLE once shipped: additions (names, more snapshots) take gate
// 55+, never an append here (feedback_serialize_gate_immutable).
ser_ver >= 54 ? (
  file_mem(0, kmac_nmap,  KMAC_N);
  file_mem(0, kmac_scope, KMAC_N);
  file_mem(0, kmac_color, KMAC_N);
  file_mem(0, kmac_pad,   KMAC_N * KMAC_MAX_MAP);
  file_mem(0, kmac_pid,   KMAC_N * KMAC_MAX_MAP);
  file_mem(0, kmac_lo,    KMAC_N * KMAC_MAX_MAP);
  file_mem(0, kmac_hi,    KMAC_N * KMAC_MAX_MAP);
  file_mem(0, kmac_curve, KMAC_N * KMAC_MAX_MAP);
  file_mem(0, kmac_snap,     KMAC_NSNAP * KMAC_N);
  file_mem(0, kmac_snap_has, KMAC_NSNAP);
  file_var(0, kmac_snap_act);
);
// A count past KMAC_MAX_MAP was saved by the macro editor's unguarded ADD picker (H22, 2026-10-23). Every reader
// clamps it, but the editor's delete trusted it; clamp on read (the stream itself is unchanged).
is_read && ser_ver >= 54 ? (
  _srz_km = 0; loop(KMAC_N, kmac_nmap[_srz_km] = max(0, min(KMAC_MAX_MAP, kmac_nmap[_srz_km] | 0)); _srz_km += 1;);
);
is_read && ser_ver < 54 ? (
  // pre-54 chunks: 8 empty macros, identity colours, no snapshots. The
  // fx_* arrays those projects saved are already their final values, so
  // nothing needs re-applying (and the tick's prime pass applies nothing).
  _srz_km = 0;
  loop(KMAC_N,
    kmac_nmap[_srz_km] = 0; kmac_scope[_srz_km] = 0; kmac_color[_srz_km] = _srz_km;
    _srz_km += 1;
  );
  _srz_km = 0; loop(KMAC_NSNAP, kmac_snap_has[_srz_km] = 0; _srz_km += 1;);
  kmac_snap_act = 0;
);

// ver 55: kit-macro custom NAMES (≤ KMAC_NAME_LEN chars; empty = house
// default label). Fresh gate per the immutability rule — nothing appended
// to 54. Strings via file_string, the #kit_name idiom.
ser_ver >= 55 ? (
  file_string(0, #kmac_name0); file_string(0, #kmac_name1);
  file_string(0, #kmac_name2); file_string(0, #kmac_name3);
  file_string(0, #kmac_name4); file_string(0, #kmac_name5);
  file_string(0, #kmac_name6); file_string(0, #kmac_name7);
);
is_read && ser_ver < 55 ? (
  strcpy(#kmac_name0, ""); strcpy(#kmac_name1, "");
  strcpy(#kmac_name2, ""); strcpy(#kmac_name3, "");
  strcpy(#kmac_name4, ""); strcpy(#kmac_name5, "");
  strcpy(#kmac_name6, ""); strcpy(#kmac_name7, "");
);

// ver 56: dock-face view override (Spec_Swing_Dock_Mode.md) — 0 Auto (the
// aspect trigger decides) · 1 Full UI always · 2 Rack face always. Fresh
// gate per the immutability rule. Default 0 needs no backfill: pre-56
// chunks leave the zero-init, which IS Auto, and the variable is never
// assigned in @init. Clamp on read so an out-of-range value degrades to a
// legal mode instead of leaking a garbage float into the == tests.
ser_ver >= 56 ? (
  file_var(0, dock_face_mode);
  is_read ? dock_face_mode = max(0, min(2, dock_face_mode | 0));
);

// ver 57: reverb / delay bus enables. FRESH gate — 56 has shipped.
// Migration matters here: before 57 "off" was encoded IN a parameter
// (rvb_size == 0, dly_div == 0), so a straight zero-init read would turn
// every old project's buses off. Read the old encoding, then hand the
// parameter back a usable value so switching the bus on gives you a reverb
// instead of a null one — which is the whole point of a non-destructive off.
ser_ver >= 57 ? (
  file_var(0, rvb_on);
  file_var(0, dly_on);
);
// (the <57 migration lives with the other backfills, AFTER the v15 gate that
// restores dly_div / rvb_size — it reads them.)

// ver 58: console strip sections. FRESH gate — 57 has shipped, and appending
// to a shipped gate is how you desync every project written by it (§3.4).
//
// Eleven of the fourteen default to 1, and EEL2 zero-init is 0, so a project
// written before 58 would load with the console almost entirely blank without
// the backfill below. It restores the pre-58 console exactly: every section a
// 57-era build drew is on, and the two things 58 adds (the inserts band and
// the focus strip) start off — an old project should look like it did, not
// like it grew features while it was closed.
ser_ver >= 58 ? (
  file_var(0, con_ins);   file_var(0, con_ins_full); file_var(0, con_slots);
  file_var(0, con_sw);    file_var(0, con_sw_full);
  file_var(0, con_sends); file_var(0, con_pan);      file_var(0, con_cut);
  file_var(0, con_fader); file_var(0, con_meter);    file_var(0, con_dbsc);
  file_var(0, con_name);
  file_var(0, con_focus);
  file_var(0, con_master);
  file_var(0, con_bg);
  // Clamp on read: these drive layout arithmetic and a garbage float would
  // land as a strip height. con_slots is the only non-boolean (0 = FIT).
  is_read ? (
    con_ins   = con_ins   ? 1 : 0;  con_ins_full = con_ins_full ? 1 : 0;
    con_sw    = con_sw    ? 1 : 0;  con_sw_full  = con_sw_full  ? 1 : 0;
    con_sends = con_sends ? 1 : 0;  con_pan      = con_pan      ? 1 : 0;
    con_cut   = con_cut   ? 1 : 0;  con_fader    = con_fader    ? 1 : 0;
    con_meter = con_meter ? 1 : 0;  con_dbsc     = con_dbsc     ? 1 : 0;
    con_name  = con_name  ? 1 : 0;  con_focus    = con_focus    ? 1 : 0;
    con_master = con_master ? 1 : 0;
    con_slots = max(0, min(8, con_slots | 0));
    con_slots != 0 && con_slots != 4 && con_slots != 6 && con_slots != 8 ?
      con_slots = 8;
    con_bg = max(0, min(5, con_bg | 0));   // 5 = light grey
  );
);
// ver 59: fader well fill (0 full · 1 edge · 2 off). Zero-init = 0 = the
// full slab every earlier build drew, so pre-59 projects need no backfill.
ser_ver >= 59 ? (
  file_var(0, con_wf);
  is_read ? con_wf = max(0, min(2, con_wf | 0));
);
// ver 60: FX LCD track-number display. Zero-init would be OFF, but the option
// exists because the number was ASKED for, so a project that predates the flag
// gets it ON — the backfill below, not an @init assignment (a sample-rate
// change re-runs @init and would wipe the user's choice every time).
ser_ver >= 60 ? (
  file_var(0, fxv_tnum_on);
  is_read ? fxv_tnum_on = fxv_tnum_on ? 1 : 0;
);
is_read && ser_ver < 60 ? fxv_tnum_on = 1;
// ver 61: picker vendor column. ⛔ A SEPARATE GATE, not an extension of 60 --
// projects have already been written at 60, and widening a gate that has been
// written shifts every field after it in those files.
ser_ver >= 61 ? (
  file_var(0, fxv_vend_on);
  is_read ? fxv_vend_on = fxv_vend_on ? 1 : 0;
);
is_read && ser_ver < 61 ? fxv_vend_on = 1;
// ver 62: rail categories folded or open. Its own gate, same reason as 61.
ser_ver >= 62 ? (
  file_var(0, fxv_cats_open);
  is_read ? fxv_cats_open = fxv_cats_open ? 1 : 0;
);
is_read && ser_ver < 62 ? fxv_cats_open = 1;
// ver 63: REAPER's category group folded or open. Its own gate -- 62 has been
// written to projects already and widening a written gate shifts every field
// after it in those files.
ser_ver >= 63 ? (
  file_var(0, fxv_rcat_open);
  is_read ? fxv_rcat_open = fxv_rcat_open ? 1 : 0;
);
is_read && ser_ver < 63 ? fxv_rcat_open = 0;
// ver 64: the FOLDERS group folded or open. Its own gate, same reason as 63.
ser_ver >= 64 ? (
  file_var(0, fxv_fold_open);
  is_read ? fxv_fold_open = fxv_fold_open ? 1 : 0;
);
is_read && ser_ver < 64 ? fxv_fold_open = 1;
// ver 65: which rail groups are SWITCHED OFF. Hidden is not folded -- a folded
// group keeps its header so you can unfold it, a hidden one is gone until the
// restore row brings it back. Its own gate, same reason as 64.
// ⚠️ All three in ONE gate because they are one decision written at one time;
// a project holding 65 holds all three or none, so there is no half-read.
ser_ver >= 65 ? (
  file_var(0, fxv_g2_off);
  file_var(0, fxv_g3_off);
  file_var(0, fxv_g4_off);
  is_read ? (
    fxv_g2_off = fxv_g2_off ? 1 : 0;
    fxv_g3_off = fxv_g3_off ? 1 : 0;
    fxv_g4_off = fxv_g4_off ? 1 : 0;
  );
);
// ⭐ NOTHING hidden for a project that predates the control. An addition must
// not take a group away from a project that never asked to lose one.
is_read && ser_ver < 65 ? ( fxv_g2_off = 0; fxv_g3_off = 0; fxv_g4_off = 0; );
is_read && ser_ver < 58 ? (
  // ⚠️ ON, not off. The first version set this to 0 reasoning that "an old
  // project should look like it did" -- which is right for a change and WRONG
  // for an addition. The inserts band takes nothing away and alters no
  // behaviour; it adds a row of information. Defaulting it off meant the
  // feature was invisible in every project anyone had ever saved, which is
  // every project. Reported as "inserts don't do anything" and that is
  // exactly what it looked like: the band simply never drew.
  con_ins = 1; con_ins_full = 1; con_slots = 8; con_ins_house = 0;
  con_sw = 1;  con_sw_full = 1;                      // 57 drew no Swing band,
                                                     // but full is its honest
                                                     // shape once it exists
  con_sends = 1; con_pan = 1; con_cut = 1;
  con_fader = 1; con_meter = 1; con_dbsc = 1; con_name = 1;
  con_focus = 0; con_master = 0;
);

// ver 44: color overhaul — Folder auto-color mode removed, Rainbow
// renumbered from slot 4→3 (4 modes total). 5 core drum type hues
// spread across the full color wheel for maximum distinction.
// Migration in swing_color_serialize: Folder(3)→Off, Rainbow(4)→Rainbow(3).

// ver 43: color system simplified (themes + palettes removed, replaced
// by a single MONO toggle) and tooltip on/off preference. Defaults:
//   col_mono = 0 (full color)
//   tooltips_enabled = 1 (tooltips visible by default for new instances)
// Old projects (ser_ver < 43): zero-init handles col_mono correctly.
// tooltips_enabled needs the explicit backfill below — otherwise old
// projects would load with tooltips disabled (zero-init=0).
ser_ver >= 43 ? file_var(0, col_mono);
ser_ver >= 43 ? file_var(0, tooltips_enabled);
is_read && ser_ver < 43 ? ( tooltips_enabled = 1; );

// NOTE: pad VOL/PAN knob appearance is NOT serialized here. It lives on hidden
// sliders (slider27-30) that persist via the FX chunk — same pattern as
// pad_icon_mode / map_override_locked. Keeping it OFF @serialize avoids any
// ser_ver bump (and the stream-skew risk that carries), and de-conflicts with
// concurrent work on this gate.

// ver 41: pad-click-selects-track preference. EEL2 zeros uninitialized vars
// on fresh insert, so a brand-new instance gets pad_click_selects_track = 0
// (off — opt-in via Colors right-click menu).
ser_ver >= 41 ? file_var(0, pad_click_selects_track);
// ver 42: welcome-banner dismissal flag. EEL2 zero-init = 0 = show banner.
// User dismisses banner with a click → flag goes to 1 → banner stays gone
// in subsequent sessions on this instance. Per-instance so each fresh
// insert gets its own welcome state.
ser_ver >= 42 ? file_var(0, _welcome_dismissed);

// ── Ver 40 migration: master volume scale dB ──────────────────────────────
// Pre-40, slider2 was `global_vol` with a LINEAR amplitude range (0..2,
// default 1.0). Felt squashed perceptually because human hearing is log.
// In ver 40, slider2 is `master_db` with a dB range (-60..+12, default 0).
// On read of an older project, slider2 still holds the saved AMPLITUDE
// value (REAPER restored it into our renamed variable). Convert it once,
// here, so the equivalent dB lands in master_db and downstream
// (@slider → global_vol) produces the same loudness the project had.
// 20*log10(x) = log(x) * 8.6858896381 (EEL has no log10).
is_read && ser_ver < 40 ? (
  master_db = master_db <= 0 ? -60 : log(master_db) * 8.6858896381;
  slider_automate(slider2);  // commit migrated value so future saves write dB
  global_vol = master_db <= -60 ? 0 : exp(master_db * 0.11512925465);
);
// ver 36: auto-load attempt flag — set after the bridge has been asked to
// load the default 808 kit on this instance, so we never re-trigger on
// project re-open even if the user later cleared all pads.
ser_ver >= 36 ? file_var(0, _auto_load_attempted);
ser_ver >= 3 ? file_var(0, repeat_div);
// ver 6: global velocity curve and swing
ser_ver >= 6 ? (
  file_var(0, vel_curve);
  file_var(0, swing_amt);
);
// ver 8: global FX
ser_ver >= 8 ? (
  file_var(0, gfx_hpf_freq);
  file_var(0, gfx_lpf_freq);
  file_var(0, gfx_sat_drv);
);
// ver 15: global send FX parameters
ser_ver >= 15 ? (
  file_var(0, dly_div);
  file_var(0, dly_fb);
  file_var(0, dly_mix);
  file_var(0, dly_hpf_hz);
  file_var(0, dly_lpf_hz);
  file_var(0, dly_ping);
  file_var(0, rvb_size);
  file_var(0, rvb_damp);
  file_var(0, rvb_mix);
  file_var(0, rvb_width);
);
// ver 16: master EQ + limiter parameters
ser_ver >= 16 ? (
  file_var(0, gfx_eq_lo);
  file_var(0, gfx_eq_mid);
  file_var(0, gfx_eq_hi);
  file_var(0, gfx_lim_on);
  file_var(0, gfx_lim_thr);
  file_var(0, gfx_lim_rel);
);
// ver 17: (was full_level + sixteen_lvl, both deprecated — read for compat)
ser_ver >= 17 ? (
  file_var(0, _fl_compat);   // was full_level — read for migration
  file_var(0, _16lvl_compat); // was sixteen_lvl — ignored
);
// ver 18: master EQ and per-pad EQ frequencies (draggable)
ser_ver >= 18 ? (
  file_var(0, gfx_eq_lo_freq);
  file_var(0, gfx_eq_mid_freq);
  file_var(0, gfx_eq_hi_freq);
);
// ver 20: master EQ shelf/bell toggles + kit name
ser_ver >= 20 ? (
  file_var(0, meq_lo_bell);
  file_var(0, meq_hi_bell);
  file_string(0, #kit_name);
  is_read ? ( kit_name_gmem_dirty = 1; audiolen_gmem_dirty = 1; pad_colors_gmem_dirty = 1; pad_names_gmem_dirty = 1; );
);
// ver 22: note_map mode + multi_out (redundant — multi_out already at top, but
// kept here to preserve the serial stream position for backward compatibility)
ser_ver >= 22 ? (
  file_var(0, note_map);
  file_var(0, multi_out);
);
// ver 23: color_palette
ser_ver >= 23 ? (
  file_var(0, color_palette);
  file_var(0, meq_bypass);
);
// ver 24: master compressor
ser_ver >= 24 ? (
  file_var(0, cmp_thresh);
  file_var(0, cmp_ratio);
  file_var(0, cmp_attack);
  file_var(0, cmp_release);
  file_var(0, cmp_knee);
  file_var(0, cmp_makeup);
  file_var(0, cmp_mix);
  file_var(0, cmp_bypass);
);
// ver 25: reverb pre-delay + HPF
ser_ver >= 25 ? (
  file_var(0, rvb_predelay);
  file_var(0, rvb_hpf);
);
// ver 32: global one-shot toggle
ser_ver >= 32 ? (
  file_var(0, oneshot_global);
);
// ver 49: master drive character type (0=SOFT 1=TUBE 2=TAPE 3=FUZZ 4=CLIP).
// NEW gate — never appended to an older gate (a v48 build wrote that layout).
ser_ver >= 49 ? file_var(0, gfx_drv_mode);
// (a leftover duplicate `is_read = file_avail(0) >= 0;` sat here for months —
// @serialize's first statement already sets it; removed in the perf sweep)
// Serialize-integrity flag (read-side hardening). Set to 1 if any embedded
// audio length read from the stream is out of range (negative, larger than its
// buffer, or larger than the items actually remaining in the file per
// file_avail). A desynced stream — e.g. the 2026-06-10 ser_ver gate-extension
// class of bug — makes the per-pad audio length read back as garbage; passing
// that straight to file_mem() invokes UNDOCUMENTED behavior (the SDK does not
// specify file_mem with an oversized/negative count), which is what amplified a
// 2-field skew into total loss of pads 1-15. Validating before file_mem caps
// the damage and lets us know a load was corrupt. Init every load.
_ser_bad = 0; _ser_bad_told = 0;   // the count of saved lengths refused this read; @block tells the LCD once (2026-10-16)
// Mark that this instance has restored real per-pad state from a project/undo
// chunk. The audio-only-reload preserve path (GS_KIT_PRESERVE_LIVE) is only
// honored when this is set, so a fresh insert that auto-loads a kit (and only
// holds @init defaults) can't snapshot-and-restore those defaults over the
// kit's own params. Set once on the first state restore; stays set for the
// session.
is_read ? _has_deserialized = 1;
is_read && ser_ver < 3 ? repeat_div = 0;
is_read && ser_ver < 6 ? ( vel_curve = 0; swing_amt = 0; );
is_read && ser_ver < 8 ? ( gfx_hpf_freq = 20; gfx_lpf_freq = 20000; gfx_sat_drv = 0; );
is_read && ser_ver < 49 ? gfx_drv_mode = 0;  // master drive type defaults to SOFT
is_read && ser_ver >= 8 ? recalc_global_fx();
is_read && ser_ver < 15 ? (
  dly_div = 2; dly_fb = 0.35; dly_mix = 0.5; dly_hpf_hz = 80; dly_lpf_hz = 8000; dly_ping = 1;
  rvb_size = 0.5; rvb_damp = 0.5; rvb_mix = 0.4; rvb_width = 1.0;
);
is_read && ser_ver >= 15 ? ( dly_recalc(); rvb_recalc(); );
// ver 57 backfill — MUST sit below the v15 gate above: before 57 "off" was
// encoded IN a parameter (rvb_size == 0, dly_div == 0), so the migration has
// to read the values the stream just restored. Zero-init would otherwise load
// every pre-57 project with both buses off. Hand the parameter back a usable
// value too, so switching the bus on gives a reverb rather than a null one.
is_read && ser_ver < 57 ? (
  rvb_on = rvb_size > 0.001;
  dly_on = dly_div > 0;
  !rvb_on ? ( rvb_size = 0.5; rvb_recalc(); );  // kit-default SIZE
  !dly_on ? ( dly_div  = 2;   dly_recalc(); );  // kit-default 1/4T
);
// Land the gate glide on the restored state instead of fading in from the
// @init defaults, and park the ring-out counter so a bus restored OFF stands
// down on the first sample rather than idling an engine for 500 ms.
is_read ? (
  _rvb_gate = rvb_on ? 1 : 0; _dly_gate = dly_on ? 1 : 0;
  _rvb_tail_n = rvb_on ? 0 : _bus_tail_hold;
  _dly_tail_n = dly_on ? 0 : _bus_tail_hold;
);
is_read && ser_ver < 16 ? (
  gfx_eq_lo = 0; gfx_eq_mid = 0; gfx_eq_hi = 0;
  gfx_lim_on = 1; gfx_lim_thr = 1.0; gfx_lim_rel = 100;
);
is_read && ser_ver >= 16 ? (
  gfx_lim_rel_c = exp(-1.0 / max(1, gfx_lim_rel * 0.001 * srate));
  recalc_global_fx();
);
is_read && ser_ver < 17 ? (
  _fl_compat = 0; _16lvl_compat = 0;
);
// Migrate old full_level → vel_curve=3, ONCE: the flag is cleared, or the next save wrote it again and every reopen
// forced the curve back to Fixed whatever the user had set since (the audit, 2026-10-22)
is_read && _fl_compat > 0 ? ( vel_curve = 3; _fl_compat = 0; );
is_read && ser_ver < 18 ? (
  gfx_eq_lo_freq = 200;
  gfx_eq_mid_freq = 1000;
  gfx_eq_hi_freq = 5000;
);
is_read && ser_ver < 20 ? (
  meq_lo_bell = 0;
  meq_hi_bell = 0;
  strcpy(#kit_name, "");
);
is_read && ser_ver < 22 ? (
  note_map = 0;
);
is_read && ser_ver < 23 ? (
  color_palette = 0; meq_bypass = 0;
);
is_read && ser_ver < 24 ? (
  cmp_thresh = 0; cmp_ratio = 4; cmp_attack = 10; cmp_release = 100;
  cmp_knee = 6; cmp_makeup = 0; cmp_mix = 1.0; cmp_bypass = 1;
);
is_read && ser_ver < 70 ? ( cmp_auto = 0; );
is_read && ser_ver >= 24 ? ( cmp_recalc(); );   // here for the targets cmp_reset() seats below; the ver-70 read recalcs again (H14)
is_read && ser_ver < 25 ? (
  rvb_predelay = 0; rvb_hpf = 0;
);
is_read && ser_ver >= 25 ? ( rvb_recalc(); );
is_read && ser_ver < 32 ? ( oneshot_global = 1; );
// Existing instances (pre-v36) shouldn't suddenly auto-load 808 on project
// re-open — assume they've already been used and skip the auto-load path.
is_read && ser_ver < 36 ? ( _auto_load_attempted = 1; );

// ⚠️ Every scratch variable in this @serialize body is _srz_-private ON
// PURPOSE (validator-enforced: serialize_var_isolation). REAPER runs chunk
// capture WITHOUT the JSFX code mutex — @serialize executes concurrently with
// the audio thread and the @gfx thread. When this loop still iterated on the
// shared global `i`, the audio thread's own loop(NUM_PADS,…) scans stomped it
// mid-save (proven 2026-07-16 via shadow-index probe, FX window open AND
// closed); get_path_slot(i>=15) then clamps to #pp15 and every remaining
// record serialized as a clone of pad 15, dropping the kit audio (the
// pad-clone save corruption). Repro/probe harness: .dev_tests/reb_min_hunt.lua
// + reb_probe_driver.sh + reb_census.py; probe cells 26320814-19 (REB
// headroom) are free again — the probe itself lives in git history.
// Step 2a: a read rebuilds every slot's regions from the stream. Drop the in-flight loader
// jobs first (their regions are about to vanish; lane 1 is the marker reload's own lane),
// then start the area over -- each embedded length below takes its region as it arrives.
is_read ? (
  swing_ldr_abort(ldr_job0); swing_ldr_abort(ldr_job1);
  swing_alloc_reset(NUM_SLOTS);
  swing_disp_clear(_al_dl_srz);
  alc_hold = 1;   // the compaction tick stands still while this pass fills the regions (cleared at the end of the read)
);
// ser_ver 76 (step 3a, banks): how many per-pad records follow, and the bank on screen. NEW gate, and
// the record layout below is NOT touched -- every inner gate stays as written (wiki 3.4): a 75 file has
// sixteen records and reads exactly as before, a 76 file has NUM_SLOTS. Reading < 76: sixteen pads land
// in bank A, bank_cur 0, and slots 16..63 are wiped after the walk (see the 76 tail). A file with MORE
// slots than this build holds is read up to NUM_SLOTS and desyncs after -- an older reader's limit, as
// with every bump.
_srz_nslots = NUM_SLOTS;
ser_ver >= 76 ? (
  file_var(0, _srz_nslots);
  file_var(0, bank_cur);
);
is_read ? (
  ser_ver >= 76 ? (
    _srz_nslots = max(NUM_PADS, min(NUM_SLOTS, _srz_nslots | 0));
    bank_cur = max(0, min(NUM_BANKS - 1, bank_cur | 0));
  ) : (
    _srz_nslots = NUM_PADS;
    bank_cur = 0;
  );
);
_srz_i = 0; loop(_srz_nslots,   // step 3a: every slot the file carries (was NUM_PADS)
  file_var(0, s_len[_srz_i]);
  file_var(0, s_start[_srz_i]);
  file_var(0, s_end[_srz_i]);
  file_var(0, s_skip[_srz_i]);
  file_var(0, s_norm[_srz_i]);
  file_var(0, s_norm_gain[_srz_i]);
  file_var(0, p_gain[_srz_i]);
  file_var(0, p_pan[_srz_i]);
  file_var(0, p_tune[_srz_i]);
  file_var(0, p_attack[_srz_i]);
  file_var(0, p_decay[_srz_i]);
  file_var(0, p_sustain[_srz_i]);
  file_var(0, p_release[_srz_i]);
  file_var(0, p_mute[_srz_i]);
  file_var(0, p_solo[_srz_i]);
  file_var(0, p_output[_srz_i]);
  // ver 45: per-pad trigger note + note-lock (tuned-mode "save the tune").
  // MUST be version-guarded — without this, loading any pre-45 project reads
  // these two file_vars at a stream position the old save never wrote,
  // desyncing every field after it (pads come back with note 0 / garbage).
  // The WRITE side always emits the CURRENT ser_ver (>= 45), so new saves
  // persist these; only reads of pre-45 files skip. (Wording is version-
  // independent on purpose — it stays true across bumps.)
  ser_ver >= 45 ? (
    file_var(0, p_note[_srz_i]);
    file_var(0, p_note_lock[_srz_i]);
  );
  // ver 50: per-pad chromatic key range (semitone offsets from root). NEW
  // gate (never appended to an existing one — old in-memory plugins save the
  // pre-50 layout). The WRITE side emits the current ser_ver (>= 50) so both
  // persist. On READ of a pre-50
  // project the false branch backfills a single-note range (0/0), keeping every
  // legacy kit identical. Clamp guards corrupt external edits (offsets >= 0).
  ser_ver >= 50 ? (
    file_var(0, p_rng_lo[_srz_i]);
    file_var(0, p_rng_hi[_srz_i]);
    p_rng_lo[_srz_i] = max(0, min(127, p_rng_lo[_srz_i]));
    p_rng_hi[_srz_i] = max(0, min(127, p_rng_hi[_srz_i]));
  ) : (
    p_rng_lo[_srz_i] = 0;
    p_rng_hi[_srz_i] = 0;
  );
  _srz_sp = get_path_slot(_srz_i);
  file_string(0, _srz_sp);
  // ver 4: per-pad color index and custom name
  ser_ver >= 4 ? (
    file_var(0, p_color[_srz_i]);
    _srz_cn = get_cname_slot(_srz_i);
    file_string(0, _srz_cn);
  );
  // ver 5: source sample rate
  ser_ver >= 5 ? file_var(0, s_sr[_srz_i]);
  // ver 6: choke group, one-shot, reverse
  ser_ver >= 6 ? (
    file_var(0, p_choke[_srz_i]);
    file_var(0, p_oneshot[_srz_i]);
    file_var(0, p_reverse[_srz_i]);
  );
  // ver 37: per-pad L↔R channel swap
  ser_ver >= 37 ? file_var(0, p_swapLR[_srz_i]);
  // ver 7: per-pad FX parameters
  ser_ver >= 7 ? (
    file_var(0, fx_hpf_freq[_srz_i]);
    file_var(0, fx_lpf_freq[_srz_i]);
    file_var(0, fx_eq_lo[_srz_i]);
    file_var(0, fx_eq_mid[_srz_i]);
    file_var(0, fx_eq_hi[_srz_i]);
    file_var(0, fx_sat_drv[_srz_i]);
  );
  // ver 9: per-layer metadata and layer controls
  ser_ver >= 9 ? (
    file_var(0, p_layer_cnt[_srz_i]);
    file_var(0, p_layer_mode[_srz_i]);
    _srz_li = 0; loop(MAX_LAYERS,
      _srz_lidx = _srz_i * MAX_LAYERS + _srz_li;
      file_var(0, l_len[_srz_lidx]);
      file_var(0, l_start[_srz_lidx]);
      file_var(0, l_end[_srz_lidx]);
      file_var(0, l_sr[_srz_lidx]);
      file_var(0, l_norm[_srz_lidx]);
      file_var(0, l_norm_gain[_srz_lidx]);
      _srz_li += 1;
    );
  );
  // v10: per-layer velocity ranges and RR order
  ser_ver >= 10 ? (
    _srz_li = 0; loop(MAX_LAYERS,
      _srz_lidx = _srz_i * MAX_LAYERS + _srz_li;
      file_var(0, l_vel_lo[_srz_lidx]);
      file_var(0, l_vel_hi[_srz_lidx]);
      file_var(0, l_rr_order[_srz_lidx]);
      _srz_li += 1;
    );
  );
  // v11: per-layer file paths for reload
  ser_ver >= 11 ? (
    _srz_li = 0; loop(MAX_LAYERS,
      _lps = LPATH_STR_BASE + _srz_i * MAX_LAYERS + _srz_li;
      file_string(0, _lps);
      _srz_li += 1;
    );
  );
  // v12: embedded audio — write/read actual sample buffers
  // For each layer (or legacy slot), store the used sample count then the data.
  // Only the used portion is written, keeping preset size proportional to content.
  ser_ver >= 12 ? (
    p_layer_cnt[_srz_i] > 0 ? (
      // Layered pad: embed each layer's audio
      _srz_li = 0; loop(MAX_LAYERS,
        _srz_lidx = _srz_i * MAX_LAYERS + _srz_li;
        _srz_abuf = p_lptr[_srz_i * MAX_LAYERS + _srz_li];
        _srz_alen = l_len[_srz_lidx];
        file_var(0, _srz_alen);          // sample count (interleaved stereo pairs)
        // Read-side guard: a legitimate layer length is 0..LAYER_SIZE. A garbage
        // length from a desynced stream reads back as a huge or negative number;
        // passing that to file_mem invokes UNDOCUMENTED behavior (oversized/neg
        // count) — the exact amplifier that turned a 2-field skew into total loss
        // of pads 1-15. Clamp out-of-range to 0 (skip the read) and flag. NB: do
        // NOT consult file_avail here — its mid-@serialize behavior is unverified
        // and calling it inside the read loop corrupts subsequent block reads.
        is_read && (_srz_alen < 0 || _srz_alen > LAYER_SIZE) ? ( _srz_alen = 0; _ser_bad += 1; );
        // ver 51 no-embed: audio bytes present only when embed_written. In marker
        // mode the length above is still written/read (expected-vs-restored +
        // stream alignment), but the samples are NOT — the loader reloads them
        // from the layer path (v11 file_string above). Read + write branch on the
        // SAME serialized flag, so the stream never desyncs.
        // Step 2a: on a read the layer's region is taken here, sized to the length just read
        // (the tables were reset at the top of the pass). Refused = no room -- unreachable at
        // sixteen slots, reachable once four banks share the area: the bytes are still
        // consumed so the stream stays aligned, and the layer comes back empty.
        is_read && embed_written && _srz_alen > 0 ? (
          swing_pad_fit_layer(_srz_i, _srz_li, _srz_alen, _al_dl_srz) ? (
            _srz_abuf = p_lptr[_srz_i * MAX_LAYERS + _srz_li];
          ) : (
            _srz_abuf = -1; swing_alloc_refuse_note(_srz_i);
          );
          swing_disp_free(_al_dl_srz);
        );
        embed_written && _srz_alen > 0 ? (
          _srz_abuf >= 0 ? file_mem(0, _srz_abuf, _srz_alen) : (
            _srz_skip = _srz_alen;
            while (_srz_skip > 0) (
              _srz_n = min(_srz_skip, SWAP_CHUNK);
              file_mem(0, _swap_tmp_buf, _srz_n);
              _srz_skip -= _srz_n;
            );
            is_read ? l_len[_srz_lidx] = 0;
          );
        );
        _srz_li += 1;
      );
    ) : (
      // Legacy single-sample pad: embed full slot audio
      _srz_abuf = p_aptr[_srz_i];
      _srz_alen = s_len[_srz_i];
      file_var(0, _srz_alen);
      // Read-side guard (see layered branch): a real slot length is 0..SLOT_SIZE.
      // Out of range ⇒ desynced stream ⇒ clamp to 0 + flag, avoiding the
      // undocumented file_mem oversized-count path. No file_avail here (unsafe
      // mid-read).
      is_read && (_srz_alen < 0 || _srz_alen > SLOT_SIZE) ? ( _srz_alen = 0; _ser_bad += 1; );
      // ver 51 no-embed: skip the sample bytes in marker mode (see layered
      // branch). Length stays in the stream; audio reloads from the pad path.
      // Step 2a: the plain region is taken here on a read (see the layered branch).
      is_read && embed_written && _srz_alen > 0 ? (
        swing_pad_fit_main(_srz_i, _srz_alen, _al_dl_srz) ? (
          _srz_abuf = p_aptr[_srz_i];
        ) : (
          _srz_abuf = -1; swing_alloc_refuse_note(_srz_i);
        );
        swing_disp_free(_al_dl_srz);
      );
      embed_written && _srz_alen > 0 ? (
        _srz_abuf >= 0 ? file_mem(0, _srz_abuf, _srz_alen) : (
          _srz_skip = _srz_alen;
          while (_srz_skip > 0) (
            _srz_n = min(_srz_skip, SWAP_CHUNK);
            file_mem(0, _swap_tmp_buf, _srz_n);
            _srz_skip -= _srz_n;
          );
          is_read ? s_len[_srz_i] = 0;
        );
      );
    );
  );
  // v13: drive mode per pad
  ser_ver >= 13 ? (
    file_var(0, fx_drv_mode[_srz_i]);
  );
  // v14: bitcrush parameters
  ser_ver >= 14 ? (
    file_var(0, fx_bc_rate[_srz_i]);
    file_var(0, fx_bc_bits[_srz_i]);
  );
  // v15: per-pad send amounts
  ser_ver >= 15 ? (
    file_var(0, fx_snd_dly[_srz_i]);
    file_var(0, fx_snd_rvb[_srz_i]);
  );
  // v18: per-pad EQ frequencies (draggable)
  ser_ver >= 18 ? (
    file_var(0, fx_eq_lo_freq[_srz_i]);
    file_var(0, fx_eq_mid_freq[_srz_i]);
    file_var(0, fx_eq_hi_freq[_srz_i]);
  );
  // v19: sum mode tightness + per-pad repeat
  ser_ver >= 19 ? (
    file_var(0, p_sum_tight[_srz_i]);
    file_var(0, p_rpt_div[_srz_i]);
  );
  // v34: per-pad sample offset
  ser_ver >= 34 ? (
    file_var(0, p_sample_offset[_srz_i]);
  );
  // v27: per-layer gain
  ser_ver >= 27 ? (
    _srz_li = 0; loop(MAX_LAYERS,
      _srz_lidx = _srz_i * MAX_LAYERS + _srz_li;
      file_var(0, l_gain[_srz_lidx]);
      _srz_li += 1;
    );
  );
  // v35: per-pad ADSR-user-tuned flag (1 = user touched ADSR; skip auto-analyze on drag-in)
  ser_ver >= 35 ? (
    file_var(0, p_adsr_user[_srz_i]);
  );
  // v38: per-pad compressor (amount + mode)
  ser_ver >= 38 ? (
    file_var(0, fx_cmp_amt[_srz_i]);
    file_var(0, fx_cmp_mode[_srz_i]);
  );
  // v39: per-pad filter resonance Q
  ser_ver >= 39 ? (
    file_var(0, fx_reso[_srz_i]);
  );
  // v45: per-pad Swing Pitch (Part B) mode + algo
  //   sp_pitch_mode  — 0=Repitch (default, today's behavior) / 1=Tuned / 2=Stretch
  //   sp_pitch_algo  — 0=Drum (default) / 1=Tonal / 2=Texture / 3=Voice
  // Shift_st is sourced from existing p_tune[_srz_i] (already serialized at v0)
  // so a single semitone value drives every mode.
  ser_ver >= 45 ? (
    file_var(0, sp_pitch_mode[_srz_i]);
    file_var(0, sp_pitch_algo[_srz_i]);
  );
  // v46: 4th EQ band (second bell, "hi-mid").
  // v47: per-bell Q. SEPARATE gate — projects were saved against the
  // 2-field v46 build, and extending an already-written gate skews every
  // field after it (the maxed-faders corruption of 2026-06-10). Rule:
  // never append to a gate ANY build has written; bump instead.
  ser_ver >= 46 ? (
    file_var(0, fx_eq_mid2[_srz_i]);
    file_var(0, fx_eq_mid2_freq[_srz_i]);
  );
  ser_ver >= 47 ? (
    file_var(0, fx_eq_mid_q[_srz_i]);
    file_var(0, fx_eq_mid2_q[_srz_i]);
  );
  // v48: per-band shelf Q — FRESH gate (never extend a written gate)
  ser_ver >= 48 ? (
    file_var(0, fx_eq_lo_q[_srz_i]);
    file_var(0, fx_eq_hi_q[_srz_i]);
  );
  // v53: smash send (parallel-comp bus) — FRESH gate. ⚠️ the transient shaper
  // re-targeted 54 (gates land in ship order; wire order = file order).
  ser_ver >= 53 ? (
    file_var(0, fx_snd_smash[_srz_i]);
  );
  is_read ? (
    // Defaults for older presets
    ser_ver < 4 ? (
      p_color[_srz_i] = _srz_i;
      strcpy(get_cname_slot(_srz_i), "");
    );
    ser_ver < 5 ? s_sr[_srz_i] = 0;
    ser_ver < 6 ? ( p_choke[_srz_i] = 0; p_oneshot[_srz_i] = 1; p_reverse[_srz_i] = 0; );
    ser_ver < 37 ? p_swapLR[_srz_i] = 0;  // pre-v37 presets: L↔R swap off
    ser_ver < 7 ? (
      fx_hpf_freq[_srz_i] = 20; fx_lpf_freq[_srz_i] = 20000;
      fx_eq_lo[_srz_i] = 0; fx_eq_mid[_srz_i] = 0; fx_eq_hi[_srz_i] = 0;
      fx_sat_drv[_srz_i] = 0;
    );
    ser_ver < 9 ? (
      p_layer_cnt[_srz_i] = 0;
      p_layer_mode[_srz_i] = 3;
      _srz_li = 0; loop(MAX_LAYERS,
        _srz_lidx = _srz_i * MAX_LAYERS + _srz_li;
        l_len[_srz_lidx] = 0; l_start[_srz_lidx] = 0; l_end[_srz_lidx] = 1.0;
        l_sr[_srz_lidx] = 0; l_norm[_srz_lidx] = 0; l_norm_gain[_srz_lidx] = 1.0;
        l_vel_lo[_srz_lidx] = _srz_li / MAX_LAYERS;
        l_vel_hi[_srz_lidx] = (_srz_li + 1) / MAX_LAYERS;
        l_rr_order[_srz_lidx] = _srz_li;
        l_gain[_srz_lidx] = 1.0;
        _srz_li += 1;
      );
    );
    ser_ver < 10 ? (
      _srz_li = 0; loop(MAX_LAYERS,
        _srz_lidx = _srz_i * MAX_LAYERS + _srz_li;
        l_vel_lo[_srz_lidx] = _srz_li / MAX_LAYERS;
        l_vel_hi[_srz_lidx] = (_srz_li + 1) / MAX_LAYERS;
        l_rr_order[_srz_lidx] = _srz_li;
        _srz_li += 1;
      );
    );
    ser_ver < 11 ? (
      // No layer paths stored — clear layer path strings
      _srz_li = 0; loop(MAX_LAYERS,
        strcpy(LPATH_STR_BASE + _srz_i * MAX_LAYERS + _srz_li, "");
        _srz_li += 1;
      );
    );
    ser_ver < 13 ? fx_drv_mode[_srz_i] = 0;  // default to SOFT
    ser_ver < 14 ? ( fx_bc_rate[_srz_i] = 0; fx_bc_bits[_srz_i] = 16; );  // bitcrush off
    ser_ver < 15 ? ( fx_snd_dly[_srz_i] = 0; fx_snd_rvb[_srz_i] = 0; );  // sends off
    ser_ver < 18 ? ( fx_eq_lo_freq[_srz_i] = 200; fx_eq_mid_freq[_srz_i] = 1000; fx_eq_hi_freq[_srz_i] = 5000; );  // EQ frequency defaults
    ser_ver < 19 ? ( p_sum_tight[_srz_i] = 0; p_rpt_div[_srz_i] = 0; );  // tight by default, repeat off
    ser_ver < 34 ? ( p_sample_offset[_srz_i] = 0; );  // offset off
    // v35: assume old presets had auto-derived ADSR (let drag-in re-analyze)
    ser_ver < 35 ? ( p_adsr_user[_srz_i] = 0; );
    ser_ver < 38 ? ( fx_cmp_amt[_srz_i] = 0; fx_cmp_mode[_srz_i] = 0; );  // compressor off
    ser_ver < 39 ? ( fx_reso[_srz_i] = 0.707; );  // Butterworth default
    // v45: existing presets shipped before three-mode pitch — Repitch/Drum
    // (Repitch = today's local SincResampler path = zero behavior change).
    ser_ver < 45 ? ( sp_pitch_mode[_srz_i] = 0; sp_pitch_algo[_srz_i] = 0; );
    // v46: pre-4-band projects — hi-mid bell flat (identical sound)
    ser_ver < 46 ? ( fx_eq_mid2[_srz_i] = 0; fx_eq_mid2_freq[_srz_i] = 3000; );
    // v47: pre-per-bell-Q projects — Qs at the old fixed 0.8
    ser_ver < 47 ? ( fx_eq_mid_q[_srz_i] = 0.8; fx_eq_mid2_q[_srz_i] = 0.8; );
    // v48: pre-shelf-Q projects — Qs at the old fixed S=1.0 equivalent
    ser_ver < 48 ? ( fx_eq_lo_q[_srz_i] = 0.7071; fx_eq_hi_q[_srz_i] = 0.7071; );
    ser_ver < 53 ? ( fx_snd_smash[_srz_i] = 0; );  // smash send off
    ser_ver < 27 ? (
      _srz_li = 0; loop(MAX_LAYERS,
        l_gain[_srz_i * MAX_LAYERS + _srz_li] = 1.0;
        _srz_li += 1;
      );
    );
    // v26: force one-shot for all existing kits — drum pads should ignore note-off
    // (tilr/Saike approach: samples play through, note length is irrelevant)
    ser_ver < 26 ? p_oneshot[_srz_i] = 1;
    // v32: migrate binary one-shot to tri-state (-1 = follow global)
    // Old binary had no global toggle, so both 0 (gate) and 1 (one-shot) → -1
    ser_ver >= 6 && ser_ver < 32 ? ( p_oneshot[_srz_i] = -1; );
    // v17: migrate integer palette index → float hue
    ser_ver < 17 && ser_ver >= 4 ? (
      _srz_ci = (p_color[_srz_i])|0;  // was integer 0-15
      _srz_ci = max(0, min(15, _srz_ci));
      p_color[_srz_i] = pc[_srz_ci];  // pc[] maps old index → hue float
    );
    ser_ver < 17 && ser_ver < 4 ? (
      p_color[_srz_i] = _srz_i / 16.0;  // no color stored, use evenly-spaced hues
    );
    // v12+: audio was embedded — already restored by file_mem above, UNLESS
    // this is a ver-51 no-embed MARKER save (embed_written == 0): the chunk
    // carried only per-pad lengths + paths, so reload the samples from disk.
    // Pre-v12 always path-reloaded. Both cases go through the same reload.
    // (embed_written backfills to 1 for ser_ver 12..50, so those still take the
    // embedded path — no double-load.)
    ser_ver < 12 || !embed_written ? (
      // Reload legacy audio (only for non-layered pads)
      p_layer_cnt[_srz_i] == 0 && s_len[_srz_i] > 0 && strlen(_srz_sp) > 0 ? (
        load_from_path(_srz_i, _srz_sp);
      );
      // Reload layer audio from stored paths.
      p_layer_cnt[_srz_i] > 0 ? (
        _any_lp = 0;
        _srz_li = 0; loop(MAX_LAYERS,
          _lps = LPATH_STR_BASE + _srz_i * MAX_LAYERS + _srz_li;
          strlen(_lps) > 0 ? (
            // load_layer_from_path blind-resets l_start/l_end to 0/1 (twice:
            // pre-load and post-load in rk_swing_core) — correct for a fresh
            // drop, WRONG here: this @serialize pass just restored the user's
            // trim into those exact cells, and any kit-loaded pad has LPATH
            // stamped (VER-201, core:738) so it takes THIS branch, never the
            // trim-preserving load_from_path fallback below. Save the pair
            // around the call and re-apply — the same post-load re-apply the
            // VER-201 importer already does (rk_swing_ui_state:1141-1142).
            // Harmless on a failed load (l_len stays 0, pad is silent anyway).
            // Without this, the on-open preserve reload then CEMENTS the wipe:
            // its snapshot runs after this pass, so restore puts the zeroed
            // pair back over the sidecar's correct values (found 2026-08-05,
            // pad-12 "Foley Car Door" repro in tk.rpp).
            _srz_lidx2 = _srz_i * MAX_LAYERS + _srz_li;
            _srz_lt0 = l_start[_srz_lidx2];
            _srz_lt1 = l_end[_srz_lidx2];
            load_layer_from_path(_srz_i, _srz_li, _lps);
            l_start[_srz_lidx2] = _srz_lt0;
            l_end[_srz_lidx2]   = _srz_lt1;
            _any_lp = 1;
          );
          _srz_li += 1;
        );
        // Promoted-single pad (CMD 63 / VER-200 load): p_layer_cnt=1 with audio
        // in layer 0 but LPATH empty — its disk source is the pad-main path.
        // Fall back to load_from_path so the marker reload isn't left blank.
        !_any_lp && strlen(_srz_sp) > 0 ? load_from_path(_srz_i, _srz_sp);
      );
    );
    s_dirty[_srz_i] = 1;
    recalc_pad(_srz_i);
    recalc_fx(_srz_i);
  );
  _srz_i += 1;
);

// v28: lock bitmask placeholder (+ legacy map slots for ser_ver 28–30)
ser_ver >= 28 ? (
  _lk_compat = 0; file_var(0, _lk_compat); // lock removed — keep format slot
  // Legacy slot data: read and discard for ser_ver 28–30
  is_read && ser_ver >= 28 && ser_ver <= 30 ? (
    file_var(0, _sl_discard);  // active_slot
    _sl_si = 0; loop(16,       // 16 slots
      _sl_pi = 0; loop(16,     // 16 pads per slot
        // 6 numeric fields (gain, pan, pitch, output, mute, locked)
        file_var(0, _sl_discard); file_var(0, _sl_discard);
        file_var(0, _sl_discard); file_var(0, _sl_discard);
        file_var(0, _sl_discard); file_var(0, _sl_discard);
        // Path string: length + N chars
        file_var(0, _sl_len);
        _sl_ci = 0; loop(_sl_len, file_var(0, _sl_discard); _sl_ci += 1;);
        // Name string: length + N chars
        file_var(0, _sl_len);
        _sl_ci = 0; loop(_sl_len, file_var(0, _sl_discard); _sl_ci += 1;);
        _sl_pi += 1;
      );
      _sl_si += 1;
    );
  );
);
// v29: color system (theme, auto-mode, intensity)
ser_ver >= 29 ? (
  swing_color_serialize();
);
is_read && ser_ver < 29 ? (
  col_theme_id = 0;
  col_auto_mode_id = 0;
  col_intensity = 1.0;
);
// Always rebuild pad colors after project load (prevents stale col_rgba[])
is_read ? ( col_dirty = 1; );

// v33: embedded mode knob toggle
ser_ver >= 33 ? (
  file_var(0, embed_show_knobs);
);
is_read && ser_ver < 33 ? ( embed_show_knobs = 1; );

// ─── Reset companion state on project load ──────────────────────────────
is_read ? (
  gmem[GS_UPDATE_STATE] = 0;      // clear stale update indicator
  gmem[GS_UPDATE_REQUEST] = 1;    // ask companion to re-check
  heartbeat_counter = 0;
  update_dot_alpha = 0;
  update_dot_dir = 1;
);

// ─── Anti-pop: kill all voices + reset FX state + fade-in after deserialize ──
is_read ? (
  // Kill all voices immediately so @sample doesn't read half-written buffers
  _srz_vi = 0; loop(V_SLOTS,
    v_pos[_srz_vi] = -1; v_env[_srz_vi] = 0; v_stage[_srz_vi] = 0;
    _srz_vi += 1;
  );
  // Clear delay + reverb buffers (stale tails would pop through on first sample)
  memset(dly_bufL, 0, DLY_BUF_MAX);
  memset(dly_bufR, 0, DLY_BUF_MAX);
  dly_wpos = 0; dly_outL = 0; dly_outR = 0;
  dly_fb_hpf_stL = 0; dly_fb_hpf_stR = 0;
  dly_fb_lpf_stL = 0; dly_fb_lpf_stR = 0;
  rvb_outL = 0; rvb_outR = 0;
  // Clear reverb tank (delay lines + allpasses + pre-delay + filter states)
  _srz_vi = 0; loop(8,
    memset(rvb_dl_buf[_srz_vi], 0, RVB_MAX_DL); rvb_dl_wp[_srz_vi] = 0;
    memset(rvb_ap_buf[_srz_vi], 0, rvb_ap_len[_srz_vi]); rvb_ap_wp[_srz_vi] = 0;
    rvb_lp_state[_srz_vi] = 0;
    _srz_vi += 1;
  );
  memset(rvb_pre_bufL, 0, RVB_MAX_PRE);
  memset(rvb_pre_bufR, 0, RVB_MAX_PRE);
  rvb_pre_wp = 0; rvb_hpf_stateL = 0; rvb_hpf_stateR = 0;
  // Reset master SVF filters (clears integrator state + coefficients)
  _srz_i = 0; loop(SVF_MST_COUNT,
    svf_init(svf_master + _srz_i * SVF_STEREO_SIZE);
    _srz_i += 1;
  );
  // Reset per-pad SVF filters (clears integrator state + coefficients)
  _srz_i = 0; loop(NUM_SLOTS * SVF_PER_PAD,   // step 3a: every slot
    svf_init(svf_pad + _srz_i * SVF_STEREO_SIZE);
    _srz_i += 1;
  );
  // Recompute filter coefficients from deserialized params, then snap the
  // SVFs to them — a restore must not glide up from the unity reset.
  recalc_global_fx();
  _srz_i = 0; loop(NUM_SLOTS, recalc_fx(_srz_i); _srz_i += 1;);   // step 3a: every slot
  _srz_i = 0; loop(NUM_SLOTS * SVF_PER_PAD,
    svf_snap(svf_pad + _srz_i * SVF_STEREO_SIZE);
    _srz_i += 1;
  );
  _srz_i = 0; loop(SVF_MST_COUNT, svf_snap(svf_master + _srz_i * SVF_STEREO_SIZE); _srz_i += 1;);
  // Mark every pad's waveform cache dirty so the visual refreshes after
  // chunk restore (Ctrl+Z, project reload). Without this, wv_cache holds
  // stale data from before the deserialize and the pad keeps showing
  // the previous waveform — making Ctrl+Z look like it did nothing
  // even when the underlying audio buffer DID revert.
  _srz_i = 0; loop(NUM_SLOTS, s_dirty[_srz_i] = 1; _srz_i += 1;);   // step 3a: every slot
  // Reset compressor state (circuit engine: two cap voltages, not an
  // envelope -- poke nothing directly, the inc owns its internals)
  cmp_reset();
  // Reset limiter envelope
  gfx_lim_env = 1.0; gfx_lim_gr = 1.0;
  // Start output crossfade: blend from last output (saved in _xf_prev) to new DSP.
  // Gate: only fade if _xf_prev contains *clearly audible* audio (-40 dB).
  // Below that, any snap-cut pop is masked by the noise floor — and arming the
  // crossfade for sub-audible residue (e.g. reverb tail at -60 dB) means the
  // 20ms ramp attenuates the first hit's transient before the @sample
  // short-circuit (-80 dB) can deactivate it. Threshold split is intentional.
  abs(_xf_prev[0]) + abs(_xf_prev[1]) > 0.01 ? (
    _xf_pos = 0;
    _xf_len = swing_xf_len(0.020);  // 20ms crossfade (+ a block under Wired, A-5)
    _xf_active = 1;
  );

  // Sync param smoothers to chunk-loaded targets so they don't ramp from
  // their @init defaults (0 / 1.0) on the first audio block. Without this,
  // the saturator/master-volume ramp slowly toward the saved values and
  // the FIRST hit (or first whole pass of a loop) sounds quieter than
  // subsequent ones — symptom: "first kick is soft, fine after the loop
  // wraps once."
  _sat_drv_sm = gfx_sat_drv;
  _vol_sm     = global_vol;

  // ── Chunk-truncation audio repair detection ───────────────────────────
  // REAPER's FX-state chunk has a hard size limit. For big kits (e.g.
  // 808 at ~2 MB) the audio embedded via `file_mem(0, _srz_abuf, _srz_alen)`
  // gets truncated on chunk capture — the metadata round-trips fine
  // but the audio buffer comes back zeroed on chunk restore (Undo, Redo,
  // project reopen). The auto-kit-sidecar mechanism handles project
  // reopen separately; this detector handles Undo/Redo + any other
  // mid-session chunk restore.
  //
  // Heuristic: for each pad whose metadata says s_len > 100 (real audio
  // expected, not just empty), probe THREE positions in the buffer —
  // start (samples 0/1/2), middle (s_len/2), end (s_len-1). If ALL of
  // those are exactly 0, the buffer was wiped — flag for repair. Three
  // probes mitigate false positives from pads that legitimately start
  // with silence preroll (kick attacks, denormal-cleared tails).
  //
  // On any pad failing the check, set GS_AUDIO_REPAIR_REQ = instance_id
  // so the bridge knows WHICH instance to repair. Multiple instances
  // can fail in the same session — the bridge processes them serially
  // by clearing the slot after each one (last-writer-wins is fine
  // because each flagged instance keeps re-writing until repaired).
  _ar_truncated = 0;
  _ar_pi = 0; loop(NUM_SLOTS,   // step 3a: every slot
    // Step 2a: a layered pad's sound is in its layer-0 region (p_aptr is dead after the
    // promotion's transfer), so probe the region that holds it, over its own length.
    _ar_len = p_layer_cnt[_ar_pi] > 0 ? l_len[_ar_pi * MAX_LAYERS] : s_len[_ar_pi];
    _ar_len > 100 ? (
      _ar_buf = p_layer_cnt[_ar_pi] > 0 ? p_lptr[_ar_pi * MAX_LAYERS] : p_aptr[_ar_pi];
      _ar_mid = (_ar_len / 2) | 0;
      _ar_end = _ar_len - 1;
      // All-zero check at three positions — buffer is wiped iff every
      // probe is exactly 0. A real-audio pad has at least one non-zero
      // sample across these three points (probability ≈ 1).
      _ar_buf[0] == 0 && _ar_buf[1] == 0 && _ar_buf[2] == 0 &&
        _ar_buf[_ar_mid] == 0 && _ar_buf[_ar_end] == 0 ?
        _ar_truncated = 1;
    );
    _ar_pi += 1;
  );
  _ar_truncated ? gmem[GS_AUDIO_REPAIR_REQ] = instance_id;

  // ── P4 step 3: restore stamps ─────────────────────────────────────────
  // _reb_restore_gen counts completed deserializes (0 = this instance never
  // restored — the bridge's rebase audit skips it); _reb_restored_at feeds
  // the relink banner's grace window (don't warn while the bridge's
  // auto-rebase may still be repairing). The marker-reload loop above
  // already stamped pad_fail_bits naturally via the loaders' recompute.
  // RUNTIME-ONLY: never serialized, never touched in @init (@init can run
  // AFTER @serialize — EEL zero-init covers first run).
  _reb_restore_gen += 1;
  _reb_restored_at = time_precise();
  paths_gen += 1;
  alc_hold = 0;   // the regions are filled: the compaction tick may move them again (step 2a)
);

// ── ver 66: mini browser strip state ────────────────────────────────────────
// The strip used to reset on every load, and that is wrong twice over. It
// forgets how you left it — and because REAPER restores a floating FX window
// at its last SIZE, a window that had been GROWN for an open strip came back
// wide with the strip shut. A live bridge hides that (it gives back exactly
// what it added), but a bridge restart ADOPTS the wide window as the new
// baseline and the next open grows it again. Persisting fb_open keeps the
// window and the strip telling the same story.
//
// ⚠️ Every var here has a ZERO default and is assigned nowhere in @init. That
// is not tidiness, it is the requirement: @init can run AFTER @serialize (see
// the _reb_restore_gen note above), so an @init assignment would stamp the
// restored value back. multi_out and embed_mode follow the same rule.
// fb_fsz / fb_preview / fb_autoload are absent for exactly that reason —
// non-zero defaults need an offset form, which is a use-site refactor.
ser_ver >= 66 ? (
  file_var(0, fb_open);
  file_var(0, fb_subfolders);
  file_var(0, fb_lcd);
  file_var(0, fb_font);
);
// ver 67: the FOLDER TREE rail. Same rule as above -- zero default, assigned
// nowhere in @init.
ser_ver >= 67 ? file_var(0, fb_tree);
// ver 68: where the user dragged the seam between the rail and the file list.
// ⭐ Stored as an OFFSET FROM FB_TREE_W (150), which is what lets it obey the
// zero-default rule above -- 0 reads as "the default width", so an old project
// and a fresh instance land in the same place. This is the offset form the
// comment above says fb_fsz / fb_preview / fb_autoload are still waiting for.
ser_ver >= 68 ? file_var(0, fb_tw_off);
// ver 69: the wordmark's DOCK intent. Set by the "return to the dock" click,
// cleared only by the "pop out" click -- NOT by the pane releasing the canvas,
// which is what slider42 tracks and why slider42 could not carry this: the
// pane clears it when the user closes the dock tab, and the reopened window
// floated with nobody remembering it had been docked. Zero default, assigned
// nowhere in @init, same rule as everything above.
ser_ver >= 69 ? file_var(0, dock_want);
ser_ver >= 70 ? file_var(0, cmp_auto);
// ⚠️ The Weld comp is recalculated AGAIN after its last field (2026-10-23, H14).
// Its only recalc ran up at the ver-24 block, before cmp_auto was read here, so
// it built the timing network for the PREVIOUS AUTO state: a fresh instance
// (default fixed release) never wrote the AUTO network's coefficients
// (cmp_t_invdet stayed 0), then read cmp_auto = 1 -- the comp stopped
// compressing, makeup only, until a knob moved. That first recalc stays where
// it is: cmp_reset() above seats the makeup / mix smoothers at the targets it
// sets, and those do not depend on AUTO, so this second call moves no target
// (no glide) and only rebuilds the network. Nothing Weld reads comes after
// this line (ver 73 is Anvil's: pushed below).
is_read && ser_ver >= 70 ? ( cmp_recalc(); );
ser_ver >= 71 ? file_var(0, rpt_grid);
ser_ver >= 72 ? ( file_var(0, rpt_prob); file_var(0, rpt_hum); file_var(0, rpt_press); );
// A project written before 72 has no probability field, and 0 would read as a
// roll that never sounds. Backfill the only sane value.
is_read && ser_ver < 72 ? ( rpt_prob = 1.0; rpt_hum = 0.0; rpt_press = 0.0; );
// 73: which engine the master comp runs (0 Weld, the byte-identical default;
// 1 Anvil Black; 2 Anvil Blue) and Anvil's own six controls, which share
// nothing with Weld's and keep their values while the other voice is in.
// Zero default on the voice: every project written before 73 loads as Weld.
ser_ver >= 73 ? (
  file_var(0, cmp_voice);
  file_var(0, cmp_anv_in); file_var(0, cmp_anv_out); file_var(0, cmp_anv_atk);
  file_var(0, cmp_anv_rel); file_var(0, cmp_anv_ratio); file_var(0, cmp_anv_mix);
);
is_read && ser_ver < 73 ? (
  cmp_voice = 0; cmp_anv_in = 0; cmp_anv_out = 0; cmp_anv_atk = 3; cmp_anv_rel = 5;
  cmp_anv_ratio = 3; cmp_anv_mix = 1;
);
is_read ? swing_comp_anvil_push();
// 74: the console's EON PLUGINS switch. Older projects hide them (the tidy default).
ser_ver >= 74 ? file_var(0, con_ins_house);
is_read && ser_ver < 74 ? con_ins_house = 0;
is_read ? con_ins_house = con_ins_house ? 1 : 0;

// ser_ver 75: master EQ Q, one per MODE (LO shelf, LO bell, MID, HI shelf, HI
// bell) -- wheel over a node. A NEW gate: the 74 gate above is never extended.
// The backfill is not decoration: ext_noinit makes @init run once per
// instance, so loading an older project into a running Swing would otherwise
// keep the PREVIOUS project's Q. Per-mode Q needs no knowledge of the mode to
// backfill -- every value simply returns to the pre-75 fixed shape.
ser_ver >= 75 ? (
  file_var(0, gfx_eq_lo_sq); file_var(0, gfx_eq_lo_bq); file_var(0, gfx_eq_mid_q);
  file_var(0, gfx_eq_hi_sq); file_var(0, gfx_eq_hi_bq);
);
is_read && ser_ver < 75 ? (
  gfx_eq_lo_sq = sqrt(0.5); gfx_eq_lo_bq = 0.8; gfx_eq_mid_q = 0.8;
  gfx_eq_hi_sq = sqrt(0.5); gfx_eq_hi_bq = 0.8;
);
// A saved Q is another program's number: clamp it to the wheel's range, and
// catch NaN in the positive form (a NaN fails every comparison).
is_read ? (
  gfx_eq_lo_sq = gfx_eq_lo_sq >= 0.3 ? min(6, gfx_eq_lo_sq) : sqrt(0.5);
  gfx_eq_lo_bq = gfx_eq_lo_bq >= 0.3 ? min(6, gfx_eq_lo_bq) : 0.8;
  gfx_eq_mid_q = gfx_eq_mid_q >= 0.3 ? min(6, gfx_eq_mid_q) : 0.8;
  gfx_eq_hi_sq = gfx_eq_hi_sq >= 0.3 ? min(6, gfx_eq_hi_sq) : sqrt(0.5);
  gfx_eq_hi_bq = gfx_eq_hi_bq >= 0.3 ? min(6, gfx_eq_hi_bq) : 0.8;
);
// ser_ver 76 (step 3a, banks), the TAIL: the SYN slot for slots 16..63. Gate 52 wrote the fourteen
// arrays sixteen wide and is immutable, so the remaining slots ride here, whole-array file_mem from
// NUM_PADS for NUM_SLOTS - NUM_PADS cells each (static bounds, the 52 shape).
ser_ver >= 76 ? (
  file_mem(0, ps_enable   + NUM_PADS, NUM_SLOTS - NUM_PADS);
  file_mem(0, ps_engine   + NUM_PADS, NUM_SLOTS - NUM_PADS);
  file_mem(0, ps_level    + NUM_PADS, NUM_SLOTS - NUM_PADS);
  file_mem(0, ps_vel_lo   + NUM_PADS, NUM_SLOTS - NUM_PADS);
  file_mem(0, ps_vel_hi   + NUM_PADS, NUM_SLOTS - NUM_PADS);
  file_mem(0, ps_rr_order + NUM_PADS, NUM_SLOTS - NUM_PADS);
  file_mem(0, ps_mac0 + NUM_PADS, NUM_SLOTS - NUM_PADS);
  file_mem(0, ps_mac1 + NUM_PADS, NUM_SLOTS - NUM_PADS);
  file_mem(0, ps_mac2 + NUM_PADS, NUM_SLOTS - NUM_PADS);
  file_mem(0, ps_mac3 + NUM_PADS, NUM_SLOTS - NUM_PADS);
  file_mem(0, ps_mac4 + NUM_PADS, NUM_SLOTS - NUM_PADS);
  file_mem(0, ps_mac5 + NUM_PADS, NUM_SLOTS - NUM_PADS);
  file_mem(0, ps_mac6 + NUM_PADS, NUM_SLOTS - NUM_PADS);
  file_mem(0, ps_mac7 + NUM_PADS, NUM_SLOTS - NUM_PADS);
);
// ── 77: PAD BANKS step 4b -- the four bank names (a kit loaded into a bank names that bank; the strip shows them).
// A fresh gate: 76 has been written by this tree's builds since 3a (wiki 3.4: never append to a written gate).
// Reading < 77: bank A takes the kit name (read above) and B..D are unnamed, so the strip shows the kit's
// name on A and "kit" / "empty" on the others until a load names them.
ser_ver >= 77 ? (
  _srz_i = 0; loop(NUM_BANKS, file_string(0, BKNAME_STR_BASE + _srz_i); _srz_i += 1; );
);
is_read && ser_ver < 77 ? (
  _srz_i = 1; loop(NUM_BANKS - 1, strcpy(BKNAME_STR_BASE + _srz_i, ""); _srz_i += 1; );
  strcpy(BKNAME_STR_BASE, #kit_name);
);
// ── 78: the STEP SEQUENCER (Spec_Swing_Seq_View 8; phase S1, 2026-10-19). A fresh gate at the tail; the body is
// rk_seq_core's seq_serialize (sparse: an unused pattern costs one flag, a lane its switched-on steps; every count
// meets a static bound before it is used). Reading an older file clears the sequencer: a running instance that opens
// an older project must not keep the previous project's patterns (ext_noinit; the 75 rule).
ser_ver >= 78 ? seq_serialize();
is_read && ser_ver < 78 ? seq_clear_all();
// ── 80: the side slot's second panel (round two J's first cut, 2026-10-22): the pad FX panel's open flag and which of
// the slot's two panels is in front (0 the browser, 1 the pad FX panel). Zero defaults, assigned nowhere in @init (the
// ver 66 rule): a window grown for an open panel must come back with it open. A fresh gate at the tail.
ser_ver >= 80 ? ( file_var(0, pfx_open); file_var(0, side_front); );
// ── 81: the browser's height when it is placed below the pads (round two J's swap, 2026-10-22; fb_place rides the
// sequencer's SETTINGS block). Zero default = the default height, assigned nowhere in @init.
ser_ver >= 81 ? file_var(0, fb_h);
// ── 82: the pad editor placed below the pads (2026-10-22; fx_place rides the sequencer's SETTINGS block): its dragged
// height there, and the panel's page (0 the sound editor, 1 the synth editor). Zero defaults, assigned nowhere in @init.
ser_ver >= 82 ? ( file_var(0, fx_h); file_var(0, pfx_page); );
// ── 83: the side slot's width as the user dragged it (its gutter's handle, 2026-10-22); 0 = the panels' own widths.
ser_ver >= 83 ? file_var(0, side_w);
// Reading a file that carried fewer slots than this build holds (every file before 76): the slots it
// did not carry are WIPED where it matters -- a running instance that opens an older project must not
// keep the previous project's bank B. Audio lengths, layers, the four strings, the SYN enable and the
// SYN neutral set (the 52-era backfill); the other parameters of an empty slot are unreachable
// (pad_is_playable) and every load path runs clear_pad first, which resets them.
is_read && _srz_nslots < NUM_SLOTS ? (
  _srz_i = _srz_nslots; loop(NUM_SLOTS - _srz_nslots,
    swing_slot_wipe(_srz_i);   // regions, lengths, layers, strings, SYN enable (rk_swing_core; shared with the import's bank wipe, step 3b)
    ser_ver < 76 ? (
      ps_enable[_srz_i] = 0; ps_engine[_srz_i] = 0; ps_level[_srz_i] = 1;
      ps_vel_lo[_srz_i] = 0; ps_vel_hi[_srz_i] = 1; ps_rr_order[_srz_i] = MAX_LAYERS;
      ps_mac0[_srz_i] = 0.5; ps_mac1[_srz_i] = 0.5; ps_mac2[_srz_i] = 0.5; ps_mac3[_srz_i] = 0.5;
      ps_mac4[_srz_i] = 0.5; ps_mac5[_srz_i] = 0.5; ps_mac6[_srz_i] = 0.5; ps_mac7[_srz_i] = 0.5;
    );
    _srz_i += 1;
  );
);
// The master filters were rebuilt and snapped far above, BEFORE Q was read,
// so they still hold the previous Q -- the graph would show the restored Q
// while the audio kept the old one (reopen, or undo of a Q-only edit). Rebuild
// and snap again now that every master-EQ value is in: a restore must not
// glide (the same rule as the pass above). The block drift watcher would
// catch it too, but a block late and gliding.
is_read ? (
  recalc_global_fx();
  _srz_i = 0; loop(SVF_MST_COUNT, svf_snap(svf_master + _srz_i * SVF_STEREO_SIZE); _srz_i += 1;);
);

// ─── Graphics ─────────────────────────────────────────────────────────────
// Default height 720 -> 780: at 720 the master section overflowed the window.
// The left column is a fixed stack (LCD 130 + KIT/SOUND/PLAY/SAMPLES/TOOLS
// rows) that puts _ctrl_area_y at 549, leaving only 165 px for the master
// block — so swing_panels_draw_master() clipped the DRIVE-type pill
// (SOFT/TUBE/TAPE/FUZZ/CLIP) by 9 px and the MASTER VOL caption by 8 px on a
// fresh instance. Break-even is 741; 780 clears both by ~20 px, which is the
// margin that absorbs font-metric variance across DPI settings.
@gfx 780 780

// Letterbox / margin colour. REAPER clears the backbuffer with this BEFORE it
// calls @gfx, so what we set here lands on the next frame — imperceptible, and
// it means the margins can follow the theme instead of staying cream while the
// body goes dark. bg_r is set by swing_ui_set_colors() further down @gfx, so on
// the very first frame it is still 0: fall back to the cream until it is real,
// or the plugin opens with one black frame.
// +0.5 before the truncate, so the EON default body reproduces the old constant
// EXACTLY (0.84/0.81/0.76 * 255 = 214.2/206.6/193.8 — a bare |0 gives 214,206,193
// and shifts the margins a point off the body they are supposed to match).
gfx_clear = bg_r > 0 ? ((bg_r * 255 + 0.5) | 0) + ((bg_g * 255 + 0.5) | 0) * 256 + ((bg_b * 255 + 0.5) | 0) * 65536
                     : 214 + 207*256 + 194*65536;  // warm cream (the EON default body)
// Embed mouse routing (REAPER 7.45+ verified): 0x200 SET = passthrough (click goes
// to the track), CLEAR = capture inline. Swing's embedded view is interactive (pad
// triggers + VOL knobs), so default to CAPTURE — clear 0x200 — or every click passes
// through and the embedded knobs freeze (they can't grab the drag). Was |= 0x200
// unconditionally. (EEL2 has no unary bitwise-NOT; clear a bit via |= then -=.)
// Not in an idle pass (& 2): idle leaves 0x200 as the last visible pass set it (house rule 4).
!(gfx_ext_flags & 2) ? gfx_ext_flags = (gfx_ext_flags | 0x200) - 0x200;
// NAME BAR (the THEME menu's row, slider45) re-applied every visible pass, which is
// what makes the pick live: REAPER picks 0x100 up on the next frame, both ways
// (measured 7.79 + 7.80). On an older host the change simply waits for a reload.
!(gfx_ext_flags & 2) ? (
  name_bar ? ( gfx_ext_flags = (gfx_ext_flags | 0x100) - 0x100; ) : ( gfx_ext_flags |= 0x100; );
);

// HOVER (the THEME menu's row, slider46) -> the knob library's rk_hover_mode,
// which rk_knob_draw reads for every style. Set HERE, at the top of the pass and
// on EVERY pass including the embed, because the pad knobs draw in the embedded
// view too and a knob drawn before this line would use last frame's level.
// ⛔ The slider stores the LIBRARY's encoding (0 = Normal), NOT the menu's row
// order -- so a project saved before this row existed reads 0 and draws exactly
// as it always did. The menu does the reordering; see swing_thm_hover_k2v.
rk_hover_mode = hover_mode;

// Skip first 2 frames — gfx_w/gfx_h may not be valid yet on project load
gfx_frame_count += 1;
gfx_frame_count <= 2 ? (
  gfx_set(0, 0, 0, 1); gfx_rect(0, 0, gfx_w, gfx_h);
) : (

// ── UI font scale (issue #1 point 3: "unusable" at 4K / 175%) ─────────────
// REAPER hands this @gfx a surface sized by the display scale, so at 175% the
// window is 1.75x the 780 declared above. Every box here is a fraction of
// gfx_w/gfx_h and grew with it; the labels were literal pixels and did not.
// ⭐ Deliberately NOT gfx_ext_retina. That changes the coordinate system the
// entire UI is built on -- a rewrite, not a fix -- and the minibrowser's own
// comments already depend on Swing staying off it. This leaves every
// coordinate exactly as it is and only asks how much bigger the surface is
// than the size the layout was drawn for.
// min of the two ratios, not gfx_w alone: the window resizes to any aspect,
// and text sized off the LONG side overflows boxes bound by the short one.
// max(1, ...) never shrinks below the designed sizes -- a window smaller than
// 780 keeps exactly today's behaviour instead of gaining unreadable text,
// which is the floor the handful of already-scaled call sites use too.
// The sequencer's gutter and panel (rk_seq_ui) are EXTRA height the window gained for them, not room the face
// grew into: left in, a wide window would rescale the whole face the moment the panel opened. Last window
// pass's take (the gate runs below); an embed pass has neither.
_ui_sc = max(1.0, min(gfx_w / 780, (gfx_h - ((gfx_ext_flags & 1) ? 0 : seq_ui_take_win)) / 780));


// ── Deferred undo action processor ──
swing_ui_process_undo();

// ── Kit-undo request: engine flagged a kit-level undo (type-3 entry). Ask the
//    bridge to reload this instance's undo sidecar (CMD 82). The reload then
//    arrives as a normal browser-style kit load (PENDING_LOAD_INST + REQ=2). ──
_udo_kitundo_req ? (
  gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 && gmem[KIT_GMEM_CMD] == 0 ? (
    gmem[KIT_GMEM_LOCK] = instance_id;
    gmem[KIT_GMEM_CMD] = 82;
    _udo_kitundo_req = 0;
  ) : gmem[KIT_GMEM_BRIDGE_ALIVE] <= 0 ? (
    _udo_kitundo_req = 0;   // no bridge — drop the request rather than wedge
  );
);

// ── Phase 2: deferred swap-undo (swap_pads + get_*_slot are reachable here at
//    runtime; avoids def-time forward refs from the engine) ──
_udo_swap_req ? (
  _udo_applying = 1;
  swap_pads(udo_s2_pad, udo_s2_pad2);
  // swap_pads handles audio+metadata; the strings (cname, name, path AND the four layer paths, which this site
  // used to leave crossed -- H15, 2026-10-23) through the one helper every swap site shares
  swing_pad_swap_strings(udo_s2_pad, udo_s2_pad2);
  s_dirty[udo_s2_pad] = 1; s_dirty[udo_s2_pad2] = 1; col_dirty = 1; pad_names_gmem_dirty = 1;
  gmem[GS_PROJ_DIRTY] = 1;
  _udo_applying = 0; _udo_swap_req = 0;
);

// ── Phase 2: deferred per-pad name restore (get_*_slot is core-only; the
//    engine sets the flag, we apply it here) ──
_udo_name_req ? (
  undo_pad_names_restore(_udo_name_pad);
  _udo_name_pad >= 0 ? s_dirty[_udo_name_pad] = 1;
  col_dirty = 1; pad_names_gmem_dirty = 1;
  _udo_name_req = 0;
);

// ── Deferred synth-autoname rename sync: _syn_autoname sets the flag so a
//    16-pad batch fires ONE CMD 52 after all names landed. Retries while the
//    CMD bus is busy instead of dropping; drops when no bridge (nothing
//    consumes CMD 52 then — mirrors _udo_kitundo_req). ──
_syn_name_sync ? (
  gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? (
    sync_note_names();
    gmem[KIT_GMEM_CMD] == 52 ? _syn_name_sync = 0;
  ) : (
    _syn_name_sync = 0;
  );
);

// ── Pad category post drain (synth icon parity + native sample drops): ONE
//    PADCAT-mailbox post per 4th frame — the REQ cell is single-slot and the
//    bridge polls it per defer tick (~30Hz), so batch posts would drop all but
//    the last. That pacing is what lets a 16-file drop categorise all 16 pads
//    instead of just the one that happened to land last. Queue survives a dead
//    bridge; posts need a registry slot (the mailbox routes by slot+note). ──
_reg_my_slot >= 0 && gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 && (gfx_frame_count & 3) == 0 ? (
  _syn_cp_i = 0; _syn_cp_done = 0;
  loop(NUM_PADS,
    _syn_cp_i_s = swing_bp(_syn_cp_i);
    !_syn_cp_done && _syn_cat_pend[_syn_cp_i_s] > -100 ? (
      swing_lcd_padcat_post_ex(_syn_cp_i_s, _syn_cat_pend[_syn_cp_i_s], _syn_cat_src[_syn_cp_i_s]);
      _syn_cat_pend[_syn_cp_i_s] = -100;
      _syn_cat_src[_syn_cp_i_s] = -1;
      _syn_cp_done = 1;
    );
    _syn_cp_i += 1;
  );
);

// ── EON_VIEW_REQ: Lua asks for a big view. Edge-triggered on the seq cell, and
//    baselined on the first frame so a stale request left in gmem by a previous
//    session cannot yank a freshly-inserted instance into some view. Slot-
//    matched, so one Swing switching view does not drag its siblings along.
//    swing_bigview_open (not a bare assignment) because it also zeroes the
//    stale _ov_* modal gates — the documented hazard for every view entry. ──
_reg_my_slot >= 0 ? (
  _view_req_seq = gmem[EON_VIEW_REQ]|0;
  _view_req_last < 0 ? (
    _view_req_last = _view_req_seq;                 // baseline, act on nothing
  ) : (
    _view_req_seq != _view_req_last ? (
      _view_req_last = _view_req_seq;
      (gmem[EON_VIEW_REQ + 1]|0) == _reg_my_slot ? (
        _view_req_id = gmem[EON_VIEW_REQ + 2]|0;
        _view_req_id == VIEW_NONE ? swing_bigview_close() :
        _view_req_id > 0 && _view_req_id <= VIEW_FXPICK ? swing_bigview_open(_view_req_id) :
        _view_req_id == VIEW_SEQ ? swing_bigview_open(VIEW_SEQ) :
        // Pad Banks step 4d: the bank actions (ids 12..VIEW_ID_MAX)
        _view_req_id >= VIEW_BANK_A && _view_req_id <= VIEW_BANK_D ? swing_banktabs_select(_view_req_id - VIEW_BANK_A) :
        _view_req_id == VIEW_BANK_NEXT ? swing_banktabs_select((bank_cur + 1) % NUM_BANKS) :
        _view_req_id == VIEW_BANK_PREV ? swing_banktabs_select((bank_cur + NUM_BANKS - 1) % NUM_BANKS);
      );
    );
  );
);

// ── EON_POPUP_REQ: Lua asks for a modal overlay or popup. Same discipline as
//    EON_VIEW_REQ above — edge-triggered on seq, baselined on the first frame
//    so a stale request cannot yank a fresh instance open, and slot-matched so
//    siblings are unaffected. Each kind calls the SAME opener the click handler
//    does, so a captured figure cannot drift from the real UI. ──
_reg_my_slot >= 0 ? (
  _popup_req_seq = gmem[EON_POPUP_REQ]|0;
  _popup_req_last < 0 ? (
    _popup_req_last = _popup_req_seq;               // baseline, act on nothing
  ) : (
    _popup_req_seq != _popup_req_last ? (
      _popup_req_last = _popup_req_seq;
      (gmem[EON_POPUP_REQ + 1]|0) == _reg_my_slot ? (
        _popup_req_kind = gmem[EON_POPUP_REQ + 2]|0;
        // +3 is a PAD INDEX for kinds 1-3 and a MODE VALUE for 5-8, so each is
        // clamped where it is used rather than globally — a mode squeezed into
        // the pad range would be silently wrong instead of obviously wrong.
        _popup_req_arg  = gmem[EON_POPUP_REQ + 3]|0;
        _popup_req_pad  = max(0, min(NUM_PADS - 1, _popup_req_arg));
        // Anchor popups inside the frame: the real ones open at the mouse, and
        // there is no mouse here. Fractions of gfx_w/h so any window size works.
        // 0, not -1: callers act on result > 0 (a pick) or == -1 (cancel), so
        // zero closes the card without firing either branch. A capture must
        // never leave a selection behind.
        _popup_req_kind == 0 ? (
          swing_popup_close(0); cat_ov_pad = -1; rng_ov_pad = -1; pk_ov_pad = -1; kmac_ed_open = 0; _mv_drag_pad = -1;
          kdd_open = KDD_MODE_NONE;
          // Clear the demo banner too: a capture must never leave a "samples
          // missing" warning standing over a session where nothing is missing.
          _relink_demo_n = 0; _relink_dismissed = 0;
        ) :
        _popup_req_kind == 1 ? ( cat_ov_pad = swing_bp(_popup_req_pad); ) :   // bank-relative by protocol (step 4a)
        _popup_req_kind == 2 ? ( rng_ov_pad = swing_bp(_popup_req_pad); ) :
        _popup_req_kind == 3 ? (
          swing_lcd_catmenu_open(gfx_w * 0.30, gfx_h * 0.34, swing_bp(_popup_req_pad));
        ) :
        _popup_req_kind == 4 ? (
          swing_lcd_modemenu_open(gfx_w * 0.34, gfx_h * 0.42);
        ) :
        // 5-8 are plain view sub-states, not modal cards. They persist until
        // changed — swing_mapping_init runs once from @init (freemem pattern),
        // NOT on view entry — so the caller sets them and then opens the view.
        _popup_req_kind == 5 ? (                       // mapping layout, 0..6
          _mv_layout = max(0, min(6, _popup_req_arg));
        ) :
        _popup_req_kind == 6 ? (                       // KIT-tab dropdown panel
          // The panel only draws over the KIT tab (rk_swing_ui_changemap:568
          // gates on lcd_right_tab == 0), so force the tab too rather than
          // silently producing the pad grid with nothing over it.
          lcd_right_tab = 0;
          kdd_open = max(KDD_MODE_NONE, min(KDD_MODE_LAYERS, _popup_req_arg));
        ) :
        _popup_req_kind == 7 ? (                       // push grid sub-mode
          _mv_push_mode = _popup_req_arg != 0;
        ) :
        _popup_req_kind == 8 ? (                       // 8-pad bank A/B
          _mv_bank = _popup_req_arg != 0;
        ) :
        _popup_req_kind == 9 ? (                       // embed menu
          swing_state_embedmenu_open(gfx_w * 0.34, gfx_h * 0.28);
        ) :
        _popup_req_kind == 10 ? (                      // controller note-map presets
          swing_panels_mapmenu_open(gfx_w * 0.22, gfx_h * 0.22);
        ) :
        _popup_req_kind == 11 ? (                      // "Kit samples missing" banner
          // Backdate the restore stamp past the banner's own 6s settle, or the
          // figure would come back empty for the first six seconds.
          _relink_demo_n = max(1, min(NUM_PADS, _popup_req_arg));
          _relink_dismissed = 0;
          _reb_restored_at = time_precise() - 10;
        ) :
        _popup_req_kind == 12 ? (                      // ...and its action menu
          swing_state_relinkmenu_open(gfx_w * 0.30, gfx_h * 0.30);
        ) :
        _popup_req_kind == 13 ? (                      // per-pad NOTE picker
          // Opens exactly as the NOTE pill does: set the pad, raise pk_reframe,
          // and let swing_notepick_draw claim the framing. The pill cannot call
          // a function in the picker lib (it imports first), so the flag IS the
          // shared opener — using it here is what keeps this figure identical to
          // what a click produces instead of a lookalike.
          pk_ov_pad = swing_bp(_popup_req_pad);   // bank-relative by protocol, like kinds 1-3 (Pad Banks audit M3)
          pk_reframe = 1;
          _ov_lmb_down = 0; _ov_rmb_down = 0; _ov_LMB = 0; _ov_RMB = 0; _ov_wheel = 0;
        );
      );
    );
  );
);

// ── Random SYNTH kit populate (NEW button → "New Random SYNTH Kit"): waits
//    for the NEW reset to land (_undo_pending returns to 0; bridge-dead NEW
//    resets synchronously so this fires immediately). Lives HERE because
//    _syn_* helpers resolve only after every import. Macros = engine ear-pack
//    defaults blended toward random (35/65) — full-random rolls too many
//    zero-decay corpses; this keeps every pad speaking while still surprising. ──
_syn_newkit_req && _undo_pending == 0 && !kit_busy ? (
  _snk_p = 0;
  loop(NUM_PADS,
    _snk_p_s = swing_bp(_snk_p);
    ps_enable[_snk_p_s] = 1;
    // Anchored core: pad 0 = KICK, pad 1 = SNARE, pad 2 = HAT (bottom row on
    // the MPC layout), rest random — a playable foundation every roll.
    ps_engine[_snk_p_s] =
      _snk_p == 0 ? 0 :
      _snk_p == 1 ? 1 :
      _snk_p == 2 ? 3 : rand(6)|0;
    _syn_engine_defaults(_snk_p_s, ps_engine[_snk_p_s]|0);
    _snk_k = 0; loop(8,
      _syn_mac_set(_snk_p_s, _snk_k,
        min(1, max(0, _syn_mac_get(_snk_p_s, _snk_k) * 0.35 + rand(1) * 0.65)));
      _snk_k += 1;
    );
    ps_level[_snk_p_s] = 1;
    ps_vel_lo[_snk_p_s] = 0; ps_vel_hi[_snk_p_s] = 1;
    p_rr_idx[_snk_p_s] = 0;
    _syn_autoname(_snk_p_s);   // engine names + batched CMD 52 + col_dirty
    s_dirty[_snk_p_s] = 1;
    _snk_p += 1;
  );
  _kd_site = 7; mark_dirty_kit();
  col_dirty = 1;
  _syn_newkit_req = 0;
);

// ── DEV HOOK (kitpipe_button probe) RETIRED 2026-08-03. It replayed the LOAD
//    button's old write-set (take LOCK, raise CMD 2, self-arm), but the real
//    LOAD click stopped doing that — it opens the Kits view, and picks go
//    through CMD 24 (see rk_swing_ui_panels_controls "No CMD-2 arming here
//    anymore"). So the hook exercised a path no button takes, while its
//    trigger — a bare instance_id in a gmem cell — was one off-by-one write
//    away from a synthetic kit load in a customer session (GS_LOAD_WANT, the
//    adjacent cell, is legitimately written with instance_id by four sites).
//    Headless LOAD coverage lives on in the kitsview devpick mailbox in
//    @block, which drives the REAL CMD-24 funnel end-to-end. CMD 2 itself
//    stays live for Lite/companion senders — only the synthetic presser died.


// ── Frame globals (required by knobs_kbsg) ──
_char = gfx_getchar();
is_embedded = gfx_ext_flags & 1;
mx = mouse_x; my = mouse_y;
LMB = mouse_cap & 1;
RMB = mouse_cap & 2;
// Per-surface press latches (D-3): loads THIS pass's surface latch into
// prev_LMB / prev_RMB, and freezes an unhovered embed's pass while the other
// embed holds a press. Defined beside the latches in @init.
swing_srf_load();
lmb_down = LMB && !prev_LMB;
rmb_down = RMB && !prev_RMB;
// Internal PARAM undo: snapshot all pads' pre-edit state on the mouse-DOWN
// edge (before any UI handler can mutate a pad this frame). Committed on the
// mouse-UP edge below for whichever pads mark_dirty_pad() flagged.
// A wheel or right-button bracket still open (D-9, below) commits first, so its
// edits keep their own entry and the left press captures a fresh baseline.
lmb_down && _udo_nl_t > 0 ? ( undo_commit_gesture(); _udo_nl_t = 0; );
lmb_down ? undo_capture_baseline();
// A finished kit or browser load re-bases the snapshot (D-8): the import tick and
// swing_browser_load_pad_done raise the request from @block. A drag in flight
// loses its pre-load entry, the accepted trade.
_udo_rebase_req ? ( _udo_rebase_req = 0; undo_capture_baseline(); );
// Modifiers from the same effective mouse state as LMB and mx/my: _srf_cap is
// mouse_cap, except on an unhovered embed pass standing in for the other
// embed's live press, where swing_srf_load hands over the owner's cap (D-3).
CTRL  = _srf_cap & 4;

SHIFT = _srf_cap & 8;
ALT   = _srf_cap & 16;
// Global safety: release active_id when mouse button is up
!LMB && active_id >= 0 ? active_id = -1;
dt = min(time_precise() - frame_last_timer, 0.05);
frame_last_timer = time_precise();
hv_speed = 11;
frame_wheel = mouse_wheel / 120;
mouse_wheel = 0;
// Internal PARAM undo for a wheel notch or a right-button edit (D-9): with no left
// press, the first one captures the baseline and opens a timed bracket, further
// notches within 0.3 s extend it, and the tail commits it once 0.3 s pass without
// activity (or a left press begins, above). Before this, only the left press
// captured a baseline, so a scrolled knob had nothing to undo.
!LMB && (frame_wheel != 0 || rmb_down) ? (
  _udo_nl_t == 0 ? undo_capture_baseline();
  _udo_nl_t = time_precise();
);

// ── Registry heartbeat (mirror of the @block writer at the @block top) ──
// @block freezes when transport stops or REAPER idles the audio device,
// so the 3s registry timeout expired and every consumer (PDC host,
// strip-sync, browser) flapped the slot dead->alive on each audio burst:
// console spam plus real PDC re-flushes. The GUI thread keeps ticking
// while the FX window (or an embedded view) is open, so refresh the
// heartbeat here too. Slot/offset MUST match the @block writer (+1 = HB).
_reg_my_slot >= 0 ? (
  gmem[GS_INST_REG_BASE + _reg_my_slot * GS_INST_REG_STRIDE + 1] = time_precise();
);

// ── Overlay modal gate ──
swing_ui_modal_gate();
// Mini browser input claim. MUST run here, before any pane draws: the strip
// paints last, so this is the only point at which it can stop a click reaching
// whatever is underneath its column.
swing_fb_gate();
// The step sequencer's panel under the pads: its height this frame, the height request to the bridge, and
// ui_bot -- the main face's bottom edge, which the layout reads instead of gfx_h (rk_seq_ui swing_seq_gate).
swing_seq_gate();

// ── In-place pad-name editor input (rk_swing_padname_edit.jsfx-inc) ──
// Right after the modal gate: its click-swallow (box owns clicks inside
// itself) must precede every grid handler; its guards must see this
// frame's modal state. Drains the char queue and zeroes _char while
// editing so the popup/overlay ESC checks don't double-consume.
swing_pne_tick();

// ── Kit-import gate + state machine moved to @block (above @sample),
//    so they fire even when the FX window is closed. The @gfx side here
//    keeps swing_ui_export_tick() because export uses gfx-context modal
//    dialogs (file save, name prompt) that genuinely need @gfx.
swing_ui_export_tick();

// ── Misc commands: auto-color, rename, meters, caches ──
swing_ui_misc_cmds();

// ── Pre-computed pad colors ──
col_dirty ? (
  swing_color_rebuild();
  // Flush pad hues + effective S/L to gmem so the Kit Bridge can sync
  // multi-out track colors without the browser being open.
  _ki = 0; loop(NUM_PADS,
    _ki_s = swing_bp(_ki);
    gmem[KIT_GMEM_META + _ki * KIT_GMEM_META_PP + 12] =
      col_auto_mode_id > 0 ? col_auto_hue[_ki] : p_color[_ki_s];
    _ki += 1;
  );
  swing_color_get_theme_sl(col_theme_id);
  gmem[GS_COL_EFFECTIVE_S] = _sc_s * col_intensity;
  gmem[GS_COL_EFFECTIVE_L] = _sc_l;
);

// ── Color constants ──
swing_ui_set_colors();

// ── Browser sync: write window size + dirty UI state to gmem (see rk_swing_ui_state.jsfx-inc) ──
swing_browser_sync_gmem_writes();

browser_running = gmem[GS_BROWSER_OPEN];
media_explorer_running = gmem[GS_MEDIA_EXPLORER_OPEN];

// ── Browser sample/layer load (CMD 63 / 64) — see rk_swing_browser_load.jsfx-inc ──
// NOTE: Both must run BEFORE the GS_BROWSE_PAD sync below, otherwise we'd
// overwrite the browser's target pad before the handler reads it.
// (Each handler internally checks _is_browser_target() so secondary
//  Swing instances ignore the CMD.)
// Drive the Tuned-mode pitch chain at GUI rate. swing_block_pitch_tick()
// otherwise only runs from @init / @slider / @block — so on a fresh kit load
// with transport stopped, a Tuned pad's bake was never REQUESTED until the
// audio engine ran @block (the "had to play audio / run the probe" symptom).
// With options:gfx_idle this @gfx section ticks at gfx_hz even when the FX
// window is closed, so the bake fires as soon as the pad has audio regardless
// of transport / window state. Safe from @gfx: the tick only publishes to the
// gmem request channel (no audio buffers touched) and is explicitly designed
// to be called from multiple contexts in the same gesture.
swing_block_pitch_tick();
// ── ENGINE-STALL FALLBACK ONLY (2026-07-27 double-dispatch fix) ─────────
// These five dispatches also run in @block, and BOTH used to fire: a @gfx
// frame landing during a @block handler's multi-ms disk load RE-ENTERED the
// same CMD (the handler only clears CMD at its end). Harmlessly idempotent
// for years — until the FILL name-adopt consume-once flag made the twin
// entries diverge (entrant #2 found the flag consumed, skipped the adopt,
// and its auto-basename push landed last: every filled pad showed
// "padNN_lay0"). @gfx now consumes ONLY when the audio engine is provably
// stalled: the @block heartbeat (_bl_blkctr) frozen for >0.5s of WALL TIME
// (frame counting misread huge audio-device buffers — a 4096-sample buffer
// is ~93ms/block, freezing the heartbeat across several 60Hz frames while
// the engine is perfectly alive; 0.5s is unreachable by any real buffer
// yet still instant for the engine-stopped case — 2026-07-27 review).
// Window-closed loads stay covered by @block; engine-stopped by this.
// !_bl_inflight on ALL FIVE: a handler wedging @block long enough to open
// this gate must never be re-entered concurrently from here.
_bl_gfx_blkseen != _bl_blkctr ? ( _bl_gfx_blkseen = _bl_blkctr; _bl_gfx_tlast = time_precise(); );
time_precise() - _bl_gfx_tlast > 0.5 ? (
  gmem[KIT_GMEM_CMD] == 63 && !kit_busy && !_bl_inflight ? swing_browser_load_pad();
  gmem[KIT_GMEM_CMD] == 64 && !kit_busy && !_bl_inflight ? swing_browser_load_layer();
  gmem[KIT_GMEM_CMD] == 65 && _reg_my_slot == gmem[GS_PENDING_PITCH_INST] && !kit_busy && !_bl_inflight ? swing_pad_audio_swap();  // !kit_busy: defer Tuned bake while a kit-import restore is populating pad buffers (blank-pads race)
  gmem[KIT_GMEM_CMD] == 66 && _reg_my_slot == gmem[GS_PENDING_PITCH_INST] && !kit_busy && !_bl_inflight ? swing_pad_audio_export();  // !kit_busy (Phase 3): 66 writes KIT_GMEM_AUDIO offset 0, where VER-201 stages pad 0 path string
  gmem[KIT_GMEM_CMD] == 67 && _reg_my_slot == gmem[GS_PENDING_PITCH_INST] && !kit_busy && !_bl_inflight ? swing_pad_layer_audio_swap();  // !kit_busy (Phase 3): same shared-band defer as CMD 65
);
// Sync selected pad to gmem — but NEVER while a browse-load command is
// staged. Pre-stall-gate, "dispatch runs above in this frame" made that
// ordering implicit; now @block is the normal consumer, so a CMD 63/64
// written between @gfx frames would have its GS_BROWSE_PAD target STOMPED
// by this sync before @block reads it (2026-07-27 review, critical). The
// one-frame publish latency is harmless — this cell is rewritten every
// frame. Only the active instance writes — otherwise two instances would
// race and the browser would jump between their pad selections.
_is_browser_target() && gmem[KIT_GMEM_CMD] != 63 && gmem[KIT_GMEM_CMD] != 64 ? gmem[GS_BROWSE_PAD] = sel_pad;

// ── Pad FX panel sync: FX-focused pad + its live FX params ────────────────
// Mirrors the GS_BROWSE_PAD write above, for the external Pad FX window.
// Publishes the FX-focused pad (overlay pad if open, else last-selected) and
// that pad's 19 live per-pad FX values, then sets the handshake slot so the
// panel never reads the band mid-switch. Browser-target instance only — same
// gate as GS_BROWSE_PAD, so secondary instances never race the band.
_is_browser_target() ? (
  _fxsp = (overlay_pad >= 0 && overlay_pad < NUM_SLOTS) ? overlay_pad : sel_pad;  // pad-editor index only; big views aren't pads; an absolute pad (step 4a)
  gmem[GS_FX_SEL_PAD] = _fxsp;
  _fxsp >= 0 && _fxsp < NUM_SLOTS ? (
    gmem[GS_FX_PUB_BASE + FX_PID_HPF_FREQ]    = fx_hpf_freq[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_LPF_FREQ]    = fx_lpf_freq[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_RESO]        = fx_reso[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_EQ_LO]       = fx_eq_lo[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_EQ_MID]      = fx_eq_mid[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_EQ_HI]       = fx_eq_hi[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_EQ_LO_FREQ]  = fx_eq_lo_freq[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_EQ_MID_FREQ] = fx_eq_mid_freq[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_EQ_HI_FREQ]  = fx_eq_hi_freq[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_CMP_AMT]     = fx_cmp_amt[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_CMP_MODE]    = fx_cmp_mode[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_BC_RATE]     = fx_bc_rate[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_BC_BITS]     = fx_bc_bits[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_SAT_DRV]     = fx_sat_drv[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_DRV_MODE]    = fx_drv_mode[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_SND_DLY]     = fx_snd_dly[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_SND_RVB]     = fx_snd_rvb[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_EQ_MID2]      = fx_eq_mid2[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_EQ_MID2_FREQ] = fx_eq_mid2_freq[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_EQ_MID_Q]     = fx_eq_mid_q[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_EQ_MID2_Q]    = fx_eq_mid2_q[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_EQ_LO_Q]      = fx_eq_lo_q[_fxsp];
    gmem[GS_FX_PUB_BASE + FX_PID_EQ_HI_Q]      = fx_eq_hi_q[_fxsp];
    // 23..26 are strip-band cells, not pids — publish zeros so the Lua reader
    // (loop 0..GS_FX_PUB_COUNT-1) never crosses stale gmem on its way to 27.
    gmem[GS_FX_PUB_BASE + 23] = 0;
    gmem[GS_FX_PUB_BASE + 24] = 0;
    gmem[GS_FX_PUB_BASE + 25] = 0;
    gmem[GS_FX_PUB_BASE + 26] = 0;
    gmem[GS_FX_PUB_BASE + FX_PID_SND_SMASH]    = fx_snd_smash[_fxsp];
    gmem[GS_FX_PUB_PAD] = _fxsp;
  );
);

// ── Live mute/solo sync to browser ──────────────────────────────────────
// Writes effective-mute state per pad (mute toggle OR muted-by-solo) so
// the browser pad swatches can dim muted pads to match the JSFX UI. Only
// the active browser-target instance writes — otherwise multiple instances
// would race on the same gmem block.
_is_browser_target() ? (
  _pmi = 0;
  loop(NUM_PADS,
    _pmi_s = swing_bp(_pmi);
    gmem[GS_PAD_MUTED_BASE + _pmi] =
      (p_mute[_pmi_s] || (any_solo && !p_solo[_pmi_s])) ? 1 : 0;
    _pmi += 1;
  );
);

// ── Auto-load 808 gate moved to @block (above @sample) so it fires on
//    fresh inserts even when the FX window isn't open yet. The block-
//    side path is functionally identical — same condition, same
//    PENDING_LOAD_INST routing, same _auto_load_attempted flag.

// ── Companion script commands ──────────────────────────────────────────
// Instance-addressed: a nonzero TARGET means the cmd is for that instance
// ONLY — bystanders neither obey nor clear it (it stays pending for the
// target, same hold semantics as kit_busy). 0 = broadcast, legacy writers.
// New Kit (4) is the exception to the hold: it decides at once, by the NEW
// button's rule (swing_new_kit_request, rk_swing_defaults; audit H23, user
// decisions 2026-10-23) -- refused with the busy flash while this Swing loads
// or saves, rather than held and run when this Swing's load ends; at once when
// only another Swing holds the bridge.
_ccmd = gmem[GS_COMPANION_CMD]|0;
_cctgt = gmem[GS_COMPANION_TARGET]|0;
_ccmd > 0 && (!kit_busy || _ccmd == 4) && (_cctgt == 0 || _cctgt == (instance_id|0)) ? (
  _ccmd == 4 ? ( // New kit — full reset (pads + name + FX). See rk_swing_defaults.jsfx-inc.
    swing_new_kit_request(0);
  );
  _ccmd == 5 ? (
    // Adopt MULTI routing for a BRIDGE-initiated multi-out build (CMD 40/74).
    // Swing's own right-click builder calls swing_panels_multiout_prep() before
    // raising CMD 40, so it is already in MULTI when the tracks appear. The
    // action / EON-menu / Song-Starter routes call do_build_multiout() straight
    // from Lua and never ran it — so they built the child tracks with Swing
    // still summing to stereo Out 1, which is the exact failure that prep
    // exists to prevent.
    // ⚠️ Deliberately NOT a call to swing_panels_multiout_prep(): that also
    // seizes KIT_GMEM_LOCK and republishes pad names, which on THIS route the
    // bridge is already doing for itself. Only the two things the bridge cannot
    // do are done here.
    // NO mark_dirty_kit here — USER POLICY 2026-08-11 (diag src=1005 t=0.2s
    // n=0 pinned it): this adopt is the tail of a BUILD action (Song Starter /
    // MATRIX / EON menu), i.e. session routing, not a kit-content edit — and
    // it lit the SAVE dot on every fresh multi-out build (the held-pending 5
    // flips the still-stereo default 0.2s after the 2→32 channel bump; the
    // bump itself re-runs nothing -- measured 2026-10-10, an ext_noinit = 1
    // JSFX through 2 -> 32 -> 48 channels). A later kit SAVE persists multi_out/p_output from
    // live state regardless of the dot, so nothing is lost by staying quiet.
    // (The 2026-08-10 idempotence guard is folded into this: no dirty either way.)
    multi_out = 1;
    _mo_i = 0; loop(NUM_SLOTS, p_output[_mo_i] = swing_out_default(_mo_i); _mo_i += 1;);   // step 2b: bus = position in the bank (a bank-track / split choice stays: every build and Update adopts, Outputs step 2)
  );
  _ccmd == 6 ? (
    // Leave MULTI for a bridge-initiated collapse (CMD 44, Multi-Out -> Wired):
    // the child tracks are gone, so the multi-out routing has nowhere to go.
    // ONLY multi_out is cleared. p_output is deliberately left alone: the
    // bridge flips Wired on in the same breath, Wired's rising edge (@block,
    // immediate) sets p_output[i] = i for the pairs, and this command lands
    // LATER -- it is consumed here in @gfx, which only runs with the window
    // open -- so a reset of p_output would undo the routing Wired just set.
    // In stereo p_output is not consulted at all (bus_idx is 0 regardless).
    // No mark_dirty, for the same reason CMD 5 has none: session routing.
    multi_out = 0;
  );
  _ccmd == 7 ? (
    // Into MULTI for an UPDATE of existing multi-out tracks (CMD 40 -> No): the outputs stay exactly as the user
    // set them. CMD 5's reset to "every pad on its own output" belongs to a fresh build and a Rebuild; an Update
    // used to run it too (the bridge posted 5 before it asked), and undid any pad pointed at another's output.
    // An older Swing ignores 7: the cmd is consumed below like any other. No mark_dirty: session routing.
    multi_out = 1;
  );
  gmem[GS_COMPANION_TARGET] = 0;   // consume the address WITH the cmd (cmd cleared LAST)
  gmem[GS_COMPANION_CMD] = 0;
);

// ── Idle context: a closed instance draws nothing (D O-1; decided 2026-09-15) ──
// options:gfx_idle keeps @gfx ticking with no surface showing: 13 passes/s on
// REAPER 7.79, gfx_ext_flags bit 2 set, a real canvas of the last window size,
// mouse_cap 0 (EON_Probe_Surface S2). Everything a closed instance needs from
// those passes sits ABOVE this point -- the registry heartbeat mirror, the
// undo / name / swap / companion mailboxes, the PADCAT drain, EON_VIEW_REQ and
// EON_POPUP_REQ, the export tick and misc commands, the browser sync, the pitch
// tick and the engine-stall fallback -- and below it there is only drawing and
// the input that drawing carries. So an idle pass skips both branches whole:
// the closed-window cost of an instance is a few gmem writes per pass instead
// of a full floating frame (background, header cluster, LCD page, sixteen pad
// faces with waveforms, the strip and its browser-sync writes). The frame tail
// after the branches still runs, so a pad held when the window closes is
// released on the first idle pass, as before.
// What an idle pass no longer does, each checked: bump the strip's FB_FACE_HB
// (no reader anywhere) or re-post its grow request (the bridge acts on a
// CHANGE of FB_REQ_GROW, and the last value stands); re-aim the FX picker at
// sel_pad (swing_fxview_follow_pad re-publishes on the first window pass,
// before the FX tab draws); reset gfx_lim_gr (one stale GR-meter frame on
// reopen); refresh _dock_gfx_t (so the re-dock hello fires on reopen, which is
// what its comment always assumed); consume _ins_want_wired (it waits for the
// window, where it was raised). The gmem walk over both branches' call graphs
// found no mailbox consume below this point (fix plan 2026-09-14, section 9).
// The first idle pass after a shown one posts the audition's STOP (D-7, decision 7):
// closing the window stops it, as closing the strip does. Idle passes alone never
// post (an instance loaded with its window closed starts idle).
_gfx_idle_now = (gfx_ext_flags & 2) ? 1 : 0;
_gfx_idle_now && !_gfx_idle_prev && _gfx_pass_n > 0 ? fb_prv_cmd = 2;
_gfx_idle_prev = _gfx_idle_now; _gfx_pass_n += 1;
(gfx_ext_flags & 2) ? (
  0;
) :
is_embedded ? (
  // ═══════════════════════════════════════════════════════════════════════
  // EMBEDDED — Maximized 4×4 coloured pad grid with waveforms + note info
  // ═══════════════════════════════════════════════════════════════════════
  // Pad Banks Outputs step 4: the panel's width for the bridge's mixer check (a theme that narrows it once the track
  // passes 38 channels). Only a drawing pass gets here (an idle pass is the branch above).
  _reg_my_slot >= 0 ? (
    gmem[GS_STRIP_BASE + _reg_my_slot * GS_STRIP_STRIDE + GS_STRIP_OFF_EMB_W] = gfx_w;
    gmem[GS_STRIP_BASE + _reg_my_slot * GS_STRIP_STRIDE + GS_STRIP_OFF_EMB_HB] += 1;
  );
  swing_grid_draw_embedded();
  // Browser drag-over highlight, embedded twin of the call in the floating
  // branch below. Deliberately per-branch rather than once after this
  // ternary: the shared point down at the frame tail is AFTER the tooltip,
  // popup and theme overlays paint, so a highlight drawn there would sit on
  // top of modal UI. Must follow the draw — it reuses e_cw/e_ch/e_gap.
  swing_grid_extdrag();

  // ── Hover title bar: the way OUT of the embed ─────────────────────────────
  // Going borderless (0x100) removed the strip REAPER used to draw above the
  // embed, which was the only way to open the floating window. The other EON
  // embeds arm 0x200 (click passthrough) over DEAD SPACE and let a passed-
  // through click do it, but Swing's embed is a full-bleed 4x4 pad grid with
  // no dead space at all — hence @gfx clearing 0x200 by default and capturing
  // everything.
  //
  // ⚠️ This replaces a CTRL+click gesture, which could not work and was
  // removed rather than left in as documented-but-dead. 0x200 is a hint REAPER
  // reads to route the NEXT click, so it must already be armed while the mouse
  // merely HOVERS. Pointer position is delivered to an embedded UI on hover
  // (every other EON embed's hover test depends on that); modifier state is
  // not, so CTRL only became true once the button was already down — a frame
  // too late to affect that click's routing. Position works, modifiers cannot.
  //
  // ⭐ LOOK and CLICK-BAND are deliberately DECOUPLED. The bar reveals over a
  // generous approach zone, but the band that actually takes the click is
  // always exactly the bar's own height. Letting the grab area grow with the
  // fade would make every click near the top a coin toss between "pad" and
  // "open window"; a soft reveal over a hard target is predictable.
  //
  // Cost, accepted deliberately: within that fixed band a click opens the
  // window instead of triggering the pad under it. Nothing is drawn at rest.
  _eb_h = max(9, min(18, (gfx_h * 0.09)|0));
  // Approach zone, clamped: 3x the bar normally, but never more than 45% of a
  // short MCP strip or the "approach" would be the whole embed.
  _eb_zone = max(_eb_h + 1, min(_eb_h * 3, (gfx_h * 0.45)|0));
  _eb_in  = mx >= 0 && mx < gfx_w && my >= 0 && my < gfx_h;
  _eb_hot = _eb_in && my < _eb_h;          // the FIXED armed band
  // Proximity target: 0 at the bottom of the zone, 1 at the top edge.
  _eb_want = _eb_in ? max(0, min(1, (_eb_zone - my) / _eb_zone)) : 0;
  // Eased toward the target rather than tracked pixel-for-pixel, so a jittering
  // hand does not strobe the bar. Same dt/hv_speed the knob hovers ride on.
  _eb_t += (_eb_want - _eb_t) * min(1, dt * hv_speed);

  _eb_t > 0.01 ? (
    // Fill holds off until you are genuinely close (45% of the way in), so at
    // the far edge of the zone all you get is the accent line hinting — no
    // grey slab sitting over the pads.
    _eb_fill = max(0, min(1, (_eb_t - 0.45) * 1.818));
    _eb_fill > 0 ? (
      gfx_set(0.05, 0.06, 0.08, _eb_fill * 0.85);
      gfx_rect(0, 0, gfx_w, _eb_h);
    );
    gfx_set(0.10, 0.70, 0.85, _eb_t * (_eb_hot ? 1.0 : 0.8));
    gfx_rect(0, _eb_h - 1, gfx_w, 1);
    // Label only once the fill is carrying it, and only when the bar is tall
    // enough to seat it without clipping.
    _eb_h >= 12 && _eb_fill > 0.25 ? (
      rk_font(1, max(9, _eb_h - 5), 'b');
      gfx_measurestr("OPEN", _eb_tw, _eb_th);
      _eb_tw < gfx_w - 8 ? (
        gfx_set(0.85, 0.90, 0.95, _eb_fill);
