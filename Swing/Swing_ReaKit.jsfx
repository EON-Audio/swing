  big_view_id == VIEW_REVERB ? swing_panels_draw_fx_big(3) :
  big_view_id == VIEW_COMP ? swing_panels_draw_fx_big(5) :
  big_view_id == VIEW_KITS ? swing_kitsview_draw() :
  big_view_id == VIEW_SYNTH ? swing_synthview_draw() :
  big_view_id == VIEW_FXPICK ? swing_fxview_draw() :
