);

// Draw octave lines
ly=tbh;
notepos=0;
loop(numnotes,
  ly += row_height;
  octavestart = (basenote+(numnotes-1-notepos)) % 12;
  octavestart == 0 ? (
    color(18);
    gfx_x=0.0; gfx_y=ly;
    gfx_lineto(gfx_w,gfx_y,0);
  );
  notepos+=1;
);

// Draw bar lines  
xpos=pkw;
bar=1;
loop(nbars,
  xpos+=barlen;
  color(19);
  gfx_x=xpos+1; gfx_y=tbh;
  gfx_lineto(gfx_x,gfx_h,0);
  bar+=1;
);

ly=tbh;
notepos=0;
loop(numnotes,

  ty=(tbh+((notepos+1)*(grid_bottom-tbh))/(numnotes))|0;

  lx=pkw;
  xpos=0;
  mask = 2^(numnotes-1-notepos);

  cidx=(p&7);
  use_r=(cidx&1) ? 0.6 : 0.2;
  use_g=(cidx&2) ? 0.6 : 0.2;
  use_b=(cidx&4) ? 0.2 : 0.6;
  cidx==3  ? use_r*=2;
  cidx==4 ? use_g*=2;
  // EON: per-lane cell colour (matches the Swing pad). Use the actual MIDI note,
  // and only LOADED pads (with a name) get colour; blank pads stay neutral.
  colorscheme==10 ? (
    eon_lnote = basenote + (numnotes-1-notepos) + notetranspose[numnotes-1-notepos];
    eon_lhue = eon_pad_hue_for_note(eon_lnote);
    eon_haslane = (eon_lhue > -5) && (notenames[eon_lnote] != 0);
    eon_haslane ? (
      eon_lhue <= -1.5 ? (setcolor(120,120,128,255);) :
      eon_lhue < 0 ? (setcolor(210,210,220,255);) :
      (eon_hsl2rgb(eon_lhue, gmem[EON_SW_COL_S], gmem[EON_SW_COL_L]););
      eon_clr = gfx_r; eon_clg = gfx_g; eon_clb = gfx_b;
    );
  );

  
  loop(listlength,
    tx = (((xpos+1)*(gfx_w - pkw))/listlength)+pkw|0;
    sel=(notelist[xpos]&mask);
    // EON: visual swing -- nudge off-beat (odd) cells right on swung lanes, up to half a cell
    eon_swsh = (colorscheme==10 && groove_off_rt[(numnotes-1-notepos)*max_seqlength + xpos] > 0) ? (((groove_off_rt[(numnotes-1-notepos)*max_seqlength + xpos]/tpb) * (tx - lx))|0) : 0;   // EON GROOVE: nudge = the lane's actual per-step offset (any groove shape)

    // draw square
    colorscheme==1 ? (

    gfx_a=1;
    gfx_r=use_r; gfx_g=use_g; gfx_b=use_b;  
    !(xpos % steps_per_beat) ? ( gfx_g=gfx_r; gfx_r=gfx_b; gfx_b=use_g;);
    lbeatpos == xpos ? ( gfx_r=gfx_g=gfx_b=sel?0.8:0.4; ) :
       !sel ? (gfx_r*=0.55; gfx_g*=0.55; gfx_b*=0.55; );

    ):(
    color(21); //selected standard beats 
    (xpos % steps_per_beat) == 0 ? ( 
       color(20); //selected first beat 
    );
    lbeatpos == xpos ? ( // time position color
      sel?(color(22);):(color(23);); 
      ) : !sel ? ( // standard row colour
        (xpos % steps_per_beat) == 0 ? (colorscheme==10 ? (gfx_r=eon_pc24r;gfx_g=eon_pc24g;gfx_b=eon_pc24b;gfx_a=1;):(color(24);)):(colorscheme==10 ? (gfx_r=eon_pc25r;gfx_g=eon_pc25g;gfx_b=eon_pc25b;gfx_a=1;):(color(25);))
      ); 
    );

    curnote=(numnotes-1-notepos)*listlength+xpos;
    num_sd = getSubdivNum(curnote);
    // EON: shade active step cell by velocity (louder = brighter teal; ghost = dim).
    // Applies to normal (non-subdivided) cells only; subdiv cells re-set their own color.
    (colorscheme==10 && sel && lbeatpos != xpos && !num_sd) ? (
      eon_vf = 0.40 + 0.60*(getVelo(curnote)/127);
      eon_haslane ? (
        gfx_r = eon_clr*eon_vf; gfx_g = eon_clg*eon_vf; gfx_b = eon_clb*eon_vf; gfx_a = 1;
      ) : ( // blank pad: neutral grey block (no teal, no colour)
