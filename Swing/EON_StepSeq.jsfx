nn[0] = strcpy(500, "C");
nn[1] = strcpy(501, "C");
nn[2] = strcpy(502, "D");
nn[3] = strcpy(503, "D");
nn[4] = strcpy(504, "E");
nn[5] = strcpy(505, "F");
nn[6] = strcpy(506, "F");
nn[7] = strcpy(507, "G");
nn[8] = strcpy(508, "G");
nn[9] = strcpy(509, "A");
nn[10] = strcpy(510, "A");
nn[11] = strcpy(511, "B");
#name_str="";
notename_digit=0;
nn_filename=1000; // string slot for notename file name
lnotenames_file=-1;
// EON -- Swing gmem slot map (Swing_Media_Transfer); mirrors rk_lua_core core.GMEM.
// Read-only by the live note-name sync in @gfx; no writes to Swing's slots.
EON_SW_ALIVE        = 1711;  // GS_SWING_ALIVE (nonzero = Swing running)
EON_SW_META_BASE    = 100;   // per-pad meta block base
EON_SW_META_PP      = 80;    // floats per pad
EON_SW_NOTE_OFF     = 10;    // MIDI note at META_BASE + pad*META_PP + 10
EON_SW_PADNAME_BASE = 1720;  // per-pad name (ASCII 1-char/slot, 0-terminated)
EON_SW_PADNAME_LEN  = 32;    // stride per pad name
EON_SW_HUE_OFF      = 12;    // per-pad color hue at META_BASE + pad*META_PP + 12
EON_SW_COL_S        = 1432;  // GS_COL_EFFECTIVE_S (theme saturation)
EON_SW_COL_L        = 1433;  // GS_COL_EFFECTIVE_L (theme lightness)
// EON -- unified theme band (published by Swing_Kit_Bridge from rk_lua_theme;
// mirrors rk_lua_core core.GMEM.GS_THEME_*). gmem[GS_THEME_ID] is the generation
// handshake: 0 = nothing published -> keep the hardcoded EON scheme. Else 8
// semantic colours x 3 floats (normalized 0..1 RGB) from GS_THEME_BASE, slot
// order 0 BG,1 PANEL,2 TEXT,3 TEXT_DIM,4 ACCENT,5 ACCENT2,6 GRID,7 BORDER.
GS_THEME_ID         = 2649;  // band 2649..2673 (padfx=2625-2648; StepSeq M/S=2700+)
GS_THEME_BASE       = 2650;
GS_THEME_REQ        = 2674;  // theme selector -> bridge: 0 none; 1 eon,2 dark,3 light,4 reaper
GS_THEME_CUR        = 2675;  // bridge -> selector: active theme index (1..4) for highlight
// EON -- StepSeq -> Swing-bridge publish: per-PAD mute/solo so multi-out tracks mirror
// the lane M/S. Reserved in the free control gap 2674-2999 (padfx 2625-2648,
// theme band 2649-2673; AUDIO_BASE=3000 starts a 4M audio buffer -> MUST stay below it).
EON_SS_ALIVE        = 2700;  // incrementing heartbeat (advancing = StepSeq GUI live)
EON_SS_ANYSOLO      = 2702;  // 1 = at least one lane soloed
EON_SS_MUTE_BASE    = 2710;  // per-pad mute (pad 0..15) -> 2710..2725
EON_SS_SOLO_BASE    = 2730;  // per-pad solo (pad 0..15) -> 2730..2745
GS_SS_PICKER_REQ    = 2750;  // StepSeq -> bridge: 1 = open Swing-pairing picker (bridge reads + resets to 0)
GS_SS_PICKER_SEL    = 2751;  // StepSeq -> bridge: PAIR dropdown selection (1=Auto, slot+2=manual pair); bridge resets to 0
GS_SS_ROSTER_BASE   = 2760;  // bridge -> StepSeq: live Swing roster, 16 slots x 15 floats -> 2760..2999
GS_SS_ROSTER_STRIDE = 15;    //   [0]=live flag, [1..14]=track-name chars (0-padded)
GS_SS_ROSTER_MAX    = 16;    //   == Swing GS_INST_REG_MAX (registry slots)
// EON -- BANDED per-instance mute/solo publish. A PAIRED StepSeq writes its lane M/S
// into its paired Swing's registry-slot band so the bridge mirrors it onto THAT Swing's
// child tracks only (two pairs no longer collide on the global 2700-2745 region, which
// remains the UNPAIRED fallback). Placed in the verified-free identity gap, after the
// PADNAME bands (26,010,000 + 16*512 = 26,018,192 < 26,020,000; ceiling 33,554,432).
EON_SS_MSB_BASE   = 26020000;  // + slot*EON_SS_MSB_STRIDE
EON_SS_MSB_STRIDE = 80;        // [0]=heartbeat, [1]=anysolo, [2..17]=pad mute, [18..33]=pad solo,
                               // [40..55]=REVERSE pad-mute cmd, [56..71]=REVERSE pad-solo cmd
                               // (bridge -> StepSeq when the user edits the child track in the
                               //  TCP: 0=none, 1=set OFF, 2=set ON; consumed by eon_publish_ms)
// EON -- per-instance IDENTITY band (unified single source of truth). Byte-exact
// match to Swing INST_IDENT_* / rk_lua_core core.GMEM. When the bridge pairs this
// StepSeq to a specific Swing instance it pushes that Swing's registry SLOT+1 into
// slider48; eon_pair_slot = slider48-1 (-1 = unpaired -> fall back to the shared
// active-instance META scan). Lane hue/name then read THIS instance's band, so two
// StepSeq+Swing pairs no longer cross-read the single shared blob.
EON_ID_BASE       = 26000000;  // slot*EON_ID_STRIDE + pad*EON_ID_FIELDS + field
EON_ID_STRIDE     = 128;       // 16 pads * 8 fields
EON_ID_FIELDS     = 8;
EON_ID_HUE        = 1;         // == IDENT_OFF_HUE  (-2 sentinel = blank pad)
EON_ID_NOTE       = 4;         // == IDENT_OFF_NOTE
// Kit-categories band (bridge-owned; Spec_Swing_Kit_Categories §7a). Per-pad
// {VER, CAT, SRC, LOCK}; CAT = 46-vocab index (== rk_cat_glyphs ids), -1 =
// uncategorised; VER==0 = never published -> consumers fall back to name match.
EON_PADCAT_BASE   = 26003000;  // slot*EON_PADCAT_STRIDE + pad*4 + field
EON_PADCAT_STRIDE = 64;        // 16 pads * 4 fields
// Write-back mailbox (Steppa icon pick -> bridge sets the PAD's category, ONE
// source of truth): [0]=seq (bumped LAST) [1]=slot [2]=lane NOTE [3]=glyph id
// (-1 = Auto: bridge re-infers from the pad name). 26004500 verified free.
EON_PADCAT_REQ    = 26004500;
// ③ ADAPT band (bridge -> us): after a positional kit load the bridge computes
// the lane PERMUTATION that re-aims patterns at their old jobs. [0]=seq (LAST)
// [1]=slot [2..17]=dst pad for src pad 0..15. We LIGHT the ADAPT chip on a
// non-identity perm for our slot and apply ONLY on click (never automatic).
EON_PADCAT_ADAPT  = 26004600;
EON_ID_MUTE       = 2;         // == IDENT_OFF_MUTE (E-2: paired lanes VIEW the pad state)
EON_ID_SOLO       = 3;         // == IDENT_OFF_SOLO
// E-2 -- inbound command mailboxes on the paired Swing (byte-exact to Swing
// INST_INCMD_* / rk_lua_core core.GMEM). A paired lane-pill click posts a SET
// (absolute 0/1) to the SEQUENCER-ORIGIN cells; this StepSeq is the only
// writer of those cells (the bridge owns 640/672). Payload first, flag LAST;
// flag 2 = the Swing adopt also fires mark_dirty_pad (the click's undo point).
EON_INCMD_BASE     = 26100000;
EON_INCMD_STRIDE   = 1024;
EON_INCMD_SEQ_MUTE = 704;      // + pad*2: [0]=flag, [1]=0/1
EON_INCMD_SEQ_SOLO = 736;      // + pad*2
// Lane VOL/PAN knobs write the pad's gain/pan through the SAME mailbox. Unlike
// the SEQ_MUTE/SEQ_SOLO cells above these are NOT sequencer-origin regions --
// they are the shared GAIN/PAN cells the SFZ importer and browser also use, so
// a knob drag and an import can in principle race. That is acceptable and
// self-correcting: both are absolute SETs, the flag is consumed per block, and
// the loser is simply overwritten by the next drag frame. Do NOT convert these
// to toggle semantics for the same reason.
EON_INCMD_GAIN     = 896;      // + pad*2: [0]=flag, [1]=linear gain 0..8
EON_INCMD_PAN      = 928;      // + pad*2: [0]=flag, [1]=pan -1..1
EON_IDNAME_BASE   = 26010000;  // slot*EON_IDNAME_STRIDE + pad*32 chars (0-term)
EON_IDNAME_STRIDE = 512;       // 16 pads * 32
// Per-instance pad MIX band (Swing-owned publisher, we only READ). Byte-exact
// to Swing INST_PADMIX_*. This is what lets a lane knob rest on the pad's real
// value instead of a guess -- without it the knobs would be write-only and
// would lie about current state whenever the pad was changed from Swing's side.
EON_SW_PADMIX_BASE   = 26019000;  // + slot*EON_SW_PADMIX_STRIDE + pad*2
EON_SW_PADMIX_STRIDE = 48;        // 16 pads * 2 fields, then the knob-appearance tail
EON_SW_PADMIX_GAIN   = 0;         // linear gain; knob runs 0..2 like Swing's own
EON_SW_PADMIX_PAN    = 1;         // -1..1
// Knob appearance tail — the paired Swing's four hidden knob sliders. Steppa runs
// the SAME resolution chain against them (see ss_knob_colors) so the lane knobs
// are the same knob Swing draws, including any style/colour the user picked there.
EON_SW_PADMIX_VSTYLE = 32;
EON_SW_PADMIX_VAPPR  = 33;
EON_SW_PADMIX_PSTYLE = 34;
EON_SW_PADMIX_PAPPR  = 35;
// P3b-4b region-NAME band (courier -> StepSeq): 8 windowed names (the visible
// pattern-row page, name i = region ordinal PAGE+1+i) x 32 chars 0-terminated,
// then the SELECTED ordinal's name at +256 (independent of the window so a
// selection off the visible page still resolves). Keyed by SYNC fields
// NAMEPAGE/NAMESEL (42/43). Verified-free gap: above the M/S band end
// (26021280), below the SYNC band (26030000). 16 slots x 320 -> ..26027119.
EON_SS_RGNNAME_BASE   = 26022000;  // + slot*EON_SS_RGNNAME_STRIDE
EON_SS_RGNNAME_STRIDE = 320;
EON_SS_RGNNAME_SEL    = 256;       // offset of the SELECTED-name sub-band
// P3b-4c SONG band (courier -> StepSeq): the project-global song chain
// (pattern_song.lua, ExtState EON_DRUM_MATRIX:song) snapshot, published per
// SYNCON slot. Header: +0 GEN (monotonic, bumped LAST after a full rewrite)
// +1 LEN (cap 32) +2 PLAYING +3 CURENT (1-based playing entry, 0=none)
// +4 LOOP. Entries at +8 + e*2: [0] = ordinal + repeats*256 (ordinal = 1-based
// position in the start-sorted region list), [1] = packed colour r*65536+g*256+b.
// 16 slots x 112 -> ..26029791, still below the SYNC band (26030000).
EON_SS_SONG_BASE      = 26028000;  // + slot*EON_SS_SONG_STRIDE
EON_SS_SONG_STRIDE    = 112;
EON_SS_SONG_MAX       = 32;        // entry cap (mirrors the bridge publisher)
// P3b-4e: per-ENTRY names for the song chips. A chain entry can reference an
// OFF-PAGE ordinal, so the page-windowed RGNNAME band can't serve the strip —
// the bridge writes each entry's region name here (chars BEFORE the SONG band's
// GEN bump, payload-first) whenever it republishes the chain. 32 entries x 16
// chars 0-term per slot. Above the INCMD mailboxes' end (26100000 + 16*1024 =
// ..26116383); grep-verified free 2026-07-02.
EON_SS_SONGNAME_BASE   = 26120000;  // + slot*EON_SS_SONGNAME_STRIDE + entry*16
EON_SS_SONGNAME_STRIDE = 512;
// EON -- StepSeq SYNC-MODE band (Phase 0 reservation; see plan "two views of one
// pattern"). A paired, sync-enabled StepSeq and the Drum Matrix exchange a
// per-bound-pattern revision + origin tag here so neither editor re-consumes its
// own change (feedback-safe). Verified-free gap: above the M/S band
// (26020000 + 16*80 = 26021280) and below the INCMD mailboxes (26100000).
EON_SS_SYNC_BASE    = 26030000;  // + slot*EON_SS_SYNC_STRIDE
EON_SS_SYNC_STRIDE  = 64;
EON_SS_SYNC_EPOCH    = 0;        // ss_edit_epoch  (StepSeq bumps per grid edit)
EON_SS_SYNC_DIGEST   = 1;        // ss_grid_digest
EON_SS_SYNC_DMREV    = 2;        // dm_rev (monotonic per bound region; either side bumps)
EON_SS_SYNC_ORIGIN   = 3;        // origin_tag: 0 none, 1 DM, 2 StepSeq
EON_SS_SYNC_UID_LO   = 4;        // bound_region_uid lo
EON_SS_SYNC_UID_HI   = 5;        // bound_region_uid hi
EON_SS_SYNC_EXPORTREQ= 6;        // ss_export_req
EON_SS_SYNC_EXPORTACK= 7;        // ss_export_ack
EON_SS_SYNC_DMPUSH   = 8;        // dm_push_seq (courier bumps -> StepSeq imports the staged grid)
// StepSeq publishes its active-pattern shape so a courier can build a matching grid:
EON_SS_SYNC_SS_LISTLEN = 9;      // StepSeq -> courier: active pattern listlength
EON_SS_SYNC_SS_SPB     = 10;     // StepSeq -> courier: active pattern steps_per_beat
EON_SS_SYNC_SS_SYNCON  = 11;     // StepSeq -> courier: 1 while Sync Mode on + paired
// Region-pick policy (which DM region a pattern syncs against). AUTO = active
// pattern index -> the (patidx+1)th region by start time; a per-pattern override
// pins a specific region ordinal instead. Fields live in the unused tail of the
// 64-wide SYNC stride (12..63 free).
EON_SS_SYNC_SS_PATIDX  = 12;     // StepSeq -> courier: active pattern index (0-based) for AUTO mapping
EON_SS_SYNC_SS_RGNSEL  = 13;     // StepSeq -> courier: region override (0 = Auto, k>=1 = pin to ordinal k)
EON_SS_SYNC_DM_RGNCNT  = 14;     // courier -> StepSeq: DM region count (picker max; 0 = unknown/none)
EON_SS_SYNC_SEED_REQ   = 21;     // courier -> StepSeq: region was EMPTY on engage -> please export (seed it from the grid)
EON_SS_SYNC_DM_PATSET  = 15;     // courier -> StepSeq: switch to this pattern index (a DM pattern was clicked)
EON_SS_SYNC_DM_PATSEQ  = 20;     // courier -> StepSeq: monotonic bump = consume DM_PATSET (edge-detect)
EON_SS_SYNC_NEW_REQ    = 16;     // StepSeq -> courier: monotonic bump = "+" clicked, create a new region/pattern
EON_SS_SYNC_REN_REQ    = 17;     // StepSeq -> courier: monotonic bump = RENAME region (1-based ordinal in OP_ORD; bridge opens the dialog)
EON_SS_SYNC_OP_ORD     = 18;     // StepSeq -> courier: ordinal payload for REN/DEL (written BEFORE the counter bump)
EON_SS_SYNC_DEL_REQ    = 19;     // StepSeq -> courier: monotonic bump = DELETE region (ordinal in OP_ORD; bridge confirms first)
EON_SS_SYNC_COL_REQ    = 54;     // StepSeq -> courier: monotonic bump = CHANGE COLOR of region (ordinal in OP_ORD;
                                 // bridge opens the native picker). 54 because 20/21/22.. are taken and field 52
                                 // is GS_SSWIN_OPEN (see warning below) — next truly free field after OPT_AA=53.
EON_SS_SYNC_RGNCOL     = 22;     // courier -> StepSeq: + i -> packed colour (r*65536+g*256+b) of region ordinal PAGE+1+i; fields 22..37
EON_SS_SYNC_OPENSW_REQ = 38;     // StepSeq -> courier: monotonic bump = TOGGLE this slot's paired Swing FX window
EON_SS_SYNC_SWING_OPEN = 39;     // courier -> StepSeq: 1 if the paired Swing's FX window is open (button highlight)
EON_SS_SYNC_SS_PAGE    = 40;     // StepSeq -> courier: pattern-row page BASE ordinal offset (page*8); makes 22..37 a window
EON_SS_SYNC_SS_SELORD  = 41;     // StepSeq -> courier: ABSOLUTE selected region ordinal (1-based; 0 = unset -> courier uses PATIDX)
// P3b-4b region NAMES. The courier mirrors region names into a per-slot char band
// (below) windowed by SS_PAGE, chars-first-key-last like REN/DEL. NAMEPAGE carries
// (page base + 1) the window was written FOR: trust the window only when it equals
// eon_pat_base+1 (0 = old bridge / never written -> draw nothing, not garbage).
// NAMESEL likewise keys the SELECTED-name sub-band to an ordinal, so the selected
// pattern's name survives paging away from its window.
EON_SS_SYNC_NAMEPAGE   = 42;     // courier -> StepSeq: page base+1 the name window describes (0 = unset)
EON_SS_SYNC_NAMESEL    = 43;     // courier -> StepSeq: ordinal whose name fills the SEL sub-band (0 = unset)
// P3b-4c SONG strip commands (StepSeq -> courier). One command per gesture,
// payload-first-bump-last: write A1/A2, then OP, then bump REQ (the bridge
// edge-detects REQ). The JSFX never owns chain state — it renders whatever the
// bridge last published into the SONG band below, so edits can't echo.
// opcodes: 1=APPEND(A1=ordinal) 2=REMOVE(A1=pos) 3=REORDER(A1=from,A2=to)
//          4=SET_REPEATS(A1=pos,A2=n) 5=PLAY 6=STOP 7=TOGGLE_LOOP 8=CLEAR
//          9=COMMIT (stamp the chain to the timeline at the edit cursor)
//          10=ZOOM_SONG (fit the arrange to the whole song, pattern_regions.ZoomToSong)
//          11=ZOOM_PATTERN (A1 = pattern ordinal; frame that pattern's region)
// PLAY/LOOP are DAW-SYNCED: the published PLAYING = the transport state (any
// source) and LOOP = the transport REPEAT (engine parks native repeat during
// song playback, holding the intent) — the cells mirror REAPER's own buttons.
EON_SS_SYNC_SONG_OP    = 44;     // StepSeq -> courier: opcode
EON_SS_SYNC_SONG_A1    = 45;     // StepSeq -> courier: arg 1
EON_SS_SYNC_SONG_A2    = 46;     // StepSeq -> courier: arg 2
EON_SS_SYNC_SONG_REQ   = 47;     // StepSeq -> courier: monotonic counter (edge-detected)
EON_SS_SYNC_RGNQN      = 48;     // courier -> StepSeq: bound region length in QN (0 = no region; P3b-5a length-follow)
// SETTINGS option mirror (machine-global; canonical store = bridge ExtState
// EON_StepSeq/autozoom_select + sync_on_open, "0" = off, unset = on). The
// panel toggles write the values + bump REQ; the bridge persists the bump and
// republishes the canonical values every tick, so all instances agree.
EON_SS_SYNC_OPT_AZ     = 49;     // both ways: "Zoom on select" (auto-frame a pattern's region on select)
EON_SS_SYNC_OPT_SO     = 50;     // both ways: "Sync on by default" (slider49 defaults On; the bridge enforces an explicit Off on first pairing)
EON_SS_SYNC_OPT_REQ    = 51;     // StepSeq -> courier: option-set request counter (edge-detected)
// ⚠️ field 52 = GS_SSWIN_OPEN (bridge seq-window heartbeat, Swing_ReaKit.jsfx) — NOT free, do not reuse.
EON_SS_SYNC_OPT_AA     = 53;     // both ways: "Auto-adapt patterns" (③ apply the kit-load lane perm automatically,
                                 // no chip). DEFAULT OFF — canonical ExtState EON_StepSeq/auto_adapt, "1" = on
                                 // (INVERTED vs AZ/SO above, which default on via the unset-means-on idiom).
// Shared transfer buffer (single, owner-tagged) for one pattern's note grid. In
// the verified-free gap above the SYNC band (..26031023), below INCMD (26100000).
// header [0]=owner_slot [1]=seq [2]=numpads [3]=numsteps [4]=steps_per_beat;
// data: pad p, step s velocity at EON_SS_XFER_DATA + p*numsteps + s (0 = no note).
EON_SS_XFER_BASE   = 26040000;
EON_SS_XFER_DATA   = 26040008;
// P3b-5b RATCHET band (parallel to DATA): per cell p,s holds packed subdivision info
// = sdnum | (subdivnotelist << 4). sdnum = getSubdivNum (0 = no subdiv); the cell plays
// sdnum+1 evenly-spaced sub-hits across the step, bit k of the mask = sub-position k on.
// The bridge expands a subdivided cell into N+1-spaced MIDI notes on export. Sits clear
// of DATA (16 x max_seqlength=64 = 1024 -> ..26041031) and below INCMD (26100000).
EON_SS_XFER_SUBDIV = 26042000;
// P3b-5b sub-hit VELOCITY band (parallel to SUBDIV, but 8 slots per cell): velocity
// of sub-hit k at EON_SS_XFER_SUBVEL + (p*numsteps + s)*8 + k; 0 = unset -> the
// consumer falls back to the cell velocity. 16 x max_seqlength=64 cells x 8 = 8192
// -> ..26138191, above the SONGNAME band's end (..26128191); grep-verified free
// (bundle + Extension repo) 2026-07-02.
EON_SS_XFER_SUBVEL = 26130000;
// EON Apply band (AP-1): the custom "apply preset to the ACTIVE pattern" path. Unlike
// the sync XFER above (PAD-keyed, sync-gated), this is ROW-keyed (StepSeq-native rows,
// like a native preset load) and consumed UNGATED so it works standalone. The bridge
// stages one stored grid here + bumps applyreq_seq; the targeted instance drops it into
// the active pattern. Single shared band, owner-tagged (one apply per user action).
// Clear of SUBDIV (16 x max_seqlength=64 = ..26043023) and below INCMD (26100000).
// header [0]=target_slot [1]=applyreq_seq [2]=numrows [3]=numsteps [4]=steps_per_beat
//        [5]=subdiv-list stamp (== [1] when the staging bridge also wrote the sparse
//        SUBDIV list; an old bridge never writes [5] -> the list is ignored);
// data: row r, step s velocity at EON_SS_APPLY_DATA + r*numsteps + s (0 = no note).
// subdivs (AP-0b): sparse ratchet list after the 16x16 vel plane at EON_SS_APPLY_SD:
//   [0]=count (<=72), then stride 10 per ratchet: cellindex(row*numsteps+step), K(2..8),
//   v0..v7. Fits the band: 26044264 + 1 + 72*10 = 26044985 < PCTRL 26045000.
EON_SS_APPLY_BASE  = 26044000;
EON_SS_APPLY_DATA  = 26044008;
EON_SS_APPLY_SD    = 26044264;   // = APPLY_DATA + 16*16 (after the vel plane)
// EON Preset-control band (AP-2): the in-window "Preset <- name ->" scroll strip talks to
// the bridge here, per-slot (addressed like APPLY by _apply_self: paired slot, else 0).
// +0 NAV_SEQ (SS->bridge, bumped per wheel/arrow) +1 NAV_DIR (-1/+1) +2 CUR_IDX
// +3 COUNT (bridge->SS, for display) +16.. NAME chars (bridge->SS, null-terminated ASCII).
EON_SS_PCTRL_BASE   = 26045000;
EON_SS_PCTRL_STRIDE = 64;
// EON Browser-launch mailbox (AP-4): right-clicking the Preset strip asks the (always-on)
// bridge to open the ReaImGui browser. OPEN_REQ is bumped by the JSFX; SLOT carries which
// instance to target so the panel opens on the right slot. Above the 16-slot PCTRL band.
EON_SS_BROWSER_OPEN_REQ = 26046100;
EON_SS_BROWSER_ALIVE    = 26046101;  // browser -> everyone: time_precise heartbeat (fresh = a browser is open)
EON_SS_BROWSER_SLOT     = 26046102;
EON_SS_DM_OPEN_REQ      = 26046200;  // StepSeq -> courier (GLOBAL): bump = TOGGLE the Drum Matrix overlay
EON_SS_DM_OPEN_STATE    = 26046201;  // courier -> StepSeq (GLOBAL): 1 if the DM overlay is open (button highlight)
// EON GROOVE mailbox (bridge -> StepSeq): stages one imported groove template into a USER
// slot (9..15). Single shared band, slot-addressed like APPLY; consumed on seq edge, then
// the slot content lives in @serialize (the bridge is NOT needed at project reload).
// Sits above the SUBVEL band's end (..26138191); grep-verified free (bundle sources) 2026-07-03.
// header: [0]=target_slot [1]=groovereq_seq [2]=user_slot 0..6 [3]=n_steps [4]=flags [5..20]=name chars
// data:   [64..127] = 64 tick offsets (0..127, per 16th step), [128..191] = 64 vel amps (0..1)
// launch: [200] = OPEN_REQ (JSFX bumps -> bridge launches the .rgt browser),
//         [201] = browser ALIVE heartbeat (browser-owned), [202] = target StepSeq slot
EON_SS_GROOVE_BASE   = 26140000;
EON_SS_GRV_OPEN_REQ   = 26140200;
EON_SS_GRV_OPEN_SLOT  = 26140202;
EON_SS_GRV_OPEN_USLOT = 26140203;  // suggested USER slot 0..6 (menu's empty-slot click preselects it in the browser)
// USER-slot readback (StepSeq -> browser): raw slots 9..15 republished on every groove
// recompute so the import browser can NAME + EXPORT them (incl. slots restored from a
// saved project). Per-instance: base + inst_slot*STRIDE; [0] = generation bump,
// [1..1120] = 7 x 160 raw slot floats. 26141000 + 16*1200 = ..26160199, verified free.
EON_SS_GRV_PUB_BASE   = 26141000;
EON_SS_GRV_PUB_STRIDE = 1200;
eon_sync_mode     = 0;         // set each frame from slider49; 0 = standalone (no sync behaviour).
                               // slider49 DEFAULTS ON (fresh instances come up armed; sync stays inert
                               // until a Swing pairs, so unpaired = standalone row as before). Saved
                               // projects keep their stored slider value; the bridge enforces an explicit
                               // machine-wide "Sync on by default = Off" on first pairing instead.
eon_sync_last_push = 0;        // last consumed dm_push (import edge-detect)
eon_export_pending = 0;        // @gfx "Export -> DM" click -> @block serializes the grid once
eon_export_seq     = 0;        // monotonic export-request seq (StepSeq -> bridge, EXPORTREQ)
eon_seed_req_last  = 0;        // last seen SEED_REQ (bridge asks us to export-seed an empty region on engage)
eon_preset_loaded  = 0;        // set by @serialize read (preset/project load) -> @block force-exports it to DM (StepSeq wins, no region clobber)
// P3b-1 live SS->DM debounce/echo state (runtime only, not serialized):
eon_sync_last_exp_digest = -1; // grid digest last EXPORTED (don't re-export an unchanged grid)
eon_sync_prev_digest     = -1; // grid digest last @block (settle detector)
eon_sync_settle          = 0;  // seconds the digest has been stable (gesture-end debounce)
eon_sync_last_p          = -1; // active pattern last @block (suppress export on a pattern switch)
eon_sync_just_imported   = 0;  // set right after an import -> next @block re-baselines (no echo export)
eon_apply_last           = 0;  // AP-1: last consumed applyreq_seq (apply-band edge-detect; per-instance)
eon_apply_primed         = 0;  // AP-1: 0 until first @block baselines applyreq -> a new instance opens BLANK
eon_pnav_seq             = 0;  // AP-2: our monotonic preset-nav request counter (bumped per wheel/arrow)
eon_apply_dirty          = 0;  // AP-4: an apply changed the grid -> arm a settle-debounced undo capture
eon_apply_settle         = 0;  // AP-4: seconds since the last apply (gesture-end debounce)
eon_pat_flash            = 0;  // AP-4: pattern-select flash 1->0 (decays each @gfx frame)
eon_pat_flash_p          = -1; // AP-4: which pattern index is currently flashing
eon_pat_big              = 0;  // AP-4: 1 while redrawing the selected pattern button enlarged (2nd pass)
eon_dm_patseq_last       = 0;  // DM->SS: last consumed DM_PATSEQ (a clicked DM pattern switches us)
// (request counters live IN gmem now -- read-modify-write at the emit sites;
//  an instance-local counter restarts at 0 on reload and stops edging)
eon_opensw_seq           = 0;  // SETTINGS "Open Swing" request counter
eon_dmopen_seq           = 0;  // SETTINGS "Drum Matrix" request counter
eon_pair_slot     = -1;        // set each @gfx frame from slider48; -1 = unpaired
max_notename_length=4; //Number of characters in note name. This controls the notename field width in GUI.
max_subdivs=8;
sdlist_p=0; // sdlist location of current pattern
tb_pianokey_end=10*(7*4+5*3+2)+5*4+3*3+1;

//initialize all patterns to same length,steps per beat, midi channels
// EON serialize-safety: run-once. These tables are blob-serialized (@serialize
// memcpy's listlength_pat/steps_per_beat_pat/rowchannel), and a samplerate change
// re-runs @init but NOT @serialize -- an unguarded re-seed here reset every
// pattern to 16 steps / 4 spb / channel 0, and the NEXT save then truncated the
// sequence to those lengths for good. Fresh memory is all-zero, so first load
// behaves exactly as before.
eon_patseed_inited == 0 ? (
  memset(listlength_pat, listlength, npatterns);
  memset(steps_per_beat_pat, steps_per_beat, npatterns);
  memset(rowchannel, 0, max_numnotes);
  listlength_all=listlength*npatterns;
  eon_patseed_inited = 1;
);

// Set note velocity value to bits (7:0)
function setVelo(note, velo)
(
  velolist[note] &= 0xFFFFFF80; //clear old
  velolist[note] += velo; //set new
);

// Get note velocity value from bits (7:0)
function getVelo(note)
(
  velolist[note] & 0x7F;
);

// EON GROOVE: scale a played velocity by the lane/step accent multiplier -- at SEND time
// only (stored velocities never mutate). amp==1 is an exact identity ((v*1.0)|0 == v,
// including v==0 for legacy velo-0 subdiv hits), so slot-0/classic lanes are byte-identical.
function grv_velo(v, row, step) local(pv)
(
  pv = (v * groove_amp_rt[row*max_seqlength + step])|0;
  pv > 127 ? pv = 127;
  pv < 1 && v > 0 ? pv = 1;    // accents never turn a real hit into a velo-0 note-off
  pv;
);

// EON GROOVE: copy a groove slot's name (plugin memory chars, NOT gmem) into dest.
// Same char-loop shape as eon_roster_label.
function grv_name(dest, slot, maxc) local(b, i, c)
(
  strcpy(dest, "");
  b = groove_slots + slot*GROOVE_STRIDE + 128;
  i = 0; c = b[0];
  while(i < maxc && c > 0 && c < 256) (
    sprintf(#grv_ch, "%c", c);
    strcat(dest, #grv_ch);
    i += 1;
    c = i < 16 ? b[i] : 0;
  );
  dest;
);

// EON GROOVE: builtin-slot builders (called from @init below -- deterministic content,
// safe to rebuild on a samplerate re-init). grv_mk zeroes offsets, sets amps to 1,
// writes the name + template length + loaded flag; callers then poke the shape in.
function grv_setname(slot, str) local(b, l, i)
(
  b = groove_slots + slot*GROOVE_STRIDE + 128;
  l = strlen(str); l > 15 ? l = 15;
  i = 0; loop(l, b[i] = str_getchar(str, i); i += 1;);
  b[l] = 0;
);
function grv_mk(slot, str, len) local(b, i)
(
  b = groove_slots + slot*GROOVE_STRIDE;
  i = 0; loop(64, b[i] = 0; b[64+i] = 1; i += 1;);
  grv_setname(slot, str);
  b[144] = len;
  b[145] = 1;
);

// ── Builtin groove bank (shapes; the strength wheel supplies the amount) ──
// Tick values from .refs/groove_bank_research_2026-07-03.md. Slot 0 (SWING) content is
// never read -- the recompute special-cases it to the frozen legacy expression.
grv_mk(1, "8THS", 4);        // swing the 2nd 8th of each beat (both 16ths of the pair)
groove_slots[GROOVE_STRIDE + 2] = 127; groove_slots[GROOVE_STRIDE + 3] = 127;
grv_mk(2, "DRAG", 1);        // uniform lane lag (Dilla kick/snare) -- 100% = half a step
groove_slots[2*GROOVE_STRIDE + 0] = 64;
grv_mk(3, "LATEBK", 16);     // late backbeat: steps 5 + 13 of a 16-step bar drag
groove_slots[3*GROOVE_STRIDE + 4] = 64; groove_slots[3*GROOVE_STRIDE + 12] = 64;
grv_mk(4, "OFF8", 4);        // off-8ths ride late (laid-back offbeats)
groove_slots[4*GROOVE_STRIDE + 2] = 64;
grv_mk(5, "DIRT", 16);       // MPC60-style: classic swing + deterministic per-step jitter (~3 ticks, melodiefabriek)
grv_db = groove_slots + 5*GROOVE_STRIDE;
grv_db[0]=1;  grv_db[1]=62;  grv_db[2]=2;  grv_db[3]=64;
grv_db[4]=0;  grv_db[5]=66;  grv_db[6]=0;  grv_db[7]=65;
grv_db[8]=0;  grv_db[9]=66;  grv_db[10]=1; grv_db[11]=65;
grv_db[12]=2; grv_db[13]=62; grv_db[14]=0; grv_db[15]=65;
grv_mk(6, "ACC DN", 4);      // velocity only: downbeat accent shape (needs Vel accent > 0)
groove_slots[6*GROOVE_STRIDE + 64] = 1; groove_slots[6*GROOVE_STRIDE + 65] = 0.75;
groove_slots[6*GROOVE_STRIDE + 66] = 0.85; groove_slots[6*GROOVE_STRIDE + 67] = 0.75;
grv_mk(7, "ACC OFF", 4);     // velocity only: offbeat-hat accent shape
groove_slots[7*GROOVE_STRIDE + 64] = 0.7; groove_slots[7*GROOVE_STRIDE + 66] = 0.7;
grv_mk(8, "SW16+", 2);       // EXTENDED 16th swing: strength 100 = Linn ~99.6% (classic caps at 75%)
groove_slots[8*GROOVE_STRIDE + 1] = 127;

// ── Ladder snaps: named machine swing values -> Classic Swing (or SW16+ past 75%) at
// the right strength. strength = (linn% - 50) x 4 (classic) / desired_ticks/127 x 100 (SW16+).
// Values from .refs/groove_bank_research_2026-07-03.md (Linn interview, SP-1200/Korg ladders).
function grv_snap_set(i, mach, pct, slot, strv)
(
  grv_snaps[i*4] = mach; grv_snaps[i*4+1] = pct; grv_snaps[i*4+2] = slot; grv_snaps[i*4+3] = strv;
);
// Curated to 5 genuinely distinct feels (user 2026-07-03): every other historical notch
// is a wheel-nudge from one of these. machine ids: 0=MPC 1=SP-1200 2=Korg DDD-1 3=Triplet.
grv_snap_n = 5;
grv_snap_set(0, 0, 54, 0, 16);    // MPC 54% -- "loosen without sounding swung" (Linn)
grv_snap_set(1, 0, 62, 0, 48);    // MPC 62% -- Linn's ~90BPM head-nod sweet spot
grv_snap_set(2, 3, 66, 0, 67);    // Triplet 66.7% -- the mathematical shuffle anchor
grv_snap_set(3, 1, 71, 0, 84);    // SP-1200 71% -- heavy, near-drunk
grv_snap_set(4, 2, 88, 8, 77);    // Korg DDD-1 88% -- extreme, via the SW16+ template (past the classic 75% cap)

// Set note start offset to bits (15:8)
function setStart(note, start)
(
  velolist[note] &= 0xFFFF00FF; //clear old
  velolist[note] += (start << 8); //set new
);

// Get note start value from bits (15:8)
function getStart(note)
(
  (velolist[note] & 0x0000FF00) >> 8;
);

// Set number of subdivs to bits (19:16)
function setSubdivNum(note, num)
(
  velolist[note] &= 0xFFF0FFFF; //clear old
  velolist[note] += (num << 16); //set new
);

// Get number of subdivs from bits (19:16)
function getSubdivNum(note)
(
  (velolist[note] & 0x000F0000) >> 16;
);

function setSubdivVelo(row, step, sd_pos, velo)
(
  sdlist[sdlist_p+row*max_seqlength*max_subdivs+step*max_subdivs+sd_pos] &= 0xFFFFFF80; //clear old
  sdlist[sdlist_p+row*max_seqlength*max_subdivs+step*max_subdivs+sd_pos] += velo;
);

function getSubdivVelo(row, step, sd_pos)
(
  sdlist[sdlist_p+row*max_seqlength*max_subdivs+step*max_subdivs+sd_pos] & 0x7F;
);

// Set subdiv notelist indicating which subdiv steps are enabled
function setSubdivNotelist(row, step, notes)
(
  sdlist[sdlist_p+row*max_seqlength*max_subdivs+step*max_subdivs] &= 0xFF00FFFF; //clear old
  sdlist[sdlist_p+row*max_seqlength*max_subdivs+step*max_subdivs] += (notes << 16); //set new
  
);

// Get subdiv notelist indicating which subdiv steps are enabled
function getSubdivNotelist(row, step)
(
  (sdlist[sdlist_p+row*max_seqlength*max_subdivs+step*max_subdivs] & 0x00FF0000) >> 16;
);

// Get CC value from source's bit field indicated by ccpos
function getCc(source, ccpos) local(val)
(
  val = 0;
  ccpos == 0 ? val = source & 0xFF;
  ccpos == 1 ? val = (source & 0x0000FF00) >> 8;
  ccpos == 2 ? val = (source & 0x00FF0000) >> 16;
  ccpos == 3 ? (
    source & 0x80000000 ? ( // bit 31 = 1
      val = ((source & 0x7F000000) >> 24) + 0x80;
    ) : (
      val = (source & 0x7F000000) >> 24;
    );
  );
  val;
);

// Set CC value val to target's bit field indicated by ccpos
function setCc(target, ccpos, val)
(
  ccpos == 0 ? (target &= 0xFFFFFF00; target += val;);
  ccpos == 1 ? (target &= 0xFFFF00FF; target += val * 2^8;);
  ccpos == 2 ? (target &= 0xFF00FFFF; target += val * 2^16;);
  ccpos == 3 ? (target &= 0x00FFFFFF; target += val * 2^24;);
  target;
);

// Is the value within valid MIDI value range (7bit)?
function is_midi_val(value) local(valid)  // localized 2026-07-09: dual-thread caller set (scratch-race audit)
(
  valid = 0;
  value >= 0 && value < 128 ? valid = 1;
  valid;
);

// Truncate to valid MIDI value range (7bit).
function trunc_midi_val(value) 
(
  value < 0 ? (
    value = 0;
  ) : (
    value > 127 ? value = 127;
  );
  value;
);

function scale_velobarwidth(seqlen) local(width, gfx_w_l)
(
  width = 2;
  gfx_w == 0 ? gfx_w_l=400+pkw : gfx_w_l=gfx_w;
  seqlen/(gfx_w_l/(400+pkw)) > 65 ? width = 1;
  seqlen/(gfx_w_l/(400+pkw)) < 42 ? width = 3;
  width; // return scaled width
);

// Update flags indicating patterns that are not empty
function update_has_notes() local(p, step, note_found, notelist, cclist)
(
  //has_notes=0;
  notelist=notelist_base;
  cclist=cclist_base;
  p=0;
  loop(npatterns,
    
    note_found=0;
    step=0;
    while(step < listlength_pat[p] && !note_found ? (
        notelist[step] != 0 ? note_found=1;
        cclist[step] != 0 ? note_found=1;
        step+=1;
      );
    );
    note_found ? (has_notes[p]=1;):(has_notes[p]=0;);
    notelist+=listlength_pat[p];
    cclist+=listlength_pat[p];
    p+=1;
  );
);

// Change pattern
function change_pattern(new_p) local(i)
(
  new_p<0 ? new_p=0 : new_p>=npatterns ? new_p=npatterns-1;
  new_p != p ? (eon_pat_flash = 1.0; eon_pat_flash_p = new_p;);   // EON AP-4: arm select-flash
  p=new_p;
  notelist=0;
  velolist=velolist_base;
  i=0;
  loop(p,
    notelist+=listlength_pat[i];
    velolist+=max_numnotes*listlength_pat[i];
    i+=1;
  );
  notetie=notetie_base+notelist;
  cclist=cclist_base+notelist;
  notelist=notelist_base+notelist;
  
  listlength=listlength_pat[p];
  velobarwidth = scale_velobarwidth(listlength);
  steps_per_beat = steps_per_beat_pat[p];
  rateadj = steps_per_beat * rate;
  update_has_notes();
  refresh_tb=1;
  ltiestate = 0; // clear all note ties
  sdlist_p=p*max_numnotes*max_seqlength*max_subdivs;
);

// EON Sync (Phase 1, Import): adopt a courier-staged note grid into the ACTIVE
// pattern. The shared transfer buffer is keyed by PAD (0..15) so it's kit-layout
// agnostic; eon_lane_pad[L] (rebuilt each @block) maps lane L -> pad. We do NOT
// touch listlength (no slab relayout): notes past our grid were already dropped
// by the courier; we clamp defensively and stride the buffer by ITS own numsteps.
// Clears the active pattern (notes/velocities/ties/ratchets) then writes presence
// (2^L bit, matching the engine) + velocity (setVelo) + the cell's ratchet if the
// bridge staged one (P3b-5b: subdiv count/mask from SUBDIV, per-sub-hit velocities
// from SUBVEL). Only ever called from the gated @block trigger, so Sync OFF /
// unpaired = this never runs.
function eon_ss_import_grid() local(np, buf_ns, use_ns, r, s, pad, vel, sd, sdn, bm, k, sv)
(
  np     = gmem[EON_SS_XFER_BASE + 2]|0;          // numpads
  buf_ns = gmem[EON_SS_XFER_BASE + 3]|0;          // numsteps the courier wrote
  use_ns = buf_ns < listlength ? buf_ns : listlength;
  use_ns < 0 ? use_ns = 0;
  // Clear the active pattern's slabs (pointers set by change_pattern).
  memset(notelist, 0, listlength);
  memset(velolist, 0, max_numnotes*listlength);
  memset(notetie,  0, listlength);
  memset(sdlist + sdlist_p, 0, max_numnotes*max_seqlength*max_subdivs);
  r = 0;
  loop(numnotes,
    pad = eon_lane_pad[r];
    (pad >= 0 && pad < np && buf_ns > 0) ? (
      s = 0;
      loop(use_ns,
        vel = gmem[EON_SS_XFER_DATA + pad*buf_ns + s]|0;
        vel > 0 ? (
          notelist[s] += 2^r;                                  // set lane r presence bit
          vel < 1 ? vel = 1 : vel > 127 ? vel = 127;
          setVelo(r*listlength + s, vel);
          // P3b-5b: adopt the cell's ratchet (count + mask + per-sub-hit velocities).
          // The slabs were cleared above, so a cell without subdiv data stays plain.
          sd  = gmem[EON_SS_XFER_SUBDIV + pad*buf_ns + s]|0;
          sdn = sd % 16;
          (sdn > 0 && sdn < max_subdivs) ? (
            setSubdivNum(r*listlength + s, sdn);
            bm = ((sd / 16)|0) & 0xFF;
            setSubdivNotelist(r, s, bm);
            k = 0;
            loop(sdn + 1,
              (bm & (2^k)) ? (
                sv = gmem[EON_SS_XFER_SUBVEL + (pad*buf_ns + s)*8 + k]|0;
                (sv < 1 || sv > 127) ? sv = vel;               // unset -> cell velocity
                setSubdivVelo(r, s, k, sv);
              );
              k += 1;
            );
          );
        );
        s += 1;
      );
    );
    r += 1;
  );
  update_has_notes();
  refresh_tb = 1;
);

// EON Apply (AP-1): drop a stored grid into the ACTIVE pattern. Like eon_ss_import_grid
// but the buffer is ROW-keyed (StepSeq-native row index, exactly how a native preset
// load populates the grid) instead of pad-keyed -- so no live-kit pad remap, and it
// works with NO Swing pairing. Clears the active pattern then writes presence (2^r) +
// velocity. v1 = presence+velocity only (ratchets/ties are the sidecar layer, omitted).
// ── EON LANE OPS: per-lane rewrites of the ACTIVE pattern (lane right-click menu).
// DM parity (Drum Matrix lib/paint_mode.lua lane_tools): clear / fill-every-N /
// shift(rotate) / mirror / randomize / accent / humanize-velocity. Every op ends in
// eon_lane_done() -- the same post-mutation set the DM-apply path uses (has_notes
// refresh + settle-debounced sliderchange = ONE undo point + serialize snapshot).
function eon_lane_done() (
  update_has_notes();
  refresh_tb = 1; refresh_pianokeys = 1;
  eon_apply_dirty = 1; eon_apply_settle = 0;
);
// clear ONE step of lane y: presence bit, ties INTO and OUT OF the step, and the whole
// velolist cell (vel + start offset + subdiv count in one write -> sdlist goes inert).
function eon_lane_clear_step(y, x) local(mask) (
  mask = 2^y;
  (notelist[x] & mask) ? notelist[x] -= mask;
  (notetie[x] & mask) ? notetie[x] -= mask;
  x > 0 && (notetie[x-1] & mask) ? notetie[x-1] -= mask;
  velolist[y*listlength + x] = 0;
);
function eon_lane_clear(y) local(x) (
  x = 0; loop(listlength, eon_lane_clear_step(y, x); x += 1;);
  memset(sdlist + sdlist_p + y*max_seqlength*max_subdivs, 0, max_seqlength*max_subdivs);
);
function eon_lane_fill(y, n) local(x, mask) (
  eon_lane_clear(y);
  mask = 2^y; x = 0;
  loop(listlength,
    (x % n) == 0 ? ( notelist[x] += mask; setVelo(y*listlength + x, lastvelo); );
    x += 1;
  );
);
function eon_lane_random(y, pct) local(x, mask) (
  eon_lane_clear(y);
  mask = 2^y; x = 0;
  loop(listlength,
    rand(100) < pct ? ( notelist[x] += mask; setVelo(y*listlength + x, lastvelo); );
    x += 1;
  );
);
// snapshot lane y into eon_lane_scratch: per step k -> [k*11] presence, +1 whole
// velolist cell (vel+offset+subdivs), +2 tie bit, +3..10 the step's sdlist cells.
function eon_lane_grab(y) local(x, mask, base, k, roff) (
  mask = 2^y; roff = sdlist_p + y*max_seqlength*max_subdivs;
  x = 0;
  loop(listlength,
    base = eon_lane_scratch + x*11;
    base[0] = (notelist[x] & mask) ? 1 : 0;
    base[1] = velolist[y*listlength + x];
    base[2] = (notetie[x] & mask) ? 1 : 0;
    k = 0; loop(max_subdivs, base[3+k] = sdlist[roff + x*max_subdivs + k]; k += 1;);
    x += 1;
  );
);
// write step x of lane y from scratch slot src (presence/velcell/sdlist -- NOT ties;
// tie placement differs between rotate and mirror, callers handle it).
function eon_lane_put(y, x, src) local(mask, base, k, roff) (
  mask = 2^y; roff = sdlist_p + y*max_seqlength*max_subdivs;
  base = eon_lane_scratch + src*11;
  (notelist[x] & mask) ? notelist[x] -= mask;
  base[0] ? notelist[x] += mask;
  velolist[y*listlength + x] = base[1];
  k = 0; loop(max_subdivs, sdlist[roff + x*max_subdivs + k] = base[3+k]; k += 1;);
);
// rotate lane y by dir steps (+1 = right, -1 = left), wrapping. Ties travel with
// their step -- a tie rotated off the end wraps to the loop boundary, which is
// self-consistent (the pattern loops).
function eon_lane_rotate(y, dir) local(x, src, mask) (
  eon_lane_grab(y);
  mask = 2^y; x = 0;
  loop(listlength,
    src = x - dir; src < 0 ? src += listlength; src >= listlength ? src -= listlength;
    eon_lane_put(y, x, src);
    (notetie[x] & mask) ? notetie[x] -= mask;
    eon_lane_scratch[src*11 + 2] ? notetie[x] += mask;
    x += 1;
  );
);
// mirror lane y (x -> listlength-1-x). A tie lives in the GAP between steps, so the
// mirrored tie at x comes from the old gap at listlength-2-x; the last gap drops.
function eon_lane_mirror(y) local(x, mask) (
  eon_lane_grab(y);
  mask = 2^y; x = 0;
  loop(listlength,
    eon_lane_put(y, x, listlength-1-x);
    (notetie[x] & mask) ? notetie[x] -= mask;
    (x < listlength-1 && eon_lane_scratch[(listlength-2-x)*11 + 2]) ? notetie[x] += mask;
    x += 1;
  );
);
function eon_lane_accent(y, n, amt) local(x, mask, v) (
  mask = 2^y; x = 0;
  loop(listlength,
    ((notelist[x] & mask) && (x % n) == 0) ? (
      v = getVelo(y*listlength + x) + amt; v > 127 ? v = 127;
      setVelo(y*listlength + x, v);
    );
    x += 1;
  );
);
function eon_lane_humanize(y, amt) local(x, mask, v) (
  mask = 2^y; x = 0;
  loop(listlength,
    (notelist[x] & mask) ? (
      v = getVelo(y*listlength + x) + ((rand(2*amt + 1))|0) - amt;
      v > 127 ? v = 127; v < 1 ? v = 1;
      setVelo(y*listlength + x, v);
    );
    x += 1;
  );
);

// EON Sync (Export, StepSeq -> DM): serialize the ACTIVE pattern's note grid into
// the shared transfer buffer, PAD-keyed (eon_lane_pad[L] -> pad) exactly like the
// import layout, so the bridge can write it onto the DM region's lanes. Reads
// presence from the engine bitmask (notelist[s] & 2^L) and velocity via getVelo.
// One-shot; only ever called from the gated @block export trigger.
function eon_ss_export_grid() local(r, s, pad, vel, sdn, bm, k, sv)
(
  gmem[EON_SS_XFER_BASE + 0] = _eon_blk_ps;       // owner slot
  gmem[EON_SS_XFER_BASE + 2] = 16;                // numpads
  gmem[EON_SS_XFER_BASE + 3] = listlength;        // numsteps
  gmem[EON_SS_XFER_BASE + 4] = steps_per_beat;
  // zero the 16 x listlength grid + ratchet regions (gmem isn't memset-able; loop it).
  s = 0;
  loop(16 * listlength,
    gmem[EON_SS_XFER_DATA + s] = 0;
    gmem[EON_SS_XFER_SUBDIV + s] = 0;
    k = 0; loop(8, gmem[EON_SS_XFER_SUBVEL + s*8 + k] = 0; k += 1;);
    s += 1;
  );
  // fill: lane r -> pad; presence bit 2^r at notelist[s]; velocity from getVelo. Also
  // carry per-cell subdivision (P3b-5b): sdnum + active-bit mask, so the bridge expands a
  // ratchet into sdnum+1 evenly-spaced notes (matching the @sample subdiv playback).
  r = 0;
  loop(numnotes,
    pad = eon_lane_pad[r];
    (pad >= 0 && pad < 16) ? (
      s = 0;
      loop(listlength,
        (notelist[s] & (2^r)) ? (
          vel = getVelo(r*listlength + s);
          vel < 1 ? vel = 1 : vel > 127 ? vel = 127;
          gmem[EON_SS_XFER_DATA + pad*listlength + s] = vel;
          sdn = getSubdivNum(r*listlength + s);
          sdn > 0 ? (
            bm = getSubdivNotelist(r, s);                 // which sub-positions are on
            gmem[EON_SS_XFER_SUBDIV + pad*listlength + s] = sdn + (bm * 16);   // sdn | (bm<<4)
            // per-sub-hit velocities (P3b-5b): the bridge expansion and a re-import
            // both restore them 1:1 instead of flattening to the cell velocity.
            k = 0;
            loop(sdn + 1,
              (bm & (2^k)) ? (
                sv = getSubdivVelo(r, s, k);
                sv < 1 ? sv = 1 : sv > 127 ? sv = 127;
                gmem[EON_SS_XFER_SUBVEL + (pad*listlength + s)*8 + k] = sv;
              );
              k += 1;
            );
          );
        );
        s += 1;
      );
    );
    r += 1;
  );
);

// EON Sync (P3b-1, live SS->DM): cheap change-digest over the ACTIVE pattern's grid.
// Covers presence (notelist), the FULL velolist word (velocity + start-offset + subdivNum
// bits, so a ratchet-count edit registers) and the active pattern's sdlist (subdiv mask +
// per-subdiv velocities) -- i.e. everything the export now carries (P3b-5b ratchets too).
// Modulo-folded to stay inside double precision; equality collisions are astronomically
// unlikely for real edits. Used by @block to fire a debounced export once a gesture settles.
function eon_grid_digest() local(s, n, acc, r, rb, k)
(
  acc = 0; s = 0;
  loop(listlength, acc = (acc*131 + (notelist[s]|0)) % 2000000011; s += 1;);
  n = numnotes*listlength; s = 0;
  loop(n, acc = (acc*131 + (velolist[s]|0)) % 2000000011; s += 1;);
  // active-pattern subdivisions (ratchets): per row, the listlength*max_subdivs slab.
  r = 0;
  loop(numnotes,
    rb = sdlist_p + r*max_seqlength*max_subdivs;
    k = 0;
    loop(listlength*max_subdivs, acc = (acc*131 + (sdlist[rb + k]|0)) % 2000000011; k += 1;);
    r += 1;
  );
  acc;
);

// Update chain beats
function update_chain_beats() local(i_pat)
(
  chain_beats=listlength_pat[0]/steps_per_beat_pat[0];
  i_pat=1;
  loop(chain,
    chain_beats+=listlength_pat[i_pat]/steps_per_beat_pat[i_pat];
    i_pat+=1;
  );
);

// Change sequence length
function change_seqlen(newsz) local(ip, y, pstart, pstartv, pstart_n, pstartv_n, new_listlength_all)
(
  newsz >= 1 && listlength_pat[p] != newsz ? (
    
    new_listlength_all=listlength_all-listlength_pat[p]+newsz;
    
    newsz < listlength_pat[p] ? ( // decrease size
    
      pstart=0; // old pattern start offset for notes
      pstartv=0; // old pattern start offset for velocities
      pstart_n=0; // new pattern start offset for notes
      pstartv_n=0; // new pattern start offset for velocities
      ip=0; // loop index iterating over patterns
      loop(npatterns,
        memcpy(sparebuf + ip*1024, pstart, listlength_pat[ip]); // save a copy of the full quality notelist
        memcpy(sparebuf_tie + ip*1024, notetie_base+pstart, listlength_pat[ip]); // save a copy of the full quality notetielist 
        memcpy(sparebuf_cc + ip*1024, cclist_base+pstart, listlength_pat[ip]); // save a copy of the full quality notetielist 
        y=0;
        loop(max_numnotes,
          memcpy(sparebuf2 + ip*max_numnotes*max_seqlength+y*max_seqlength, velolist_base+pstartv+y*listlength_pat[ip], listlength_pat[ip]); // save a copy of the full quality
          y+=1;
        );

        ip < p ? (
          memcpy(new_velolist_base+pstartv_n, velolist_base+pstartv, max_numnotes*listlength_pat[ip]);
          pstart_n+=listlength_pat[ip];
          pstartv_n+=max_numnotes*listlength_pat[ip];
        ) : ip == p ? (
          memcpy(pstart_n, pstart, newsz);
          memcpy(notetie_base+pstart_n, notetie_base+pstart, newsz);
          memcpy(cclist_base+pstart_n, cclist_base+pstart, newsz);
          y=0;
          loop(max_numnotes,
            memcpy(new_velolist_base+pstartv_n+y*newsz, velolist_base+pstartv+y*listlength_pat[ip], newsz);
            y+=1;
          );
          pstart_n+=newsz;
          pstartv_n+=max_numnotes*newsz;
        ) : (
          memcpy(pstart_n, pstart, listlength_pat[ip]);
          memcpy(notetie_base+pstart_n, notetie_base+pstart, listlength_pat[ip]);
          memcpy(cclist_base+pstart_n, cclist_base+pstart, listlength_pat[ip]);
          memcpy(new_velolist_base+pstartv_n, velolist_base+pstartv, max_numnotes*listlength_pat[ip]);
          pstart_n+=listlength_pat[ip]; 
          pstartv_n+=max_numnotes*listlength_pat[ip];          
        );
        
        pstart+=listlength_pat[ip];
        pstartv+=max_numnotes*listlength_pat[ip];
        ip+=1;
      ); 
      
    ) : ( // increase size
    
      pstart=listlength_all; // old pattern start offset for notes
      pstartv=max_numnotes*listlength_all; // old pattern start offset for velocities
      pstart_n=new_listlength_all; // new pattern start offset for notes
      pstartv_n=max_numnotes*new_listlength_all; // new pattern start offset for velocities
      
      ip=npatterns-1; // loop index iterating over patterns in reverse order
      loop(npatterns,      
        pstart-=listlength_pat[ip];
        pstartv-=max_numnotes*listlength_pat[ip];
        
        ip < p ? (
          pstart_n-=listlength_pat[ip];
          pstartv_n-=max_numnotes*listlength_pat[ip];
          memcpy(new_velolist_base+pstartv_n, velolist_base+pstartv, max_numnotes*listlength_pat[ip]);
        ) : ip == p ? (
          pstart_n-=newsz;
          pstartv_n-=max_numnotes*newsz;
          y=0;
          loop(max_numnotes,
            memcpy(new_velolist_base+pstartv_n+y*newsz, velolist_base+pstartv+y*listlength_pat[ip], listlength_pat[ip]);
            memcpy(new_velolist_base+pstartv_n+y*newsz+listlength_pat[ip], sparebuf2+ip*max_numnotes*max_seqlength+y*max_seqlength+listlength_pat[ip], newsz-listlength_pat[ip]);
            y+=1;
          );
          memcpy(cclist_base+pstart_n, cclist_base+pstart, listlength_pat[ip]);
          memcpy(cclist_base+pstart_n+listlength_pat[ip], sparebuf_cc+ip*1024+listlength_pat[ip], newsz-listlength_pat[ip]);
          memcpy(notetie_base+pstart_n, notetie_base+pstart, listlength_pat[ip]);
          memcpy(notetie_base+pstart_n+listlength_pat[ip], sparebuf_tie+ip*1024+listlength_pat[ip], newsz-listlength_pat[ip]);
          memcpy(pstart_n, pstart, listlength_pat[ip]);
          memcpy(pstart_n+listlength_pat[ip], sparebuf+ip*1024+listlength_pat[ip], newsz-listlength_pat[ip]);
        ) : (
          pstart_n-=listlength_pat[ip]; 
          pstartv_n-=max_numnotes*listlength_pat[ip]; 
          memcpy(new_velolist_base+pstartv_n, velolist_base+pstartv, max_numnotes*listlength_pat[ip]);
          memcpy(cclist_base+pstart_n, cclist_base+pstart, listlength_pat[ip]);
          memcpy(notetie_base+pstart_n, notetie_base+pstart, listlength_pat[ip]);
          memcpy(pstart_n, pstart, listlength_pat[ip]);
        );
        ip-=1;
      );
    );   
    
    listlength_pat[p] = newsz;
    temp = new_velolist_base;
    new_velolist_base = velolist_base;
    velolist_base = temp;
    
    listlength = newsz; // Update current sequence length
    listlength_all = new_listlength_all;
    //change_pattern(p);
  
    velolist=velolist_base;
    ip=0;
    loop(p,
      velolist+=max_numnotes*listlength_pat[ip];
      ip+=1;
    );
    
    velobarwidth = scale_velobarwidth(listlength);
    
    p <= chain ? update_chain_beats();

  );
);

// (moved BELOW change_seqlen: EEL2 resolves function refs at DEF time,
//  and AP-0c calls change_seqlen — defined above — from this function.)
function eon_ss_apply_grid() local(nr, buf_ns, buf_spb, use_ns, r, s, vel,
                                   sd_n, sd_i, sd_ptr, sd_cell, sd_k, sd_r, sd_s,
                                   sd_v0, sd_base, sd_p, sd_v,
                                   ap_rgnqn, ap_spb, ap_want, ap_geo, sd_rep)
(
  nr      = gmem[EON_SS_APPLY_BASE + 2]|0;         // numrows the bridge wrote
  buf_ns  = gmem[EON_SS_APPLY_BASE + 3]|0;         // numsteps the bridge wrote
  buf_spb = gmem[EON_SS_APPLY_BASE + 4]|0;         // steps_per_beat the bridge wrote
  // P3b-6 TILE (user 2026-08-11): synced with length-follow active, the REGION
  // owns the grid length (the Match rule) — a one-bar preset must LOOP across
  // it, not shrink the grid out from under the region (Song Starter sections
  // are 4-16 bars; presets are authored as ONE bar). Geometry target =
  // floor(region_QN x preset spb + 0.5), the EXACT formula the length-follow
  // block enforces (same clamp), so its next-block recompute is a no-op and
  // the two can never fight. Unsynced (or no region): target = the preset's
  // own length — the original AP-0c adopt, byte-identical.
  ap_spb   = (buf_spb >= 1 && buf_spb <= max_steps_per_beat) ? buf_spb : steps_per_beat;
  ap_rgnqn = (eon_sync_mode && _eon_blk_ps >= 0)
             ? gmem[EON_SS_SYNC_BASE + _eon_blk_ps*EON_SS_SYNC_STRIDE + EON_SS_SYNC_RGNQN] : 0;
  ap_rgnqn > 0 ? (
    ap_geo = floor(ap_rgnqn * ap_spb + 0.5);
    ap_geo < 1 ? ap_geo = 1;
    ap_geo > max_seqlength ? ap_geo = max_seqlength;
  ) : (
    ap_geo = buf_ns;
  );
  // AP-0c: ADOPT the staged grid's geometry so non-16 presets (triplet grid:
  // 12 steps, spb 3) apply with the right feel instead of clamping. Mirrors
  // @slider's resize (change_seqlen repacks + updates listlength/velolist);
  // skipped mid @gfx pattern gesture (same _ui_patop guard as @slider) — the
  // rare race degrades to the old clamp behavior. Sliders are synced via
  // sliderchange (AP-4 pattern) or the next @slider pass would resize back.
  (!_ui_patop && ap_geo >= 1 && ap_geo <= max_seqlength && ap_geo != listlength) ? (
    change_seqlen(ap_geo);
    sliderchange(slider3 = ap_geo);
  );
  (!_ui_patop && buf_spb >= 1 && buf_spb <= max_steps_per_beat && buf_spb != steps_per_beat) ? (
    steps_per_beat = buf_spb;
    steps_per_beat_pat[p] = buf_spb;
    rateadj = steps_per_beat * rate;
    sliderchange(slider9 = buf_spb);
  );
  // Write span: the whole grid when tiling (source column wraps modulo the
  // preset length below); otherwise the original min(preset, grid) clamp.
  use_ns = ap_rgnqn > 0 ? listlength
                        : (buf_ns < listlength ? buf_ns : listlength);
  use_ns < 0 ? use_ns = 0;
  memset(notelist, 0, listlength);
  memset(velolist, 0, max_numnotes*listlength);
  memset(notetie,  0, listlength);
  memset(sdlist + sdlist_p, 0, max_numnotes*max_seqlength*max_subdivs);
  r = 0;
  loop(numnotes,
    (r < nr && buf_ns > 0) ? (
      s = 0;
      loop(use_ns,
        // Source column wraps modulo the preset's length — the TILE. In every
        // non-tile case s < buf_ns, so the modulo is a no-op (original path).
        vel = gmem[EON_SS_APPLY_DATA + r*buf_ns + (s % buf_ns)]|0;
        vel > 0 ? (
          notelist[s] += 2^r;                                  // set lane r presence bit
          setVelo(r*listlength + s, vel > 127 ? 127 : (vel < 1 ? 1 : vel));
        );
        s += 1;
      );
    );
    r += 1;
  );
  // AP-0b: sparse SUBDIV list — the bridge stages ratchet cells after the vel
  // plane. Gated on header[5]==header[1] (the staging bridge stamps both; an
  // OLD bridge never writes [5], so a stale list can't be adopted). Writes the
  // same structures @serialize restores: velolist count bits (K-1)<<16,
  // sdlist[0]=(mask<<16)|v0, sdlist[pos]=vp — so subdiv playback + UI just work.
  gmem[EON_SS_APPLY_BASE + 5] == gmem[EON_SS_APPLY_BASE + 1] ? (
    sd_n = gmem[EON_SS_APPLY_SD]|0;
    sd_n > 72 ? sd_n = 72;
    sd_i = 0;
    loop(sd_n,
      sd_ptr  = EON_SS_APPLY_SD + 1 + sd_i*10;
      sd_cell = gmem[sd_ptr]|0;
      sd_k    = gmem[sd_ptr + 1]|0;
      sd_r    = buf_ns > 0 ? (sd_cell / buf_ns)|0 : 0;
      sd_s    = sd_cell - sd_r*buf_ns;
      (sd_k > 1 && sd_k <= max_subdivs && sd_r < numnotes && sd_s < use_ns && buf_ns > 0) ? (
        sd_v0 = gmem[sd_ptr + 2]|0;
        sd_v0 < 1 ? sd_v0 = 1;
        sd_v0 > 127 ? sd_v0 = 127;
        // P3b-6: replicate the ratchet cell at every tile of the preset. In
        // the non-tile case use_ns <= buf_ns, so the while runs exactly once
        // at sd_rep == sd_s — the original single write.
        sd_rep = sd_s;
        while(sd_rep < use_ns) (
          setVelo(sd_r*listlength + sd_rep, sd_v0);          // low bits = FIRST sub-hit
          velolist[sd_r*listlength + sd_rep] |= (sd_k - 1)*65536;
          sd_base = sdlist_p + sd_r*max_seqlength*max_subdivs + sd_rep*max_subdivs;
          sdlist[sd_base] = (2^sd_k - 1)*65536 + sd_v0;      // mask<<16 | v0
          sd_p = 1;
          loop(sd_k - 1,
            sd_v = gmem[sd_ptr + 2 + sd_p]|0;
            sd_v < 1 ? sd_v = 1;
            sd_v > 127 ? sd_v = 127;
            sdlist[sd_base + sd_p] = sd_v;
            sd_p += 1;
          );
          sd_rep += buf_ns;
        );
      );
      sd_i += 1;
    );
  );
  update_has_notes();
  refresh_tb = 1;
);

// ③ ADAPT: apply the bridge-computed lane permutation to EVERY pattern —
// presence bits, velwords (ratchets ride in the velword+sdlist), subdiv
// cells, ties — plus the global per-lane attrs (swing, groove, mute, solo,
// icon override, midi channel). In-place per pattern via the classic
// inverse-permutation cycle walk; eon_adapt_scratch is the row buffer
// (up to 1408 floats = 128 steps x 11; inv table at +1408, attr temp at
// +1440). @block-ONLY (dispatched by the adapt engine — never call from
// @gfx: the dedicated scratch is what keeps it clear of the @gfx lane ops).
// Rows 16+ (beyond the 16 pads) are untouched. ONE user action = the AP-4
// settle lands one undo point + serialize snapshot.
function eon_adapt_apply()
local(ad_i, ad_p, ad_s, ad_L, ad_nl, ad_tl, ad_vl, ad_sd, ad_inv, ad_buf,
      ad_vis, ad_d0, ad_cur, ad_src, ad_k, ad_bm, ad_sm, ad_sb, ad_db, ad_t)
(
  ad_inv = eon_adapt_scratch + 1408;
  ad_buf = eon_adapt_scratch;
  // review-hardened: the permutation comes from eon_adapt_dst — validated
  // (0..15, strict bijection) and snapshotted/composed at ARM time in @block.
  // The shared band is NEVER read here, so foreign-slot republishes between
  // arm and click cannot swap the mapping under the lit chip.
  ad_i = 0; loop(16, ad_inv[eon_adapt_dst[ad_i]|0] = ad_i; ad_i += 1;);
  // per-pattern packed pointers (the @serialize iteration shape)
  ad_nl = notelist_base; ad_tl = notetie_base; ad_vl = velolist_base;
  ad_p = 0;
  loop(npatterns,
    ad_L  = listlength_pat[ad_p];
    ad_sd = sdlist + ad_p*max_numnotes*max_seqlength*max_subdivs;
    ad_vis = 0;
    ad_d0 = 0;
    loop(16,
      (!(ad_vis & 2^ad_d0) && (ad_inv[ad_d0]|0) != ad_d0) ? (
        // buf = row[d0] (presence, tie, vel, sd8 per step)
        ad_s = 0; loop(ad_L,
          ad_bm = 2^ad_d0;
          ad_buf[ad_s*11 + 0] = (ad_nl[ad_s] & ad_bm) ? 1 : 0;
          ad_buf[ad_s*11 + 1] = (ad_tl[ad_s] & ad_bm) ? 1 : 0;
          ad_buf[ad_s*11 + 2] = ad_vl[ad_d0*ad_L + ad_s];
          ad_k = 0; loop(8,
            ad_buf[ad_s*11 + 3 + ad_k] = ad_sd[ad_d0*max_seqlength*max_subdivs + ad_s*max_subdivs + ad_k];
            ad_k += 1;
          );
          ad_s += 1;
        );
        ad_cur = ad_d0;
        while(
          ad_src = ad_inv[ad_cur]|0;
          ad_vis |= 2^ad_cur;
          ad_src != ad_d0 ? (
            // row[cur] = row[src]
            ad_s = 0; loop(ad_L,
              ad_sb = 2^ad_src; ad_db = 2^ad_cur;
              (ad_nl[ad_s] & ad_sb) ? ( !(ad_nl[ad_s] & ad_db) ? ad_nl[ad_s] += ad_db; )
                                    : ( (ad_nl[ad_s] & ad_db) ? ad_nl[ad_s] -= ad_db; );
              (ad_tl[ad_s] & ad_sb) ? ( !(ad_tl[ad_s] & ad_db) ? ad_tl[ad_s] += ad_db; )
                                    : ( (ad_tl[ad_s] & ad_db) ? ad_tl[ad_s] -= ad_db; );
              ad_vl[ad_cur*ad_L + ad_s] = ad_vl[ad_src*ad_L + ad_s];
              ad_k = 0; loop(8,
                ad_sd[ad_cur*max_seqlength*max_subdivs + ad_s*max_subdivs + ad_k] =
                  ad_sd[ad_src*max_seqlength*max_subdivs + ad_s*max_subdivs + ad_k];
                ad_k += 1;
              );
              ad_s += 1;
            );
            ad_cur = ad_src;
            1;   // continue the cycle
          ) : (
            // row[cur] = buf (the original d0 content closes the cycle)
            ad_s = 0; loop(ad_L,
              ad_db = 2^ad_cur;
              ad_buf[ad_s*11 + 0] > 0.5 ? ( !(ad_nl[ad_s] & ad_db) ? ad_nl[ad_s] += ad_db; )
                                        : ( (ad_nl[ad_s] & ad_db) ? ad_nl[ad_s] -= ad_db; );
              ad_buf[ad_s*11 + 1] > 0.5 ? ( !(ad_tl[ad_s] & ad_db) ? ad_tl[ad_s] += ad_db; )
                                        : ( (ad_tl[ad_s] & ad_db) ? ad_tl[ad_s] -= ad_db; );
              ad_vl[ad_cur*ad_L + ad_s] = ad_buf[ad_s*11 + 2];
              ad_k = 0; loop(8,
                ad_sd[ad_cur*max_seqlength*max_subdivs + ad_s*max_subdivs + ad_k] = ad_buf[ad_s*11 + 3 + ad_k];
                ad_k += 1;
              );
              ad_s += 1;
            );
            0;   // cycle closed
          );
        );
      );
      ad_d0 += 1;
    );
    ad_nl += ad_L; ad_tl += ad_L; ad_vl += ad_L*max_numnotes;
    ad_p += 1;
  );
  // global per-lane attrs: tmp[16] then write back permuted (new[d] = old[inv[d]])
  ad_t = eon_adapt_scratch + 1440;
  ad_i = 0; loop(16, ad_t[ad_i] = lane_swing[ad_i];         ad_i += 1;); ad_i = 0; loop(16, lane_swing[ad_i]         = ad_t[ad_inv[ad_i]|0]; ad_i += 1;);
  ad_i = 0; loop(16, ad_t[ad_i] = lane_groove[ad_i];        ad_i += 1;); ad_i = 0; loop(16, lane_groove[ad_i]        = ad_t[ad_inv[ad_i]|0]; ad_i += 1;);
  ad_i = 0; loop(16, ad_t[ad_i] = lane_mute[ad_i];          ad_i += 1;); ad_i = 0; loop(16, lane_mute[ad_i]          = ad_t[ad_inv[ad_i]|0]; ad_i += 1;);
  ad_i = 0; loop(16, ad_t[ad_i] = lane_solo[ad_i];          ad_i += 1;); ad_i = 0; loop(16, lane_solo[ad_i]          = ad_t[ad_inv[ad_i]|0]; ad_i += 1;);
  ad_i = 0; loop(16, ad_t[ad_i] = lane_icon_override[ad_i]; ad_i += 1;); ad_i = 0; loop(16, lane_icon_override[ad_i] = ad_t[ad_inv[ad_i]|0]; ad_i += 1;);
  ad_i = 0; loop(16, ad_t[ad_i] = rowchannel[ad_i];         ad_i += 1;); ad_i = 0; loop(16, rowchannel[ad_i]         = ad_t[ad_inv[ad_i]|0]; ad_i += 1;);
  eon_recalc_solo();
  update_has_notes();
  groove_dirty = 1;
  refresh_tb = 1; refresh_pianokeys = 1;
  eon_apply_dirty = 1; eon_apply_settle = 0;   // AP-4: one undo + serialize snapshot
  eon_adapt_pend = 0;   // consumed (eon_adapt_last already tracked at arm)
);

function moveUpDown(dir) // 1 Up // 0 Down //
(
  step=0; endrowused=0;
  loop(listlength,
    dir?(notelist[step]>281474976710655 ? endrowused+=1;):(endrowused+=notelist[step]&1;);
    step+=1; 
  );
  endrowused==0? (
    step=0; 
    loop(listlength,
    notelist[step]=dir?(notelist[step]*2;):(notelist[step]/2;);
    notetie[step]= dir?(notetie[step]*2;):(notetie[step]/2;);
    dir?(row=max_numnotes;):(row=0;);
    loop(max_numnotes,
      sd_pos=0;
    loop(max_subdivs,
        sdlist[sdlist_p+row*max_seqlength*max_subdivs+step*max_subdivs+sd_pos] = sdlist[sdlist_p+
      ((dir?(row-1):(row+1);)*max_seqlength*max_subdivs)+step*max_subdivs+sd_pos];
        sd_pos+=1;
      );  
    velolist[step+(row*listlength)] = velolist[step+((dir?(row-1):(row+1);)*listlength)];
      dir?(row-=1;):(row+=1;);
    );
    step+=1;
    );
  );       
  dir?(memset(velolist, 0, listlength););    
);

function moveRightLeft(dir,ccs) // 1 Right // 0 Left // 
(
  y=dir?(-1):(1);
  z=dir?(listlength-1):(0);
  x=dir?(0):(listlength-1);
  sparebuf[0] = notelist[z];
  sparebuf_tie[0] = notetie[z]; 
  ccs ? sparebuf_cc[0] = cclist[z];
  step=z;
  loop(listlength-dir,   
    notelist[step] = notelist[step+y]; 
    notetie[step] = notetie[step+y];
    ccs ? cclist[step] = cclist[step+y];
    dir?(step-=1;):(step+=1;);
  );
  notelist[x] = sparebuf[0];
  notetie[x] = sparebuf_tie[0];
  ccs ? cclist[x] = sparebuf_cc[0];
  row=0;  
  loop(max_numnotes,
    step=z;
    sparebuf2[0]=velolist[dir?((row+1)*listlength-1):(row*listlength);];
    sd_pos=0;
    loop(max_subdivs,
      sparebuf3[sd_pos]=sdlist[sdlist_p+row*max_seqlength*max_subdivs+step*max_subdivs+sd_pos];
      sd_pos+=1;
    );  
    loop(listlength-1,    
      sd_pos=0;
      loop(max_subdivs,
        sdlist[sdlist_p+row*max_seqlength*max_subdivs+step*max_subdivs+sd_pos] = sdlist[sdlist_p+row*max_seqlength*max_subdivs+(step+y)*max_subdivs+sd_pos];
        sd_pos+=1;
      ); 
      velolist[step+(row*listlength)] = velolist[step+(row*listlength)+y];
      step+=y; 
    );
    velolist[dir?(row*listlength):(((row+1)*listlength)-1);]=sparebuf2[0];
    sd_pos=0;
    loop(max_subdivs,
      sdlist[sdlist_p+row*max_seqlength*max_subdivs+x*max_subdivs+sd_pos] = sparebuf3[sd_pos];
      sd_pos+=1;
    );
  row+=1;
  );
);

function initialize48(pm)
(
  //change number of patterns: initialize 48 patts ONLY, set max_seqlength
  patternmode=pm; max_seqlength = pm==0?(64):(128);
  listlength = 16; steps_per_beat=4; npatterns = 48;
  p=0; pat_shift=0; xtrapatts=0; chain=0;
  sliderchange(slider1=p);
  sliderchange(slider3=listlength);
  sliderchange(slider9=steps_per_beat);
  sliderchange(slider44=pat_shift);
  sliderchange(slider46=xtrapatts);
  sliderchange(slider12=chain);
  sliderchange(slider47=npatterns);
  memset(sparebuf,      0, npatterns*1024);
  memset(sparebuf_tie,  0, npatterns*1024);
  memset(sparebuf_cc,   0, npatterns*1024);
  memset(notelist_base, 0, npatterns*max_seqlength);
  memset(notetie_base,  0, npatterns*max_seqlength);
  memset(cclist_base,   0, npatterns*max_seqlength); 
  memset(sparebuf2,     0, npatterns*max_seqlength*max_numnotes);
  memset(velolist_base, 0, npatterns*max_seqlength*max_numnotes); 
  memset(sdlist,        0, npatterns*max_seqlength*max_numnotes*max_subdivs);
  memset(rowchannel,    0, max_numnotes);
  memset(notetranspose, 0, max_numnotes);
  memset(listlength_pat, listlength, npatterns); 
  memset(steps_per_beat_pat, steps_per_beat, npatterns); 
  listlength_all=listlength*npatterns;
  change_pattern(p);
  update_has_notes();
  refresh_tb=1;
);
@slider

new_p=slider1|0;
new_p!=p ? (_ui_patop ? _pend_pat = new_p : change_pattern(new_p));  // defer past @gfx pattern gestures
basenote=slider2|0; 
numnotes=slider4|0;
rate=slider5;
notelen_p = slider6|0;
defnotelen = (tpb*(notelen_p/100))|0;
mode = slider7|0; //0= piano roll, 1 = drum map
mode == 0 ? (
  chw=0;
  pianow=3*8+8;
) : (
  chw = 2*8+8 + (colorscheme==10 ? 16 : 0); // EON: wider channel column for the drum glyph
  pianow=max_notename_length*8+8;
);
eon_colvis_apply();
swing_p = slider8|0;
swing = ((tpb/2)*(swing_p/100))|0;
// EON: on first run / project load, seed every lane's swing from the master -- but NOT if a saved
// per-lane set was just deserialized (lane_swing_loaded), so loaded projects keep their per-lane values
lane_swing_inited==0 ? (lane_swing_loaded==0 ? memset(lane_swing, swing_p, max_numnotes); lane_swing_inited=1;);
// EON: seed each pattern an auto hue (8 evenly-spaced) on first run / no-load; right-click overrides; persisted
pattern_hue_inited==0 ? (pattern_hue_loaded==0 ? (eon_phi=0; loop(npatterns, pattern_hue[eon_phi]=(eon_phi==0 ? -1 : (eon_phi%8)/8); eon_phi+=1;);); pattern_hue_inited=1;);   // -1 = MPC cream (pattern 1)
midi_trigger=slider10|0;
prev_p==p ? ( // not changing pattern
  newsz=slider3|0;
  _ui_patop ? _pend_seqlen = newsz : change_seqlen(newsz);  // defer past @gfx pattern gestures
  steps_per_beat=slider9|0;
  steps_per_beat_pat[p]=steps_per_beat;
  rateadj = steps_per_beat * rate;
  p <= chain ? update_chain_beats();
);
trig_note_start=slider11|0;
chain=slider12|0;
elh_percent=slider13;
notenames_file=0;   // drum-map file removed -- names come from Swing, else GM defaults
cc_to_adjust=slider14|0;
cc_type[0]=slider20|0;
cc_type[1]=slider21|0;
cc_type[2]=slider22|0;
cc_type[3]=slider23|0;
cc_chan[0]=slider30|0;
cc_chan[1]=slider31|0;
cc_chan[2]=slider32|0;
cc_chan[3]=slider33|0;
start_beatpos=slider40;
play_before_start=slider41|0;
end_beatpos=slider42;
colorscheme=slider43;
pat_shift=slider44;
pm=slider45;
xtrapatts=slider46;
npatterns=slider47;
// View-only: no groove_dirty / no pattern invalidation, nothing downstream depends
// on it. Default 1 so the structure is on out of the box (the grid read as flat
// without it); flipping it off restores the previous plain look exactly.
eon_gridlines=slider50;
// Column mask. Read BEFORE the pkw derivation below, which consumes it. Also
// view-only -- hiding a column changes nothing about what the lane plays, which
// is why none of this touches groove_dirty or the pattern data.
eon_colvis=slider51|0;
pm!=patternmode ? (
 _ui_patop ? _pend_init48 = pm : initialize48(pm);  // defer past @gfx pattern gestures
);
// EON GROOVE: any slider pass may have changed swing strength / pattern state -- rebuild
// the runtime groove table next @block (flag-gated, ~3k int ops; unconditional is cheap).
groove_dirty = 1;

@serialize
// Write:
// collect properties of active notes -> runlength encode -> encode to saveable -> serialize
//
// Read:
// unserialize -> decode from saveable -> runlength decode -> expand note properties
//

function enc_to_saveable(target, source, length) local(_srz_i, i_t, s)
(
  _srz_i=0;
  i_t=0;
  loop(length,
    s = source[_srz_i];
    s < 0 ? ( // negative source value
      target[i_t] = 0x200000; // add flag to bit 21 indicating negative value
      s = abs(s); // store absolute value
    ) : (
      target[i_t] = 0;
    );
    s > 0xFFFFF ? (//using more than 20 bits -> split
      target[i_t] += (s & 0xFFFFF) + 0x100000; // copy bits (19:0) and add flag to bit 20
      i_t += 1;
      s & 0x80000000 ? ( // bit 31 = 1
        target[i_t] = ((s & 0x7FFFFFFF) >> 20) + 0x800; // copy bits (31:20)
      ) : (
        target[i_t] = ((s & 0x7FFFFFFF) >> 20); // copy bits (31:20)
      );
    ) : (
      runl_flags[_srz_i] ? (
        target[i_t] = s + 2^23; //bit 23 flags a run length. It is safe to do because length of run is always < 2^23 and > 0.
      ) : (
        target[i_t] += s;
      );
    );
    _srz_i += 1;
    i_t += 1;
  );
  i_t; // return length of target
);

function dec_from_saveable(target, source, length) local(_srz_i, i_t, s)
(
  memset(runl_flags, 0, length); //clear run length flags
  _srz_i=0;
  i_t=0;
  loop(length,
    s = source[_srz_i];
    _srz_s_neg = s & 0x200000; // extract negative value flag
    _srz_s_neg ? s -= 0x200000; //clear negative value flag
    s & 0x100000 ? ( // split data flag
      s &= 0xFFFFF; // extract bits (19:0)
      _srz_i+=1;
      s += source[_srz_i] * 2^20; // extract bits (31:20)
      target[i_t] = s;
    ) : (
      s & 0x800000 ? ( // run length flag
        runl_flags[i_t] = 1; // copy run length flag 
        target[i_t] = s & 0xFFFFF; // remove flag and copy source data to target
      ):(
        target[i_t] = s; // copy to target
      );
    );
    _srz_s_neg ? target[i_t]=-target[i_t]; // negate target data if source data was flagged negative
    _srz_i += 1;
    i_t += 1;
  );
  i_t; // return length of target
);

// Run length encoder
function runl_enc(target, source, length) local(_srz_i, i_t, s, run, prev_s, rl)
(
  memset(runl_flags, 0, length); //clear run length flags
  i_t=0;
  rl=1;
  run=0;
  prev_s=source[0];
  _srz_i=1;
  loop(length-1,
    s = source[_srz_i];
    s==prev_s ? (
      run=1;
      rl+=1; 
    ) : (
      run ? ( //end of run
        run=0;
        target[i_t]=rl; //store run length
        rl=1;
        runl_flags[i_t]=1; // flag run length position
        i_t += 1;
        target[i_t]=prev_s; // store data to be repeated
      ) : ( //there was no run active
        target[i_t]=prev_s; // store previous source data
      );
      i_t += 1;
    );
    prev_s=s;
    _srz_i+=1;
  );
  // End of source data
  run ? ( // Data ends in a run
    target[i_t]=rl; //store run length
    runl_flags[i_t]=1; // flag run length position
    i_t += 1;
    target[i_t]=prev_s; // store data to be repeated
  ) : ( //no run in the end
    target[i_t]=prev_s; // store previous source data
  );
  i_t + 1; // return length of target
);

// Run length decoder
function runl_dec(target, source, length) local(_srz_i, i_t)
(
  _srz_i=0;
  i_t=0;
  while(
    runl_flags[_srz_i] ? ( // Current source data is a run length
      memset(target+i_t, source[_srz_i+1], source[_srz_i]); // Fill target with next source data. Fill length = run length. 
      i_t+=source[_srz_i];
      _srz_i+=1;
    ) : (
      target[i_t]=source[_srz_i];
      i_t+=1;
    );
    _srz_i+=1;
    _srz_i < length;
  );
  i_t; // return length of target
);

_srz_serialread= (file_avail(0) >= 0);

_srz_serilen=0;

!_srz_serialread ?(
  memcpy(savedata+_srz_serilen, cclist_base, listlength_all);
  _srz_serilen += (listlength_all);
  memcpy(savedata+_srz_serilen, notetranspose, max_numnotes);
  _srz_serilen += max_numnotes;
  memcpy(savedata+_srz_serilen, rowchannel, max_numnotes);
  _srz_serilen += max_numnotes;
  memcpy(savedata+_srz_serilen, listlength_pat, npatterns);
  _srz_serilen += npatterns;
  memcpy(savedata+_srz_serilen, steps_per_beat_pat, npatterns);
  _srz_serilen += npatterns; _srz_pat = 0;
  _srz_pstart = notelist_base;
  _srz_pstartv = velolist_base;
  _srz_pstartsd = sdlist;
  _srz_tstart = notetie_base;
  loop ( npatterns,
    _srz_step = 0;
    loop ( listlength_pat[_srz_pat],
      _srz_notelist_buffer1_save=_srz_pstart[_srz_step]&0xFFFFFFFF;
      savedata[_srz_serilen] = _srz_notelist_buffer1_save;_srz_serilen += 1;
      _srz_notelist_buffer2_save=_srz_pstart[_srz_step]/(2^32);
      _srz_notelist_buffer2_save=_srz_notelist_buffer2_save&0xFFFFFFFF;
      savedata[_srz_serilen] = _srz_notelist_buffer2_save; _srz_serilen += 1;
      _srz_notetie_buffer1_save=_srz_tstart[_srz_step]&0xFFFFFFFF;
      savedata[_srz_serilen] = _srz_notetie_buffer1_save; _srz_serilen += 1;
      _srz_notetie_buffer2_save=_srz_tstart[_srz_step]/(2^32);
      _srz_notetie_buffer2_save=_srz_notetie_buffer2_save&0xFFFFFFFF;
      savedata[_srz_serilen] = _srz_notetie_buffer2_save; _srz_serilen += 1;
      _srz_stepnotes = _srz_pstart[_srz_step];
        _srz_stepnotes!=0 ? ( // has notes in current step
        _srz_row = 0;
        while (
          (_srz_stepnotes&1) ? ( // note on current row
            _srz_velo_save = _srz_pstartv[_srz_row*listlength_pat[_srz_pat]+_srz_step];
            savedata[_srz_serilen] = _srz_velo_save;
            _srz_serilen += 1;
            (_srz_velo_save & 0x000F0000) ? ( // has subdivs
              _srz_subdivnotelist_save=((_srz_pstartsd[_srz_row*max_seqlength*max_subdivs+_srz_step*max_subdivs] & 0x00FF0000) >> 16);
              savedata[_srz_serilen] = _srz_subdivnotelist_save;
              _srz_serilen += 1;
              _srz_sdpos_save=0;
              while (
                (_srz_subdivnotelist_save&1) ? ( // save only active subdiv notes
                  savedata[_srz_serilen] = _srz_pstartsd[_srz_row*max_seqlength*max_subdivs+_srz_step*max_subdivs+_srz_sdpos_save];
                  _srz_serilen += 1;
                );
                _srz_subdivnotelist_save *= 0.5;
                _srz_sdpos_save += 1;
                _srz_subdivnotelist_save>=1;
              );
            );
          );
          _srz_stepnotes *= 0.5;
          _srz_row +=1;
          _srz_stepnotes>=1;
        );
      );
      _srz_step += 1;
    );
    _srz_tstart += listlength_pat[_srz_pat];
    _srz_pstart += listlength_pat[_srz_pat];
    _srz_pstartv += listlength_pat[_srz_pat]*max_numnotes;
    _srz_pstartsd += max_numnotes*max_seqlength*max_subdivs;
    _srz_pat += 1;
  );
  _srz_serilen = runl_enc(savedata2, savedata, _srz_serilen);
  _srz_serilen = enc_to_saveable(savedata, savedata2, _srz_serilen);
);

file_var(0,listlength);
file_var(0,_srz_serilen);
file_mem(0,savedata,_srz_serilen);
file_var(0,serz_data_ver);
file_var(0,listlength_all);
file_var(0,lastvelo);
// EON: per-lane swing, appended at the end of state. Old projects (saved before this existed) read
// 0 items here -> lane_swing_loaded stays 0 -> @slider seeds every lane from the master instead.
(file_mem(0, lane_swing, max_numnotes) >= max_numnotes) ? lane_swing_loaded = 1;
// EON: per-pattern hues (appended; old projects read 0 items -> auto-seeded in @slider)
(file_mem(0, pattern_hue, npatterns) >= npatterns) ? pattern_hue_loaded = 1;
// EON: per-lane MUTE/SOLO (appended; old projects/presets read 0 items -> stay 0 = unmuted)
(file_mem(0, lane_mute, max_numnotes) >= max_numnotes) ? lane_mute_loaded = 1;
(file_mem(0, lane_solo, max_numnotes) >= max_numnotes) ? lane_solo_loaded = 1;
eon_recalc_solo();
// EON: embedded VIEW mode (0=GRID, 1=PANELS), appended LAST so old projects hit EOF
// here and leave it at the load-time default (0=GRID). Not initialised in @init, so a
// samplerate change (which re-runs @init, not @serialize) can't clobber the loaded value.
file_var(0, ss_embed_view);
// EON: per-pattern DM region override (0 = Auto, k>=1 = pinned ordinal), appended LAST
// after ss_embed_view. Old projects hit EOF here -> read 0 items -> the array stays all-0
// (= Auto for every pattern). Not initialised in @init (see allocation note) so a
// samplerate-change @init re-run can't clobber a loaded override.
file_mem(0, eon_region_override, npatterns);
// EON GROOVE (appended after eon_region_override -- append-only, count-guarded):
// per-lane groove slot ids (all-0 on old projects = classic swing for every lane).
(file_mem(0, lane_groove, max_numnotes) >= max_numnotes) ? lane_groove_loaded = 1;
// master groove pick (plain var, ss_embed_view precedent: EOF leaves the load-time 0 = classic)
file_var(0, master_groove);
// global velocity-accent amount, +1 sentinel: 0 = never saved -> recompute defaults to 100.
// (A bare 0..100 var can't distinguish "old project" from "saved as 0"; fresh memory is 0
// and @init must not initialise serialized vars -- samplerate re-init clobber.)
file_var(0, groove_vel_amt_p1);
// USER groove slots 9..15 (imported .rgt/MIDI templates; 0..8 = builtins, rebuilt in @init)
// -- must live here so a cold re-instantiation (audio-device close) restores them without
// the bridge running.
(file_mem(0, groove_slots + 9*GROOVE_STRIDE, 7*GROOVE_STRIDE) >= 7*GROOVE_STRIDE) ? groove_user_loaded = 1;
// EON ICONS (appended after the groove user slots -- append-only, count-guarded):
// per-lane icon override (0 = Auto/name-based glyph, k>=1 = category k-1). Old
// projects/presets (incl. codec-generated library presets, which end earlier) read
// 0 items -> the array stays all-0 = Auto for every lane. Not initialised in @init.
(file_mem(0, lane_icon_override, max_numnotes) >= max_numnotes) ? lane_icon_override_loaded = 1;

_srz_serialread ?(

  _srz_serilen = dec_from_saveable(savedata2, savedata, _srz_serilen);
  _srz_serilen = runl_dec(savedata, savedata2, _srz_serilen);
 
  // clear spare buffers, noteties & subdivs first
  memset(sparebuf, 0, npatterns*1024);
  memset(sparebuf2, 0, npatterns*max_numnotes*max_seqlength);
  memset(sparebuf_tie, 0, npatterns*1024);
  memset(sparebuf_cc, 0, npatterns*1024);
  memset(sdlist, 0, npatterns*max_numnotes*max_seqlength*max_subdivs);
  
  i_srz = 0;
  memcpy(cclist_base, savedata+i_srz, listlength_all); // read CCs from saved data
  i_srz += listlength_all;
  memcpy(notetranspose, savedata+i_srz, max_numnotes);
  i_srz += max_numnotes;
  memcpy(rowchannel, savedata+i_srz, max_numnotes);
  i_srz += max_numnotes;
  memcpy(listlength_pat, savedata+i_srz, npatterns); // read pattern lengths from saved data
  i_srz += npatterns;
  memcpy(steps_per_beat_pat, savedata+i_srz, npatterns); // read steps_per_beat from saved data
  i_srz += npatterns;

  _srz_pat = 0;
  _srz_tstart = notetie_base;
  _srz_pstart = notelist_base;
  _srz_pstartv = velolist_base;
  _srz_pstartsd = sdlist;
  loop (npatterns,
    _srz_step = 0;
    memset(_srz_pstartv, 0, max_numnotes*listlength_pat[_srz_pat]); //initialize all velocities of pat to 0
    loop ( listlength_pat[_srz_pat],
    _srz_notelist_buffer1_save = savedata[i_srz];  i_srz += 1;
    _srz_notelist_buffer2_save = savedata[i_srz];  i_srz += 1;
    _srz_stepnotes = _srz_pstart[_srz_step]=(_srz_notelist_buffer1_save+(_srz_notelist_buffer2_save*(2^32)));
      _srz_notetie_buffer1_save = savedata[i_srz];  i_srz += 1;
    _srz_notetie_buffer2_save = savedata[i_srz];  i_srz += 1;
    _srz_tstart[_srz_step]=(_srz_notetie_buffer1_save+(_srz_notetie_buffer2_save*(2^32)));
      _srz_stepnotes!=0 ? (
        _srz_row = 0;
        while (
          (_srz_stepnotes&1) ? (
            _srz_velo_save = savedata[i_srz];
            i_srz += 1;
            _srz_pstartv[_srz_row*listlength_pat[_srz_pat]+_srz_step] = _srz_velo_save;
             // read subdivs from savedata
            (_srz_velo_save & 0x000F0000) ? ( // has subdivs
              _srz_subdivnotelist_save = savedata[i_srz];
              i_srz += 1;
              _srz_subdivnotelist_save_orig = _srz_subdivnotelist_save;
              _srz_sdpos_save=0;
              while (
                (_srz_subdivnotelist_save&1) ? ( // restore active subdiv notes
                  _srz_pstartsd[_srz_row*max_seqlength*max_subdivs+_srz_step*max_subdivs+_srz_sdpos_save] = savedata[i_srz];
                  i_srz += 1;
                );
                _srz_subdivnotelist_save *= 0.5;
                _srz_sdpos_save += 1;
                _srz_subdivnotelist_save>=1;
              );
              // set subdivnotelist
              _srz_pstartsd[_srz_row*max_seqlength*max_subdivs+_srz_step*max_subdivs] &= 0xFF00FFFF; //clear old
              _srz_pstartsd[_srz_row*max_seqlength*max_subdivs+_srz_step*max_subdivs] += (_srz_subdivnotelist_save_orig << 16); //set new
            );
          );
          _srz_stepnotes *= 0.5;
          _srz_row += 1;
          _srz_stepnotes>=1;
        );
      );
      _srz_step += 1;
    );
    _srz_tstart += listlength_pat[_srz_pat];
    _srz_pstart += listlength_pat[_srz_pat];
    _srz_pstartv += listlength_pat[_srz_pat]*max_numnotes;
    _srz_pstartsd += max_numnotes*max_seqlength*max_subdivs;
    _srz_pat += 1;
  );
  recalc_elh = 1; // recalculate envelope lane height
  lbasenote = -1; // Force graphics redraw
  lnotenames_file = -1; // Force notenames reload
  change_pattern(slider1|0);
  update_chain_beats();
  eon_preset_loaded = 1;   // a preset/project just loaded -> @block pushes it to the DM (don't let sync clobber it)
  groove_dirty = 1;        // EON GROOVE: lane_groove / user slots / vel amount just (re)loaded -> rebuild the runtime table
);

@block

// Consume pattern ops deferred while a @gfx pattern gesture was in flight
// (slider values already carry the targets — no sliderchange needed here).
!_ui_patop ? (
  _pend_init48 >= 0 ? ( initialize48(_pend_init48); _pend_init48 = -1; );
  _pend_pat    >= 0 ? ( _pend_pat != p ? change_pattern(_pend_pat); _pend_pat = -1; );
  _pend_seqlen >= 0 ? ( change_seqlen(_pend_seqlen); _pend_seqlen = -1; );
);

// EON: derive the paired slot from slider48 (eon_pair_slot is @gfx-only; sign =
// auto/manual, irrelevant here). E-2: PAIRED no longer advances the banded M/S
// heartbeat — that region is retired and the bridge's banded mirror must see it
// dead (the pad-M/S legs own the child tracks now). Instead, rebuild the
// lane->pad map + band any-solo so eon_audible band-gates correctly even with
// the GUI closed. Unpaired keeps the legacy global heartbeat.
_eon_blk_ps = (abs(slider48)|0) - 1;
_eon_blk_ps >= 0 ? (
  eon_e2_rebuild_map(_eon_blk_ps);
) : (
  gmem[EON_SS_ALIVE] = gmem[EON_SS_ALIVE] + 1;
);

// EON Apply (AP-1): UNGATED custom-preset apply -> active pattern. Works standalone (no
// sync / no Swing pairing). The bridge stages a stored grid in the APPLY band addressed
// to our slot (paired) or slot 0 (lone unpaired) and bumps applyreq_seq; we consume the
// edge and drop it into the active pattern. We DON'T force an export here: if Sync is on,
// the digest-settle export below sees the grid change and propagates ONE update per
// settled gesture -- so scroll-auditioning coalesces instead of thrashing the DM region.
// PRIME-ON-OPEN: a freshly instantiated instance baselines to the CURRENT applyreq
// (without applying) so it opens BLANK -- it never adopts a stale request left in gmem
// by an earlier apply this session; only bumps made AFTER it opened fire. @init resets
// the flag, so a samplerate-reinit also re-baselines (no spurious apply on reinit).
_apply_self = _eon_blk_ps >= 0 ? _eon_blk_ps : 0;
eon_apply_primed ? (
  (gmem[EON_SS_APPLY_BASE + 1] != eon_apply_last && (gmem[EON_SS_APPLY_BASE]|0) == _apply_self) ? (
    eon_ss_apply_grid();
    eon_apply_last = gmem[EON_SS_APPLY_BASE + 1];
    eon_apply_dirty = 1; eon_apply_settle = 0;   // arm settle-debounced undo capture
    // P3b-6: StepSeq-wins force-export, same flag the @serialize preset path
    // sets — WITHOUT it, an apply that changes listlen/spb (any preset on a
    // region-owned grid; every triplet preset) races the bridge's res-change
    // watcher: the watcher fires ~30ms after the change while the live echo
    // needs ~100ms of settle, so the re-import could clobber the fresh apply
    // with the region's OLD content. The flag's export fires later THIS SAME
    // @block (site order), so EXPORTREQ is bumped before the bridge can look.
    eon_preset_loaded = 1;
  );
) : (
  eon_apply_last = gmem[EON_SS_APPLY_BASE + 1];   // baseline the pre-existing request -> open blank
  eon_apply_primed = 1;
);
// AP-4: once the apply gesture settles (~0.25s of no new apply), snap ONE FX-state undo
// point. The apply mutates notelist silently (no slider), so without this REAPER has no
// undo point for it -> Ctrl+Z jumps to before the plugin was inserted. sliderchange forces
// REAPER to capture the @serialize state (new grid) + marks the project dirty. Debounced so
// scroll-auditioning yields ONE undo per landing, not one per wheel tick.
eon_apply_dirty ? (
  eon_apply_settle += samplesblock / srate;
  eon_apply_settle >= 0.25 ? (
    sliderchange(slider1 = p);
    eon_apply_dirty = 0;
  );
);

// EON GROOVE adopt: the bridge staged an imported template into a USER slot (8..15) and
// bumped the seq. Same prime/edge/slot-address pattern as APPLY above; the adopted slot
// content is persisted via @serialize (AP-4 settle reuse below forces the state snapshot,
// so the import survives project save + cold re-instantiation without the bridge).
eon_grv_primed ? (
  (gmem[EON_SS_GROOVE_BASE + 1] != eon_grv_last && (gmem[EON_SS_GROOVE_BASE]|0) == _apply_self) ? (
    grv_us = gmem[EON_SS_GROOVE_BASE + 2]|0;
    (grv_us >= 0 && grv_us < 7) ? (
      grv_d = groove_slots + (9 + grv_us)*GROOVE_STRIDE;
      grv_i = 0; loop(64, grv_d[grv_i]       = gmem[EON_SS_GROOVE_BASE + 64  + grv_i]; grv_i += 1;);
      grv_i = 0; loop(64, grv_d[64 + grv_i]  = gmem[EON_SS_GROOVE_BASE + 128 + grv_i]; grv_i += 1;);
      grv_i = 0; loop(16, grv_d[128 + grv_i] = gmem[EON_SS_GROOVE_BASE + 5   + grv_i]; grv_i += 1;);
      grv_d[144] = gmem[EON_SS_GROOVE_BASE + 3];
      grv_d[145] = 1;                                      // bit0 = loaded (mailbox flag bits are commands, not state)
      // mailbox flag bit1 = "assign to MASTER on adopt" (browser toggle) -- mirrors the
      // master-menu pick: all lanes take the new slot, strength floored to audible.
      (gmem[EON_SS_GROOVE_BASE + 4]|0) & 2 ? (
        master_groove = 9 + grv_us;
        swing_p == 0 ? (
          swing_p = 60; swing = ((tpb/2)*(swing_p/100))|0;
          sliderchange(slider8 = swing_p);
        );
        memset(lane_groove, 9 + grv_us, max_numnotes);
        memset(lane_swing, swing_p, max_numnotes);
        refresh_tb = 1;
      );
      groove_dirty = 1;
      eon_apply_dirty = 1; eon_apply_settle = 0;           // debounced sliderchange -> undo point + serialize snapshot
      refresh_pianokeys = 1;
    );
    eon_grv_last = gmem[EON_SS_GROOVE_BASE + 1];
  );
) : (
  eon_grv_last = gmem[EON_SS_GROOVE_BASE + 1];             // baseline a stale request (slots came back via @serialize)
  eon_grv_primed = 1;
);

// EON GROOVE recompute: rebuild the runtime per-lane/per-step offset + velocity-amp
// layers. Flag-gated (~49x64 int ops); lives in @block, NOT @gfx, so playback is
// groove-correct with the GUI closed. Slot 0 (classic swing) uses the VERBATIM legacy
// expression ((tpb/2)*(strength/100))|0 on odd steps -- frozen, do NOT refactor: any
// re-association risks ulp drift vs the old engine and breaks the byte-identical proof.
groove_dirty ? (
  groove_dirty = 0;
  grv_vamt = groove_vel_amt_p1 > 0 ? groove_vel_amt_p1 - 1 : 100;   // +1 sentinel: unset -> 100
  grv_n = 0;
  loop(max_numnotes,
    grv_g = lane_groove[grv_n]|0;
    (grv_g < 0 || grv_g >= GROOVE_NSLOTS) ? grv_g = 0;
    (grv_g > 0 && !(groove_slots[grv_g*GROOVE_STRIDE + 145]&1)) ? grv_g = 0;   // unloaded slot -> classic fallback
    grv_st = lane_swing[grv_n];                                    // REPURPOSED: strength 0..100
    grv_s = 0;
    grv_g == 0 ? (
      grv_sw = ((tpb/2)*(grv_st/100))|0;                           // frozen legacy swing expression
      loop(max_seqlength,
        groove_off_rt[grv_n*max_seqlength + grv_s] = (grv_s & 1) ? grv_sw : 0;   // odd step == old swing_beat parity
        groove_amp_rt[grv_n*max_seqlength + grv_s] = 1;            // classic swing never touches velocity
        grv_s += 1;
      );
    ) : (
      grv_b   = groove_slots + grv_g*GROOVE_STRIDE;
      grv_len = grv_b[144]|0;
      (grv_len < 1 || grv_len > 64) ? grv_len = 16;
      loop(max_seqlength,
        grv_t = grv_b[grv_s % grv_len];                            // template wraps by its own length
        grv_t < 0 ? grv_t = 0;
        grv_t > tpb-1 ? grv_t = tpb-1;
        groove_off_rt[grv_n*max_seqlength + grv_s] = floor(grv_t * grv_st / 100 + 0.5);
        grv_a = grv_b[64 + (grv_s % grv_len)];
        (grv_a < 0 || grv_a > 1) ? grv_a = 1;
        groove_amp_rt[grv_n*max_seqlength + grv_s] = 1 - (1 - grv_a) * grv_vamt / 100;   // vel amount pre-baked
        grv_s += 1;
      );
    );
    grv_n += 1;
  );
  // publish the raw USER slots to the readback band (browser names + exports them).
  // Runs only on recompute (slots change rarely); ~1.1k writes, @block-safe.
  grv_pb = EON_SS_GRV_PUB_BASE + _apply_self*EON_SS_GRV_PUB_STRIDE;
  grv_i = 0;
  loop(7*GROOVE_STRIDE,
    gmem[grv_pb + 1 + grv_i] = groove_slots[9*GROOVE_STRIDE + grv_i];
    grv_i += 1;
  );
  gmem[grv_pb] = (gmem[grv_pb]|0) + 1;
);

// EON Sync Mode (Phase 1, Import direction). When Sync is ON and we're paired,
// publish our active-pattern shape (a courier needs it to build a matching grid)
// and adopt a grid the courier stages + signals via dm_push. DORMANT until a
// courier exists: with dm_push == 0 the import never runs, so Sync OFF or
// unpaired = byte-identical standalone behaviour. _eon_blk_ps = our Swing slot.
// Kit-categories: watch the paired slot's PADCAT VER sum so a category change
// (Swing pill / our picker via the bridge) redraws the lane column promptly —
// the icon column is refresh-gated and nothing else bumps it on a band change.
eon_pc_vs = 0;
eon_pair_slot >= 0 ? (
  eon_pc_i = 0;
  loop(16,
    eon_pc_vs += gmem[EON_PADCAT_BASE + eon_pair_slot*EON_PADCAT_STRIDE + eon_pc_i*4];
    eon_pc_i += 1;
  );
);
eon_pc_vs != eon_pc_vs_last ? ( refresh_pianokeys = 1; refresh_tb = 1; eon_pc_vs_last = eon_pc_vs; );
// ③ ADAPT engine (@block-OWNED; review-hardened): the bridge bumped the ADAPT
// seq for OUR slot -> VALIDATE the 16 dsts (each 0..15, seen-mask 0xFFFF =
// strict bijection; a torn/foreign band is rejected, never armed) and SNAPSHOT
// them into eon_adapt_dst — apply NEVER re-reads the shared band, so a later
// kit load on ANOTHER slot can't swap the mapping under the lit chip. If a
// perm was already pending un-clicked, COMPOSE: total[p] = P2[P1[p]] (two
// loads without a click re-aim correctly from the ORIGINAL arrangement).
// Re-pair to a different slot cancels the pending perm outright.
// ALL adapt mutation lives HERE: the chip posts eon_adapt_click_req /
// eon_adapt_dismiss_req from @gfx and this section consumes them, so arm,
// compose, apply and dismiss are single-threaded on the audio thread — no
// @gfx/@block race on eon_adapt_dst. Slot gate = _eon_blk_ps (slider48-
// derived, valid with the GUI closed; eon_pair_slot is @gfx-maintained).
// Dismiss runs FIRST: a right-click aimed at the OLD chip must not eat a perm
// freshly armed in this very block (the new offer re-lights instead).
eon_adapt_dismiss_req ? ( eon_adapt_pend = 0; eon_adapt_auto_req = 0; eon_adapt_dismiss_req = 0; refresh_tb = 1; );
eon_adapt_armed_now = 0;
eon_adapt_primed ? (
  _eon_blk_ps < 0 || (eon_adapt_pend && _eon_blk_ps != eon_adapt_slot) ? ( eon_adapt_pend = 0; eon_adapt_auto_req = 0; ) :
  (gmem[EON_PADCAT_ADAPT] != eon_adapt_last && (gmem[EON_PADCAT_ADAPT + 1]|0) == _eon_blk_ps) ? (
    eon_adapt_last = gmem[EON_PADCAT_ADAPT];
    // validate into staging first (band cells are foreign until proven sane)
    eon_ad_ok = 1; eon_ad_seen = 0; eon_ad_i = 0;
    loop(16,
      eon_ad_v = gmem[EON_PADCAT_ADAPT + 2 + eon_ad_i]|0;
      (eon_ad_v < 0 || eon_ad_v > 15) ? eon_ad_ok = 0 : eon_ad_seen |= 2^eon_ad_v;
      eon_adapt_scratch[1472 + eon_ad_i] = eon_ad_v;   // staging (past the +1440 attr temp)
      eon_ad_i += 1;
    );
    eon_ad_ok && eon_ad_seen == 65535 ? (
      eon_adapt_pend ? (
        // compose onto the un-applied P1: total[p] = P2[P1[p]]
        eon_ad_i = 0;
        loop(16,
          eon_adapt_dst[eon_ad_i] = eon_adapt_scratch[1472 + (eon_adapt_dst[eon_ad_i]|0)];
          eon_ad_i += 1;
        );
      ) : (
        eon_ad_i = 0;
        loop(16, eon_adapt_dst[eon_ad_i] = eon_adapt_scratch[1472 + eon_ad_i]; eon_ad_i += 1;);
      );
      // composed result may be identity (B->C undid A->B): then nothing pends
      eon_ad_id = 1; eon_ad_i = 0;
      loop(16, (eon_adapt_dst[eon_ad_i]|0) != eon_ad_i ? eon_ad_id = 0; eon_ad_i += 1;);
      eon_adapt_pend = !eon_ad_id;
      eon_adapt_armed_now = eon_adapt_pend;
      eon_adapt_slot = _eon_blk_ps;
      refresh_tb = 1;
    );
  );
) : ( eon_adapt_last = gmem[EON_PADCAT_ADAPT]; eon_adapt_primed = 1; );
// ③ ADAPT dispatch: consume the @gfx click, OR auto-apply a FRESHLY armed perm
// (Settings "Auto-adapt patterns", band OPT cell 53; default OFF). Enabling
// auto never consumes a chip that was already lit — a settings toggle must not
// mutate patterns as a side effect; eon_adapt_auto_req keeps a deferred auto-
// apply retrying until the grid is quiet. The gesture gate (mstate/_ui_patop)
// parks the apply while a @gfx grid gesture is in flight — requests and pend
// persist, so it lands on the next quiet block. Once pend is gone (applied,
// dismissed, unpaired, or composed to identity) any stale request is dropped.
eon_auto_adapt_on = _eon_blk_ps >= 0 && gmem[EON_SS_SYNC_BASE + _eon_blk_ps*EON_SS_SYNC_STRIDE + EON_SS_SYNC_OPT_AA] > 0.5;
eon_adapt_armed_now && eon_auto_adapt_on ? eon_adapt_auto_req = 1;
eon_adapt_pend && (eon_adapt_click_req || eon_adapt_auto_req) && mstate == 0 && !_ui_patop ? (
  eon_adapt_apply();
  eon_adapt_click_req = 0; eon_adapt_auto_req = 0;
);
!eon_adapt_pend ? ( eon_adapt_click_req = 0; eon_adapt_auto_req = 0; );
eon_sync_mode = slider49 > 0.5;
eon_len_follow = 0;   // Match-rule indicator for @gfx (Len pill tick + tooltip); re-derived every block
(eon_sync_mode && _eon_blk_ps >= 0) ? (
  _ssb = EON_SS_SYNC_BASE + _eon_blk_ps*EON_SS_SYNC_STRIDE;
  gmem[_ssb + EON_SS_SYNC_SS_LISTLEN] = listlength;
  gmem[_ssb + EON_SS_SYNC_SS_SPB]     = steps_per_beat;
  gmem[_ssb + EON_SS_SYNC_SS_SYNCON]  = 1;
  // Region-pick: publish the active pattern index (for AUTO positional mapping) and
  // this pattern's override (0 = Auto, k>=1 = pin to region ordinal k). The courier
  // resolves the target region from these, so import/export no longer depend on the
  // edit/play cursor being parked over the right DM region.
  gmem[_ssb + EON_SS_SYNC_SS_PATIDX]  = p;
  gmem[_ssb + EON_SS_SYNC_SS_RGNSEL]  = eon_region_override[p];
  // P3b-4 paging: publish the ABSOLUTE selected ordinal (seeded from p on engage so a
  // fresh sync behaves exactly like the old positional map) + the visible page base
  // (the bridge slices the colour window 22..37 from it).
  eon_sel_ord < 1 ? eon_sel_ord = p + 1;
  gmem[_ssb + EON_SS_SYNC_SS_SELORD] = eon_sel_ord;
  gmem[_ssb + EON_SS_SYNC_SS_PAGE]   = eon_pat_base;
  _dmpush = gmem[_ssb + EON_SS_SYNC_DMPUSH];
  (_dmpush > 0 && _dmpush != eon_sync_last_push && (gmem[EON_SS_XFER_BASE]|0) == _eon_blk_ps) ? (
    eon_ss_import_grid();
    eon_sync_last_push = _dmpush;
    eon_sync_just_imported = 1;   // re-baseline next: a DM push is NOT a user edit (echo suppression)
  );
  // P3b-5a LENGTH-FOLLOW (the Match rule, spec 8a.4): while synced, the bound region's
  // TIME SPAN is authoritative -- grid steps = region_QN x steps_per_beat, snapped to
  // whole steps (clamped to max_seqlength). Adopting a new length republishes LISTLEN,
  // and the bridge's res-change watcher re-imports the region at the new grid (the same
  // verified flow as the Grid-feel toggle). A manual Seq Length edit in sync mode snaps
  // back next block (region wins: resolution is yours, total steps follow the region).
  _rgnqn = gmem[_ssb + EON_SS_SYNC_RGNQN];
  eon_len_follow = _rgnqn > 0;   // Len pill shows the "follows region" tick + tooltip
  _rgnqn > 0 ? (
    _wantlen = floor(_rgnqn * steps_per_beat + 0.5);
    _wantlen < 1 ? _wantlen = 1;
    _wantlen > max_seqlength ? _wantlen = max_seqlength;
    _wantlen != listlength && !_ui_patop ? (  // defers past @gfx gestures; diff-driven = natural retry
      change_seqlen(_wantlen);
      sliderchange(slider3 = listlength);
      refresh_tb = 1; refresh_pianokeys = 1;
    );
  );
  // DM -> SS pattern SELECT: a DM pattern chip was clicked (bridge mapped its region ->
  // pattern index). Switch to it (the patidx publish below + bridge re-import then load it).
  _dmpatseq = gmem[_ssb + EON_SS_SYNC_DM_PATSEQ];
  (_dmpatseq != eon_dm_patseq_last && !_ui_patop) ? (  // edge held (last not updated) while a @gfx gesture is in flight
    eon_dm_patseq_last = _dmpatseq;
    _dmpat = gmem[_ssb + EON_SS_SYNC_DM_PATSET]|0;   // absolute pattern index = region ordinal - 1
    (_dmpat >= 0 && _dmpat != (eon_sel_ord - 1)) ? (
      // P3b-4 paging: page to the ordinal, select its on-page button (internal pattern
      // slots are 0..7 per page; the grid is re-imported from the region on select).
      eon_sel_ord  = _dmpat + 1;
      eon_pat_page = (_dmpat / 8)|0;
      _dmpl = _dmpat % 8;
      (_dmpl != p && _dmpl < npatterns) ? (
        change_pattern(_dmpl);
        sliderchange(slider1 = p);
        sliderchange(slider3 = listlength);
      );
      refresh_tb = 1;
    );
  );
  // SEED on engage: the bridge found the region EMPTY when Sync turned on -> export our grid to
  // seed it (user: "setup a preset then turn sync on -> push to DM"). One-shot per bump.
  _seedreq = gmem[_ssb + EON_SS_SYNC_SEED_REQ];
  (_seedreq != eon_seed_req_last) ? (
    eon_export_pending = 1;
    eon_seed_req_last = _seedreq;
  );
  // PRESET/PROJECT LOAD: the grid just changed under us via @serialize, NOT a region import.
  // Push it to the DM (StepSeq wins) so a preset load isn't clobbered by the region re-import.
  // The export bumps EXPORTREQ; the bridge skips its pattern-switch re-import while exporting.
  eon_preset_loaded ? (
    eon_export_pending = 1;
    eon_preset_loaded = 0;
  );
  // EON live SS->DM (P3b-1): auto-fire the export once an edit GESTURE settles (~100ms
  // of no further grid change), so the DM region tracks the StepSeq 1:1 without the
  // manual button. ECHO/NO-OP SUPPRESSION: a pattern switch (p changed) or a just-
  // consumed DM import re-baselines the digest instead of exporting -- so selecting a
  // pattern never writes, and an imported grid never bounces straight back out.
  _dig = eon_grid_digest();
  (p != eon_sync_last_p || eon_sync_just_imported) ? (
    eon_sync_last_exp_digest = _dig;   // adopt as baseline; no export
    eon_sync_prev_digest     = _dig;
    eon_sync_settle          = 0;
    eon_sync_last_p          = p;
    eon_sync_just_imported   = 0;
  ) : (
    _dig != eon_sync_prev_digest ? (
      eon_sync_settle = 0;             // grid still changing -> reset the settle timer
      eon_sync_prev_digest = _dig;
    ) : (
      eon_sync_settle += samplesblock / srate;   // stable this block -> accrue settle time
    );
    (eon_sync_settle >= 0.10 && _dig != eon_sync_last_exp_digest) ? (
      eon_export_pending = 1;          // gesture settled + grid differs from last export -> fire
      eon_sync_last_exp_digest = _dig;
    );
  );
  // Export (StepSeq -> DM): fired by the live debounce above OR a SETTINGS "Export -> DM"
  // click (both set eon_export_pending). Serialize the active grid into the transfer
  // buffer, tag ORIGIN=StepSeq + bump DM_REV (so the DM-side reflect won't echo it back
  // in P3b-2), and bump EXPORTREQ so the bridge writes it onto the bound region's lanes.
  eon_export_pending ? (
    eon_ss_export_grid();
    eon_export_seq += 1;
    gmem[_ssb + EON_SS_SYNC_EXPORTREQ] = eon_export_seq;
    gmem[_ssb + EON_SS_SYNC_ORIGIN]    = 2;                                  // 2 = StepSeq
    gmem[_ssb + EON_SS_SYNC_DMREV]     = (gmem[_ssb + EON_SS_SYNC_DMREV]|0) + 1;
    eon_export_pending = 0;
  );
) : (
  _eon_blk_ps >= 0 ? gmem[EON_SS_SYNC_BASE + _eon_blk_ps*EON_SS_SYNC_STRIDE + EON_SS_SYNC_SS_SYNCON] = 0;
);

ts_num_l=ts_num;
ts_denom_l=ts_denom;
  
function all_playing_notes_off()
(
  npos=0;
  noneed=noteonstate;
  noteonstate=0;
  while(
    (noneed&1) ? (
      midisend(cursplpos,0x80+chan[npos],npos+basenote+trans[npos]); 
    );
    npos+=1;
    noneed*=0.5;
    noneed >= 1;
  );
);

prev_p!=p ? (
  prev_p=p;
  sliderchange(slider3=listlength);
  sliderchange(slider9=steps_per_beat);
);
 
mode == 1 ? (
  trans=notetranspose;
  chan=rowchannel;
):( 
  trans=notrans;
  chan=zerochan;
);

want_previewoff && last_preview >=0 ? (
  midisend(0,0x80+chan[last_preview],last_preview+basenote+trans[last_preview]);
  last_preview=-1;
);
want_previewoff=0;

want_previewoff_nt && last_preview_nt >=0 ? (
  midisend(0,0x80+preview_nt_chan,last_preview_nt+basenote+trans[last_preview_nt]);
  last_preview_nt=-1;
);
want_previewoff_nt=0;

want_noteoff_nt ? (
  is_midi_val(prev_nt) ? midisend(0,0x80+preview_nt_chan,prev_nt);
);
want_noteoff_nt=0;

want_preview >=0 ?
(
  is_midi_val(note_to_send = want_preview+basenote+trans[want_preview]) ? (
    midisend(0,0x90+chan[want_preview],note_to_send+previewvelo*256);
    last_preview=want_preview;
  );
  want_preview=-1;
);

want_preview_nt >=0 ?
(
  is_midi_val(note_to_send = want_preview_nt+basenote+trans[want_preview_nt]) ? (
    preview_nt_chan=chan[want_preview_nt];
    midisend(0,0x90+preview_nt_chan,note_to_send+lastvelo*256);
    last_preview_nt=want_preview_nt;
  );
  want_preview_nt=-1;
);

chain > 0 && beatpos == listlength-1 && pat_trigger_pending == 0? (
  p < chain ? (
    pat_trigger_num=p+1;
    pat_trigger_pending=1;
  ) : p==chain ? (
    pat_trigger_num=0;
    pat_trigger_pending=1;
  );
);

i_buf=0;
pat_triggered=0;
cur_note_trigger=0;
while (
  midirecv(offset,msg1,msg23) ? (
    midi_trigger > 0  ? ( // trigger enabled 
      s = msg1&0xF0;
      n=msg23&0x7F;        
      vel=(msg23/256)|0;
      s==0x90 && vel > 0 ? ( // Note-On event
        n >= trig_note_start && n < trig_note_start+npatterns ? ( // Note within pattern change trigger range
          !pat_triggered ? ( // Not yet triggered pattern
            pat_trigger_num=n-trig_note_start;
            pat_trigger_pending=1;
            pat_triggered=1;
            midi_trigger > 2 ? ( // trigger resync enabled
              beat_position >= -100 && beat_position <= 9999 ? (
                start_beatpos = beat_position; // set start beat position to current beat_position
                midi_trigger > 4 ? ( // trigger resync qunatizing enabled
                  start_beatpos_float = start_beatpos;
                  start_beatpos = start_beatpos_float|0;
                  start_beatpos_float - start_beatpos > 0.5 ? start_beatpos+=1;
                );
              );
              sliderchange(slider40=start_beatpos);
              refresh_tb=1;
            );
          );
          cur_note_trigger=1; // Always flag cur_note_trigger, even when already triggered, to keep trigger notes silent.
        ) : midi_trigger==2 || midi_trigger==4 || midi_trigger==6 ? ( // Transpose enabled
          n != basenote ? (
            pattrans_trigger_pending=1;
            pattrans_trigger_note=n;
          );
          cur_note_trigger=1; // Always flag cur_note_trigger to keep trigger notes silent.
        );
      ) : (s==0x90 && vel == 0) || s==0x80 ? ( // Note-off event
        n >= trig_note_start && n < trig_note_start+npatterns ? ( // Note within pattern change trigger range
          cur_note_trigger=1; // Always flag cur_note_trigger, even when already triggered, to keep trigger notes silent.
        ) : midi_trigger==2 || midi_trigger==4 || midi_trigger==6 ? ( // Transpose enabled
          cur_note_trigger=1; // Always flag cur_note_trigger to keep trigger notes silent.
        );
      );
    );
    !cur_note_trigger ? ( // This note was not triggering pattern change
      i_buf < 1024 ? ( // capacity of buf_offset/buf_msg1/buf_msg23 (see @init freemem map);
                       // unchecked, event 1025 would overwrite buf_msg1[0]/buf_msg23[0]/
                       // start_adj_orig_list[0] in one iteration
        buf_offset[i_buf]=offset;
        buf_msg1[i_buf]=msg1;
        buf_msg23[i_buf]=msg23;
        i_buf+=1;
      ) : (
        midisend(offset,msg1,msg23); // overflow: pass through unmodified (same fallback as
                                     // out-of-grid events in the replay loop below)
      );
    );
    cur_note_trigger=0;
    loop_to_start=1; // just to keep while loop repeating
  );
);

beat_position >= start_beatpos ? (
  curbeatpos = beat_position - start_beatpos;
) : (
  chain > 0 && p <= chain ? (
    pat_beats=chain_beats / rate;
  ) : (
    pat_beats=listlength/steps_per_beat / rate;
  );
  curbeatpos = beat_position - (start_beatpos - pat_beats * ceil((start_beatpos - beat_position)/pat_beats));
);

cursplpos=0;
dbeatpos = (tempo * 4.0 / (60.0 * ts_denom * srate));

beat_position_int=beat_position;

loop((play_state&1) ? samplesblock : 1,
  
  play_state_i=play_state;
  (!play_before_start && beat_position_int < start_beatpos) || (end_beatpos > start_beatpos && beat_position_int >= end_beatpos) ? (
    play_state_i&=0xFFFE; // set bit 0 to 0. Prevents playback.
  );
  
  chain > 0 && p <= chain ? (
    chains_passed_full=floor(curbeatpos/(chain_beats / rate));
    beats_remaining=curbeatpos-((curbeatpos/(chain_beats / rate))|0)*(chain_beats / rate);
    chain_preceding_beats=0;
    chain_pat_beats = listlength_pat[0]/steps_per_beat_pat[0] / rate;
    i_cp=0;
    beats_remaining >= chain_pat_beats ? (
      while(
        chain_preceding_beats+=chain_pat_beats;
        i_cp+=1;
        chain_pat_beats = listlength_pat[i_cp]/steps_per_beat_pat[i_cp] / rate;
        chain_preceding_beats+chain_pat_beats < beats_remaining;
      );
    );
    !pat_trigger_pending && i_cp != p && (play_state_i&1) ? (
      pat_trigger_num=i_cp;
      pat_trigger_pending=1;
    );
    curbeatpos_c=curbeatpos-chains_passed_full*(chain_beats / rate)-chain_preceding_beats;
    curbeatpos_c < 0 ? ( // Position outside current pattern. Produces unpredictable behaviour. May happen if a pattern in chain contains incomplete beat(s).
      curbeatpos_c=0;
      debug_hits+=1;
    );
    beatpos=(play_state_i&1) ? (curbeatpos_c * rateadj)%listlength : -100;
    tickpos=(play_state_i&1) ? (curbeatpos_c * rateadj * tpb)%(listlength * tpb) : -100;
  ) : (
    beatpos=(play_state_i&1) ? (curbeatpos * rateadj)%listlength : -100;
    tickpos=(play_state_i&1) ? (curbeatpos * rateadj * tpb)%(listlength * tpb) : -100;
  );
  
  tickpos != ltickpos && (beatpos == lbeatpos) && (play_state_i&1) ? (
    npos=0;
    noneed=noteonstate;
    a = swingstate;
    sdr_t = sdreach; // subdiv-lane reach walk (see the boundary sdreach comment)
    ltiestate_t=ltiestate;
    while(
      // EON GROOVE: unified per-step delay. eff = hand-nudged start offset + the lane's
      // groove-table offset (classic swing compiles to odd-step offsets in the table).
      // Clamped to tpb-1: ticks tops out at 127, so 127 is the last firable tick -- this
      // also makes legacy offset==128 cells (previously silently dropped) fire at tick 127.
      // Subdiv cells use the GROOVE offset only (legacy: swing shifted bursts, getStart
      // never applied to subdivs -- preserved).
      eff = getStart(npos*listlength+beatpos) + groove_off_rt[npos*max_seqlength+beatpos];
      eff > tpb-1 ? eff = tpb-1;
      sdnum=getSubdivNum(npos*listlength+beatpos);
      sdnum == 0 ? ( // not subdiv
        notelen_eff = defnotelen + eff; notelen_eff > tpb ? notelen_eff = tpb;   // ==tpb -> off falls to the boundary (legacy truncation)
        (noneed&1) && notelen_eff == ticks && !(ltiestate_t&1) ? (
          midisend(cursplpos,0x80+chan[npos],npos+basenote+trans[npos]);
          noteonstate -= 2^npos; // exact to lane 48; guarded by (noneed&1) so the bit is
            // provably set. ⚠️NEVER use (1<<npos)/0xFFFFFFFF idioms on lane masks: EEL2
            // shifts are 32-BIT (probe-verified: 1<<40==256) and the old clear here wiped
            // every bit >=32 -- legacy survived only because it rebuilt noteonstate each
            // boundary; the physical invariant does not.
        );
        eff == ticks && (a&1) ? (   // deferred note-on (the a-bit is only set when eff>0)
          is_midi_val(note_to_send = npos+basenote+trans[npos]) ? (
            !(ltiestate_t&1) ? ( // send new note only when there is no tie from previous note
              eon_audible(npos) ? ( // EON: mute/solo gate -- PHYSICAL noteonstate: bit set
                                    // only when the note-on actually left the JSFX
                midisend(cursplpos,0x90+chan[npos],note_to_send + grv_velo(getVelo(npos*listlength+beatpos), npos, beatpos)*256);
                noteonstate |= 2^npos; // pow not shift: EEL2 << is 32-bit, lanes go to 48
              );
            ) : (
              ltiestate-=2^npos; // clear old tiestate; the held note's physical bit was
                                 // already carried across the boundary (deferred-tie branch)
                                 // -- do NOT add it again here
            );
            (swingtiestate & 2^npos) && (beatpos < listlength-1) ? ltiestate+=2^npos; // Set tie state if tie enabled and not last note of sequence
          );
        );
      ) : ( // subdiv note
        ticks > 0 && sd_playstate[2*npos] ? (
          grv_sdo = groove_off_rt[npos*max_seqlength+beatpos];
          grv_sdo > tpb-1 ? grv_sdo = tpb-1;
          sd_ticks=((tpb-grv_sdo) / (sd_playstate[2*npos]+1))|0;
          sd_ticks < 1 ? sd_ticks = 1;   // guard: large groove offsets can zero the spacing
          ticks >= grv_sdo && ((ticks-grv_sdo) % sd_ticks) == 0 ? (
            sdpos=((ticks-grv_sdo)/sd_ticks)|0;
            // PHYSICAL noteonstate per sub-hit: the off is gated on "a hit of this lane is
            // actually sounding" (bit set), not on "previous sd step was enabled" -- the
            // enabled-check made a MUTED ratchet lane spray one note-off per sub-boundary
            // with zero note-ons. For audible lanes timing is identical: the bit is set
            // exactly where the legacy prev-step-enabled check was true. Also retires the
            // (sdpos-1) negative-shift edge at the first deferred hit. All mask math is
            // 2^npos pow -- EEL2 shifts are 32-bit, lanes go to 48 (probe-verified).
            (noteonstate & 2^npos) ? (
              midisend(cursplpos,0x80+chan[npos],npos+basenote+trans[npos]); // note-off previous subdiv note
              noteonstate -= 2^npos; // exact: guarded by the & test above
            );
            (sd_playstate[2*npos+1] >> (sdpos))&1 ? (// current sd step is enabled
              playvelo=grv_velo(getSubdivVelo(npos, beatpos, sdpos), npos, beatpos);
              eon_audible(npos) ? ( // EON: mute/solo gate
                midisend(cursplpos,0x90+chan[npos],npos+basenote+trans[npos] + playvelo*256); // note-on subdiv note
                noteonstate |= 2^npos;
              );
            );
            sdpos==sd_playstate[2*npos] ? sd_playstate[2*npos]=0;
          );
        );
      );
      npos+=1;
      noneed*=0.5;
      ltiestate_t*=0.5;
      sdr_t*=0.5;
      (a*=0.5) >=1 || noneed >= 1 || sdr_t >= 1;
    );
    ticks+=1;
    ltickpos=tickpos;
  );
  
  // Deferred pattern-trigger consume (arbitration retry path). Runs on its OWN
  // every @block — NOT folded into the per-beat block below — because that block
  // is the whole per-beat MIDI engine (note on/off, CC, tie state); re-entering
  // it off a retry would double-send notes/CC. A trigger that landed on a beat
  // while a @gfx pattern gesture was in flight switches a sub-beat late here,
  // once the gesture clears (the intended defer semantics).
  _patdefer_retry && !_ui_patop ? (
    _patdefer_retry = 0;
    pat_trigger_pending ? (
      pat_trigger_pending = 0;
      change_pattern(pat_trigger_num);
      sliderchange(slider1=p);
      sliderchange(slider3=listlength);
    );
  );

  beatpos != lbeatpos || !(play_state_i&1) ? (
    pat_trigger_pending ? (
      _ui_patop ? _patdefer_retry = 1 : (   // gesture in flight → retry next block (above)
        pat_trigger_pending=0;
        change_pattern(pat_trigger_num);
        sliderchange(slider1=p);
        sliderchange(slider3=listlength);
      );
    );
    pattrans_trigger_pending ? (
      pattrans_trigger_pending=0;
      all_playing_notes_off();
      basenote=pattrans_trigger_note;
      sliderchange(slider2=basenote);
      refresh_tb=1;
      ltiestate = 0; // clear all note ties
    );
    
    // Send CC
    (play_state_i&1) ? (
      i_blk=0;
      ccvalues = cclist[beatpos];
      loop(numccs,
        val = getCc(ccvalues, i_blk);
        val & 0x80 && (cc_type[i_blk] < 127)? ( // event enabled and not special type
          midisend(cursplpos, 0xB0 + cc_chan[i_blk], cc_type[i_blk] | ((val&0x7F) << 8));
        );
        i_blk+=1;
      );
    );
    
    (play_state_i&1) ? (
      a = notelist[beatpos];
      // Step probability
      rand_a_play=1;
      cc_type[0] == 127 ? (
        val = getCc(cclist[beatpos], 0);
        (val&0x80) && (rand(127) > val&0x7F) ? rand_a_play=0;
      );
    ) : a = 0;
    
    // a &= recmask; // - multiply for bitmask safety?
                   //stops notes more than 32 above basenote being transmitted
    !(play_state_i&1) ? (
      ltiestate = 0; // clear all note ties if transport is stopped
      memset(sd_playstate, 0, max_numnotes*2); // clear all subdiv states
    );
    npos=0;
    noneed=noteonstate;
    noteonstate=0;
    tiestate=0;
    swingtiestate=0;
    swingstate=0;
    sdreach=0;
    ticks = 0;
    while(
      // EON GROOVE: unified defer decision -- any lane whose step event lands after the
      // boundary (hand offset + groove offset > 0) is flagged into swingstate and fired
      // by the tick loop at ticks==eff. Subdiv cells defer on the GROOVE offset only
      // (legacy semantics: getStart never applied to subdiv bursts).
      eff = getStart(npos*listlength+beatpos) + groove_off_rt[npos*max_seqlength+beatpos];
      eff > tpb-1 ? eff = tpb-1;
      (noneed&1) && !(ltiestate&1) ? (
         midisend(cursplpos,0x80+chan[npos],npos+basenote+trans[npos]); // send note off
      );
      (a&1) && (rand_a_play || chan[npos]!=cc_chan[0] || (ltiestate&1))? (
        sdnum=getSubdivNum(npos*listlength+beatpos);
        sdnum == 0 ? ( // not subdiv
          eff > 0 ? (
            swingstate+=2^npos; // flag a delayed (groove/offset) note to be played by the tick loop
            (notetie[beatpos] & 2^npos) ? swingtiestate+=2^npos;
            (ltiestate&1) ? (
              tiestate+=2^npos; // keep the tiestate
              (noneed&1) ? noteonstate |= 2^npos; // tie into a deferred note: the held note
                // keeps sounding until the tick loop consumes the tie, so carry its PHYSICAL
                // bit across the boundary. (Also closes a legacy hole: transport stop inside
                // this window used to hang the held note -- all_playing_notes_off saw no bit.)
            );
          ) : ( // on-the-boundary note playback

            playvelo=grv_velo(getVelo(npos*listlength+beatpos), npos, beatpos);
            is_midi_val(note_to_send = npos+basenote+trans[npos]) ? (
              // PHYSICAL noteonstate: bit = "a note-on actually left this JSFX and owns a
              // future note-off". Muted lanes set no bit, so they no longer emit note-offs
              // they never earned (those cut live-played notes on gate-mode/ranged pads).
              // Tie continuations INHERIT the sounding note's bit -- gating the set on
              // audibility here would hang tied notes.
              !(ltiestate&1) ? ( // no tie from previous note -> fresh note-on
                eon_audible(npos) ? ( // EON: mute/solo gate
                  midisend(cursplpos,0x90+chan[npos],note_to_send + playvelo*256);
                  noteonstate |= 2^npos; // pow not shift: EEL2 << is 32-bit, lanes go to 48
                );
              ) : (
                (noneed&1) ? noteonstate |= 2^npos; // tie: held note keeps sounding
              );
              (notetie[beatpos] & 2^npos) && (beatpos < listlength-1) ? tiestate+=2^npos; // Set tie state if tie enabled and not last note of sequence
            );
          );
        ) : ( // subdiv note

          sd_playstate[2*npos]=sdnum;
          sd_playstate[2*npos+1]=getSubdivNotelist(npos, beatpos); // sd note enable bits
          sdreach+=2^npos; // REACH (immediate + deferred bursts): the tick loop's while()
            // only iterates lanes while its masks are nonzero. Legacy got reach from the
            // unconditional noteonstate set; with PHYSICAL noteonstate a muted burst sets
            // no bit and the loop could stop short of this lane -- skipping sub-hit
            // processing and mid-burst unmute. DEDICATED mask, not swingstate: swingstate
            // arms the tick loop's deferred NOTE-ON branch via (a&1), and a mid-step
            // pattern change can flip this cell to sdnum==0 -- a swingstate bit would then
            // fire a note-on the sequencer never scheduled. sdreach is consulted by the
            // while() tail ONLY.
          (ltiestate&1) && (noneed&1) ? noteonstate |= 2^npos; // tie held into a ratchet
            // step: carry the sounding note's bit so the first sub-boundary off releases it
            // (legacy released it a full step later via the unconditional bit; without the
            // carry it would hang).
          groove_off_rt[npos*max_seqlength+beatpos] == 0 ? (
            sd_playstate[2*npos+1]&1 ? (// first sd step is enabled
              playvelo=grv_velo(getSubdivVelo(npos, beatpos, 0), npos, beatpos);
              eon_audible(npos) ? ( // EON: mute/solo gate -- PHYSICAL noteonstate
                midisend(cursplpos,0x90+chan[npos],npos+basenote+trans[npos] + playvelo*256); // note-on subdiv note
                noteonstate |= 2^npos; // |= : idempotent vs the tie-carry above
              );
            );
          );
          // Deferred burst (groove offset > 0): every hit incl. the first fires from the
          // tick loop, which maintains noteonstate per sub-hit -- the last AUDIBLE hit
          // leaves its bit set so the boundary note-off still lands. This preserves the
          // post-S1 "last sub-hit of a delayed ratchet" fix WITHOUT the spurious note-off
          // for muted lanes / transport-stop-mid-step that the unconditional set caused.
        );
      );
      npos+=1;
      noneed*=0.5;
      ltiestate*=0.5;
      (a*=0.5) >=1 || noneed >= 1;
    );
    lbeatpos=beatpos;
    recmask = 0xFFFFFFFF;
    ltiestate=tiestate;
  );
  cursplpos += 1;
  curbeatpos += dbeatpos;
  beat_position_int+=dbeatpos;
);

midi_buf_len=i_buf;
i_buf=0;
loop(midi_buf_len,
  offset=buf_offset[i_buf];
  msg1=buf_msg1[i_buf];
  msg23=buf_msg23[i_buf];
  s = msg1&0xF0;
  n=msg23&0x7F;        
  npos=n-basenote;
  (play_state_i==5) ? ( // Recording
    vel=(msg23/256)|0;
    s==0x90 && vel > 0 ? ( // Note-On  
      (npos >= 0 && npos < numnotes) ? (
        mask = 2^npos;
        ticks > (tpb/2) ? ( // Quantize to nearest beatpos 
          bp = (beatpos+1) % listlength; 
          chain > 0 && p <= chain && bp == 0 ? (
            chain_rec_to_next = 1;
          );
        ) : ( 
          bp = beatpos; 
        ); 
        chain_rec_to_next ? ( // record note to next pattern in chain
          rec_p = p+1 % chain;
          rec_p == 0 ? (
            rec_p_notelist=notelist_base;
            rec_p_velolist=velolist_base;
          ) : (
            rec_p_notelist=notelist+listlength;
            rec_p_velolist=velolist+listlength*max_numnotes;
          );
          nlm=(rec_p_notelist[bp] & mask);
          nlm==0 ? ( 
            rec_p_notelist[bp]+=mask; // Record new note
          );
          // Overwrite velocity
          rec_velpos=npos*listlength_pat[rec_p]+bp;
          rec_p_velolist[rec_velpos] &= 0xFFFFFF80; //clear old velocity
          rec_p_velolist[rec_velpos] += vel; //set new velocity
        ) : (
          nlm=(notelist[bp] & mask);
          nlm==0 ? ( 
            notelist[bp]+=mask; // Record new note
          );
          setVelo(npos*listlength+bp, vel); // Overwrite velocity
        );
        recmask -= mask;
        chain_rec_to_next = 0;
      );
    );
  );
  // Transpose notes (Only in in Drum map mode)
  (s == 0x90 || s == 0x80) && npos >= 0 && npos < numnotes ? ( // note-on or note-off, and within visible grid
    is_midi_val(note_to_send = npos+basenote+trans[npos]) ? (
      msg23 = msg23-n+note_to_send; // transpose note
      msg1 = (msg1&0xF0) + chan[npos]; // remap MIDI channel
      midisend(offset,msg1,msg23);
    );
  ) : ( // received note is not within visible grid, or some other event received. -> send unmodified
    midisend(offset,msg1,msg23);
  );
  i_buf+=1;
);

@sample

panic_go ?
(// midi panic to stop all notes
  c = 0;
  while(
    midisend(0, $xE0+c, $x00, $x40);
    midisend(0, $xB0+c, $x7B, $x00);
    c+=1;
    c < 16; 
  );
  panic_go = 0;
);

// for drums set:: @gfx 622+pkw 400+tbh, numnotes = 16, env 1 set to prob?
@gfx 860 594
// ^ The @gfx header takes numeric literals only. This line historically read
// "@gfx 860+pkw 594+4*tbrh+1+13" -- REAPER parsed the numeric prefixes (860, 594)
// and silently ignored the arithmetic (variables don't exist at parse time), so
// 860x594 IS the size every build has ever requested. Hardcoded 2026-08-03 to
// state that honestly; the UI lays itself out from gfx_w/gfx_h at runtime anyway.

// Pattern-op arbitration: gesture-edge detect (see @init note). Raised only
// on click-edge / wheel frames; cleared at the end of this section.
_ui_patop = ((mouse_cap & 3) && ((mouse_cap & 3) != (_uip_prev & 3))) || mouse_wheel ? 1 : 0;

// ── knobs_kbsg frame contract ────────────────────────────────────────────────
// ssl_knob_interact (which mpc_knob_interact delegates to) reads these as plain
// GLOBALS, not arguments: mx/my, LMB, lmb_down, CTRL, dt, hv_speed, frame_wheel.
// StepSeq defined none of them, so nothing is being shadowed here -- verified
// against the whole file before adding. Mirrors EON_Drum_Strip.jsfx:855-863.
// MUST be computed here, at the very top of @gfx: StepSeq zeroes mouse_wheel in
// several handlers further down, so a later frame_wheel would read 0 and the
// knobs would silently never see the wheel.
mx = mouse_x; my = mouse_y;
LMB = mouse_cap & 1;
lmb_down = LMB && !ss_prev_lmb;
ss_prev_lmb = LMB;
CTRL = mouse_cap & 4;            // the lib's FINE-drag modifier (0.1x), not SHIFT
dt = min(time_precise() - ss_last_t, 0.05);   // capped: a stalled GUI must not
ss_last_t = time_precise();                   // jump hover_t a whole second
hv_speed = 11;                                // house hover speed (Drum Strip parity)
frame_wheel = mouse_wheel / 120;

// Lane-knob appearance, resolved to match the PAIRED Swing exactly. Style 0 means
// "follow the theme", same as Swing, so sk_kp is only the fallback -- if the user
// picked a specific style for the pad VOL or PAN knob over in Swing, Steppa's lane
// knobs adopt it too. VOL and PAN are resolved SEPARATELY on purpose: Swing's
// defaults are accent for VOL and accent2 for PAN, so they are different colours,
// and collapsing them onto one role (which an earlier pass here did) is exactly
// what made every lane knob the same flat orange.
ss_th_live = gmem[GS_THEME_ID] > 0;
sk_kp = (ss_th_live && gmem[GS_THEME_KNOB_P] >= 1) ? (gmem[GS_THEME_KNOB_P] | 0) : 1;
ss_pmb    = eon_pair_slot >= 0 ? EON_SW_PADMIX_BASE + eon_pair_slot*EON_SW_PADMIX_STRIDE : -1;
ss_vstyle = ss_pmb >= 0 && gmem[ss_pmb + EON_SW_PADMIX_VSTYLE] > 0 ? (gmem[ss_pmb + EON_SW_PADMIX_VSTYLE]|0) : sk_kp;
ss_pstyle = ss_pmb >= 0 && gmem[ss_pmb + EON_SW_PADMIX_PSTYLE] > 0 ? (gmem[ss_pmb + EON_SW_PADMIX_PSTYLE]|0) : sk_kp;
ss_vappr  = ss_pmb >= 0 ? (gmem[ss_pmb + EON_SW_PADMIX_VAPPR]|0) : 0;
ss_pappr  = ss_pmb >= 0 ? (gmem[ss_pmb + EON_SW_PADMIX_PAPPR]|0) : 0;
// Reset the per-frame knob latches BEFORE the lane headers draw. ss_knob_busy
// tells the click handler a widget owns the mouse; ss_knob_anim asks for another
// frame so hover_t can finish its transition.
ss_knob_busy = 0;
ss_knob_anim = 0;
// Latched once per frame so both knobs in every lane agree, and so the answer
// can't change mid-draw if an overlay flag is written partway through @gfx.
ss_kn_input = ss_knob_input_ok();
_uip_prev = mouse_cap;

// EON: resolve the bridge-assigned pairing each frame. slider48 holds the paired
// Swing's registry SLOT+1, sign = how it was paired (+auto / -manual, 0 = unpaired);
// eon_pair_slot drives lane hue/name reads, eon_pair_manual the dropdown checkmark.
eon_pair_slot   = (abs(slider48)|0) - 1;
eon_pair_manual = slider48 < -0.5;
// EON Sync Mode (Phase 0): read the toggle each frame. Read-only for now — no
// path consumes eon_sync_mode yet, so standalone behaviour is unchanged. Future
// sync code gates on (eon_sync_mode && eon_pair_slot >= 0).
eon_sync_mode   = slider49 > 0.5;
// EON P3b-3b: region-mirroring pattern row. When Sync is ON + paired, the pattern buttons
// mirror the Drum Matrix regions (one per region, hidden when none) instead of the fixed 8.
// DM_RGNCNT (field 14) is published by the bridge (TRUE count, uncapped); floor at 1 so
// pattern 1 ALWAYS shows. Sync OFF -> eon_npat_vis = 8 = the unchanged standalone row.
//
// P3b-4 PAGING: the row physically fits 8 buttons (slots 0-7; the Swing slider owns
// slots 9-13, so anything past slot 8 was never clickable). More than 8 regions ->
// window the row: page P shows ordinals P*8+1 .. P*8+8, a pager pill sits at slot 8
// (left-click next page, right-click menu). Colours (fields 22..37) are published as a
// WINDOW starting at eon_pat_base (we publish SS_PAGE; the bridge slices its list).
// Selection is an ABSOLUTE ordinal (eon_sel_ord, published as SS_SELORD) so flipping
// pages is a pure VIEW change — the synced region only moves on an actual click.
eon_pat_sync = eon_sync_mode && eon_pair_slot >= 0;
// P3b-4f: outside sync the grid backdrop must not keep wearing a region tint
// (eon_selrc is captured by the selected chip's draw, which stops running).
!eon_pat_sync ? eon_selrc = 0;
eon_npat_total = eon_pat_sync ? max(gmem[EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE + EON_SS_SYNC_DM_RGNCNT]|0, 1) : 8;
eon_pat_pages  = ((eon_npat_total + 7) / 8)|0;
eon_pat_page   = min(max(eon_pat_page, 0), eon_pat_pages - 1);
eon_pat_base   = eon_pat_sync ? eon_pat_page * 8 : 0;
eon_npat_vis   = eon_pat_sync ? min(eon_npat_total - eon_pat_base, 8) : 8;
// Is the selected pattern's ordinal on the visible page? Gates every "selected"
// highlight so paging away doesn't light a same-index button on another page.
eon_sel_onpage = !eon_pat_sync || ((((eon_sel_ord - 1) / 8)|0) == eon_pat_page);
// '+' (new region) lives at slot eon_npat_vis — only on the LAST page with a free slot
// (or exactly-8 total, where slot 8 is free because the pager only appears when >8).
eon_pat_addbtn = eon_pat_sync && (eon_pat_base + eon_npat_vis >= eon_npat_total)
                 && (eon_npat_vis < 8 || eon_npat_total == 8);
// P3b-4d NAME CHIPS: sync widens the pattern buttons (pitch eon_pbw) so each can
// carry its region NAME, and packs the row's other occupants right to make room
// (PAIR at busp*22=528 is the hard stop): chips 0..312, pager 314..335, swing
// pill 338..410, VIEW 412..484, CC 487..524. EVERY draw + hit-test site routes
// through these vars and they all collapse to the original busp geometry when
// sync is off — standalone stays byte-identical.
eon_pbw  = eon_pat_sync ? 39 : busp;          // pattern-button pitch (chip w = eon_pbw-3)
eon_swpx = eon_pat_sync ? 338 : busp*9;       // swing pill x
eon_swpw = eon_pat_sync ? 72  : busp*4;       // swing pill width
eon_vwx  = eon_pat_sync ? 412 : busp*14;      // VIEW pill cell x (draw at +2, hit +busp*3)
eon_ccx  = eon_pat_sync ? 487 : busp*18;      // CC toggle cell x (draw at +2)
eon_ccwd = eon_pat_sync ? 34  : busp*3-3;     // CC rect width (hit = cell..cell+eon_ccwd+3)
eon_ccch = eon_pat_sync ? 24  : 32;           // CC chevron x offset within the cell
// Pager hover (slot 8) — tracked here so the refresh-gated toolbar redraws on change.
eon_pg_hov = eon_pat_sync && eon_npat_total > 8
             && mouse_y >= eon_pbh+1 && mouse_y < eon_pbh+tbrh-1
             && mouse_x >= eon_pbw*8+2 && mouse_x < eon_pbw*8+2+busp-3;
eon_pg_hov != eon_l_pg_hov ? (eon_l_pg_hov = eon_pg_hov; refresh_tb = 1;);
// EON: command-button toggle state (SWING / MATRIX) -- read open-state for the highlight,
// force a toolbar redraw on change (toolbar is refresh-gated). Buttons sit top-right (724+).
eon_swopen_now = eon_pair_slot>=0 ? (gmem[EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE + EON_SS_SYNC_SWING_OPEN]|0) : 0;
eon_dmopen_now = gmem[EON_SS_DM_OPEN_STATE]|0;
// AP-4: preset-browser open? Heartbeat fresh AND targeting THIS slot -> the Preset
// strip tints violet (same open-state language as the SWING/MTRX buttons).
eon_psopen_now = ((time_precise() - gmem[EON_SS_BROWSER_ALIVE]) < 0.8
                  && (gmem[EON_SS_BROWSER_SLOT]|0) == (eon_pair_slot>=0 ? eon_pair_slot : 0)) ? 1 : 0;
// FIXED positions (don't move with the window): PAIR | SWING | SYNC | MTRX | cog, just right of CC.
eon_swb_x = 604; eon_syncb_x = 662; eon_mxb_x = 720; eon_cogb_x = 778; eon_cmdb_w = 54;
// Control row: preset strip (fixed) then theme, both packed left after S/Bt.
eon_thx2 = 675; eon_psx = busp*16; eon_psw = 275;
// which command button is hovered (1=SYNC 2=SWING 3=MATRIX) -> hover brighten + redraw on change
eon_cmd_hov = (mouse_y>=eon_pbh && mouse_y<eon_pbh+tbrh) ? (
  mouse_x>=eon_syncb_x && mouse_x<eon_syncb_x+eon_cmdb_w ? 1 :
  mouse_x>=eon_swb_x   && mouse_x<eon_swb_x+eon_cmdb_w   ? 2 :
  mouse_x>=eon_mxb_x   && mouse_x<eon_mxb_x+eon_cmdb_w   ? 3 : 0) : 0;
(eon_swopen_now != eon_l_swopen || eon_dmopen_now != eon_l_dmopen || eon_cmd_hov != eon_l_cmd_hov
 || eon_psopen_now != eon_l_psopen) ? (
  eon_l_swopen=eon_swopen_now; eon_l_dmopen=eon_dmopen_now; eon_l_cmd_hov=eon_cmd_hov;
  eon_l_psopen=eon_psopen_now; refresh_tb=1;);
// Redraw the PAIR button when the pairing or its roster label changes (toolbar is
// refresh-gated; without this the label would only update on the next forced redraw).
slider48 != eon_lpair48 ? (eon_lpair48 = slider48; refresh_tb = 1;);
eon_prsum = 0;
eon_pair_slot >= 0 ? (
  eon_pri = 0;
  loop(GS_SS_ROSTER_STRIDE,
    eon_prsum += gmem[GS_SS_ROSTER_BASE + eon_pair_slot*GS_SS_ROSTER_STRIDE + eon_pri];
    eon_pri += 1;
  );
);
eon_prsum != eon_lprsum ? (eon_lprsum = eon_prsum; refresh_tb = 1;);
// E-2: repaint the lane M/S pills when the PAD band mute/solo changes — pad
// edits land in the band (Swing buttons, TCP mutes via the bridge, browser),
// not in the local lane arrays, so the pill strip must watch the band.
eon_msdig = 0;
eon_pair_slot >= 0 ? (
  eon_pri = 0;
  loop(16,
    eon_msdig += gmem[EON_ID_BASE + eon_pair_slot*EON_ID_STRIDE + eon_pri*EON_ID_FIELDS + EON_ID_MUTE]
               + gmem[EON_ID_BASE + eon_pair_slot*EON_ID_STRIDE + eon_pri*EON_ID_FIELDS + EON_ID_SOLO] * 2;
    eon_pri += 1;
  );
);
eon_msdig != eon_lmsdig ? (eon_lmsdig = eon_msdig; refresh_pianokeys = 1;);
// P3b-4c: repaint the SONG strip when the bridge republishes the chain or the
// playing entry advances (the toolbar is refresh-gated; without this the strip
// would only update on the next forced redraw). Also keep it live under the
// mouse so hover/drag feedback tracks the cursor.
eon_song_dig = 0;
(eon_pair_slot >= 0 && eon_song_on) ? (
  eon_song_dig = gmem[EON_SS_SONG_BASE + eon_pair_slot*EON_SS_SONG_STRIDE]
               + gmem[EON_SS_SONG_BASE + eon_pair_slot*EON_SS_SONG_STRIDE + 3]*131
               + gmem[EON_SS_SONG_BASE + eon_pair_slot*EON_SS_SONG_STRIDE + 2]*997;
);
eon_song_dig != eon_lsongdig ? (eon_lsongdig = eon_song_dig; refresh_tb = 1;);
(eon_song_vis && mouse_y >= eon_song_y-2 && mouse_y < eon_song_y+eon_song_h) ? (refresh_tb = 1;);
// P3b-4d: the chips render NAMES from the refresh-gated toolbar, so repaint when
// the published window changes. The key fields alone don't move on a same-page
// rename — fold the first 8 chars of each windowed name into the digest too.
eon_name_dig = 0;
(eon_pat_sync && eon_pair_slot >= 0) ? (
  eon_name_dig = gmem[EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE + EON_SS_SYNC_NAMEPAGE]
               + gmem[EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE + EON_SS_SYNC_NAMESEL]*131;
  eon_pri = 0;
  loop(64,
    eon_name_dig += gmem[EON_SS_RGNNAME_BASE + eon_pair_slot*EON_SS_RGNNAME_STRIDE
                         + ((eon_pri/8)|0)*32 + (eon_pri%8)] * (eon_pri+3);
    eon_pri += 1;
  );
);
eon_name_dig != eon_lnamedig ? (eon_lnamedig = eon_name_dig; refresh_tb = 1;);

// EON: piano toggle -> dynamic toolbar height. eon_pbh = piano body height (0 when hidden);
// every toolbar row below the piano is positioned relative to it. Default shown = unchanged layout.
eon_pbh = 8 + (slider17 < 0.5 ? 0 : (slider17 < 1.5 ? 2*tbrh : (slider17 < 2.5 ? 3*tbrh : (slider17 < 3.5 ? 5*tbrh : 4*tbrh))));   // EON: +8 top margin (was 0); Off, Piano=2, Pads8=3, Pads16=5, Manual=4 rows
eon_r2  = eon_pbh + tbrh + 6;   // EON: control-row TOP = pattern-row bottom + 6px gap between the two rows
eon_r2b = eon_r2 + tbrh;        // EON: control-row BOTTOM (all control-row draws/hit-tests route through these)
// P3b-4c: optional SONG strip row between the control row and the beat ruler.
// Runtime-only toggle (no @serialize churn); the tbh != ltbh watcher below
// already forces the full-redraw + grid recalc when it opens/closes, and the
// ruler is tbh-relative so it slides down for free. Sync-mode + EON theme only.
eon_song_vis = (colorscheme==10 && eon_pat_sync && eon_song_on) ? 1 : 0;
eon_song_h = eon_song_vis ? tbrh+4 : 0;
eon_song_y = eon_r2b + 2;       // strip row top (only meaningful when eon_song_vis)
// Column-header strip: a thin row directly above the lanes, carrying one cell per
// lane-header column. Same shape as the SONG strip above -- its height folds into
// tbh, so the lanes, ruler and grid all reflow for free and every tbh-relative
// hit-test stays correct without being touched. Drum mode + EON theme only, since
// those are the only conditions under which the columns themselves exist.
eon_colhdr_vis = (colorscheme==10 && mode==1) ? 1 : 0;
eon_colhdr_h   = eon_colhdr_vis ? 13 : 0;
eon_colhdr_y   = eon_r2b + 1 + eon_song_h;   // sits just under SONG, just above the ruler
tbh = eon_r2b + 1 + eon_song_h + eon_colhdr_h + 13;
tbh != ltbh ? (recalc_elh=1; eon_pdraw=6; ltbh=tbh;);   // layout changed -> force redraws so BOTH double-buffers get it
slider17 != lslider17 ? (eon_pdraw=6; lslider17=slider17;);   // view switch (piano<->pads<->off) -> force strip redraw
gmem[GS_THEME_ID] != eon_last_theme_id ? (eon_last_theme_id = gmem[GS_THEME_ID]; eon_pdraw=6;);   // EON: theme band republished -> force full re-skin redraw (cached double-buffer wouldn't update otherwise)
eon_pdraw > 0 ? (refresh_tb=1; refresh_pianokeys=1; refresh_cc_controls=1; eon_pdraw -= 1;);  // no blank-flash on toggle
// keep the top strip live while the mouse is over it -> hover read-out tracks the cursor
(colorscheme==10 && slider17 >= 0.5 && mouse_x >= 0 && mouse_x < gfx_w && mouse_y >= 0 && mouse_y < eon_pbh) ? (refresh_tb=1;);

recalc_elh || lgfx_h != gfx_h? (
  recalc_elh=0;
  elh=(gfx_h - tbh) * elh_percent|0;
  elh < el_divh ? elh = el_divh; //keep lane divider always visible
  grid_bottom=gfx_h - elh;
  refresh_pianokeys=1;
  refresh_cc_controls=1;
);
  
function draw_button(x, y)
(
  colorscheme==10 ? ( // EON: rounded, beveled button (Saike-style, MIT)
    eon_nice_button(x+2, y+1, busp-3, tbrh-2, 58/255, 64/255, 76/255, 96/255, 104/255, 120/255);
  ) : (
    color(1);
    gfx_x=x+2;gfx_y=y+1;
    gfx_rectto(gfx_x+busp-2,y+tbrh-1);
  );
);

function draw_button_highlight(x, y)
(
  colorscheme==10 ? ( // EON: teal hover glow, rounded
    gfx_set(0, 0.72, 0.86, 0.28);
    roundRect(x+2, y+1, busp-3, tbrh-2, 3, 1);
  ) : (
    color(2);
    gfx_x=x+2;gfx_y=y+1;
    gfx_rectto(gfx_x+busp-2,y+tbrh-1);
  );
);

function draw_pat_button(patnum, x, y, hl) local(bx, by, bw, bh, bw_lum, eon_cl, eon_issel, eon_plbl)
(
  // banks removed: patnum is the pattern index directly (one row)
  // P3b-4 paging: "selected" only lights when the selected ordinal is on the visible
  // page (eon_sel_onpage); the number label shows the region ORDINAL in sync.
  eon_issel = patnum==p && eon_sel_onpage;
  eon_plbl  = eon_pat_sync ? eon_pat_base + patnum + 1 : patnum + 1;
  colorscheme==10 ? ( // EON: each pattern its own hue; brightness shows active / has-notes / empty
    bx = x*eon_pbw+2; by = y+1; bw = eon_pbw-3; bh = tbrh-2;   // P3b-4d: sync = wide name chips
    (eon_issel && eon_pat_big) ? (bx-=3; by-=3; bw+=6; bh+=5;);   // EON: selected button drawn enlarged (2nd pass, on top)
    pattern_hue[patnum] < 0 ? (   // MPC cream / housing pattern
      eon_cl = eon_issel ? 1.0 : (has_notes[patnum] ? 0.70 : 0.52);
      gfx_r=0.84*eon_cl; gfx_g=0.81*eon_cl; gfx_b=0.76*eon_cl;
    ) : (
      eon_hsl2rgb(pattern_hue[patnum], 0.62, eon_issel ? 0.56 : (has_notes[patnum] ? 0.31 : 0.20));
    );
    // EON P3b-3b: in sync, the button = its DM region's actual colour (bridge-published, packed
    // r*65536+g*256+b), brightness-scaled for active/has-notes/empty so selection still reads.
    // P3b-4: field 22+patnum is a PAGE WINDOW (bridge slices at SS_PAGE), so index by button.
    eon_pat_sync ? (
      eon_rc = gmem[EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE + EON_SS_SYNC_RGNCOL + patnum]|0;
      // P3b-4f: the grid backdrop tint follows the SELECTED chip's region
      // colour — captured here (0 = colourless region -> backdrop falls back
      // to its standalone look) so the two can never disagree on what
      // "selected" or "its colour" means.
      eon_issel ? eon_selrc = eon_rc;
      eon_rc > 0 ? (
        eon_rcl = eon_issel ? 1.0 : (has_notes[patnum] ? 0.66 : 0.46);
        gfx_r = ((eon_rc/65536)|0)/255*eon_rcl;
        gfx_g = (((eon_rc/256)|0)%256)/255*eon_rcl;
        gfx_b = (eon_rc%256)/255*eon_rcl;
      );
    );
    bw_lum = gfx_r*0.30 + gfx_g*0.59 + gfx_b*0.11;   // fill luminance -> number contrast
    gfx_a=1; gfx_rect(bx, by, bw, bh);
    (chain > 0 && chain >= patnum) ? (setcolor(0,205,238,255); gfx_rect(bx, by, bw, 2););  // chain stripe (top)
    eon_issel ? (
      // SELECTED: dark outer keyline (pops against the grid) + bright 2px inner ring +
      // a bold accent bar across the bottom (selected-tab style) = unmistakable.
      gfx_set(0.05,0.06,0.08,0.95); gfx_rect(bx-1,by-1,bw+2,1); gfx_rect(bx-1,by+bh,bw+2,1); gfx_rect(bx-1,by-1,1,bh+2); gfx_rect(bx+bw,by-1,1,bh+2);
      gfx_set(0.99,1.0,1.0,1.0); gfx_rect(bx,by,bw,2); gfx_rect(bx,by+bh-2,bw,2); gfx_rect(bx,by,2,bh); gfx_rect(bx+bw-2,by,2,bh);
      gfx_set(0.0,0.86,1.0,1.0); gfx_rect(bx+2, by+bh-3, bw-4, 3);   // cyan accent bar
    );
    bw_lum > 0.52 ? setcolor(26,30,36,255) : setcolor(238,244,250,255);
    // Adaptive chip label (user 2026-07-03): fetch the region name FIRST
    // (window-keyed: NAMEPAGE must match our page so a flip can't paint stale
    // names). A region still wearing its DEFAULT "Pattern N" name draws the
    // classic big number — the name is redundant next to the ordinal. A
    // RENAMED region flips to name-first: bold 11px name + tiny 7px ordinal.
    eon_pnhas = 0;
    (eon_pat_sync
     && (gmem[EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE + EON_SS_SYNC_NAMEPAGE]|0) == eon_pat_base + 1) ? (
      eon_rgnname(patnum, #eon_pchp, 31);
      sprintf(#eon_pdef, "Pattern %d", eon_plbl);
      eon_pnhas = strlen(#eon_pchp) > 0 && strcmp(#eon_pchp, #eon_pdef) != 0;
    );
    eon_pnhas ? (
      gfx_setfont(7, "Verdana", 7);
      gfx_x = x*eon_pbw+4; gfx_y = (y+tbrh/2-3)|0;
      gfx_drawnumber(eon_plbl, 0);
      gfx_setfont(7, "Verdana", 11, 'b');
      eon_pcx  = x*eon_pbw + (eon_plbl < 10 ? 12 : 17);
      eon_pcaw = bx + bw - eon_pcx - 2;
      eon_pcaw > 8 ? (
        strcpy(#eon_pchpt, #eon_pchp);
        gfx_measurestr(#eon_pchpt, eon_pcnw, eon_pcnh);
        while(strlen(#eon_pchpt) > 1 && eon_pcnw > eon_pcaw) (
          strncpy(#eon_pchpt, #eon_pchp, strlen(#eon_pchpt)-1);
          gfx_measurestr(#eon_pchpt, eon_pcnw, eon_pcnh);
        );
        gfx_x = eon_pcx; gfx_y = (y+tbrh/2-6)|0;
        gfx_drawstr(#eon_pchpt);
      );
      gfx_setfont(0);
    ) : (
      gfx_x=x*eon_pbw+5; gfx_y=(y+tbrh/2-4)|0;
      eon_plbl < 10 ? gfx_x+=4;
      gfx_drawnumber(eon_plbl, 0);
    );
    hl ? (gfx_set(1,1,1,0.16); gfx_rect(bx, by, bw, bh););
    // EON AP-4: select-flash -- the button flashes bright then fades, plus an outward ripple.
    (patnum == eon_pat_flash_p && eon_pat_flash > 0.02) ? (
      gfx_set(1,1,1, eon_pat_flash*0.6); gfx_rect(bx, by, bw, bh);                  // white fill flash
      eon_fexp = (1 - eon_pat_flash) * 7;
      gfx_set(0.0,0.86,1.0, eon_pat_flash);
      gfx_rect(bx-eon_fexp,        by-eon_fexp,        bw+2*eon_fexp, 1);            // top
      gfx_rect(bx-eon_fexp,        by+bh+eon_fexp-1,   bw+2*eon_fexp, 1);            // bottom
      gfx_rect(bx-eon_fexp,        by-eon_fexp,        1, bh+2*eon_fexp);            // left
      gfx_rect(bx+bw+eon_fexp-1,   by-eon_fexp,        1, bh+2*eon_fexp);            // right
    );
  ) : (
    chain > 0 && chain >= patnum ? (color(3);) : (color(1););
    gfx_x=x*eon_pbw+2;gfx_y=y+1;
    gfx_rectto(gfx_x+eon_pbw-2, y+tbrh-1);
    chain >patnum ? (color(3); gfx_y=y+tbrh/2-3; gfx_rectto(gfx_x+2,gfx_y+6););
    eon_issel ? (color(4);) : has_notes[patnum] ? (color(5);) : (color(6););
    gfx_x=x*eon_pbw+5; gfx_y=(y+tbrh/2-4)|0;
    eon_plbl < 10 ? gfx_x+=4;
    gfx_drawnumber(eon_plbl, 0);
    hl ? draw_button_highlight(x*eon_pbw,y);
  );
);

function eon_btn_frame(x, y, cells) ( // EON: rounded pill frame for wide toolbar controls (diamond otherwise)
  colorscheme==10 ? (
    eon_nice_button(x+2, y+1, busp*cells-3, tbrh-2, 58/255, 64/255, 76/255, 96/255, 104/255, 120/255);
  ) : (
    color(1);
    gfx_x=x+2; gfx_y=y+1;
    gfx_lineto(gfx_x+(busp*cells-2-1), gfx_y, 0);
    gfx_lineto(gfx_x, gfx_y+(tbrh-2-1), 0);
    gfx_lineto(gfx_x-(busp*cells-2-1), gfx_y, 0);
    gfx_lineto(gfx_x, gfx_y-(tbrh-2-1), 0);
  );
);

// ─────────────────────────────────────────────────────────────────────────────
// EON P3b-4c: SONG strip — a drag-and-drop chain of pattern references (the
// bridge's pattern_song engine; project-global, non-destructive). The JSFX only
// RENDERS the bridge-published snapshot and POSTS commands; it never owns chain
// state, so edits cannot echo. Shared geometry (eon_sg_*) is computed by
// eon_song_geom() so the renderer and the mouse hit-tests always agree.
// ─────────────────────────────────────────────────────────────────────────────
function eon_song_geom() (
  eon_sg_b   = EON_SS_SONG_BASE + (eon_pair_slot >= 0 ? eon_pair_slot : 0)*EON_SS_SONG_STRIDE;
  eon_sg_len = min(gmem[eon_sg_b+1]|0, EON_SS_SONG_MAX);
  eon_sg_x0  = busp*2 + 2;                       // chips start after the PLAY + LOOP cells (ZOOM moved to the control row, under the cog)
  eon_sg_avail = gfx_w - eon_sg_x0 - 8;
  // P3b-4e: cap 84px (room for ordinal + name); chips squeeze as the chain grows
  // and drop the name text below ~30px (the ordinal + colour still read).
  eon_sg_cw  = eon_sg_len > 0 ? max(14, min(84, (eon_sg_avail/eon_sg_len)|0)) : busp;
);
// Post one song command (payload first, OP, then the REQ bump LAST — the bridge
// edge-detects REQ). Seed the counter above whatever gmem already holds so a
// JSFX reload can't replay a stale request.
function eon_song_cmd(op, a1, a2) (
  eon_pair_slot >= 0 ? (
    gmem[EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE + EON_SS_SYNC_SONG_A1] = a1;
    gmem[EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE + EON_SS_SYNC_SONG_A2] = a2;
    gmem[EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE + EON_SS_SYNC_SONG_OP] = op;
    eon_songreq_seq = max(eon_songreq_seq, gmem[EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE + EON_SS_SYNC_SONG_REQ]|0) + 1;
    gmem[EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE + EON_SS_SYNC_SONG_REQ] = eon_songreq_seq;
  );
);
// ── Column-header strip ──────────────────────────────────────────────────────
// One cell per lane-header column, sitting directly above the lanes and aligned
// to them via eon_colx/eon_colw (recorded by eon_ms_geo, so a cell can never land
// somewhere its column isn't). A VISIBLE column shows its initial and hides on
// click. A HIDDEN column collapses to a stub carrying a right-pointing chevron --
// that arrow is the only thing keeping a hidden column reachable in place, rather
// than only from the Settings panel.
// Deliberately NOT a toggle-anywhere row: the click target is the cell itself, so
// the gesture is "click the thing you want gone / back", which is what makes it
// read like the SONG strip rather than a settings row that happens to be inline.
function draw_col_header() local(i, cx, cw, on, lbl, hot, pin) (
  eon_colhdr_vis ? (
    gfx_set(0.045, 0.060, 0.085, 1);
    gfx_rect(0, eon_colhdr_y, pkw, eon_colhdr_h);
    gfx_setfont(8, "Verdana", 9);
    i = 0;
    loop(7,
      cx = eon_colx[i]; cw = eon_colw[i];
      cw > 0 ? (
        on  = eon_colvis & (2^i);
        hot = mouse_y >= eon_colhdr_y && mouse_y < eon_colhdr_y + eon_colhdr_h
              && mouse_x >= cx && mouse_x < cx + cw;
        lbl = i==0 ? $'I' : i==1 ? $'N' : i==2 ? $'M' : i==3 ? $'S' : i==4 ? $'V' : i==5 ? $'P' : $'W';
        on ? (
          // PINNED = icon/name where this is the last one of the pair still showing.
          // It cannot be turned off (a lane with neither has no identity), so it is
          // drawn muted with a dot rather than looking like a live toggle that
          // silently ignores clicks. Amber reads "held", not "active".
          pin = (i < 2) && ((eon_colvis & 3) != 3);
          pin ? ( hot ? gfx_set(0.34,0.28,0.13,1) : gfx_set(0.20,0.17,0.10,1); )
              : ( hot ? gfx_set(0.16,0.34,0.42,1) : gfx_set(0.10,0.13,0.18,1); );
          gfx_rect(cx, eon_colhdr_y+1, max(1,cw-1), eon_colhdr_h-2);
          pin ? ( hot ? gfx_set(0.98,0.84,0.45,1) : gfx_set(0.62,0.52,0.28,1); )
              : ( hot ? gfx_set(0.95,0.97,1.0,1) : gfx_set(0.48,0.52,0.58,1); );
          gfx_x = cx + ((cw-5)*0.5)|0; gfx_y = eon_colhdr_y+2; gfx_drawchar(lbl);
          // pin dot, top-right of the cell — survives at 9px where a padlock glyph would not
          pin && cw >= 12 ? gfx_circle(cx+cw-4, eon_colhdr_y+3, 1.5, 1, 1);
        ) : (
          // collapsed -> chevron. Drawn as a small triangle rather than a glyph so
          // it reads at 9px, where a font arrow turns to mush.
          hot ? gfx_set(0.28,0.55,0.66,1) : gfx_set(0.20,0.24,0.30,1);
          gfx_rect(cx, eon_colhdr_y+1, max(1,cw-1), eon_colhdr_h-2);
          hot ? gfx_set(0.95,0.97,1.0,1) : gfx_set(0.62,0.66,0.72,1);
          gfx_triangle(cx+3, eon_colhdr_y+3, cx+3, eon_colhdr_y+eon_colhdr_h-4, cx+7, eon_colhdr_y+(eon_colhdr_h*0.5)|0);
        );
      );
      i += 1;
    );
  );
);

function draw_song_strip() local(y, h, e, cx, v, ord, rep, col, lum, playing, curent, lp, cy) (
  eon_song_geom();
  y = eon_song_y; h = tbrh - 2;
  playing = gmem[eon_sg_b+2]|0; curent = gmem[eon_sg_b+3]|0; lp = gmem[eon_sg_b+4]|0;
  gfx_set(0.045, 0.060, 0.085, 1); gfx_rect(0, y-2, gfx_w, eon_song_h-2);   // row backdrop
  cy = y + h*0.5;
  // PLAY/STOP cell — mirrors the TRANSPORT (lit red square whenever the DAW
  // plays, from any source; triangle = start the song / plain play when empty)
  eon_nice_button(2, y, busp-3, h, 58/255, 64/255, 76/255, 96/255, 104/255, 120/255);
  playing ? (
    gfx_set(1.0, 0.45, 0.35, 1); gfx_rect((2+(busp-3)*0.5-4)|0, (cy-4)|0, 8, 8);
  ) : (
    gfx_set(0.35, 0.95, 0.55, 1);
    gfx_triangle(2+(busp-3)*0.5-3, cy-5, 2+(busp-3)*0.5-3, cy+5, 2+(busp-3)*0.5+6, cy);
  );
  // LOOP cell — mirrors the DAW's transport REPEAT (cyan when on)
  eon_nice_button(busp+2, y, busp-3, h, 58/255, 64/255, 76/255, 96/255, 104/255, 120/255);
  lp ? gfx_set(0.0, 0.86, 1.0, 1) : gfx_set(0.55, 0.60, 0.68, 1);
  gfx_circle((busp+2+(busp-3)*0.5)|0, cy|0, 5, 0, 1);
  gfx_triangle(busp+2+(busp-3)*0.5+3, cy-7, busp+2+(busp-3)*0.5+8, cy-4, busp+2+(busp-3)*0.5+3, cy-1);
  // (ZOOM cell removed — the song/pattern zoom buttons live in the control
  // row under the settings cog now, available even with this strip hidden.)
  // Chips: region colour fill + ordinal + xN repeats badge + playing ring
  gfx_setfont(6, "Verdana", 10, 'b');
  eon_sg_len == 0 ? (
    gfx_set(0.45, 0.50, 0.58, 0.9); gfx_x = eon_sg_x0 + 4; gfx_y = (cy-5)|0;
    gfx_drawstr("drag patterns here");
  ) : (
    e = 0;
    loop(eon_sg_len,
      cx = eon_sg_x0 + e*eon_sg_cw;
      v = gmem[eon_sg_b + 8 + e*2]|0; ord = v % 256; rep = (v/256)|0; rep < 1 ? rep = 1;
      col = gmem[eon_sg_b + 8 + e*2 + 1]|0;
      col > 0 ? (
        gfx_r = ((col/65536)|0)/255*0.72; gfx_g = (((col/256)|0)%256)/255*0.72; gfx_b = (col%256)/255*0.72;
      ) : ( gfx_r = 0.30; gfx_g = 0.33; gfx_b = 0.40; );
      gfx_a = 1; gfx_rect(cx, y, eon_sg_cw-2, h);
      (playing && curent == e+1) ? (   // playing entry: bright ring
        gfx_set(0.99, 1.0, 1.0, 1);
        gfx_rect(cx, y, eon_sg_cw-2, 1); gfx_rect(cx, y+h-1, eon_sg_cw-2, 1);
        gfx_rect(cx, y, 1, h); gfx_rect(cx+eon_sg_cw-3, y, 1, h);
      );
      lum = gfx_r*0.30 + gfx_g*0.59 + gfx_b*0.11;
      lum > 0.52 ? gfx_set(0.10, 0.12, 0.14, 1) : gfx_set(0.93, 0.96, 0.98, 1);
      gfx_x = cx + 3; gfx_y = (cy-5)|0; gfx_drawnumber(ord, 0);
      // P3b-4e: entry's region NAME beside the ordinal (SONGNAME band; written by
      // the bridge before every GEN bump). Skipped when the chain squeezes chips
      // too narrow; truncated by measurestr to the room left of the xN badge.
      eon_sg_cw >= 30 ? (
        eon_songname(e, #eon_sgnm, 15);
        strlen(#eon_sgnm) > 0 ? (
          eon_sgnx  = cx + (ord < 10 ? 14 : 20);
          eon_sgnaw = cx + eon_sg_cw - eon_sgnx - (rep > 1 ? 16 : 4);
          eon_sgnaw > 8 ? (
            strcpy(#eon_sgnmt, #eon_sgnm);
            gfx_measurestr(#eon_sgnmt, eon_sgnw, eon_sgnh);
            while(strlen(#eon_sgnmt) > 1 && eon_sgnw > eon_sgnaw) (
              strncpy(#eon_sgnmt, #eon_sgnm, strlen(#eon_sgnmt)-1);
              gfx_measurestr(#eon_sgnmt, eon_sgnw, eon_sgnh);
            );
            gfx_x = eon_sgnx; gfx_y = (cy-5)|0; gfx_drawstr(#eon_sgnmt);
          );
        );
      );
      (rep > 1 && eon_sg_cw >= 20) ? (
        gfx_x = cx + eon_sg_cw - 16; gfx_y = y + 1;
        gfx_drawstr("x"); gfx_drawnumber(rep, 0);
      );
      e += 1;
    );
  );
  gfx_setfont(0);
);

function draw_mode_button(x,y,hl)
(
  colorscheme==10 ? (
    // EON: render with Saike's selection-button widget (rk_widgets, MIT). Click is
    // still handled by the toolbar's button==0 hit-test on this same rect; this draws
    // the active-mode state (teal = DRUM map, amber = piano/KEYS) + queues a tooltip.
    mode==1 ? (knob_font_color_r=0;    knob_font_color_g=0.80; knob_font_color_b=0.95;)
            : (knob_font_color_r=0.92; knob_font_color_g=0.70; knob_font_color_b=0.28;);
    knob_font_color_a=1;
    selection_button_r=0.10; selection_button_g=0.12; selection_button_b=0.16;
    drawSelectionButton(mode ? "DM" : "PR", x+2, y+1, busp-3, tbrh-2, mode, -mode, "Toggle Drum-map / Piano-roll mode");
  ) : (
    draw_button(x,y);
    color(37);
    gfx_x=x+4; gfx_y=y+5;
    mode == 0 ? ( gfx_printf("PR"); ) : ( gfx_printf("DM"); );
    hl ? draw_button_highlight(x,y);
  );
);

function draw_patshift_button(x,y,hl)
(
  draw_button(x,y);
  color(37);
  gfx_x=x+4; gfx_y=y+5;
  patternmode==0?(pat_shift == 0 ? (
    gfx_printf("++");
  ) : (
    gfx_printf("--");
  ););
  hl ? draw_button_highlight(x,y);
);

function draw_panic_button(x,y,hl)
(
  draw_button(x,y);
  color(37);
  gfx_x=x+8.5; gfx_y=y+5;
  gfx_printf("!");
  gfx_circle(x+12,y+8.5,6); 
  gfx_circle(x+12,y+8.5,6.5); 
  hl ? draw_button_highlight(x,y);
);

function draw_startmode_button(x,y,hl)
(
  draw_button(x,y);
  color(37);
  gfx_x=x+4; gfx_y=y+5;
  play_before_start == 0 ? (
    gfx_drawchar($' ');
    gfx_x-=3;
    gfx_drawchar($'|');
    gfx_x-=2;
    gfx_drawchar($'>');
  ) : (
    gfx_drawchar($'>');
    gfx_x-=3;
    gfx_drawchar($'|');
    gfx_x-=2;
    gfx_drawchar($'>');
  );
  hl ? draw_button_highlight(x,y);
);

function draw_position_display(x, y, hl, value)
(
  eon_btn_frame(x, y, 2);
  
  // Draw value
  color(38);
  gfx_x=x+6; gfx_y=y+5;
  value < 0 && abs(value) >= 100 ? (
    gfx_printf(" --- ");
  ) : value < 0 && abs(value) >= 10 ? (
    gfx_drawnumber(value,1);
  ) : value < 0 ? (
    gfx_drawnumber(value,2);
  ) : value < 10 ? (
    gfx_drawnumber(value,3);
  ) : value < 100 ? (
    gfx_drawnumber(value,2);
  ) : value < 1000 ? (
    gfx_drawnumber(value,1);
  ) : (
    gfx_x+=4;
    gfx_drawnumber(value,0);
  );
  hl ? (
    color(2);
    gfx_x=x+2;gfx_y=y+1;
    gfx_rectto(gfx_x+(busp*2-2),gfx_y+(tbrh-2));
  );
);

function draw_slider(x,y,pos)
(
  eon_btn_frame(x, y, 6);
  // value-fill bar (teal in EON), inset so it stays inside the rounded frame
  colorscheme==10 ? (gfx_set(0, 0.62, 0.76, 0.5);) : (color(1); gfx_a=0.5;);
  gfx_x=x+3;gfx_y=y+2;
  gfx_rectto(gfx_x+(busp*6-4-1)*pos, gfx_y+(tbrh-4-1));
);

function draw_slider_highlight(x, y)
(
  color(2);
  gfx_x=x+2;gfx_y=y+1;
  gfx_rectto(gfx_x+(busp*6-2), gfx_y+(tbrh-2));
);

function draw_z_space_highlight(x, y, z)
(
  color(2);
  gfx_x=x+2;gfx_y=y+1;
  gfx_rectto(gfx_x+(busp*z-2), gfx_y+(tbrh-2));
);

function draw_notelen_slider(x, y, hl) local(pw, ph, fw, frac, intens)
(
  pw = busp*4 - 4; ph = tbrh - 4;
  gfx_set(0.10,0.12,0.14,1); gfx_rect(x+2, y+2, pw, ph);
  frac = notelen_p/100;
  fw = (pw*frac)|0; intens = 0.50 + 0.50*frac;
  gfx_set(0.92*intens, 0.58*intens, 0.12*intens, 1); fw > 0 ? gfx_rect(x+2, y+2, fw, ph);  // amber
  hl ? (
    gfx_set(1,1,1,0.10); gfx_rect(x+2, y+2, pw, ph);
    gfx_set(0.45,0.86,0.96,0.9); gfx_rect(x+2, y+2, pw, 1); gfx_rect(x+2, y+ph+1, pw, 1);
  );
  gfx_set(0.93,0.96,0.99,1); gfx_setfont(0);
  gfx_x=x+8; gfx_y=y+5; gfx_printf("Note %d%%", notelen_p);
);

function draw_swing_slider(x, y, hl) local(pw, ph, fw, intens)
(
  // EON: fill-bar pill. The fill = swing amount; its colour INTENSITY also scales with the
  // amount (dim at low, bright cyan at high) so you read "how swung" at a glance. hl = hover.
  // P3b-4d: width from eon_swpw (compacted + moved right when sync's name chips need room).
  pw = eon_swpw - 4; ph = tbrh - 4;
  gfx_set(0.10,0.12,0.14,1); gfx_rect(x+2, y+2, pw, ph);                       // track
  fw = (pw * (swing_p/100))|0;
  intens = 0.28 + 0.72*(swing_p/100);
  gfx_set(0, 0.66*intens, 0.82*intens, 1); fw > 0 ? gfx_rect(x+2, y+2, fw, ph); // fill
  hl ? (
    gfx_set(1,1,1,0.10); gfx_rect(x+2, y+2, pw, ph);                            // hover brighten
    gfx_set(0.45,0.86,0.96,0.9); gfx_rect(x+2, y+2, pw, 1); gfx_rect(x+2, y+ph+1, pw, 1);  // hover edges
  );
  gfx_set(0.93,0.96,0.99,1); gfx_setfont(0);
  // EON GROOVE: a picked master groove shows its name (amber) instead of "Swing";
  // right-click opens the groove menu, left-drag stays strength.
  master_groove > 0 ? (
    gfx_set(0.96,0.80,0.38,1);
    grv_name(#grv_mn, master_groove|0, eon_pat_sync ? 4 : 7);
    gfx_x=x+5; gfx_y=y+5; gfx_printf("%s %d", #grv_mn, swing_p);
  ) : eon_pat_sync ? (
    gfx_x=x+5; gfx_y=y+5; gfx_printf("Swg %d", swing_p);
  ) : (
    gfx_x=x+9; gfx_y=y+5; gfx_printf("Swing %d%%", swing_p);
  );
);

function draw_patternlen_slider(x, y, hl) local(pw, ph, fw, frac, intens)
(
  pw = busp*4 - 4; ph = tbrh - 4;
  gfx_set(0.10,0.12,0.14,1); gfx_rect(x+2, y+2, pw, ph);
  frac = listlength/max_seqlength;
  fw = (pw*frac)|0; intens = 0.50 + 0.50*frac;
  gfx_set(0.56*intens, 0.40*intens, 0.92*intens, 1); fw > 0 ? gfx_rect(x+2, y+2, fw, ph);  // purple
  hl ? (
    gfx_set(1,1,1,0.10); gfx_rect(x+2, y+2, pw, ph);
    gfx_set(0.45,0.86,0.96,0.9); gfx_rect(x+2, y+2, pw, 1); gfx_rect(x+2, y+ph+1, pw, 1);
  );
  // Synced Match rule active: the region owns the length — cyan "bound" tick on
  // the left edge (tooltip carries the words; a manual Len drag snaps back).
  eon_len_follow ? ( gfx_set(0.45,0.86,0.96,0.9); gfx_rect(x+2, y+2, 2, ph); );
  gfx_set(0.93,0.96,0.99,1); gfx_setfont(0);
  gfx_x=x+8; gfx_y=y+5; gfx_printf("Len %d", listlength);
);

function draw_rate_slider(x, y, hl)
(
  draw_slider(x,y,rate/4);
  color(38);
  gfx_x=x+8; gfx_y=y+5;
  gfx_printf("Rate");
  rate > 0.125 ? (
    gfx_x=x+108;
    gfx_drawnumber(rate,2);
  ) :(
    gfx_x=x+100;
    gfx_drawnumber(rate,3);
  );
  hl ? draw_slider_highlight(x,y);
);

function draw_numbeats_slider(x, y, hl) local(pw, ph, fw, frac, intens)
(
  // EON: compact 4-cell pill -- short text + value, fill + colour intensity scale with the
  // value (matches the swing pill), hl = hover. Grid resolution (steps per beat, 1..16).
  pw = busp*4 - 4; ph = tbrh - 4;
  gfx_set(0.10,0.12,0.14,1); gfx_rect(x+2, y+2, pw, ph);                       // track
  frac = steps_per_beat / 16;
  fw = (pw*frac)|0; intens = 0.50 + 0.50*frac;
  gfx_set(0.88*intens, 0.32*intens, 0.56*intens, 1); fw > 0 ? gfx_rect(x+2, y+2, fw, ph);  // pink
  hl ? (
    gfx_set(1,1,1,0.10); gfx_rect(x+2, y+2, pw, ph);
    gfx_set(0.45,0.86,0.96,0.9); gfx_rect(x+2, y+2, pw, 1); gfx_rect(x+2, y+ph+1, pw, 1);
  );
  gfx_set(0.93,0.96,0.99,1); gfx_setfont(0);
  // EON GRID CHIP: beatmaker words, not notation — the label IS the education
  // (right-click opens the grid picker; drag still sweeps raw 1..16).
  gfx_x=x+8; gfx_y=y+5;
  steps_per_beat == 4 ? gfx_printf("Straight") :
  steps_per_beat == 3 ? gfx_printf("Triplet") :
  steps_per_beat == 6 ? gfx_printf("Triplet 16") :
  steps_per_beat == 8 ? gfx_printf("Straight 32") :
  gfx_printf("S/Bt %d", steps_per_beat);
);

function draw_colors_button(x,y,hl)
(
  eon_btn_frame(x, y, 4);
  // Draw label:
  color(38);
  gfx_y=y+5;
  gfx_x=x+6;
  gfx_printf(colorschemename);
  hl ? draw_z_space_highlight(x,y,4);
);

function draw_midimode_button(x,y,hl)
(
  eon_btn_frame(x, y, 6);
  // Draw label:
  color(38);
  gfx_y=y+6;
  gfx_x=x+9;
  midi_trigger==0?label="Midi Off";
  midi_trigger==1?label="Pattern Change";
  midi_trigger==2?label="Transpose";
  midi_trigger==3?label="Resync";
  midi_trigger==4?label="Xpose + Resync";
  midi_trigger==5?label="Resync Quantized";
  midi_trigger==6?label="Xpose + Resync Q";		
  gfx_printf(label);
  hl ? draw_slider_highlight(x,y);
);

function draw_pattmode_button(x,y,hl)
(
  // Draw edges
  color(1);
  gfx_x=x+2;gfx_y=y+1;
  gfx_lineto(gfx_x+(busp*8-2-1), gfx_y, 0);
  gfx_lineto(gfx_x, gfx_y+(tbrh-2-1), 0);
  gfx_lineto(gfx_x-(busp*8-2-1), gfx_y, 0);
  gfx_lineto(gfx_x, gfx_y-(tbrh-2-1), 0);  
  // Draw label:
  color(38);
  gfx_y=y+6;
  gfx_x=x+9;
  patternmode==0?label="96 Patterns/64 Steps";
  patternmode==1?label="48 Patterns/128 Steps";
  gfx_printf(label);
  gfx_y=y+6;
  gfx_x=x+195;
  label2="<< Select 64/128 step mode: CLEARS ALL PATTERNS! Save First.";
  gfx_printf(label2);
  hl ? draw_z_space_highlight(x,y,8);
);
function draw_settings_button(x,y,hl)
(
  colorscheme==10 ? (   // EON: vector cog on the cream housing
    setcolor(214,207,194,255); gfx_x=x; gfx_y=y; gfx_rectto(x+busp*2-2, y+tbrh-2);
    eon_cgx = (x+busp*0.95)|0; eon_cgy = (y+tbrh*0.5)|0; eon_cgr = min((tbrh*0.34)|0, 8); eon_cgd = (eon_cgr*0.7)|0;
    hl ? setcolor(0,150,180,255) : setcolor(66,72,86,255);
    gfx_rect(eon_cgx-2, eon_cgy-eon_cgr-2, 4, 4);
    gfx_rect(eon_cgx-2, eon_cgy+eon_cgr-2, 4, 4);
    gfx_rect(eon_cgx-eon_cgr-2, eon_cgy-2, 4, 4);
    gfx_rect(eon_cgx+eon_cgr-2, eon_cgy-2, 4, 4);
    gfx_rect(eon_cgx-eon_cgd-2, eon_cgy-eon_cgd-2, 4, 4);
    gfx_rect(eon_cgx+eon_cgd-2, eon_cgy-eon_cgd-2, 4, 4);
    gfx_rect(eon_cgx-eon_cgd-2, eon_cgy+eon_cgd-2, 4, 4);
    gfx_rect(eon_cgx+eon_cgd-2, eon_cgy+eon_cgd-2, 4, 4);
    gfx_circle(eon_cgx, eon_cgy, eon_cgr, 1, 1);
    setcolor(214,207,194,255); gfx_circle(eon_cgx, eon_cgy, (eon_cgr*0.42)|0, 1, 1);
  ) : (
    eon_btn_frame(x, y, 4);
    color(38);
    gfx_y=y+5;
    gfx_x=x+6;
    gfx_printf("Settings");
    hl ? draw_z_space_highlight(x,y,4);
  );
);

function draw_velo_display(x,y,hl)
(
  eon_btn_frame(x, y, 2);
  
  // Draw label:
  color(38);
  gfx_y=y+5;
  gfx_x=x+6;
  gfx_printf("V:");
  
  // Draw value
  lastvelo < 10 ? (
    gfx_x=x+22+2*8;
  ) : lastvelo < 100 ? (
    gfx_x=x+22+8;
  ) : (
    gfx_x=x+22;
  );
  gfx_drawnumber(lastvelo,0);
  drawnvelo=lastvelo;
  hl ? (
    color(2);
    gfx_x=x+2;gfx_y=y+1;
    gfx_rectto(gfx_x+(busp*2-2-1),gfx_y+(tbrh-2-1));
  );
);

function draw_move_button(x,y,hl)
(
  eon_btn_frame(x, y, 2);
  
  // Draw label:
  color(38);
  gfx_y=y+5;
  gfx_x=x+10;
  gfx_printf("Move");
 
  hl ? (
    color(2);
    gfx_x=x+2;gfx_y=y+1;
    gfx_rectto(gfx_x+(busp*2-2-1),gfx_y+(tbrh-2-1));
  );
);

function isSharp(note) local(octavestart)
(
  octavestart = note % 12; 
  octavestart == 1 || octavestart == 3 || octavestart == 6 || octavestart == 8 || octavestart == 10 ? (
    1;
  ) : (
    0;
  );
);

function getNotename(note, default_names)
( 
  notenames[note]==0 || default_names ? ( // empty notename -> use default note names
    #name_str=nn[note % 12];
    isSharp(note) ? (
      #name_str+="#";
    ) : (
      #name_str+=" ";
    );
    notename_digit=floor((note-12)/12 + octave_offset);  
    strcat(#name_str, sprintf(#, "%{notename_digit}d"));
  ) : ( // use notename extracted from file
    #name_str=notenames[note];
  );
);

function draw_trigstart_display(x,y,hl)
(
  eon_btn_frame(x, y, 4);
  
  // Print label and value
  color(38);
  gfx_y=y+5;
  gfx_x=x+6;
  gfx_printf("Trig: ");
  gfx_printf(getNotename(trig_note_start, 1));
  
  hl ? (
    color(2);
    gfx_x=x+2;gfx_y=y+1;
    gfx_rectto(gfx_x+(busp*2-2-1),gfx_y+(tbrh-2-1));
  );
);

function draw_basenote_display(x,y,hl)
(
  eon_btn_frame(x, y, 4);
  
  // Print label and value
  color(38);
  gfx_y=y+5;
  gfx_x=x+6;
  gfx_printf("Base: ");
  gfx_printf(getNotename(basenote, 1));
  
  hl ? (
    color(2);
    gfx_x=x+2;gfx_y=y+1;
    gfx_rectto(gfx_x+(busp*2-2-1),gfx_y+(tbrh-2-1));
  );
);

function draw_velocity(x,y,hl) 
(
  // Draw default velocity value
  color(31); gfx_x=gfx_y=0;
  gfx_x=x; gfx_y=y;
  gfx_rectto(gfx_x+(busp*2-2-1),gfx_y+(tbrh-4-1));
  draw_velo_display(x,y,0);
  hl ? (
    color(2);
    gfx_x=x+2;gfx_y=y+1;
    gfx_rectto(gfx_x+(busp*2-2-1),gfx_y+(tbrh-2-1));
  );
);

function draw_drum_note(note) local(notepos, nt, trans, half_rh, scaled_tr, offset, name, eon_h, eon_lr, eon_lg, eon_lb, eon_lum, eon_cat)
(
  notepos = numnotes-1-note;
  nt = basenote+note+notetranspose[note];
  name=#;
  name=getNotename(nt, 0);
  // Erase previous text by drawing black text over
  color(7);
  gfx_x=chw+4.0; gfx_y=tbh+notepos*row_height+row_height/2-3;
  gfx_printf(name); 
  gfx_x=4.0;
  rowchannel[note]+1 < 10 ? gfx_x=gfx_x+3.0;
  gfx_drawnumber(rowchannel[note]+1, 0);
  
  colorscheme != 10 ? (   // EON paints the whole lane tile in its own block below (no dark icon column)
    color(10);
    gfx_x=2.0; gfx_y=tbh+notepos*row_height+1;
    gfx_rectto(chw-3, gfx_y+row_height-2);
  );
  !isSharp(basenote+note) && colorscheme != 10 ? ( // faint white-key bg (skipped in EON: flat dark lanes)
    color(8);
    gfx_x=chw; gfx_y=tbh+notepos*row_height+1;
    gfx_rectto(pkw-3, gfx_y+row_height-2);
  );
  // EON: bright pad-colour lane tile (Swing-style) -- loaded = its pad colour, blank = cream
  colorscheme==10 ? (
    eon_h = eon_pad_hue_for_note(nt);
    (eon_h > -5 && notenames[nt] != 0) ? ( // LOADED
      eon_h <= -1.5 ? (setcolor(110,110,118,255);) :
      eon_h < 0 ? (setcolor(196,196,206,255);) :
      (eon_hsl2rgb(eon_h, gmem[EON_SW_COL_S], gmem[EON_SW_COL_L]););
      eon_lr=gfx_r; eon_lg=gfx_g; eon_lb=gfx_b;
      eon_lum = eon_lr*0.30 + eon_lg*0.59 + eon_lb*0.11;
      // name tile [chw, pkw-3] = full pad colour
      gfx_r=eon_lr; gfx_g=eon_lg; gfx_b=eon_lb; gfx_a=1;
      gfx_x=chw; gfx_y=tbh+notepos*row_height+1; gfx_rectto(pkw-3, gfx_y+row_height-2);
      // icon column [2, chw-2] = darker pad colour -> its own strip (future button)
      gfx_r=eon_lr*0.52; gfx_g=eon_lg*0.52; gfx_b=eon_lb*0.52; gfx_a=1;
      gfx_x=2; gfx_y=tbh+notepos*row_height+1; gfx_rectto(chw-2, gfx_y+row_height-2);
      // glyph on the icon button — precedence (kit-categories ①): manual override
      // wins, else the PAIRED pad's published category (ONE identity with the
      // Swing pad badge), else name-based. Unpaired/unpublished = old behavior.
      eon_padc = eon_pad_cat_for_note(nt);   // nt = MIDI note; `note` is the ROW index
      // PADCAT_NONE = the pad's owner said it has no job, so the lane shows no
      // glyph. It must NOT reach the name fallback (that is for pads nobody has
      // classified) — but a manual lane override still outranks it, because that
      // is this seq's own opinion about its own lane.
      eon_cat = lane_icon_override[note] == LANE_ICON_NONE ? PADCAT_NONE :
                lane_icon_override[note] > 0 ? (lane_icon_override[note]|0)-1 :
                eon_padc >= 0 ? eon_padc :
                eon_padc == PADCAT_NONE ? PADCAT_NONE : eon_cat_for_name(name);
      // chw is 0 when the ICON column is hidden, which would collapse the glyph
      // onto the left edge at a negative radius -- gate on the column bit, not
      // just on the category.
      (eon_colvis & 1) && eon_cat != PADCAT_NONE ?
        eon_draw_cat_glyph(eon_cat, (chw*0.5)|0, (tbh+notepos*row_height+row_height*0.5)|0, min(min(chw,row_height)*0.5-2, 12), eon_lum*0.52);
    ) : ( // blank / out-of-kit -> cream (never black)
      setcolor(214,207,194,255);
      gfx_x=2; gfx_y=tbh+notepos*row_height+1; gfx_rectto(pkw-3, gfx_y+row_height-2);
    );
  );
  colorscheme != 10 ? ( // EON identifies lanes by glyph + name -> no channel numbers
    color(9);
    gfx_x=4.0; gfx_y=tbh+notepos*row_height+row_height/2-3;
    rowchannel[note]+1 < 10 ? gfx_x=gfx_x+3.0;
    gfx_drawnumber(rowchannel[note]+1, 0);
  );
  gfx_x=chw+4.0;
  
  colorscheme==10 ? eon_ms_geo();   // EON: compute lane-header control-strip geometry before placing the name
  gfx_x=chw+6.0; gfx_y=tbh+notepos*row_height+row_height/2-7;     // EON: name centered on its single line
  color(4);
  // EON: bold, high-contrast name -> dark on bright/light tiles, light on dark; blanks -> dark
  colorscheme==10 ? (
    (eon_h > -5 && notenames[nt] != 0) ? (eon_lum > 0.52 ? setcolor(14,15,18,255) : setcolor(252,253,255,255)) : setcolor(52,48,40,255)
  );
  colorscheme==10 ? (gfx_a = (notenames[nt]==0 ? 0.55 : 1.0)) : (gfx_a = (notenames[nt]==0 ? 0.3 : 0.6));
  colorscheme==10 ? gfx_setfont(8, "Verdana", min(max(row_height-3, 9), 14));
  // pianow is 0 when the NAME column is hidden; printing anyway would spill the
  // name across the control strip. Only the EON scheme can hide columns.
  (colorscheme != 10 || (eon_colvis & 2)) ? gfx_printf(name);
  // EON: lane Mute/Solo buttons + swing% readout in the right control strip (single line, beside the name)
  colorscheme==10 ? (
    eon_ms_by = (tbh+notepos*row_height + eon_ms_row2dy)|0;
    eon_ms_ty = eon_ms_by + (((eon_ms_bh-8)/2)|0);              // text top within a button
    // E-2: paired+mapped lanes DISPLAY the pad state from the IDENT band (the
    // canonical mute/solo); unmapped/unpaired lanes show the local lane state.
    eon_vpd = eon_pair_slot >= 0 ? eon_lane_pad[note] : -1;
    eon_vm = eon_vpd >= 0
      ? gmem[EON_ID_BASE + eon_pair_slot*EON_ID_STRIDE + eon_vpd*EON_ID_FIELDS + EON_ID_MUTE] > 0.5
      : lane_mute[note];
    eon_vs = eon_vpd >= 0
      ? gmem[EON_ID_BASE + eon_pair_slot*EON_ID_STRIDE + eon_vpd*EON_ID_FIELDS + EON_ID_SOLO] > 0.5
      : lane_solo[note];
    eon_va = eon_vpd >= 0 ? eon_band_anysolo : any_solo;
    // silenced overlay over the NAME area only (leave the control strip readable)
    (eon_vm || (eon_va && !eon_vs)) ? (
      gfx_set(0,0,0,0.42); gfx_x=2; gfx_y=tbh+notepos*row_height+1; gfx_rectto(eon_cz-1, gfx_y+row_height-2);
    );
    // control-strip backdrop so M/S/swing read as their own zone, separate from
    // the name. NOTE: eon_ctrlw cannot reach 0 under eon_colvis_apply() -- five
    // hidden columns still leave 5*EON_COL_STUB+3 (the restore chevrons live in
    // that zone, which is why it must stay painted). The > 0 guard is belt and
    // braces for a derivation change, not a live skip path.
    eon_ctrlw > 0 ? (
      gfx_set(0.05, 0.06, 0.09, 0.85); gfx_x=eon_cz; gfx_y=tbh+notepos*row_height+1; gfx_rectto(pkw-2, gfx_y+row_height-2);
    );
    row_height >= 8 ? (
      gfx_setfont(8, "Verdana", min(max(eon_ms_bh-2, 7), 12));
      // Mute PILL (red when active)
      (eon_colvis & 4) ? (
        eon_vm ? gfx_set(0.84,0.27,0.23,1) : gfx_set(0.22,0.22,0.26,1);
        eon_fill_pill(eon_ms_mx, eon_ms_by, eon_ms_bw, eon_ms_bh);
        eon_vm ? gfx_set(1,1,1,1) : gfx_set(0.66,0.66,0.70,1);
        gfx_x=eon_ms_mx+((eon_ms_bw/2-3)|0); gfx_y=eon_ms_ty; gfx_drawchar($'M');
      );
      // Solo PILL (amber when active)
      (eon_colvis & 8) ? (
        eon_vs ? gfx_set(0.95,0.78,0.27,1) : gfx_set(0.22,0.22,0.26,1);
        eon_fill_pill(eon_ms_sx, eon_ms_by, eon_ms_bw, eon_ms_bh);
        eon_vs ? gfx_set(0.09,0.09,0.09,1) : gfx_set(0.66,0.66,0.70,1);
        gfx_x=eon_ms_sx+((eon_ms_bw/2-3)|0); gfx_y=eon_ms_ty; gfx_drawchar($'S');
      );
      // VOL / PAN knobs — remote control of the paired Swing pad, drawn with the
      // HOUSE widget (rk_knob_draw + mpc_knob_interact from knobs_kbsg), so these
      // are the same knobs Swing puts on its pads: same 18 styles, same theme
      // response, same drag/wheel/double-click feel, hover animation included.
      // Style comes from the live theme exactly as EON_Drum_Strip.jsfx:927 does.
      // Only drawn for lanes that resolve to a pad -- an unpaired lane, or one
      // whose note maps to nothing, has no pad to control.
      (eon_kn_v_on || eon_kn_p_on) && eon_lane_has_mix(note) ? (
        eon_kn_cy = (tbh + notepos*row_height + row_height/2)|0;
        eon_knm_v = ss_knob_mem + (note*2    )*KS;
        eon_knm_p = ss_knob_mem + (note*2 + 1)*KS;
        eon_kn_v_on ? (
        // VOL — 0..2.0 with default 1.0, matching Swing's own on-pad VOL knob
        // (rk_swing_ui_grid_pads.jsfx-inc:255). Deliberately NOT the mailbox's
        // full 0..8: Swing solved the taper problem by narrowing the range, so
        // matching it gives identical feel instead of a second, different curve.
        ss_knob_color(nt, ss_vappr, 0);
        rk_knob_draw(ss_vstyle, eon_kn_vx, eon_kn_cy, eon_kn_r,
                     eon_lane_gain(note), 0, 2.0, 0, eon_knm_v[0],
                     ss_kc_r, ss_kc_g, ss_kc_b, 0, 0.36, 0.34, 0.32);
        ss_kn_input ? (
          eon_knv = mpc_knob_interact(eon_knm_v, eon_kn_vx, eon_kn_cy, eon_kn_r,
                                      eon_lane_gain(note), 0, 2.0, 1.0, 0);
          eon_knv != eon_lane_gain(note) ? eon_lane_set_gain(note, eon_knv);
        ) : ( eon_knm_v[1] = 0; );   // panel opened mid-drag -> release, don't strand it
        );
        // PAN — is_sym=1 makes the widget draw it bipolar from centre, so a
        // centred pan reads as neutral without any anchor maths of our own.
        eon_kn_p_on ? (
        ss_knob_color(nt, ss_pappr, 1);
        rk_knob_draw(ss_pstyle, eon_kn_px, eon_kn_cy, eon_kn_r,
                     eon_lane_pan(note), -1, 1, 1, eon_knm_p[0],
                     ss_kc_r, ss_kc_g, ss_kc_b, 0, 0.36, 0.34, 0.32);
        ss_kn_input ? (
          eon_knp = mpc_knob_interact(eon_knm_p, eon_kn_px, eon_kn_cy, eon_kn_r,
                                      eon_lane_pan(note), -1, 1, 0, 0);
          eon_knp != eon_lane_pan(note) ? eon_lane_set_pan(note, eon_knp);
        ) : ( eon_knm_p[1] = 0; );
        );
        // PROBLEM 2 (repaint): the lane header is dirty-flag painted, but hover_t
        // only advances on frames that actually redraw. Latch "some knob is
        // mid-transition" here; the post-gate check re-dirties so the animation
        // gets the frames it needs, then stops on its own at 0 or 1. Bounded --
        // never a blanket continuous repaint.
        // Both latches are gated on the knob still being VISIBLE. A hidden knob
        // never gets an interact call, so its memory freezes at whatever it held --
        // hide a knob mid-hover and a bare mem[6] test would latch ss_knob_busy
        // on forever and silently eat every click in the lane header.
        (eon_kn_v_on && ((eon_knm_v[0] > 0 && eon_knm_v[0] < 1) || eon_knm_v[1])) ||
        (eon_kn_p_on && ((eon_knm_p[0] > 0 && eon_knm_p[0] < 1) || eon_knm_p[1])) ? ss_knob_anim = 1;
        // A live knob suppresses this lane's own gestures (audition scrub /
        // transpose / pill hits) for the frame -- the widget owns the mouse.
        // Same guard Swing uses on its pads (grid_pads.jsfx-inc:259).
        (eon_kn_v_on && (eon_knm_v[6] || eon_knm_v[1])) ||
        (eon_kn_p_on && (eon_knm_p[6] || eon_knm_p[1])) ? ss_knob_busy = 1;
      );
      // GROOVE PILL -> blank at rest when straight; appears (highlighted) on hover.
      // Click = pick the groove type, wheel = strength. Classic swing shows "N%",
      // a picked groove shows its short name + strength (amber).
      (eon_colvis & 64) && (lane_swing[note] > 0 || lane_groove[note] > 0 || note==eon_hover_lane) ? (
        note==eon_hover_lane ? gfx_set(0.13,0.18,0.24,1) : gfx_set(0.05,0.07,0.10,1);
        eon_fill_pill(eon_sw_x, eon_ms_by, eon_sw_w, eon_ms_bh);
        gfx_setfont(8, "Verdana", 9);
        gfx_x = eon_sw_x+4; gfx_y = eon_ms_ty;
        lane_groove[note] > 0 ? (
          setcolor(244, 196, 88, 255);
          grv_name(#grv_pn, lane_groove[note]|0, 2);   // 2-char type code + strength: "DR60" (pill is ~28px)
          gfx_drawstr(#grv_pn);
          gfx_drawnumber(lane_swing[note], 0);
        ) : (
          lane_swing[note] > 0 ? setcolor(0, 210, 244, 255) : setcolor(120,124,132,255);
          gfx_drawnumber(lane_swing[note], 0); gfx_drawchar($'%');
        );
      );
    );
    gfx_setfont(0); // restore megababy default font
  );
  
  //Draw transpose indicator
  trans = notetranspose[note];
  trans != 0 ? (     
    half_rh = row_height/2|0;
    color(11);
    gfx_x=chw+0.0; gfx_y=tbh+(notepos*row_height+half_rh)|0;
    
    scaled_tr = trans/8;
    offset = (half_rh-1)*scaled_tr;
    offset > 0 && offset < 1 ? offset=1;
    offset < 0 && offset > -1 ? offset=-1;
    offset=offset|0;
    offset > half_rh-1 ? offset = half_rh-1;
    offset < (-half_rh)+1 ? offset = (-half_rh)+1;
    gfx_rectto(gfx_x+3, gfx_y - offset);
  );
);

function eon_draw_vtext(slot, cx, cy, maxlen, lum) local(tw, th) (
  // render the name horizontally into offscreen buffer 0, then blit it rotated -90 (reads bottom-to-top)
  gfx_setfont(6, "Verdana", 9);
  sprintf(#eon_kn, "%s", slot);
  gfx_measurestr(#eon_kn, tw, th);
  tw = min(tw, maxlen);
  gfx_dest = 0;
  gfx_setimgdim(0, 0, 0);              // force-clear by resizing
  gfx_setimgdim(0, tw+4, th+2);
  lum > 0.55 ? gfx_set(0.10,0.12,0.16,1) : gfx_set(0.98,0.99,1.0,1);
  gfx_x=2; gfx_y=1; gfx_drawstr(#eon_kn);
  gfx_dest = -1;                       // back to the main framebuffer
  gfx_x = (cx - (tw+4)*0.5)|0; gfx_y = (cy - (th+2)*0.5)|0;
  gfx_blit(0, 1, -1.5707963);
);

function eon_pad_rgb(nt) local(h) (   // sets gfx_r/g/b to the lane's Swing colour; returns 1 if a named pad
  h = eon_pad_hue_for_note(nt);
  (h > -5 && notenames[nt] != 0) ? (
    h <= -1.5 ? ( gfx_r=110/255; gfx_g=110/255; gfx_b=118/255; ) :
    h < 0     ? ( gfx_r=196/255; gfx_g=196/255; gfx_b=206/255; ) :
    ( eon_hsl2rgb(h, gmem[EON_SW_COL_S], gmem[EON_SW_COL_L]); );
    gfx_a=1; 1;
  ) : ( 0; );
);

function eon_draw_trig_num(cx, cy, num, lum) local(fr, fg, fb, ar, ag, ab)
(
  lum > 0.52 ? ( fr=26/255; fg=22/255; fb=14/255; ar=1; ag=1; ab=1; )
             : ( fr=252/255; fg=250/255; fb=244/255; ar=8/255; ag=10/255; ab=16/255; );
  gfx_set(ar, ag, ab, 1);                    // outline halo (8 offsets)
  gfx_x=cx-1; gfx_y=cy-1; gfx_drawnumber(num,0);
  gfx_x=cx+1; gfx_y=cy-1; gfx_drawnumber(num,0);
  gfx_x=cx-1; gfx_y=cy+1; gfx_drawnumber(num,0);
  gfx_x=cx+1; gfx_y=cy+1; gfx_drawnumber(num,0);
  gfx_x=cx;   gfx_y=cy-1; gfx_drawnumber(num,0);
  gfx_x=cx;   gfx_y=cy+1; gfx_drawnumber(num,0);
  gfx_x=cx-1; gfx_y=cy;   gfx_drawnumber(num,0);
  gfx_x=cx+1; gfx_y=cy;   gfx_drawnumber(num,0);
  gfx_set(fr, fg, fb, 1);                     // fill on top
  gfx_x=cx; gfx_y=cy; gfx_drawnumber(num,0);
);

// EON: Manual map -- 4x4 of the 16 lanes by EFFECTIVE note (basenote+lane+notetranspose).
// Scroll a pad to retune it onto the Swing sound you want; blank = no sound at that note.
function draw_tb_manual(x, y) local(i, nt, padw, px, py, col, row, ncols, ph1, eon_nnw, eon_nnh)
(
  gfx_setfont(6, "Verdana", 9);
  eon_hovnote = -1;
  ph1 = tbrh;
  ncols = 4;
  padw = (gfx_w - 4) / ncols;
  i = 0;
  loop(min(16, numnotes),
    nt = basenote + i + notetranspose[i];
    col = i % ncols;
    row = (i / ncols)|0;
    px = (x + 2 + col*padw)|0;
    py = (y + row*ph1)|0;
    eon_pad_rgb(nt) ? 0 : setcolor(54,56,64,255);                              // lane colour, or dark blank slot
    gfx_x=px; gfx_y=py+1; gfx_rectto((px+padw-1)|0, py+ph1-1);
    setcolor(12,14,20,255);
    gfx_x=(px+padw-1)|0; gfx_y=py+1;        gfx_lineto((px+padw-1)|0, py+ph1-1, 0);
    gfx_x=px;            gfx_y=(py+ph1-1)|0; gfx_lineto((px+padw-1)|0, py+ph1-1, 0);
    notenames[nt] != 0 ? (
      sprintf(#eon_kn, "%s", notenames[nt]);
      setcolor(8,12,18,210);     gfx_x=px+14; gfx_y=py+(ph1*0.5-4)|0; gfx_drawstr(#eon_kn, 1, (px+padw)|0,   py+ph1);
      setcolor(250,252,255,255); gfx_x=px+13; gfx_y=py+(ph1*0.5-5)|0; gfx_drawstr(#eon_kn, 1, (px+padw-1)|0, py+ph1-1);
    );
    gfx_setfont(7,"Verdana",9,'b');
    sprintf(#eon_kn, "%s", getNotename(nt, 1));
    gfx_measurestr(#eon_kn, eon_nnw, eon_nnh);
    setcolor(12,16,24,205);    gfx_rect(px+2, py+1, (eon_nnw+5)|0, (eon_nnh+1)|0);
    setcolor(253,254,255,255); gfx_x=px+4; gfx_y=py+1; gfx_drawstr(#eon_kn);
    gfx_setfont(6,"Verdana",9);
    (mouse_y >= py && mouse_y < py+ph1 && mouse_x >= px && mouse_x < px+padw) ? (eon_hovnote = nt);
    i += 1;
  );
  gfx_setfont(0);
);

// EON: Pads view -- the 16 kit pads as a labelled colour strip (note name + pad name),
// mirroring the live Swing kit. Same role as the piano: read which note maps to which pad.
function draw_tb_pads(x, y, npads) local(i, nt, padw, px, py, col, row, ncols, ph1, ppw, ppx, eon_nnw, eon_nnh)
(
  gfx_setfont(6, "Verdana", 9);
  eon_hovnote = -1;
  ph1 = tbrh;
  // --- pattern row: 8 trigger pads across the top (mirrors the piano's trigger zone) ---
  ppw = (gfx_w - 4) / 8;
  i = 0;
  loop(8,
    ppx = (x + 2 + i*ppw)|0;
    pattern_hue[i] < 0 ? (setcolor(214,207,194,255);) : (eon_hsl2rgb(pattern_hue[i],0.60,0.54); gfx_a=1;);
    gfx_x=ppx; gfx_y=y+1; gfx_rectto((ppx+ppw-1)|0, y+ph1-1);
    gfx_set(0.97,0.74,0.30,0.42); gfx_x=ppx; gfx_y=y+1; gfx_rectto((ppx+ppw-1)|0, y+ph1-1);                 // gold cast = "pattern"
    i==p ? ( setcolor(255,255,255,255); gfx_x=ppx+1; gfx_y=y+1; gfx_lineto((ppx+ppw-2)|0, y+1, 0); gfx_x=ppx+1; gfx_y=y+2; gfx_lineto((ppx+ppw-2)|0, y+2, 0); );  // active pattern marker
    setcolor(12,14,20,255); gfx_x=(ppx+ppw-1)|0; gfx_y=y+1; gfx_lineto((ppx+ppw-1)|0, y+ph1-1, 0);
    gfx_setfont(7,"Verdana",12,'b');
    eon_draw_trig_num((ppx+ppw*0.5-4)|0, y+(ph1*0.5-7)|0, i+1, 0.62);
    gfx_setfont(6,"Verdana",9);
    i += 1;
  );
  // --- kit grid: the pads, below the pattern row (2x4 for 8, 4x4 for 16) ---
  ncols = 4;
  padw = (gfx_w - 4) / ncols;
  i = 0;
  loop(min(npads, numnotes),
    nt = basenote + i;
    col = i % ncols;
    row = (i / ncols)|0;
    px = (x + 2 + col*padw)|0;
    py = (y + ph1 + row*ph1)|0;
    eon_pad_rgb(nt) ? 0 : setcolor(70,74,84,255);                                  // lane colour, or neutral if blank
    gfx_x=px; gfx_y=py+1; gfx_rectto((px+padw-1)|0, py+ph1-1);
    setcolor(12,14,20,255);
    gfx_x=(px+padw-1)|0; gfx_y=py+1;        gfx_lineto((px+padw-1)|0, py+ph1-1, 0);   // vertical separator
    gfx_x=px;            gfx_y=(py+ph1-1)|0; gfx_lineto((px+padw-1)|0, py+ph1-1, 0);   // horizontal separator
    notenames[nt] != 0 ? (                                                          // pad name, centred
      sprintf(#eon_kn, "%s", notenames[nt]);
      setcolor(8,12,18,210);     gfx_x=px+14; gfx_y=py+(ph1*0.5-4)|0; gfx_drawstr(#eon_kn, 1, (px+padw)|0,   py+ph1);
      setcolor(250,252,255,255); gfx_x=px+13; gfx_y=py+(ph1*0.5-5)|0; gfx_drawstr(#eon_kn, 1, (px+padw-1)|0, py+ph1-1);
    );
    gfx_setfont(7,"Verdana",9,'b');                                                 // note name, top-left, on a dark chip for contrast
    sprintf(#eon_kn, "%s", getNotename(nt, 1));
    gfx_measurestr(#eon_kn, eon_nnw, eon_nnh);
    setcolor(12,16,24,205);    gfx_rect(px+2, py+1, (eon_nnw+5)|0, (eon_nnh+1)|0);
    setcolor(253,254,255,255); gfx_x=px+4; gfx_y=py+1; gfx_drawstr(#eon_kn);
    gfx_setfont(6,"Verdana",9);
    (mouse_y >= py && mouse_y < py+ph1 && mouse_x >= px && mouse_x < px+padw) ? (eon_hovnote = nt);
    i += 1;
  );
  gfx_setfont(0);
);

function draw_tb_pianokeys(x, y) local(note, w, gap, in_range, in_trig_range, eon_kx, i, kw, eon_nw, eon_wi, eon_bw, eon_ph, eon_tpi, eon_tklum, eon_irlum )
(
  colorscheme==10 ? (
    // EON windowed piano (real white/black keys), ~3 octaves around the kit, 2 rows tall
    eon_pn = max(1, min(6, slider16|0)) * 12;   // octaves x 12, set by "Piano octaves" slider
    eon_ph = 2*tbrh - 1;
    eon_plo = max(0, basenote - 2);
    (eon_plo + eon_pn) > 127 ? (eon_plo = 127 - eon_pn);
    trig_note_start < eon_plo ? (trig_note_start = eon_plo);
    trig_note_start > (eon_plo + eon_pn - 8) ? (trig_note_start = eon_plo + eon_pn - 8);
    eon_nw = 0; i = 0;
    loop(eon_pn, !isSharp(eon_plo+i) ? (eon_nw += 1); i += 1;);
    kw = (gfx_w - 4) / eon_nw;                 // white-key width
    eon_key_w = kw; eon_pwin_lo = eon_plo;
    eon_bw = (kw*0.62)|0;                       // black-key width
    eon_hovnote = -1;
    gfx_setfont(6, "Verdana", 9);
    eon_wi = 0; i = 0;
    loop(eon_pn,                                 // pass 1: white keys (full height)
      note = eon_plo + i;
      !isSharp(note) ? (
        eon_kx = (x + 2 + eon_wi*kw)|0;
        in_range = (note >= basenote && note < basenote+numnotes);
        in_trig_range = (note >= trig_note_start && note < trig_note_start+8);
        in_range ? ( eon_pad_rgb(note) ? (eon_irlum=(gfx_r*0.30+gfx_g*0.59+gfx_b*0.11)*0.58+0.23;) : (setcolor(60,195,230,255); eon_irlum=0.50;) ) :
        in_trig_range ? ( eon_tpi=note-trig_note_start; pattern_hue[eon_tpi]<0 ? (setcolor(214,207,194,255);) : (eon_hsl2rgb(pattern_hue[eon_tpi],0.60,0.56); gfx_a=1;); eon_tklum=(gfx_r*0.30+gfx_g*0.59+gfx_b*0.11)*0.58+0.31; ) :
        ( setcolor(222,224,230,255); );
        gfx_x=eon_kx; gfx_y=y+1; gfx_rectto((eon_kx+kw-1)|0, y+eon_ph);
        in_range ? ( gfx_set(0.18,0.62,0.84,0.11); gfx_x=eon_kx; gfx_y=y+1; gfx_rectto((eon_kx+kw-1)|0, y+eon_ph); );      // faint blue zone hint (keeps the lane colour vibrant, like the pads)
        in_trig_range ? ( gfx_set(0.97,0.74,0.30,0.42); gfx_x=eon_kx; gfx_y=y+1; gfx_rectto((eon_kx+kw-1)|0, y+eon_ph); ); // gold zone cast
        setcolor(12,14,20,255); gfx_x=(eon_kx+kw-1)|0; gfx_y=y+1; gfx_lineto((eon_kx+kw-1)|0, y+eon_ph, 0); gfx_x=(eon_kx+kw-2)|0; gfx_y=y+1; gfx_lineto((eon_kx+kw-2)|0, y+eon_ph, 0);   // stronger 2px dark separator
        in_range ? (   // note name CENTRED on its key (+ shadow) so you can tell which key it lands on
          sprintf(#eon_kn, "%s", getNotename(note, 1));
          setcolor(6,10,16,215);     gfx_x=eon_kx+1; gfx_y=y+eon_ph-10; gfx_drawstr(#eon_kn, 1, (eon_kx+kw)|0,   y+eon_ph);
          setcolor(247,250,255,255); gfx_x=eon_kx;   gfx_y=y+eon_ph-11; gfx_drawstr(#eon_kn, 1, (eon_kx+kw-1)|0, y+eon_ph-1);
        ) : (
          sprintf(#eon_kn, "%s", getNotename(note, 1));
          setcolor(40,42,50,255); gfx_x=eon_kx; gfx_y=y+eon_ph-11; gfx_drawstr(#eon_kn, 1, (eon_kx+kw-1)|0, y+eon_ph-1);
        );
        in_trig_range ? (   // pattern number on the trigger key
          gfx_setfont(7, "Verdana", 12, 'b');
          eon_draw_trig_num((eon_kx + kw*0.5 - 4)|0, y+2, note - trig_note_start + 1, eon_tklum);
          gfx_setfont(6, "Verdana", 9);
        );
        (mouse_y >= y && mouse_y < y+eon_ph && mouse_x >= eon_kx && mouse_x < eon_kx+kw) ? (eon_hovnote = note);
        eon_wi += 1;
      );
      i += 1;
    );
    eon_wi = 0; i = 0;
    loop(eon_pn,                                 // pass 2: black keys (narrow, top portion, on top)
      note = eon_plo + i;
      isSharp(note) ? (
        eon_kx = (x + 2 + eon_wi*kw - eon_bw*0.5)|0;
        in_range = (note >= basenote && note < basenote+numnotes);
        in_trig_range = (note >= trig_note_start && note < trig_note_start+8);
        in_range ? ( eon_pad_rgb(note) ? 0 : setcolor(0,120,150,255); ) :
        in_trig_range ? ( eon_tpi=note-trig_note_start; pattern_hue[eon_tpi]<0 ? (setcolor(150,144,132,255);) : (eon_hsl2rgb(pattern_hue[eon_tpi],0.60,0.40); gfx_a=1;); eon_tklum=(gfx_r*0.30+gfx_g*0.59+gfx_b*0.11)*0.55+0.28; ) :
        ( setcolor(26,28,36,255); );
        gfx_x=eon_kx; gfx_y=y+1; gfx_rectto((eon_kx+eon_bw)|0, (y + 1 + eon_ph*0.58)|0);
        in_range ? ( gfx_set(0.16,0.50,0.74,0.16); gfx_x=eon_kx; gfx_y=y+1; gfx_rectto((eon_kx+eon_bw)|0, (y + 1 + eon_ph*0.58)|0); );
        in_trig_range ? ( gfx_set(0.85,0.62,0.22,0.45); gfx_x=eon_kx; gfx_y=y+1; gfx_rectto((eon_kx+eon_bw)|0, (y + 1 + eon_ph*0.58)|0); );
        setcolor(6,8,14,255);   // dark/black outline on the black keys
        gfx_x=eon_kx;            gfx_y=y+1;                 gfx_lineto(eon_kx,            (y+1+eon_ph*0.58)|0, 0);
        gfx_x=(eon_kx+eon_bw)|0; gfx_y=y+1;                 gfx_lineto((eon_kx+eon_bw)|0, (y+1+eon_ph*0.58)|0, 0);
        gfx_x=eon_kx;            gfx_y=(y+1+eon_ph*0.58)|0; gfx_lineto((eon_kx+eon_bw)|0, (y+1+eon_ph*0.58)|0, 0);
        in_trig_range ? (   // pattern number on the trigger key (black)
          gfx_setfont(7, "Verdana", 9, 'b');
          eon_draw_trig_num((eon_kx + eon_bw*0.5 - 3)|0, y+2, note - trig_note_start + 1, eon_tklum);
          gfx_setfont(6, "Verdana", 9);
        );
        (mouse_y >= y && mouse_y < y+1+eon_ph*0.58 && mouse_x >= eon_kx && mouse_x < eon_kx+eon_bw) ? (eon_hovnote = note);
      ) : (
        eon_wi += 1;
      );
      i += 1;
    );
    gfx_setfont(0);
    tb_pianokey_end = gfx_w;
  ) : (
    gfx_x=x+2;gfx_y=y+1;
    w_scale=-1;
    while( w_scale+=1; gfx_w-128 > 483+w_scale*128; );
    note=0;
    loop(128,
      note >= basenote && note < basenote+numnotes ? in_range=1 : in_range=0;
      note >= trig_note_start && note < trig_note_start+npatterns ? in_trig_range=1 : in_trig_range=0;
      eon_kx = gfx_x;
      isSharp(note) ? (
        color(7); in_range ? (color(12);); in_trig_range ? (!in_range ? color(13););
        w=3; gap=0;
      ) : (
        color(4); in_range ? (color(14);); in_trig_range ? (color(15););
        w=4; !isSharp(note+1) ? gap=1 : gap=0;
      );
      gfx_rectto(eon_kx+w+w_scale,gfx_y+tbrh-2);
      gfx_x+=gap; gfx_y=y+1;
      note+=1;
    );
    tb_pianokey_end=10*(7*4+5*3+12*w_scale+2)+5*4+3*3+8*w_scale+1;
  );
  // EON: hovered note-name (+ pad-name if it's a kit pad) read-out at the strip's right
  (colorscheme==10 && eon_hovnote >= 0) ? (
    gfx_setfont(7, "Verdana", 12);
    (eon_pad_hue_for_note(eon_hovnote) > -5 && notenames[eon_hovnote] != 0) ? (
      sprintf(#eon_hovstr, "%s  -  %s", getNotename(eon_hovnote,1), notenames[eon_hovnote]);
    ) : (
      sprintf(#eon_hovstr, "%s", getNotename(eon_hovnote,1));
    );
    gfx_measurestr(#eon_hovstr, eon_hovw, eon_hovh);
    setcolor(8,10,16,235);
    gfx_x = gfx_w - eon_hovw - 12; gfx_y = y+tbrh;
    gfx_rectto(gfx_w-2, y+2*tbrh-1);
    setcolor(0,205,238,255);
    gfx_x = gfx_w - eon_hovw - 8; gfx_y = y + tbrh + ((tbrh-eon_hovh)*0.5)|0;
    gfx_printf(#eon_hovstr);
    gfx_setfont(0);
  );
);

function clear_pattern(pat) local(i, notelist, velolist, notetie, cclist)
(
  notelist=0;
  velolist=velolist_base;
  i=0;
  loop(pat,
    notelist+=listlength_pat[i];
    velolist+=max_numnotes*listlength_pat[i];
    i+=1;
  );
  notetie=notetie_base+notelist;
  cclist=cclist_base+notelist;
  notelist=notelist_base+notelist;
  memset(notelist, 0, listlength_pat[pat]);
  memset(notetie, 0, listlength_pat[pat]);
  memset(cclist, 0, listlength_pat[pat]);
  memset(velolist, 0, listlength_pat[pat]*max_numnotes);
  memset(sparebuf + pat*1024, 0, max_seqlength);
  memset(sparebuf_tie + pat*1024, 0, max_seqlength);
  memset(sparebuf_cc + pat*1024, 0, max_seqlength);
  memset(sparebuf2 + pat*max_numnotes*max_seqlength, 0, max_numnotes*max_seqlength);
);

function draw_pianokeys() local(notepos, octavestart)
(
  // Erase old keys
  //color(7); gfx_y=tbh-1;

  colorscheme==10 ? (gfx_set(0.60,0.57,0.51,1);) : (color(7););   // EON: darker-cream lane-column bg -> tile gaps read as soft cream separators (not black)
  gfx_x=0; gfx_y=tbh-1;
  gfx_rectto(pkw,grid_bottom);
  
  // Draw new keys
  notepos=0;
  loop(numnotes,
    octavestart = (basenote+(numnotes-1-notepos)) % 12;
    // Draw piano keys
    row_height >= 2 ? (
      mode == 0 ? (
        (octavestart == 1 || octavestart == 3 || octavestart == 6 || octavestart == 8 || octavestart == 10) ? (
          colorscheme==10 ? (   // EON: cream lane bg, so paint black keys explicitly (else they read cream until hovered)
            color(7);
            gfx_x=2.0; gfx_y=tbh+notepos*row_height+1;
            gfx_rectto(pkw-3, gfx_y+row_height-2);
          );
        ) : (
          color(4);
          gfx_x=2.0; gfx_y=tbh+notepos*row_height+1;
          gfx_rectto(pkw-3, gfx_y+row_height-2);
        );
      );
    );
    // Draw note names
    row_height >= 4 ? (
      mode == 0 ? (
        octavestart == 0 ? (
          color(16);
          gfx_x=chw+4.0; gfx_y=tbh+notepos*row_height+row_height/2-3;
          gfx_drawchar($'C');
          gfx_drawnumber(((basenote+(numnotes-1-notepos)) / 12)-1+octave_offset,0);
        );
      ) : (
        draw_drum_note(numnotes-1-notepos);
      );
    );
    notepos+=1;
  );
);

function getEnvColor(env)
(
  env == 0 ? (color(27););
  env == 1 ? (color(28););
  env == 2 ? (color(29););
  env == 3 ? (color(30););
);

function setEnvColor(env)
(
  env == cc_to_adjust ? (
    getEnvColor(env);
    gfx_a=1;
  ):(
  setcolor(76,76,76,127);
  );
);

function setCcControlColor(env)
(
  getEnvColor(env);
  gfx_a=1;
  env != cc_to_adjust ? ( 
    gfx_r*=0.3; gfx_g*=0.3; gfx_b*=0.3;
  );
);

function draw_cc_controls() local(cc_control_top, cc_control_height, ccpos)
(
  cc_control_top=grid_bottom+el_divh;
  
  // Erase old cc controls
  color(7); gfx_y=cc_control_top; gfx_x=0;
  gfx_rectto(pkw,gfx_h);
  
  cc_control_height=(elh-el_divh)/numccs;
  // Draw new cc controls
  cc_control_height >= 2 ? (
    ccpos=0;
    loop(numccs,
      setCcControlColor(ccpos);
      mode == 1 ? (
        gfx_x=2.0; gfx_y=cc_control_top+ccpos*cc_control_height+1;
        gfx_rectto(chw-3, gfx_y+cc_control_height-2);
        color(35);
        ccpos == cc_to_adjust ? gfx_a=154/255 : gfx_a=77/255;
        gfx_x=4.0; gfx_y=cc_control_top+ccpos*cc_control_height+cc_control_height/2-3;
        cc_chan[ccpos]+1 < 10 ? gfx_x=gfx_x+3.0;
        gfx_drawnumber(cc_chan[ccpos]+1, 0);
      );
      setCcControlColor(ccpos);
      gfx_x=chw; gfx_y=cc_control_top+ccpos*cc_control_height+1;
      gfx_rectto(pkw-3, gfx_y+cc_control_height-2);
      color(35);
      ccpos == cc_to_adjust ? gfx_a=154/255 : gfx_a=77/255;
      gfx_x=chw+4.0; gfx_y=cc_control_top+ccpos*cc_control_height+cc_control_height/2-3; 
      elh >=32 ? (
        cc_type[ccpos] == 1 ? (
          gfx_printf("Mod");
        ) : cc_type[ccpos] == 7 ? (
          gfx_printf("Vol");
        ) : cc_type[ccpos] == 10 ? (
          gfx_printf("Pan");
        ) : cc_type[ccpos] == 11 ? (
          gfx_printf("Exp");
        ) : cc_type[ccpos] == 64 ? (
          gfx_printf("HPd");
        ) : cc_type[ccpos] == 127 && ccpos==0 ? (
          gfx_printf("Prb");
        ) : (
          cc_type[ccpos] < 10 ? gfx_x=gfx_x+3.0;
          gfx_drawnumber(cc_type[ccpos], 0);
        );
      );
      ccpos+=1;
    );
  );
);

function draw_velobar(x, y, velo, note_w, note_h) local(tip_y, barwidth) // x, y is the bottom left corner of bar
(
  tip_y = 0.95*row_height*velo/128;
  tip_y < 1.0 ? tip_y = 1.0;
  tip_y > note_h ? tip_y = note_h;
  tip_y=tip_y|0;
  color(36);
  velobarwidth > note_w ? barwidth = note_w : barwidth = velobarwidth;
  gfx_x=x; gfx_y=y; 
  gfx_rectto(gfx_x + barwidth, gfx_y - tip_y);
);

function veloadjust_row(y, x, sd_x, veloadj) local(mask, i, sd_nl, sd_i, newvelo)
(
  lastnote_changed_x=x;
  mask = 2^y;
  i=0;
  loop(listlength,
    (notelist[i] & mask) ? (
      getSubdivNum(y*listlength+i) ? ( // subdiv note
        sd_nl = getSubdivNotelist(y, i);
        sd_nl ? ( // has enabled subdiv notes
          sd_i=0;
          loop(max_subdivs,
            sd_nl&(2^sd_i) ? (
              newvelo = getSubdivVelo(y, i, sd_i) + veloadj;
              newvelo < 1 ? newvelo=1;
              newvelo > 127 ? newvelo=127;
              setSubdivVelo(y, i, sd_i, newvelo); // Edit velocity
              i == x && sd_i == sd_x ? (lastnote_changed_velo = newvelo; sd_editval_show=1;);
            );
            sd_i+=1;
          );
        );
      ) : ( // not subdiv
        newvelo = getVelo(y*listlength+i) + veloadj;
        newvelo < 1 ? newvelo=1;
        newvelo > 127 ? newvelo=127;
        setVelo(y*listlength+i, newvelo);
        i == x ? lastnote_changed_velo = newvelo;
      );
    );
    i+=1;
  );
);
            
// ═══════════════════════════════════════════════════════════════════════════
// EON: embedded-view helpers (TCP / MCP). Declared here — after every @init and
// @gfx helper they call — and invoked from the embedded branch further below.
// All edits go through the SAME engine buffers as the full UI (notelist/velolist
// active-pattern pointers; INCMD mailbox or lane arrays for M/S), so the floating
// window, Swing pairing and @serialize stay consistent. Cross-frame state lives in
// ss_* globals (ss_mx/ss_my cursor, ss_over_widget passthrough, ss_lmb_prev edge).
// ───────────────────────────────────────────────────────────────────────────

// Toggle a step on/off in the active pattern — faithful to the full grid's plain
// left-click path (~line 3640): clear -> also drop tie + start offset + subdivs;
// set -> default velocity. update_has_notes() keeps the pattern-used markers right.
function ss_toggle_step(lane, step) local(mask, nidx) (
  mask = 2^lane;
  nidx = lane*listlength + step;
  (notelist[step] & mask) ? (                                  // erase
    notelist[step] -= mask;
    (notetie[step] & mask) ? notetie[step] -= mask;
    step > 0 && (notetie[step-1] & mask) ? notetie[step-1] -= mask;
    setStart(nidx, 0);
    setSubdivNotelist(lane, step, 0);
    setSubdivNum(nidx, 0);
  ) : (                                                        // draw
    notelist[step] += mask;
    setVelo(nidx, lastvelo > 0 ? lastvelo : 100);
  );
  update_has_notes();
);

// Toggle lane mute/solo — mirrors the pianokeys pill click (~line 4180): paired +
// mapped posts a SET toggle of the PAD state to the Swing INCMD mailbox (band echoes
// back); unpaired toggles the local lane array. Repaint via refresh_pianokeys.
function ss_mute_toggle(lane) local(pd, cb) (
  pd = eon_pair_slot >= 0 ? eon_lane_pad[lane] : -1;
  pd >= 0 ? (
    cb = EON_INCMD_BASE + eon_pair_slot*EON_INCMD_STRIDE + EON_INCMD_SEQ_MUTE + pd*2;
    gmem[cb+1] = gmem[EON_ID_BASE + eon_pair_slot*EON_ID_STRIDE + pd*EON_ID_FIELDS + EON_ID_MUTE] > 0.5 ? 0 : 1;
    gmem[cb] = 2;
  ) : (
    lane_mute[lane] = lane_mute[lane] ? 0 : 1;
  );
  refresh_pianokeys = 1;
);
function ss_solo_toggle(lane) local(pd, cb) (
  pd = eon_pair_slot >= 0 ? eon_lane_pad[lane] : -1;
  pd >= 0 ? (
    cb = EON_INCMD_BASE + eon_pair_slot*EON_INCMD_STRIDE + EON_INCMD_SEQ_SOLO + pd*2;
    gmem[cb+1] = gmem[EON_ID_BASE + eon_pair_slot*EON_ID_STRIDE + pd*EON_ID_FIELDS + EON_ID_SOLO] > 0.5 ? 0 : 1;
    gmem[cb] = 2;
  ) : (
    lane_solo[lane] = lane_solo[lane] ? 0 : 1;
    eon_recalc_solo();
  );
  refresh_pianokeys = 1;
);

// EON house header strip (orange "EON" + plugin name, theme-coloured), drawn atop
// both embedded views to match the other ReaKit plugins. On the RIGHT it draws a
// VIEW pill that cycles the embedded view GRID <-> PANELS (ss_embed_view), like the
// Drum Strip's VIEW button — the choice applies in BOTH the TCP and the MCP. Returns
// its pixel height so the caller lays content out below it.
function ss_embed_header(sc) local(hh, fs, tw, th, tx, bf) (
  hh = max(15, floor(16*sc));
  gfx_set(0.055, 0.065, 0.090, 1);                                  // dark header bar
  gfx_rect(0, 0, gfx_w, hh);
  gmem[GS_THEME_ID] > 0 ? setcolor_band(7, 200, 1.0) : gfx_set(0.20, 0.22, 0.27, 1);
  gfx_rect(0, hh-1, gfx_w, 1);                                      // divider under the bar
  // VIEW toggle pill (right): click cycles GRID <-> PANELS. Sets ss_over_widget so
  // the click is captured inline (not passed through to open the floating window).
  ss_embed_view < 0.5 ? strcpy(#ss_vl, "GRID") : strcpy(#ss_vl, "PANELS");
  fs = max(8, floor(10*sc));
  gfx_setfont(7, "Verdana", fs, 'b');
  gfx_measurestr(#ss_vl, tw, th);
  tw += floor(14*sc);
  tx = gfx_w - tw - floor(3*sc);
  gfx_set(0.13, 0.30, 0.40, 1); eon_fill_pill(tx, 2, tw, hh-4);
  gfx_set(0.92, 0.96, 1.00, 1);
  gfx_x = tx + floor(7*sc); gfx_y = ((hh - fs)*0.5) | 0; gfx_drawstr(#ss_vl);
  (ss_mx >= tx && ss_mx < gfx_w && ss_my >= 0 && ss_my < hh) ? (
    ss_over_widget = 1;
    (mouse_cap&1) && !ss_lmb_prev ? ss_embed_view = ss_embed_view < 0.5 ? 1 : 0;
  );
  // EON brand (left), shrinks to fit the space left of the pill
  bf = max(9, floor(11*sc));
  gfx_setfont(1, "Arial", bf, 'b');
  gfx_x = floor(5*sc); gfx_y = ((hh - bf)*0.5) | 0;
  gfx_set(0.95, 0.62, 0.12, 1); gfx_drawstr("EON");
  tx >= 95*sc ? (
    gmem[GS_THEME_ID] > 0 ? setcolor_band(2, 255, 1.0) : gfx_set(0.82, 0.84, 0.88, 1);
    gfx_drawstr(tx >= 132*sc ? " STEP SEQ" : " SEQ");
  );
  gfx_setfont(0);
  hh;
);

// GRID view (user-selectable): horizontal step grid of the active pattern (lanes =
// rows, steps = columns), pad-hued note cells brightened by velocity, live playhead
// column, and an optional pattern-bank row when there's vertical room. Click a
// cell to toggle the step; click a bank cell to switch pattern.
function ss_embed_grid()
  local(sc, cols, vis, hh, bankh, top, gw, gh, cw, rh, lane, step, nt, mask, cx, cy,
        named, lr, lg, lb, vel, lum, i, bw, bh, bx, clane, cstep, fs) (
  sc   = max(1, gfx_ext_retina);
  cols = max(1, listlength);
  vis  = max(1, min(numnotes, 16));
  gmem[GS_THEME_ID] > 0 ? setcolor_band(0, 255, 1.0) : gfx_set(0.09, 0.10, 0.12, 1);
  gfx_rect(0, 0, gfx_w, gfx_h);
  hh = ss_embed_header(sc);                                      // branded header strip
  bankh = (gfx_h - hh >= vis*10*sc + 18*sc) ? floor(14*sc) : 0; // pattern bank only when tall enough
  top = hh + bankh; gw = gfx_w; gh = max(1, gfx_h - top);
  cw = gw / cols; rh = gh / vis;
  lane = 0;
  loop(vis,
    cy   = top + (vis-1-lane)*rh;                                // lane 0 at the bottom (matches full UI)
    nt   = basenote + lane + notetranspose[lane];
    mask = 2^lane;
    named = eon_pad_rgb(nt);
    named ? ( lr=gfx_r; lg=gfx_g; lb=gfx_b; ) : ( lr=0.42; lg=0.40; lb=0.36; );
    step = 0;
    loop(cols,
      cx = step*cw;
      (step % steps_per_beat) == 0 ? gfx_set(0.20, 0.21, 0.25, 1) : gfx_set(0.13, 0.14, 0.17, 1);
      gfx_rect(cx+1, cy+1, max(1, cw-2), max(1, rh-2));
      (notelist[step] & mask) ? (
        vel = getVelo(lane*listlength + step);
        lum = 0.45 + 0.55*(vel/127);
        gfx_set(lr*lum, lg*lum, lb*lum, 1);
        gfx_rect(cx+1, cy+1, max(1, cw-2), max(1, rh-2));
      );
      step += 1;
    );
    lane += 1;
  );
  (lbeatpos >= 0 && lbeatpos < cols) ? (                         // playhead column
    gfx_set(0.0, 0.72, 0.86, 0.18);
    gfx_rect(lbeatpos*cw, top, max(1, cw), gh);
  );
  bankh > 0 ? (                                                  // pattern bank (1..8)
    fs = max(8, floor(8*sc)); bw = gfx_w/8; bh = bankh;
    gfx_setfont(7, "Verdana", fs);
    i = 0;
    loop(8,
      bx = i*bw;
      (slider1|0) == i ? gfx_set(0.10, 0.30, 0.40, 1) : (has_notes[i] ? gfx_set(0.22, 0.23, 0.28, 1) : gfx_set(0.13, 0.14, 0.17, 1));
      gfx_rect(bx+1, hh+1, max(1, bw-2), max(1, bh-2));
      gfx_set(0.86, 0.89, 0.93, 1);
      gfx_x = bx + (bw*0.5 - 3 | 0); gfx_y = hh+2; gfx_drawnumber(i+1, 0);
      (ss_mx >= bx && ss_mx < bx+bw && ss_my >= hh && ss_my < hh+bh) ? (
        ss_over_widget = 1;
        (mouse_cap&1) && !ss_lmb_prev ? ( change_pattern(i); sliderchange(slider1=p); sliderchange(slider3=listlength); );
      );
      i += 1;
    );
    gfx_setfont(0);
  );
  (ss_my >= top && ss_mx >= 0 && ss_mx < gfx_w) ? (              // step toggle
    clane = (vis-1) - (((ss_my-top)/gh)*vis | 0);
    cstep = ((ss_mx/gw)*cols) | 0;
    (clane >= 0 && clane < vis && cstep >= 0 && cstep < cols) ? (
      ss_over_widget = 1;
      (mouse_cap&1) && !ss_lmb_prev ? ss_toggle_step(clane, cstep);
    );
  );
  ss_lmb_prev = mouse_cap & 1;
);

// PANELS view (user-selectable): mixer-style lane panels — one tile per pad/lane
// (pad-coloured, dimmed when muted, white flash on the current step) with M and S
// pills. Adapts to 1 or 2 columns by width so all lanes stay readable in a narrow
// mixer strip OR a wide track. Click M/S to toggle (paired -> pad-owned via INCMD).
function ss_embed_panels()
  local(sc, vis, hh, ncols, percol, colw, rh, lane, col, row, nt, cx, cy,
        named, lr, lg, lb, lum, bh, bw, mbx, sbx, my0, vpd, vm, vs, fs) (
  sc   = max(1, gfx_ext_retina);
  vis  = max(1, min(numnotes, 16));
  gmem[GS_THEME_ID] > 0 ? setcolor_band(0, 255, 1.0) : gfx_set(0.09, 0.10, 0.12, 1);
  gfx_rect(0, 0, gfx_w, gfx_h);
  hh = ss_embed_header(sc);                                      // branded header + VIEW toggle
  ncols  = (gfx_w >= 140*sc && vis > 6) ? 2 : 1;                 // 2 cols when wide enough
  percol = ceil(vis / ncols);
  colw   = gfx_w / ncols;
  rh     = (gfx_h - hh) / percol;
  lane = 0;
  loop(vis,
    col = (lane / percol) | 0;                                  // col 0 = pads 0..percol-1, top-down
    row = lane - col*percol;
    cx  = col*colw;
    cy  = hh + row*rh;
    nt  = basenote + lane + notetranspose[lane];
    vpd = eon_pair_slot >= 0 ? eon_lane_pad[lane] : -1;
    vm  = vpd >= 0 ? gmem[EON_ID_BASE + eon_pair_slot*EON_ID_STRIDE + vpd*EON_ID_FIELDS + EON_ID_MUTE] > 0.5 : lane_mute[lane];
    vs  = vpd >= 0 ? gmem[EON_ID_BASE + eon_pair_slot*EON_ID_STRIDE + vpd*EON_ID_FIELDS + EON_ID_SOLO] > 0.5 : lane_solo[lane];
    named = eon_pad_rgb(nt);
    named ? ( lr=gfx_r; lg=gfx_g; lb=gfx_b; ) : ( lr=0.30; lg=0.30; lb=0.34; );
    gfx_set(lr, lg, lb, 1);
    gfx_rect(cx+1, cy+1, colw-2, max(1, rh-2));
    vm ? ( gfx_set(0, 0, 0, 0.48); gfx_rect(cx+1, cy+1, colw-2, max(1, rh-2)); );  // dim when muted
    (!vm && lbeatpos >= 0 && lbeatpos < listlength && (notelist[lbeatpos] & 2^lane)) ? (
      gfx_set(1, 1, 1, 0.22); gfx_rect(cx+1, cy+1, colw-2, max(1, rh-2));          // step flash
    );
    lum = lr*0.30 + lg*0.59 + lb*0.11;
    // lane name (left; pills draw over any overflow)
    (vm || lum <= 0.52) ? gfx_set(0.95, 0.96, 1.0, 1) : gfx_set(0.08, 0.09, 0.11, 1);
    fs = max(8, min(floor(rh*0.55), 12));
    gfx_setfont(7, "Verdana", fs);
    gfx_x = cx+4; gfx_y = cy + ((rh - fs)*0.5 | 0); gfx_drawstr(getNotename(nt, 0));
    // M/S pills (right of the cell)
    bh = min(max(rh-5, 8), 14); bw = bh + 3;
    sbx = cx + colw - bw - 2; mbx = sbx - bw - 2;
    my0 = cy + ((rh - bh)*0.5 | 0);
    gfx_setfont(8, "Verdana", min(max(bh-2, 7), 11));
    vm ? gfx_set(0.84, 0.27, 0.23, 1) : gfx_set(0.20, 0.20, 0.24, 1);
    eon_fill_pill(mbx, my0, bw, bh);
    vm ? gfx_set(1, 1, 1, 1) : gfx_set(0.62, 0.62, 0.66, 1);
    gfx_x = mbx + (bw/2 - 3 | 0); gfx_y = my0 + ((bh-8)/2 | 0); gfx_drawchar($'M');
    vs ? gfx_set(0.95, 0.78, 0.27, 1) : gfx_set(0.20, 0.20, 0.24, 1);
    eon_fill_pill(sbx, my0, bw, bh);
    vs ? gfx_set(0.09, 0.09, 0.09, 1) : gfx_set(0.62, 0.62, 0.66, 1);
    gfx_x = sbx + (bw/2 - 3 | 0); gfx_y = my0 + ((bh-8)/2 | 0); gfx_drawchar($'S');
    (ss_my >= cy && ss_my < cy+rh) ? (
      (ss_mx >= mbx && ss_mx < mbx+bw) ? ( ss_over_widget = 1; (mouse_cap&1) && !ss_lmb_prev ? ss_mute_toggle(lane); ) :
      (ss_mx >= sbx && ss_mx < sbx+bw) ? ( ss_over_widget = 1; (mouse_cap&1) && !ss_lmb_prev ? ss_solo_toggle(lane); );
    );
    lane += 1;
  );
  gfx_setfont(0);
  ss_lmb_prev = mouse_cap & 1;
);

row_height = (grid_bottom-tbh) / numnotes;

lgfx_w != gfx_w || lgfx_h != gfx_h || llistlength != listlength || lnumnotes != numnotes || lbasenote != basenote || lrateadj != rateadj || lmode != mode ? (
    
  lgfx_w = gfx_w; lgfx_h = gfx_h;
  llistlength = listlength;
  lnumnotes = numnotes;
  lbasenote = basenote;
  lrateadj = rateadj;
  lmode = mode;
  color(7); gfx_y=tbh; 
  gfx_rectto(gfx_w,gfx_h);
  
  draw_pianokeys();
  draw_cc_controls();
  
  velobarwidth = scale_velobarwidth(listlength);
  
  // Precalc values for bar line drawing
  nbars = listlength/rateadj/4/(ts_num_l/ts_denom_l);
  barlen = (gfx_w - pkw)/nbars;

  // Precalc note square width
  note_w = (gfx_w - pkw)/listlength;
);

// ═══════════════════════════════════════════════════════════════════════════
// EON: live drum-map note-name sync from the active Swing kit.
// Read-only on Swing's gmem (Swing_Media_Transfer): per pad p (0..15),
//   MIDI note = gmem[100 + p*80 + 10],  name = ASCII 1-char/slot, 0-terminated
//   at gmem[1720 + p*32 + i],  alive = gmem[1711] (GS_SWING_ALIVE).
// Rebuilds notenames[] only when the kit's notes/names change, so pad renames
// and kit loads relabel rows automatically. Falls through to the original
// drum-map FILE load when no Swing instance is present (standalone use).
// ═══════════════════════════════════════════════════════════════════════════
eon_swing_alive = gmem[EON_SW_ALIVE] > 0;
eon_publish_ms();   // EON: publish per-pad lane mute/solo to gmem for the Swing bridge to mirror onto tracks
eon_sync_tick += 1;
// Throttle the kit change-detect to ~every 5 frames (was every frame -> CPU). Still catches
// kit loads from Swing OR the Browser within ~150ms. First sync / file->Swing handoff forced immediately.
// EON: pad NAMES + colours adopt the Swing kit only when PAIRED. On any pairing change,
// force a name re-sync (sentinel) so the correct block below re-runs: paired -> kit names;
// unpaired -> the GM-default block (which also re-sizes the header for plain note names).
eon_pair_slot != eon_last_pair_ns ? (eon_last_pair_ns = eon_pair_slot; lnotenames_file = -99;);
eon_swing_alive && mode==1 && eon_pair_slot >= 0 && (eon_sync_tick >= 3 || lnotenames_file != -1) ? (
  eon_sync_tick = 0;
  // EON: when paired, read THIS instance's IDENT/PADNAME bands; else the shared META.
  // Only the BASE (and the note/hue per-pad stride) differ -- name stride is 32 in both.
  eon_md_note_b = eon_pair_slot >= 0 ? (EON_ID_BASE + eon_pair_slot*EON_ID_STRIDE + EON_ID_NOTE) : (EON_SW_META_BASE + EON_SW_NOTE_OFF);
  eon_md_hue_b  = eon_pair_slot >= 0 ? (EON_ID_BASE + eon_pair_slot*EON_ID_STRIDE + EON_ID_HUE)  : (EON_SW_META_BASE + EON_SW_HUE_OFF);
  eon_md_st     = eon_pair_slot >= 0 ? EON_ID_FIELDS : EON_SW_META_PP;
  eon_md_nm_b   = eon_pair_slot >= 0 ? (EON_IDNAME_BASE + eon_pair_slot*EON_IDNAME_STRIDE) : EON_SW_PADNAME_BASE;
  // cheap change-detect: checksum each pad's note + first 16 name bytes + per-pad hue + theme S/L
  // rolling polynomial hash (mod a large prime) -- far less collision-prone than the old additive
  // sum, so kit changes that left the additive checksum unchanged are now reliably detected
  eon_sum = 0; eon_p = 0;
  loop(16,
    eon_sum = (eon_sum*131 + (gmem[eon_md_note_b + eon_p*eon_md_st]|0) + 1) % 2000000011;
    eon_ci = 0;
    loop(20,
      eon_sum = (eon_sum*131 + (gmem[eon_md_nm_b + eon_p*EON_SW_PADNAME_LEN + eon_ci]|0) + 1) % 2000000011;
      eon_ci += 1;
    );
    eon_sum = (eon_sum*131 + ((gmem[eon_md_hue_b + eon_p*eon_md_st]*1000)|0) + 1) % 2000000011; // per-pad hue
    eon_p += 1;
  );
  eon_sum = (eon_sum*131 + ((gmem[EON_SW_COL_S]*1000)|0)) % 2000000011;
  eon_sum = (eon_sum*131 + ((gmem[EON_SW_COL_L]*1000)|0)) % 2000000011; // theme sat / lightness
  // rebuild when names changed, or when the FILE path last owned notenames[]
  (eon_sum != eon_last_sync_sum || lnotenames_file != -1) ? (
    eon_last_sync_sum = eon_sum;
    memset(notenames, 0, 128);
    max_notename_length = 4;
    eon_p = 0;
    loop(16,
      eon_nt = gmem[eon_md_note_b + eon_p*eon_md_st] | 0;
      (eon_nt >= 0 && eon_nt <= 127) ? (
        eon_sl = eon_p + 1;          // string slots 1..16 (free while Swing drives names)
        strcpy(eon_sl, "");
        eon_base = eon_md_nm_b + eon_p*EON_SW_PADNAME_LEN;
        eon_ci = 0;
        eon_c = gmem[eon_base];
        while(eon_ci < 31 && eon_c > 0 && eon_c <= 127) (
          sprintf(#eon_ch, "%c", eon_c);
          strcat(eon_sl, #eon_ch);
          eon_ci += 1;
          eon_c = gmem[eon_base + eon_ci];
        );
        eon_ci > 0 ? (
          notenames[eon_nt] = eon_sl;
          eon_ci > max_notename_length ? max_notename_length = min(12, eon_ci);
        );
      );
      eon_p += 1;
    );
    pianow = max_notename_length*8 + 8;
    eon_colvis_apply();
    barlen = (gfx_w - pkw)/nbars;
    note_w = (gfx_w - pkw)/listlength;
    draw_pianokeys();
    draw_cc_controls();
    refresh_tb=1;                    // also recolour the toolbar keys/pads immediately on a kit change
    lnotenames_file = -1;            // mark "Swing owns names"; file reloads if Swing drops
  );
);

(!eon_swing_alive || eon_pair_slot < 0) && lnotenames_file != notenames_file && mode==1 ? (
  lnotenames_file=notenames_file;
  
  memset(notenames, 0, 128); // clear old note names
  max_notename_length=4; // reset to default
  notename_str = #;
  nn_filename = #;
  // handle = file_open("seqbaby_data/GM Kit.txt");
  // drum-map file removed: empty filename -> file_open fails -> notenames stay cleared (GM names)
  !((handle = file_open(nn_filename)) < 0) ? ( // file_open successful
    nn_name=1; // collect note names to string slots starting from slot 1, slot 0 is always empty string
    notename_name = #;
    while(
      str_len = file_string(handle,notename_str);
      match("%-3{notename_note}d\t%{notename_name}s",notename_str) ? (
        notename_note >= 0 && notename_note <= 127 ? (
          strncpy(nn_name, notename_name, strlen(notename_name)-2);
          notenames[notename_note]=nn_name;
          strlen(nn_name) > max_notename_length ? max_notename_length = strlen(nn_name);
          nn_name+=1;         
        );
      );
      str_len > 0;
    );
    file_close(handle);
  );
  pianow=max_notename_length*8+8;
  eon_colvis_apply();
  barlen = (gfx_w - pkw)/nbars; // Update barlen for bar line drawing
  note_w = (gfx_w - pkw)/listlength; // Update note square width
  draw_pianokeys();
  draw_cc_controls();
);

// ═══════════════════════════════════════════════════════════════════════════
// EON: EMBEDDED TCP/MCP BRANCH. When REAPER draws this JSFX inside a track's TCP
// or the mixer MCP (gfx_ext_flags & 1), render a compact view and SKIP the full
// sequencer UI + its input handling below — otherwise the full grid's hit-tests
// would double-handle embed clicks. TWO user-selectable views, toggled by the VIEW
// pill in the header (ss_embed_view): GRID (step grid) and PANELS (mixer lane M/S).
// Either view works in BOTH the TCP and the MCP. Hybrid passthrough: over a control
// 0x200 stays clear (click handled inline); over dead space 0x200 is armed so the
// click opens the floating window. The notenames/kit sync + eon_publish_ms above run
// for BOTH paths, so lane colours/names and the Swing M/S mirror stay live even when
// only the embed is shown. (Borderless 0x100 is requested in @init.)
// ═══════════════════════════════════════════════════════════════════════════
ss_emb = gfx_ext_flags & 1;
// ⚠️ MODE-FLIP REPAINT. This file runs gfx_clear=-1 (line ~1080), so REAPER
// never wipes the framebuffer and the full UI repaints only the bands whose
// dirty flag is set (refresh_tb / refresh_pianokeys / refresh_cc_controls).
// The embed renderer, by contrast, blanks the WHOLE surface every pass
// (ss_embed_grid, gfx_rect(0,0,gfx_w,gfx_h)). So after any embedded pass the
// full view's dirty flags are LYING: they say "still drawn" about pixels the
// embed just erased, and every band that does not repaint each frame — the
// header strip above all — keeps showing the compact grid underneath.
// Nothing detected that transition before, which is why embedding in the MCP
// left the compact grid painted into the floating window's header.
// EON_Drum_Strip and EON_FX_Return_View never hit this: neither sets
// gfx_clear=-1, so REAPER wipes for them and there is nothing stale to carry.
ss_emb != ss_prev_emb ? (
  ss_prev_emb = ss_emb;
  refresh_tb = 1; refresh_pianokeys = 1; refresh_cc_controls = 1;
);
ss_emb ? (
  ss_mx = mouse_x; ss_my = mouse_y;
  gfx_ext_flags = (gfx_ext_flags | 0x200) - 0x200;     // clear passthrough (EEL2 has no ~); re-armed over dead space
  ss_over_widget = 0;
  ss_embed_view < 0.5 ? ss_embed_grid() : ss_embed_panels();
  !ss_over_widget ? gfx_ext_flags |= 0x200;            // dead-space click -> open floating window
  mouse_wheel = 0;
) : (

refresh_pianokeys ? (
  refresh_pianokeys=0;
  draw_pianokeys();
);

y_from_top=((mouse_y-tbh) / (grid_bottom-tbh))*numnotes;
y = numnotes - 1 - (y_from_top|0);
y_acc = numnotes - y_from_top;
mouse_y < tbh ? y+=1;

// EON: track which lane's control strip the mouse hovers -> highlights that lane's swing pill (refresh on change)
eon_hover_lane_new = (colorscheme==10 && mode==1 && mouse_x >= pkw-eon_ctrlw && mouse_x < pkw && mouse_y >= tbh && mouse_y < grid_bottom && y >= 0 && y < numnotes) ? y : -1;
eon_hover_lane_new != eon_hover_lane ? (eon_hover_lane = eon_hover_lane_new; refresh_pianokeys = 1;);

// ── PROBLEM 3: feeding the dirty-flag repaint enough frames to animate ───────
// The knob widget's hover_t only advances on frames where the lane header
// actually redraws, so two things have to dirty it.
// (a) ENTRY. The lane-level tracker above only fires when the LANE changes --
//     sliding sideways from the name into a knob, or between the two knobs, is
//     the same lane, so it would never repaint and the knob could never light
//     up. Track which KNOB is under the cursor and dirty on that change too.
// Bounds MUST be the widget's own test -- dist(mx,my,cx,cy) <= r, a circle. This
// started life as an x-only band spanning the full row height, which left a dead
// strip above and below each knob: too far out for the widget to accept the wheel,
// but still inside this test, so it suppressed the lane-swing wheel as well. The
// wheel did nothing there and the hover never lit. Same centre maths the draw uses
// (notepos = numnotes-1-lane), so the hit region and the pixels agree exactly.
eon_kn_hcy = tbh + (numnotes-1-eon_hover_lane_new)*row_height + row_height*0.5;
eon_kn_hov_new = (eon_hover_lane_new >= 0 && eon_lane_has_mix(eon_hover_lane_new)) ? (
  eon_kn_v_on && dist(mouse_x, mouse_y, eon_kn_vx, eon_kn_hcy) <= eon_kn_r ? eon_hover_lane_new*2 :
  eon_kn_p_on && dist(mouse_x, mouse_y, eon_kn_px, eon_kn_hcy) <= eon_kn_r ? eon_hover_lane_new*2 + 1 : -1
) : -1;
eon_kn_hov_new != eon_kn_hov ? (eon_kn_hov = eon_kn_hov_new; refresh_pianokeys = 1;);
// (b) TRANSITION. Latched during the draw pass whenever some knob's hover_t is
//     strictly between 0 and 1, or a drag is live. Self-terminating: once every
//     knob has settled at 0 or 1 nothing sets it and the repaints stop.
ss_knob_anim ? refresh_pianokeys = 1;
// (c) ⚠ THE ONE THAT MAKES THEM ACTUALLY TURN. mpc_knob_interact runs from inside
//     the DRAW pass, and the draw pass is dirty-gated. With only (a) and (b) the
//     sequence was: enter knob -> dirty -> hover_t animates 0..1 -> settles at 1 ->
//     NOTHING is dirty any more -> draw stops -> interact stops running -> the
//     click edge is never seen and the knob cannot be grabbed at all. It looked
//     like a dead widget. While the cursor is ON a knob we therefore repaint every
//     frame, which is what feeds interact the mouse. Still bounded -- the moment
//     the cursor leaves, eon_kn_hov goes -1 and this stops. A live drag is covered
//     by (b) via mem[1], so dragging off the knob keeps working.
eon_kn_hov >= 0 ? refresh_pianokeys = 1;

// EON: mouse-wheel over a drum lane sets that lane's swing (wheel is otherwise unused; left-click auditions the lane)
// PROBLEM 4: this used to claim the WHOLE header width, which now includes the
// VOL/PAN knobs -- and knobs_kbsg knobs take the wheel themselves. Both would
// have fired on one notch: the knob would move AND the lane's swing would jump.
// eon_kn_hov (computed above) is -1 unless the cursor is actually on a knob, so
// excluding it hands the wheel to the more specific target and leaves every
// other pixel of the header behaving exactly as before.
colorscheme==10 && mode==1 && mouse_wheel != 0 && eon_kn_hov < 0 && mouse_x >= 0 && mouse_x < pkw && mouse_y >= tbh && mouse_y < grid_bottom ? (
  eon_sw_lane = numnotes-1-((((mouse_y-tbh)/(grid_bottom-tbh))*numnotes)|0);   // fresh lane (global y can be clobbered)
  (eon_sw_lane >= 0 && eon_sw_lane < numnotes) ? (
    lane_swing[eon_sw_lane] = max(0, min(100, lane_swing[eon_sw_lane] + (mouse_wheel>0 ? (mouse_cap&8 ? 1 : 5) : (mouse_cap&8 ? -1 : -5))));
    mouse_wheel = 0;
    refresh_pianokeys = 1;
    groove_dirty = 1;   // EON GROOVE: lane strength changed -> rebuild the runtime table
  );
);

// EON: Settings overlay geometry + click-shield (panel clicks must not reach the grid)
eon_so_open = (colorscheme==10 && settingsopen);
// EON: on any settings open/close, force a full repaint of the grid/lanes/CC area the
// panel covers -- otherwise closing leaves the panel's pixels lingering over the grid
// (refresh_tb alone only repaints the toolbar), and clicks on that dead residue fall
// through to the notes behind it.
settingsopen != eon_so_last_open ? (
  eon_so_last_open = settingsopen;
  refresh_tb=1; refresh_pianokeys=1; refresh_cc_controls=1; eon_pdraw = max(eon_pdraw, 2);
);
eon_so_open ? (
  eon_so_w=372; eon_so_h=466; eon_so_x=((gfx_w-eon_so_w)/2)|0; eon_so_y=(tbh+18)|0;  // h: +30 each for "Region (DM)" + "Grid feel" + "Export > DM" + "Zoom on select" + "Sync on by default" + "Auto-adapt patterns" + "Grid lines" + "Lane columns" rows over the 226 base — keeps all inside the click-shield
  eon_so_in_panel = (mouse_x>=eon_so_x && mouse_x<eon_so_x+eon_so_w && mouse_y>=eon_so_y && mouse_y<eon_so_y+eon_so_h);
) : (eon_so_in_panel=0);

// EON: VIEW dropdown geometry + grid-shield (drops below the VIEW pill)
eon_vdd_open ? (
  eon_vdd_x = eon_vwx+2; eon_vdd_y = (eon_pbh+tbrh-2)|0; eon_vdd_w = busp*4; eon_vdd_rh = 19; eon_vdd_h = 5*eon_vdd_rh;
  eon_vdd_in_panel = (mouse_x>=eon_vdd_x && mouse_x<eon_vdd_x+eon_vdd_w && mouse_y>=eon_vdd_y && mouse_y<eon_vdd_y+eon_vdd_h);
) : (eon_vdd_in_panel=0);

// EON: VIEW dropdown click -- handled EARLY + sets mstate so the click is consumed (no click-through to grid/controls)
eon_vdd_open && mstate==0 && mouse_cap==1 ? (
  eon_vdd_in_panel ? (
    eon_vdd_sel = ((mouse_y - eon_vdd_y)/eon_vdd_rh)|0;
    (eon_vdd_sel>=0 && eon_vdd_sel<5) ? (slider17=eon_vdd_sel; sliderchange(slider17); recalc_elh=1;);
  );
  eon_vdd_open=0; refresh_tb=1; eon_pdraw=4; mstate=ms_tb_button_noundo;   // select or click-outside -> close, swallow the click
);

// EON: THEME picker — shared rk_theme_picker.jsfx-inc (chip + scrollable dropdown,
// identical to Swing / Drum Strip). INPUT runs EARLY (before the grid/control-row
// handlers) so it can consume the click/wheel; the chip + dropdown are DRAWN later
// (rkth_draw_chip / rkth_overlay_draw). Geometry matches the pattern-row THEME slot
// (busp*24..27). The legacy gate name eon_thdd_in_panel is recomputed from the shared
// dropdown region so the grid / control-row handlers below still gate correctly.
colorscheme==10 ? (
  eon_thx = eon_thx2; eon_thy = eon_r2+1; eon_thw = busp*3-3; eon_thh = tbrh-2;
  rkth_input(eon_thx, eon_thy, eon_thw, eon_thh, mouse_x, mouse_y,
             (mstate==0 && mouse_cap==1) ? 1 : 0, (mstate==0 && mouse_cap==2) ? 1 : 0,
             mouse_wheel, 19) ? (
    mstate=ms_tb_button_noundo; refresh_tb=1; eon_pdraw=4; mouse_wheel=0;
  );
  eon_thdd_in_panel = rkth_open && mouse_x>=rkth_ddx && mouse_x<rkth_ddx+rkth_ddw && mouse_y>=rkth_ddy && mouse_y<rkth_ddy+rkth_ddh;
) : (eon_thdd_in_panel=0);

// EON: ZOOM cells (control row, under the settings cog) — SONG (op 10) frames
// the arrange on all pattern regions, PAT (op 11, A1 = the selected pattern's
// absolute ordinal) frames just that pattern's region. Bridge-side ops via the
// song-command mailbox, so they need a paired Swing + region sync (the cells
// draw dimmed when unpaired). EARLY like the THEME input above so the click
// never falls through to the grid / control-row handlers.
colorscheme==10 && mstate==0 && mouse_cap==1 && eon_pair_slot >= 0
  && mouse_y >= eon_r2 && mouse_y < eon_r2b ? (
  (mouse_x >= eon_cogb_x && mouse_x < eon_cogb_x+busp-3) ? (
    eon_song_cmd(10, 0, 0);
    mstate = ms_tb_button_noundo; refresh_tb = 1;
  ) :
  (mouse_x >= eon_cogb_x+busp && mouse_x < eon_cogb_x+busp*2-3) ? (
    eon_song_cmd(11, max(eon_sel_ord, 1), 0);
    mstate = ms_tb_button_noundo; refresh_tb = 1;
  );
);

// EON: PAIR dropdown geometry + selection (mirrors the THEME dropdown above). Row 0 =
// "Auto (same track)", then one row per LIVE roster slot in slot order. Selection ->
// GS_SS_PICKER_SEL; the bridge persists the pairing (P_EXT GUID) and pushes the resolved
// slot back into slider48, which updates the button label.
eon_prdd_open ? (
  eon_prdd_x = busp*22; eon_prdd_y = (eon_pbh+tbrh-2)|0; eon_prdd_w = busp*6; eon_prdd_rh = 19;
  eon_prdd_n = 1; eon_pri = 0;
  loop(GS_SS_ROSTER_MAX,
    gmem[GS_SS_ROSTER_BASE + eon_pri*GS_SS_ROSTER_STRIDE] > 0 ? eon_prdd_n += 1;
    eon_pri += 1;
  );
  eon_prdd_h = eon_prdd_n*eon_prdd_rh;
  eon_prdd_in_panel = (mouse_x>=eon_prdd_x && mouse_x<eon_prdd_x+eon_prdd_w && mouse_y>=eon_prdd_y && mouse_y<eon_prdd_y+eon_prdd_h);
) : (eon_prdd_in_panel=0);
eon_prdd_open && mstate==0 && mouse_cap==1 ? (
  eon_prdd_in_panel ? (
    eon_prdd_sel = ((mouse_y - eon_prdd_y)/eon_prdd_rh)|0;
    eon_prdd_sel == 0 ? (
      gmem[GS_SS_PICKER_SEL] = 1;                       // Auto (same track)
    ) : (
      // visible row N -> the N-th live roster slot
      eon_prr = 0; eon_pri = 0; eon_prpick = -1;
      loop(GS_SS_ROSTER_MAX,
        gmem[GS_SS_ROSTER_BASE + eon_pri*GS_SS_ROSTER_STRIDE] > 0 ? (
          eon_prr += 1;
          eon_prr == eon_prdd_sel ? eon_prpick = eon_pri;
        );
        eon_pri += 1;
      );
      eon_prpick >= 0 ? gmem[GS_SS_PICKER_SEL] = eon_prpick + 2;
    );
  );
  eon_prdd_open=0; refresh_tb=1; eon_pdraw=4; mstate=ms_tb_button_noundo;   // select or click-outside -> close
);

// EON GROOVE menu: geometry + EARLY input (consumed like VIEW/PAIR). Opened by a lane
// pill click (eon_gdd_lane = lane) or master pill right-click (eon_gdd_lane = -1).
// Rows: builtins 0..7, then LOADED user slots 8..15, then (master only) a Vel-accent
// row that click-cycles 0/25/50/75/100 and keeps the menu open.
eon_gdd_open ? (
  // TWO-COLUMN panel: left = shapes + ALL 7 user slots (empty ones greyed) + (master Vel
  // row) + Import; right = ladder snaps. Row index 9..15 == slot id directly.
  eon_gdd_rh = 19; eon_gdd_cw = 118; eon_gdd_w = eon_gdd_cw*2;
  eon_gdd_nl = 16 + (eon_gdd_lane < 0 ? 2 : 1);            // 9 shapes + 7 slots + (master: Vel) + Import
  eon_gdd_rows = max(eon_gdd_nl, grv_snap_n);
  eon_gdd_h = eon_gdd_rows*eon_gdd_rh;
  eon_gdd_x > gfx_w - eon_gdd_w - 2 ? eon_gdd_x = max(0, gfx_w - eon_gdd_w - 2);
  eon_gdd_y + eon_gdd_h > gfx_h - 2 ? eon_gdd_y = max(0, gfx_h - 2 - eon_gdd_h);
  eon_gdd_in_panel = (mouse_x>=eon_gdd_x && mouse_x<eon_gdd_x+eon_gdd_w && mouse_y>=eon_gdd_y && mouse_y<eon_gdd_y+eon_gdd_h);
) : (eon_gdd_in_panel=0);
eon_gdd_open && mstate==0 && mouse_cap==1 ? (
  eon_gdd_keep = 0;
  eon_gdd_in_panel ? (
    eon_gdd_sel = ((mouse_y - eon_gdd_y)/eon_gdd_rh)|0;
    eon_gdd_col = ((mouse_x - eon_gdd_x)/eon_gdd_cw)|0;
    eon_gdd_pick = -1; eon_gdd_snap = -1; eon_gdd_isvel = 0; eon_gdd_isimp = 0;
    eon_gdd_col == 1 ? (
      (eon_gdd_sel >= 0 && eon_gdd_sel < grv_snap_n) ? eon_gdd_snap = eon_gdd_sel;
    ) : (
      (eon_gdd_sel >= 0 && eon_gdd_sel < 9) ? eon_gdd_pick = eon_gdd_sel :
      (eon_gdd_sel < 16) ? (
        // rows 9..15 == user slots 9..15 directly. Loaded -> pick it; EMPTY -> open the
        // import browser pre-pointed at this slot.
        (groove_slots[eon_gdd_sel*GROOVE_STRIDE + 145]&1) ? eon_gdd_pick = eon_gdd_sel : (
          gmem[EON_SS_GRV_OPEN_SLOT]  = eon_pair_slot >= 0 ? eon_pair_slot : 0;
          gmem[EON_SS_GRV_OPEN_USLOT] = eon_gdd_sel - 9;
          gmem[EON_SS_GRV_OPEN_REQ]   = (gmem[EON_SS_GRV_OPEN_REQ]|0) + 1;
        );
      ) :
      (eon_gdd_sel == eon_gdd_nl - 1) ? eon_gdd_isimp = 1 :
      (eon_gdd_lane < 0 && eon_gdd_sel == eon_gdd_nl - 2) ? eon_gdd_isvel = 1;
    );
    eon_gdd_snap >= 0 ? (
      // ladder snap: a named machine value = groove slot + exact strength in one click
      eon_gs_slot = grv_snaps[eon_gdd_snap*4+2]|0;
      eon_gs_str  = grv_snaps[eon_gdd_snap*4+3]|0;
      eon_gdd_lane >= 0 ? (
        lane_groove[eon_gdd_lane] = eon_gs_slot;
        lane_swing[eon_gdd_lane]  = eon_gs_str;
      ) : (
        master_groove = eon_gs_slot;
        swing_p = eon_gs_str; swing = ((tpb/2)*(swing_p/100))|0;
        sliderchange(slider8 = swing_p);
        memset(lane_groove, eon_gs_slot, max_numnotes);
        memset(lane_swing, swing_p, max_numnotes);
      );
      groove_dirty = 1;
      eon_apply_dirty = 1; eon_apply_settle = 0;
      refresh_pianokeys = 1;
    ) :
    eon_gdd_pick >= 0 ? (
      eon_gdd_lane >= 0 ? (
        lane_groove[eon_gdd_lane] = eon_gdd_pick;
        // a fresh pick at strength 0 would be inaudible -> give it a usable default
        (lane_swing[eon_gdd_lane] == 0 && eon_gdd_pick > 0) ? lane_swing[eon_gdd_lane] = 60;
      ) : (
        master_groove = eon_gdd_pick;
        (swing_p == 0 && eon_gdd_pick > 0) ? (
          swing_p = 60; swing = ((tpb/2)*(swing_p/100))|0;
          sliderchange(slider8 = swing_p);
        );
        memset(lane_groove, eon_gdd_pick, max_numnotes);   // master pick -> all lanes (lane picks override after)
        memset(lane_swing, swing_p, max_numnotes);
      );
      groove_dirty = 1;
      eon_apply_dirty = 1; eon_apply_settle = 0;           // debounced sliderchange -> undo point + serialize snapshot
      refresh_pianokeys = 1;
    ) : (
      eon_gdd_isvel ? (                                    // Vel accent row (master menu only)
        eon_gv = groove_vel_amt_p1 > 0 ? groove_vel_amt_p1 - 1 : 100;
        eon_gv = eon_gv >= 100 ? 0 : eon_gv + 25;
        groove_vel_amt_p1 = eon_gv + 1;
        groove_dirty = 1; eon_apply_dirty = 1; eon_apply_settle = 0;
        eon_gdd_keep = 1;                                  // stay open for repeat clicks
      ) :
      eon_gdd_isimp ? (                                    // "Import grooves..." -> bridge launches the .rgt browser
        gmem[EON_SS_GRV_OPEN_SLOT]  = eon_pair_slot >= 0 ? eon_pair_slot : 0;
        gmem[EON_SS_GRV_OPEN_USLOT] = 0;                   // no particular slot suggestion
        gmem[EON_SS_GRV_OPEN_REQ]   = (gmem[EON_SS_GRV_OPEN_REQ]|0) + 1;
      );
    );
  );
  !eon_gdd_keep ? eon_gdd_open = 0;
  refresh_tb=1; eon_pdraw=4; mstate=ms_tb_button_noundo;   // select or click-outside -> close, swallow
);

// EON ICONS picker: geometry + EARLY input (consumed like GROOVE). Opened by a lane
// icon-column click (eon_ico_lane). Layout: header (hovered name) + Auto row + an
// 8x6 grid of the 46 category glyphs (last 2 cells dead). eon_ico_hov: -2 none,
// -1 Auto, 0..45 category.
eon_ico_open ? (
  eon_ico_hh = 22; eon_ico_ah = 19; eon_ico_cell = 26; eon_ico_cols = 8;   // 8x6 = 46 categories + 2 dead cells
  eon_ico_w = eon_ico_cols*eon_ico_cell + 8;
  eon_ico_h = eon_ico_hh + eon_ico_ah + 6*eon_ico_cell + 8;
  eon_ico_x > gfx_w - eon_ico_w - 2 ? eon_ico_x = max(0, gfx_w - eon_ico_w - 2);
  eon_ico_y + eon_ico_h > gfx_h - 2 ? eon_ico_y = max(0, gfx_h - 2 - eon_ico_h);
  eon_ico_gx = eon_ico_x + 4;
  eon_ico_gy = eon_ico_y + eon_ico_hh + eon_ico_ah + 2;
  eon_ico_in_panel = mouse_x>=eon_ico_x && mouse_x<eon_ico_x+eon_ico_w && mouse_y>=eon_ico_y && mouse_y<eon_ico_y+eon_ico_h;
  eon_ico_hov = -2;
  (mouse_x>=eon_ico_x && mouse_x<eon_ico_x+eon_ico_w && mouse_y>=eon_ico_y+eon_ico_hh && mouse_y<eon_ico_y+eon_ico_hh+eon_ico_ah) ? eon_ico_hov = -1 :
  (mouse_x>=eon_ico_gx && mouse_x<eon_ico_gx+eon_ico_cols*eon_ico_cell && mouse_y>=eon_ico_gy && mouse_y<eon_ico_gy+6*eon_ico_cell) ? (
    eon_ico_hov = (((mouse_y-eon_ico_gy)/eon_ico_cell)|0)*eon_ico_cols + (((mouse_x-eon_ico_gx)/eon_ico_cell)|0);
    // Cell 46 = NONE (parity with Swing's pad picker); 47 stays dead. -2 is
    // "not hovering anything", so NONE needs its own value, not -2.
    eon_ico_hov == 46 ? eon_ico_hov = PADCAT_NONE :
    eon_ico_hov > 45  ? eon_ico_hov = -2;
  );
) : (eon_ico_in_panel = 0; eon_ico_hov = -2;);
eon_ico_open && mstate==0 && mouse_cap==1 ? (
  eon_ico_in_panel ? (
    // Kit-categories write-back: PAIRED picks set the PAD's category through
    // the bridge mailbox (one source of truth — Swing badge + our lane both
    // follow the republished band); the local override is CLEARED so the pad
    // category shows through. UNPAIRED keeps the local override as before.
    eon_ico_hov == -1 ? (
      lane_icon_override[eon_ico_lane] = 0;
      eon_pair_slot >= 0 ? (
        gmem[EON_PADCAT_REQ + 1] = eon_pair_slot;
        // eon_ico_lane is the ROW — convert to the lane's MIDI note (the 3961 formula)
        gmem[EON_PADCAT_REQ + 2] = basenote + eon_ico_lane + notetranspose[eon_ico_lane];
        gmem[EON_PADCAT_REQ + 3] = -1;                       // Auto: re-infer from pad name
        gmem[EON_PADCAT_REQ + 4] = -1;                       // SRC hint: leave provenance alone
        eon_ico_reqseq += 1; gmem[EON_PADCAT_REQ] = eon_ico_reqseq;   // seq LAST
      );
      eon_apply_dirty = 1; eon_apply_settle = 0;             // debounced sliderchange -> undo point + serialize snapshot
      refresh_pianokeys = 1;
    ) :
    eon_ico_hov >= 0 ? (
      eon_pair_slot >= 0 ? (
        lane_icon_override[eon_ico_lane] = 0;                // paired: pad owns the identity
        gmem[EON_PADCAT_REQ + 1] = eon_pair_slot;
        gmem[EON_PADCAT_REQ + 2] = basenote + eon_ico_lane + notetranspose[eon_ico_lane];
        gmem[EON_PADCAT_REQ + 3] = eon_ico_hov;              // glyph id = category
        gmem[EON_PADCAT_REQ + 4] = -1;                       // SRC hint: leave provenance alone
        eon_ico_reqseq += 1; gmem[EON_PADCAT_REQ] = eon_ico_reqseq;
      ) : (
        lane_icon_override[eon_ico_lane] = eon_ico_hov + 1;
      );
      eon_apply_dirty = 1; eon_apply_settle = 0;
      refresh_pianokeys = 1;
    ) :
    // NONE — same verb as Swing's picker cell 46. Paired: the PAD owns the
    // identity, so this travels to the band and Swing's badge clears too.
    // Unpaired: there is no pad to tell, so the lane keeps it locally.
    eon_ico_hov == PADCAT_NONE ? (
      eon_pair_slot >= 0 ? (
        lane_icon_override[eon_ico_lane] = 0;                // paired: pad owns the identity
        gmem[EON_PADCAT_REQ + 1] = eon_pair_slot;
        gmem[EON_PADCAT_REQ + 2] = basenote + eon_ico_lane + notetranspose[eon_ico_lane];
        gmem[EON_PADCAT_REQ + 3] = PADCAT_NONE;              // explicit "no job"
        gmem[EON_PADCAT_REQ + 4] = -1;                       // SRC hint: leave provenance alone
        eon_ico_reqseq += 1; gmem[EON_PADCAT_REQ] = eon_ico_reqseq;
      ) : (
        lane_icon_override[eon_ico_lane] = LANE_ICON_NONE;
      );
      eon_apply_dirty = 1; eon_apply_settle = 0;
      refresh_pianokeys = 1;
    );
  );
  eon_ico_open = 0;
  refresh_tb=1; eon_pdraw=4; mstate=ms_tb_button_noundo;     // pick or click-outside -> close, swallow
);

// EON LANE MENU: geometry + EARLY input (consumed like GROOVE/ICONS). Two columns:
// left = per-lane ops (rows 0..13, eon_lm_rowlbl; dividers after 1/5/10), right =
// MIDI-channel ladder (caption row + 16 channels). Header bar = the lane's name.
// Hover: eon_lm_hcol 0/1 + eon_lm_hrow (-1 = none; right col row 0 = caption, dead).
eon_lm_open ? (
  eon_lm_hh = 22; eon_lm_rh = 19; eon_lm_cw1 = 168; eon_lm_cw2 = 62;
  eon_lm_w = eon_lm_cw1 + eon_lm_cw2;
  eon_lm_h = eon_lm_hh + 17*eon_lm_rh;
  eon_lm_x > gfx_w - eon_lm_w - 2 ? eon_lm_x = max(0, gfx_w - eon_lm_w - 2);
  eon_lm_y + eon_lm_h > gfx_h - 2 ? eon_lm_y = max(0, gfx_h - 2 - eon_lm_h);
  eon_lm_in_panel = mouse_x>=eon_lm_x && mouse_x<eon_lm_x+eon_lm_w && mouse_y>=eon_lm_y && mouse_y<eon_lm_y+eon_lm_h;
  eon_lm_hcol = -1; eon_lm_hrow = -1;
  (eon_lm_in_panel && mouse_y >= eon_lm_y + eon_lm_hh) ? (
    eon_lm_hcol = mouse_x < eon_lm_x + eon_lm_cw1 ? 0 : 1;
    eon_lm_hrow = ((mouse_y - eon_lm_y - eon_lm_hh)/eon_lm_rh)|0;
    (eon_lm_hcol == 0 && eon_lm_hrow > 13) ? eon_lm_hrow = -1;      // left col: 14 rows
    (eon_lm_hcol == 1 && eon_lm_hrow == 0) ? eon_lm_hrow = -1;      // right col: caption row is dead
  );
) : (eon_lm_in_panel = 0; eon_lm_hcol = -1; eon_lm_hrow = -1;);
eon_lm_open && mstate==0 && (mouse_cap==1 || mouse_cap==2) ? (
  eon_lm_in_panel ? (
    (mouse_cap==1 && eon_lm_hrow >= 0) ? (
      eon_lm_hcol == 1 ? (
        rowchannel[eon_lm_lane] = eon_lm_hrow - 1;                   // rows 1..16 -> ch 0..15
        refresh_pianokeys = 1; eon_apply_dirty = 1; eon_apply_settle = 0;
      ) :
      eon_lm_hrow == 0 ? (
        eon_ico_open = 1; eon_ico_lane = eon_lm_lane;                // Set icon...
        eon_ico_x = chw + 2;
        eon_ico_y = (tbh + (numnotes-eon_lm_lane)*row_height)|0;
      ) :
      eon_lm_hrow == 1 ? (
        eon_pair_slot < 0 ? (                                        // paired = pad-bound (drag guard)
          notetranspose[eon_lm_lane] = 0;
          refresh_pianokeys = 1; eon_apply_dirty = 1; eon_apply_settle = 0;
        );
      ) :
      eon_lm_hrow == 2  ? ( eon_lane_clear(eon_lm_lane);         eon_lane_done(); ) :
      eon_lm_hrow == 3  ? ( eon_lane_fill(eon_lm_lane, 2);       eon_lane_done(); ) :
      eon_lm_hrow == 4  ? ( eon_lane_fill(eon_lm_lane, 4);       eon_lane_done(); ) :
      eon_lm_hrow == 5  ? ( eon_lane_fill(eon_lm_lane, 8);       eon_lane_done(); ) :
      eon_lm_hrow == 6  ? ( eon_lane_rotate(eon_lm_lane, -1);    eon_lane_done(); ) :
      eon_lm_hrow == 7  ? ( eon_lane_rotate(eon_lm_lane, 1);     eon_lane_done(); ) :
      eon_lm_hrow == 8  ? ( eon_lane_mirror(eon_lm_lane);        eon_lane_done(); ) :
      eon_lm_hrow == 9  ? ( eon_lane_random(eon_lm_lane, 30);    eon_lane_done(); ) :
      eon_lm_hrow == 10 ? ( eon_lane_random(eon_lm_lane, 50);    eon_lane_done(); ) :
      eon_lm_hrow == 11 ? ( eon_lane_accent(eon_lm_lane, 4, 30); eon_lane_done(); ) :
      eon_lm_hrow == 12 ? ( eon_lane_accent(eon_lm_lane, 2, 30); eon_lane_done(); ) :
      eon_lm_hrow == 13 ? ( eon_lane_humanize(eon_lm_lane, 10);  eon_lane_done(); );
    );
    eon_lm_open = 0;
    refresh_tb=1; eon_pdraw=4; mstate=ms_tb_button_noundo;     // pick or dead spot -> close, swallow
  ) : (
    eon_lm_open = 0;
    // right-click on the lane header while open: DON'T consume -- the opener later
    // this frame re-anchors the menu on the newly clicked lane. Everything else swallows.
    !(mouse_cap==2 && mode==1 && mouse_x < pkw && mouse_y >= tbh && mouse_y < grid_bottom) ? (
      refresh_tb=1; eon_pdraw=4; mstate=ms_tb_button_noundo;
    ) : (refresh_tb=1; eon_pdraw=4;);
  );
);

// EON P3b-4f: house context menu (lane-menu pattern -- replaces every native
// gfx_showmenu in the toolbar). Geometry + hover + click here; drawing in the
// panel layer at the end of @gfx. Kinds:
//   1 = pattern tab (Rename / Change color / Delete -> sync-band region ops)
//   2 = pager pill  (page nav + New pattern)
//   3 = song-strip chip (Repeats 1/2/3/4/6/8, Remove, Clear song, Commit;
//       payload eon_pm_ord = 1-based chain pos, eon_pm_btn = 0-based entry)
//   4 = song-strip background (Clear song / Commit)
//   5 = grid picker (Straight/Triplet/Fine; eon_pm_ord = beat count captured
//       at open -- Elektron model, the bar re-divides)
eon_pm_open ? (
  eon_pm_hh = 22; eon_pm_rh = 19;
  eon_pm_n = eon_pm_kind == 3 ? 9 : eon_pm_kind == 4 ? 2 : eon_pm_kind == 5 ? 4 : 3;
  eon_pm_w = eon_pm_kind == 5 ? 190 : 150;
  eon_pm_h = eon_pm_hh + eon_pm_n*eon_pm_rh;
  eon_pm_x > gfx_w - eon_pm_w - 2 ? eon_pm_x = max(0, gfx_w - eon_pm_w - 2);
  eon_pm_y + eon_pm_h > gfx_h - 2 ? eon_pm_y = max(0, gfx_h - 2 - eon_pm_h);
  eon_pm_in_panel = mouse_x>=eon_pm_x && mouse_x<eon_pm_x+eon_pm_w && mouse_y>=eon_pm_y && mouse_y<eon_pm_y+eon_pm_h;
  eon_pm_hrow = -1;
  (eon_pm_in_panel && mouse_y >= eon_pm_y + eon_pm_hh) ? (
    eon_pm_hrow = ((mouse_y - eon_pm_y - eon_pm_hh)/eon_pm_rh)|0;
    eon_pm_hrow >= eon_pm_n ? eon_pm_hrow = -1;
  );
) : (eon_pm_in_panel = 0; eon_pm_hrow = -1;);
eon_pm_open && mstate==0 && (mouse_cap==1 || mouse_cap==2) ? (
  eon_pm_in_panel ? (
    (mouse_cap==1 && eon_pm_hrow >= 0) ? (
      eon_pm_b = EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE;
      eon_pm_kind == 1 ? (
        // ordinal-payload-FIRST + counter-bump-LAST, same as the old menu.
        // Bumps are gmem READ-modify-write (this JSFX is the field's sole
        // writer): an instance-local counter restarts at 0 on project reload
        // while gmem + the bridge's last-seen persist, so the first request of
        // a fresh instance would rewrite the OLD value and never edge.
        gmem[eon_pm_b + EON_SS_SYNC_OP_ORD] = eon_pm_ord;
        eon_pm_hrow == 0 ? (
          gmem[eon_pm_b + EON_SS_SYNC_REN_REQ] = (gmem[eon_pm_b + EON_SS_SYNC_REN_REQ]|0) + 1;
        ) :
        eon_pm_hrow == 1 ? (
          gmem[eon_pm_b + EON_SS_SYNC_COL_REQ] = (gmem[eon_pm_b + EON_SS_SYNC_COL_REQ]|0) + 1;
        ) : (
          // Delete only when a region actually backs this tab. Tab 1 shows even
          // with ZERO regions (floor tab) -- Rename/Color seed it bridge-side,
          // but Delete has nothing to act on (row draws greyed to match).
          (gmem[eon_pm_b + EON_SS_SYNC_DM_RGNCNT]|0) >= eon_pm_ord ? (
            gmem[eon_pm_b + EON_SS_SYNC_DEL_REQ] = (gmem[eon_pm_b + EON_SS_SYNC_DEL_REQ]|0) + 1;
          );
        );
      ) :
      eon_pm_kind == 2 ? (
        eon_pm_hrow == 0 ? (eon_pat_page = (eon_pat_page + 1) % eon_pat_pages;) :
        eon_pm_hrow == 1 ? (eon_pat_page = (eon_pat_page + eon_pat_pages - 1) % eon_pat_pages;) : (
          gmem[eon_pm_b + EON_SS_SYNC_NEW_REQ] = (gmem[eon_pm_b + EON_SS_SYNC_NEW_REQ]|0) + 1;
        );
      ) :
      eon_pm_kind == 3 ? (
        // rows 0..5 = repeats 1,2,3,4,6,8 -> SET_REPEATS; 6=Remove; 7=Clear; 8=Commit
        eon_pm_hrow <= 5 ? (
          eon_song_cmd(4, eon_pm_ord, eon_pm_hrow == 4 ? 6 : (eon_pm_hrow == 5 ? 8 : eon_pm_hrow + 1));
        ) :
        eon_pm_hrow == 6 ? eon_song_cmd(2, eon_pm_ord, 0) :
        eon_pm_hrow == 7 ? eon_song_cmd(8, 0, 0) :
                           eon_song_cmd(9, 0, 0);
      ) :
      eon_pm_kind == 4 ? (
        eon_pm_hrow == 0 ? eon_song_cmd(8, 0, 0) : eon_song_cmd(9, 0, 0);
      ) : (
        // kind 5: grid re-divide -- the old inline gfx_showmenu apply, verbatim.
        // Beat count was captured at OPEN in eon_pm_ord; same apply idiom as the
        // Len drag (sliderchange + change_seqlen from @gfx).
        eon_pm_spb = eon_pm_hrow == 0 ? 4 : eon_pm_hrow == 1 ? 3 : eon_pm_hrow == 2 ? 8 : 6;
        eon_pm_len = eon_pm_ord * eon_pm_spb;
        eon_pm_len < 2 ? eon_pm_len = 2;
        eon_pm_len > max_seqlength ? eon_pm_len = max_seqlength;
        steps_per_beat = eon_pm_spb;
        sliderchange(slider3 = eon_pm_len);
        change_seqlen(eon_pm_len);             // sets listlength itself; no-op when equal
        sliderchange(slider9 = steps_per_beat);
        steps_per_beat_pat[p] = steps_per_beat;
        rateadj = steps_per_beat * rate;
        p <= chain ? update_chain_beats();
        eon_pm_undo = 1;   // real grid edit -> release must fire the undo point
      );
    );
    eon_pm_open = 0;
    refresh_tb=1; eon_pdraw=4;
    // ms_tb_gridmenu is exempt from nothing: the central release reset fires
    // sliderchange(-1) on it -> undo point AFTER the grid edit (old-flow
    // semantics). Every other pick/dismiss stays noundo.
    mstate = eon_pm_undo ? ms_tb_gridmenu : ms_tb_button_noundo;
    eon_pm_undo = 0;
  ) : (
    eon_pm_open = 0;
    // ALWAYS consume the dismissing click. The lane menu's re-anchor
    // fall-through is safe because its region holds only its own opener; the
    // toolbar is NOT -- a leaked right-click lands on real edits (pattern/note
    // length detents, move buttons, pianokeys latch, preset strip, ADAPT chip,
    // standalone hue-cycle). Re-anchoring costs one extra right-click instead.
    refresh_tb=1; eon_pdraw=4; mstate=ms_tb_button_noundo;
  );
);

// EON: mouse-wheel over toolbar value controls (Swing / Velocity / Note Length / Seq Length / Steps-per-beat)
colorscheme==10 && mouse_wheel != 0 && mouse_y >= 0 && mouse_y < tbh ? (
  eon_wd = mouse_wheel>0 ? 1 : -1;
  eon_ws = (mouse_cap&8) ? 1 : 5;   // Shift = fine
  (slider17 >= 3.5 && mouse_y < eon_pbh) ? (   // Manual map: scroll a pad to retune its note
    eon_mi = ((mouse_y/tbrh)|0)*4 + (((mouse_x-2)/max(1,(gfx_w-4)/4))|0);
    // E-2.1: in PAIRED drum mode the lane's note is owned by its pad (the
    // binding maintains notetranspose every @block), so manual retune here is
    // inert -- pad notes are changed from Swing/browser. Unpaired = unchanged.
    (eon_pair_slot < 0 && eon_mi >= 0 && eon_mi < min(16,numnotes)) ? (
      notetranspose[eon_mi] = max(0-basenote-eon_mi, min(127-basenote-eon_mi, notetranspose[eon_mi] + eon_wd));
      refresh_tb=1;
    );
  ) :
  (mouse_y>=eon_pbh && mouse_y<eon_pbh+tbrh && mouse_x>=eon_vwx && mouse_x<eon_vwx+busp*3) ? (   // View button: scroll = cycle views
    slider17 = (slider17 + eon_wd + 5) % 5; sliderchange(slider17); recalc_elh=1; refresh_tb=1;
  ) :
  (mouse_y>=eon_pbh && mouse_y<eon_pbh+tbrh && mouse_x>=eon_swpx && mouse_x<eon_swpx+eon_swpw) ? (
    swing_p = max(0,min(100, swing_p + eon_wd*eon_ws)); swing=((tpb/2)*(swing_p/100))|0;
    memset(lane_swing, swing_p, max_numnotes); groove_dirty = 1;   // EON GROOVE: master wheel now propagates like the drag (was inert per-lane before)
    sliderchange(slider8=swing_p); refresh_tb=1;
  ) : (mouse_y>=eon_r2 && mouse_y<eon_r2b) ? (
    mouse_x>=busp*2  && mouse_x<busp*4  ? (lastvelo = max(1,min(127, lastvelo + eon_wd*eon_ws)); refresh_tb=1;) :
    mouse_x>=busp*4  && mouse_x<busp*8  ? (notelen_p = max(1,min(100, notelen_p + eon_wd*eon_ws)); defnotelen=(tpb*(notelen_p/100))|0; sliderchange(slider6=notelen_p); refresh_tb=1;) :
    mouse_x>=busp*8  && mouse_x<busp*12 ? (change_seqlen(max(1,min(max_seqlength, listlength + eon_wd))); sliderchange(slider3=listlength); refresh_tb=1;) :
    mouse_x>=busp*12 && mouse_x<busp*16 ? (steps_per_beat = max(1,min(max_steps_per_beat, steps_per_beat + eon_wd)); steps_per_beat_pat[p]=steps_per_beat; rateadj=steps_per_beat*rate; sliderchange(slider9=steps_per_beat); refresh_tb=1;) :
    mouse_x>=eon_psx && mouse_x<eon_psx+eon_psw ? (   // AP-2 Preset strip: wheel -> nav request to bridge
      eon_pnav_seq += 1; _psl = eon_pair_slot>=0 ? eon_pair_slot : 0;
      gmem[EON_SS_PCTRL_BASE + _psl*EON_SS_PCTRL_STRIDE]     = eon_pnav_seq;
      gmem[EON_SS_PCTRL_BASE + _psl*EON_SS_PCTRL_STRIDE + 1] = eon_wd;
      refresh_tb=1;
    );
  );
  mouse_wheel = 0;
);

// EON: piano show/hide toggle click (pattern row, busp*16-19; outside the pattern handler's range)
colorscheme==10 && mstate==0 && (mouse_cap==1 || mouse_cap==2) && mouse_y>=eon_pbh && mouse_y<eon_pbh+tbrh && mouse_x>=eon_vwx && mouse_x<eon_vwx+busp*3 ? (
  mouse_cap==2 ? (   // right-click -> toggle the Swing-style dropdown
    eon_vdd_open = 1 - eon_vdd_open;
  ) : (              // left-click -> next view + close dropdown
    slider17 = (slider17 + 1) % 5; sliderchange(slider17); recalc_elh=1; eon_vdd_open=0;
  );
  refresh_tb=1; mstate=ms_tb_button_noundo;
);

// EON: CC/velocity lane min/max toggle click (pattern row, busp*20-23)
colorscheme==10 && mstate==0 && mouse_cap==1 && mouse_y>=eon_pbh && mouse_y<eon_pbh+tbrh && mouse_x>=eon_ccx && mouse_x<eon_ccx+eon_ccwd+3 ? (
  elh_percent > 0.02 ? ( eon_cc_lasth = elh_percent; elh_percent = 0; ) : ( elh_percent = (eon_cc_lasth > 0.02 ? eon_cc_lasth : 0.18); );
  sliderchange(slider13=elh_percent); recalc_elh=1; mstate=ms_tb_button_noundo;
);

// EON: THEME selector click/cycle/dropdown is handled by rkth_input (shared
// rk_theme_picker.jsfx-inc) in the early THEME-picker block above.

// EON: PAIR selector click (pattern row, busp*27-30). Either button toggles the custom
// pairing dropdown (drawn + handled by the eon_prdd blocks, mirroring the THEME dropdown).
colorscheme==10 && mstate==0 && (mouse_cap==1 || mouse_cap==2) && mouse_y>=eon_pbh && mouse_y<eon_pbh+tbrh && mouse_x>=busp*22-2 && mouse_x<busp*25-2 ? (
  eon_prdd_open = 1 - eon_prdd_open;
  refresh_tb=1; mstate=ms_tb_button_noundo;
);

// EON: SYNC toggle button (top-right) -> toggle Sync (DM) mode (slider49). Front-and-centre
// replacement for the buried SETTINGS row.
colorscheme==10 && mstate==0 && mouse_cap==1 && mouse_y>=eon_pbh && mouse_y<eon_pbh+tbrh && mouse_x>=eon_syncb_x && mouse_x<eon_syncb_x+eon_cmdb_w ? (
  eon_sync_mode = eon_sync_mode ? 0 : 1;
  sliderchange(slider49=eon_sync_mode);
  refresh_tb=1; mstate=ms_tb_button_noundo;
);
// EON: SWING toggle button (top-right) -> toggle the paired Swing FX window (paired only).
colorscheme==10 && mstate==0 && mouse_cap==1 && mouse_y>=eon_pbh && mouse_y<eon_pbh+tbrh && mouse_x>=eon_swb_x && mouse_x<eon_swb_x+eon_cmdb_w && eon_pair_slot>=0 ? (
  eon_opensw_seq += 1;
  gmem[EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE + EON_SS_SYNC_OPENSW_REQ] = eon_opensw_seq;
  mstate=ms_tb_button_noundo;
);
// EON: MATRIX toggle button (top-right) -> toggle the Drum Matrix overlay (global).
colorscheme==10 && mstate==0 && mouse_cap==1 && mouse_y>=eon_pbh && mouse_y<eon_pbh+tbrh && mouse_x>=eon_mxb_x && mouse_x<eon_mxb_x+eon_cmdb_w ? (
  eon_dmopen_seq += 1;
  gmem[EON_SS_DM_OPEN_REQ] = eon_dmopen_seq;
  mstate=ms_tb_button_noundo;
);
// EON: settings cog, now in the pattern-row corner -> toggle the SETTINGS popup.
colorscheme==10 && mstate==0 && mouse_cap==1 && mouse_y>=eon_pbh && mouse_y<eon_pbh+tbrh && mouse_x>=eon_cogb_x && mouse_x<eon_cogb_x+34 ? (
  settingsopen = settingsopen ? 0 : 1;
  refresh_tb=1; mstate=ms_tb_button_noundo;
);

// EON AP-2/AP-4: Preset strip click (control row, eon_psx..+eon_psw). THREE zones:
// outer 30% each = prev / next preset (the </> arrows); CENTER 40% (the name) =
// TOGGLE the preset browser (same mailbox as the right-click below; the bridge
// launches it, or bumps its CLOSE cell when one is already alive).
colorscheme==10 && mstate==0 && mouse_cap==1 && mouse_y>=eon_r2 && mouse_y<eon_r2b && mouse_x>=eon_psx && mouse_x<eon_psx+eon_psw ? (
  (mouse_x >= eon_psx + eon_psw*0.30 && mouse_x < eon_psx + eon_psw*0.70) ? (
    gmem[EON_SS_BROWSER_SLOT]     = eon_pair_slot>=0 ? eon_pair_slot : 0;
    gmem[EON_SS_BROWSER_OPEN_REQ] = (gmem[EON_SS_BROWSER_OPEN_REQ]|0) + 1;
  ) : (
    eon_pnav_seq += 1; _psl2 = eon_pair_slot>=0 ? eon_pair_slot : 0;
    gmem[EON_SS_PCTRL_BASE + _psl2*EON_SS_PCTRL_STRIDE]     = eon_pnav_seq;
    gmem[EON_SS_PCTRL_BASE + _psl2*EON_SS_PCTRL_STRIDE + 1] = mouse_x < eon_psx+(eon_psw/2) ? -1 : 1;
  );
  refresh_tb=1; mstate=ms_tb_button_noundo;
);

// EON AP-4: right-click the Preset strip -> same browser TOGGLE as the center-click
// (JSFX can't launch a ReaScript itself; the bridge registers + runs it). SLOT tells
// the panel which instance to target.
colorscheme==10 && mstate==0 && mouse_cap==2 && mouse_y>=eon_r2 && mouse_y<eon_r2b && mouse_x>=eon_psx && mouse_x<eon_psx+eon_psw ? (
  gmem[EON_SS_BROWSER_SLOT]     = eon_pair_slot>=0 ? eon_pair_slot : 0;
  gmem[EON_SS_BROWSER_OPEN_REQ] = (gmem[EON_SS_BROWSER_OPEN_REQ]|0) + 1;
  mstate=ms_tb_button_noundo;
);

// EON: Pads view -- drag to shift the range, like the piano keyboard.
//   top row (pattern triggers) drag -> trig_note_start ;  kit grid drag -> basenote.  ~1 note / 24px.
colorscheme==10 && slider17 >= 1.5 && slider17 < 3.5 && mouse_x > 0 && mouse_y > 0 && mouse_y < eon_pbh && mouse_cap==1 && (mstate==0 || mstate==ms_pads_kit || mstate==ms_pads_pat) ? (
  mstate==0 ? (   // press: record start value + anchor x
    eon_pdrag_x = mouse_x;
    mouse_y < tbrh ? (mstate=ms_pads_pat; eon_pdrag_v=trig_note_start;) : (mstate=ms_pads_kit; eon_pdrag_v=basenote;);
  ) : (           // drag: shift the range
    eon_pdn = ((mouse_x - eon_pdrag_x)/24)|0;
    mstate==ms_pads_pat ? (
      trig_note_start = max(0, min(119, eon_pdrag_v + eon_pdn)); sliderchange(slider11=trig_note_start);
    ) : (
      basenote = max(0, min(127 - numnotes, eon_pdrag_v + eon_pdn)); sliderchange(slider2=basenote);
    );
    refresh_tb=1;
  );
);

// EON: right-click the lane ICON column (drum-glyph strip, x in [2,chw)) -> open the
// EON: the right-click-the-drum-glyph shortcut to the bridge pairing picker was REMOVED
// (it popped over the lanes unexpectedly). Pairing is done via the PAIR button dropdown.

((mouse_y >= tbh && mouse_y < grid_bottom) || mstate&ms_grid || mstate&ms_pk) && !(mstate&ms_tb) && !(mstate&ms_el) && !eon_so_in_panel && !eon_vdd_in_panel && !eon_thdd_in_panel && !eon_prdd_in_panel ? ( // Mouse below toolbar and above env lane or clicking/dragging in progress

  // Highlight current piano key
  (y != lhl && mouse_x >= 0 && mouse_x < gfx_w && mouse_y >= tbh && mouse_y < grid_bottom) && (mstate == 0 || ms_sub_drawfreehand || mstate == ms_preview) ? (
  
  // Remove previous highlight
    ypos = (numnotes-1-lhl)*row_height;
    octavestart = (basenote+lhl) % 12;
    mode == 0 ? (   // piano mode: redraw the white/black key
      (octavestart == 0 || octavestart == 2 || octavestart == 4 || octavestart == 5 || octavestart == 7 || octavestart == 9 || octavestart == 11) ? (
        color(4); // white key
        gfx_x=2.0; gfx_y=tbh+ypos+1;
        gfx_rectto(pkw-3, gfx_y+row_height-2);
      ) : (
        color(7); // black key
        gfx_x=0.0; gfx_y=tbh+ypos+1;
        gfx_rectto(pkw-3, gfx_y+row_height-2);
      );
      octavestart == 0 ? (
        color(16);
        gfx_x=chw+4.0; gfx_y=tbh+ypos+row_height/2-3;
        gfx_drawchar($'C');
        gfx_drawnumber(((basenote+lhl) / 12)-1+octave_offset,0);
      );
    ) : (   // drum mode: just redraw the lane tile cleanly (no color(7) fill -> no black left border)
      draw_drum_note(lhl);
    );
    
    lhl = y;

    // Draw new highlight
    ypos = (numnotes-1-y)*row_height;
    colorscheme==10 ? (   // EON: subtle brighten so the lane colour + name stay visible on hover
      gfx_set(1,1,1,0.18); gfx_x=2; gfx_y=tbh+ypos+1; gfx_rectto(pkw-3, gfx_y+row_height-2);
    ) : (
      color(2);
      gfx_x=2.0; gfx_y=tbh+ypos+1;
      gfx_rectto(pkw-3, gfx_y+row_height-2);
    );
  notehl = 1;
  );

  // EON: lane-header RIGHT-CLICK -> open the custom lane-menu panel (house style,
  // groove-panel pattern -- replaces the native gfx_showmenu). Selection + geometry
  // live in the eon_lm EARLY block; drawing in the panel layer at the end of @gfx.
  // A right-click on another lane while open re-anchors (early block falls through).
  // eon_kn_hov < 0 keeps the lane menu off the VOL/PAN knobs. Without it a
  // right-click anywhere in the header -- knobs included -- popped the lane menu,
  // which reads as sloppy on a control that owns its own click. The test is the
  // knob's exact circle, so every other pixel of the header behaves as before.
  (mouse_cap==2 && mstate==0 && mode==1 && !eon_gdd_open && !eon_ico_open
   && eon_kn_hov < 0
   && mouse_x < pkw && mouse_y >= tbh && mouse_y < grid_bottom) ? (
    eon_lrc_lane = numnotes-1-((((mouse_y-tbh)/(grid_bottom-tbh))*numnotes)|0);
    (eon_lrc_lane >= 0 && eon_lrc_lane < numnotes) ? (
      eon_lm_open = 1;
      eon_lm_lane = eon_lrc_lane;
      eon_lm_x = mouse_x; eon_lm_y = mouse_y;
    );
    mstate = ms_tb_button_noundo;   // consume the click (pattern-menu precedent)
  );

  // Right click: audition EXISTING notes -- GRID ONLY (mouse_x >= pkw). Lane-header
  // right-click opens the lane menu above; left-click auditions the lane.
  (mouse_cap==2 && mouse_x >= pkw) ? (
    x = (((mouse_x - pkw)/(gfx_w - pkw))*listlength)|0;
    y >= 0 && y < numnotes ? (
      mstate==0 || mstate==ms_preview ? ( // Click / Button down or dragging
        mstate==0 ? (
          last_x=last_y=last_sd_x=-1;
        );
        mstate=ms_preview;
     
        x >= 0 && x < listlength ? (
          sd_edit_num = getSubdivNum(y*listlength+x);
          sd_edit_num ? ( // subdiv note
            sd_edit_nl = getSubdivNotelist(y, x);
            sd_x = ((sd_edit_num+1)*((mouse_x - pkw) - x*note_w)/note_w)|0;
            sd_edit_nl&(2^sd_x) && (last_x != x || last_sd_x != sd_x || last_y != y ) ? (
              new_note_at_mousepos=1;
            ) : (
              new_note_at_mousepos=0;
            );
          ) : (notelist[x] & 2^y) && (last_x != x || last_y != y) ? ( // not subdiv
            new_note_at_mousepos=1;
          ) : (
            new_note_at_mousepos=0;
          );
        );

        x >= 0 && x < listlength && new_note_at_mousepos ? 
        (
          previewvelo=lastvelo;
          sd_edit_num ? ( // subdiv note
              previewvelo = getSubdivVelo(y, x, sd_x);
              lastvelo=previewvelo;
          ) : ( // not subdiv
            previewvelo=getVelo(y*listlength+x);
            lastvelo=previewvelo;
          );
          lastpreviewsel>=0 ? want_previewoff=1;
          want_preview=lastpreviewsel=y; 
        ) : y != lastpreviewsel ? (
          previewvelo=lastvelo;
          lastpreviewsel>=0 ? want_previewoff=1;
          want_preview=lastpreviewsel=y; 
        );
        last_x = x;
        last_y = y;
        last_sd_x = sd_x;
      );
    );
  ):(
    // EON: leave the preview alive while a LEFT-click lane scrub owns it (the scrub
    // sends its own offs on lane change; release lands here and sends the final off).
    !(mstate==ms_preview && (mouse_cap&1)) ? (
      want_previewoff=1;
      lastpreviewsel=-1;
    );
  );

  (mouse_x > pkw || mstate == ms_startoffsetedit || mstate == ms_startoffseteditrow) && mstate != ms_rowtranpose ? (
    // Left click or Shift + Ctrl + Alt + Left click
    (mouse_cap==1) || (mouse_cap==(1|4|8|16)) ? ( 
        x_acc=((mouse_x - pkw)/(gfx_w - pkw))*listlength;
        x = x_acc|0;
        x >= 0 && x < listlength && y >= 0 && y < numnotes ? (
          mstate==0 ? (
            ylock = y;
            mask = 2^y;
            sd_edit_num = getSubdivNum(ylock*listlength+x);
            
            sd_edit_num ? ( // subdiv note
              sd_edit_nl = getSubdivNotelist(ylock, x);
              sd_x = ((sd_edit_num+1)*((mouse_x - pkw) - x*note_w)/note_w)|0;
              mstate=sd_edit_nl&(2^sd_x) ? ms_noteerase : ms_notedraw;
              mstate==ms_notedraw ? ( // Draw note
                setSubdivNotelist(ylock, x, sd_edit_nl+2^sd_x);
                setSubdivVelo(ylock, x, sd_x, lastvelo);
              ); 
              mstate==ms_noteerase ? ( // Erase note
                setSubdivNotelist(ylock, x, sd_edit_nl-2^sd_x);
              );
            ) : ( // not subdiv
              nlm=(notelist[x] & mask);
              mstate=nlm ? ms_noteerase : ms_notedraw;
              mstate==ms_noteerase ? ( // Erase note
                notelist[x]-=mask; 
                (notetie[x] & mask) ? notetie[x]-=mask; // Erase tie
                x > 0 && (notetie[x-1] & mask) ? notetie[x-1]-=mask; // Erase tie from previous 
                setStart(y*listlength+x, 0); //Reset start offset of the erased note to 0 
              );
              mstate==ms_notedraw ? ( // Draw note
                notelist[x]+=mask; 
                setVelo(y*listlength+x, lastvelo);
              ); 
            );
            ((mouse_cap!=1)||(mode==0)) ? ms_sub_drawfreehand=1;
          ) : (         
            lcnt = max(abs(last_x-x),abs(last_y-y))|0;
            lcnt > 0 ? (
              dx = (x_acc-last_x_acc)/lcnt;
              dy = (y_acc-last_y_acc)/lcnt;
              //y_step = (abs(dy) > abs(dx));
            );
            lcnt >= 1 ? (
              loop(lcnt,
                last_x_prev=last_x_acc|0; 
                last_x_acc += dx;
                last_x_int=last_x_acc|0;
                ms_sub_drawfreehand ? (
                  last_y_acc += dy;
                  last_y_int = last_y_acc|0;
                ) : (
                  last_y_int = ylock ;
                );
				
                last_x_int != last_x_prev ? ( // Fast drawing over to note on left or right -> need draw subdivs in prev note
                  sd_edit_num_prev = getSubdivNum(last_y_int*listlength+last_x_prev);
                  
                  sd_edit_num_prev ? ( // previous was subdiv note
                    last_sd_x=sd_x;
                    dx < 0 && last_sd_x > 0 ? (
                      lcnt_sd = last_sd_x;
                      dx_sd = -1;
                    ) : dx > 0 && last_sd_x < sd_edit_num_prev ? (
                      lcnt_sd = sd_edit_num_prev-last_sd_x;
                      dx_sd = 1;
                    );
                    
                    lcnt_sd >= 1 ? (
                      loop(lcnt_sd,
                        last_sd_x += dx_sd;
                        sd_edit_nl = getSubdivNotelist(last_y_int, last_x_prev);
                        mstate==ms_noteerase ? (
                          (sd_edit_nl&(2^last_sd_x)) ? (
                            setSubdivNotelist(last_y_int, last_x_prev, sd_edit_nl-2^last_sd_x);
                          );
                        );
                        mstate==ms_notedraw ? ( // Draw note
                          !(sd_edit_nl&(2^last_sd_x)) ? (
                            setSubdivNotelist(last_y_int, last_x_prev, sd_edit_nl+2^last_sd_x);
                            setSubdivVelo(last_y_int, last_x_prev, last_sd_x, lastvelo);
                          );
                        );
                      );
                    );
                  );
                );
                
                sd_edit_num = getSubdivNum(last_y_int*listlength+last_x_int);
                
                sd_edit_num ? ( // subdiv note
                  last_x_int != last_x_prev ? (
                    dx < 0 ? sd_x=sd_edit_num+1 : sd_x=-1;
                  );
                                   
                ) : ( // not subdiv
                  mask = 2^last_y_int;
                  nlm=(notelist[last_x_int] & mask);
                  mstate==ms_noteerase && nlm ? (
                    notelist[last_x_int]-=mask; // Erase note
                    (notetie[last_x_int] & mask) ? notetie[last_x_int]-=mask; // Erase tie
                    last_x_int > 0 && (notetie[last_x_int-1] & mask) ? notetie[last_x_int-1]-=mask; // Erase tie from previous
                    setStart(last_y_int*listlength+(last_x_int), 0); //Reset start offset of the erased note to 0 
                  );
                  mstate==ms_notedraw && !nlm ? ( // Draw note
                    notelist[last_x_int]+=mask; 
                    setVelo(last_y_int*listlength+(last_x_int), lastvelo);
                  );
                );
              );
            ) : ( // lcnt == 0. Within same note  
              sd_edit_num = getSubdivNum(ylock*listlength+x);
              sd_edit_num ? ( // subdiv note
                sd_x = ((sd_edit_num+1)*((mouse_x - pkw) - x*note_w)/note_w)|0;
                lcnt_sd = abs(last_sd_x-sd_x)|0;
                lcnt_sd > 0 ? (
                  dx_sd = (sd_x-last_sd_x)/lcnt_sd;
                  //dy = (y-last_y)/lcnt_sd;
                );
                lcnt_sd >= 1 ? (
                  loop(lcnt_sd,
                    last_sd_x += dx_sd;
                    //last_y += dy;
                    ms_sub_drawfreehand==0 ? last_y_int=ylock;
                    last_x_int=(last_x|0);
                    sd_edit_nl = getSubdivNotelist(last_y_int, last_x_int);
                    mstate==ms_noteerase ? (
                      (sd_edit_nl&(2^last_sd_x)) ? (
                        setSubdivNotelist(last_y_int, last_x_int, sd_edit_nl-2^last_sd_x);
                      );
                    );
                    mstate==ms_notedraw ? ( // Draw note
                      !(sd_edit_nl&(2^last_sd_x)) ? (
                        setSubdivNotelist(last_y_int, last_x_int, sd_edit_nl+2^last_sd_x);
                        setSubdivVelo(last_y_int, last_x_int, last_sd_x, lastvelo);
                      );
                    );
                  );
                );
              );
            );
          );
          last_x = x;
          last_x_acc = x_acc;
          last_y = y; 
          last_y_acc = y_acc;
          last_sd_x = sd_x;
        );
    ) : ms_sub_drawfreehand=0;

    // Ctrl + Left click
    (mouse_cap==(1|4)) ? ( 
        x = (((mouse_x - pkw)/(gfx_w - pkw))*listlength)|0;
        x >= 0 && x < listlength ? (
          velo = (((grid_bottom - mouse_y)-y*row_height) / row_height)*127|0;
          mstate==0 ? ( // clicking
            sd_editval_show=0;
            ylock = y;
            mask = 2^y;
            sd_edit_num = getSubdivNum(ylock*listlength+x);
            sd_edit_num ? ( // subdiv note
              sd_edit_nl = getSubdivNotelist(ylock, x);
              sd_x = ((sd_edit_num+1)*((mouse_x - pkw) - x*note_w)/note_w)|0;
              mstate=sd_edit_nl&(2^sd_x) ? ms_veloedit;
              mstate==ms_veloedit ? ( 
                setSubdivVelo(ylock, x, sd_x, velo); // Edit velocity
                lastvelo=velo;
                sd_editval_show=1;
              ); 
            ) : ( // not subdiv
              nlm=(notelist[x] & mask);
              mstate = nlm ? ms_veloedit;
              nlm ? (
                setVelo(y*listlength+x, velo); // Edit velocity
                lastvelo=velo;
              );
            );
            lastnote_changed_x=x;
            
          ) : ( // dragging
            sd_editval_show=0;
            y < ylock ? velo = 1;
            y > ylock ? velo = 127;
            lcnt = max(abs(last_x-x),abs(last_y-y))|0;
            lcnt > 0 ? (
              dx = (x-last_x)/lcnt;
              dy = (y-last_y)/lcnt;
              dmoy = (mouse_y - last_mo_y)/lcnt;
            );
            lcnt >= 1 ? (
              loop(lcnt,
                last_x_prev=last_x|0; 
                last_x += dx;
                last_y += dy;
                last_mo_y += dmoy;
                last_x_int=(last_x|0);
                
                last_x_int != last_x_prev ? (
                  sd_edit_num_prev = getSubdivNum(ylock*listlength+last_x_prev);
                  
                  sd_edit_num_prev ? ( // previous was subdiv note
                    last_sd_x=sd_x;
                    dx < 0 && last_sd_x > 0 ? (
                      lcnt_sd = last_sd_x;
                      dx_sd = -1;
                    ) : dx > 0 && last_sd_x < sd_edit_num_prev ? (
                      lcnt_sd = sd_edit_num_prev-last_sd_x;
                      dx_sd = 1;
                    );
                    
                    lcnt_sd >= 1 ? (
                      loop(lcnt_sd,
                        last_sd_x += dx_sd;
                        sd_edit_nl = getSubdivNotelist(ylock, last_x_prev);
                        (sd_edit_nl&(2^last_sd_x)) ? (
                          last_y > ylock ? ( 
                            velo = 127;  
                          ) : last_y < ylock ? (
                            velo = 1;
                          ) : (
                            velo = (((grid_bottom - last_mo_y)-last_y*row_height) / row_height)*127|0;
                          );
                          setSubdivVelo(ylock, last_x_prev, last_sd_x, velo);
                        );
                      );
                    );
                  );
                );
                
                sd_edit_num = getSubdivNum(ylock*listlength+last_x_int);
                sd_edit_num ? ( // subdiv note
                  last_x_int != last_x_prev ? (
                    dx < 0 ? sd_x=sd_edit_num+1 : sd_x=-1;
                  );
                                   
                ) : ( // not subdiv
                  mask = 2^(ylock|0);
                  nlm=(notelist[last_x|0] & mask);
                  last_y > ylock ? ( 
                    velo = 127;  
                  ) : last_y < ylock ? (
                    velo = 1;
                  ) : (
                    velo = (((grid_bottom - last_mo_y)-last_y*row_height) / row_height)*127|0;
                  );
                  nlm ? (lastnote_changed_x=last_x|0; setVelo(ylock*listlength+lastnote_changed_x, velo); lastvelo=velo;);  
                );
              );

            ) : ( // lcnt == 0. Within same note  
              sd_edit_num = getSubdivNum(ylock*listlength+x);
              sd_edit_num ? ( // subdiv note
                sd_x = ((sd_edit_num+1)*((mouse_x - pkw) - x*note_w)/note_w)|0;
                lcnt_sd = abs(last_sd_x-sd_x)|0;
                lcnt_sd > 0 ? (
                  dx_sd = (sd_x-last_sd_x)/lcnt_sd;
                  dmoy = (mouse_y - last_mo_y)/lcnt_sd;
                );
                lcnt_sd >= 1 ? (
                  loop(lcnt_sd,
                    last_sd_x += dx_sd;
                    last_mo_y += dmoy;
                    last_x_int=(last_x|0);
                    sd_edit_nl = getSubdivNotelist(ylock, last_x_int);
                    (sd_edit_nl&(2^last_sd_x)) ? (
                      last_y > ylock ? ( 
                        velo = 127;  
                      ) : last_y < ylock ? (
                        velo = 1;
                      ) : (
                        velo = (((grid_bottom - last_mo_y)-last_y*row_height) / row_height)*127|0;
                      );
                      setSubdivVelo(ylock, last_x_int, last_sd_x, velo);
                      lastnote_changed_x=last_x_int;
                      lastvelo=velo;
                      sd_editval_show=1;
                    );
                    
                  );
                ) : ( // lcnt_sd == 0. Adjusting single subdiv note velocity
                  sd_edit_nl = getSubdivNotelist(ylock, last_x);
                  (sd_edit_nl&(2^sd_x)) ? (
                    last_y > ylock ? ( 
                      velo = 127;  
                    ) : last_y < ylock ? (
                      velo = 1;
                    );
                    setSubdivVelo(ylock, last_x, sd_x, velo);
                    lastnote_changed_x=last_x;
                    lastvelo=velo;
                    sd_editval_show=1;
                  );
                );
              ) : ( // not subdiv
                last_y > ylock ? ( 
                  velo = 127;  
                ) : last_y < ylock ? (
                  velo = 1;
                );
                nlm ? (lastnote_changed_x=x; setVelo(ylock*listlength+lastnote_changed_x, velo); lastvelo=velo;);
              );
            );
          );
          last_x = x;
          last_y = y; 
          last_sd_x = sd_x;
          last_mo_y = mouse_y;
        );
    );

    // Ctrl + Alt + Left click

    (mouse_cap==(1|4|16)) ? ( 
        x = (((mouse_x - pkw)/(gfx_w - pkw))*listlength)|0;
        x >= 0 && x < listlength ? (
          velo = (((grid_bottom - mouse_y)-y*row_height) / row_height)*127|0;
          mstate==0 ? ( // clicking
            ylock = y;
            mask = 2^y;
            sd_edit_num = getSubdivNum(ylock*listlength+x);
            sd_edit_num ? ( // subdiv note
              sd_edit_nl = getSubdivNotelist(ylock, x);
              sd_x = ((sd_edit_num+1)*((mouse_x - pkw) - x*note_w)/note_w)|0;
              sd_edit_nl&(2^sd_x) ? (
                mstate=ms_veloeditrow;
                veloadj = velo - getSubdivVelo(y, x, sd_x);
              );
            ) : ( // not subdiv
              nlm=(notelist[x] & mask);
              nlm ? (
                mstate = ms_veloeditrow;
                veloadj = velo - getVelo(y*listlength+x);
              );
            );
            ms_veloeditrow ? (
              veloadjust_row(y, x, sd_x, veloadj);
              lastvelo=velo;
            );
              
          ) : ( // dragging
            y < ylock ? velo = 1;
            y > ylock ? velo = 127;
            veloadj_ena = 0;
            sd_edit_num = getSubdivNum(ylock*listlength+x);
            sd_edit_num ? ( // subdiv note
              sd_edit_nl = getSubdivNotelist(ylock, x);
              sd_x = ((sd_edit_num+1)*((mouse_x - pkw) - x*note_w)/note_w)|0;
              sd_edit_nl&(2^sd_x) ? (
                veloadj = velo - getSubdivVelo(ylock, x, sd_x);
                veloadj_ena = 1;
              );
            ) : ( // not subdiv
              nlm=(notelist[x] & 2^ylock);
              nlm ? (
                veloadj = velo - getVelo(ylock*listlength+x);
                veloadj_ena = 1;
              );
            );
            veloadj_ena ? (
              veloadjust_row(ylock, x, sd_x, veloadj);
              lastvelo=velo;
            );
          ); 
        );
    );
    
    // Shift + Left click
    mouse_cap==(1|8) ? ( 
      x = (((mouse_x - pkw)/(gfx_w - pkw))*listlength)|0;
      mstate==0 ? (
        x >= 0 && x < listlength ? (
          sd_edit_num = getSubdivNum(y*listlength+x);
          !sd_edit_num ? ( // not subdiv note
            ylock = y;
            xlock = x;
            mask = 2^y;
            nlm=(notelist[x] & mask);
            mstate = nlm ? ms_startoffsetedit;
            morig = mouse_x;
            start_adj_orig = getStart(ylock*listlength+x);
            lastnote_changed_x=x;
          );
        );
      ) : (
        draglen=((mouse_x - morig))|0;
        ldraglen != draglen ? (
          ldraglen = draglen;
          nlm ? (
            new_start = start_adj_orig+draglen;
            new_start < 0 ? new_start = 0;
            new_start > tpb ? new_start = tpb;
            setStart(ylock*listlength+xlock, new_start);
          );
        );
      );
    );

    // Shift + Alt + Left click
    mouse_cap==(1|8|16) ? ( 
      x = (((mouse_x - pkw)/(gfx_w - pkw))*listlength)|0;
      mstate==0 ? (
        x >= 0 && x < listlength ? (
          sd_edit_num = getSubdivNum(y*listlength+x);
          !sd_edit_num ? ( // not subdiv note
            ylock = y;
            xlock = x;
            mask = 2^y;
            nlm=(notelist[x] & mask);
            mstate = nlm ? ms_startoffseteditrow;
            morig = mouse_x;
            i=0;
            loop(listlength,
              start_adj_orig_list[i] = getStart(ylock*listlength+i);
              i == x ? start_adj_all_value = start_adj_orig_list[i];
              i+=1;
            );
            lastnote_changed_x=x;
          );
        );
      ) : (
        draglen=((mouse_x - morig))|0;
        ldraglen != draglen ? (
          ldraglen = draglen;
          mask = 2^ylock;
          nlm ? (
            i=0;
            loop(listlength,
              (notelist[i] & mask) && !getSubdivNum(ylock*listlength+i) ? (
                new_start = start_adj_orig_list[i]+draglen;
                new_start < 0 ? new_start = 0;
                new_start > tpb ? new_start = tpb;
                setStart(ylock*listlength+i, new_start);
                i == xlock ? start_adj_all_value = new_start;
              );
              i+=1;
            );
          );
        );
      );
    );
    
    // Alt + Left click
    (mouse_cap==1|16) ? ( 
        x = (((mouse_x - pkw)/(gfx_w - pkw))*listlength)|0;
        x >= 0 && x < listlength && y >= 0 && y < numnotes ? (
          mstate==0 ? ( // Click mouse button down
            sd_edit_num = getSubdivNum(y*listlength+x);
            !sd_edit_num ? ( // not subdiv note
              tie_erase=0;
              ylock = y;
              mask = 2^y;
              nlm=(notelist[x] & mask); // nlm != 0 if note exists in clicked location
              mstate = nlm ? ms_notetie;
              nlm ? (
                (notetie[x] & mask) ? (
                  notetie[x]-=mask; // Erase note tie
                  tie_erase=1;
                ) : (
                  x < listlength-1 && !getSubdivNum(y*listlength+x+1) ? ( // Don't add tie to the last note of sequence or before subdiv
                    notetie[x]+=mask; // Add note tie
                    !(notelist[x+1] & mask) ? ( // No note in next square
                      notelist[x+1]+=mask; // Add note to next square
                      setVelo(y*listlength+x+1, getVelo(y*listlength+x)); // using same velocity
                    ); 
                  );
                );
              );
            );
          ) : ( // Keeping mouse button down / dragging
            lcnt = abs(last_x-x)|0;
            lcnt > 0 ? (
              dx = (x-last_x)/lcnt;
            );
            lcnt >= 1 ? loop(lcnt,
              last_x += dx;
              mask = 2^(ylock|0);
              last_x_int=(last_x|0);
              nlm=(notelist[last_x_int] & mask);
              nlm && !getSubdivNum(ylock*listlength+last_x_int) ? ( //Drag started on top of note and is currently on top of note and not on top of subdiv
                !(notetie[last_x_int] & mask) ? ( // No note tie in current note
                  !tie_erase ? ( // Drag was started by adding tie, so we continue adding ties
                    last_x_int < listlength-1 && !getSubdivNum(ylock*listlength+last_x_int+1) ? ( // Don't add tie to the last note of sequence or before subdiv
                      notetie[last_x_int]+=mask; // Add note tie
                      !(notelist[last_x_int+1] & mask) ? ( // No note in next square
                        notelist[last_x_int+1]+=mask; // Add note to next square
                        setVelo(ylock*listlength+last_x_int+1, getVelo(ylock*listlength+last_x_int)); // using same velocity
                      );
                    );
                  );
                ) : ( // Note tie already exists in current note
                  tie_erase ? ( // Drag was started by erasing tie, so we continue erasing ties
                    notetie[last_x_int]-=mask; // Erase note tie
                  );
                );        
              );
            );
          );
          last_x = x;
        );
    ); // Mouse button released
    
    // Shift + Right click
    mouse_cap==(2|8) ? ( 
      x = (((mouse_x - pkw)/(gfx_w - pkw))*listlength)|0;
      mstate==0 ? (
        x >= 0 && x < listlength ? (
          ylock = y;
          xlock = x;
          mask = 2^y;
          nlm=(notelist[x] & mask);
          nlm_orig=nlm;
          mstate = ms_subdivnum;
          morig = mouse_y;
          sd_orig = getSubdivNum(ylock*listlength+x);
          draglen=ldraglen=0;
          note_enabled_for_sd=0;
          sd_set_to_disabled=0;
        );
      ) : (
        draglen=((morig - mouse_y)/10)|0;
        ldraglen != draglen ? (
          ldraglen = draglen;
