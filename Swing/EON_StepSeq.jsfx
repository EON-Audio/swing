    );
      ) : (
      gfx_x=lx+eon_swsh; gfx_y=ly; gfx_rectto(tx,ty);   // EON: swung off-beat starts later, end fixed -> never merges with next cell
    );
  
    notetie[xpos]&mask ? (
      // Draw note tie
      gfx_x=tx; gfx_y=ly; gfx_rectto(tx+2,ty);
