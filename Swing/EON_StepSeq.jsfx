(mouse_y < eon_pbh || mouse_y > tbh || mouse_x < 0
 || ( mouse_x > 28*busp && (mouse_y > tbrh && mouse_y < 2*tbrh) ) 
 || ( mouse_x > 24*busp && (mouse_y > 2*tbrh && mouse_y < 3*tbrh) ) 
 || (mouse_x > 24*busp  && (mouse_y > 3*tbrh && mouse_y < 4*tbrh)) 
 || (mouse_x > 28*busp  && (mouse_y > 4*tbrh && mouse_y < 5*tbrh))
 || (mouse_x > 8*busp  && (mouse_y > 5*tbrh && mouse_y < 6*tbrh))
) && (mstate!=ms_tb_numbeats)? hl_state=0; // Clear toolbar highlights

// Erase everything within note matrix
color(7);
gfx_x=pkw; gfx_y=tbh; gfx_rectto(gfx_w,grid_bottom);

// Erase everything within envelope lane
gfx_x=pkw-1; // -1 to erase also the leftmost pixels of event dots
gfx_y=gfx_h - elh+el_divh; gfx_rectto(gfx_w,gfx_h);

refresh_cc_controls ? (
  draw_cc_controls();
  refresh_cc_controls=0;
);

// EON: deep-teal LCD backdrop behind the STEP GRID only (x >= pkw); the lane-label
// column (0..pkw) is left to draw_drum_note so its names/glyphs/colours survive
colorscheme==10 ? (
  (eon_pat_sync && eon_selrc > 0) ? (
    // P3b-4f: SYNCED grid wears its DM REGION's colour — same packed RGB the
    // selected chip draws (captured in draw_pat_button), backdrop + empty-cell
    // pair derived by hue-preserving luminance scaling so every region lands
    // at the same board darkness. Depth order mirrors the hue branch below:
    // backdrop lightest (gaps read as light gridlines), first-beat cells
    // brighter than off-beat cells on a dark board. Standalone is untouched.
    eon_srr = ((eon_selrc/65536)|0)/255; eon_srg = (((eon_selrc/256)|0)%256)/255; eon_srb = (eon_selrc%256)/255;
    eon_srm = max(max(eon_srr, eon_srg), eon_srb);
    eon_srm < 0.02 ? eon_srm = 0.02;
    gfx_set(eon_srr*(0.26/eon_srm), eon_srg*(0.26/eon_srm), eon_srb*(0.26/eon_srm), 1);
    gfx_x=pkw; gfx_y=tbh; gfx_rectto(gfx_w, grid_bottom);
    eon_pc24r=eon_srr*(0.22/eon_srm); eon_pc24g=eon_srg*(0.22/eon_srm); eon_pc24b=eon_srb*(0.22/eon_srm);
    eon_pc25r=eon_srr*(0.15/eon_srm); eon_pc25g=eon_srg*(0.15/eon_srm); eon_pc25b=eon_srb*(0.15/eon_srm);
  ) :
  pattern_hue[p] < 0 ? (   // cream/default pattern -> MPC cream board (matches the housing the plugin sits in)
    gfx_set(0.55, 0.52, 0.46, 1); gfx_x=pkw; gfx_y=tbh; gfx_rectto(gfx_w, grid_bottom);   // darker-cream gridlines (clear grid)
    eon_pc24r=0.75; eon_pc24g=0.72; eon_pc24b=0.66;   // empty cell, first beat (medium cream -> beat grouping)
    eon_pc25r=0.88; eon_pc25g=0.85; eon_pc25b=0.80;   // empty cell, other beats (light cream)
  ) : (
    // backdrop + empty-cell colours tinted to the ACTIVE pattern's hue (subtle per-pattern ambiance)
