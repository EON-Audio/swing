  mstate==0 ? hl_state=hl_settings;
  );
  
) : (mouse_y > 0 && mouse_y < eon_pbh && mouse_x > 0 && mstate==0 && slider17 < 1.5) || (mstate&ms_tb_r1) ? ( // piano area (range-drag, Piano view only; Pads view is display-only)
  colorscheme==10 ? (x = eon_pwin_lo + (((mouse_x - 2) / max(1, eon_key_w)) * 12 / 7)|0) : (x=(128*(mouse_x / tb_pianokey_end))|0);
  (x >= basenote && x <= basenote+numnotes && mstate==0) || mstate==ms_tb_pianokey_base || mstate==ms_tb_pianokey_numnotes? (
    (mouse_cap==1) ? ( // Left click toolbar pianokeys on grid note range
      mstate==0 ? ( // Click / Button down
        mstate=ms_tb_pianokey_base;
        last_x=x;
      ) : (
        x != last_x ? (
