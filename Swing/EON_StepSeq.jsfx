ms_tb_button=ms_tb+ms_tb_r5+0;
ms_tb_panic=ms_tb+ms_tb_r5+1;
ms_tb_notelen=ms_tb+ms_tb_r5+3;
ms_tb_patternlen=ms_tb+ms_tb_r5+4;
ms_tb_numbeats=ms_tb+ms_tb_r5+5;
ms_tb_move=ms_tb+ms_tb_r5+6;
ms_tb_settings=ms_tb+ms_tb_r5+7;
ms_tb_velo=ms_tb+ms_tb_r5+8;
ms_tb_gridmenu=ms_tb+ms_tb_r5+9;  // EON grid-picker latch: owned by NO section, so the
                                  // frames after gfx_showmenu closes are inert until the
                                  // central release reset (old ms_tb_notelen reuse let the
                                  // Note-length section drag during menu dismissal)
ms_tb_r6=2^15; // toolbar row 6
ms_tb_pattmode=ms_tb+ms_tb_r6+0;
ms_tb_r7=2^16; // EON P3b-4c: song-strip row (drag states keep the ms_tb bit so the
               // pattern-row branch stays engaged during a promote; r7 dispatches ours)
ms_tb_songbtn       = ms_tb+ms_tb_r7+0;  // consumed click (PLAY/LOOP/toggle/menu)
ms_tb_songdrag_pat  = ms_tb+ms_tb_r7+1;  // pattern button being dragged toward the strip
ms_tb_songdrag_chip = ms_tb+ms_tb_r7+2;  // chip drag (reorder / drag-out remove)
ms_el=2^11; // envelope lane area
ms_el_divider=ms_el+0;
ms_el_envdraw=ms_el+1;
ms_el_enverase=ms_el+2;
ms_el_ctrlchange=ms_el+3;
ms_preview=2^12; // preview note or piano key 
ms_sub_drawfreehand=0; // substate for ms_noteerase and ms_notedraw. 0=off, 1=on
ms_sub_channelchange=0; // substate for ms_rowtranpose and ms_el_ctrlchange

// EON: per-lane mute/solo helpers -----------------------------------------
// audible = lane not muted AND (no lane is soloed, or THIS lane is soloed).
// E-2 -- lane->pad map for PAIRED mode: eon_lane_pad[L] = pad whose IDENT-band
// note matches lane L's effective note (basenote+L+transpose), or -1. Rebuilt
// every @block (so band-gated lanes keep working with the GUI closed) and read
// by @gfx for the pill display. Also derives eon_band_anysolo from the band's
// 16 solo fields (the pad-side any_solo equivalent).
function eon_e2_rebuild_map(slot) local(p, L, note_p, ib) (
  ib = EON_ID_BASE + slot*EON_ID_STRIDE;
  L = 0; loop(max_numnotes, eon_lane_pad[L] = -1; L += 1;);
  eon_band_anysolo = 0;
  p = 0;
  loop(16,
    note_p = gmem[ib + p*EON_ID_FIELDS + EON_ID_NOTE] | 0;
    // E-2.1 DRUM-MACHINE BINDING (user: "changing the note should not change
    // the note name in the sequencer/tcp/jsfx"): lane p IS pad p (the natural
    // bottom-up drum-row order already drawn). Instead of finding which lane a
    // pad's note lands on (which moved the name when the note changed), we PIN
    // lane p to pad p and keep its transpose pointed at pad p's CURRENT note:
    //   basenote + p + notetranspose[p] == pad note.
    // Everything downstream reads basenote+L+notetranspose[L] -- emitted MIDI,
    // displayed name (notenames[that note]), lane hue, the mute/solo map, and
    // note-off -- so all of them now follow the pad and the row keeps its name
    // and position when the trigger note changes. The row's screen position is
    // by lane index, so a lane may point at a note outside the visible grid.
    // Plain array writes (no slider_automate) -> no undo churn; re-derived
    // every @block so it self-heals after kit load / note edits.
    (p < numnotes && note_p >= 0 && note_p <= 127) ? (
      notetranspose[p] = note_p - basenote - p;
      eon_lane_pad[p]  = p;
    );
    gmem[ib + p*EON_ID_FIELDS + EON_ID_SOLO] > 0.5 ? eon_band_anysolo = 1;
    p += 1;
  );
);
// E-2: a paired+mapped lane gates on the PAD state (one mute, every surface);
// unmapped lanes and unpaired instances keep the local lane state (legacy).
function eon_audible(n) local(pd, ib) (
  pd = _eon_blk_ps >= 0 ? eon_lane_pad[n] : -1;
  pd >= 0 ? (
    ib = EON_ID_BASE + _eon_blk_ps*EON_ID_STRIDE + pd*EON_ID_FIELDS;
    !(gmem[ib + EON_ID_MUTE] > 0.5) && (eon_band_anysolo == 0 || gmem[ib + EON_ID_SOLO] > 0.5);
  ) : (
    !lane_mute[n] && (any_solo==0 || lane_solo[n]);
  );
);
// recompute the cached any_solo flag (call on toggle + after deserialize).
function eon_recalc_solo() local(i) (
  any_solo=0; i=0;
  loop(max_numnotes, lane_solo[i] ? any_solo=1; i+=1;);
);
// publish per-PAD mute/solo to gmem so the Swing bridge mirrors them onto the
// multi-out child tracks. Each Swing pad's MIDI note -> the StepSeq lane playing
// that note (basenote + lane + transpose) -> that lane's mute/solo.
// PAIRED: write the paired Swing's registry-slot BAND, mapping pads via that
// instance's IDENT-band notes. UNPAIRED: the legacy global region + shared META
// (byte-identical to the original behavior), so a bridge-less StepSeq still works.
function eon_publish_ms() local(p, note_p, L, found, ab, nb, st, mb, sb, rm, rs, adopted) (
  eon_pair_slot >= 0 ? (
    // E-2: PAIRED lanes are views/controllers of the PAD state — the banded
    // M/S region is RETIRED (no heartbeat, no publish, no reverse-mailbox
    // consume). The bridge's banded mirror sees the dead heartbeat and goes
    // silent; its pad-M/S legs own the child tracks; pill clicks post to the
    // Swing's INCMD sequencer cells instead. Unpaired branch below unchanged.
    0;
  ) : (
    nb = EON_SW_META_BASE + EON_SW_NOTE_OFF; st = EON_SW_META_PP;
    mb = EON_SS_MUTE_BASE; sb = EON_SS_SOLO_BASE;
    gmem[EON_SS_ALIVE] = gmem[EON_SS_ALIVE] + 1;   // legacy global heartbeat
    gmem[EON_SS_ANYSOLO] = any_solo;
    p = 0;
    loop(16,
      note_p = gmem[nb + p*st] | 0;
      found = -1; L = 0;
      loop(max_numnotes,
        (basenote + L + notetranspose[L]) == note_p ? found = L;
        L += 1;
      );
      gmem[mb + p] = found >= 0 ? lane_mute[found] : 0;
      gmem[sb + p] = found >= 0 ? lane_solo[found] : 0;
      p += 1;
    );
  );
);
// filled horizontal PILL (rounded-end rect): round caps + middle rect.
function eon_fill_pill(px, py, pw, ph) local(r) (
  r = (ph/2)|0;
  gfx_circle(px+r,      py+r, r, 1, 1);
  gfx_circle(px+pw-r-1, py+r, r, 1, 1);
  gfx_rect(px+r, py, pw-2*r, ph);
);

// ── Lane VOL / PAN — remote control of the paired Swing pad's gain/pan ───────
// Read from the Swing-published MIX band, write through the INCMD mailbox. There
// is deliberately NO local fallback: unlike mute/solo (which are meaningful for a
// lane driving any MIDI target) gain and pan here mean "the sampler pad's gain and
// pan", so with no pad mapped there is nothing to control and the knobs hide.
// eon_lane_has_mix() is the single gate every draw + hit-test path asks.
// DEFINED HERE, above draw_drum_note, because EEL2 resolves function references
// at DEFINITION time -- these live next to the geometry they serve, not next to
// ss_mute_toggle where they read more naturally but would compile-kill the file.
function eon_lane_has_mix(lane) (
  eon_pair_slot >= 0 && eon_lane_pad[lane] >= 0;
);
// Steppa's answer to Swing's pad_input_allowed() (rk_swing_ui_state.jsfx-inc:109),
// which is likewise a MODAL check rather than a geometric one: while any overlay
// owns the screen, the pads/knobs under it take no input at all.
// This is needed because knobs_kbsg widgets are SELF-DRIVING -- they read the mouse
// straight from globals during the DRAW pass, which runs BEFORE the overlay click
// handlers. mstate=ms_tb_button_noundo stops the state machine but means nothing to
// a widget that never consults it, so without this a click inside the groove
// dropdown or icon picker also grabbed the lane knob sitting underneath the panel.
// Some of these flags are assigned later in @gfx than the knob draw, so this reads
// last frame's value for those -- one frame of lag, which is imperceptible and far
// safer than reordering the section.
// Which flag kind to use per overlay is a real distinction, not a style choice:
//   _open      -- TRUE MODALS. Their handler fires on any click anywhere and closes
//                 (VIEW :5688, PAIR :5744 close+swallow via mstate on click-outside).
//                 A self-driving knob never consults mstate, so gating those two on
//                 _in_panel meant the dismiss-click closed the dropdown AND turned
//                 the knob underneath it. Gate on _open: while it is up, nothing turns.
//   _in_panel  -- NON-MODAL panels that stay open while you work elsewhere (settings)
//                 or consume their own clicks (theme, rkth_input). _open would freeze
//                 every lane knob for as long as the panel is showing.
function ss_knob_input_ok() (
  !eon_gdd_open && !eon_ico_open && !eon_lm_open && !eon_pm_open && !eon_vdd_open
  && !eon_prdd_open && !eon_so_in_panel && !eon_thdd_in_panel;
);
function eon_lane_gain(lane) local(pd) (
  pd = eon_pair_slot >= 0 ? eon_lane_pad[lane] : -1;
  pd >= 0 ? gmem[EON_SW_PADMIX_BASE + eon_pair_slot*EON_SW_PADMIX_STRIDE + pd*2 + EON_SW_PADMIX_GAIN] : 1;
);
function eon_lane_pan(lane) local(pd) (
  pd = eon_pair_slot >= 0 ? eon_lane_pad[lane] : -1;
  pd >= 0 ? gmem[EON_SW_PADMIX_BASE + eon_pair_slot*EON_SW_PADMIX_STRIDE + pd*2 + EON_SW_PADMIX_PAN] : 0;
);
// Absolute SETs, payload before flag (flag 2 = adopt + mark_dirty_pad, so each
// gesture lands as one Swing undo point). Clamped to the mailbox's documented
// payload ranges -- a knob must never post a value Swing would have to sanitise.
function eon_lane_set_gain(lane, v) local(pd, cb) (
  pd = eon_pair_slot >= 0 ? eon_lane_pad[lane] : -1;
  pd >= 0 ? (
    cb = EON_INCMD_BASE + eon_pair_slot*EON_INCMD_STRIDE + EON_INCMD_GAIN + pd*2;
    gmem[cb+1] = max(0, min(8, v));
    gmem[cb] = 2;
  );
);
function eon_lane_set_pan(lane, v) local(pd, cb) (
  pd = eon_pair_slot >= 0 ? eon_lane_pad[lane] : -1;
  pd >= 0 ? (
    cb = EON_INCMD_BASE + eon_pair_slot*EON_INCMD_STRIDE + EON_INCMD_PAN + pd*2;
    gmem[cb+1] = max(-1, min(1, v));
    gmem[cb] = 2;
  );
);

// Resolve ONE lane knob's colour into ss_kc_r/g/b — a faithful port of Swing's
// pad-knob appearance chain (rk_swing_ui_grid_pads.jsfx-inc:928-949), so the two
// products cannot drift. `appear`: 0 = theme accent (VOL) / accent2 (PAN) — which
// is why VOL and PAN are DIFFERENT colours by default; 1..6 = fixed presets;
// 7 = follow the pad's own colour; 8 = near-black; 9 = near-white.
// `is_pan` only selects which accent the 0 case falls back to.
// Accent/accent2 come straight from the theme band (GS_THEME_BASE slots 4 and 5),
// with Swing's AKAI-red / iMPC-blue idle fallbacks when no theme is live.
// ⚠ `nt` is the MIDI NOTE (basenote + lane + transpose), NOT the lane index.
// eon_pad_hue_for_note() and notenames[] are both note-indexed -- passing a lane
// index here silently resolves to "no name", drops through to the grey fallback,
// and every knob renders identical grey. The lane tile itself passes nt (line
// ~4400); this must match it.
function ss_knob_color(nt, appear, is_pan) local(h) (
  appear == 7 ? (
    // Inlined body of eon_pad_rgb rather than a call to it: that function is
    // defined at ~4570, far below this one, and EEL2 binds function references
    // at DEFINITION time -- calling it from here compiles to "unknown function"
    // and silently kills the whole file. eon_pad_hue_for_note and eon_hsl2rgb
    // are both defined above (436/464), so the logic is reproduced against those.
    // Keep in sync with eon_pad_rgb if its sentinel handling ever changes.
    h = eon_pad_hue_for_note(nt);
    (h > -5 && notenames[nt] != 0) ? (
      h <= -1.5 ? ( ss_kc_r=110/255; ss_kc_g=110/255; ss_kc_b=118/255; ) :
      h < 0     ? ( ss_kc_r=196/255; ss_kc_g=196/255; ss_kc_b=206/255; ) :
      ( eon_hsl2rgb(h, gmem[EON_SW_COL_S], gmem[EON_SW_COL_L]);
        ss_kc_r = gfx_r; ss_kc_g = gfx_g; ss_kc_b = gfx_b; );
    ) : ( ss_kc_r = 0.62; ss_kc_g = 0.62; ss_kc_b = 0.66; );
  ) :
  appear == 1 ? ( ss_kc_r=0.85; ss_kc_g=0.22; ss_kc_b=0.18; ) :
  appear == 2 ? ( ss_kc_r=0.95; ss_kc_g=0.55; ss_kc_b=0.15; ) :
  appear == 3 ? ( ss_kc_r=0.30; ss_kc_g=0.72; ss_kc_b=0.38; ) :
  appear == 4 ? ( ss_kc_r=0.25; ss_kc_g=0.78; ss_kc_b=0.85; ) :
  appear == 5 ? ( ss_kc_r=0.30; ss_kc_g=0.55; ss_kc_b=0.92; ) :
  appear == 6 ? ( ss_kc_r=0.62; ss_kc_g=0.42; ss_kc_b=0.90; ) :
  appear == 8 ? ( ss_kc_r=0.08; ss_kc_g=0.08; ss_kc_b=0.09; ) :
  appear == 9 ? ( ss_kc_r=0.93; ss_kc_g=0.93; ss_kc_b=0.95; ) :
  gmem[GS_THEME_ID] > 0 ? (
    is_pan ? ( ss_kc_r = gmem[GS_THEME_BASE+15]; ss_kc_g = gmem[GS_THEME_BASE+16]; ss_kc_b = gmem[GS_THEME_BASE+17]; )
           : ( ss_kc_r = gmem[GS_THEME_BASE+12]; ss_kc_g = gmem[GS_THEME_BASE+13]; ss_kc_b = gmem[GS_THEME_BASE+14]; );
  ) : (
    is_pan ? ( ss_kc_r=0.28; ss_kc_g=0.48; ss_kc_b=0.72; )   // iMPC blue  (accent2)
           : ( ss_kc_r=0.85; ss_kc_g=0.20; ss_kc_b=0.12; );  // AKAI red   (accent)
  );
);

// shared lane-header geometry (so draw + click hit-test never drift).
// SINGLE LINE: name on the left (its own full width), then a reserved control
// STRIP on the right (eon_ctrlw wide) holding the M, S and swing% PILLS.
// ── Lane-header COLUMN VISIBILITY ────────────────────────────────────────────
// One bit per column; a hidden column contributes 0 width and everything to its
// right shifts left. This is now the ONLY place pkw is derived -- the five sites
// that each recomputed "chw + pianow + eon_ctrlw" call here instead, so the drawn
// layout and the hit-test geometry cannot drift apart.
//   bit0 ICON   bit1 NAME   bit2 MUTE   bit3 SOLO   bit4 VOL   bit5 PAN   bit6 SWING
// Icon/name is a VALIDITY RULE on the pair, not two independent toggles: a lane
// showing neither has no identity left, so NAME is forced back on if both clear.
function eon_colvis_apply() (
  (eon_colvis & 3) == 0 ? eon_colvis = eon_colvis | 2;
  // Control-strip width = only what is enabled. The per-control widths are the
  // worst-case ones the old FIXED eon_ctrlw=126 was derived from (M/S 17+3,
  // knob 18+4, swing 35+4, +3 trailing), so an all-columns-on strip comes out at
  // exactly 126 and is byte-identical to the layout this replaced.
  // A hidden column collapses to a STUB, not to nothing. The stub is where its
  // restore chevron lives in the column-header strip -- a column that vanished
  // completely would have no way back except the Settings panel, which is exactly
  // the "still have the arrow to show again" requirement. Modelled on the SONG
  // strip, which collapses its height into tbh rather than disappearing.
  eon_ctrlw = 0;
  eon_ctrlw += (eon_colvis & 4)  ? 20 : EON_COL_STUB;
  eon_ctrlw += (eon_colvis & 8)  ? 20 : EON_COL_STUB;
  eon_ctrlw += (eon_colvis & 16) ? 22 : EON_COL_STUB;
  eon_ctrlw += (eon_colvis & 32) ? 22 : EON_COL_STUB;
  eon_ctrlw += (eon_colvis & 64) ? 39 : EON_COL_STUB;
  eon_ctrlw += 3;
  // Derive the NATURAL widths here rather than trusting the caller to have just
  // assigned them. The earlier version only SHRANK chw/pianow and relied on
  // "re-enabling re-runs @slider" to restore them -- but sliderchange() does not
  // re-run @slider, and chw is not reassigned anywhere in @gfx, so a restored
  // icon/name column stayed stuck at stub width forever. Computing both ends here
  // makes the function idempotent and independent of call order.
  mode == 0 ? ( eon_chw_nat = 0;                                      eon_pianow_nat = 3*8+8; )
            : ( eon_chw_nat = 2*8+8 + (colorscheme==10 ? 16 : 0);     eon_pianow_nat = max_notename_length*8+8; );
  // Stubs only exist where the column-header strip does (drum mode + EON scheme).
  // Everywhere else the columns are always full width, so a mask set in drum mode
  // cannot leak a 9px gap into the piano roll.
  (mode == 1 && colorscheme == 10) ? (
    chw    = (eon_colvis & 1) ? eon_chw_nat    : EON_COL_STUB;
    pianow = (eon_colvis & 2) ? eon_pianow_nat : EON_COL_STUB;
  ) : (
    chw = eon_chw_nat; pianow = eon_pianow_nat;
  );
  pkw = chw + pianow + (colorscheme==10 ? eon_ctrlw : 0);   // the one real derivation
);

function eon_ms_geo() (
  eon_ms_bh = min(max(row_height-8, 9), 13);
  eon_ms_bw = eon_ms_bh + 4;                     // pill: a touch wider than tall
  eon_ms_row2dy = ((row_height-eon_ms_bh)/2)|0;  // vertically centered in the row
  eon_cz = pkw - eon_ctrlw;                      // control strip left edge (just right of the name)
  // Running cursor: each ENABLED control takes its slot and advances it, so a
  // hidden column collapses rather than leaving a hole. Every disabled control
  // parks off-canvas at -1000 so no hit-test, hover test or wheel gate can match
  // something that is not drawn -- that off-canvas convention is what lets the
  // rest of the file stay ignorant of which columns are on.
  // eon_colx[i]/eon_colw[i] = the on-screen span of column i (0..6), recorded for
  // BOTH states. The column-header strip draws from these, so a header cell can
  // never land somewhere its column isn't -- same reason eon_song_geom() exists.
  // Columns 0/1 (icon, name) are fixed by chw/pianow; 2..6 are laid out below.
  eon_colx[0] = 0;   eon_colw[0] = chw;
  eon_colx[1] = chw; eon_colw[1] = pianow;
  eon_gx = eon_cz + 3;
  (eon_colvis & 4) ? ( eon_ms_mx = eon_gx; eon_colx[2]=eon_gx; eon_colw[2]=eon_ms_bw; eon_gx += eon_ms_bw + 3; )
                   : ( eon_ms_mx = -1000;  eon_colx[2]=eon_gx; eon_colw[2]=EON_COL_STUB; eon_gx += EON_COL_STUB; );
  (eon_colvis & 8) ? ( eon_ms_sx = eon_gx; eon_colx[3]=eon_gx; eon_colw[3]=eon_ms_bw; eon_gx += eon_ms_bw + 3; )
                   : ( eon_ms_sx = -1000;  eon_colx[3]=eon_gx; eon_colw[3]=EON_COL_STUB; eon_gx += EON_COL_STUB; );
  // Knobs also LOD out below an ~18px row, independently of the column bits: at
  // that size a knob is smaller than the finger dragging it. Note the asymmetry --
  // LOD hides the knob but does NOT reclaim its width (eon_ctrlw is fixed per
  // mask, computed back in @slider where row_height is not known yet), whereas
  // clearing the column bit does reclaim it. Turning a column off is the way to
  // give the step grid its pixels back.
  eon_kn_show = row_height >= 18 ? 1 : 0;
  eon_kn_r    = eon_kn_show ? min(max(((row_height-6)/2)|0, 6), 9) : 0;
  eon_kn_v_on = eon_kn_show && (eon_colvis & 16);
  eon_kn_p_on = eon_kn_show && (eon_colvis & 32);
  eon_kn_v_on ? ( eon_kn_vx = eon_gx + eon_kn_r; eon_colx[4]=eon_gx; eon_colw[4]=eon_kn_r*2; eon_gx += eon_kn_r*2 + 4; )
              : ( eon_kn_vx = -1000; eon_colx[4]=eon_gx; eon_colw[4]=(eon_colvis & 16) ? 0 : EON_COL_STUB; eon_gx += eon_colw[4]; );
  eon_kn_p_on ? ( eon_kn_px = eon_gx + eon_kn_r; eon_colx[5]=eon_gx; eon_colw[5]=eon_kn_r*2; eon_gx += eon_kn_r*2 + 4; )
              : ( eon_kn_px = -1000; eon_colx[5]=eon_gx; eon_colw[5]=(eon_colvis & 32) ? 0 : EON_COL_STUB; eon_gx += eon_colw[5]; );
  (eon_colvis & 64) ? ( eon_sw_x = eon_gx; eon_sw_w = pkw - 3 - eon_sw_x; eon_colx[6]=eon_gx; eon_colw[6]=eon_sw_w; )
                    : ( eon_sw_x = -1000; eon_sw_w = 0; eon_colx[6]=eon_gx; eon_colw[6]=EON_COL_STUB; );
);
any_solo=0;

// Toolbar element highlight states
hl_state=0;
hl_pattern=16; // Lowest 4 bits indicate the pattern number to highlight
hl_mode=113;
hl_playbeforestart=114;
hl_startpos=115;
hl_endpos=116;
hl_notelen=117;
hl_swing=118;
hl_patshift=119;
hl_panic=120;
hl_patternlen=121;
hl_numbeats=122;
hl_colorbutt=123;
hl_rate=124;
hl_move=125;
hl_velo=126;
hl_midimode=127;
hl_settings=128;
hl_pattmode=129;
last_hl_state=0;

lastpreviewsel=-1;
gfx_clear=-1;
ext_noinit=1;
// noteonstate deliberately NOT reset here: fresh instances start at 0 anyway, and an
// @init re-run mid-play must not orphan sounding notes -- under the physical invariant
// a wiped bit is a note-off that never fires (legacy's unconditional per-step rebuild
// used to paper over this).
want_preview=-1;
last_preview=-1;
want_preview_nt=-1;
last_preview_nt=-1;
want_previewoff=0;
defaultvelo=100;
// EON serialize-safety: lastvelo is file_var'd -- don't stomp it on an SR-change
// @init re-run (fresh memory is 0, so the !guard is a no-op on first load).
!lastvelo ? lastvelo=defaultvelo;

velobarwidth = 3;
ticks = 0;
tpb = 128; // ticks per beat
pianow=3*8+8;
chw = 0; //MIDI channel column width
// EON: reserved control strip at the right of each lane header.
// 72 -> 126 when the VOL/PAN knobs landed. Budget at a typical 25px row:
//   3 + M17 + 3 + S17 + 4 + VOL18 + 4 + PAN18 + 4 + swing35 + 3 = 126.
// This widens pkw, so the step grid loses ~54px. Deliberately a FIXED width
// rather than shrinking when the knobs LOD out: pkw is recomputed in five
// places from this constant, and making it row_height-dependent would thrash
// the whole header layout every time the window or lane count changed.
eon_ctrlw = 126;
// Bootstrap the column mask to all-on. @init runs BEFORE @slider, so without this
// the first derivation would see eon_colvis == 0, hide every column and compute
// pkw = 0 for one pass.
// GUARDED, not unconditional: a samplerate change re-runs @init (ext_noinit only
// shields play-start), and an unconditional 127 there would silently un-hide every
// column the user had collapsed. Same reason lastvelo is guarded just below and
// lane_swing_inited exists in @slider.
eon_colvis_inited == 0 ? ( eon_colvis = 127; eon_colvis_inited = 1; );
eon_colvis_apply();   // derives eon_ctrlw + pkw from the column mask (was: pkw = pianow+chw+eon_ctrlw)
