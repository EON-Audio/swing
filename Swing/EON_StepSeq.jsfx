      );
    );
    lx=tx+2;
    xpos+=1;
  );  

  ly=ty+2;
  notepos+=1;
);

// ── EON: grid-line structure (opt-in, slider49) ──────────────────────────────
// MUST be drawn HERE, after the cell loop. What reads as a "gridline" in this UI
// is really the backdrop showing through the 1px gap between cell fills, so the
// bar/octave lines further up get painted over by the cells -- anything drawn
// before the loop is invisible inside the grid. Drawn before the playhead so the
// playhead still reads as the topmost thing.
// Two parts, both deliberately low-alpha: this is structure, not decoration, and
// it sits under note cells that carry the actual information.
colorscheme==10 && eon_gridlines ? (
  // (1) BEAT LINES. There were none before -- beat grouping was only a fill-tint
  // difference between eon_pc24/eon_pc25, which is why the grid read as flat.
  // Bar lines already exist (color 19, theme-driven); these are the lighter tier
  // beneath them, so the hierarchy is bar > beat > step rather than bar > nothing.
  eon_gl_i = steps_per_beat;
  eon_gl_i >= 1 ? (
    while(eon_gl_i < listlength) (
      eon_gl_x = ((eon_gl_i*(gfx_w - pkw))/listlength + pkw)|0;
      gfx_set(0, 0, 0, 0.16);
      gfx_x = eon_gl_x; gfx_y = tbh; gfx_lineto(eon_gl_x, grid_bottom, 0);
      eon_gl_i += steps_per_beat;
    );
  );
  // (2) PER-LANE SEPARATORS, tinted to each lane's pad colour. Replaces nothing --
  // the octave lines above stay for piano-roll mode, where an octave boundary is
  // real; in DRUM mode they land wherever the numbering happens to cross C, which
  // is why the horizontal structure never corresponded to anything. A blank or
  // unnamed lane draws no separator at all, so empty rows stay quiet.
  eon_gl_np = 0;
  loop(numnotes,
    eon_gl_y  = (tbh + ((eon_gl_np+1)*(grid_bottom-tbh))/numnotes)|0;
    eon_gl_nt = basenote + (numnotes-1-eon_gl_np) + notetranspose[numnotes-1-eon_gl_np];
    eon_pad_rgb(eon_gl_nt) ? (
      gfx_a = 0.55;
      gfx_x = pkw; gfx_y = eon_gl_y; gfx_lineto(gfx_w, eon_gl_y, 0);
    );
    eon_gl_np += 1;
  );
);

// EON: translucent playhead column over the step grid (clearer than per-cell brighten)
(colorscheme==10 && lbeatpos >= 0 && lbeatpos < listlength) ? (
  eon_phx0 = ((lbeatpos)*(gfx_w - pkw))/listlength + pkw;
  eon_phx1 = ((lbeatpos+1)*(gfx_w - pkw))/listlength + pkw;
  gfx_r=0.0; gfx_g=0.72; gfx_b=0.86; gfx_a=0.16;
  gfx_x=eon_phx0; gfx_y=tbh; gfx_rectto(eon_phx1, grid_bottom);
);

(mstate == ms_veloedit || mstate == ms_veloeditrow || mstate == ms_startoffsetedit || mstate == ms_startoffseteditrow)&& ((nlm && sd_edit_num==0) || sd_editval_show)? (
  // Draw velocity or start offset value
  color(26);
  gfx_x=(((lastnote_changed_x)*(gfx_w - pkw))/listlength)+6+pkw|0; 
