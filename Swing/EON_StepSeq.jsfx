    eon_psnl = strlen(#eon_psname);
    while(eon_psnl > 1 && eon_psnw > eon_psaw) (
      eon_psnl -= 1;
      strncpy(#eon_pstr, #eon_psname, eon_psnl);
      strcat(#eon_pstr, "...");
      gfx_measurestr(#eon_pstr, eon_psnw, eon_psnh);
    );
  );
  eon_psopen_now ? gfx_set(0.97,0.95,1.0,1) : gfx_set(0.86,0.90,0.96,1);
  gfx_x=eon_psx+11; gfx_y=eon_psy+5; gfx_drawstr(#eon_pstr);
  (slider17 > 0.5 && slider17 < 1.5) ? draw_tb_pianokeys(busp*0, 0);          // Piano view
  (slider17 >= 1.5 && slider17 < 2.5) ? draw_tb_pads(busp*0, 0, 8);           // Pads 8  (1 pattern row + 2x4 kit)
  (slider17 >= 2.5 && slider17 < 3.5) ? draw_tb_pads(busp*0, 0, 16);          // Pads 16 (1 pattern row + 4x4 kit)
  slider17 >= 3.5 ? draw_tb_manual(busp*0, 0);                                // Manual map (4x4 remappable pads)
);

// ─────────────────────────────────────────────────────────────────────────────
// EON: widget tooltips (rk_widgets hint system, MIT). megababy gates the toolbar
// redraw, so drive the mode-button hover hint here EVERY frame, then render it on
// top. Reset to the default font afterward (megababy itself sets no custom font).
// ─────────────────────────────────────────────────────────────────────────────
colorscheme==10 ? (
  HINT_FONT = 9; gfx_setfont(HINT_FONT, "Arial", 14);
  eon_tt = 0;
  // Toolbar button hover hints. x = busp*col, y = row*tbrh, single cell = busp wide.
  (mouse_y >= 4*tbrh && mouse_y < 5*tbrh) ? (
    mouse_x >= busp*0  && mouse_x < busp*1  ? (eon_tt = "Toggle Drum-map / Piano-roll mode") :
    mouse_x >= busp*1  && mouse_x < busp*2  ? (eon_tt = "Panic: send all-notes-off") :
    mouse_x >= busp*2  && mouse_x < busp*4  ? (eon_tt = "Default note velocity (drag / scroll)") :
    mouse_x >= busp*4  && mouse_x < busp*8  ? (eon_tt = "Note length (% of step)") :
    mouse_x >= busp*8  && mouse_x < busp*12 ? (eon_tt = eon_len_follow
      ? "Synced: Len follows the DM region - pick Straight/Triplet to re-divide"
      : "Pattern length (steps)") :
    mouse_x >= busp*12 && mouse_x < busp*16 ? (eon_tt = "Grid: Straight/Triplet (right-click to pick; drag = raw steps per beat)") : 0;
  );
  (mouse_y >= 3*tbrh && mouse_y < 4*tbrh) ? (
    mouse_x >= busp*6  && mouse_x < busp*12 ? (eon_tt = "Swing amount") :
    (settingsopen && mouse_x >= busp*12 && mouse_x < busp*18) ? (eon_tt = "Rate: playback speed vs host tempo") :
    (settingsopen && mouse_x >= busp*18 && mouse_x < busp*24) ? (eon_tt = "MIDI-trigger mode (live pattern switching)") :
    (settingsopen && mouse_x >= busp*24 && mouse_x < busp*26) ? (eon_tt = "MIDI-trigger note (= pattern 1)") : 0;
  );
  (mouse_y >= 1*tbrh && mouse_y < 2*tbrh && mouse_x >= busp*24 && mouse_x < busp*26) ? (eon_tt = "Cycle colour scheme");
  // Column-header strip hints. The icon/name pair gets its OWN text when it is the
  // last one standing -- clicking it does nothing by design, and a control that
  // refuses silently reads as broken. eon_colx/eon_colw come from eon_ms_geo, so
  // the hint region is the same span that was drawn and clicked.
  (eon_colhdr_vis && mouse_y >= eon_colhdr_y && mouse_y < eon_colhdr_y+eon_colhdr_h
   && mouse_x >= 0 && mouse_x < pkw) ? (
    eon_tti = 0; eon_tth = -1;
    loop(7,
      (eon_colw[eon_tti] > 0 && mouse_x >= eon_colx[eon_tti]
       && mouse_x < eon_colx[eon_tti] + eon_colw[eon_tti]) ? eon_tth = eon_tti;
      eon_tti += 1;
    );
    eon_tth >= 0 ? (
      (eon_tth < 2 && (eon_colvis & 3) != 3 && (eon_colvis & (2^eon_tth))) ?
        eon_tt = "Kept: a lane needs its icon or its name — show the other one first" :
      (eon_colvis & (2^eon_tth)) ?
        eon_tt = (eon_tth==0 ? "Hide the icon column" : eon_tth==1 ? "Hide the name column" :
                  eon_tth==2 ? "Hide Mute" : eon_tth==3 ? "Hide Solo" : eon_tth==4 ? "Hide the VOL knob" :
                  eon_tth==5 ? "Hide the PAN knob" : "Hide the swing/groove pill") :
        eon_tt = (eon_tth==0 ? "Show the icon column" : eon_tth==1 ? "Show the name column" :
                  eon_tth==2 ? "Show Mute" : eon_tth==3 ? "Show Solo" : eon_tth==4 ? "Show the VOL knob" :
                  eon_tth==5 ? "Show the PAN knob" : "Show the swing/groove pill");
    );
  );
  // ZOOM cells (control row, under the settings cog)
  (mouse_y >= eon_r2 && mouse_y < eon_r2b && mouse_x >= eon_cogb_x && mouse_x < eon_cogb_x+busp-3) ?
    (eon_tt = "Zoom: fit the arrange to the whole song (all patterns)");
  (mouse_y >= eon_r2 && mouse_y < eon_r2b && mouse_x >= eon_cogb_x+busp && mouse_x < eon_cogb_x+busp*2-3) ?
    (eon_tt = "Zoom: fit the arrange to the selected pattern");
  (settingsopen==1 && mouse_y >= 5*tbrh && mouse_y < 6*tbrh && mouse_x >= busp*0 && mouse_x < busp*1) ? (eon_tt = "Pattern layout: 96x64 / 48x128 steps");
  // P3b-4b: hovering a pattern button in sync mode -> tooltip = the region NAME.
  // Trusted only when the courier's NAMEPAGE matches our visible page (a page flip
  // invalidates the window until the bridge rewrites it -> no stale-page names).
  (eon_pat_sync && eon_pair_slot >= 0 && mouse_y > eon_pbh && mouse_y < eon_pbh+tbrh && mouse_x < eon_pbw*eon_npat_vis) ? (
    eon_rn_i = (mouse_x / eon_pbw)|0;
    (eon_rn_i >= 0 && eon_rn_i < eon_npat_vis
     && (gmem[EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE + EON_SS_SYNC_NAMEPAGE]|0) == eon_pat_base + 1) ? (
      eon_rgnname(eon_rn_i, #eon_rgn_hov, 31);
      strlen(#eon_rgn_hov) > 0 ? eon_tt = #eon_rgn_hov;
    );
  );
  // ③ ADAPT chip hint — AFTER the region-name block (last assignment wins and
  // sync-mode name chips extend under the chip while it's lit).
  (eon_adapt_pend && mouse_x > eon_swpx-63 && mouse_x < eon_swpx-3 && mouse_y > eon_pbh && mouse_y < eon_pbh+tbrh) ?
    (eon_tt = "Re-aim patterns at moved pads (right-click: dismiss)");
  // Self-contained tooltip timing (robust in the refresh-gated toolbar): count
  // still frames while hovering a hinted button, then draw the hint box on top.
  (eon_tt && eon_ttlx == mouse_x && eon_ttly == mouse_y) ? (eon_tthold += 1) : (eon_tthold = 0);
  eon_ttlx = mouse_x; eon_ttly = mouse_y;
  (eon_tt && eon_tthold > 15) ? (
    gfx_measurestr(eon_tt, eon_ttw, eon_tth);
    eon_ttx = mouse_x + 14; eon_tty = mouse_y + 16;
    (eon_ttx + eon_ttw + 6) > gfx_w ? (eon_ttx = mouse_x - eon_ttw - 10);
    gfx_set(0.04, 0.05, 0.08, 0.95);
    gfx_rect(eon_ttx - 4, eon_tty - 3, eon_ttw + 8, eon_tth + 6);
    gfx_set(0, 0.80, 0.94, 1);
    gfx_x = eon_ttx; gfx_y = eon_tty; gfx_drawstr(eon_tt);
  );
  // P3b-4c: song-strip drag feedback — every frame, on top (the strip itself is
  // refresh-gated): an insertion caret between chips while hovering the strip,
  // plus a translucent ghost chip that rides the cursor.
  (mstate == ms_tb_songdrag_pat || mstate == ms_tb_songdrag_chip) ? (
    eon_song_geom();
    (mouse_y >= eon_song_y-1 && mouse_y < eon_song_y+eon_song_h-2 && eon_sg_len > 0) ? (
      eon_scaret = ((mouse_x - eon_sg_x0) / eon_sg_cw)|0;
      eon_scaret < 0 ? eon_scaret = 0;
      eon_scaret > eon_sg_len ? eon_scaret = eon_sg_len;
      gfx_set(0.99, 1.0, 1.0, 0.9);
      gfx_rect(eon_sg_x0 + eon_scaret*eon_sg_cw - 2, eon_song_y - 2, 2, tbrh + 2);
    );
    gfx_set(1, 1, 1, 0.35);
    gfx_rect(mouse_x - 9, mouse_y - 8, 18, 16);
    gfx_set(0.05, 0.06, 0.08, 0.9);
    gfx_x = mouse_x - 5; gfx_y = mouse_y - 5;
    gfx_drawnumber(mstate == ms_tb_songdrag_pat ? eon_sdrag_ord
                 : (gmem[eon_sg_b + 8 + (eon_sdrag_from-1)*2]|0) % 256, 0);
  );
  gfx_setfont(0);
);

// ─────────────────────────────────────────────────────────────────────────────
// EON: beat ruler (1 2 3 4 ...) in the strip just above the grid, column-aligned
// ─────────────────────────────────────────────────────────────────────────────
colorscheme==10 ? (
  gfx_set(0.10, 0.26, 0.35, 1.0);
  gfx_x=0; gfx_y=tbh-13; gfx_rectto(gfx_w, tbh-1);
  gfx_setfont(6, "Verdana", 10, 'b');
  eon_rs = 0;
  loop(listlength,
    (eon_rs % steps_per_beat) == 0 ? (
      eon_rx = (pkw + (eon_rs*(gfx_w-pkw))/listlength)|0;
      gfx_set(0.42, 0.47, 0.56, 1.0); gfx_x=eon_rx; gfx_y=tbh-13; gfx_lineto(eon_rx, tbh-1, 0);
      gfx_set(0.93, 0.96, 1.00, 1.0); gfx_x=eon_rx+3; gfx_y=tbh-12;
      gfx_drawnumber((eon_rs/steps_per_beat) % 4 + 1, 0);
    );
    eon_rs += 1;
  );
  // P3b-4c: SONG pill at the gutter's left edge (sync only) -> toggles the strip.
  (eon_pat_sync && eon_pair_slot >= 0) ? (
    eon_song_on ? gfx_set(0.0, 0.55, 0.68, 1.0) : gfx_set(0.16, 0.20, 0.27, 1.0);
    roundRect(2, tbh-13, 38, 11, 3, 1);
    eon_song_on ? gfx_set(0.95, 1.0, 1.0, 1.0) : gfx_set(0.60, 0.66, 0.74, 1.0);
    gfx_x = 8; gfx_y = tbh-12; gfx_drawstr("SONG");
  );
  // P3b-4b: SELECTED pattern's region name in the ruler's left gutter (x < pkw is
  // empty — beat numbers start at pkw; the name sits right of the SONG pill in
  // sync). Reads the dedicated SEL sub-band, keyed by NAMESEL == eon_sel_ord, so
  // the name stays correct when the selection is on a page other than the visible
  // one. This block is outside the refresh_tb gate -> updates every frame
  // (rename/reselect show within a bridge tick).
  (eon_pat_sync && eon_pair_slot >= 0 && eon_sel_ord >= 1
   && (gmem[EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE + EON_SS_SYNC_NAMESEL]|0) == eon_sel_ord) ? (
    eon_rgnname(8, #eon_rgn_sel, 31);
    strlen(#eon_rgn_sel) > 0 ? (
      eon_rsaw = pkw - 54;
      strcpy(#eon_rgn_selt, #eon_rgn_sel);
      gfx_measurestr(#eon_rgn_selt, eon_rsnw, eon_rsnh);
      (eon_rsnw > eon_rsaw) ? (
        eon_rsnl = strlen(#eon_rgn_sel);
        while(eon_rsnl > 1 && eon_rsnw > eon_rsaw) (
          eon_rsnl -= 1;
          strncpy(#eon_rgn_selt, #eon_rgn_sel, eon_rsnl);
          strcat(#eon_rgn_selt, "...");
          gfx_measurestr(#eon_rgn_selt, eon_rsnw, eon_rsnh);
        );
      );
      gfx_set(0.93, 0.96, 1.00, 1.0); gfx_x = 46; gfx_y = tbh-12; gfx_drawstr(#eon_rgn_selt);
    );
  );
  gfx_setfont(0);
);

// ─────────────────────────────────────────────────────────────────────────────
// EON: Settings overlay — floating cream panel over the grid (geometry eon_so_*
// computed earlier; eon_so_in_panel shields the grid). Theme / Piano octaves /
// Rate / MIDI mode / Trig note. Close via the X or the Settings toolbar button.
// ─────────────────────────────────────────────────────────────────────────────
// EON: VIEW dropdown -- Swing-style cream/teal menu under the VIEW pill
eon_vdd_open ? (
  gfx_set(0,0,0,0.30);        gfx_rect(eon_vdd_x+3, eon_vdd_y+4, eon_vdd_w, eon_vdd_h);   // shadow
  gfx_set(0.84,0.81,0.76,1.0); gfx_rect(eon_vdd_x, eon_vdd_y, eon_vdd_w, eon_vdd_h);       // cream panel
  gfx_set(0.40,0.37,0.32,1.0); gfx_rect(eon_vdd_x, eon_vdd_y, eon_vdd_w, eon_vdd_h, 0);    // border
  eon_vdd_i=0;
  loop(5,
    eon_vdd_ry = eon_vdd_y + eon_vdd_i*eon_vdd_rh;
    (mouse_x>=eon_vdd_x && mouse_x<eon_vdd_x+eon_vdd_w && mouse_y>=eon_vdd_ry && mouse_y<eon_vdd_ry+eon_vdd_rh) ? (
      gfx_set(0.10,0.26,0.35,1.0); gfx_rect(eon_vdd_x+1, eon_vdd_ry, eon_vdd_w-2, eon_vdd_rh);   // teal hover row
      gfx_set(0.95,0.97,1.0,1.0);
    ) : (
      (slider17|0)==eon_vdd_i ? gfx_set(0.10,0.30,0.40,1.0) : gfx_set(0.16,0.14,0.10,1.0);       // current=teal, else dark
    );
    gfx_setfont(7,"Verdana",12); gfx_x=eon_vdd_x+22; gfx_y=eon_vdd_ry+3;
    gfx_drawstr(eon_vdd_i==0?"Off":eon_vdd_i==1?"Piano":eon_vdd_i==2?"Pads 8":eon_vdd_i==3?"Pads 16":"Manual");
    (slider17|0)==eon_vdd_i ? ( gfx_set(0.10,0.30,0.40,1.0); gfx_circle(eon_vdd_x+11, (eon_vdd_ry+eon_vdd_rh*0.5)|0, 3, 1, 1); );  // current dot
    eon_vdd_i+=1;
  );
  gfx_setfont(0);
);

// EON: THEME dropdown panel — drawn by the shared rk_theme_picker.jsfx-inc
// (rkth_overlay_draw): all themes, current marked, scrollbar only if the list ever
// exceeds the visible count. Selection / scroll handled early via rkth_input.
colorscheme==10 ? ( rkth_overlay_draw(); gfx_setfont(0); );

// EON: PAIR dropdown panel (cream, Swing-style) -- row 0 = Auto (same track), then one
// row per live Swing from the bridge-published roster; current row marked teal + dot.
// Selection handled early (eon_prdd block); geometry computed there each frame.
eon_prdd_open ? (
  gfx_set(0,0,0,0.30);         gfx_rect(eon_prdd_x+3, eon_prdd_y+4, eon_prdd_w, eon_prdd_h);   // shadow
  gfx_set(0.84,0.81,0.76,1.0); gfx_rect(eon_prdd_x, eon_prdd_y, eon_prdd_w, eon_prdd_h);       // cream panel
  gfx_set(0.40,0.37,0.32,1.0); gfx_rect(eon_prdd_x, eon_prdd_y, eon_prdd_w, eon_prdd_h, 0);    // border
  eon_prrow = 0; eon_prr = 0; eon_pri = 0;
  while(eon_prrow < eon_prdd_n) (
    eon_prry = eon_prdd_y + eon_prrow*eon_prdd_rh;
    // resolve this row's registry slot (-1 = the Auto row)
    eon_prslot = -1;
    eon_prrow > 0 ? (
      while(eon_pri < GS_SS_ROSTER_MAX && eon_prslot < 0) (
        gmem[GS_SS_ROSTER_BASE + eon_pri*GS_SS_ROSTER_STRIDE] > 0 ? eon_prslot = eon_pri;
        eon_pri += 1;
      );
    );
    eon_prcur = eon_prrow == 0 ? !eon_pair_manual : (eon_pair_manual && eon_prslot == eon_pair_slot);
    (mouse_x>=eon_prdd_x && mouse_x<eon_prdd_x+eon_prdd_w && mouse_y>=eon_prry && mouse_y<eon_prry+eon_prdd_rh) ? (
      gfx_set(0.10,0.26,0.35,1.0); gfx_rect(eon_prdd_x+1, eon_prry, eon_prdd_w-2, eon_prdd_rh);   // teal hover row
      gfx_set(0.95,0.97,1.0,1.0);
    ) : (
      eon_prcur ? gfx_set(0.10,0.30,0.40,1.0) : gfx_set(0.16,0.14,0.10,1.0);                       // current=teal, else dark
    );
    gfx_setfont(7,"Verdana",12); gfx_x=eon_prdd_x+22; gfx_y=eon_prry+3;
    eon_prrow == 0 ? gfx_drawstr("Auto (same track)") : (
      eon_roster_label(eon_prslot, #eon_prbtn, 14);
      strlen(#eon_prbtn) ? gfx_drawstr(#eon_prbtn) : gfx_drawnumber(eon_prslot+1, 0);
    );
    eon_prcur ? ( gfx_set(0.10,0.30,0.40,1.0); gfx_circle(eon_prdd_x+11, (eon_prry+eon_prdd_rh*0.5)|0, 3, 1, 1); );  // current dot
    eon_prrow += 1;
  );
  gfx_setfont(0);
);

// EON GROOVE menu panel (cream, PAIR-style). Rows = builtin grooves, loaded user slots,
// then (master menu) the Vel-accent cycler. Selection handled EARLY (eon_gdd block);
// geometry computed there each frame.
eon_gdd_open ? (
  gfx_set(0,0,0,0.30);         gfx_rect(eon_gdd_x+3, eon_gdd_y+4, eon_gdd_w, eon_gdd_h);   // shadow
  gfx_set(0.84,0.81,0.76,1.0); gfx_rect(eon_gdd_x, eon_gdd_y, eon_gdd_w, eon_gdd_h);       // cream panel
  gfx_set(0.40,0.37,0.32,1.0); gfx_rect(eon_gdd_x, eon_gdd_y, eon_gdd_w, eon_gdd_h, 0);    // border
  gfx_set(0.55,0.51,0.44,0.8); gfx_rect(eon_gdd_x+eon_gdd_cw, eon_gdd_y, 1, eon_gdd_h);    // column divider
  eon_gcur_slot = eon_gdd_lane >= 0 ? lane_groove[eon_gdd_lane]|0 : master_groove|0;
  eon_gcur_str  = eon_gdd_lane >= 0 ? lane_swing[eon_gdd_lane]|0 : swing_p|0;
  gfx_setfont(7,"Verdana",12);
  // LEFT column: shapes (0..8), ALL 7 user slots (rows 9..15 == slot ids; empty greyed),
  // then (master) the Vel-accent row, then Import.
  eon_grow = 0;
  while(eon_grow < eon_gdd_nl) (
    eon_gry = eon_gdd_y + eon_grow*eon_gdd_rh;
    eon_grslot = -1; eon_gisvel = 0; eon_gisimp = 0; eon_gempty = 0;
    eon_grow < 9 ? eon_grslot = eon_grow :
    eon_grow < 16 ? (
      (groove_slots[eon_grow*GROOVE_STRIDE + 145]&1) ? eon_grslot = eon_grow : eon_gempty = eon_grow - 8;   // 1..7
    ) :
    eon_grow == eon_gdd_nl - 1 ? eon_gisimp = 1 : eon_gisvel = 1;
    eon_gcur = eon_grslot >= 0 && eon_grslot == eon_gcur_slot;
    (mouse_x>=eon_gdd_x && mouse_x<eon_gdd_x+eon_gdd_cw && mouse_y>=eon_gry && mouse_y<eon_gry+eon_gdd_rh) ? (
      gfx_set(0.10,0.26,0.35,1.0); gfx_rect(eon_gdd_x+1, eon_gry, eon_gdd_cw-2, eon_gdd_rh);   // teal hover row
      gfx_set(0.95,0.97,1.0,1.0);
    ) : (
      eon_gcur ? gfx_set(0.10,0.30,0.40,1.0) : gfx_set(0.16,0.14,0.10,1.0);                    // current=teal, else dark
    );
    gfx_x=eon_gdd_x+22; gfx_y=eon_gry+3;
    eon_gempty > 0 ? (
      gfx_set(0.52,0.49,0.44,1.0);                         // greyed: click = import into this slot
      gfx_printf("empty slot %d...", eon_gempty);
    ) : eon_gisimp ? (
      gfx_drawstr("Import grooves...");
    ) : eon_gisvel ? (
      eon_gvv = groove_vel_amt_p1 > 0 ? groove_vel_amt_p1 - 1 : 100;
      gfx_printf("Vel accent %d%%", eon_gvv);
    ) : eon_grslot == 0 ? gfx_drawstr("Swing (classic)") : (
      grv_name(#grv_rn, eon_grslot, 14);
      strlen(#grv_rn) ? gfx_drawstr(#grv_rn) : gfx_drawnumber(eon_grslot, 0);
    );
    eon_gcur ? ( gfx_set(0.10,0.30,0.40,1.0); gfx_circle(eon_gdd_x+11, (eon_gry+eon_gdd_rh*0.5)|0, 3, 1, 1); );  // current dot
    eon_grow += 1;
  );
  // RIGHT column: the machine ladder snaps (current when shape + exact strength match)
  eon_grow = 0;
  while(eon_grow < grv_snap_n) (
    eon_gry = eon_gdd_y + eon_grow*eon_gdd_rh;
    eon_gcur = (grv_snaps[eon_grow*4+2]|0) == eon_gcur_slot && (grv_snaps[eon_grow*4+3]|0) == eon_gcur_str;
    (mouse_x>=eon_gdd_x+eon_gdd_cw && mouse_x<eon_gdd_x+eon_gdd_w && mouse_y>=eon_gry && mouse_y<eon_gry+eon_gdd_rh) ? (
      gfx_set(0.10,0.26,0.35,1.0); gfx_rect(eon_gdd_x+eon_gdd_cw+1, eon_gry, eon_gdd_cw-2, eon_gdd_rh);
      gfx_set(0.95,0.97,1.0,1.0);
    ) : (
      eon_gcur ? gfx_set(0.10,0.30,0.40,1.0) : gfx_set(0.16,0.14,0.10,1.0);
    );
    gfx_x=eon_gdd_x+eon_gdd_cw+22; gfx_y=eon_gry+3;
    eon_gml = grv_snaps[eon_grow*4]|0;
    strcpy(#grv_ml, eon_gml == 0 ? "MPC" : (eon_gml == 1 ? "SP-1200" : (eon_gml == 2 ? "Korg DDD-1" : "Triplet")));
    gfx_printf("%s %d%%", #grv_ml, grv_snaps[eon_grow*4+1]|0);
    eon_gcur ? ( gfx_set(0.10,0.30,0.40,1.0); gfx_circle(eon_gdd_x+eon_gdd_cw+11, (eon_gry+eon_gdd_rh*0.5)|0, 3, 1, 1); );
    eon_grow += 1;
  );
  gfx_setfont(0);
);

// EON ICONS picker panel (cream, GROOVE-style). Header = hovered category name,
// Auto row (shows what the lane name resolves to), then the 8x6 glyph grid drawn
// with the DETAILED tier (s=11). Selection handled EARLY (eon_ico block).
eon_ico_open ? (
  gfx_set(0,0,0,0.30);         gfx_rect(eon_ico_x+3, eon_ico_y+4, eon_ico_w, eon_ico_h);   // shadow
  gfx_set(0.84,0.81,0.76,1.0); gfx_rect(eon_ico_x, eon_ico_y, eon_ico_w, eon_ico_h);       // cream panel
  gfx_set(0.40,0.37,0.32,1.0); gfx_rect(eon_ico_x, eon_ico_y, eon_ico_w, eon_ico_h, 0);    // border
  eon_ico_cur  = lane_icon_override[eon_ico_lane]|0;                                        // 0=auto, k>=1 = cat k-1
  eon_ico_auto = eon_cat_for_name(getNotename(basenote+eon_ico_lane+notetranspose[eon_ico_lane], 0));
  // header bar: hovered category name (fallback: panel title)
  gfx_set(0.10,0.26,0.35,1.0); gfx_rect(eon_ico_x, eon_ico_y, eon_ico_w, eon_ico_hh);
  gfx_setfont(7,"Verdana",12,'b'); gfx_set(0.92,0.95,0.97,1.0);
  gfx_x = eon_ico_x+8; gfx_y = eon_ico_y+4;
  eon_ico_hov >= 0 ? ( eon_catname(#eon_icname, eon_ico_hov); gfx_drawstr(#eon_icname); ) :
  eon_ico_hov == -1 ? gfx_drawstr("Auto (match lane name)") :
  eon_ico_hov == PADCAT_NONE ? gfx_drawstr("None (no icon)") : gfx_drawstr("LANE ICON");
  // Auto row (teal hover / current dot, groove-panel discipline)
  gfx_setfont(7,"Verdana",12);
  eon_ico_ay = eon_ico_y + eon_ico_hh;
  eon_ico_hov == -1 ? (
    gfx_set(0.10,0.26,0.35,1.0); gfx_rect(eon_ico_x+1, eon_ico_ay, eon_ico_w-2, eon_ico_ah);
    gfx_set(0.95,0.97,1.0,1.0);
  ) : (
    eon_ico_cur == 0 ? gfx_set(0.10,0.30,0.40,1.0) : gfx_set(0.16,0.14,0.10,1.0);
  );
  gfx_x = eon_ico_x+22; gfx_y = eon_ico_ay+3;
  eon_catname(#eon_icname, eon_ico_auto);
  gfx_printf("Auto (%s)", #eon_icname);
  eon_ico_cur == 0 ? ( gfx_set(0.10,0.30,0.40,1.0); gfx_circle(eon_ico_x+11, (eon_ico_ay+eon_ico_ah*0.5)|0, 3, 1, 1); );
  // 8x6 glyph grid: hover fill, current outline, detailed glyphs
  eon_ico_i = 0;
  loop(46,
    eon_ico_cx0 = eon_ico_gx + (eon_ico_i%eon_ico_cols)*eon_ico_cell;
    eon_ico_cy0 = eon_ico_gy + ((eon_ico_i/eon_ico_cols)|0)*eon_ico_cell;
    eon_ico_i == eon_ico_hov ? ( gfx_set(0.10,0.26,0.35,1.0); gfx_rect(eon_ico_cx0, eon_ico_cy0, eon_ico_cell, eon_ico_cell); );
    eon_ico_cur == eon_ico_i+1 ? ( gfx_set(0.10,0.30,0.40,1.0); gfx_rect(eon_ico_cx0, eon_ico_cy0, eon_ico_cell, eon_ico_cell, 0); );
    eon_draw_cat_glyph(eon_ico_i, (eon_ico_cx0+eon_ico_cell*0.5)|0, (eon_ico_cy0+eon_ico_cell*0.5)|0, 11, eon_ico_i == eon_ico_hov ? 0.2 : 0.8);
    eon_ico_i += 1;
  );
  // Cell 46 = NONE. A struck-through empty circle, not a glyph — it is the
  // absence of one, and any icon here would read as a 47th category.
  eon_ico_cx0 = eon_ico_gx + (46%eon_ico_cols)*eon_ico_cell;
  eon_ico_cy0 = eon_ico_gy + ((46/eon_ico_cols)|0)*eon_ico_cell;
  eon_ico_hov == PADCAT_NONE ? ( gfx_set(0.10,0.26,0.35,1.0); gfx_rect(eon_ico_cx0, eon_ico_cy0, eon_ico_cell, eon_ico_cell); );
  eon_ico_cur == LANE_ICON_NONE ? ( gfx_set(0.10,0.30,0.40,1.0); gfx_rect(eon_ico_cx0, eon_ico_cy0, eon_ico_cell, eon_ico_cell, 0); );
  eon_ico_hov == PADCAT_NONE ? gfx_set(0.92,0.95,0.97,1.0) : gfx_set(0.16,0.14,0.10,0.75);
  gfx_circle(eon_ico_cx0+eon_ico_cell*0.5, eon_ico_cy0+eon_ico_cell*0.5, eon_ico_cell*0.30, 0, 1);
  gfx_line(eon_ico_cx0+eon_ico_cell*0.5 - eon_ico_cell*0.21, eon_ico_cy0+eon_ico_cell*0.5 + eon_ico_cell*0.21,
           eon_ico_cx0+eon_ico_cell*0.5 + eon_ico_cell*0.21, eon_ico_cy0+eon_ico_cell*0.5 - eon_ico_cell*0.21);
  gfx_setfont(0);
);

// EON LANE MENU panel (cream, GROOVE-style). Header = lane name; left column = the
// per-lane ops (group dividers after rows 1/5/10), right column = MIDI-channel
// ladder with a caption row + teal dot on the current channel. Input handled EARLY.
eon_lm_open ? (
  gfx_set(0,0,0,0.30);         gfx_rect(eon_lm_x+3, eon_lm_y+4, eon_lm_w, eon_lm_h);   // shadow
  gfx_set(0.84,0.81,0.76,1.0); gfx_rect(eon_lm_x, eon_lm_y, eon_lm_w, eon_lm_h);       // cream panel
  gfx_set(0.40,0.37,0.32,1.0); gfx_rect(eon_lm_x, eon_lm_y, eon_lm_w, eon_lm_h, 0);    // border
  // header bar: lane name
  gfx_set(0.10,0.26,0.35,1.0); gfx_rect(eon_lm_x, eon_lm_y, eon_lm_w, eon_lm_hh);
  gfx_setfont(7,"Verdana",12,'b'); gfx_set(0.92,0.95,0.97,1.0);
  gfx_x = eon_lm_x+8; gfx_y = eon_lm_y+4;
  gfx_drawstr(getNotename(basenote+eon_lm_lane+notetranspose[eon_lm_lane], 0));
  // column divider
  gfx_set(0.55,0.51,0.44,0.8); gfx_rect(eon_lm_x+eon_lm_cw1, eon_lm_y+eon_lm_hh, 1, eon_lm_h-eon_lm_hh);
  gfx_setfont(7,"Verdana",12);
  // LEFT column: ops rows 0..13
  eon_lm_r = 0;
  loop(14,
    eon_lm_ry = eon_lm_y + eon_lm_hh + eon_lm_r*eon_lm_rh;
    (eon_lm_hcol == 0 && eon_lm_hrow == eon_lm_r) ? (
      gfx_set(0.10,0.26,0.35,1.0); gfx_rect(eon_lm_x+1, eon_lm_ry, eon_lm_cw1-2, eon_lm_rh);   // teal hover row
      gfx_set(0.95,0.97,1.0,1.0);
    ) : (
      (eon_lm_r == 1 && eon_pair_slot >= 0) ? gfx_set(0.52,0.49,0.44,1.0)                      // greyed: pad-bound
                                            : gfx_set(0.16,0.14,0.10,1.0);
    );
    gfx_x = eon_lm_x+10; gfx_y = eon_lm_ry+3;
    eon_lm_rowlbl(#eon_lmn, eon_lm_r);
    gfx_drawstr(#eon_lmn);
    (eon_lm_r == 1 || eon_lm_r == 5 || eon_lm_r == 10) ? (                                     // group dividers
      gfx_set(0.55,0.51,0.44,0.6); gfx_rect(eon_lm_x+6, eon_lm_ry+eon_lm_rh-1, eon_lm_cw1-12, 1);
    );
    eon_lm_r += 1;
  );
  // RIGHT column: caption + channels 1..16
  eon_lm_cur = rowchannel[eon_lm_lane]|0;
  gfx_set(0.42,0.39,0.34,1.0);
  gfx_x = eon_lm_x+eon_lm_cw1+10; gfx_y = eon_lm_y+eon_lm_hh+3; gfx_drawstr("MIDI ch");
  eon_lm_r = 1;
  loop(16,
    eon_lm_ry = eon_lm_y + eon_lm_hh + eon_lm_r*eon_lm_rh;
    (eon_lm_hcol == 1 && eon_lm_hrow == eon_lm_r) ? (
      gfx_set(0.10,0.26,0.35,1.0); gfx_rect(eon_lm_x+eon_lm_cw1+1, eon_lm_ry, eon_lm_cw2-2, eon_lm_rh);
      gfx_set(0.95,0.97,1.0,1.0);
    ) : (
      eon_lm_cur == eon_lm_r-1 ? gfx_set(0.10,0.30,0.40,1.0) : gfx_set(0.16,0.14,0.10,1.0);    // current=teal
    );
    gfx_x = eon_lm_x+eon_lm_cw1+22; gfx_y = eon_lm_ry+3;
    gfx_drawnumber(eon_lm_r, 0);
    eon_lm_cur == eon_lm_r-1 ? ( gfx_set(0.10,0.30,0.40,1.0); gfx_circle(eon_lm_x+eon_lm_cw1+11, (eon_lm_ry+eon_lm_rh*0.5)|0, 3, 1, 1); );
    eon_lm_r += 1;
  );
  gfx_setfont(0);
);

// EON P3b-4f: pattern-tab / pager context menu -- house style (lane-menu clone).
// Header = the pattern's live name from the courier name band (same NAMEPAGE
// gate the tabs use; falls back to "PATTERN N"), or "PATTERNS" on the pager.
// The Change color row wears a right-aligned swatch of the region's CURRENT
// colour (RGNCOL window, same cells the tab chips read). Divider before the
// last row of both kinds (destructive Delete / New pattern).
eon_pm_open ? (
  // OPEN-frame geometry: the early block ran before the opener this frame, so
  // recompute the kind-derived metrics here -- otherwise the first frame paints
  // the PREVIOUS panel's size (first-ever open: invisible; kind switch: cropped).
  eon_pm_hh = 22; eon_pm_rh = 19;
  eon_pm_n = eon_pm_kind == 3 ? 9 : eon_pm_kind == 4 ? 2 : eon_pm_kind == 5 ? 4 : 3;
  eon_pm_w = eon_pm_kind == 5 ? 190 : 150;
  eon_pm_h = eon_pm_hh + eon_pm_n*eon_pm_rh;
  gfx_set(0,0,0,0.30);         gfx_rect(eon_pm_x+3, eon_pm_y+4, eon_pm_w, eon_pm_h);   // shadow
  gfx_set(0.84,0.81,0.76,1.0); gfx_rect(eon_pm_x, eon_pm_y, eon_pm_w, eon_pm_h);       // cream panel
  gfx_set(0.40,0.37,0.32,1.0); gfx_rect(eon_pm_x, eon_pm_y, eon_pm_w, eon_pm_h, 0);    // border
  gfx_set(0.10,0.26,0.35,1.0); gfx_rect(eon_pm_x, eon_pm_y, eon_pm_w, eon_pm_hh);      // teal header
  gfx_setfont(7,"Verdana",12,'b'); gfx_set(0.92,0.95,0.97,1.0);
  gfx_x = eon_pm_x+8; gfx_y = eon_pm_y+4;
  eon_pm_kind == 1 ? (
    strcpy(#eon_pmt, "");
    (eon_pm_btn >= 0 && eon_pm_btn < 8
     && (gmem[EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE + EON_SS_SYNC_NAMEPAGE]|0) == eon_pat_base + 1) ? (
      eon_rgnname(eon_pm_btn, #eon_pmt, 18);
    );
    strlen(#eon_pmt) == 0 ? sprintf(#eon_pmt, "PATTERN %d", eon_pm_ord);
    gfx_drawstr(#eon_pmt);
  ) :
  eon_pm_kind == 3 ? (
    strcpy(#eon_pmt, "");
    eon_pm_btn >= 0 ? eon_songname(eon_pm_btn, #eon_pmt, 16);
    strlen(#eon_pmt) == 0 ? sprintf(#eon_pmt, "ENTRY %d", eon_pm_ord);
    gfx_drawstr(#eon_pmt);
  ) : (
    gfx_drawstr(eon_pm_kind == 2 ? "PATTERNS" : eon_pm_kind == 4 ? "SONG" : "GRID");
  );
  // current-item row: song chip = its live repeat count; grid = live steps_per_beat
  eon_pm_cur = -1;
  eon_pm_kind == 3 && eon_pm_btn >= 0 ? (
    eon_pm_rep = (gmem[eon_sg_b + 8 + eon_pm_btn*2]|0)/256|0; eon_pm_rep < 1 ? eon_pm_rep = 1;
    eon_pm_cur = eon_pm_rep <= 4 ? eon_pm_rep - 1 : eon_pm_rep == 6 ? 4 : eon_pm_rep == 8 ? 5 : -1;
  );
  eon_pm_kind == 5 ? (
    eon_pm_cur = steps_per_beat == 4 ? 0 : steps_per_beat == 3 ? 1 :
                 steps_per_beat == 8 ? 2 : steps_per_beat == 6 ? 3 : -1;
  );
  eon_pm_tx = eon_pm_cur >= 0 ? 20 : 10;   // dot gutter only on kinds that mark a current row
  gfx_setfont(7,"Verdana",12);
  eon_pm_r = 0;
  loop(eon_pm_n,
    eon_pm_ry = eon_pm_y + eon_pm_hh + eon_pm_r*eon_pm_rh;
    eon_pm_hrow == eon_pm_r ? (
      gfx_set(0.10,0.26,0.35,1.0); gfx_rect(eon_pm_x+1, eon_pm_ry, eon_pm_w-2, eon_pm_rh);   // teal hover row
      gfx_set(0.95,0.97,1.0,1.0);
    ) : (
      (eon_pm_kind == 1 && eon_pm_r == 2
       && (gmem[EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE + EON_SS_SYNC_DM_RGNCNT]|0) < eon_pm_ord)
        ? gfx_set(0.52,0.49,0.44,1.0)      // greyed: no region behind this tab yet (lane-menu grey)
      : eon_pm_r == eon_pm_cur
        ? gfx_set(0.10,0.30,0.40,1.0)      // current = teal text (lane-menu channel idiom)
        : gfx_set(0.16,0.14,0.10,1.0);
    );
    gfx_x = eon_pm_x+eon_pm_tx; gfx_y = eon_pm_ry+3;
    eon_pm_rowlbl(#eon_pmn, eon_pm_kind, eon_pm_r);
    gfx_drawstr(#eon_pmn);
    eon_pm_r == eon_pm_cur ? (
      gfx_set(0.10,0.30,0.40,1.0);
      gfx_circle(eon_pm_x+11, (eon_pm_ry+eon_pm_rh*0.5)|0, 3, 1, 1);
    );
    // current-colour swatch on the Change color row (packed r*65536+g*256+b; 0 = unpublished)
    (eon_pm_kind == 1 && eon_pm_r == 1 && eon_pm_btn >= 0) ? (
      eon_pm_pc = gmem[EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE + EON_SS_SYNC_RGNCOL + eon_pm_btn]|0;
      eon_pm_pc > 0 ? (
        gfx_set(((eon_pm_pc/65536)|0)/255, (((eon_pm_pc/256)|0)%256)/255, (eon_pm_pc%256)/255, 1.0);
        gfx_rect(eon_pm_x+eon_pm_w-19, eon_pm_ry+5, 9, 9);
        gfx_set(0.40,0.37,0.32,0.9); gfx_rect(eon_pm_x+eon_pm_w-19, eon_pm_ry+5, 9, 9, 0);
      );
    );
    // group dividers: k3 after Repeats-8 and Remove; k4 none; others before last row
    (eon_pm_kind == 3 ? (eon_pm_r == 5 || eon_pm_r == 6)
     : eon_pm_kind == 4 ? 0 : eon_pm_r == 1) ? (
      gfx_set(0.55,0.51,0.44,0.6); gfx_rect(eon_pm_x+6, eon_pm_ry+eon_pm_rh-1, eon_pm_w-12, 1);
    );
    eon_pm_r += 1;
  );
  gfx_setfont(0);
);

eon_so_open ? (
  eon_so_click = (mouse_cap&1) && !eon_so_clk_last;

  gfx_set(0,0,0,0.30); gfx_rect(eon_so_x+5, eon_so_y+6, eon_so_w, eon_so_h);     // shadow
  gfx_set(0.84,0.81,0.76,1.0); gfx_rect(eon_so_x, eon_so_y, eon_so_w, eon_so_h); // cream panel
  gfx_set(0.10,0.26,0.35,1.0); gfx_rect(eon_so_x, eon_so_y, eon_so_w, 26);       // teal title bar
  gfx_set(0.55,0.51,0.44,1.0); gfx_rect(eon_so_x, eon_so_y+eon_so_h-1, eon_so_w, 1);

  gfx_setfont(7,"Verdana",13,'b'); gfx_set(0.92,0.95,0.97,1);
  gfx_x=eon_so_x+12; gfx_y=eon_so_y+6; gfx_drawstr("SETTINGS");
  eon_so_bx=eon_so_x+eon_so_w-24; eon_so_by=eon_so_y+5;
  gfx_x=eon_so_bx+5; gfx_y=eon_so_by+1; gfx_drawstr("X");
  (eon_so_click && mouse_x>=eon_so_bx && mouse_x<eon_so_bx+20 && mouse_y>=eon_so_by && mouse_y<eon_so_by+18) ? (settingsopen=0; refresh_tb=1;);

  gfx_setfont(7,"Verdana",12);
  eon_so_ry=eon_so_y+36; eon_so_lx=eon_so_x+14; eon_so_cx=eon_so_x+150;

  // (Theme cycler removed -- EON is the Swing-matched theme; EON variants TBD later)

  // Piano Octaves (- N +)
  gfx_set(0.14,0.16,0.14,1); gfx_x=eon_so_lx; gfx_y=eon_so_ry+4; gfx_drawstr("Piano Octaves");
  gfx_set(0.20,0.22,0.20,1); gfx_rect(eon_so_cx, eon_so_ry, 24, 22);
  gfx_set(0.92,0.94,0.90,1); gfx_x=eon_so_cx+9; gfx_y=eon_so_ry+5; gfx_drawstr("-");
  gfx_set(0.14,0.16,0.14,1); gfx_x=eon_so_cx+40; gfx_y=eon_so_ry+5; gfx_drawnumber(max(1,min(6,slider16|0)),0);
  gfx_set(0.20,0.22,0.20,1); gfx_rect(eon_so_cx+62, eon_so_ry, 24, 22);
  gfx_set(0.92,0.94,0.90,1); gfx_x=eon_so_cx+69; gfx_y=eon_so_ry+5; gfx_drawstr("+");
  (eon_so_click && mouse_y>=eon_so_ry && mouse_y<eon_so_ry+22) ? (
    mouse_x>=eon_so_cx && mouse_x<eon_so_cx+24 ? (sliderchange(slider16 = max(1,(slider16|0)-1));) :
    mouse_x>=eon_so_cx+62 && mouse_x<eon_so_cx+86 ? (sliderchange(slider16 = min(6,(slider16|0)+1)););
    refresh_tb=1; refresh_pianokeys=1;
  );
  eon_so_ry+=30;

  // Rate (- value +)
  gfx_set(0.14,0.16,0.14,1); gfx_x=eon_so_lx; gfx_y=eon_so_ry+4; gfx_drawstr("Rate");
  gfx_set(0.20,0.22,0.20,1); gfx_rect(eon_so_cx, eon_so_ry, 24, 22);
  gfx_set(0.92,0.94,0.90,1); gfx_x=eon_so_cx+9; gfx_y=eon_so_ry+5; gfx_drawstr("-");
  gfx_set(0.14,0.16,0.14,1); gfx_x=eon_so_cx+32; gfx_y=eon_so_ry+5; gfx_drawnumber(rate,3);
  gfx_set(0.20,0.22,0.20,1); gfx_rect(eon_so_cx+78, eon_so_ry, 24, 22);
  gfx_set(0.92,0.94,0.90,1); gfx_x=eon_so_cx+85; gfx_y=eon_so_ry+5; gfx_drawstr("+");
  (eon_so_click && mouse_y>=eon_so_ry && mouse_y<eon_so_ry+22) ? (
    mouse_x>=eon_so_cx && mouse_x<eon_so_cx+24 ? (rate=max(0.125,rate-0.125); sliderchange(slider5=rate);) :
    mouse_x>=eon_so_cx+78 && mouse_x<eon_so_cx+102 ? (rate=min(4.0,rate+0.125); sliderchange(slider5=rate););
  );
  eon_so_ry+=30;

  // MIDI Mode (cycle)
  gfx_set(0.14,0.16,0.14,1); gfx_x=eon_so_lx; gfx_y=eon_so_ry+4; gfx_drawstr("MIDI Mode");
  gfx_set(0.16,0.34,0.42,1); gfx_rect(eon_so_cx, eon_so_ry, 200, 22);
  gfx_set(0.90,0.95,0.97,1); gfx_x=eon_so_cx+8; gfx_y=eon_so_ry+5;
  gfx_drawstr(midi_trigger==0?"Off":midi_trigger==1?"Pattern":midi_trigger==2?"Pat + Transpose":midi_trigger==3?"Pat + Resync":midi_trigger==4?"Pat+Trans+Resync":midi_trigger==5?"Pat+Resync Q":"Pat+Trans+Resync Q");
  (eon_so_click && mouse_x>=eon_so_cx && mouse_x<eon_so_cx+200 && mouse_y>=eon_so_ry && mouse_y<eon_so_ry+22) ? (
    midi_trigger = (midi_trigger>=6 ? 0 : midi_trigger+1); sliderchange(slider10=midi_trigger);
  );
  eon_so_ry+=30;

  // Trig Note (- value +)
  gfx_set(0.14,0.16,0.14,1); gfx_x=eon_so_lx; gfx_y=eon_so_ry+4; gfx_drawstr("Trig Note");
  gfx_set(0.20,0.22,0.20,1); gfx_rect(eon_so_cx, eon_so_ry, 24, 22);
  gfx_set(0.92,0.94,0.90,1); gfx_x=eon_so_cx+9; gfx_y=eon_so_ry+5; gfx_drawstr("-");
  gfx_set(0.14,0.16,0.14,1); gfx_x=eon_so_cx+36; gfx_y=eon_so_ry+5; gfx_drawnumber(trig_note_start,0);
  gfx_set(0.20,0.22,0.20,1); gfx_rect(eon_so_cx+78, eon_so_ry, 24, 22);
  gfx_set(0.92,0.94,0.90,1); gfx_x=eon_so_cx+85; gfx_y=eon_so_ry+5; gfx_drawstr("+");
  (eon_so_click && mouse_y>=eon_so_ry && mouse_y<eon_so_ry+22) ? (
    mouse_x>=eon_so_cx && mouse_x<eon_so_cx+24 ? (trig_note_start=max(0,trig_note_start-1); sliderchange(slider11=trig_note_start);) :
    mouse_x>=eon_so_cx+78 && mouse_x<eon_so_cx+102 ? (trig_note_start=min(127,trig_note_start+1); sliderchange(slider11=trig_note_start););
  );
  eon_so_ry+=30;

  // Base Note (- value +)
  gfx_set(0.14,0.16,0.14,1); gfx_x=eon_so_lx; gfx_y=eon_so_ry+4; gfx_drawstr("Base Note");
  gfx_set(0.20,0.22,0.20,1); gfx_rect(eon_so_cx, eon_so_ry, 24, 22);
  gfx_set(0.92,0.94,0.90,1); gfx_x=eon_so_cx+9; gfx_y=eon_so_ry+5; gfx_drawstr("-");
  gfx_set(0.14,0.16,0.14,1); gfx_x=eon_so_cx+36; gfx_y=eon_so_ry+5; gfx_drawnumber(basenote,0);
  gfx_set(0.20,0.22,0.20,1); gfx_rect(eon_so_cx+78, eon_so_ry, 24, 22);
  gfx_set(0.92,0.94,0.90,1); gfx_x=eon_so_cx+85; gfx_y=eon_so_ry+5; gfx_drawstr("+");
  (eon_so_click && mouse_y>=eon_so_ry && mouse_y<eon_so_ry+22) ? (
    mouse_x>=eon_so_cx && mouse_x<eon_so_cx+24 ? (basenote=max(0,basenote-1); sliderchange(slider2=basenote); refresh_tb=1; refresh_pianokeys=1;) :
    mouse_x>=eon_so_cx+78 && mouse_x<eon_so_cx+102 ? (basenote=min(127,basenote+1); sliderchange(slider2=basenote); refresh_tb=1; refresh_pianokeys=1;);
  );
  eon_so_ry+=30;

  // Sync (Drum Matrix) — toggle slider49. When ON + paired, the StepSeq <-> Drum
  // Matrix courier imports the current DM region into the active pattern.
  gfx_set(0.14,0.16,0.14,1); gfx_x=eon_so_lx; gfx_y=eon_so_ry+4; gfx_drawstr("Sync (DM)");
  eon_sync_mode ? gfx_set(0.18,0.45,0.28,1) : gfx_set(0.22,0.24,0.22,1);
  gfx_rect(eon_so_cx, eon_so_ry, 200, 22);
  gfx_set(0.90,0.95,0.97,1); gfx_x=eon_so_cx+8; gfx_y=eon_so_ry+5;
  gfx_drawstr(eon_sync_mode ? (eon_pair_slot>=0 ? "On (paired)" : "On - pair a Swing") : "Off");
  (eon_so_click && mouse_x>=eon_so_cx && mouse_x<eon_so_cx+200 && mouse_y>=eon_so_ry && mouse_y<eon_so_ry+22) ? (
    eon_sync_mode = eon_sync_mode ? 0 : 1;
    sliderchange(slider49=eon_sync_mode);
  );
  eon_so_ry+=30;

  // Sync on by default (MACHINE-WIDE, bridge-persisted via ExtState): fresh
  // StepSeq instances now ship with slider49 ON (insert and go, bridge or not);
  // this option makes an explicit Off stick — the bridge pushes the machine
  // default (on OR off) onto a fresh instance at its first pairing. Mirror =
  // sync-band fields 49-51 (values + set-request); bridge republishes per tick.
  eon_so_b = eon_pair_slot >= 0 ? EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE : -1;
  eon_opt_so = eon_so_b >= 0 && gmem[eon_so_b + EON_SS_SYNC_OPT_SO] > 0.5;
  gfx_set(0.14,0.16,0.14,1); gfx_x=eon_so_lx; gfx_y=eon_so_ry+4; gfx_drawstr("Sync on by default");
  eon_so_b >= 0 ? (eon_opt_so ? gfx_set(0.18,0.45,0.28,1) : gfx_set(0.22,0.24,0.22,1)) : gfx_set(0.18,0.19,0.19,1);
  gfx_rect(eon_so_cx, eon_so_ry, 200, 22);
  gfx_set(0.90,0.95,0.97,1); gfx_x=eon_so_cx+8; gfx_y=eon_so_ry+5;
  gfx_drawstr(eon_so_b >= 0 ? (eon_opt_so ? "On (new instances)" : "Off") : "(pair a Swing)");
  (eon_so_click && eon_so_b >= 0 && mouse_x>=eon_so_cx && mouse_x<eon_so_cx+200 && mouse_y>=eon_so_ry && mouse_y<eon_so_ry+22) ? (
    gmem[eon_so_b + EON_SS_SYNC_OPT_SO]  = eon_opt_so ? 0 : 1;
    gmem[eon_so_b + EON_SS_SYNC_OPT_REQ] = gmem[eon_so_b + EON_SS_SYNC_OPT_REQ] + 1;
  );
  eon_so_ry+=30;

  // Zoom on select (MACHINE-WIDE, bridge-persisted): selecting a pattern in
  // sync mode navigates the arrange to its region (JumpTo + loop-point
  // highlight). Off = the arrange stays put; the courier still re-imports.
  eon_opt_az = eon_so_b >= 0 && gmem[eon_so_b + EON_SS_SYNC_OPT_AZ] > 0.5;
  gfx_set(0.14,0.16,0.14,1); gfx_x=eon_so_lx; gfx_y=eon_so_ry+4; gfx_drawstr("Zoom on select");
  eon_so_b >= 0 ? (eon_opt_az ? gfx_set(0.18,0.45,0.28,1) : gfx_set(0.22,0.24,0.22,1)) : gfx_set(0.18,0.19,0.19,1);
  gfx_rect(eon_so_cx, eon_so_ry, 200, 22);
  gfx_set(0.90,0.95,0.97,1); gfx_x=eon_so_cx+8; gfx_y=eon_so_ry+5;
  gfx_drawstr(eon_so_b >= 0 ? (eon_opt_az ? "On (frame pattern region)" : "Off") : "(pair a Swing)");
  (eon_so_click && eon_so_b >= 0 && mouse_x>=eon_so_cx && mouse_x<eon_so_cx+200 && mouse_y>=eon_so_ry && mouse_y<eon_so_ry+22) ? (
    gmem[eon_so_b + EON_SS_SYNC_OPT_AZ]  = eon_opt_az ? 0 : 1;
    gmem[eon_so_b + EON_SS_SYNC_OPT_REQ] = gmem[eon_so_b + EON_SS_SYNC_OPT_REQ] + 1;
  );
  eon_so_ry+=30;

  // Auto-adapt patterns (MACHINE-WIDE, bridge-persisted, DEFAULT OFF): when a
  // kit load re-arranges pad jobs, apply the ③ ADAPT lane permutation
  // automatically — no chip, works with the GUI closed. Off = the chip flow
  // (click applies, right-click dismisses). Enabling this never consumes an
  // already-lit chip (the @block engine auto-fires on FRESH arms only).
  eon_opt_aa = eon_so_b >= 0 && gmem[eon_so_b + EON_SS_SYNC_OPT_AA] > 0.5;
  gfx_set(0.14,0.16,0.14,1); gfx_x=eon_so_lx; gfx_y=eon_so_ry+4; gfx_drawstr("Auto-adapt patterns");
  eon_so_b >= 0 ? (eon_opt_aa ? gfx_set(0.18,0.45,0.28,1) : gfx_set(0.22,0.24,0.22,1)) : gfx_set(0.18,0.19,0.19,1);
  gfx_rect(eon_so_cx, eon_so_ry, 200, 22);
  gfx_set(0.90,0.95,0.97,1); gfx_x=eon_so_cx+8; gfx_y=eon_so_ry+5;
  gfx_drawstr(eon_so_b >= 0 ? (eon_opt_aa ? "On (kit loads re-aim)" : "Off") : "(pair a Swing)");
  (eon_so_click && eon_so_b >= 0 && mouse_x>=eon_so_cx && mouse_x<eon_so_cx+200 && mouse_y>=eon_so_ry && mouse_y<eon_so_ry+22) ? (
    gmem[eon_so_b + EON_SS_SYNC_OPT_AA]  = eon_opt_aa ? 0 : 1;
    gmem[eon_so_b + EON_SS_SYNC_OPT_REQ] = gmem[eon_so_b + EON_SS_SYNC_OPT_REQ] + 1;
  );
  eon_so_ry+=30;

  // Grid Lines (on/off) — beat lines + per-lane tinted separators. Purely visual,
  // so unlike the sync options above it needs no pairing and no gmem round-trip.
  gfx_set(0.14,0.16,0.14,1); gfx_x=eon_so_lx; gfx_y=eon_so_ry+4; gfx_drawstr("Grid lines");
  eon_gridlines ? gfx_set(0.18,0.45,0.28,1) : gfx_set(0.22,0.24,0.22,1);
  gfx_rect(eon_so_cx, eon_so_ry, 200, 22);
  gfx_set(0.90,0.95,0.97,1); gfx_x=eon_so_cx+8; gfx_y=eon_so_ry+5;
  gfx_drawstr(eon_gridlines ? "On (beat + lane lines)" : "Off");
  (eon_so_click && mouse_x>=eon_so_cx && mouse_x<eon_so_cx+200 && mouse_y>=eon_so_ry && mouse_y<eon_so_ry+22) ? (
    // Working global first, then the slider — same reason as the column toggles.
    eon_gridlines = eon_gridlines ? 0 : 1;
    sliderchange(slider50 = eon_gridlines);
    refresh_pianokeys = 1; eon_pdraw = max(eon_pdraw, 2);
  );
  eon_so_ry+=30;

  // Lane columns — seven inline letter toggles rather than seven rows, which would
  // have cost 210px of panel height. Order matches the header left-to-right so the
  // control reads as a picture of the thing it edits.
  //   I icon · N name · M mute · S solo · V vol · P pan · W swing
  gfx_set(0.14,0.16,0.14,1); gfx_x=eon_so_lx; gfx_y=eon_so_ry+4; gfx_drawstr("Lane columns");
  eon_so_ci = 0;
  loop(7,
    eon_so_cbx = eon_so_cx + eon_so_ci*28;
    eon_so_cbit = 2^eon_so_ci;
    // Amber = PINNED: the last of the icon/name pair, which cannot be turned off.
    // Same language as the column-header strip so the two surfaces agree.
    eon_so_pin = (eon_so_ci < 2) && ((eon_colvis & 3) != 3) && (eon_colvis & eon_so_cbit);
    eon_so_pin ? gfx_set(0.34,0.28,0.13,1)
      : (eon_colvis & eon_so_cbit) ? gfx_set(0.18,0.45,0.28,1) : gfx_set(0.22,0.24,0.22,1);
    gfx_rect(eon_so_cbx, eon_so_ry, 24, 22);
    eon_so_pin ? gfx_set(0.98,0.84,0.45,1)
      : (eon_colvis & eon_so_cbit) ? gfx_set(0.90,0.95,0.97,1) : gfx_set(0.55,0.57,0.55,1);
    gfx_x = eon_so_cbx+8; gfx_y = eon_so_ry+5;
    gfx_drawchar(eon_so_ci==0 ? $'I' : eon_so_ci==1 ? $'N' : eon_so_ci==2 ? $'M' :
                 eon_so_ci==3 ? $'S' : eon_so_ci==4 ? $'V' : eon_so_ci==5 ? $'P' : $'W');
    (eon_so_click && mouse_x>=eon_so_cbx && mouse_x<eon_so_cbx+24 && mouse_y>=eon_so_ry && mouse_y<eon_so_ry+22) ? (
      // Explicit add/subtract rather than an XOR: EEL2 does use `~` for binary XOR,
      // but it appears nowhere else in this codebase, and an operator whose
      // semantics can't be confirmed from in-tree precedent is not worth the risk
      // on a bitmask that decides whether the UI draws at all.
      eon_so_new = (eon_colvis & eon_so_cbit) ? eon_colvis - eon_so_cbit : eon_colvis + eon_so_cbit;
      // Enforce the icon/name pair here too, not just in eon_colvis_apply: clicking
      // the second of the two should visibly refuse rather than silently snap back
      // on the next slider pass.
      (eon_so_new & 3) == 0 ? eon_so_new = eon_colvis;
      // Working global first, then the slider — see the column-strip click for why.
      eon_colvis = eon_so_new;
      sliderchange(slider51 = eon_so_new);
      eon_colvis_apply();
      refresh_tb=1; refresh_pianokeys=1; eon_pdraw = max(eon_pdraw, 2);
    );
    eon_so_ci += 1;
  );
  eon_so_ry+=30;

  // Region (DM): which DM region the ACTIVE pattern syncs against. AUTO maps the active
  // pattern index -> the (p+1)th region by start time (so switching pattern follows
  // regions for free); clicking cycles Auto -> 1 .. count -> Auto to PIN a specific
  // ordinal (per pattern, persisted). The courier publishes the live region count
  // (DM_RGNCNT) so the cycle clamps to what exists; count 0 leaves only Auto. This
  // replaces the old cursor-parked region pick. Re-toggle Sync (or click Export) to
  // act on the new target.
  eon_rgn_cnt = (eon_pair_slot>=0) ? (gmem[EON_SS_SYNC_BASE + eon_pair_slot*EON_SS_SYNC_STRIDE + EON_SS_SYNC_DM_RGNCNT]|0) : 0;
  eon_rgn_sel = eon_region_override[p]|0;
  gfx_set(0.14,0.16,0.14,1); gfx_x=eon_so_lx; gfx_y=eon_so_ry+4; gfx_drawstr("Region (DM)");
  gfx_set(0.16,0.34,0.42,1); gfx_rect(eon_so_cx, eon_so_ry, 200, 22);
  gfx_set(0.90,0.95,0.97,1); gfx_x=eon_so_cx+8; gfx_y=eon_so_ry+5;
  eon_rgn_sel<1 ? (
    gfx_drawstr("Auto -> R"); gfx_drawnumber(p+1,0);
  ) : (
    gfx_drawstr("Region "); gfx_drawnumber(eon_rgn_sel,0);
  );
  (eon_so_click && mouse_x>=eon_so_cx && mouse_x<eon_so_cx+200 && mouse_y>=eon_so_ry && mouse_y<eon_so_ry+22) ? (
    eon_rgn_sel += 1;
    eon_rgn_sel > eon_rgn_cnt ? eon_rgn_sel = 0;   // wrap (cnt = 0 -> only Auto)
    eon_region_override[p] = eon_rgn_sel;
  );
  eon_so_ry+=30;

  // Grid feel: flip the active pattern between STRAIGHT (4 steps/beat) and TRIPLET-capable
  // (12/beat). 12 holds straight 16ths (every 3rd cell) + 8th-triplets (every 4th) +
  // 16th-triplets (every 2nd) on ONE grid (deep-research wf_085daf33: the high-res common-grid
  // approach). Scales Seq Length x3 / /3 to keep the bar count. SYNC-mode only: the bridge
  // re-imports the region at the new resolution (it watches listlen/spb), so notes land
  // correctly -- the region is the source of truth, so no in-plugin note remap is needed.
  eon_is_trip = (steps_per_beat % 3) == 0 && steps_per_beat >= 6;   // 6/12 = triplet-capable
  gfx_set(0.14,0.16,0.14,1); gfx_x=eon_so_lx; gfx_y=eon_so_ry+4; gfx_drawstr("Grid feel");
  (eon_sync_mode && eon_pair_slot>=0) ? (eon_is_trip ? gfx_set(0.42,0.30,0.16,1) : gfx_set(0.16,0.34,0.42,1)) : gfx_set(0.18,0.19,0.19,1);
  gfx_rect(eon_so_cx, eon_so_ry, 200, 22);
  gfx_set(0.90,0.95,0.97,1); gfx_x=eon_so_cx+8; gfx_y=eon_so_ry+5;
  gfx_drawstr((eon_sync_mode && eon_pair_slot>=0) ? (eon_is_trip ? "Triplet (12/beat)" : "Straight (4/beat)") : "(enable Sync + pair)");
  (eon_so_click && eon_sync_mode && eon_pair_slot>=0 && mouse_x>=eon_so_cx && mouse_x<eon_so_cx+200 && mouse_y>=eon_so_ry && mouse_y<eon_so_ry+22) ? (
    eon_is_trip ? (
      eon_new_spb = 4;  eon_new_len = max(2, (listlength/3)|0);
    ) : (
      eon_new_spb = 12; eon_new_len = min(max_seqlength, listlength*3);
    );
    listlength = eon_new_len; sliderchange(slider3=listlength); change_seqlen(listlength);
    steps_per_beat = eon_new_spb; steps_per_beat_pat[p] = eon_new_spb; sliderchange(slider9=eon_new_spb); rateadj = steps_per_beat*rate;
    p <= chain ? update_chain_beats();
    refresh_tb = 1; refresh_pianokeys = 1;
  );
  eon_so_ry+=30;

  // Export grid -> DM: write the ACTIVE pattern onto the bound region's lanes (one-shot;
  // StepSeq-authoritative -- clears the region window then writes the grid). Enabled only
  // when Sync is on + paired. Sets eon_export_pending; @block does the serialize + EXPORTREQ.
  gfx_set(0.14,0.16,0.14,1); gfx_x=eon_so_lx; gfx_y=eon_so_ry+4; gfx_drawstr("Export > DM");
  (eon_sync_mode && eon_pair_slot>=0) ? gfx_set(0.22,0.30,0.42,1) : gfx_set(0.18,0.19,0.19,1);
  gfx_rect(eon_so_cx, eon_so_ry, 200, 22);
  gfx_set(0.90,0.95,0.97,1); gfx_x=eon_so_cx+8; gfx_y=eon_so_ry+5;
  gfx_drawstr((eon_sync_mode && eon_pair_slot>=0) ? "Write grid to DM region" : "(enable Sync + pair)");
  (eon_so_click && eon_sync_mode && eon_pair_slot>=0 && mouse_x>=eon_so_cx && mouse_x<eon_so_cx+200 && mouse_y>=eon_so_ry && mouse_y<eon_so_ry+22) ? (
    eon_export_pending = 1;
  );

  gfx_setfont(0);
  eon_so_clk_last = mouse_cap&1;
) : (eon_so_clk_last = mouse_cap&1;);

);   // ═══ end EMBEDDED branch: close of `ss_emb ? (embed) : (full-UI draw + input)` ═══

// Pattern-op arbitration: gesture frame over — release the audio side.
_ui_patop = 0;
// End-of-frame mouse state. JSFX never auto-clears mouse_wheel, and knobs_kbsg's
// contract (libs/knobs_kbsg.jsfx-inc:43) is explicit that the CALLER zeroes it --
// the widget only ever reads frame_wheel. Every raw mouse_wheel handler above has
// already run by here, so one unconditional clear consumes the notch exactly once.
// NOT done next to the frame_wheel assignment the way Swing_ReaKit.jsfx:4578 does
// it: StepSeq has four consumers that read RAW mouse_wheel later in the frame (lane
// swing, theme chip, toolbar, embed branch) and zeroing early would kill all four.
// Without this, a single notch over a lane knob stayed set forever -- eon_kn_hov>=0
// forces a repaint every frame, the knob re-applied the same notch each time, and
// the pad's gain/pan ramped to the rail and pinned there. EON_Drum_Strip.jsfx:1739.
mouse_wheel = 0;
