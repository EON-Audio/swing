// rk_ss_thememenu.jsfx-inc — EON Steppa's THEME-menu rows
//
// The house rule: one menu holding every appearance option this face has.
// Steppa's are THEME, KNOB, GRID LINES, SONG STRIP and NAME BAR. The panel
// engine is rk_thememenu_core.jsfx-inc; read ITS header for the contract and
// the import order, which is load-bearing — this file comes BEFORE the core.
//
// ⚠️ Compiled BEFORE EON_StepSeq.jsfx's own @init, so it cannot call anything
// Steppa defines. It touches globals only.
//
// ⭐ GRID LINES and SONG STRIP already have toggles in Steppa's options panel
// (the `eon_so_*` block). These rows write the SAME globals and the SAME
// sliders, so the two paths cannot disagree — exactly how Swing's pad rows
// mirror its pad right-click menu. Nothing is removed from the options panel.
//
// ⛔ LANE COLUMNS (slider51) is deliberately NOT a row. It is a 7-bit mask —
// icon, name, mute, solo, vol, pan, swing — and a single-pick list cannot
// express a multi-toggle. It needs a checklist widget, which is its own job.
//
// ⚠️ Steppa persists with sliderchange(sliderN = value), not slider_automate;
// there is no slider_automate anywhere in the file. Follow the local idiom.

@init

THM_N_ROWS = 5;

THM_ROW_THEME   = 0;
THM_ROW_KNOB    = 1;
THM_ROW_GRID    = 2;
THM_ROW_SONG    = 3;
THM_ROW_NAMEBAR = 4;

// Knob-style names in dispatcher order — the same list and spelling every other
// face uses, so a style reads the same wherever it is named.
function ss_knob_name(v) (
  v == 1  ? strcpy(#_thm_lbl, "SSL") :
  v == 2  ? strcpy(#_thm_lbl, "Vari-Mu") :
  v == 3  ? strcpy(#_thm_lbl, "API") :
  v == 4  ? strcpy(#_thm_lbl, "Witti") :
  v == 5  ? strcpy(#_thm_lbl, "Neve") :
  v == 6  ? strcpy(#_thm_lbl, "Joanny") :
  v == 7  ? strcpy(#_thm_lbl, "MPC") :
  v == 8  ? strcpy(#_thm_lbl, "Jog") :
  v == 9  ? strcpy(#_thm_lbl, "Rainbow") :
  v == 10 ? strcpy(#_thm_lbl, "Spice") :
  v == 11 ? strcpy(#_thm_lbl, "Encoder") :
  v == 12 ? strcpy(#_thm_lbl, "Pultec") :
  v == 13 ? strcpy(#_thm_lbl, "Ableton") :
  v == 14 ? strcpy(#_thm_lbl, "FL") :
  v == 15 ? strcpy(#_thm_lbl, "Pro Tools") :
  v == 16 ? strcpy(#_thm_lbl, "FabFilter") :
  v == 17 ? strcpy(#_thm_lbl, "Serum") :
  v == 18 ? strcpy(#_thm_lbl, "Roland") :
  v == 19 ? strcpy(#_thm_lbl, "Pultec Cr") :
  v == 20 ? strcpy(#_thm_lbl, "Neve Alt") :
  strcpy(#_thm_lbl, "Default");
);

function thm_cap(r) (
  r == THM_ROW_KNOB    ? strcpy(#_thm_lbl, "KNOB") :
  r == THM_ROW_GRID    ? strcpy(#_thm_lbl, "GRID LINES") :
  r == THM_ROW_SONG    ? strcpy(#_thm_lbl, "SONG STRIP") :
  r == THM_ROW_NAMEBAR ? strcpy(#_thm_lbl, "NAME BAR") :
  strcpy(#_thm_lbl, "THEME");
);

function thm_val(r) (
  r == THM_ROW_THEME ? strcpy(#_thm_lbl, rkth_name(rkth_cur() - 1)) :
  r == THM_ROW_KNOB  ? ss_knob_name(gmem[GS_THEME_KNOB_P] | 0) :
  r == THM_ROW_GRID  ? ( eon_gridlines ? strcpy(#_thm_lbl, "On") : strcpy(#_thm_lbl, "Off") ) :
  r == THM_ROW_SONG  ? ( eon_song_on   ? strcpy(#_thm_lbl, "On") : strcpy(#_thm_lbl, "Off") ) :
  ( ss_name_bar ? strcpy(#_thm_lbl, "Shown") : strcpy(#_thm_lbl, "Hidden") );
);

function thm_count(r) (
  r == THM_ROW_THEME ? RKTH_N : r == THM_ROW_KNOB ? 21 : 2;
);

function thm_curidx(r) (
  r == THM_ROW_THEME ? rkth_cur() - 1 :
  r == THM_ROW_KNOB  ? (gmem[GS_THEME_KNOB_P] | 0) :
  r == THM_ROW_GRID  ? (eon_gridlines ? 1 : 0) :
  r == THM_ROW_SONG  ? (eon_song_on   ? 1 : 0) :
  (ss_name_bar ? 1 : 0);
);

function thm_optname(r, k) (
  r == THM_ROW_THEME ? strcpy(#_thm_lbl, rkth_name(k)) :
  r == THM_ROW_KNOB  ? ss_knob_name(k) :
  r == THM_ROW_NAMEBAR ? ( k ? strcpy(#_thm_lbl, "Shown") : strcpy(#_thm_lbl, "Hidden") ) :
  ( k ? strcpy(#_thm_lbl, "On") : strcpy(#_thm_lbl, "Off") );
);

// '!' ticks the live value — swing_popup's per-item marker.
function thm_menu(r) local(_k, _n, _cur) (
  _n = thm_count(r); _cur = thm_curidx(r);
  strcpy(#_thm_items, "");
  _k = 0;
  loop(_n,
    _k > 0 ? strcat(#_thm_items, "|");
    _k == _cur ? strcat(#_thm_items, "!");
    thm_optname(r, _k);
    strcat(#_thm_items, #_thm_lbl);
    _k += 1;
  );
);

function thm_openlist(r, px, py) (
  thm_pick_row = r;
  thm_menu(r);
  swing_popup_open(px, py, #_thm_items, SP_POPUP_CALLER_THEME);
);

// ⭐ Writes exactly what the options panel writes, so the two surfaces cannot
// disagree: the global AND the slider, through sliderchange.
// ⚠ eon_pdraw / refresh_tb are Steppa's repaint requests — this file runs a
// frame before the panel redraws, and without them a toggle would not show
// until something else forced a repaint.
function thm_apply(r, res) local(_k) (
  _k = res - 1;   // swing_popup returns 1-based
  r == THM_ROW_THEME ? ( gmem[GS_THEME_REQ]      = _k + 1; ) :
  r == THM_ROW_KNOB  ? ( gmem[GS_THEME_KNOB_REQ] = _k + 1; ) :
  r == THM_ROW_GRID  ? ( eon_gridlines = _k; sliderchange(slider50 = eon_gridlines); ) :
  r == THM_ROW_SONG  ? ( eon_song_on   = _k; sliderchange(slider55 = eon_song_on);   ) :
  ( ss_name_bar = _k; sliderchange(slider56 = ss_name_bar); );
  refresh_tb = 1; eon_pdraw = 4;
);

// Called by the core every frame, open or shut: a list outlives the panel,
// because the click that picks an item can be the click that closes it.
function thm_poll() (
  swing_popup_result > 0 && swing_popup_caller_id == SP_POPUP_CALLER_THEME ? (
    thm_apply(thm_pick_row, swing_popup_result);
    swing_popup_result = 0;
  );
  swing_popup_result == -1 && swing_popup_caller_id == SP_POPUP_CALLER_THEME ? (
    swing_popup_result = 0;
  );
);
