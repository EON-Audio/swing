// rk_swing_kitart.jsfx-inc — drum-machine archetype cover art, drawn as VECTORS
// ---------------------------------------------------------------------------
// Fifteen machine archetypes for the KIT tab cover tile, used when a kit has no
// cover image of its own. Vector rather than PNG for the same reason the 3D drum
// is vector (see rk_swing_ui_drum3d.jsfx-inc): no binary assets in the ship
// manifests, no gfx_loadimg slot pressure, and it scales to any tile size.
//
// Each archetype is a direct transcription of its 512x512 SVG artboard. The
// helpers below take SVG-space coordinates and push them through one
// offset+scale, set once per icon by _ka_begin — so the drawing code stays a
// literal 1:1 reading of the artwork and can be re-derived if the art changes.
//
// Colours are the artwork's own. These are portraits of real machine families
// and the colour IS the identity, so unlike the category-glyph portrait they
// deliberately do NOT take the LCD theme tint.
//
// @gfx ONLY. Every function keeps its scratch in local() — @gfx runs concurrent
// with @block, so a shared global scratch var is a data race (see
// .dev_tests/gfx_race_audit.py). ka_ox/ka_oy/ka_k/ka_a are the sole globals and
// are written only inside the @gfx pass.

@init

// ── Coordinate context ────────────────────────────────────────────────────
// _ka_begin maps the 512-unit artboard onto a _s x _s square at (_x,_y).
function _ka_begin(_x, _y, _s)
(
  ka_ox = _x; ka_oy = _y; ka_k = _s / 512; ka_a = 1;
);

// Colour from 0-255 SVG channel values, honouring the current ka_a.
function _ka_col(_r, _g, _b)
(
  gfx_set(_r / 255, _g / 255, _b / 255, ka_a);
);

// ── Primitives (all take SVG-space coords) ────────────────────────────────
// Filled rect. Sizes clamp to 1px so a hairline detail never vanishes at small
// tile sizes — an invisible shape reads as a rendering bug, a 1px one does not.
function _ka_rect(_x, _y, _w, _h)
(
  gfx_rect(ka_ox + _x * ka_k, ka_oy + _y * ka_k,
           max(1, _w * ka_k), max(1, _h * ka_k));
);

function _ka_circle(_cx, _cy, _r)
(
  gfx_circle(ka_ox + _cx * ka_k, ka_oy + _cy * ka_k, max(0.5, _r * ka_k), 1, 1);
);

// Filled rounded rect. gfx_roundrect is an OUTLINE primitive in REAPER, so a
// filled one is a cross rect plus four corner discs.
function _ka_rrect(_x, _y, _w, _h, _r)
local(_px, _py, _pw, _ph, _pr)
(
  _px = ka_ox + _x * ka_k; _py = ka_oy + _y * ka_k;
  _pw = max(1, _w * ka_k); _ph = max(1, _h * ka_k);
  _pr = min(_r * ka_k, min(_pw, _ph) * 0.5);
  _pr <= 0.75 ? (
    gfx_rect(_px, _py, _pw, _ph);
  ) : (
    gfx_rect(_px + _pr, _py, _pw - _pr * 2, _ph);
    gfx_rect(_px, _py + _pr, _pr + 1, _ph - _pr * 2);
    gfx_rect(_px + _pw - _pr - 1, _py + _pr, _pr + 1, _ph - _pr * 2);
    gfx_circle(_px + _pr, _py + _pr, _pr, 1, 1);
    gfx_circle(_px + _pw - _pr - 1, _py + _pr, _pr, 1, 1);
    gfx_circle(_px + _pr, _py + _ph - _pr - 1, _pr, 1, 1);
    gfx_circle(_px + _pw - _pr - 1, _py + _ph - _pr - 1, _pr, 1, 1);
  );
);

// Filled ellipse by horizontal spans — EEL2/gfx has no ellipse primitive and
// the drum shells need one. Span count follows the on-screen height so a big
// tile stays smooth and a small one stays cheap.
function _ka_ellipse(_cx, _cy, _rx, _ry)
local(_n, _i, _t, _dx, _sy, _sh, _pcx, _pcy, _prx, _pry)
(
  _pcx = ka_ox + _cx * ka_k; _pcy = ka_oy + _cy * ka_k;
  _prx = max(0.5, _rx * ka_k); _pry = max(0.5, _ry * ka_k);
  _n = max(3, ceil(_pry * 2));
  _sh = _pry * 2 / _n;
  _i = 0;
  loop(_n,
    _t = -1 + 2 * (_i + 0.5) / _n;
    _dx = sqrt(max(0, 1 - _t * _t));
    _sy = _pcy + _t * _pry;
    gfx_rect(_pcx - _prx * _dx, _sy - _sh * 0.5, max(1, _prx * 2 * _dx), _sh + 1);
    _i += 1;
  );
);

// Thick line with round caps (SVG stroke-linecap="round").
function _ka_line(_x1, _y1, _x2, _y2, _w)
local(_ax, _ay, _bx, _by, _dx, _dy, _len, _nx, _ny, _hw, _n, _i, _t)
(
  _ax = ka_ox + _x1 * ka_k; _ay = ka_oy + _y1 * ka_k;
  _bx = ka_ox + _x2 * ka_k; _by = ka_oy + _y2 * ka_k;
  _hw = max(0.5, _w * ka_k * 0.5);
  _dx = _bx - _ax; _dy = _by - _ay;
  _len = sqrt(_dx * _dx + _dy * _dy);
  _len > 0.0001 ? (
    _nx = -_dy / _len; _ny = _dx / _len;
    _n = max(1, ceil(_hw * 2));
    _i = 0;
    loop(_n,
      _t = -_hw + (_i + 0.5) * (_hw * 2 / _n);
      gfx_line(_ax + _nx * _t, _ay + _ny * _t, _bx + _nx * _t, _by + _ny * _t, 1);
      _i += 1;
    );
  );
  gfx_circle(_ax, _ay, _hw, 1, 1);
  gfx_circle(_bx, _by, _hw, 1, 1);
);

// Filled quad as two triangles — covers the SVG trapezoid paths (drum shells).
function _ka_quad(_x1, _y1, _x2, _y2, _x3, _y3, _x4, _y4)
local(_ax, _ay, _bx, _by, _cx, _cy, _dx2, _dy2)
(
  _ax = ka_ox + _x1 * ka_k; _ay = ka_oy + _y1 * ka_k;
  _bx = ka_ox + _x2 * ka_k; _by = ka_oy + _y2 * ka_k;
  _cx = ka_ox + _x3 * ka_k; _cy = ka_oy + _y3 * ka_k;
  _dx2 = ka_ox + _x4 * ka_k; _dy2 = ka_oy + _y4 * ka_k;
  gfx_triangle(_ax, _ay, _bx, _by, _cx, _cy);
  gfx_triangle(_ax, _ay, _cx, _cy, _dx2, _dy2);
);

// Rect outline of a given SVG stroke-width, drawn INSIDE the edge like SVG
// centres it — close enough at tile size and never bleeds past the shape.
function _ka_srect(_x, _y, _w, _h, _sw)
local(_t)
(
  _t = max(1, _sw * ka_k);
  gfx_rect(ka_ox + _x * ka_k, ka_oy + _y * ka_k, max(1, _w * ka_k), _t);
  gfx_rect(ka_ox + _x * ka_k, ka_oy + (_y + _h) * ka_k - _t, max(1, _w * ka_k), _t);
  gfx_rect(ka_ox + _x * ka_k, ka_oy + _y * ka_k, _t, max(1, _h * ka_k));
  gfx_rect(ka_ox + (_x + _w) * ka_k - _t, ka_oy + _y * ka_k, _t, max(1, _h * ka_k));
);

function _ka_scircle(_cx, _cy, _r)
(
  gfx_circle(ka_ox + _cx * ka_k, ka_oy + _cy * ka_k, max(0.5, _r * ka_k), 0, 1);
);

// == Archetypes ==========================================================
// Each is a 1:1 transcription of its 512x512 SVG artboard, in source paint
// order. Regenerate from the SVG if the art changes - do not hand-tune here.

function swing_kitart_analog_boom(_x, _y, _s)
(
  _ka_begin(_x, _y, _s);
  _ka_col(43, 27, 18); _ka_rrect(0, 0, 512, 512, 72); // case background
  _ka_col(59, 51, 48); _ka_rrect(36, 116, 440, 284, 18); // faceplate
  _ka_col(143, 85, 37); _ka_rrect(36, 116, 60, 284, 18); // left wood cheek
  _ka_col(143, 85, 37); _ka_rrect(416, 116, 60, 284, 18); // right wood cheek
  _ka_col(59, 51, 48); _ka_rect(80, 116, 352, 284); // faceplate over cheek inner edges
  _ka_col(29, 23, 21); _ka_rrect(112, 146, 288, 62, 8); // step strip recess
  _ka_col(255, 106, 40); _ka_rect(130, 164, 24, 26); // step 1
  _ka_col(255, 106, 40); _ka_rect(166, 164, 24, 26); // step 2
  _ka_col(122, 58, 24); _ka_rect(202, 164, 24, 26); // step 3 (off)
  _ka_col(255, 106, 40); _ka_rect(238, 164, 24, 26); // step 4
  _ka_col(122, 58, 24); _ka_rect(274, 164, 24, 26); // step 5 (off)
  _ka_col(255, 106, 40); _ka_rect(310, 164, 24, 26); // step 6
  _ka_col(122, 58, 24); _ka_rect(346, 164, 24, 26); // step 7 (off)
  _ka_col(255, 106, 40); _ka_circle(164, 308, 50); // left knob
  _ka_col(224, 73, 28); _ka_circle(256, 308, 50); // centre knob
  _ka_col(255, 106, 40); _ka_circle(348, 308, 50); // right knob
);

