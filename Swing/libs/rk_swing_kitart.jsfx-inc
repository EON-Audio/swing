);

function swing_kitart_groovebox(_x, _y, _s)
(
  _ka_begin(_x, _y, _s);
  _ka_col(14, 36, 32); _ka_rrect(0, 0, 512, 512, 72); // body / tile background
  _ka_col(18, 58, 50); _ka_rrect(46, 46, 420, 420, 30); // faceplate
  _ka_col(10, 28, 24); _ka_rrect(80, 80, 352, 120, 10); // display well
  _ka_col(62, 232, 168); _ka_rect(104, 106, 96, 68); // lit display block
  _ka_col(26, 58, 50); _ka_rect(212, 106, 192, 68); // dim display block
  _ka_col(62, 232, 168); _ka_rrect(80, 230, 164, 164, 12); // lit pad square
  _ka_col(10, 28, 24); _ka_rrect(256, 230, 164, 164, 12); // dark pad square
);

function swing_kitart_tribal_world(_x, _y, _s)
(
  _ka_begin(_x, _y, _s);
  _ka_col(26, 26, 26); _ka_rrect(0, 0, 512, 512, 72); // background tile
  _ka_col(201, 161, 59); _ka_quad(60, 420, 256, 76, 452, 420, 60, 420); // pyramid / triangle body (3-point path, 4th corner folded onto the 1st)
  _ka_col(26, 26, 26); _ka_line(256, 76, 256, 420, 8); // centre split line
  _ka_col(138, 106, 34); _ka_rrect(60, 420, 392, 34, 8); // base plinth
  _ka_col(26, 26, 26); _ka_circle(180, 330, 20); // left eye dot
  _ka_col(26, 26, 26); _ka_circle(332, 330, 20); // right eye dot
);

function swing_kitart_deep_house(_x, _y, _s)
(
  _ka_begin(_x, _y, _s);
  _ka_col(10, 22, 34); _ka_rrect(0, 0, 512, 512, 72); // background tile
  _ka_col(28, 58, 82); _ka_rrect(40, 40, 432, 432, 220); // outer platter disc
  _ka_col(10, 22, 34); _ka_circle(256, 256, 150); // dark record field
  _ka_col(47, 109, 149); _ka_circle(256, 256, 96); // blue label ring
  _ka_col(10, 22, 34); _ka_circle(256, 256, 40); // spindle hole
  _ka_col(47, 109, 149); _ka_rrect(236, 40, 40, 70, 10); // top index marker tab
);

function swing_kitart_vintage_combo(_x, _y, _s)
(
  _ka_begin(_x, _y, _s);
  _ka_col(46, 15, 20); _ka_rrect(0, 0, 512, 512, 72); // background tile
  _ka_col(122, 31, 43); _ka_rrect(34, 94, 444, 324, 20); // amp body
  _ka_col(153, 42, 58); _ka_rrect(34, 94, 444, 64, 20); // top control panel
  _ka_col(244, 217, 160); _ka_rrect(70, 196, 98, 98, 14); // grille cloth panel 1
  _ka_col(244, 217, 160); _ka_rrect(184, 196, 98, 98, 14); // grille cloth panel 2
  _ka_col(244, 217, 160); _ka_rrect(298, 196, 146, 98, 14); // grille cloth panel 3 (wide)
  _ka_col(58, 13, 19); _ka_rrect(70, 310, 374, 70, 12); // lower shadow bar
);

// == Dispatch =============================================================
// Archetype ids, kept as plain ordinals so a caller can persist one in a
// serialized field later without needing a lookup table:
//   0 analog boom    1 analog house   2 early digital   3 digital classic
//   4 sampler WS     5 vinyl lofi     6 modern trap     7 acoustic kit
//   8 percussion     9 generic       10 neon rave      11 groovebox
//  12 tribal world  13 deep house    14 vintage combo
// 9 stays the FALLBACK as well as its own id, so an out-of-range value from a
// newer build draws the neutral machine rather than nothing at all.
function swing_kitart_draw(_id, _x, _y, _s)
(
  _id == 0  ? swing_kitart_analog_boom(_x, _y, _s) :
  _id == 1  ? swing_kitart_analog_house(_x, _y, _s) :
  _id == 2  ? swing_kitart_early_digital(_x, _y, _s) :
  _id == 3  ? swing_kitart_digital_classic(_x, _y, _s) :
  _id == 4  ? swing_kitart_sampler_ws(_x, _y, _s) :
  _id == 5  ? swing_kitart_vinyl_lofi(_x, _y, _s) :
  _id == 6  ? swing_kitart_modern_trap(_x, _y, _s) :
  _id == 7  ? swing_kitart_acoustic_kit(_x, _y, _s) :
  _id == 8  ? swing_kitart_percussion(_x, _y, _s) :
  _id == 10 ? swing_kitart_neon_rave(_x, _y, _s) :
  _id == 11 ? swing_kitart_groovebox(_x, _y, _s) :
  _id == 12 ? swing_kitart_tribal_world(_x, _y, _s) :
  _id == 13 ? swing_kitart_deep_house(_x, _y, _s) :
  _id == 14 ? swing_kitart_vintage_combo(_x, _y, _s) :
              swing_kitart_generic(_x, _y, _s);
);

// Pick an archetype from the kit NAME, or -1 when nothing matches.
// The name is the strongest signal the user gives us — "808 Trap Kit" states an
// intent that the pad categories cannot. Machine identifiers are tested before
// genre words so "808 Trap" reads as the 808 rather than the generic trap tile.
// Deliberately conservative: only distinctive tokens are matched. Short ones
// like "sp" were left out because they hit ordinary words ("Splash", "Inspire")
// and a wrong portrait is worse than the neutral fallback.
function swing_kitart_pick()
(
  strlen(#kit_name) < 1 ? -1 :
  matchi("*808*", #kit_name) ? 0 :
  matchi("*909*", #kit_name) ? 1 :
  (matchi("*linn*", #kit_name) || matchi("*dmx*", #kit_name) || matchi("*vintage*", #kit_name)) ? 2 :
  (matchi("*mpc*", #kit_name) || matchi("*sampler*", #kit_name) || matchi("*boom bap*", #kit_name) || matchi("*boombap*", #kit_name)) ? 4 :
  (matchi("*lofi*", #kit_name) || matchi("*lo-fi*", #kit_name) || matchi("*vinyl*", #kit_name) || matchi("*dusty*", #kit_name) || matchi("*tape*", #kit_name)) ? 5 :
  (matchi("*trap*", #kit_name) || matchi("*drill*", #kit_name)) ? 6 :
  // ── set 2 ──
  // "deep house" is tested BEFORE the plain "house" branch below, or the
  // generic 909 branch would swallow it.
  matchi("*deep house*", #kit_name) ? 13 :
  (matchi("*rave*", #kit_name) || matchi("*neon*", #kit_name) || matchi("*hardcore*", #kit_name)) ? 10 :
  (matchi("*groovebox*", #kit_name) || matchi("*electribe*", #kit_name)) ? 11 :
  (matchi("*tribal*", #kit_name) || matchi("*world*", #kit_name) || matchi("*ethnic*", #kit_name) || matchi("*djembe*", #kit_name)) ? 12 :
  (matchi("*combo*", #kit_name) || matchi("*organ*", #kit_name)) ? 14 :
  (matchi("*acoustic*", #kit_name) || matchi("*rock*", #kit_name) || matchi("*jazz*", #kit_name) || matchi("*live*", #kit_name)) ? 7 :
  (matchi("*perc*", #kit_name) || matchi("*conga*", #kit_name) || matchi("*latin*", #kit_name) || matchi("*afro*", #kit_name) || matchi("*bongo*", #kit_name) || matchi("*shaker*", #kit_name)) ? 8 :
  (matchi("*house*", #kit_name) || matchi("*techno*", #kit_name) || matchi("*acid*", #kit_name)) ? 1 :
  (matchi("*digital*", #kit_name) || matchi("*electro*", #kit_name)) ? 3 :
  -1;
);
