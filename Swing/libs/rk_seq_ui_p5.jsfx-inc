// rk_seq_ui_p5.jsfx-inc -- part 5 of rk_seq_ui.jsfx-inc (6 parts), cut at a function boundary by
// .dev_tests/split_big_incs.py: REAPER's load time grows with the square of a file's size. Edit freely;
// keep each file under about 40 KB.

// ⚠️ @init IS LOAD-BEARING (.docs/wiki/02-file-structure.md).
@init

// ── The grid, drawn into a rectangle: the panel's, or the big view's ─────────────────────────────────
// Reads the mouse from the ordinary globals (the panel is part of the main face; the big-view wrapper hands
// it the _ov_* copies). `big` = 1 draws the big view's X (closes the view); 0 the panel's (closes the panel).
function swing_seq_panel_draw(x, y, w, h, big)
local(pd, hdr_w, bar_h, rul_h, foot_h, row_h, lanes_y, gx, gw, shown, cw, l, s, cx, cy, ry, hov, lb, sb, pat,
      tw, th, bx, by, bw, bh, k, on, vel, nm, len, div, st, tgt, has, n0, cellk, pages, colr, colg, colb,
      chip_w, msw, box_w, name_x, name_w, fs, hov_l, hov_s, hov_vel, view, prob, rt, nud, acc, rsb, pb, fy, fh,
      selb, selr, nv, frac, bxw, i, vmax, cur, ov, pk, sel_on, bank, fl, ph, swv, cat, sx, bar2_h, song_h, by2, bh2,
      foot_one, tr_row2, rx, pw, fw, ov_ld, ov_rd, ov_w, ov_lmb, ov_mx, hov_acc, ci_x, cms_x, cnm_x, cnm_w, cln_x, cdv_x, csw_x,
      icb, icw, bxh, snq, mtb, fold, rroll, lanes_h, rfold, lroll, lavail, srow, nsb, rlf, rgrip, rgy, tiny, keys_h, cr_max, cr_need, cr_room, cr_fit, cr_w, cr_x, cr_i, cr_named, cr_lit, cr_go, cr_tr,
      pkp_on, pkp_ld, pkp_rd, pkp_lmb, pkp_rmb, pkp_w, pkp_mx, pkp_my, scr_hit, lz_on, lp_on, lz_lit, lz_sb, lz_ord, lzs, nmin, lw, zw, nw, lzg1, lzg2, aw, arw, ow, oxw, ox, lhint, nvis, lwh, lsbh, lsbx, lsby, lsbk,
      shr, shk) (
  // the drawn picker up (the small things round): everything under it sees the mouse parked -- no press, no wheel, no
  // hover -- and the picker gets the real one back at the end, where it draws last (a press outside it closes it there)
  pkp_on = seq_ui_pk_lane >= 0;
  pkp_on ? (
    pkp_ld = lmb_down; pkp_rd = rmb_down; pkp_lmb = LMB; pkp_rmb = RMB; pkp_w = frame_wheel; pkp_mx = mx; pkp_my = my;
    lmb_down = 0; rmb_down = 0; LMB = 0; RMB = 0; frame_wheel = 0; mx = -100000; my = -100000;
  );
  !LMB ? ( seq_ui_paint = -1; seq_ui_last = -1; seq_ui_drag_l = -1; seq_ui_drag_sw = -1; seq_ui_cdrag = 0; seq_ui_vdrag_id = 0; seq_ui_lsb_drag = 0; );
  seq_ui_want_cur = 0;
  pd = swing_px(8);
  seq_ui_theme_bg(); gfx_set(seq_ui_bg_r, seq_ui_bg_g, seq_ui_bg_b, 0.98); gfx_rect(x, y, w, h);
  gfx_set(0.23, 0.37, 0.54, 0.55);
  gfx_rect(x, y, w, 1); gfx_rect(x, y + h - 1, w, 1); gfx_rect(x, y, 1, h); gfx_rect(x + w - 1, y, 1, h);

  pat = max(0, min(SEQ_PATS - 1, seq_cur | 0));
  pb = seq_pat_at(pat);
  view = max(0, min(SEQ_UI_VIEWS - 1, seq_view | 0));
  bar_h = swing_px(SEQ_UI_BAR_B); bar2_h = swing_px(SEQ_UI_BAR2_B); song_h = seq_opt_sync ? swing_px(SEQ_UI_SONG_B) : 0; rul_h = swing_px(SEQ_UI_RUL_B);
  // the footer: two rows, or three where the panel is too narrow for the step editor and the pattern's feel side by side
  foot_one = w >= swing_px(SEQ_UI_FOOT_ONE_B);
  foot_h = swing_px(SEQ_UI_FOOT_B) + (foot_one ? 0 : swing_px(SEQ_UI_FOOT3_B));
  // top to bottom: the toolbar's two rows, the song strip's band (0 until S4), the ruler, the lanes, the footer
  keys_h = seq_trig_mode > 0 ? swing_px(SEQ_UI_KEYS_ROW_B) : 0;   // the key row under the chips while KEYS is on (round two C: the lanes give it their height)
  by2 = y + swing_px(4) + bar_h + swing_px(2) + keys_h; bh2 = bar2_h;
  lanes_y = by2 + bh2 + swing_px(4) + song_h + rul_h;
  // Sixteen rows between the ruler and the footer, FILLING the height (floored, capped at SEQ_UI_ROW_B), computed at
  // whatever the rectangle is; the header's boxes stay at most 22 design px tall, centred, so a tall row is all grid.
  // Shorter than sixteen rows of SEQ_UI_ROW_SCROLL_B: the rows keep that height and the lanes scroll (below); a rectangle
  // short of even one such row shows one row as tall as it has, down to the old floor (2026-10-27).
  row_h = floor((y + h - foot_h - swing_px(4) - lanes_y) / SEQ_LANES);
  row_h = row_h >= swing_px(SEQ_UI_ROW_SCROLL_B) ? min(swing_px(SEQ_UI_ROW_B), row_h)
        : max(swing_px(SEQ_UI_ROW_MIN_B), min(swing_px(SEQ_UI_ROW_SCROLL_B), y + h - foot_h - swing_px(4) - lanes_y));
  // The lane header's columns (the polish pass: each can be hidden from the ruler's labels or its menu), design px from the
  // left: the colour chip 12, the icon (an option: 16 to 34, growing with the rows), M / S 38, the name 62, then the length,
  // the division and the swing
  // 2 + 30 each, and 4 -- SEQ_UI_HDR_B (212) with everything but the icon shown. A hidden column's x is -1.
  // S5: one roll lane folds out (seq_ui_roll_lane): the other fifteen keep a short row (at most 19 design px), the roll takes
  // the rest of the height
  seq_ui_roll_hov = 0;
  fold = seq_ui_roll_lane >= 0 && seq_ui_roll_lane < SEQ_LANES ? seq_ui_roll_lane : -1;
  fold >= 0 && !seq_lane_roll(seq_lane_at(pat, fold)) ? fold = -1;
  lavail = y + h - foot_h - swing_px(4) - lanes_y; rroll = 0; rgrip = 0;
  // a roll folds out only where its slivers and its grabber fit; shorter, it stays folded back for the frame (the lanes
  // scroll instead, below) and opens again when the panel has the height
  fold >= 0 && lavail < SEQ_LANES * swing_px(SEQ_UI_ROW_SLIVER_B) + swing_px(SEQ_UI_RGRIP_B) ? fold = -1;
  fold >= 0 ? (
    // the roll's share of the height (seq_opt_rollh per cent, 0 = half; the grabber sets it): sixteen rows of the rest,
    // slivers at the least, the grabber's band, and the roll body with what is left (the user: "adjustable height grabbers")
    rlf = seq_opt_rollh > 0 ? max(SEQ_UI_ROLL_MIN_PC, min(SEQ_UI_ROLL_MAX_PC, seq_opt_rollh)) * 0.01 : 0.5;
    rgrip = swing_px(SEQ_UI_RGRIP_B);
    row_h = max(swing_px(SEQ_UI_ROW_SLIVER_B), min(swing_px(19), floor(lavail * (1 - rlf) / SEQ_LANES)));
    rroll = max(0, lavail - SEQ_LANES * row_h - rgrip);
  );
  // The lanes SCROLL where sixteen rows of SEQ_UI_ROW_SCROLL_B do not fit (2026-10-27; the owner: "when the sequencer is
  // at the bottom can we add scrolling to it as well?" -- a short panel below the pads, or the squeeze, drew the lanes past
  // its bottom, under the footer and off the window; then, the same day: "scroll up and down instead of trying to fit all
  // the lanes in" -- the threshold, the 11 px floor until then). The rows keep that height, as many as fit are shown (nvis,
  // 0 when not even one fits), and the window over them (seq_ui_lscr, the first lane shown in lane order; view state, not
  // saved) moves with the wheel over the lanes wherever nothing under the pointer takes the wheel itself -- an ON step, a
  // modifier wheel on any step, the LEN / DIV / SW boxes keep theirs (the roll's rule: "over a note its velocity; over an
  // empty spot the rows"), so the names column always scrolls. A thin bar at the lanes' right edge (in the padding right
  // of the cells, never over them) shows where the window is: its thumb drags, a press above or below it pages.
  // An open roll keeps its slivers (SEQ_UI_ROW_SLIVER_B, above: the fifteen other lanes compacted on purpose so the roll
  // has the height) and never scrolls; where even its slivers do not fit it folds back and the rows scroll as here.
  nvis = fold < 0 && SEQ_LANES * row_h > lavail ? max(0, floor(lavail / row_h)) : SEQ_LANES;
  seq_ui_lscr = max(0, min(SEQ_LANES - nvis, seq_ui_lscr | 0));
  seq_ui_nvis = nvis;   // the rigs
  lanes_h = fold >= 0 ? SEQ_LANES * row_h + rgrip + rroll : nvis * row_h;
  rfold = fold >= 0 ? (seq_opt_topdown ? fold : SEQ_LANES - 1 - fold) : SEQ_LANES;
  tiny = row_h < swing_px(9);   // the compacted lanes beside an open roll: the chip and the cells only
  icb = max(SEQ_UI_ICON_B, min(34, floor(row_h / max(0.5, _ui_sc)) - 2)); icw = swing_px(icb);   // the icon column grows with the rows
  k = 12; ci_x = x + swing_px(k); seq_opt_icons ? k += icb;
  cms_x = (seq_col_hide & 1) ? -1 : x + swing_px(k); cms_x >= 0 ? k += 38;
  cnm_x = (seq_col_hide & 2) ? -1 : x + swing_px(k); cnm_x >= 0 ? ( cnm_w = swing_px(k + 62) - swing_px(k); k += 62; ) : cnm_w = 0;
  cln_x = (seq_col_hide & 4) ? -1 : x + swing_px(k + 2); cln_x >= 0 ? k += 32;
  cdv_x = (seq_col_hide & 8) ? -1 : x + swing_px(k + 2); cdv_x >= 0 ? k += 32;
  csw_x = (seq_col_hide & 16) ? -1 : x + swing_px(k + 2); csw_x >= 0 ? k += 32;
  fold >= 0 ? k = max(k, SEQ_UI_ROLL_LEFT_B - 4);   // the roll's column (the keyboard) has its room whatever is hidden
  hdr_w = swing_px(k + 4);
  gx = x + hdr_w; gw = w - hdr_w - pd;
  seq_ui_lanes_y = lanes_y; seq_ui_row_h = row_h; seq_ui_ci_x = ci_x; seq_ui_icw = icw; seq_ui_nm_x = cnm_x; seq_ui_gx = gx;   // the lanes' geometry this frame (the rigs)
  // Steps shown: whole bars of sixteen, as many as fit at the narrowest cell, one to four.
  shown = 16 * max(1, min(4, floor(gw / (16 * swing_px(SEQ_UI_CELL_B)))));
  cw = gw / shown;
  // 48 shown (three bars) leaves a second page of sixteen: a fraction here pinned the page to 0 on the next frame and
  // steps 49-64 could not be reached (audit K5); the ruler and the STEPS label stop at 64, the cells at the lane's length
  pages = ceil(SEQ_STEPS / shown);
  !big ? seq_ui_shown = shown;
  // FOLLOW: the page turns with the playhead of the selected lane (the longest lane when none is selected), only while
  // the engine plays THIS pattern and no gesture is live. View state: the page is not an edit (no dirty, no undo).
  seq_opt_follow && seq_playing && seq_eng_pat == pat && !LMB && seq_ui_cdrag == 0 ? (
    fl = seq_ui_sel_l >= 0 && seq_ui_sel_l < SEQ_LANES ? seq_ui_sel_l : seq_ui_longest_lane(pat);
    ph = seq_wk[fl * SEQ_WK_F + 1] | 0;
    ph >= 0 ? seq_page = floor(ph / shown);
  );
  seq_page = max(0, min(pages - 1, seq_page | 0));
  n0 = seq_page * shown;

  // ── Toolbar: title · pattern tabs · page · ON · OPT · the transport · the full face · X ──
  by = y + swing_px(4); bh = bar_h;
  // close X, at the FAR RIGHT of this row (2026-10-27; the owner: "Move sequencer 'X' to far right"; it sat at the top
  // left from 2026-10-26, at the top right before that): always closes the sequencer -- from the full view too (the user,
  // 2026-10-23: "X should always just close"; the full-face button just left of it is the one that brings the panel
  // back). Drawn here, before the row, so its click is taken first; the row's right end keeps its room (the full face
  // at x + w - 48, the transport left of that, the chips' room counts both).
  seq_ui_x_x = x + w - swing_px(24);
  hov = seq_ui_btn(seq_ui_x_x, by, swing_px(20), bh, "X", 0);
  hov && lmb_down ? (
    big ? ( swing_bigview_close(); active_id = -1; );
    seq_shown = 0;
  );
  hov ? swing_tooltip_check(1444, "Close the sequencer.");
  rk_font(1, swing_fs(13), 'b');
  gfx_set(0.65, 0.78, 0.94, 0.95);
  tw = 0; th = 0; gfx_measurestr("STEP SEQ", tw, th);
  gfx_x = x + swing_px(10); gfx_y = by + (bh - swing_fs(13)) * 0.5 - 1; gfx_drawstr("STEP SEQ");
  sx = gfx_x;   // the title's right edge: the chips start clear of it (below)
  // the pattern chips (round two H, 2026-10-21; the user: "can those be color-coded as well? ... The way Steppa did it was it
  // did not show all the patterns at once. It allowed for there to be room until more patterns were created."): one chip per
  // pattern on show (seq_npat), "+" after the last. A chip carries its number and -- when the pattern has a name of its own,
  // or its region's while SONG is on -- the name; its colour is the pattern's own, its region's, or a hue from its number; the
  // one on screen is ringed, a dot marks one with hits. The row scrolls (the wheel over it, the ‹ › ends) when the chips
  // outgrow their room, and the chip on screen is always in view. Keys 1-8 pick from the first chip shown; a key or a trigger
  // note past the count does nothing (the user's choice); DUP raises the count; SONG on follows the regions.
  seq_ui_ren_p >= 0 && lmb_down ? seq_ui_ren_commit();   // a click anywhere keeps a rename in progress
  seq_npat = max(1, min(SEQ_PATS, seq_npat | 0));
  seq_ui_ack_tick();   // the engine's acks (a kit landed, a preset, ADAPT): the gate takes them each window pass too (K8)
  seq_opt_sync ? ( cr_i = 0; loop(max(0, min(64, seq_map_n | 0)), cr_w = seq_map[cr_i * 4 + 2] | 0; cr_w >= seq_npat && cr_w < SEQ_PATS ? seq_npat = cr_w + 1; cr_i += 1; ); );   // SONG: every pattern a region plays
  pat >= seq_npat ? seq_npat = pat + 1;
  bx = max(x + swing_px(96), sx + swing_px(10));   // 96 again since the X went to the far right (108 while it sat at the left, 2026-10-26)
  // the chip AREA is a fixed footprint, so nothing to its right moves as patterns are added (the user: Steppa "allowed for
  // there to be room until more patterns were created"): at least the old tabs' 244 design px (with the transport on row 2
  // where the row is narrow, as it was beside the tabs), and more where the row also holds the transport (cr_tr): what
  // is left after the page arrows (the widest label), ON, OPT and the right end; never past the row with the transport down
  rk_font(1, swing_fs(9), 0); gfx_measurestr("STEPS 49-64", tw, th);
  cr_need = x + w - bx - swing_px(10) - (pages > 1 ? swing_px(62) + tw : 0) - swing_px(84) - swing_px(56);   // the room with the transport on row 2 (the right end: the full-face button and the X, 32 while the X sat at the left)
  cr_tr = cr_need - (seq_opt_transport ? swing_px(102) : 0);                                                   // ... and with it on row 1
  cr_max = max(swing_px(80), min(cr_need, max(swing_px(244), cr_tr)));
  // what the whole row would take: 26 a numbered chip, 64 a named one, 96 one being renamed, 2 between, 28 the "+"
  cr_need = swing_px(28); cr_i = 0;
  loop(seq_npat, cr_need += (seq_ui_ren_p == cr_i ? swing_px(96) : seq_ui_pat_name(cr_i) ? swing_px(64) : swing_px(26)) + swing_px(2); cr_i += 1; );
  cr_room = min(cr_need, cr_max);
  cr_need <= cr_max ? seq_ui_chip0 = 0 : pat != seq_ui_chip_pat ? (
    // the row scrolls: when the pattern on screen CHANGES the row is pulled to it -- the first chip shown at most the one on
    // screen, advancing until it fits; between changes the ‹ › ends and the wheel scroll the row freely (this clamp ran
    // every frame until audit K9 and undid them the next frame: the row never scrolled past the chip on screen)
    seq_ui_chip0 = max(0, min(min(seq_npat - 1, pat), seq_ui_chip0 | 0));
    cr_fit = 0;
    while(!cr_fit) (
      cr_w = swing_px(16); cr_i = seq_ui_chip0;
      while(cr_i <= pat) ( cr_w += (seq_ui_ren_p == cr_i ? swing_px(96) : seq_ui_pat_name(cr_i) ? swing_px(64) : swing_px(26)) + swing_px(2); cr_i += 1; );
      cr_w <= cr_max - swing_px(44) || seq_ui_chip0 >= pat ? cr_fit = 1 : seq_ui_chip0 += 1;
    );
  ) : seq_ui_chip0 = max(0, min(seq_npat - 1, seq_ui_chip0 | 0));
  seq_ui_chip_pat = pat;
  cr_x = bx;
  seq_ui_chip0 > 0 ? ( seq_ui_btn(cr_x, by, swing_px(14), bh, "<", 0) && lmb_down ? seq_ui_chip0 -= 1; cr_x += swing_px(16); );
  cr_i = seq_ui_chip0; cr_go = 1;
  while(cr_go && cr_i < seq_npat) (
    cr_named = seq_ui_pat_name(cr_i);   // the name, if any, in #seq_ui_gstr
    cr_w = seq_ui_ren_p == cr_i ? swing_px(96) : cr_named ? swing_px(64) : swing_px(26);
    cr_i > seq_ui_chip0 && cr_x + cr_w > bx + cr_room - swing_px(28) - (cr_i < seq_npat - 1 ? swing_px(16) : 0) ? cr_go = 0 : (
      cr_lit = cr_i == pat;
      seq_ui_pat_rgb(cr_i);
      hov = mx >= cr_x && mx < cr_x + cr_w && my >= by && my < by + bh;
      gfx_set(_hsl_r, _hsl_g, _hsl_b, cr_lit ? 1 : (hov ? 0.8 : 0.55)); gfx_rect(cr_x, by, cr_w, bh);
      cr_lit ? ( gfx_set(1, 1, 1, 0.9); gfx_rect(cr_x, by, cr_w, 2); gfx_rect(cr_x, by + bh - 2, cr_w, 2); gfx_rect(cr_x, by, 2, bh); gfx_rect(cr_x + cr_w - 2, by, 2, bh); );
      (_hsl_r + _hsl_g + _hsl_b) * 0.333 > 0.55 ? gfx_set(0, 0, 0, 0.85) : gfx_set(1, 1, 1, 0.92);
      seq_ui_ren_p == cr_i ? (
        // the rename box on the chip: the text so far and a caret; Enter keeps it, Escape drops it, a click anywhere keeps it
        sprintf(#seq_ui_lbl, "%s_", #seq_ui_ren_buf); rk_font(1, swing_fs(10), 'b'); gfx_measurestr(#seq_ui_lbl, tw, th);
        gfx_x = cr_x + swing_px(4); gfx_y = by + (bh - th) * 0.5; gfx_drawstr(#seq_ui_lbl);
      ) : (
        sprintf(#seq_ui_lbl, "%d", cr_i + 1); rk_font(1, swing_fs(cr_named ? 10 : 11), 'b'); gfx_measurestr(#seq_ui_lbl, tw, th);
        gfx_x = cr_x + (cr_named ? swing_px(4) : (cr_w - tw) * 0.5); gfx_y = by + (bh - th) * 0.5; gfx_drawstr(#seq_ui_lbl);
        cr_named ? ( rk_font(1, swing_fs(8), 0); swing_mapping_name_line(cr_x + tw + swing_px(6) + (cr_w - tw - swing_px(10)) * 0.5, by + (bh - swing_fs(8)) * 0.5, cr_w - tw - swing_px(10), #seq_ui_gstr, 0); );
        cr_i != pat && seq_pat_used(cr_i) ? gfx_rect(cr_x + cr_w * 0.5 - 1, by + bh - 4, 3, 2);
      );
      hov && lmb_down && cr_i != pat ? ( seq_cur = cr_i; seq_ui_sel_l = -1; mark_dirty(); seq_ui_loop_follow(cr_i, 0); );   // a lit LOOP Region follows
      // SONG on: the press also arms a drag -- pulled down past 6 px it rides to the song strip's chain (seq_ui_sdrag_tick)
      hov && lmb_down && seq_opt_sync ? ( seq_ui_sdrag = 1; seq_ui_sdrag_pat = cr_i; seq_ui_sdrag_x0 = mx; seq_ui_sdrag_y0 = my; );
      hov && rmb_down ? seq_ui_pattern_menu_open(cr_i);
      hov ? swing_tooltip_check(1470, seq_opt_sync ? "A pattern: click = on screen; drag it down onto the song strip's chain to add its region there; right-click = the PATTERN menu (copy, paste, rename, colour, remove ...). Keys 1-8 pick from the first chip shown."
                                                   : "A pattern: click = on screen; right-click = the PATTERN menu (copy, paste, rename, colour, remove ...). Keys 1-8 pick from the first chip shown.");
      cr_x += cr_w + swing_px(2); cr_i += 1;
    );
  );
  cr_i < seq_npat ? ( seq_ui_btn(cr_x, by, swing_px(14), bh, ">", 0) && lmb_down ? seq_ui_chip0 = min(seq_npat - 1, seq_ui_chip0 + 1); cr_x += swing_px(16); );
  seq_ui_plus_x = -1;
  seq_npat < SEQ_PATS ? (
    seq_ui_plus_x = cr_x;
    hov = seq_ui_btn(cr_x, by, swing_px(26), bh, "+", 0);
    hov && lmb_down ? ( seq_opt_sync ? seq_ui_region_req(16, 0) : ( seq_npat += 1; seq_cur = seq_npat - 1; seq_ui_sel_l = -1; seq_ui_edited(); ); );
    hov ? ( seq_opt_sync ? swing_tooltip_check(1471, "A new region after the last, playing the lowest pattern no region plays yet (SONG is on).") : swing_tooltip_check(1472, "The next pattern.") );
    cr_x += swing_px(28);
  );
  mx >= bx && mx < bx + cr_max && my >= by && my < by + bh && frame_wheel != 0 ? seq_ui_chip0 = max(0, min(seq_npat - 1, (seq_ui_chip0 | 0) + (frame_wheel > 0 ? -1 : 1)));
  seq_ui_chips_x = bx; seq_ui_chips_w = cr_max;
  keys_h > 0 ? seq_ui_keystrip_draw(x + swing_px(8), by + bh + swing_px(1), w - swing_px(16), keys_h - swing_px(2), pat);   // the key row across the panel (round two C)
  bx += cr_max + swing_px(10);
  pages > 1 ? (
    // an arrow takes the page back from FOLLOW; the page (and FOLLOW) is view state: it marks nothing (the owner's D8,
    // 2026-10-29: "only real edits"), saved with the project's next save like the panel's height
    seq_ui_btn(bx, by, swing_px(20), bh, "<", 0) && lmb_down && seq_page > 0 ? ( seq_page -= 1; seq_opt_follow = 0; );
    bx += swing_px(22);
    sprintf(#seq_ui_lbl, "STEPS %d-%d", n0 + 1, min(SEQ_STEPS, n0 + shown));
    rk_font(1, swing_fs(9), 0);
    gfx_set(0.75, 0.82, 0.9, 0.9);
    gfx_measurestr(#seq_ui_lbl, tw, th);
    gfx_x = bx + swing_px(4); gfx_y = by + (bh - th) * 0.5; gfx_drawstr(#seq_ui_lbl);
    bx += tw + swing_px(10);
    seq_ui_btn(bx, by, swing_px(20), bh, ">", 0) && lmb_down && seq_page < pages - 1 ? ( seq_page += 1; seq_opt_follow = 0; );
    bx += swing_px(30);
  );
  // ON (the toolbar pass; PLAY until then: it read as REAPER's play next to the transport): the sequencer runs, or not
  hov = seq_ui_btn(bx, by, swing_px(44), bh, "ON", !seq_off);
  hov && lmb_down ? ( seq_off = !seq_off; mark_dirty(); );
  hov ? swing_tooltip_check(1463, "ON: the sequencer plays with REAPER's transport. Off, it keeps its patterns and the pads are yours from MIDI alone.");
  bx += swing_px(48);
