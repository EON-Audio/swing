      hov ? swing_tooltip_check(1442, seq_opt_sync ? "TO ITEM with SONG on: the song as MIDI, one item under every region holding the pattern it plays -- each drum on its own track where the kit has one, else this track. What was there is cleared first, and the sequencer stands aside where the song is printed. A region with no hits gets none. Right-click: the chain from the edit cursor instead." : "TO ITEM: the pattern as a MIDI item on this track, from the edit cursor's bar -- one cycle of the longest lane, as it would play there. Right-click: 2, 4 or 8 cycles. Switch ON off to hear the item alone.");
    ) : ( seq_ui_btn_dim(rx + swing_px(48), by2, swing_px(44), bh2, "TO ITEM") ? swing_tooltip_check(1442, "TO ITEM: the pattern as a MIDI item on this track. Needs the Kit Bridge."); );
    pw = rx - swing_px(8) - bx;
  ) : ( pw = x + w - swing_px(8) - bx; );
  // the preset's band (S3b): the name, index and count the bridge published for this slot
