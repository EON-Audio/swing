    ) : ( seq_ui_btn_dim(rx, by2, swing_px(44), bh2, "SONG") ? swing_tooltip_check(1441, "SONG: each region plays its own pattern. Needs the Kit Bridge."); );
    // TO ITEM (PRINT until the toolbar pass; S6): the pattern as a MIDI item on this track, through the bridge; right-click: the cycles
    pk ? (
      hov = seq_ui_btn(rx + swing_px(48), by2, swing_px(44), bh2, "TO ITEM", 0);
