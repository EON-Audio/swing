// rk_swing_ui_minibrowser.jsfx-inc
// Swing mini file browser — the in-canvas sidebar.
// (c) EON Studios — All Rights Reserved
//
// WHY THIS EXISTS: the big Swing_Browser is for "go and find something". This is
// for "get that sample onto this pad without leaving the instrument". The scope
// IS the value — there is deliberately no search, no tagging, no column set and
// no per-row waveform here.
//
// The one thing EEL2 cannot do is enumerate a directory, so Swing_Kit_Bridge's
// eon_fb_tick lists one folder and publishes it into EON_SWBROWSE; this face
// snapshots that band and draws it. The face sends a row INDEX back, never a
// path, so a non-ASCII filename still loads even though the wire folds names to
// '?' for display.
//
// ⛔ THE PADS MUST STAY VISIBLE WHENEVER THIS IS OPEN. That is not a nicety —
// drag-to-pad only works because the list and the grid share ONE @gfx canvas,
// which is the whole reason this is worth building. So it takes width from the
// left pane rather than becoming a full-window big view like the FX picker.

@init

// ── band (declared in .refs/gmem_regions_supplement.tsv, 26607616..26673151) ──
EON_SWBROWSE_BASE   = 26607616;   // 406 * 65536, block-aligned
EON_SWBROWSE_STRIDE = 4096;
EON_SWBROWSE_SLOTS  = 16;
// Waveform peaks for the SELECTED row live in their OWN band: a row record is
// 60 cells and these could never ride along. 2026-10-15 (the user: "can we draw
// the wave forms any better?"): 512 columns, folded to one per pixel when drawn,
// plus a loudness BODY per column; 16 slots * 4096 fill block 407 exactly.
EON_SWBPK_BASE      = 26673152;   // 407 * 65536
EON_SWBPK_STRIDE    = 4096;  // per slot: L max, L min, R max, R min, L body, R body -- 6 * FB_PK_N (3072 used)
FB_PK_N             = 512;        // columns; the strip draws one per pixel and folds the rest

// ── folder tree band (26738688..26804223, 408 * 65536) ──────────────────────
// Its own band because the tree and the file list are on screen TOGETHER and
// EON_SWBROWSE's stride is full to the byte (256 + 64*60 = 4096).
EON_SWBTREE_BASE   = 26738688;
EON_SWBTREE_STRIDE = 4096;

FBT_PUB_SEQ  = 0;
FBT_GEN      = 1;
FBT_TOTAL    = 2;
FBT_WIN_OFF  = 3;
FBT_WIN_N    = 4;
FBT_FLAGS    = 5;    // bit0 = a folder is being expanded right now
FBT_SEL      = 6;    // visible index that IS the file list's folder, -1 = none
FBT_HB       = 7;
FBT_REQ_SEQ  = 32;   // written LAST
FBT_REQ_OFF  = 33;
FBT_REQ_N    = 34;
FBT_REQ_VERB = 35;   // 0 page · 1 toggle expand · 2 select · 3 rebuild
FBT_REQ_TIDX = 36;
FBT_FACE_HB  = 38;
FBT_ROWS     = 256;

FBT_R_LEN   = 0;
FBT_R_NAME  = 1;
FBT_R_DEPTH = 49;
FBT_R_FLAGS = 50;    // bit0 expanded · bit1 is cwd · bit2 loaded and childless
FBT_R_TIDX  = 51;

FB_TREE_W   = 150;   // the rail's DEFAULT width. Wide enough for a pack name at
                     // depth 2 and no wider -- it buys its width back from the
                     // WINDOW now, but a docked instance still has to live
                     // inside what it has.
                     // ⭐ The user can drag the seam between the rail and the
                     // list; `fb_tw_off` is their OFFSET FROM THIS NUMBER, and
                     // swing_fb_tree_w() is the only thing that should be read.
FB_TREE_MIN = 90;    // below this a folder name is not readable at any depth
FB_TREE_MAX = 420;   // past this the rail is the feature and the list is a hint
FB_LIST_MIN = 150;   // the file list's floor. The DRAG may never push the list
                     // under this -- a smaller WINDOW still can, and the rail
                     // hides itself instead (see the layout block).
FB_SPLIT_HIT = 4;    // grab radius around the seam, so the target is 8 px wide.
                     // ⭐ A 1 px divider is not a control. REAPER's own splitters
                     // are about this, and the gutter chevron went 16 -> 24 for
                     // the same reason: a line you have to hunt for reads as
                     // trim, not as something you can move.
FB_SPLIT_GRIP = 20;  // half the handle's height. 17 -> 20: at 34 px the grip
                     // read as a smudge on the divider rather than as a part.
// ⛔ `fb_tw_off` IS DECLARED NOWHERE, ON PURPOSE. It is serialized (ver 68), and
// the house rule for that is: assigned nowhere in @init, and the default must BE
// the zero value -- @init can run AFTER @serialize, so an @init assignment would
// stamp the default back over the restored value. That is exactly why this is an
// OFFSET and not a width: 0 means 150. fb_open / fb_tree / multi_out / embed_mode
// all follow the same rule, and fb_fsz / fb_preview / fb_autoload are left
// unsaved because nobody had done the offset form yet. This is that form.

FB_PUB_SEQ  = 0;    // seqlock: odd = mid-write, even = stable
FB_GEN      = 1;
FB_ANS_REQ  = 2;
FB_TOTAL    = 3;
FB_WIN_OFF  = 4;
FB_WIN_N    = 5;
FB_FLAGS    = 6;    // bit0 scanning, bit1 unreadable/empty, bit2 at root,
                    // bit3 folder is starred, bit4 showing the PLACES list
FB_HB       = 7;    // liveness COUNTER, not a clock — this face has no wall clock
FB_FMT_VER  = 8;
FB_NDIRS    = 9;
FB_CWD_LEN  = 10;

FB_REQ_SEQ  = 32;   // written LAST
FB_REQ_OFF  = 33;
FB_REQ_N    = 34;
FB_REQ_VERB = 35;   // 1 enter folder · 2 up · 3 load row to pad
FB_REQ_RIDX = 36;
FB_REQ_PAD  = 37;
FB_REQ_COUNT = 41;  // verb 8 only: how many consecutive rows to load
FB_REQ_RECURSE  = 42;    // 1 = walk subfolders, 0 = this folder only
FB_REQ_GFXW     = 44;    // face->bridge: our current gfx_w, so the bridge can
                         // measure canvas-px per window-px instead of assuming
                         // 1:1 (true only while Swing stays off gfx_ext_retina)
FB_TR_RPT       = 11;    // bridge->face (P0a, the sequencer's transport row): REAPER's repeat state, 0 / 1
FB_TR_MEAS      = 12;    // bridge->face: the bar under the play (or edit) cursor, 1-based (TimeMap2_timeToBeats)
FB_TR_BEAT      = 13;    // bridge->face: the beat inside that bar x 1000 (0-based: 0 = the bar's first beat)
FB_REQ_GROW     = 43;    // face->bridge: px of extra CANVAS width wanted, so the
                         // window WIDENS instead of the strip taking the pads'
                         // room. JSFX cannot resize its own window -- the @gfx
                         // line is a hint REAPER reads once -- so the bridge
                         // does it with JS_Window_Resize. Measured 2026-08-29
                         // (.dev_tests/fbwin_probe.lua): +200 asked -> canvas
                         // +200, gfx_w +200, height untouched, restore exact.
FB_REQ_AUD      = 46;    // 1 = also load the PREVIEW voice on this click
FB_REQ_GROWH    = 58;    // face->bridge: px of extra CANVAS height wanted, so the window grows TALLER for the
                         // step sequencer's panel under the pads (rk_seq_ui swing_seq_gate; 2026-10-19).
                         // The same bridge resize as FB_REQ_GROW, the same adopt-on-first-sight and rate
                         // limit; the width probe measured height the same way (+120 asked -> +120 given).
// THE DOCKED KEYBOARD (2026-10-15; the user: "when swing is docked and the mini browser is open the keyboard
// dont work in the mini browser"). A plugin gets its keys through its FX window, and the dock rig
// (EON_Swing_Dock.lua) moves the canvas out of it, so docked Swing saw no keys at all. Now the dock catches
// them in its own window and queues them here, and the browser takes them one per frame as `_char`.
// FB_DOCK_KEYS (face -> dock, every frame): 2 = this Swing is the docked one and its browser holds the
// keyboard (the last click landed in the browser), 3 = the same with the filter box typing, 0 = no.
// FB_DOCK_KW (dock writes: keys queued so far), FB_DOCK_KR (face writes: keys taken so far), the ring
// FB_DOCK_KRING + (n % 8). The dock never writes past 8 unread keys.
FB_DOCK_KEYS    = 47;
FB_DOCK_KW      = 48;
FB_DOCK_KR      = 49;
FB_DOCK_KRING   = 50;    // ..57
FB_DOCK_KRING_N = 8;
FB_REQ_FILT_LEN = 192;   // verb 9: filter text length...
FB_REQ_FILT     = 193;   // ...and its chars, +193..240
FB_REQ_FILT_MAX = 48;
FB_REQ_LAYER = 40;  // verb 7 only: which layer to stack onto. CMD 64 needs an
                    // EXPLICIT index -- it does not pick a free one for you.
FB_REQ_INST = 39;   // face->bridge: OUR instance_id, so the load is routed to
                    // THIS Swing and not another one. Swing ignores CMD 63 whose
                    // KIT_GMEM_INSTANCE does not match its own instance_id -- the
                    // load silently does nothing without this, which is exactly
                    // how the first audition build came out silent (2026-08-29).
FB_FACE_HB  = 38;   // face->bridge: bumped every frame. Lets the bridge tell
                    // "nobody is looking" from "nothing has changed", and is
                    // the only outside-visible proof that @gfx ran at all.

FB_CWD      = 64;
FB_CWD_MAX  = 128;

FB_ROWS     = 256;
FB_REC      = 60;
FB_REC_MAX  = 64;

FB_R_LEN      = 0;
FB_R_NAME     = 1;
FB_R_NAME_MAX = 48;
FB_R_KIND     = 49;  // 0 file · 1 folder · 2 parent ".."
FB_R_EXT      = 50;
FB_R_RIDX     = 51;
FB_R_SIZE_KB  = 52;
FB_R_SR       = 53;
FB_R_CH       = 54;
FB_R_MS       = 55;
FB_R_PLKIND   = 56;  // places only: 1 starred, 2 recent, 3 drive
// ── FMT 2 (the next round, 2026-10-27; Spec_Swing_Mini_Browser_Next_Round §10; declared with core.SWBROWSE) ──
// The face writes FB_REQ_FMT = FB_FACE_FMT every frame; the bridge publishes the FMT 2 shape only then, and says so in
// FB_FMT_VER. A bridge that does not (an older one, until REAPER restarts it) gets today's data drawn in the new look.
FB_FACE_FMT   = 2;
FB_R_CAT      = 57;  // P2: glyph id + 1 (0 = none / not classified yet)
FB_R_PHASH    = 58;  // P3: the row's path as a 52-bit number (swing_fb_path_hash; 0 = none)
FB_R_CCOL     = 59;  // P2: the category's colour, r * 65536 + g * 256 + b
                     // FB_R_KIND 5 = a group LABEL (P1b): RIDX -1, SIZE_KB = its files shown, name = prefix, char 31, folder
FB_CAT_N      = 14;  // P2: categories present in the listing
FB_CAT_OFF    = 15;  // P2: the first category on this chip page
FB_CAT_TAB    = 16;  // P2: six pairs, 16..27: (id + 1) * 1,000,000 + count, packed colour
FB_CAT_ON     = 28;  // P2: the filter this view was built with, glyph id + 1 (0 = all)
FB_FILES_SHOWN = 29; // P1b: files in the view
FB_FILES_ALL  = 30;  // P1b: files in the listing
FB_REQ_CATF   = 59;  // face -> bridge: the category filter, glyph id + 1 (verb 17)
FB_REQ_FMT    = 60;  // face -> bridge: the format this face understands (45 is free, but the rigs' sandbox hooks use it)
FB_RN_RIDX    = 241; // P4, bridge -> face, outside the seqlock: the RIDX answered + 1, written LAST
FB_RN_NOTE    = 242; //   MIDI note + 1 (0 = no pitch)
FB_RN_STATE   = 243; //   1 running, 2 done, 3 failed
FB_RN_GEN     = 244; //   the listing's GEN it answers
FB_DK_RIDX    = 245; // P1b (seqlocked): the row last described + 1 ...
FB_DK_ORD     = 246; //   ... and its place among the files shown (0 = not shown)
FB_PH_W       = 5;   // P3: hashes kept per pad: its own path, then its layers 0..3
fb_catf = 0;         // P2: the category filter the face asked for (glyph id + 1); not saved

// ── geometry ────────────────────────────────────────────────────────────────
// The chevron lives in its OWN gutter on the OUTER edge, so the toggle stays
// put whether the panel is out or away. A drawer whose handle moves with it is
// the thing that makes collapsible sidebars feel broken.
FB_GUTTER_W = 24;   // was 16. A 16 px strip flush against the window's right
                    // edge is a poor target -- REAPER's own frame and resize
                    // area eat into it, and it reads as trim rather than as a
                    // control. 24 px with a visible seam and an arrow is
                    // unmistakably a button.
FB_PANEL_W  = 292;   // Poise's width: a name plus TWO narrow columns, not four
PFX_PANEL_W = 420;   // the pad editor's panel in the side slot (rk_swing_ui_padfx_side, round two J, 2026-10-22): the editor's
                     // own width (op_w), so its sections draw as they do in the overlay
SEQ_SIDE_W  = 600;   // the step sequencer's column when it is placed at the side (seq_place 1; the sideways render): its
                     // toolbar, chips and footer fold for the width on their own (rk_seq_ui swing_seq_panel_draw)
// ... and how far each may SQUEEZE beside the others before one becomes a tab (rk_swing_ui_padfx_side swing_side_fit; the
// owner, 2026-10-27: "squeeze before tabbing"), canvas px like the widths above -- each the narrowest its draw holds with
// nothing clipped or run together: the editor's 360 (its widest fixed row, Sum's TIGHT / LOOSE / VOL knob and dB, ends at
// ~348; the knob rows and the buttons spread with the width); the sequencer's 450 (the toolbar's first row -- the title's
// 96, the chips' floor 80, the page arrows round "STEPS 49-64", ON, OPT, the full face and the X -- needs ~446, the
// footer's step editor with a four-hit roll 446; the lanes' cells narrow, the feel takes its third row); the browser's
// is its own list floor (FB_LIST_MIN, the redraw's "Fit": nothing clips there) plus the rail's floor while the rail is on
PFX_SIDE_MIN_W = 360;
SEQ_SIDE_MIN_W = 450;
SIDE_W_MIN_B = 300;  // the side slot's narrowest DRAGGED width (its panels' part), design px (the width handle, 2026-10-22)
// Docked, the side slot may take up to 60 % of the docker's width from the pads (the owner, 2026-10-27; it was 45 %, as it
// still is for a float), but never so much that the pads' area left of the slot (the whole of it in the rack face a dock
// switches to) goes under SIDE_PADS_MIN_W_B -- a pad column ~98 px: the S / M / R pills 15, the VOL / PAN knobs r 9 --
// and never less than the old 45 % (a narrow docker squeezes the pads as it always did). swing_side_share_w.
SIDE_DOCK_SHARE = 0.60;
SIDE_PADS_MIN_W_B = 400;
FB_SEAM_W   = 8;     // the SEAM between the pads and the side panel: the slot's width handle (the user: "in between the pads
                     // and where the pad FX is"), part of the slot's width while it is open
FB_ROW_H    = 24;   // + fb_fsz at use sites, so bigger type still fits (22 -> 24: the redraw, P1a)
FB_HDR_H    = 32;    // breadcrumb: back, up, the folder you are in, the star, PLACES (+ fb_fsz)
FB_TOOL_H   = 30;    // the switch bar's row (+ fb_fsz); two rows of two segments when the labels do not fit
FB_FILT_H   = 30;    // the filter box (+ fb_fsz)
// (FB_STATUS_H, the old fixed 128 px status strip, is gone: the deck is a CARD sized by swing_fb_draw's layout --
// its wave gives way before the list goes under two rows.)
// Type sizes in one place. Everything was a notch small on a real screen.
// BASE sizes. fb_fsz is the user's offset on top -- the defaults read small on
// a real screen, so it starts at +2 rather than 0.
FB_FS_ROW   = 13;
FB_FS_HDR   = 13;
FB_FS_BTN   = 11;
FB_FS_STAT  = 12;
FB_FONT_N   = 5;

// ══ PREVIEW VOICE ═══════════════════════════════════════════════════════════
// The browser's OWN player. Auditioning used to BE loading -- the sample landed
// on a pad and the pad played it -- which is why it fought with AUTOLOAD, why it
// overwrote the kit, and why a misfire was silence with nothing to point at.
// This is a real voice instead: previewing never touches a pad, and play/stop/
// loop become controls that either work or visibly do not.
//
// ⭐ SIZE: ~11 s of stereo at 44.1 k. A seventeenth full pad slot would have cost
// SLOT_SIZE (4,000,000 floats, ~32 MB) for something that only ever holds one
// sample at a time; this is a quarter of that (~8 MB). Since 2026-10-14 it is a RING
// (Spec_Swing_Preview_Ring): the bridge keeps it topped up as the player
// consumes, so a longer file plays whole (up to the bridge's 120 s decode); the
// size is how far ahead the stream runs, not how long a file may be. ⛔ It still
// must not grow: it sits below the 64 M pad region in the same gmem grant.
FB_PRV_MAX = 1000000;

_prv_len  = 0;    // frames actually loaded (0 = nothing)
_prv_ch   = 0;
_prv_sr   = 0;
_prv_pos  = 0;    // fractional read position, owned by @sample
_prv_on   = 0;    // @block owns this; @sample only reads it
_prv_rate = 1;
// P5 (2026-10-27): the audition's pitch nudge -- fb_prv_semi (-12..+12, @gfx's: the stepper), _prv_pmul the read rate's
// multiplier (@block makes it, @sample only reads it: Swing_ReaKit.jsfx). Not saved, like fb_preview; never a load's.
fb_prv_semi = 0;
_prv_semi_seen = 0;
_prv_pmul = 1;
_prv_lf      = -1; // open handle while a sliced preview read is in flight
_prv_rd      = 0;  // cells read into _prv_buf so far by that job
_prv_loading = 0;  // 1 = a read is in flight; @block pumps it, @sample ignores it
// The RING (Spec_Swing_Preview_Ring, 2026-10-14): the buffer above is a ring the bridge
// keeps topped up as the player consumes, so a file is no longer cut at ~11 s. The
// player's positions are ABSOLUTE frames in the job's stream; its ring index is
// (_prv_ring_base + frame * 2) mod FB_PRV_MAX. These are the PLAYER's side; the incoming
// job's side (_pp_prv_*) lives in rk_swing_padpcm, so a new preview can land while the
// old voice still fades.
_prv_ring_base = 0;   // ring index of the player's stream offset 0 (0 on the old file-read path)
_prv_job = -1;        // the stream job the player plays (-1: the old file-read path, or nothing)
_prv_eos = 0;         // 1 = the stream's end (LAST) landed: reaching _prv_len is the END, not an underrun
_prv_long = 0;        // 1 = the file does not fit the ring: frame 0 is gone once played, PLAY after the end re-requests
_prv_total_frames = 0;// one pass of the file, frames (information)
_prv_hold_n = 0;      // @sample: samples held on an underrun (published as PP_PRV_HOLD; probes expect 0)
// Release envelope for the audition voice. The transport used to be a boolean:
// _prv_on went to 0 mid-waveform and the contribution to the master vanished in
// one sample, which is a step, which is a click -- at STOP, and again at the
// end of any file long enough to be truncated by FB_PRV_MAX, where the cut
// lands at whatever amplitude the buffer happened to end on. The pad voices
// have had a release since day one; this voice never got one.
// @block: was a CMD-69 request for THIS instance pending last block? The
// rising edge of that is the user asking for an audition -- the only event
// allowed to clear a STOP. See the edge detector in rk_swing_padpcm.
_prv_cmd_seen = 0;
_prv_env = 0;   // current gain, @sample owns it
_prv_tgt = 0;   // 1 = playing, 0 = releasing; @block sets it, @sample chases it
fb_prv_loop = 0;
fb_prv_gain = 0.7;
fb_prv_cmd  = 0;  // @gfx -> @block: 1 = play from the top, 2 = stop
_prv_stopped = 0; // @block owns this too: STOP was the last transport command, so a chunk
                  // of a stream still landing must not restart the audition (D-7);
                  // cleared by PLAY and by every new preview
_fb_was_open = 0; // @gfx: the strip was open on the previous frame (its close posts STOP)

// ── The audition transport, in ONE place ─────────────────────────────────────
// ⚠️⚠️ 3.0.14 SHIPPED SILENT AUDITIONS because this did not exist. The release
// envelope was added to the file-read completion and to PLAY, and the two
// STREAMED arming sites in rk_swing_padpcm.jsfx-inc were left setting _prv_on
// by hand -- so the voice switched on with _prv_env and _prv_tgt still at zero,
// rendered silence, and turned itself back off on the next sample. And the
// streamed path is the NORMAL one: a level-204 bridge consumes CMD 69 itself,
// and only "no bridge at all" falls through to the file read
// (Swing_ReaKit.jsfx, the CMD 69 block). The fallback worked; the path every
// customer uses did not.
// Five sites arm or release this voice -- file-read completion, streamed
// progressive, streamed LAST, stream failure, and PLAY/STOP. They all call
// these now, so the next field added to the transport cannot reach four of
// five again.
function swing_prv_kill()
(
  _prv_on = 0; _prv_env = 0; _prv_tgt = 0;
);
// len > 1, matching @sample's own gate: the 2-point interpolator addresses
// frame _prv_len - 2, so a one-frame buffer has nothing to play -- and arming
// it anyway latched _prv_on on with no renderer running to ever clear it.
function swing_prv_arm()
(
  _prv_len > 1 ? ( _prv_pos = 0; _prv_tgt = 1; _prv_on = 1; ) : swing_prv_kill();
);
// STOP and end-of-buffer only ASK. @sample ends the voice when the envelope
// reaches zero, which is the whole point of having one.
function swing_prv_release()
(
  _prv_tgt = 0;
);
fb_prv_name = -1; // row handle currently loaded, so the face can show it

function swing_fb_prv_init(mem_start)
(
  _prv_buf = mem_start;
  mem_start + FB_PRV_MAX;
);

// Load a file into the preview buffer. Runs from @block (file I/O), never @gfx.
// Mirrors load_from_path's reader, but into our own buffer and with no pad, no
// undo capture and no kit state touched -- that is the entire point.
//
// ⚠️ SLICED, in three parts. This used to be one function that opened the file,
// memset the whole 8 MB buffer and then pulled up to FB_PRV_MAX cells in a
// single @block -- an audition click cost a guaranteed dropout at any small
// device buffer. The pad loader had been sliced (swing_ldr_step's per-block
// budget) and this had not, so CMD 69 was the last unbounded read on the audio
// thread. The memset is gone outright: file_mem's return bounds _prv_len, the
// @sample reader is bounded by _prv_len, and nothing ever looks past it.
//
// Definition order matters -- EEL2 resolves function refs when a function is
// DEFINED, so abort must come before the begin that calls it.

// Drop a read in flight and close its handle. Safe to call when idle.
function swing_fb_prv_abort()
(
  _prv_loading && _prv_lf >= 0 ? file_close(_prv_lf);
  _prv_lf = -1; _prv_loading = 0; _prv_rd = 0;
);

// Open + riff only; the read is pumped by swing_fb_prv_step. Returns 1 if a job
// started. A new request supersedes whatever was in flight.
function swing_fb_prv_begin(path_str) local(nch, fsr)
(
  swing_fb_prv_abort();
  // Envelope zeroed HERE and nowhere else on the start path: this is where the
  // buffer stops holding the old file, so this is the only place the voice
  // genuinely restarts from silence. PLAY only raises _prv_tgt, so hitting it
  // while a release is still in flight ramps back up from wherever the envelope
  // got to -- resetting it to 0 there would step it down, which is the click
  // again, just somewhere new.
  swing_prv_kill();
  _prv_len = 0; _prv_pos = 0; _prv_stopped = 0;   // a new preview is a new request to hear (D-7)
  // the old (no-bridge) path fills the buffer linearly from 0: no ring, no wrap, the end is the end
  _prv_ring_base = 0; _prv_job = -1; _prv_eos = 0; _prv_long = 0;
  _prv_lf = file_open(path_str);
  _prv_lf >= 0 ? (
    file_riff(_prv_lf, nch, fsr);
    nch > 0 && nch < 3 ? (
      _prv_ch   = nch;
      _prv_sr   = fsr > 0 ? fsr : srate;
      _prv_rate = _prv_sr / srate;
      _prv_rd   = 0;
      _prv_loading = 1;
    ) : (
      file_close(_prv_lf); _prv_lf = -1;   // not mono or stereo: nothing to audition
    );
  ) : ( _prv_lf = -1; );
  _prv_loading;
);

// One slice, `budget` cells at most. Returns 1 once the load has landed or
// failed -- the caller starts the audition on that edge.
function swing_fb_prv_step(budget) local(m, n)
(
  !_prv_loading ? ( 1; ) : (
    m = min(budget, FB_PRV_MAX - _prv_rd);
    n = m > 0 ? file_mem(_prv_lf, _prv_buf + _prv_rd, m) : 0;
    _prv_rd += n;
    // A short read is end-of-file; a full buffer is the 11 s audition ceiling.
    n < m || _prv_rd >= FB_PRV_MAX ? (
      file_close(_prv_lf); _prv_lf = -1; _prv_loading = 0;
      // file_mem returns INTERLEAVED samples; frames is what the reader wants
      _prv_len = (_prv_rd / _prv_ch) | 0;
      _prv_total_frames = _prv_len; _prv_eos = 1;   // complete: the player's end is the end
      1;
    ) : ( 0; );
  );
);
// ── state ───────────────────────────────────────────────────────────────────
// ⚠️⚠️ fb_open is SERIALIZED (@serialize ver 66) and therefore must NOT be
// assigned here. EEL2 zero-init already gives it 0 = closed, and @init can run
// AFTER @serialize (see Swing_ReaKit.jsfx's _reb_restore_gen note) -- an @init
// assignment would quietly stamp a restored "open" back to closed. Same rule
// the shipping serialized vars follow: multi_out and embed_mode are declared
// nowhere in @init either. The same applies to fb_lcd, fb_subfolders, fb_font.
fb_scroll    = 0;
fb_sel       = -1;   // selected row HANDLE (FB_R_RIDX), NOT a page index:
                     // scrolling repaginates, and a page-relative index would
                     // silently move the highlight onto a different file.
_fb_seen     = -1;   // last FB_PUB_SEQ consumed
_fbt_flw     = -1;   // the tree's cwd row followed (or seen on screen) last; -1 = follow the next one (sweep BRW11)
_fb_n        = 0;
_fb_total    = 0;
_fb_off      = 0;
_fb_ndirs    = 0;
_fb_flags    = 0;
_fb_hb       = 0;
_fb_hb_last  = 0;
_fb_hb_still = 0;    // frames the heartbeat has not moved
_fb_reqseq   = 0;
_fb_lmb_prev = 0;
_fb_cmd_stuck = 0;   // frames the shared command channel has been busy
_fb_kbdir = 1;       // the keyboard walk's direction, for a landing on a group label (P1b)
_fb_fmt = 1;         // the format of the page on screen (FMT_VER): 2 = labels, chips, dots, tags (2026-10-27)

// ── options ─────────────────────────────────────────────────────────────────
// AUDITION: a clicked or arrowed file plays on the browser's OWN preview voice
// (bridge verb 12, or verb 3's REQ_AUD when AUTOLOAD also loads it) -- it never
// loads a pad; putting the file on the focused pad is AUTOLOAD's job. It is ON
// by default because that is the point of a browser, and a BUTTON so it can be
// silenced.
// Measured 2026-08-29: a load makes NO REAPER undo point, so walking the list
// costs nothing in undo history -- but Swing's own undo keeps only ONE level.
fb_preview = 1;
// AUTOLOAD: does a plain CLICK put the file on the focused pad, or only select
// it? Dragging always loads -- that gesture is explicit and says where. This
// only governs the click, so the list can be walked and read without touching
// the kit. OFF by default since 2026-10-15 (the user: "the autoload should not
// be on by default"): a click auditions, and with AUTOLOAD on the audition had
// to wait behind the pad load it queued first. Session-only, like fb_preview.
fb_autoload = 0;
// LCD: paint the strip in the theme's SCREEN colours instead of the pad tray,
// for the retro-hardware look. Off = it reads as part of the chassis.
// SUBFOLDERS: list the whole tree under here, not just this folder.
// Both SERIALIZED (ver 66) and both default OFF, so both rely on zero-init and
// are deliberately not assigned here — see the note at fb_scroll above.

// ── type options ────────────────────────────────────────────────────────────
// EEL2 cannot hold a font name in a variable and pass it around, so the family
// is an INDEX and one helper does the switch. Everything in the strip draws
// through it, which is also what makes a size offset possible at all.
// fb_font: 0 Arial - 1 Verdana - 2 Tahoma - 3 Segoe UI - 4 Consolas.
// SERIALIZED (ver 66), default 0 ⇒ zero-init, not assigned here.
fb_fsz  = 2;      // -2..+8 on top of the base sizes
// ⚠️ fb_fsz, fb_preview and fb_autoload are NOT persisted: the first two's
// defaults are non-zero (2, 1), and this codebase's serialize pattern requires the
// default to BE the zero value, because @init can run after @serialize and
// would stamp the restored value back. Persisting them needs an offset form
// (store value-minus-default) — worth doing, but it is a refactor of every use
// site, not a one-line gate. fb_autoload's default became 0 on 2026-10-15, so it
// COULD now be saved under a new serialize gate; it is not yet (session-only).
fb_settings_open = 0;

_fb_tc = 0.9; _fb_tw = 0; _fb_th = 0;   // shared by swing_fb_btn

// ── drag-to-pad ─────────────────────────────────────────────────────────────
// THE reason this browser is worth building. The list and the pad grid share
// ONE @gfx canvas, so this is just mouse down/move/up tracked by hand -- no OS
// drop target, no extension, no ImGui payload. The BIG browser can never have
// this gesture: it is a separate HWND and an ImGui payload cannot cross.
// Verified by probe 2 (2026-08-29): the release IS delivered while the cursor
// is outside the canvas, and mouse_x/y keep reporting true coordinates out
// there (negatives included) -- so the ghost can follow past the edge and a
// release away from the grid is a real cancel, not a stuck drag.
// 0 = idle, 1 = pressed (may still turn out to be a click), 2 = dragging.
fb_drag_state = 0;
fb_drag_ridx  = -1;
fb_drag_row   = -1;   // page row, for the ghost's name
fb_drag_ext   = 0;
fb_drag_pad   = -1;   // pad under the cursor, -1 = nothing
fb_drag_x0    = 0;
fb_drag_y0    = 0;
FB_DRAG_SLOP  = 4;    // px before a press becomes a drag rather than a click
fb_drag_layer = 0;    // resolved at drop time when ALT is held
fb_drag_count = 1;    // how many rows this drag carries
fb_drag_press = -1;   // the row handle PRESSED: a click acts on it (a range press carries the range in fb_drag_ridx)
fb_drag_keep  = 0;    // 1 = a plain press inside the range kept it; a click (no drag) collapses it to the row (sweep BRW15)
// Selection is a RANGE of row handles: fb_sel is the anchor, fb_sel_b the far
// end. Shift-click moves only the far end, so the anchor survives -- that is
// what makes a range feel like a range rather than two separate picks.
fb_sel_b = -1;

// ── filter ──────────────────────────────────────────────────────────────────
// ⚠️ MEASURED CONTRACT (rk_swing_padname_edit's header, kbprobe 2026-08-04):
// gfx_getchar() delivers letters/digits/backspace/enter when floating or in a
// chain; SEVERAL chars can land in ONE frame so the queue must be DRAINED; ESC
// arrives too (a physical press -- injected ESC is silently lost, wiki 7.4);
// and an EMBEDDED instance gets NO keyboard whatsoever -- so the box refuses
// focus there rather than looking editable and eating keys.
fb_filt_focus = 0;
fb_filt_len   = 0;

// Returns the bumped pointer, matching every other *_init in the suite.
function swing_fb_init(mem_start)
(
  _fb_rows = mem_start;
  _fb_cwd  = mem_start + FB_REC_MAX * FB_REC;
  _fb_knob = _fb_cwd + FB_CWD_MAX + 1;      // jo_knob_interact's own scratch
  _fb_trows = _fb_knob + 16;                // folder-tree page, same 64x60 shape
  // PREFAULT: NSEEL allocates gmem lazily on first write, and a face that only
  // ever READS a never-written block sees zeros forever. The FX picker learned
  // this the same way. One touch is enough to back the whole 65536 block.
  // ⚠️ Written back as READ, never 0: @init runs before @block has claimed a
  // registry slot (_reg_my_slot is -1 here), so the clamp lands on SLOT 0 --
  // another Swing's mailbox -- and a 0 stamped on its REQ_N could cut a request
  // of theirs in flight to an empty page (sweep BRW39/41, 2026-10-26).
  gmem[EON_SWBROWSE_BASE + max(0, min(EON_SWBROWSE_SLOTS - 1, _reg_my_slot)) * EON_SWBROWSE_STRIDE + FB_REQ_N]
    = gmem[EON_SWBROWSE_BASE + max(0, min(EON_SWBROWSE_SLOTS - 1, _reg_my_slot)) * EON_SWBROWSE_STRIDE + FB_REQ_N];
  gmem[EON_SWBPK_BASE + max(0, min(EON_SWBROWSE_SLOTS - 1, _reg_my_slot)) * EON_SWBPK_STRIDE]
    = gmem[EON_SWBPK_BASE + max(0, min(EON_SWBROWSE_SLOTS - 1, _reg_my_slot)) * EON_SWBPK_STRIDE];
  gmem[EON_SWBTREE_BASE + max(0, min(EON_SWBROWSE_SLOTS - 1, _reg_my_slot)) * EON_SWBTREE_STRIDE + FBT_REQ_N]
    = gmem[EON_SWBTREE_BASE + max(0, min(EON_SWBROWSE_SLOTS - 1, _reg_my_slot)) * EON_SWBTREE_STRIDE + FBT_REQ_N];
  _fb_cseg = _fb_trows + FB_REC_MAX * FB_REC;   // the breadcrumb's segments: 32 (start, end) pairs (the redraw)
  _fb_ph   = _fb_cseg + 64;                     // P3: the 64 pads' path hashes, FB_PH_W each
  _fb_ctab = _fb_ph + 64 * FB_PH_W;             // P2: the chip table's six pairs, copied with the page
  _fb_ctab + 12;
);

function swing_fb_tree_band()
(
  EON_SWBTREE_BASE
    + max(0, min(EON_SWBROWSE_SLOTS - 1, _reg_my_slot)) * EON_SWBTREE_STRIDE;
);

// Same seqlock discipline as the file list: read seq, read body, read seq
// again; odd or changed means discard and try next frame.
// ⚠️ NO REGISTRY SLOT, NO BAND (sweep BRW39/41, 2026-10-26): swing_fb_band and
// swing_fb_tree_band clamp _reg_my_slot = -1 to SLOT 0, another Swing's. Only
// the hello was guarded; the snapshot's per-frame writes, every request, the
// filter and the dock keys all drove Swing #1's strip from a seventeenth
// Swing (or one whose slot was re-claimed). Each of them is gated now, and
// the strip says so instead of showing a stranger's list.
function swing_fb_tree_snapshot()
  local(b, s1, s2, i, n)
(
  _reg_my_slot < 0 ? 0 : (
  b = swing_fb_tree_band();
  gmem[b + FBT_FACE_HB] = gmem[b + FBT_FACE_HB] + 1;
  s1 = gmem[b + FBT_PUB_SEQ];
  (s1 == _fbt_seen || (s1 % 2) == 1) ? (
    0;
  ) : (
    _fbt_total = gmem[b + FBT_TOTAL];
    _fbt_off   = gmem[b + FBT_WIN_OFF];
    _fbt_sel   = gmem[b + FBT_SEL];
    _fbt_flags = gmem[b + FBT_FLAGS];
    n = max(0, min(FB_REC_MAX, gmem[b + FBT_WIN_N]));
    // CELL BY CELL -- memcpy cannot cross from gmem into local memory, and with
    // ~72 MB of local it silently copies pad AUDIO instead of failing.
    i = 0; loop(n * FB_REC, _fb_trows[i] = gmem[b + FBT_ROWS + i]; i += 1;);
    s2 = gmem[b + FBT_PUB_SEQ];
    s2 == s1 ? ( _fbt_seen = s1; _fbt_n = n; 1; ) : 0;
  );
  );
);

function swing_fb_tree_request(verb, tidx)
  local(b)
(
  _reg_my_slot < 0 ? 0 : (   // no slot: slot 0's mailbox is another Swing's (sweep BRW41)
  b = swing_fb_tree_band();
  gmem[b + FBT_REQ_VERB] = verb;
  gmem[b + FBT_REQ_TIDX] = tidx;
  gmem[b + FBT_REQ_OFF]  = fbt_scroll;
  gmem[b + FBT_REQ_N]    = FB_REC_MAX;
  // Continue from the band, never from 0 -- see swing_fb_request.
  _fbt_reqseq < gmem[b + FBT_REQ_SEQ] ? _fbt_reqseq = gmem[b + FBT_REQ_SEQ]|0;
  _fbt_reqseq += 1;
  gmem[b + FBT_REQ_SEQ]  = _fbt_reqseq;     // written LAST
  );
);

// The rail's COMMITTED width -- what the user let go of, clamped. This is the
// one the WINDOW sizes itself to, so it must not move while a drag is in flight:
// the grow request has to stay a step function.
//
// ⚠️⚠️ THAT IS NOT A STYLE POINT. The 2026-08-30 docking regression was the
// grow request riding `gfx_w`, a per-frame quantity -- the bridge then resized
// the float on every tick and fought the dock the whole way, in Steppa too,
// because they share the bridge. A width that changed on every frame of a
// splitter drag is the SAME BUG with a different source. The live drag value
// lives in `_fb_tw_live` and never reaches the cap or the request.
function swing_fb_tree_w()
(
  max(FB_TREE_MIN, min(FB_TREE_MAX, FB_TREE_W + fb_tw_off));
);

// The panel width the strip would LIKE, whether it is open or not.
// Capped at 45% of the window: the rack/dock face is often only a few hundred
// px wide, where a fixed panel would leave the pads a sliver -- and the pads
// staying usable is the whole premise of dropping onto them.
// ── The side slot (round two J, 2026-10-22): the browser (unless placed below: fb_place 3), the pad editor (pfx_open)
// and the step sequencer when placed at the side (seq_place 1) share this column -- side by side when it has the room,
// tabs until it does (rk_swing_ui_padfx_side, imported after this lib and after rk_seq_ui). The gate below opens the
// slot, asks for width and squeezes on ANY of them, with the SUM of the open ones' widths. fb_open stays the browser's own.
function swing_side_open() ( (fb_open && fb_place != 3) || (pfx_open && fx_place != 3) || (seq_shown && seq_place == 1); );
// The panels' OWN want (plus the seam): what the bridge is asked to grow the window for.
function swing_side_auto_w() (
  ((fb_open && fb_place != 3) ? FB_PANEL_W + (fb_tree ? swing_fb_tree_w() : 0) : 0) + ((pfx_open && fx_place != 3) ? PFX_PANEL_W : 0) + ((seq_shown && seq_place == 1) ? SEQ_SIDE_W : 0) + swing_px(FB_SEAM_W);
);
// ... or the width the user DRAGGED the slot to (side_w, canvas px, gate 83; 0 = the panels' own widths), which the
// seam's handle sets (swing_side_handle): the slot's CAP. A dragged width never reaches the bridge (the user, 2026-10-22:
// "when i move the handle it resizes the window"): the window stays as it is and the pads give the difference, or take
// it back -- the gate's squeeze, immediate while a dragged width stands.
function swing_side_want_w() (
  side_w > 0 ? max(swing_px(SIDE_W_MIN_B), side_w | 0) + swing_px(FB_SEAM_W) : swing_side_auto_w();
);

// The most of a window w px wide the slot may take from the pads: 45 % (the old cap), docked (!_fb_growp: the dock rig
// holds this Swing) up to SIDE_DOCK_SHARE while the pads keep SIDE_PADS_MIN_W_B beside the slot and its gutter (the
// owner, 2026-10-27: "docked share 60 %"). The cap below and the gate's squeeze both read it.
// A width the user DRAGGED (side_w > 0, the seam's handle) docked: the pads' minimum is the only limit, never under the
// old 45 % (the owner, the same day: docked, the handle "only goes so far" -- it stopped at the 60 %); the automatic
// width (side_w 0) keeps the 60 %. A float as before.
function swing_side_share_w(w) (
  _fb_growp ? (w * 0.45) | 0
  : side_w > 0 ? max((w * 0.45) | 0, (w | 0) - FB_GUTTER_W - swing_px(SIDE_PADS_MIN_W_B))
  : max((w * 0.45) | 0, min((w * SIDE_DOCK_SHARE) | 0, (w | 0) - FB_GUTTER_W - swing_px(SIDE_PADS_MIN_W_B)));
);

function swing_fb_cap_w()
(
  _fb_capw_sw = swing_side_open() ? swing_side_want_w() : FB_PANEL_W + (fb_tree ? swing_fb_tree_w() : 0);
  // the 45 % cap guards the pads where the slot takes its room FROM them; a window that grew for the slot kept the pads'
  // width, so the cap is the want itself there (_fb_growp: the gate's can-grow latch; two panels, 736, would never fit
  // under 45 % of the window they grew; round two J, 2026-10-22). Docked: up to 60 % (swing_side_share_w).
  _fb_growp ? _fb_capw_sw : min(_fb_capw_sw, max(150, swing_side_share_w(gfx_w)));
);

// What the strip occupies RIGHT NOW. Computed once per frame in swing_fb_gate;
// layout, the input gate, the draw and the growth request all read this.
function swing_fb_width()
(
  fb_w_cur | 0;
);

function swing_fb_band()
(
  EON_SWBROWSE_BASE
    + max(0, min(EON_SWBROWSE_SLOTS - 1, _reg_my_slot)) * EON_SWBROWSE_STRIDE;
);

// The next key the dock rig queued for this browser (FB_DOCK_KEYS above), or 0. One per call; a backlog past
// the ring's eight is cut to the newest eight (the dock never writes past them, this is the belt to it).
function swing_fb_dock_key() local(b, kw, kr, k) (
  k = 0;
  _reg_my_slot >= 0 ? (   // no slot, no band (sweep BRW41)
    b = swing_fb_band();
    kw = gmem[b + FB_DOCK_KW] | 0; kr = gmem[b + FB_DOCK_KR] | 0;
    kw - kr > FB_DOCK_KRING_N ? kr = kw - FB_DOCK_KRING_N;
    kr < kw ? (
      k = gmem[b + FB_DOCK_KRING + (kr % FB_DOCK_KRING_N)] | 0;
      gmem[b + FB_DOCK_KR] = kr + 1;
    );
  );
  k;
);

// ── snapshot ────────────────────────────────────────────────────────────────
// Seqlock: read seq, read body, read seq again. Odd or changed = discard. The
// face runs at frame rate and the bridge publishes at defer rate, so a
// collision costs one frame and never a torn row.
function swing_fb_snapshot()
  local(b, s1, s2, i, n, cl)
(
  _reg_my_slot < 0 ? 0 : (   // no registry slot: slot 0's band is another Swing's (sweep BRW39/41)
  b = swing_fb_band();
  gmem[b + FB_FACE_HB] = gmem[b + FB_FACE_HB] + 1;   // I am here, and drawing
  // Ask for the window to WIDEN rather than take the width off the pads: the
  // request is the SUM of the side slot's open panels plus the seam
  // (swing_side_auto_w), with no easing. The bridge clamps it at 1000 px.
  //
  // A window that CANNOT grow (docked, embedded, no js_ReaScriptAPI) still gets
  // a correct strip: the 45% cap governs what it draws, so it falls back to the
  // squeeze on its own with nothing extra to write.
  // ⚠️⚠️ A CONSTANT, NOT swing_fb_cap_w(). The cap is derived from gfx_w, and
  // gfx_w changes on EVERY FRAME while a window is being docked or undocked --
  // so the request changed every frame, the bridge resized the floating window
  // every tick, and it fought the dock operation the whole way. Docking Swing
  // AND Steppa went stiff, because they share the bridge and the docker.
  // The request now moves only when a side panel opens, closes or changes width
  // (the browser, its tree, PAD FX, the sequencer). The 45% cap still
  // governs what the strip DRAWS (swing_fb_cap_w, used in the gate), so a small
  // window is still never swallowed -- it just hands the surplus back to the
  // panes instead of feeding it into a loop.
  // ⚠️ _fb_on -- the GATE's view of the slot this frame -- and not swing_side_open() live: a panel flag raised after the
  // gate ran but before this line (the PAD FX button once; a rig hook; any future caller) posted the request in the
  // same frame, the bridge widened the window within the tick, and the gate's first-frame baseline then took the GROWN
  // width as the bare one -- the slot sat 24 px wide for twenty frames and opened by the squeeze (the swap's audit,
  // 2026-10-22). Read from the gate, a flag raised late is posted a frame later, after the gate has baselined the
  // window it will grow. The want itself may move the same frame (a second panel beside an open one): the base stands.
  gmem[b + FB_REQ_GROW] = _fb_on ? swing_side_auto_w() : 0;   // the SUM of the side slot's open panels (round two J) -- never a dragged width (the seam splits the window that is there)
  // The docked keyboard (FB_DOCK_KEYS above): only the instance the dock rig captured (slider42, under its live
  // heartbeat -- the rack face's own test), only while its browser is open and holds the keyboard.
  !fb_open ? fb_kbd = 0;
  gmem[b + FB_DOCK_KEYS] = (fb_open && fb_kbd && slider42 > 0.5 && (time_precise() - gmem[GS_RIG_ALIVE_SWING]) < 2)
                           ? (fb_filt_focus ? 3 : 2) : 0;
  // The bridge has to know WHOSE window to widen, and growth must work before
  // the first request has ever been posted.
  gmem[b + FB_REQ_INST] = instance_id;
  // Our canvas width, so the bridge can MEASURE canvas-px per window-px rather
  // than assume 1:1. True today (Swing never sets gfx_ext_retina) -- but EON
  // Anvil, Drum Strip and FX Return View all DO, so the day someone adds it
  // here the growth would silently under-deliver on a scaled display.
  gmem[b + FB_REQ_GFXW] = gfx_w;
  gmem[b + FB_REQ_FMT] = FB_FACE_FMT;   // the format this face draws (P1b-P4): the bridge publishes FMT 2 only then
  _fb_hb = gmem[b + FB_HB];
  s1 = gmem[b + FB_PUB_SEQ];
  (s1 == _fb_seen || (s1 % 2) == 1) ? (
    0;
  ) : (
    _fb_total = gmem[b + FB_TOTAL];
    _fb_off   = gmem[b + FB_WIN_OFF];
    _fb_ndirs = gmem[b + FB_NDIRS];
    _fb_flags = gmem[b + FB_FLAGS];
    _fb_fmt   = gmem[b + FB_FMT_VER];   // 2 = the labels, the chips, the dots, the tags; 1 = an older bridge's page
    _fb_gen   = gmem[b + FB_GEN];
    _fb_ans   = gmem[b + FB_ANS_REQ];
    _fb_fmt >= 2 ? (
      _fb_catn = gmem[b + FB_CAT_N]; _fb_catoff = gmem[b + FB_CAT_OFF]; _fb_caton = gmem[b + FB_CAT_ON];
      i = 0; loop(12, _fb_ctab[i] = gmem[b + FB_CAT_TAB + i]; i += 1;);
      _fb_fshown = gmem[b + FB_FILES_SHOWN]; _fb_fall = gmem[b + FB_FILES_ALL];
      _fb_dkr = gmem[b + FB_DK_RIDX]; _fb_dko = gmem[b + FB_DK_ORD];
    ) : ( _fb_catn = 0; _fb_caton = 0; _fb_fshown = 0; _fb_fall = 0; _fb_dkr = 0; _fb_dko = 0; );
    // P2: once the bridge has answered our last chip press, its filter is ours (a new folder starts at ALL, and a
    // later "+N" press must not carry an old filter back)
    _fb_ans >= _fb_catf_seq ? fb_catf = _fb_caton;
    n = max(0, min(FB_REC_MAX, gmem[b + FB_WIN_N]));
    // ⚠️ CELL BY CELL. memcpy CANNOT cross from gmem into local memory — they
    // are separate address spaces, and because Swing's local memory runs to
    // ~72 MB a memcpy from 26,607,872 silently copies pad AUDIO into the row
    // buffer instead of failing. That exact mistake in the FX picker showed up
    // as box glyphs and rows starting two-thirds down the list.
    i = 0; loop(n * FB_REC, _fb_rows[i] = gmem[b + FB_ROWS + i]; i += 1;);
    cl = max(0, min(FB_CWD_MAX, gmem[b + FB_CWD_LEN]));
    i = 0; loop(cl, _fb_cwd[i] = gmem[b + FB_CWD + i]; i += 1;);
    _fb_cwd_len = cl;
    s2 = gmem[b + FB_PUB_SEQ];
    s2 == s1 ? ( _fb_seen = s1; _fb_n = n; 1; ) : 0;   // torn -> discard
  );
  );
);

// ── request ─────────────────────────────────────────────────────────────────
// REQ_SEQ is written LAST so the bridge never reads a half-formed request.
function swing_fb_request(verb, ridx, pad)
  local(b)
(
  _reg_my_slot < 0 ? 0 : (   // no slot: slot 0's mailbox is another Swing's (sweep BRW41)
  b = swing_fb_band();
  gmem[b + FB_REQ_VERB] = verb;
  gmem[b + FB_REQ_RIDX] = ridx;
  gmem[b + FB_REQ_PAD]  = pad;
  gmem[b + FB_REQ_OFF]  = fb_scroll;
  gmem[b + FB_REQ_N]    = FB_REC_MAX;
  gmem[b + FB_REQ_INST]  = instance_id;   // route the load back to THIS instance
  gmem[b + FB_REQ_LAYER] = fb_drag_layer;
  gmem[b + FB_REQ_COUNT] = fb_drag_count;
  gmem[b + FB_REQ_RECURSE] = fb_subfolders;
  gmem[b + FB_REQ_AUD]     = fb_preview;
  gmem[b + FB_REQ_CATF]    = fb_catf;          // P2: read by verb 17 only
  verb == 17 ? _fb_catf_seq = max(_fb_reqseq, gmem[b + FB_REQ_SEQ] | 0) + 1;   // the chip lit is ours until this is answered
  // ⭐ CONTINUE FROM THE BAND, NEVER FROM 0. The bridge takes a request only
  // when its number differs from the last one it saw for this slot, and it
  // remembers that across OUR reloads: a project switch, an undo that rebuilds
  // the FX, a chunk restore. This counter restarts at 0 on every one of those
  // while gmem keeps the old number -- so a reloaded strip whose predecessor
  // sent exactly one request (a hello and nothing else, i.e. every restored-
  // open strip) posted 1 on top of a seen 1 and the hello was swallowed. The
  // heartbeat kept climbing and the OLD listing stayed in the band, which is
  // why it looked fine (.dev_tests/fbhello_e2e.lua, 2026-09-02: GEN never
  // moved). Seeding from the band's own REQ_SEQ makes the number monotonic
  // for the life of the process, whoever held the slot before us.
  _fb_reqseq < gmem[b + FB_REQ_SEQ] ? _fb_reqseq = gmem[b + FB_REQ_SEQ]|0;
  _fb_reqseq += 1;
  gmem[b + FB_REQ_SEQ]  = _fb_reqseq;
  );
);

// Can this instance's window actually BE resized? Growth is the whole opening
// motion, and there are three cases where it is never going to happen: the dock
// rig has captured our canvas into a pane, REAPER has embedded us in the TCP, or
// js_ReaScriptAPI is missing so the bridge has nothing to resize with. In all
// three the strip has to fall back to taking room off the pads.
//
// ⛔ NOT `dock_face`. That goes to 1 on a WIDE FLOAT from the aspect-ratio
// trigger (Swing_ReaKit.jsfx, the AUTO branch), and a wide float grows perfectly
// well -- gating on it would kill growth for anyone who just likes a wide window.
// The question is who OWNS the window, not which face we happen to be wearing.
//
// ⚠️ slider42 is honoured only while OUR pane's heartbeat is fresh, the same
// gate Swing's own dock_face logic uses. GS_RIG_ALIVE (2626) is stamped by
// EITHER pane, so it would let Steppa's pane vouch for ours -- that exact
// confusion cost a day on 2026-08-30. GS_RIG_ALIVE_SWING is stamped only by
// EON Swing Dock.lua.
// The dock rig (EON_Swing_Dock.lua: the wordmark's dock) holds THIS Swing now -- its heartbeat fresh and this instance
// flagged (slider42): swing_fb_can_grow's own test, by name (rk_swing_ui_state swing_bot_slot, 2026-10-27).
function swing_dock_held() ( !is_embedded && (time_precise() - gmem[GS_RIG_ALIVE_SWING]) < 2 && slider42 > 0.5; );
// ... and the rig running at all (holding this Swing, another, or about to capture one): the slots' carry (below,
// rk_seq_ui swing_seq_gate) freezes across a dock's first frames on this.
function swing_dock_rig_up() ( (time_precise() - gmem[GS_RIG_ALIVE_SWING]) < 2; );

function swing_fb_can_grow()
(
  is_embedded ? 0
  : ((time_precise() - gmem[GS_RIG_ALIVE_SWING]) < 2 && slider42 > 0.5) ? 0
  : 1;
);

// The side seam's reach over the pads (2026-10-27; the owner: "Resizing the side and bottom panels: hard to grab"). With a
// panel open at the side, the slot's width handle (the seam, swing_side_handle) also takes the SIDE_SEAM_EXT px just left
// of it alongside the pad well, from grid_top down to ui_bot: the well's own right margin (rk_swing_ui_grid_pads: the well
// ends 4 px short of the pads' column and no pad control reaches into it), so no control loses a click there. Not beside
// the LCD bar or the bank strip above the well: their controls run to the column's edge, and there the control wins. The
// gate claims it (swing_fb_gate_window), the seam lights and the resize cursor shows over it. Not while a gesture on the
// pads is live (a pad swap, a mini knob: the drag is theirs). Fixed px, not scaled: the well's margin does not scale.
SIDE_SEAM_EXT = 4;
function swing_side_seam_ext(_se_mx, _se_my) local(_se_x) (
  _se_x = gfx_w - swing_fb_width();
  swing_side_open() && big_view_id == VIEW_NONE && !_grid_gesture_live && _se_mx >= _se_x - SIDE_SEAM_EXT && _se_mx < _se_x && _se_my >= grid_top && _se_my < ui_bot;
);

// Window and idle passes only: swing_fb_gate (below) is the entry point @gfx
// calls, and it skips embed passes whole (D-1).
function swing_fb_gate_window()
  local(_cap, _got, _cangrow, _fb_yield, _relatch)
(
  // ══ HOW MUCH WIDTH THE STRIP MAY TAKE, THIS FRAME ═════════════════════════
  // ⭐⭐ THE RULE: it only ever occupies width the WINDOW HAS ALREADY BEEN GIVEN.
  // It asks for the whole width at once and takes nothing until that width
  // arrives -- so the pads never move, and the browser appears in space that did
  // not exist a frame earlier. It reads as the window extending, because that is
  // exactly what happens.
  //
  // ⛔ The first version EASED the strip's own width instead. For every frame of
  // that easing the strip was claiming room the window did not have yet, so the
  // panes squeezed and then un-squeezed as the window caught up -- "it moves
  // Swing and then the panel opens", which is the very thing the easing was
  // meant to smooth. There is no animation here now and none is wanted: the
  // whole open costs one bridge tick.
  _fb_on   = swing_side_open();   // the slot: the browser OR the pad FX panel (round two J, 2026-10-22)
  _cangrow = swing_fb_can_grow();
  // ⚠️ THE LATCH BEFORE THE CAP IS MEASURED (sweep BRW9, 2026-10-26).
  // swing_fb_cap_w reads _fb_growp, and both measures below -- the first-frame
  // adopt and the re-baseline when the window changes hands -- took their cap
  // before the latch was seeded or moved: with two side panels open (870 px)
  // frame 1's 45 % cap put the baseline 128 px too wide, the pads jumped once
  // the squeeze latched, and a later dock + undock rebased on the grown width
  // and cut the panels short until the slot was reopened. _relatch remembers
  // that the latch moved this frame, for the re-baseline.
  _relatch  = _fb_w_init && _fb_growp != _cangrow;
  _fb_growp = _cangrow;           // seeded on frame 1 (never a transition), relatched after
  _cap      = swing_fb_cap_w();

  // First frame of this instance. A project that LOADS with the strip open gets
  // a window REAPER already restored at the grown size, so that width is treated
  // as ALREADY PRESENT rather than asked for again -- the bridge's first-sight
  // adopt makes the same assumption from the other side.
  _fb_w_init ? 0 : (
    _fb_base_w   = _fb_on ? (gfx_w - _cap) : gfx_w;
    _fb_base_set = 1;
    _fb_w_init   = 1;
  );

  // ⚠️⚠️ RE-BASELINE WHEN THE WINDOW CHANGES HANDS -- not only when the strip
  // closes. `_fb_squeeze` used to be cleared by the close-reset at the bottom of
  // this function and NOWHERE ELSE, so docking with the strip OPEN latched it:
  // the pads gave up their width, and undocking did not give it back, because
  // the reset needed `!fb_open` to fire. The window stayed narrow until you
  // closed the strip and opened it again, with nothing on screen saying why.
  // A dock or an undock invalidates the baseline anyway -- gfx_w means something
  // completely different on the other side of it -- so both directions measure
  // afresh from here.
  _relatch ? (
    // ⚠️⚠️ RE-BASELINE THE SAME WAY THE FIRST-FRAME ADOPT DOES, and for the same
    // reason: when the window already CARRIES the panel, gfx_w includes it, and
    // measuring the baseline as plain gfx_w would treat the grown width as the
    // new bare width and ask for another 292 on top. An undock is exactly that
    // case -- REAPER restores a float at the size it had, panel width included.
    // ⛔ But `fb_open` alone is NOT the test. Open the strip while DOCKED and the
    // window was never grown at all, so the float comes back its ordinary size;
    // subtracting the cap there would claim 292 px the pads still need. That is
    // what `_fb_carry` is for -- it is the last answer measured while the window
    // was ours to grow, and it is deliberately frozen across the dock.
    // 2026-10-27 (the dock's one-to-one): the WIDTH it carried (_fb_carry_w), not only whether it carried all of it. A
    // window the screen let grow only part of the way carried that part and squeezed the rest from the pads; read as
    // "carries nothing", the undock re-based on the whole float and the slot came back narrower than it left (measured
    // in a sandbox: 1308 -> 757, Pad FX + the sequencer side by side -> the sequencer alone). So the base takes off what
    // was carried, and a window that carried only part squeezes again at once.
    _fb_base_w   = (_fb_on && _fb_carry_w > 0) ? (gfx_w - _fb_carry_w) : gfx_w;
    _fb_base_set = 1;
    _fb_squeeze  = (_fb_on && _fb_carry_w > 0 && !_fb_carry) ? 1 : 0;
    _fb_wait     = 0;
  );

  _fb_on && !_fb_base_set ? ( _fb_base_w = gfx_w; _fb_base_set = 1; _fb_wait = 0; );

  // Width the window has actually gained since the strip was opened.
  _got = _fb_base_set ? max(0, gfx_w - _fb_base_w) : 0;

  // Fall back to taking the room off the pads when the window will not grow.
  // ⭐ TWO ROUTES IN, and the fast one matters. When we can SEE that growth is
  // impossible (docked or embedded) the squeeze is immediate -- the 20-frame
  // wait was a third of a second of the chevron visibly doing nothing before the
  // pads moved, every single time, in the one case we could have predicted.
  // The timeout stays for the case we CANNOT see: js_ReaScriptAPI missing, or a
  // Swing living somewhere the bridge's track-FX walk does not reach (a v7
  // container, take FX, input FX). There the request is posted, nothing answers,
  // and 20 frames later we stop waiting.
  _fb_on ? (
    _fb_wait += 1;
    (!_cangrow || side_w > 0 || (_fb_wait > 20 && _got < _cap - 2)) ? _fb_squeeze = 1;   // no growth, or PART of it (the screen's edge): the pads give the rest (round two J); a dragged width (the seam): at once
  ) : ( _fb_wait = 0; );

  // Is the window carrying the panel's width right now? Updated ONLY while the
  // window is ours to resize, so it freezes at its last honest value the moment
  // we dock -- which is what the transition above needs to read on the way back
  // out. -2 of slack because the grow is measured in window px and read back in
  // canvas px, and those need not divide evenly.
  // 2026-10-27 (the dock's one-to-one), after the squeeze: with no dock rig up the window is ours and this follows it
  // squeezed or not (_fb_carry_w, the width carried, for the relatch above: a want that grew on a long-open slot squeezes
  // at once and the window grows after -- frozen at the squeeze, the carried width missed that growth and the undock came
  // back narrower, measured in a sandbox 1344 -> 1197); with a rig up, a squeezed frame is frozen: the dock's first
  // frames have the canvas in the docker already and slider42 not yet set ("can grow"), and in a docker narrower than
  // the float the shrink read as "no longer carrying" (tb_test.py D, through the harness).
  _cangrow && (!_fb_squeeze || !swing_dock_rig_up()) ? (
    _fb_carry   = (_fb_on && _got >= _cap - 2) ? 1 : 0;
    _fb_carry_w = _fb_on ? min(_got, _cap) : 0;
  );

  // ⚠️ The cap is applied whether OPEN or CLOSED, deliberately. On a close the
  // request drops to 0 but the window is still wide for one tick; sizing the
  // panel from `fb_open` would blank it instantly and let the panes lunge into
  // space that is about to disappear -- the same reshape, in reverse.
  // the squeeze takes from the pads only what the window did not give, and never past 45 % of the window the slot
  // started from (the pads' floor, the old cap's meaning): a screen that allows part of the growth gets the rest from the
  // pads instead of a panel cut short at the right (the user, 2026-10-22: "the vol is cut off"; round two J). Docked: up
  // to 60 %, the pads' own minimum held (swing_side_share_w; the owner, 2026-10-27).
  _fb_room = _got + max(0, swing_side_share_w(_fb_base_w) - FB_GUTTER_W);
  fb_w_cur = FB_GUTTER_W + (_fb_squeeze ? (_fb_on ? min(_cap, _fb_room) : 0) : min(_cap, _got));

  // Window back where it started: forget the baseline so the next open measures
  // afresh (the user may have resized it in between).
  (!_fb_on && _got < 1) ? ( _fb_base_set = 0; _fb_squeeze = 0; );

  _fb_gx0 = gfx_w - swing_fb_width();      // the strip owns this column outright
  // The rack face has no 28 px header -- it has rack_hdr_h. Using 28 there would
  // leave a live strip of ungated pixels along the top of the panel.
  _fb_top = dock_face ? rack_hdr_h : 28;
  // ⛔ A full-window big view (FX picker, console, comp, EQ...) is painted AFTER
  // the strip and covers the whole canvas, but this gate runs before either of
  // them. Without the big_view_id test the strip went on claiming its column
  // while invisible, so the right ~316 px of EVERY big view was click-dead --
  // a whole column of picker cards, the right-most console strips. Found in the
  // 2026-08-29 growth audit; the strip has never referenced big_view_id.
  // ⚠️ ...and the strip YIELDS where something else owns the pixels (D-2, D-6,
  // Audit D 2026-09-14): the open THEME list (rkth_input runs in the header,
  // AFTER this gate, and the list paints last -- over the strip -- so with the
  // folder rail on every row from y = 28 down was dead and the click went to
  // the browser row beneath it: a folder change, or with AUTOLOAD a file load);
  // the rack face's change-map panel (its kdd_px ignores the strip's column);
  // and a gesture live on the pad grid -- a swap drag or a VOL/PAN mini-knob
  // drag drifting into the column ended the moment it crossed, because the zero
  // below is what the knob and the swap read as a release. The strip protects
  // its own drags the same way (fb_drag_state, below); the grid gets the same
  // courtesy. The list and panel rects are last frame's and the gesture flag is
  // last frame's: fine, none of them moves inside one frame.
  // ⚠️ The THEME MENU panel (2026-09-22) is the third rect in this list and it needs
  // the yield most: it drops from the THEME chip at the RIGHT end of the header,
  // straight into the strip's column, so without this arm the right-hand part of
  // every row — the CHIP half, the only part that takes a click — would be dead.
  _fb_yield = (thm_open && mouse_x >= thm_px && mouse_x < thm_px + thm_pw
                        && mouse_y >= thm_py && mouse_y < thm_py + thm_ph)
           || (rkth_open && mouse_x >= rkth_ddx && mouse_x < rkth_ddx + rkth_ddw
                         && mouse_y >= rkth_ddy && mouse_y < rkth_ddy + rkth_ddh)
           || (dock_face && kdd_open != KDD_MODE_NONE
               && mouse_x >= kdd_px && mouse_x < kdd_px + CHGMAP_PANEL_W
               && mouse_y >= kdd_py && mouse_y < kdd_py + CHGMAP_PANEL_H)
           || _grid_gesture_live;
  _fb_over = (big_view_id == VIEW_NONE && !_fb_yield
          && mx >= _fb_gx0 && mx < gfx_w
          && my >= _fb_top && my < ui_bot) || side_gdrag   // a width drag in flight keeps the claim (and the stash) wherever the cursor is   // the frame's copies of mouse_x / mouse_y (the rig's fake mouse sets them; round two J)   // ui_bot: the sequencer's gutter and panel own what is under it (swing_seq_gate)
          || (!_fb_yield && swing_side_seam_ext(mx, my));   // the seam's reach over the pads' margin (2026-10-27)
  _fb_over ? (
    // ⚠️ EEL2 identifiers are CASE-INSENSITIVE: _fb_g_lmb and _fb_g_LMB would be
    // ONE variable, and the second assignment would quietly eat the first.
    // Spelled out so the two halves of the mouse state cannot collide.
    _fb_g_lmbdown  = lmb_down;  _fb_g_rmbdown  = rmb_down;
    _fb_g_lmbclick = LMB;       _fb_g_rmbclick = RMB;
    _fb_g_wheel    = frame_wheel;
    lmb_down = 0; rmb_down = 0; frame_wheel = 0; LMB = 0; RMB = 0;
  ) : (
    _fb_g_lmbdown = 0; _fb_g_rmbdown = 0;
    _fb_g_lmbclick = 0; _fb_g_rmbclick = 0; _fb_g_wheel = 0;
  );
  // A drag that STARTED in the strip keeps the grid quiet for its whole life,
  // even once the cursor is out over the pads -- otherwise the drop click would
  // also register as a pad hit and trigger the pad it landed on.
  fb_drag_state == 2 ? ( lmb_down = 0; LMB = 0; frame_wheel = 0; );
  // A splitter drag can wander left over the pads before the button comes up.
  // Same insurance as above: the press already happened on the seam, so nothing
  // out there should act on the way past.
  fb_split_drag ? ( lmb_down = 0; LMB = 0; frame_wheel = 0; );
  // The gutter's width drag likewise (swing_side_handle): the cursor is out over the pads while the slot follows it.
  side_gdrag ? ( lmb_down = 0; LMB = 0; frame_wheel = 0; );
);

// ══ THE SURFACE TEST (D-1, Audit D 2026-09-14) ═══════════════════════════════
// The strip never appears in an EMBEDDED pass (TCP / MCP: swing_grid_draw_embedded
// is the whole frame there), but the gate above ran in every pass, and with
// swing_fb_can_grow at 0 in the embed its squeeze made fb_w_cur = 24 + cap on the
// embed's own canvas: the embed's right 24 px were click-dead (the rightmost
// pads and their VOL knobs), and 174 px with the strip open in the window --
// most of a TCP embed, the whole 82 px MCP embed. The embed reads none of the
// width machine and nothing consumes the stash there, so an embed pass SKIPS the
// gate whole -- the Drum Strip rule: embed passes must skip the panel, never
// clear it. The `_fb_*` width cells are left untouched too: the one-shot
// first-frame adopt and the re-baseline must measure a WINDOW canvas, not
// whichever surface REAPER painted first after a project load. Only the five
// stash cells are zeroed, so no late reader can act on the window's last click.
//
// ══ NO CLICK-THROUGHS ═══════════════════════════════════════════════════════
// The strip PAINTS last so it can cover pane content that overflows its column.
// But input runs in draw order, so by then every widget underneath has already
// tested the click. Painting last therefore fixes the picture and NOT the
// clicks -- a control whose rect reaches into this column would still fire.
//
// So input is claimed EARLY and separately, exactly the way swing_ui_modal_gate
// does it for overlays: stash the real mouse state, zero the shared frame
// globals so nothing beneath can act, and let the late draw restore its own
// copies for its own hit tests.
// Call this from @gfx BEFORE the panes draw. It is cheap and it is the only
// thing standing between a click on a file row and whatever sits behind it.
function swing_fb_gate()
(
  is_embedded ? (
    _fb_g_lmbdown = 0; _fb_g_rmbdown = 0;
    _fb_g_lmbclick = 0; _fb_g_rmbclick = 0; _fb_g_wheel = 0;
  ) : swing_fb_gate_window();
);

// ══ KEYBOARD ════════════════════════════════════════════════════════════════
// Walk the list without the mouse. This is the natural partner to the preview
// voice: arrow down, hear it, arrow down, hear the next one.
//
// ⚠️ Swing takes ONE char per frame off the queue into `_char` at the top of
// @gfx (Swing_ReaKit.jsfx, "Frame globals"). A handler that only calls
// gfx_getchar() therefore misses the first key of every frame -- at normal
// typing speed that is every key, which is how the filter box lost them all
// until 2026-09-30. The list below reads `_char` alone (one key per frame; the
// rest wait in the queue); swing_fb_filter_keys takes `_char` first and then
// drains the rest.
//
// ⚠️ ESC does arrive, WAK on or off (a physical press logs 27; the old "never"
// was the injection harness losing it -- kbprobe_default.jsfx, wiki 7.4). An
// EMBEDDED instance gets no keyboard whatsoever (measured, same probe).
FBK_UP    = 30064;        // 'up'
FBK_DOWN  = 1685026670;   // 'down'
FBK_LEFT  = 1818584692;   // 'left'
FBK_RIGHT = 1919379572;   // 'rght'
FBK_PGUP  = 1885828464;   // 'pgup'
FBK_PGDN  = 1885824110;   // 'pgdn'
FBK_HOME  = 1752132965;   // 'home'
FBK_END   = 6647396;      // 'end'

// Page row holding this handle, or -1.
function swing_fb_row_of(ridx) local(i, r)
(
  r = -1;
  i = 0;
  loop(_fb_n, _fb_rows[i * FB_REC + FB_R_RIDX] == ridx ? r = i; i += 1;);
  r;
);

// A NEW LISTING is coming (a folder, PLACES, the filter, a rescan). The row
// handles are indexes into each folder's own listing and restart in every one,
// so the selection, a keyboard landing still waiting for its page and the
// audition's row (what PLAY re-asks for after a long file's end) must not
// survive into it: Enter on a folder kept them, so a row with the same handle
// in the new folder showed selected and the next Enter loaded it onto the pad;
// PLAY after a folder change played the new folder's row (sweep BRW10 / BRW16,
// 2026-10-26). Every site that asks for a new listing calls this.
function swing_fb_relist()
(
  fb_sel = -1; fb_sel_b = -1; _fb_kbwant = 0; fb_prv_name = -1;
);

// Act on the row at `pr` in the CURRENT page, exactly as a click on it would.
function swing_fb_kb_select(pr) local(p, kind, ext)
(
  // A group LABEL (P1b) is never a stop: step on in the direction of the move (_fb_kbdir), or back the other way at
  // the page's edge (a label is always followed by a file of its group).
  _fb_rows[pr * FB_REC + FB_R_KIND] == 5 ? (
    (pr + _fb_kbdir >= 0 && pr + _fb_kbdir < _fb_n) ? pr += _fb_kbdir : pr -= _fb_kbdir;
    pr = max(0, min(_fb_n - 1, pr));
  );
  p    = _fb_rows + pr * FB_REC;
  kind = p[FB_R_KIND];
  ext  = p[FB_R_EXT];
  fb_sel = p[FB_R_RIDX]; fb_sel_b = fb_sel;
  kind == 0 ? (
    // Same three-way the click uses: load, or only audition, or only describe.
    // SFZ is a 16-pad kit import and is never walked onto a pad.
    (fb_autoload && ext != 10) ? ( swing_fb_request(3, fb_sel, sel_pad); fb_preview ? fb_prv_name = fb_sel; ) :
    (fb_preview  && ext != 10) ? ( swing_fb_request(12, fb_sel, -1); fb_prv_name = fb_sel; )
                               : swing_fb_request(5, fb_sel, -1);
  ) : swing_fb_request(5, fb_sel, -1);
);

function swing_fb_kb_move(d, vis) local(pos, np, i)
(
  _fb_kbdir = d < 0 ? -1 : 1;   // which way a landing on a group label steps (swing_fb_kb_select)
  _fb_total < 1 ? 0 : (
    // Where the selection is in ABSOLUTE terms: its place on this page plus the
    // window offset. A page index alone would move under us when the list
    // repaginates -- the same trap the status line hit.
    pos = -1;
    i = 0;
    loop(_fb_n,
      _fb_rows[i * FB_REC + FB_R_RIDX] == fb_sel ? pos = _fb_off + i;
      i += 1;
    );
    pos < 0 ? pos = _fb_off - 1;                 // nothing selected: start above
    np = max(0, min(_fb_total - 1, pos + d));
    // ⚠️⚠️ Against what is ON SCREEN, not against the loaded PAGE. The bridge
    // publishes up to 64 rows but the list only draws `vis` of them (~15), so
    // comparing with _fb_n let the selection walk 60 rows down inside the page
    // while the view never moved -- "page up and page down work but the view
    // doesn't follow". The visible window is [_fb_off, _fb_off + vis).
    (np < _fb_off || np >= _fb_off + min(_fb_n, vis)) ? (
      // Off the loaded page: scroll there and remember which row we were
      // heading for. ⚠️ One request per frame -- paging AND selecting in the
      // same frame would overwrite REQ_SEQ and the bridge would see only one.
      fb_scroll = max(0, min(max(0, _fb_total - vis), np - ((vis / 3) | 0)));
      _fb_kbwant = np + 1;                       // +1 so 0 can mean "none"
      swing_fb_request(0, 0, -1);
    ) : swing_fb_kb_select(np - _fb_off);
  );
);

function swing_fb_list_keys(vis) local(c, used, p)
(
  // ⚠️⚠️ ONE char, and ONLY the one Swing already drained. gfx_getchar() is
  // DESTRUCTIVE: a handler that loops on it eats every key in the frame,
  // including the ones the pad-name editor, the macro rename box and the popups
  // are waiting for -- so renaming a pad would silently stop working whenever
  // the strip happened to be open. Reading the shared `_char` and clearing it
  // only when we actually used it leaves every other handler intact.
  c = _char;
  used = 0;
  c == FBK_DOWN  ? ( swing_fb_kb_move(1, vis);       used = 1; ) :
  c == FBK_UP    ? ( swing_fb_kb_move(-1, vis);      used = 1; ) :
  c == FBK_PGDN  ? ( swing_fb_kb_move(vis, vis);     used = 1; ) :
  c == FBK_PGUP  ? ( swing_fb_kb_move(-vis, vis);    used = 1; ) :
  c == FBK_HOME  ? ( swing_fb_kb_move(-999999, vis); used = 1; ) :
  c == FBK_END   ? ( swing_fb_kb_move(999999, vis);  used = 1; ) :
  (c == FBK_LEFT || c == 8) ? (                // left / backspace = go up
    fb_scroll = 0; swing_fb_relist();
    swing_fb_request(2, 0, -1); used = 1;
  ) :
  (c == FBK_RIGHT || c == 13 || c == 10) ? (
    // Enter/Right: a folder opens, a file loads onto the focused pad. ALT
    // stacks it as a LAYER instead -- the same meaning the drag already has.
    fb_sel >= 0 ? (
      p = swing_fb_row_of(fb_sel);
      p >= 0 ? (
        _fb_rows[p * FB_REC + FB_R_KIND] > 0 ? (
          fb_scroll = 0; swing_fb_request(1, fb_sel, -1); swing_fb_relist();   // the selection stays behind (sweep BRW10)
        ) : ALT ? (
          fb_drag_layer = swing_pad_next_layer(sel_pad);
          fb_drag_count = 1;   // verb 7 takes REQ_COUNT files now: one here, not a drag's stale count
          swing_fb_request(7, fb_sel, sel_pad);
        ) : ( swing_fb_request(3, fb_sel, sel_pad); fb_preview ? fb_prv_name = fb_sel; );   // verb 3 carries REQ_AUD (sweep BRW16)
      );
    );
    used = 1;
  );
  used ? _char = 0;                            // ours; hide it from the rest
);

// Push the filter text over the wire. LEN is written LAST of the payload and
// REQ_SEQ last of all, same ordering rule as every other request.
function swing_fb_send_filter() local(i, n)
(
  _reg_my_slot < 0 ? 0 : (   // no slot: slot 0's mailbox is another Swing's (sweep BRW41)
  n = min(FB_REQ_FILT_MAX, strlen(#fb_filt));
  i = 0; loop(n, gmem[swing_fb_band() + FB_REQ_FILT + i] = str_getchar(#fb_filt, i); i += 1;);
  gmem[swing_fb_band() + FB_REQ_FILT_LEN] = n;
  swing_fb_request(9, 0, -1);
  );
);

// Drain the keyboard queue into the filter box.
// ⚠️⚠️ `_char` FIRST. The frame globals already took this frame's first key
// off the queue, so a loop that starts at gfx_getchar() never sees it -- the
// box lost the first key of every frame, which at normal typing speed is EVERY
// key (hand-tested 2026-09-30: "kick" typed normally left the box empty,
// "snare" in one burst arrived as "nare"). The pad-name editor and the macro
// rename box read the same way.
// ⚠️ SEVERAL characters can arrive in ONE @gfx frame (measured 3), so after
// `_char` this loops until the queue is empty rather than taking one per frame
// -- typing fast would otherwise drop letters. _char is consumed so the
// popup/overlay handlers do not also act on the same keystroke.
function swing_fb_filter_keys() local(c, changed)
(
  changed = 0;
  c = _char;
  while (c > 0) (
    c == 8 ? (                                   // backspace
      strlen(#fb_filt) > 0 ? (
        strcpy_substr(#fb_filt, #fb_filt, 0, strlen(#fb_filt) - 1);
        changed = 1;
      );
    ) : (c == 13 || c == 10) ? (                 // enter closes the box
      fb_filt_focus = 0;
    ) : (c >= 32 && c < 127) ? (
      strlen(#fb_filt) < FB_REQ_FILT_MAX ? (
        str_setchar(#fb_filt, strlen(#fb_filt), c);
        changed = 1;
      );
    );
    c = gfx_getchar();
  );
  _char = 0;                                     // consumed
  fb_filt_len = strlen(#fb_filt);
  changed ? ( fb_scroll = 0; swing_fb_relist(); swing_fb_send_filter(); );
);

// Every piece of type in the strip goes through here: it is the only place the
// family index becomes a name, and the only place the user's size offset lands.
function swing_fb_font(sz, bold) local(_s)
(
  _fb_fsz_last = sz; _fb_fbold_last = bold;   // the strip's current text face, for swing_fb_clipstr's re-assert
  _s = max(8, min(28, sz + fb_fsz));
  fb_font == 1 ? gfx_setfont(1, "Verdana",  _s, bold ? 'b' : 0) :
  fb_font == 2 ? gfx_setfont(1, "Tahoma",   _s, bold ? 'b' : 0) :
  fb_font == 3 ? gfx_setfont(1, "Segoe UI", _s, bold ? 'b' : 0) :
  fb_font == 4 ? gfx_setfont(1, "Consolas", _s, bold ? 'b' : 0) :
                 rk_font(1, _s, bold ? 'b' : 0);
);

function swing_fb_font_name(i)
(
  i == 1 ? "Verdana" : i == 2 ? "Tahoma" : i == 3 ? "Segoe UI" :
  i == 4 ? "Consolas" : "Arial";
);

// A SOLID five-point star in the current colour (the owner, 2026-10-27: "that star needs to be solid filled"; until then
// the title row drew a pentagram outline with a dot in it and a starred place an outline): centre (cx, cy), outer radius
// r. The inner pentagon in one call (gfx_triangle fills any CONVEX polygon), a triangle on each of its sides for the
// points, then the ten outer edges once more antialiased so a small star keeps clean points. The parts share edges, so
// the colour must be OPAQUE: under an alpha below 1 those edges draw twice and show as darker seams -- callers mix their
// colour against the ground first (swing_fb_mixset) or set gfx_a to 1.
function swing_fb_star(cx, cy, r) local(ri, i, a)
(
  ri = r * 0.382;   // a regular star's inner radius (sin 18 / sin 54)
  gfx_triangle(cx + cos(-0.9424778) * ri, cy + sin(-0.9424778) * ri, cx + cos(0.3141593) * ri, cy + sin(0.3141593) * ri,
               cx + cos(1.5707963) * ri, cy + sin(1.5707963) * ri, cx + cos(2.8274334) * ri, cy + sin(2.8274334) * ri,
               cx + cos(4.0840704) * ri, cy + sin(4.0840704) * ri);
  i = 0;
  loop(5,
    a = i * 1.2566371 - 1.5707963;   // 72 deg steps from the top; the inner corners 36 deg either side
    gfx_triangle(cx + cos(a) * r, cy + sin(a) * r, cx + cos(a - 0.6283185) * ri, cy + sin(a - 0.6283185) * ri,
                 cx + cos(a + 0.6283185) * ri, cy + sin(a + 0.6283185) * ri);
    gfx_line(cx + cos(a) * r, cy + sin(a) * r, cx + cos(a - 0.6283185) * ri, cy + sin(a - 0.6283185) * ri, 1);
    gfx_line(cx + cos(a) * r, cy + sin(a) * r, cx + cos(a + 0.6283185) * ri, cy + sin(a + 0.6283185) * ri, 1);
    i += 1;
  );
);

// One row icon, drawn to fit a box of side `s` centred on (cx, cy).
// kind: 0 file (the `ext` argument then picks waveform vs SFZ) - 1 folder -
// 2 parent ".." - 3 a PLACES row (`ext` carries the place kind) - 4 open folder.
// ⚠️ cx,cy is the CENTRE, not the top-left: every branch draws from cx - s/2.
// Getting that wrong is what buried the folder-tree icons under the twisty.
// Every row type gets a SHAPE, not a coloured block: at a glance you should be
// able to tell a sample from a folder from a shortcut without reading a word.
// ⭐ A wave file gets an actual WAVEFORM -- bars around a centre line. It is the
// one glyph that says "this is audio" with no label at all.
function swing_fb_icon(kind, ext, cx, cy, s) local(h, q, i, bh, a0)
(
  h = s * 0.5;
  q = s * 0.25;
  kind == 2 ? (                       // parent: a folder with the way back out
    gfx_rect(cx - h, cy - q, s, h * 1.4);
    gfx_rect(cx - h, cy - h * 0.8, h * 0.7, q * 0.8);
    gfx_line(cx, cy + q * 0.2, cx, cy - q * 0.6, 1);
    gfx_line(cx, cy - q * 0.6, cx - q * 0.5, cy - q * 0.1, 1);
    gfx_line(cx, cy - q * 0.6, cx + q * 0.5, cy - q * 0.1, 1);
  ) : kind == 1 ? (                   // folder: a tab and a body
    gfx_rect(cx - h, cy - q, s, h * 1.4);
    gfx_rect(cx - h, cy - h * 0.8, h * 0.7, q * 0.8);
  ) : kind == 4 ? (                   // OPEN folder: the one you are standing in
    // At 11 px an open folder cannot be a perspective drawing -- it just turns
    // into a shape. It is the same tab-and-body as kind 1 with the front leaf
    // slid out to the right and dimmed, which reads as open at any size and
    // still reads as a FOLDER, which is the point.
    gfx_rect(cx - h, cy - h * 0.8, h * 0.7, q * 0.8);          // tab
    gfx_rect(cx - h, cy - q, s * 0.74, h * 1.4);               // back leaf
    gfx_set(gfx_r, gfx_g, gfx_b, gfx_a * 0.5);
    gfx_rect(cx - h + q * 0.9, cy - q * 0.35, s * 0.78, h * 1.15);   // front leaf
  ) : kind == 3 ? (
    // A places row is one of THREE things and they were all the same bookmark,
    // so the list could not be read at all: a star you chose, a folder you
    // happened to be in, and a drive are not the same kind of entry.
    ext == 1 ? (                      // STARRED: a solid star, opaque (swing_fb_star: its parts share edges); the
                                      // callers' 0.9 alpha off the selected row goes to 1 for the star alone
      a0 = gfx_a; gfx_a = 1;
      swing_fb_star(cx, cy + h * 0.1, h * 1.1);   // a regular star sits low in its box: its lower points reach 0.81 r
      gfx_a = a0;
    ) : ext == 3 ? (                  // DRIVE: a stacked platter
      gfx_rect(cx - h, cy - q * 1.1, s, q * 0.9);
      gfx_rect(cx - h, cy + q * 0.2, s, q * 0.9);
      gfx_set(gfx_r, gfx_g, gfx_b, gfx_a * 0.45);
      gfx_rect(cx + q * 0.3, cy - q * 0.85, q * 0.5, q * 0.4);
      gfx_rect(cx + q * 0.3, cy + q * 0.45, q * 0.5, q * 0.4);
    ) : (                             // RECENT: a clock wound back
      gfx_circle(cx, cy, h * 0.9, 0, 1);
      gfx_line(cx, cy, cx, cy - h * 0.5, 1);
      gfx_line(cx, cy, cx + h * 0.45, cy + h * 0.15, 1);
    );
  ) : kind == 5 ? (                   // a group LABEL (P1b): no glyph -- a label is read, never acted on
    0;
  ) : ext == 10 ? (                   // SFZ: stacked layers, because it is a KIT
    gfx_rect(cx - h, cy - q * 1.4, s, q * 0.7);
    gfx_rect(cx - h, cy - q * 0.2, s, q * 0.7);
    gfx_rect(cx - h, cy + q,      s, q * 0.7);
  ) : (                               // AUDIO: a waveform
    i = 0;
    loop(7,
      // a fixed, symmetric envelope -- this is an icon, not the file's own shape
      bh = (i == 3) ? h : (i == 2 || i == 4) ? h * 0.72
         : (i == 1 || i == 5) ? h * 0.40 : h * 0.18;
      gfx_rect(cx - h + i * (s / 7), cy - bh, max(1, s / 11), bh * 2);
      i += 1;
    );
  );
);

// ══ THE REDRAW'S HELPERS (P1a, 2026-10-27; Spec_Swing_Mini_Browser_Next_Round §2, the look approved 2026-10-21) ════
// Every colour below comes from the ground (swing_fb_ground computes the surfaces and the one accent pair once a frame),
// so the strip reads right on all 14 themes and on both grounds. Fills are OPAQUE mixes of two known colours: a
// translucent fill through _rk_vu_rrect would double its alpha where its rects and corner discs overlap.

// gfx_set to a mix of two colours: t = 0 the first, 1 the second, alpha 1.
function swing_fb_mixset(r1, g1, b1, r2, g2, b2, t) (
  gfx_set(r1 + (r2 - r1) * t, g1 + (g2 - g1) * t, b1 + (b2 - b1) * t, 1);
);

// A filled rounded rectangle in the current colour: rk_vu's own fill helper, reused as it is (wiki §4.10: no fifth
// helper; rk_vu is imported before this file), with the sizes made whole and an empty box refused.
function swing_fb_rr(x, y, w, h, r) (
  w >= 1 && h >= 1 ? _rk_vu_rrect(x | 0, y | 0, w | 0, h | 0, max(0, min(r, min(w, h) * 0.5)));
);

// Draw string s from (x, y), at most maxw px wide: whole when it fits, else cut at a character with ".." after it
// (the rail's way; never a "..." prefix: three dots in front read as a menu). Returns the pen's x after it.
// The face is the one the caller last asked swing_fb_font for, set again here (wiki §4.3: set the font right before
// every measure; a glyph or a pill drawn between the caller's set and this call may have moved it).
// _fb_dw / _fb_dh are this function's measure outputs.
function swing_fb_clipstr(s, x, y, maxw) local(n, k, c, cw, ch, lim) (
  swing_fb_font(_fb_fsz_last, _fb_fbold_last);
  n = strlen(s);
  _fb_dw = 0; _fb_dh = 0;
  n > 0 ? gfx_measurestr(s, _fb_dw, _fb_dh);
  gfx_x = x; gfx_y = y;
  _fb_dw <= maxw ? ( n > 0 ? gfx_drawstr(s); ) : (
    gfx_measurestr("..", cw, ch);
    lim = x + maxw - cw;
    k = 0;
    while (k < n && (c = str_getchar(s, k); gfx_measurechar(c, cw, ch); gfx_x + cw <= lim)) (
      gfx_drawchar(c);
      k += 1;
    );
    gfx_x < x + maxw ? gfx_drawstr("..");
  );
  gfx_x;
);

// A row's name cells (byte by byte, as the bridge published them) into string dest: from cell `from`, n bytes,
// stopping early at a char-31 split (a label row's two parts). Returns the index after the last byte taken.
function swing_fb_rowstr(p, dest, from, n) local(k, c) (
  strcpy(dest, "");
  k = from;
  while (k < n && (c = p[FB_R_NAME + k]; c != 31)) (
    str_setchar(dest, strlen(dest), max(32, c));
    k += 1;
  );
  k;
);

// The magnifier, the refresh arrows, the pin, the cross: drawn glyphs (no font has them all). Centre (cx, cy), size s.
function swing_fb_glyph(which, cx, cy, s) local(r, i, a) (
  r = s * 0.5;
  which == 0 ? (                      // magnifier
    gfx_circle(cx - r * 0.18, cy - r * 0.18, r * 0.62, 0, 1);
    gfx_line(cx + r * 0.28, cy + r * 0.28, cx + r * 0.85, cy + r * 0.85, 1);
    gfx_line(cx + r * 0.32, cy + r * 0.24, cx + r * 0.89, cy + r * 0.81, 1);
  ) : which == 1 ? (                  // refresh: an open ring and its head
    i = 0;
    loop(10,
      a = 0.6 + i * 0.5;
      gfx_line(cx + sin(a) * r * 0.75, cy - cos(a) * r * 0.75, cx + sin(a + 0.5) * r * 0.75, cy - cos(a + 0.5) * r * 0.75, 1);
      i += 1;
    );
    gfx_triangle(cx + sin(0.6) * r * 0.75 - r * 0.42, cy - cos(0.6) * r * 0.75 - r * 0.05,
                 cx + sin(0.6) * r * 0.75 + r * 0.08, cy - cos(0.6) * r * 0.75 - r * 0.42,
                 cx + sin(0.6) * r * 0.75 + r * 0.2, cy - cos(0.6) * r * 0.75 + r * 0.25);
  ) : which == 2 ? (                  // pin (PLACES): a head and a point
    gfx_circle(cx, cy - r * 0.3, r * 0.45, 1, 1);
    gfx_triangle(cx - r * 0.3, cy - r * 0.05, cx + r * 0.3, cy - r * 0.05, cx, cy + r * 0.9);
  ) : (                               // cross
    gfx_line(cx - r * 0.55, cy - r * 0.55, cx + r * 0.55, cy + r * 0.55, 1);
    gfx_line(cx - r * 0.55, cy + r * 0.55, cx + r * 0.55, cy - r * 0.55, 1);
  );
);

// A button whose face is a GLYPH. Same chrome as the text one so they read as
// one family. which: 0 star - 1 gear - 2 back - 3 up - 4 the pin (PLACES) - 5 refresh - 6 clear.
// The redraw: no box at rest; a soft round ground under the mouse, the accent when `on`; thin chevrons.
function swing_fb_iconbtn(bx, by, bw, bh, which, on, dim, edge)
  local(hot, cx2, cy2, r, i, a)
(
  hot = mouse_x >= bx && mouse_x < bx + bw && mouse_y >= by && mouse_y < by + bh;
  (hot && !dim) || (on && which != 0) ? (
    on && which != 0 ? gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, 1)
                     : swing_fb_mixset(fb_lst_r, fb_lst_g, fb_lst_b, _fb_tc, _fb_tc, _fb_tc, 0.10);
    swing_fb_rr(bx, by, bw, bh, min(bw, bh) * 0.5);
  );
  cx2 = bx + bw * 0.5; cy2 = by + bh * 0.5;
  r = min(bw, bh) * 0.32;
  on && which != 0 ? gfx_set(fb_acc_t, fb_acc_t, fb_acc_t, 1)
                   : gfx_set(_fb_tc, _fb_tc, _fb_tc, dim ? 0.22 : (hot ? 1 : 0.72));
  which == 0 ? (                      // STAR -- solid, five points (the owner, 2026-10-27: "that star needs to be solid
                                      // filled"): the accent when this folder is starred, else the same shape in a dim
                                      // grey (lighter under the mouse). Opaque colours, mixed on the list's ground (the
                                      // header sits on it): swing_fb_star's parts share edges.
    on ? gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, 1)
       : swing_fb_mixset(fb_lst_r, fb_lst_g, fb_lst_b, _fb_tc, _fb_tc, _fb_tc, dim ? 0.22 : (hot ? 0.80 : 0.42));
    swing_fb_star(cx2, cy2 + r * 0.11, r * 1.12);   // centred on its height: a regular star's lower points reach 0.81 r
  ) : which == 1 ? (                  // GEAR
    gfx_circle(cx2, cy2, r * 0.92, 0, 1);
    gfx_circle(cx2, cy2, r * 0.38, 0, 1);
    i = 0;
    loop(8,
      a = i * 0.7853982;
      gfx_line(cx2 + cos(a) * r * 0.92, cy2 + sin(a) * r * 0.92,
               cx2 + cos(a) * r * 1.38, cy2 + sin(a) * r * 1.38, 1);
      i += 1;
    );
  ) : which == 2 ? (                  // BACK: a thin chevron
    gfx_line(cx2 + r * 0.35, cy2 - r * 0.8, cx2 - r * 0.45, cy2, 1);
    gfx_line(cx2 - r * 0.45, cy2, cx2 + r * 0.35, cy2 + r * 0.8, 1);
    gfx_line(cx2 + r * 0.35 + 1, cy2 - r * 0.8, cx2 - r * 0.45 + 1, cy2, 1);
    gfx_line(cx2 - r * 0.45 + 1, cy2, cx2 + r * 0.35 + 1, cy2 + r * 0.8, 1);
  ) : which == 3 ? (                  // UP: a thin chevron
    gfx_line(cx2 - r * 0.8, cy2 + r * 0.35, cx2, cy2 - r * 0.45, 1);
    gfx_line(cx2, cy2 - r * 0.45, cx2 + r * 0.8, cy2 + r * 0.35, 1);
    gfx_line(cx2 - r * 0.8, cy2 + r * 0.35 + 1, cx2, cy2 - r * 0.45 + 1, 1);
    gfx_line(cx2, cy2 - r * 0.45 + 1, cx2 + r * 0.8, cy2 + r * 0.35 + 1, 1);
  ) : which == 4 ? swing_fb_glyph(2, cx2, cy2, r * 2.2)
    : which == 5 ? swing_fb_glyph(1, cx2, cy2, r * 2.4)
    :              swing_fb_glyph(3, cx2, cy2, r * 1.8);
  hot && edge && !dim;
);

// One button: a rounded PILL, the accent when `on`, the list's ink tint when off. Returns 1 on the press edge inside it.
// _fb_tw/_fb_th are GLOBAL on purpose: gfx_measurestr writes through its args,
// and EEL2 function locals are the wrong shape for that.
function swing_fb_btn(bx, by, bw, bh, lbl, on, edge) local(hot)
(
  hot = mouse_x >= bx && mouse_x < bx + bw && mouse_y >= by && mouse_y < by + bh;
  on ? gfx_set(fb_acc_r * (hot ? 1.08 : 1), fb_acc_g * (hot ? 1.08 : 1), fb_acc_b * (hot ? 1.04 : 1), 1)
     : swing_fb_mixset(fb_lst_r, fb_lst_g, fb_lst_b, _fb_tc, _fb_tc, _fb_tc, hot ? 0.16 : 0.08);
  swing_fb_rr(bx, by, bw, bh, bh * 0.5);
  swing_fb_font(FB_FS_BTN, 1);
  _fb_tw = 0; _fb_th = 0;
  gfx_measurestr(lbl, _fb_tw, _fb_th);
  on ? gfx_set(fb_acc_t, fb_acc_t, fb_acc_t, 1) : gfx_set(_fb_tc, _fb_tc, _fb_tc, hot ? 1 : 0.78);
  gfx_x = bx + (bw - _fb_tw) * 0.5; gfx_y = by + (bh - _fb_th) * 0.5;
  gfx_drawstr(lbl);
  hot && edge;
);

// The switch row as ONE segmented bar: AUTOLOAD, AUDITION, SUBFOLDERS, TREE in one rounded track, only the lit
// segments filled with the accent, the GEAR an icon at the bar's right end. The labels shorten when they do not fit
// (SUBFOLDERS -> SUBFLD, then four short words); when even those do not fit the segments take two rows of two.
// Each segment is as wide as its word plus an equal share of what is left, so the long words fit a 292 px strip.
// Returns the height it used. Its presses are the old toolbar's, word for word.
function swing_fb_segbar(x, y, w, h, edge)
  local(gw, sw, tier, rows, i, sx, sy, sh, on, lbl, hot, tw, th, need, k, cw, av, l0, l1, l2, l3, ex)
(
  gw = h;                                            // the gear: a square at the right end
  av = w - gw - 4;                                   // the track's width
  swing_fb_font(FB_FS_BTN - 1, 1);
  // the tier whose four words fit the track in one row; none: two rows of two (the second tier's words)
  tier = 3; rows = 1;
  k = 0;
  loop(3,
    need = 0;
    i = 0;
    loop(4,
      lbl = k == 0 ? (i == 0 ? "AUTOLOAD" : i == 1 ? "AUDITION" : i == 2 ? "SUBFOLDERS" : "TREE")
          : k == 1 ? (i == 0 ? "AUTOLOAD" : i == 1 ? "AUDITION" : i == 2 ? "SUBFLD" : "TREE")
          :          (i == 0 ? "AUTO" : i == 1 ? "AUDIT" : i == 2 ? "SUB" : "TREE");
      tw = 0; th = 0; gfx_measurestr(lbl, tw, th);
      need += tw + 12;
      i += 1;
    );
    tier == 3 && need <= av ? tier = k;
    k += 1;
  );
  tier == 3 ? ( tier = 1; rows = 2; );
  // the four widths: the word + 12, plus an equal share of the rest of the row
  i = 0;
  loop(4,
    lbl = tier == 0 ? (i == 0 ? "AUTOLOAD" : i == 1 ? "AUDITION" : i == 2 ? "SUBFOLDERS" : "TREE")
        : tier == 1 ? (i == 0 ? "AUTOLOAD" : i == 1 ? "AUDITION" : i == 2 ? "SUBFLD" : "TREE")
        :             (i == 0 ? "AUTO" : i == 1 ? "AUDIT" : i == 2 ? "SUB" : "TREE");
    tw = 0; th = 0; gfx_measurestr(lbl, tw, th);
    i == 0 ? l0 = tw + 12 : i == 1 ? l1 = tw + 12 : i == 2 ? l2 = tw + 12 : l3 = tw + 12;
    i += 1;
  );
  rows == 1 ? ( ex = max(0, (av - l0 - l1 - l2 - l3) / 4); l0 += ex; l1 += ex; l2 += ex; l3 += ex; )
            : ( ex = (av - l0 - l1) / 2; l0 += ex; l1 += ex; ex = (av - l2 - l3) / 2; l2 += ex; l3 += ex; );
  sh = rows == 2 ? h * 2 - 2 : h;
  // the track
  swing_fb_mixset(fb_lst_r, fb_lst_g, fb_lst_b, fb_hln_r, fb_hln_g, fb_hln_b, 0.75);
  swing_fb_rr(x, y, av, sh, h * 0.5);
  i = 0;
  loop(4,
    sw = i == 0 ? l0 : i == 1 ? l1 : i == 2 ? l2 : l3;
    sx = x + (rows == 2 ? ((i % 2) ? (i == 1 ? l0 : l2) : 0) : (i == 0 ? 0 : i == 1 ? l0 : i == 2 ? l0 + l1 : l0 + l1 + l2));
    sy = y + (rows == 2 ? ((i / 2) | 0) * (h - 2) : 0);
    on = i == 0 ? fb_autoload : i == 1 ? fb_preview : i == 2 ? fb_subfolders : fb_tree;
    lbl = tier == 0 ? (i == 0 ? "AUTOLOAD" : i == 1 ? "AUDITION" : i == 2 ? "SUBFOLDERS" : "TREE")
        : tier == 1 ? (i == 0 ? "AUTOLOAD" : i == 1 ? "AUDITION" : i == 2 ? "SUBFLD" : "TREE")
        :             (i == 0 ? "AUTO" : i == 1 ? "AUDIT" : i == 2 ? "SUB" : "TREE");
    hot = mouse_x >= sx && mouse_x < sx + sw && mouse_y >= sy && mouse_y < sy + h;
    on ? ( gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, 1); swing_fb_rr(sx + 2, sy + 2, sw - 4, h - 4, (h - 4) * 0.5); )
       : hot ? ( swing_fb_mixset(fb_lst_r, fb_lst_g, fb_lst_b, _fb_tc, _fb_tc, _fb_tc, 0.10); swing_fb_rr(sx + 2, sy + 2, sw - 4, h - 4, (h - 4) * 0.5); );
    tw = 0; th = 0; gfx_measurestr(lbl, tw, th);
    on ? gfx_set(fb_acc_t, fb_acc_t, fb_acc_t, 1) : gfx_set(_fb_tc, _fb_tc, _fb_tc, hot ? 0.95 : 0.66);
    gfx_x = sx + (sw - tw) * 0.5; gfx_y = sy + (h - th) * 0.5;
    gfx_drawstr(lbl);
    hot && edge ? (
      // AUTOLOAD and AUDITION are separate on purpose: one decides whether a click
      // touches the kit at all, the other whether it makes a noise.
      i == 0 ? fb_autoload = !fb_autoload :
      i == 1 ? fb_preview = !fb_preview :
      // SUBFOLDERS walks the tree instead of the one folder -- the big browser's
      // own switch. Probe-measured 2026-08-29: a 25,000-file library walks in
      // 384 ms and the scan is chunked, so it streams in rather than freezing.
      i == 2 ? ( fb_subfolders = !fb_subfolders; fb_scroll = 0; swing_fb_relist();
                 swing_fb_request(10, 0, -1); ) :
               ( fb_tree = !fb_tree;
                 // Rebuild from wherever the list is standing, so the rail opens around
                 // the folder you are already in rather than somewhere you left days ago.
                 fb_tree ? ( fbt_scroll = 0; _fbt_pagereq = -1; _fbt_flw = -1; swing_fb_tree_request(3, 0); ); );
    );
    // a hairline between two unlit neighbours (a lit one carries its own edge)
    i < 3 && (rows == 1 || i == 0 || i == 2) && !on ? (
      cw = i == 0 ? fb_preview : i == 1 ? fb_subfolders : fb_tree;
      !cw ? ( gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.12); gfx_rect(sx + sw, sy + 6, 1, h - 12); );
    );
    i += 1;
  );
  swing_fb_iconbtn(x + w - gw, y, gw, h, 1, fb_settings_open, 0, edge) ? fb_settings_open = !fb_settings_open;
  sh;
);

// The strip's gutter: a 24 px column on the window's outer edge (FB_GUTTER_W: a 16 px strip read as trim), the seam
// on its inner edge, a thin chevron at mid-height that points the way the panel will MOVE. Painted by the browser's
// draw and by the side slot's own gutter (rk_swing_ui_padfx_side swing_side_gutter_draw), so the two look the same.
function swing_fb_gutter_paint(gx, y, h, hot, open) local(cx, cy, d) (
  swing_fb_mixset(_fb_gr, _fb_gg, _fb_gb, 0, 0, 0, fb_light ? 0.06 : 0.22);
  gfx_rect(gx, y, FB_GUTTER_W, h);
  gfx_set(fb_hln_r, fb_hln_g, fb_hln_b, 1); gfx_rect(gx, y, 1, h);
  hot ? ( swing_fb_mixset(_fb_gr, _fb_gg, _fb_gb, _fb_tc, _fb_tc, _fb_tc, 0.10); gfx_rect(gx + 1, y, FB_GUTTER_W - 1, h); );
  cx = gx + FB_GUTTER_W * 0.5; cy = y + h * 0.5;
  // a short grip above and below the chevron, so the column reads as a handle and not as the window's margin
  gfx_set(_fb_tc, _fb_tc, _fb_tc, hot ? 0.42 : 0.20);
  gfx_rect(cx - 1, cy - 34, 2, 18); gfx_rect(cx - 1, cy + 16, 2, 18);
  hot ? gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, 1) : gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.62);
  d = open ? -1 : 1;
  gfx_line(cx + 2 * d, cy - 5, cx - 2 * d, cy, 1); gfx_line(cx - 2 * d, cy, cx + 2 * d, cy + 5, 1);
  gfx_line(cx + 2 * d + d, cy - 5, cx - 2 * d + d, cy, 1); gfx_line(cx - 2 * d + d, cy, cx + 2 * d + d, cy + 5, 1);
);

// ══ P3 (2026-10-27, spec §5 option A): "on a pad" -- the face matches ════════════════════════════════════════════
// A path as ONE number, the bridge's eon_fb_path_hash to the bit (read that comment): normalized the same way ("\" ->
// "/", A-Z -> a-z, a run of separators -> one, a trailing one dropped), then h1 = (h1 * 31 + c + 1) mod 67108859 and
// h2 = (h2 * 37 + c + 1) mod 67108837 joined as h1 * 2^26 + h2 + 1 (0 = empty). Every step is a whole number under
// 2^32, held exactly in a double; the modulus is floor()-based (EEL2's % is not trusted with these sizes).
function swing_fb_path_hash(s) local(n, k, c, h1, h2, pend, cnt) (
  n = strlen(s); h1 = 7; h2 = 11; pend = 0; cnt = 0; k = 0;
  loop(n,
    c = str_getchar(s, k);
    c == 92 ? c = 47;
    c >= 65 && c <= 90 ? c += 32;
    c == 47 ? pend = 1 : (
      pend ? (
        h1 = h1 * 31 + 48; h1 -= floor(h1 / 67108859) * 67108859;
        h2 = h2 * 37 + 48; h2 -= floor(h2 / 67108837) * 67108837;
        cnt += 1; pend = 0;
      );
      h1 = h1 * 31 + c + 1; h1 -= floor(h1 / 67108859) * 67108859;
      h2 = h2 * 37 + c + 1; h2 -= floor(h2 / 67108837) * 67108837;
      cnt += 1;
    );
    k += 1;
  );
  cnt > 0 ? h1 * 67108864 + h2 + 1 : 0;
);

// The 64 pads' own sources and their layers' (every bank: a pad in another bank is tagged with its bank's letter),
// hashed every half second while the strip draws. Swing knows what is on its pads -- every load sets the path
// (get_path_slot; the root-note request sends the same) -- so the tag is right for every load route, at once. A load
// lands in @block: a path read half-written hashes to a number nothing has, i.e. no tag for half a second, never a
// wrong one. A pad that plays nothing carries no hash.
function swing_fb_pad_hashes() local(ap, L) (
  time_precise() - _fb_ph_t >= 0.5 || time_precise() < _fb_ph_t ? (
    _fb_ph_t = time_precise();
    ap = 0;
    loop(NUM_SLOTS,
      _fb_ph[ap * FB_PH_W] = pad_is_playable(ap) ? swing_fb_path_hash(get_path_slot(ap)) : 0;
      L = 0;
      loop(FB_PH_W - 1,
        _fb_ph[ap * FB_PH_W + 1 + L] = (pad_is_playable(ap) && L < p_layer_cnt[ap] && L < MAX_LAYERS)
                                       ? swing_fb_path_hash(LPATH_STR_BASE + ap * MAX_LAYERS + L) : 0;
        L += 1;
      );
      ap += 1;
    );
  );
);

// The first pad, by pad order, that holds this row's file: _fb_tag_ap (-1 = none) and _fb_tag_n, how many pads do.
function swing_fb_tag_of(h) local(ap, k, hit) (
  _fb_tag_ap = -1; _fb_tag_n = 0;
  h > 0 ? (
    ap = 0;
    loop(NUM_SLOTS,
      hit = 0; k = 0;
      loop(FB_PH_W, _fb_ph[ap * FB_PH_W + k] == h ? hit = 1; k += 1; );
      hit ? ( _fb_tag_n += 1; _fb_tag_ap < 0 ? _fb_tag_ap = ap; );
      ap += 1;
    );
  );
  _fb_tag_ap;
);

// The tag: a small pill in that pad's colour with its note's name, the bank letter in front when the pad is not in the
// bank on screen, a "+" when more pads hold the file. Right-aligned at rx, centred on cy. Returns its width (0 = none).
function swing_fb_tag_draw(ap, nmore, rx, cy) local(tw, th, w, lum) (
  ap < 0 ? 0 : (
    swing_lcd_note_str(#fb_tnote, p_note[ap] | 0);
    swing_pad_bank(ap) != bank_cur ? sprintf(#fb_tag, "%c %s", 65 + swing_pad_bank(ap), #fb_tnote) : strcpy(#fb_tag, #fb_tnote);
    nmore > 1 ? strcat(#fb_tag, "+");
    swing_fb_font(FB_FS_BTN - 2, 0);   // digits: regular below 10 px (wiki §4.7)
    tw = 0; th = 0; gfx_measurestr(#fb_tag, tw, th);
    w = tw + 12;
    swing_color_pad_hsl(ap, 0.55, fb_light ? 0.50 : 0.56);
    gfx_set(_hsl_r, _hsl_g, _hsl_b, 1);
    swing_fb_rr(rx - w, cy - 8, w, 16, 8);
    lum = _hsl_r * 0.299 + _hsl_g * 0.587 + _hsl_b * 0.114;
    lum > 0.55 ? gfx_set(0.08, 0.08, 0.08, 1) : gfx_set(1, 1, 1, 1);
    gfx_x = rx - w + 6; gfx_y = cy - th * 0.5; gfx_drawstr(#fb_tag);
    w;
  );
);

// ══ P2 (2026-10-27, spec §4): the CHIPS ═══════════════════════════════════════════════════════════════════════════
// ALL first (its count: the files in the listing), then the categories of the page the bridge sent, by count: a dot in
// the category's colour, its name (eon_catname: the pad category menu's words), its count. As many as fit in two lines;
// when not all categories are on show, a last "+N" chip asks for the page after the last one shown (the first page
// again past the end). A press asks verb 17 for that filter (the lit chip again = ALL); the chip lit is the one the face
// asked for until the bridge has answered, then the one its view was built with (a new folder starts at ALL).
// Returns the height used (0 = no chips: an older bridge, a places list). draw 0 = measure only.
FB_CHIP_H = 20;
function swing_fb_chips(x, y, w, edge, draw)
  local(k, n, id, cnt, col, cx, line, cw, tw, th, nw, lit, hot, ncat, plusw, room, nxt, h, cy)
(
  h = FB_CHIP_H + max(0, fb_fsz * 0.5) | 0;
  _fb_catn < 1 || _fb_fmt < 2 ? 0 : (
    lit = (_fb_ans >= _fb_catf_seq) ? _fb_caton : fb_catf;
    swing_fb_font(FB_FS_BTN - 1, 0);
    tw = 0; th = 0; gfx_measurestr("+99", plusw, th); plusw += 16;
    cx = x; line = 0; ncat = 0; k = -1;
    n = max(0, min(6, _fb_catn - _fb_catoff));
    while (k < n && line < 2) (
      k < 0 ? ( id = -1; cnt = _fb_fall; strcpy(#fb_chip, "ALL"); col = 0; ) : (
        id = ((_fb_ctab[k * 2] / 1000000) | 0) - 1; cnt = _fb_ctab[k * 2] - (id + 1) * 1000000; col = _fb_ctab[k * 2 + 1];
        eon_catname(#fb_chip, id);
      );
      tw = 0; th = 0; gfx_measurestr(#fb_chip, tw, th);
      sprintf(#fb_chipn, "%d", cnt);
      nw = 0; gfx_measurestr(#fb_chipn, nw, th);
      cw = (k < 0 ? 10 : 20) + tw + 5 + nw + 9;
      // the room this chip may take: on the last line, leave the "+N" its place when more remain after it
      room = x + w - cx - ((line == 1 && (_fb_catn - _fb_catoff - (k + 1)) > 0) ? plusw + 4 : 0);
      cw > room ? (
        line += 1; cx = x;
        room = x + w - cx - ((line == 1 && (_fb_catn - _fb_catoff - (k + 1)) > 0) ? plusw + 4 : 0);
      );
      line < 2 && cw > room ? line = 2;    // too wide even for a fresh line: the rest go under "+N"
      line < 2 ? (
        cy = y + line * (h + 4);
        draw ? (
          hot = mouse_x >= cx && mouse_x < cx + cw && mouse_y >= cy && mouse_y < cy + h;
          lit == id + 1 ? gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, 1)
                        : swing_fb_mixset(fb_lst_r, fb_lst_g, fb_lst_b, _fb_tc, _fb_tc, _fb_tc, hot ? 0.13 : 0.06);
          swing_fb_rr(cx, cy, cw, h, h * 0.5);
          k >= 0 ? (
            gfx_set(((col / 65536) | 0) / 255, (((col / 256) | 0) & 255) / 255, (col & 255) / 255, 1);
            gfx_circle(cx + 10, cy + h * 0.5, 3.5, 1, 1);
          );
          lit == id + 1 ? gfx_set(fb_acc_t, fb_acc_t, fb_acc_t, 1) : gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.85);
          gfx_x = cx + (k < 0 ? 9 : 18); gfx_y = cy + (h - th) * 0.5; gfx_drawstr(#fb_chip);
          lit == id + 1 ? gfx_set(fb_acc_t, fb_acc_t, fb_acc_t, 0.7) : gfx_set(_fb_tc, _fb_tc, _fb_tc, (_fb_flags & 64) ? 0.30 : 0.50);
          gfx_x += 5; gfx_drawstr(#fb_chipn);
          hot && edge ? (
            fb_catf = (k < 0 || lit == id + 1) ? 0 : id + 1;
            fb_scroll = 0; swing_fb_relist();
            swing_fb_request(17, _fb_catoff, -1);
          );
        );
        cx += cw + 4;
        k >= 0 ? ncat += 1;
        k += 1;
      );
    );
    // not every category on show: "+N" asks for the next page (the first again past the end)
    _fb_catn > ncat ? (
      line > 1 ? ( line = 1; cx = x + w - plusw; );
      line == 0 && cx + plusw > x + w ? ( line = 1; cx = x; );
      cy = y + line * (h + 4);
      draw ? (
        sprintf(#fb_chipn, "+%d", _fb_catn - ncat);
        hot = mouse_x >= cx && mouse_x < cx + plusw && mouse_y >= cy && mouse_y < cy + h;
        swing_fb_mixset(fb_lst_r, fb_lst_g, fb_lst_b, _fb_tc, _fb_tc, _fb_tc, hot ? 0.16 : 0.09);
        swing_fb_rr(cx, cy, plusw, h, h * 0.5);
        gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.85);
        tw = 0; gfx_measurestr(#fb_chipn, tw, th);
        gfx_x = cx + (plusw - tw) * 0.5; gfx_y = cy + (h - th) * 0.5; gfx_drawstr(#fb_chipn);
        hot ? swing_tooltip_check(1700, "More categories: the next ones by count.");
        nxt = _fb_catoff + ncat;
        hot && edge ? swing_fb_request(17, nxt >= _fb_catn ? 0 : nxt, -1);
      );
    );
    (min(line, 1) + 1) * (h + 4);
  );
);

// ══ P4 (2026-10-27, spec §6): the root-note pill's text ═════════════════════════════════════════════════════════
// Into #fb_root for the row the deck describes: "root F#3", "root -" when no pitch was found, "" while running, on a
// failure or for an answer that names another row or another listing (00-rules: an answer names what it answers).
// Read around RN_RIDX, which the bridge writes last. Returns the text's length (0 = no pill).
function swing_fb_root_text(sel) local(b, a1, a2, nt, stt, g) (
  strcpy(#fb_root, "");
  _reg_my_slot >= 0 && _fb_fmt >= 2 && sel >= 0 ? (
    b = swing_fb_band();
    a1 = gmem[b + FB_RN_RIDX]; nt = gmem[b + FB_RN_NOTE]; stt = gmem[b + FB_RN_STATE]; g = gmem[b + FB_RN_GEN];
    a2 = gmem[b + FB_RN_RIDX];
    a1 == a2 && a1 == sel + 1 && g == _fb_gen && stt == 2 ? (
      nt > 0 ? ( swing_lcd_note_str(#fb_rnote, nt - 1); sprintf(#fb_root, "root %s", #fb_rnote); ) : strcpy(#fb_root, "root -");
    );
  );
  strlen(#fb_root);
);

// ── draw ────────────────────────────────────────────────────────────────────
// The RAIL's own menu. "How do I get that out of the list?" has to be
// answerable from the row you are looking at.
// ⚠️ Only a STARRED root offers Remove -- a drive or a standard place is not
// ours to take away -- so fb_tmenu_rem adds it, as the LAST row (below).
function swing_fb_tmenu_open(mx, my)
(
  strcpy(#fb_menu, "#");
  strcat(#fb_menu, #fb_menu_name);
  // ⚠️⚠️ THE CONDITIONAL ITEM GOES LAST. With Remove in the middle the menu had
  // two different index tables and the handler had to consult a flag to know
  // which one was on screen -- so picking Remove could land on Reveal instead,
  // which is a menu item that appears to do nothing. Last means index 5 can
  // only ever BE Remove, and only exists when it is offered.
  //   1 header · 2 show · 3 expand/collapse · 4 reveal · 5 remove (if starred)
  strcat(#fb_menu, "|Show in the list|Expand / collapse|^g Reveal in Explorer");
  fb_tmenu_rem ? strcat(#fb_menu, "|^a Remove from this list");
  swing_popup_open(mx, my, #fb_menu, SP_POPUP_CALLER_FB_TREE);
);

// ══ THE FOLDER TREE ═════════════════════════════════════════════════════════
// A rail of folders beside the list. The LIST follows the TREE; the tree does
// not follow the list, so opening a pack never throws away where you were.
//
// ⭐ Every unexpanded folder shows a twisty whether or not it has children, and
// expanding an empty one just shows nothing. That is deliberate: asking "do you
// have children?" per visible row is one directory listing per row, and probe 1
// measured REAPER's listing cache as SINGLE-SLOT -- 40 rows of that during a
// scan ran 100x slower. A twisty that occasionally opens onto nothing is a far
// smaller cost than a browser that stalls while you scroll.
//
// The redraw (P1a, 2026-10-27): the rail is the ground itself; SECTION LABELS (STARRED / PLACES / DRIVES) replace the
// hairlines between the three top-level kinds (`(fl / 8) & 3`: 1 starred, 2 standard places, 3 drives), drives draw
// dimmer, and the folder you are in wears the list's selection band (inset, rounded, the accent edge on the left), so
// "here" looks the same in both halves.
FBT_LBL_H = 15;   // a section label's height (+ fb_fsz / 2)
function swing_fb_tree_draw(tx, ty, tw, th, edge)
  local(i, ry, rh, nlen, ci, hot, dep, fl, tidx, cx, cy, ind, vis, over, rk, lh, prevk, grp, dim, yy, sel, i1)
(
  swing_fb_tree_snapshot();

  gfx_set(_fb_gr, _fb_gg, _fb_gb, 1);
  gfx_rect(tx, ty, tw, th);
  gfx_set(fb_hln_r, fb_hln_g, fb_hln_b, 1);
  gfx_rect(tx + tw - 1, ty, 1, th);              // divider against the list

  rh   = 20 + max(0, fb_fsz);
  lh   = FBT_LBL_H + max(0, fb_fsz * 0.5) | 0;
  // The rows that fit: the section labels take room between the groups, so the page is counted the way it is drawn
  // (the follow below compares the cwd row against it).
  // The PROJECT root leads the places and sits in FRONT of the stars (eon_fb_tree_roots: the root that changes with
  // the work comes first): a place row before the page's first starred row is the project, and is captioned so --
  // otherwise PLACES would caption it and then again after the stars.
  vis = 0; yy = ty + 3; prevk = 0; i = 0; i1 = 1000;
  loop(_fbt_n, _fb_trows[i * FB_REC + FBT_R_DEPTH] == 0 && (((_fb_trows[i * FB_REC + FBT_R_FLAGS] / 8) | 0) & 3) == 1 && i1 > i ? i1 = i; i += 1; );
  i = 0;
  while (i < _fbt_n && yy + rh <= ty + th) (
    dep = _fb_trows[i * FB_REC + FBT_R_DEPTH];
    rk = dep == 0 ? ((_fb_trows[i * FB_REC + FBT_R_FLAGS] / 8) | 0) & 3 : 0;
    dep == 0 && rk > 0 && rk != prevk ? ( yy += lh; prevk = rk; );
    yy + rh <= ty + th ? ( vis += 1; yy += rh; ) : ( yy = ty + th; );
    i += 1;
  );
  yy < ty + th ? vis += max(0, ((ty + th - yy) / rh) | 0);   // past the page's rows: plain rows
  vis = max(1, vis);
  over = mouse_x >= tx && mouse_x < tx + tw && mouse_y >= ty && mouse_y < ty + th;

  over && _fb_g_wheel != 0 ? (
    fbt_scroll = max(0, min(max(0, _fbt_total - vis),
                            fbt_scroll - (_fb_g_wheel > 0 ? 3 : -3)));
    _fbt_pagereq != fbt_scroll ? (
      _fbt_pagereq = fbt_scroll; swing_fb_tree_request(0, 0);
    );
    // ⚠️ CONSUME it. The file list reads the same stashed wheel further down and
    // has no idea the rail exists, so without this one notch over the tree
    // scrolled BOTH columns at once.
    _fb_g_wheel = 0;
  ) : _fbt_sel >= 0 && _fbt_sel != _fbt_flw ? (
    // Follow the folder you are in -- ONCE per folder row (sweep BRW11,
    // 2026-10-26). _fbt_sel indexes the WHOLE tree, so it is compared against
    // the published window rather than the local scroll. The bridge keeps SEL
    // on the cwd's row while that row is inside its 64-row page, so a follow
    // on "off screen" fired again after every wheel-up that pushed the cwd
    // below the visible rows and snapped the rail back: the rows above it
    // (stars, places, drives) could not be reached by wheel. _fbt_flw is the
    // cwd row followed, or seen on screen, last; the rail's rebuilds reset it.
    _fbt_flw = _fbt_sel;
    (_fbt_sel < _fbt_off || _fbt_sel >= _fbt_off + vis) ? (
      fbt_scroll = max(0, _fbt_sel - ((vis / 3) | 0));
      _fbt_pagereq != fbt_scroll ? (
        _fbt_pagereq = fbt_scroll; swing_fb_tree_request(0, 0);
      );
    );
  );

  _fbt_prevk = 0;                 // group tracker, per draw
  grp = 0;                        // the top-level kind the row on the pen belongs to (0 = not known on this page)
  i = 0; ry = ty + 3;
  while (i < _fbt_n && ry + rh <= ty + th) (
    nlen = _fb_trows[i * FB_REC + FBT_R_LEN];
    dep  = _fb_trows[i * FB_REC + FBT_R_DEPTH];
    fl   = _fb_trows[i * FB_REC + FBT_R_FLAGS];
    tidx = _fb_trows[i * FB_REC + FBT_R_TIDX];

    // Top level groups itself: your stars, the standard places, then the
    // drives. A small caption where the kind changes turns eleven rows into
    // three short lists, and the icon says which is which.
    rk = dep == 0 ? ((fl / 8) | 0) & 3 : 0;
    dep == 0 ? grp = rk;
    dep == 0 && rk > 0 && rk != _fbt_prevk ? (
      swing_fb_font(9, 1);
      gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.42);
      gfx_x = tx + 10; gfx_y = ry + 3;
      gfx_drawstr(rk == 1 ? "STARRED" : rk == 2 ? (i < i1 && i1 < 1000 ? "PROJECT" : "PLACES") : "DRIVES");
      ry += lh;
      _fbt_prevk = rk;
    );
    ry + rh <= ty + th ? (
    dim = grp == 3;                                  // drives and what is under them: dimmer
    // Indent stops growing at depth 6 -- past that the name has nowhere left
    // to go and a deep library would push every row off the rail.
    // ⭐ 9 -> 7 PAYS FOR THE ICON COLUMN. The prefix in front of a name went
    // from 13 px to 22, and dropping 2 px per level hands most of that back: a
    // depth-1 row loses 7 px of name, depth 4 loses one, and depth 5 and deeper
    // come out AHEAD of where they were. Every row gains a folder icon for it.
    ind  = 6 + min(dep, 6) * 7;
    hot  = over && mouse_y >= ry && mouse_y < ry + rh;
    cy   = ry + (rh / 2) | 0;
    sel  = fl & 2;

    sel ? (
      swing_fb_mixset(_fb_gr, _fb_gg, _fb_gb, fb_acc_r, fb_acc_g, fb_acc_b, fb_light ? 0.16 : 0.26);
      swing_fb_rr(tx + 4, ry + 1, tw - 9, rh - 2, (rh - 2) * 0.5);
      gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, 1);
      swing_fb_rr(tx + 4, ry + 3, 3, rh - 6, 1.5);
    ) : hot ? (
      swing_fb_mixset(_fb_gr, _fb_gg, _fb_gb, _fb_tc, _fb_tc, _fb_tc, 0.07);
      swing_fb_rr(tx + 4, ry + 1, tw - 9, rh - 2, (rh - 2) * 0.5);
    );

    // ── TWISTY COLUMN: tx+ind .. tx+ind+10 ── (a thin chevron: down when open, right when not)
    !(fl & 4) ? (                                  // has, or may have, children
      cx = tx + ind + 3;
      gfx_set(_fb_tc, _fb_tc, _fb_tc, dim ? 0.32 : 0.50);
      (fl & 1) ? (
        gfx_line(cx - 3, cy - 2, cx, cy + 2, 1); gfx_line(cx, cy + 2, cx + 3, cy - 2, 1);
      ) : (
        gfx_line(cx - 1, cy - 4, cx + 2, cy, 1); gfx_line(cx + 2, cy, cx - 1, cy + 4, 1);
      );
    );

    // ── ICON COLUMN: centred on tx+ind+15, so it spans ind+9.5 .. ind+20.5 ──
    // ⛔⛔ THESE TWO USED TO SHARE ONE COLUMN. The icon was centred at ind+6 --
    // spanning ind+0.5 to ind+11.5 -- and the twisty drew at ind..ind+8 AFTERWARDS,
    // straight over the top of it. Every icon in the rail was painted out, so all
    // eleven rows read as an arrow and a word. And only the ROOTS ever asked for
    // one: `swing_fb_icon` was called under `dep == 0 && rk > 0`, so no actual
    // subfolder had an icon to lose in the first place.
    // Now: a folder on EVERY row, in the FILE LIST's colours so a folder is the
    // same object in both halves of the strip, and the folder you are standing
    // in (flags bit1) opens.
    // ⚠️ A starred root or a drive keeps its own glyph even when it IS the cwd:
    // the star is what makes that row findable, and the row highlight plus full
    // alpha already say you are here.
    rk == 1 ? gfx_set(0.95, 0.70, 0.22, sel ? 1 : 0.90) :   // starred
    rk == 3 ? gfx_set(0.55, 0.62, 0.72, sel ? 1 : 0.70)     // drive
            : gfx_set(0.86, 0.66, 0.30, sel ? 1 : (dim ? 0.62 : 0.85));    // folder
    rk == 1 ? swing_fb_icon(3, 1, tx + ind + 15, cy, 11) :
    rk == 3 ? swing_fb_icon(3, 3, tx + ind + 15, cy, 11)
            : swing_fb_icon((fl & 2) ? 4 : 1, 0, tx + ind + 15, cy, 11);

    // ⚠️ CLIPPED TO THE RAIL, not to a character count. A fixed 26-char cap is
    // wrong twice over: proportional fonts make 26 chars any width they like,
    // and an indented row has less room than a top-level one -- so long library
    // names ran straight past the divider and painted over the file list.
    // Drawing until the pen reaches the edge is exact at any depth or font.
    swing_fb_font(FB_FS_ROW - 1, sel ? 1 : 0);
    gfx_set(_fb_tc, _fb_tc, _fb_tc, sel ? 1.0 : (dim ? 0.58 : 0.84));
    strcpy(#fb_tname, "");
    ci = 0; loop(min(nlen, FB_R_NAME_MAX), str_setchar(#fb_tname, ci, max(32, _fb_trows[i * FB_REC + FBT_R_NAME + ci])); ci += 1;);
    swing_fb_clipstr(#fb_tname, tx + ind + 23, ry + ((rh - gfx_texth) / 2) | 0, tw - ind - 23 - 7);

    // The twisty toggles, the ICON AND NAME navigate. Two targets in one row, so
    // the split has to be somewhere the eye already sees: the glyph's own column.
    // ⚠️ 12 -> 10, to match the twisty column above. Left at 12 it reached 2 px
    // into the folder icon, so the left edge of a folder toggled instead of
    // opening it -- the kind of near-miss that just feels like a missed click.
    hot && edge ? (
      mouse_x < tx + ind + 10 && !(fl & 4) ?
        swing_fb_tree_request(1, tidx) :
        ( swing_fb_tree_request(2, tidx); swing_fb_relist(); );   // the list follows: a new listing (sweep BRW10)
    );
    hot && _fb_g_rmbdown ? (
      fb_tmenu_tidx = tidx;
      // ⚠️ Recomputed from `fl` rather than read from the `rk` local. A local in
      // this file was measured going stale mid-function (the drag promotion),
      // and this one decides whether the menu OFFERS Remove at all -- a stale
      // 0 here is a starred folder you cannot get rid of.
      fb_tmenu_rem  = (dep == 0 && (((fl / 8) | 0) & 3) == 1) ? 1 : 0;
      strcpy(#fb_menu_name, "");
      ci = 0; loop(min(nlen, 30),
        str_setchar(#fb_menu_name, ci, _fb_trows[i * FB_REC + FBT_R_NAME + ci]);
        ci += 1;);
      swing_fb_tmenu_open(mouse_x, mouse_y);
    );

    ry += rh;
    );
    i += 1;
  );

  _fbt_n < 1 ? (
    gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.45);
    swing_fb_font(FB_FS_STAT, 0);
    gfx_x = tx + 10; gfx_y = ty + 10;
    gfx_drawstr((_fbt_flags & 1) ? "Opening..." : "No folders");
  );
);

// ══ RIGHT-CLICK MENU ════════════════════════════════════════════════════════
// Swing-styled popup, not gfx_showmenu -- the rest of the plugin migrated off
// that deliberately and a native menu here would look imported.
//
// ⚠️ Selection is by 1-BASED INDEX and the '#' header counts as item 1, so the
// labels are display-only and cannot break routing. Keep the numbering below in
// step with the strings or a menu pick fires the wrong action.
//
// The popup has no nested submenus, so "Add as layer" opens a SECOND popup at
// the same point. Two clicks, and the layer list gets the whole menu to itself
// rather than four cramped rows -- which is what makes it easy to hit.
function swing_fb_menu_open(mx, my) local(i)
(
  fb_menu_x = mx; fb_menu_y = my;
  strcpy(#fb_menu, "#");
  strcat(#fb_menu, #fb_menu_name);
  fb_menu_kind == 0 ? (
    //  2 load · 3 layer · 4 preview · 5 reveal · 6 copy · 7 star
    // An SFZ (ext 10) is a 16-pad kit import the big browser does: the bridge
    // refuses it on verbs 3, 7 and 12, so the three are greyed rather than
    // offered and silently refused (sweep BRW40, 2026-10-26).
    strcat(#fb_menu, fb_menu_ext == 10 ? "|^g Load onto pad|^g Add as layer...|^g Preview"
                                       : "|Load onto pad|Add as layer...|Preview");
    strcat(#fb_menu, "|^g Reveal in Explorer|^g Copy path|^a Star this folder");
  ) : (
    //  2 open · 3 star
    strcat(#fb_menu, "|Open|^a Star this folder|^g Reveal in Explorer");
  );
  swing_popup_open(mx, my, #fb_menu, SP_POPUP_CALLER_FB_ROW);
);

function swing_fb_menu_layers() local(i)
(
  //  2 next free, then 3.. = layer 1..MAX_LAYERS
  strcpy(#fb_menu, "#Add as layer|^b Next free layer");
  i = 0;
  loop(MAX_LAYERS,
    strcat(#fb_menu, "|Layer ");
    strcat(#fb_menu, sprintf(#fb_menu_num, "%d", i + 1));
    i += 1;
  );
  swing_popup_open(fb_menu_x, fb_menu_y, #fb_menu, SP_POPUP_CALLER_FB_LAYER);
);

// Act on a pick. Split out so the index table lives next to the strings above.
// ⚠️ Reads swing_popup_result DIRECTLY rather than caching it in a local: a
// local in this file was measured going stale mid-function (see the drag
// promotion), and a menu that silently picks the wrong item is the same class
// of failure as a drag that silently does nothing.
function swing_fb_menu_result()
(
  (swing_popup_result > 0 && swing_popup_caller_id == SP_POPUP_CALLER_FB_ROW) ? (
    // "Star this folder" is the ROW's folder -- verb 16 with the row (the
    // bridge stars a folder row's path, a file's folder, a place): verb 11
    // with handle 0 starred, or UNSTARRED, the folder you were standing in
    // (sweep BRW12, 2026-10-26). The audition's row follows a Load (verb 3
    // carries REQ_AUD) and a Preview, so PLAY after a long file's end re-asks
    // for the right one (sweep BRW16); an SFZ's greyed rows do nothing (BRW40).
    fb_menu_kind == 0 ? (
      (fb_menu_ext == 10 && swing_popup_result <= 4) ? 0 :
      swing_popup_result == 2 ? ( swing_fb_request(3, fb_menu_ridx, sel_pad); fb_preview ? fb_prv_name = fb_menu_ridx; ) :
      swing_popup_result == 3 ? swing_fb_menu_layers() :
      swing_popup_result == 4 ? ( swing_fb_request(12, fb_menu_ridx, -1); fb_prv_name = fb_menu_ridx; ) :
      swing_popup_result == 5 ? swing_fb_request(14, fb_menu_ridx, -1) :
      swing_popup_result == 6 ? swing_fb_request(15, fb_menu_ridx, -1) :
      swing_popup_result == 7 ? swing_fb_request(16, fb_menu_ridx, -1);
    ) : (
      swing_popup_result == 2 ? ( fb_scroll = 0; swing_fb_request(1, fb_menu_ridx, -1); swing_fb_relist(); ) :
      swing_popup_result == 3 ? swing_fb_request(16, fb_menu_ridx, -1) :
      swing_popup_result == 4 ? swing_fb_request(14, fb_menu_ridx, -1);
    );
    // ⚠️ NOT consumed when it opened the layer step: swing_fb_menu_layers has
    // just set a new result/caller pair and clearing here would wipe it.
    swing_popup_result == 3 && fb_menu_kind == 0 && fb_menu_ext != 10 ? 0 : ( swing_popup_result = 0; );
  ) : (swing_popup_result > 0 && swing_popup_caller_id == SP_POPUP_CALLER_FB_TREE) ? (
    //  2 show · 3 expand/collapse · 4 reveal · 5 remove (starred roots only)
    swing_popup_result == 2 ? ( swing_fb_tree_request(2, fb_tmenu_tidx); swing_fb_relist(); ) :
    swing_popup_result == 3 ? swing_fb_tree_request(1, fb_tmenu_tidx) :
    swing_popup_result == 5 ? swing_fb_tree_request(4, fb_tmenu_tidx) :
                              swing_fb_tree_request(5, fb_tmenu_tidx);
    swing_popup_result = 0;
  ) : (swing_popup_result > 0 && swing_popup_caller_id == SP_POPUP_CALLER_FB_LAYER) ? (
    fb_drag_layer = swing_popup_result == 2
                      ? swing_pad_next_layer(max(0, sel_pad))
                      : min(swing_popup_result - 3, MAX_LAYERS - 1);
    fb_drag_count = 1;   // verb 7 takes REQ_COUNT files now: one here, not a drag's stale count
    swing_fb_request(7, fb_menu_ridx, sel_pad);
    swing_popup_result = 0;
  );
);

// The slot's ground and text colour, in the globals the tree's own draw reads: the user's choice of ground (the pad tray,
// or the theme's screen in LCD mode) and the text from its measured luminance -- this has to work across all 14 themes
// AND both ground choices. Its own function since the swap's audit (round two J, 2026-10-22): with the browser placed
// BELOW the pads its draw does not run in the side slot, and the slot paints its gutter from these.
// The redraw (P1a, 2026-10-27; spec §2): the surfaces and the ONE accent pair, from the ground through the same
// luminance rule, once a frame. A light ground: the list a little lighter (#eef0f3 -> #f7f8fa on the approved board),
// the card white, the hairline a little darker; a dark ground: the list and the card RAISED (lighter than the ground,
// never white), the hairline lighter still. The accent: #3b6fc9 on a light ground, 0.45 / 0.70 / 0.92 on a dark one,
// with the text that reads on it (white / near black). Read by the strip, its rail, its gutter and the side slot.
function swing_fb_ground() local(_fg_lum) (
  fb_lcd ? ( _fb_gr = lcd_bg_r;   _fb_gg = lcd_bg_g;   _fb_gb = lcd_bg_b;   )
         : ( _fb_gr = pad_well_r; _fb_gg = pad_well_g; _fb_gb = pad_well_b; );
  _fg_lum = _fb_gr * 0.299 + _fb_gg * 0.587 + _fb_gb * 0.114;
  _fb_tc = _fg_lum > 0.55 ? 0.12 : 0.90;
  fb_light = _fg_lum > 0.55;
  fb_light ? (
    fb_lst_r = _fb_gr + (1 - _fb_gr) * 0.55; fb_lst_g = _fb_gg + (1 - _fb_gg) * 0.55; fb_lst_b = _fb_gb + (1 - _fb_gb) * 0.55;
    fb_crd_r = 1; fb_crd_g = 1; fb_crd_b = 1;
    fb_hln_r = _fb_gr * 0.945; fb_hln_g = _fb_gg * 0.945; fb_hln_b = _fb_gb * 0.95;
    fb_acc_r = 0.231; fb_acc_g = 0.435; fb_acc_b = 0.788; fb_acc_t = 1;          // #3b6fc9
    fb_wrm_r = 0.93; fb_wrm_g = 0.47; fb_wrm_b = 0.13;                           // the playhead: warm against the accent
  ) : (
    fb_lst_r = _fb_gr + (1 - _fb_gr) * 0.045; fb_lst_g = _fb_gg + (1 - _fb_gg) * 0.045; fb_lst_b = _fb_gb + (1 - _fb_gb) * 0.045;
    fb_crd_r = _fb_gr + (1 - _fb_gr) * 0.095; fb_crd_g = _fb_gg + (1 - _fb_gg) * 0.095; fb_crd_b = _fb_gb + (1 - _fb_gb) * 0.095;
    fb_hln_r = _fb_gr + (1 - _fb_gr) * 0.17; fb_hln_g = _fb_gg + (1 - _fb_gg) * 0.17; fb_hln_b = _fb_gb + (1 - _fb_gb) * 0.17;
    fb_acc_r = 0.45; fb_acc_g = 0.70; fb_acc_b = 0.92; fb_acc_t = 0.08;
    fb_wrm_r = 1.0; fb_wrm_g = 0.72; fb_wrm_b = 0.35;
  );
);

// ── The side slot's WIDTH HANDLE (the user, 2026-10-22: "a handle for the side panel that will allow it to adjust like
// the bottom's handle" / "in between the pads and where the pad FX is"): the SEAM between the pads and the side panel
// (rk_swing_ui_padfx_side swing_side_seam_draw paints it; this reads it): drag LEFT for a wider slot, right for
// narrower, the wheel for small steps; a right-click puts the panels' own widths back (side_w 0). side_w is the slot's
// panels' width in canvas px (gate 83); the slot's cap follows it and the pads give or take the difference inside the
// window that is there (never a window resize). The frame's copies of the mouse (mx, my, the stash), so the rig's fake mouse drives
// it; the gate keeps the column claimed while a drag is in flight. (x, y, w, h) = the seam; _sh_open: the slot has a
// width to drag. Returns 1 while the seam is under the mouse. Called once a frame from the side slot's draw. ──
function swing_side_handle(_sh_x, _sh_y, _sh_w, _sh_h, _sh_open) local(_sh_hot) (
  _sh_hot = (mx >= _sh_x && mx < _sh_x + _sh_w && my >= _sh_y && my < _sh_y + _sh_h) || swing_side_seam_ext(mx, my);   // + its reach over the pads' margin
  side_cur_want = 0;
  _sh_open ? (
    _sh_hot && _fb_g_lmbdown ? ( side_gdrag = 1; side_gdrag_x0 = mx; side_gdrag_w0 = max(0, fb_w_cur - FB_GUTTER_W - swing_px(FB_SEAM_W)); );
    // the ceiling is a sanity bound only (8000 canvas px; it was 2000, under what a docker across a wide screen gives:
    // 2026-10-27, docked the pads' minimum is the limit, swing_side_share_w); the cap clamps what draws
    side_gdrag && _fb_g_lmbclick ? side_w = max(swing_px(SIDE_W_MIN_B), min(8000, side_gdrag_w0 + (side_gdrag_x0 - mx)));
    !_fb_g_lmbclick ? side_gdrag = 0;
    // the wheel steps from the width SHOWN: a width dragged past the limit (stored, not drawn) took notches that moved nothing
    _sh_hot && _fb_g_wheel != 0 ? side_w = max(swing_px(SIDE_W_MIN_B), min(8000, (side_w > 0 ? min(side_w, max(0, fb_w_cur - FB_GUTTER_W - swing_px(FB_SEAM_W))) : max(0, fb_w_cur - FB_GUTTER_W - swing_px(FB_SEAM_W))) + (_fb_g_wheel > 0 ? swing_px(20) : -swing_px(20))));
    _sh_hot && _fb_g_rmbdown ? side_w = 0;
    (_sh_hot || side_gdrag) ? side_cur_want = 32644;   // the left / right arrows (IDC_SIZEWE)
    _sh_hot ? swing_tooltip_check(1493, "The side panel's width: drag left for wider, right for narrower (wheel for small steps); right-click for the panels' own widths. The pads give the room; the window stays.");
  ) : side_gdrag = 0;
  _sh_hot && _sh_open;
);

// ══ THE REDRAW'S PARTS (P1a, 2026-10-27; spec §2) ═════════════════════════════════════════════════════════════════
// The breadcrumb, the deck's facts, the transport and the card, each its own function so swing_fb_draw stays a layout.
// All draw from the palette swing_fb_ground computed this frame.

// One run of the published cwd's cells, [a, b), into string dest.
function swing_fb_cwdstr(dest, a, b) local(k) (
  strcpy(dest, "");
  k = a; loop(max(0, b - a), str_setchar(dest, strlen(dest), max(32, _fb_cwd[k])); k += 1; );
);

// The breadcrumb: the folder you are in, its parents dim, the separators lighter, the leaf bold. Segments are the runs
// between "\" and "/" (a "parent / leaf" label splits the same way, its spaces trimmed). Parents that do not fit drop
// off the FRONT -- never a "..." prefix: three dots in front read as an overflow menu (the bridge's own rule for this
// string) -- and a leaf wider than the room is cut at a character.
function swing_fb_crumbs(bx, by, bw, bh) local(n, i, c, s0, k, first, tot, tw, th, sepw, yy) (
  n = 0; i = 0; s0 = 0;
  loop(_fb_cwd_len + 1,
    c = i < _fb_cwd_len ? _fb_cwd[i] : 47;
    (c == 92 || c == 47) ? (
      k = i;
      while (k > s0 && _fb_cwd[k - 1] == 32) ( k -= 1; );
      while (s0 < k && _fb_cwd[s0] == 32) ( s0 += 1; );
      k > s0 && n < 32 ? ( _fb_cseg[n * 2] = s0; _fb_cseg[n * 2 + 1] = k; n += 1; );
      s0 = i + 1;
    );
    i += 1;
  );
  sepw = 14;
  n < 1 ? (
    swing_fb_font(FB_FS_HDR, 0); gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.5);
    swing_fb_clipstr("(no folder)", bx, by + (bh - gfx_texth) * 0.5, bw);
  ) : (
    // the leaf first, then the parents in front of it while they fit
    swing_fb_font(FB_FS_HDR, 1);
    swing_fb_cwdstr(#fb_cstr, _fb_cseg[(n - 1) * 2], _fb_cseg[(n - 1) * 2 + 1]);
    tw = 0; th = 0; gfx_measurestr(#fb_cstr, tw, th);
    tot = tw; first = n - 1;
    swing_fb_font(FB_FS_HDR, 0);
    while (first > 0 && (swing_fb_cwdstr(#fb_cstr, _fb_cseg[(first - 1) * 2], _fb_cseg[(first - 1) * 2 + 1]);
                         tw = 0; gfx_measurestr(#fb_cstr, tw, th); tot + sepw + tw <= bw)) (
      tot += sepw + tw; first -= 1;
    );
    gfx_x = bx;
    k = first;
    loop(n - first,
      k < n - 1 ? (
        swing_fb_font(FB_FS_HDR, 0); gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.50);
        swing_fb_cwdstr(#fb_cstr, _fb_cseg[k * 2], _fb_cseg[k * 2 + 1]);
        gfx_y = by + (bh - gfx_texth) * 0.5; gfx_drawstr(#fb_cstr);
        gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.28);      // the separator: a small light chevron
        c = gfx_x + sepw * 0.5; yy = by + bh * 0.5;
        gfx_line(c - 2, yy - 3, c + 1, yy, 1); gfx_line(c + 1, yy, c - 2, yy + 3, 1);
        gfx_x += sepw;
      ) : (
        swing_fb_font(FB_FS_HDR, 1); gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.95);
        swing_fb_cwdstr(#fb_cstr, _fb_cseg[k * 2], _fb_cseg[k * 2 + 1]);
        swing_fb_clipstr(#fb_cstr, gfx_x, by + (bh - gfx_texth) * 0.5, max(0, bx + bw - gfx_x));
      );
      k += 1;
    );
  );
);

// The deck's facts: "2 ch . 44.1 kHz . 0.4 s . 72 KB" in a small face, a drawn dot between (no font is trusted with a
// middle dot: P7's question), wrapping to a second line when the card is narrow. The "longer than a pad holds" warning
// keeps its place at the end, warm. draw 0 = measure only. Returns the lines it takes (1 or 2).
function swing_fb_facts(p, fx, fy, maxw, lh, draw) local(nt, k, tw, th, xx, line, ms, sr, s) (
  swing_fb_font(FB_FS_STAT - 1, 0);
  sr = p[FB_R_SR]; ms = p[FB_R_MS];
  nt = (p[FB_R_KIND] > 0 || p[FB_R_EXT] == 10 || sr <= 0) ? 1
     : 4 + ((p[FB_R_KIND] == 0 && p[FB_R_EXT] != 10 && ms > SLOT_SIZE * 500 / sr) ? 1 : 0);
  xx = fx; line = 0; k = 0;
  loop(nt,
    p[FB_R_KIND] > 0 ? strcpy(#fb_tok, "folder") :
    p[FB_R_EXT] == 10 ? strcpy(#fb_tok, "SFZ kit - import it from the big browser") :   // nothing in the strip loads one (sweep BRW40)
    sr <= 0 ? strcpy(#fb_tok, "sample") :
    k == 0 ? sprintf(#fb_tok, "%d ch", p[FB_R_CH]) :
    k == 1 ? ( (sr % 1000) == 0 ? sprintf(#fb_tok, "%d kHz", (sr / 1000) | 0) : sprintf(#fb_tok, "%.1f kHz", sr / 1000); ) :
    k == 2 ? ( s = (ms / 1000) | 0;
               ms >= 60000 ? sprintf(#fb_tok, "%d:%d%d", (s / 60) | 0, ((s % 60) / 10) | 0, s % 10)
                           : sprintf(#fb_tok, "%.1f s", ms / 1000); ) :
    k == 3 ? ( p[FB_R_SIZE_KB] >= 1000 ? sprintf(#fb_tok, "%.1f MB", p[FB_R_SIZE_KB] / 1024) : sprintf(#fb_tok, "%d KB", p[FB_R_SIZE_KB]); ) :
             strcpy(#fb_tok, "longer than a pad holds");
    // Before the drop (Spec_Swing_Pad_Banks §8.1, 2026-09-23): a file longer than a pad holds at its own rate
    // (SLOT_SIZE cells of interleaved stereo) is trimmed on load -- said here, where it can still be avoided.
    tw = 0; th = 0; gfx_measurestr(#fb_tok, tw, th);
    xx > fx && xx + 12 + tw > fx + maxw && line == 0 ? ( line = 1; xx = fx; );   // a token that does not fit goes down
    xx > fx ? (
      draw ? ( gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.32); gfx_circle(xx + 6, fy + line * lh + lh * 0.5, 1.5, 1, 1); );
      xx += 12;
    );
    draw ? (
      k == 4 ? gfx_set(fb_wrm_r, fb_wrm_g, fb_wrm_b, 1) : gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.62);
      swing_fb_clipstr(#fb_tok, xx, fy + line * lh + (lh - th) * 0.5, max(0, fx + maxw - xx));
    );
    xx += tw;
    k += 1;
  );
  line + 1;
);

// The transport: a round PLAY (STOP while it plays), the LOOP pill, VOL at the right. These are real controls, not a
// side effect of loading: the browser has its own player, so PLAY means play and STOP means stop. A row too narrow
// for all of them takes two (VOL goes down); `draw` 0 = measure only. Returns the rows. The knob's centre goes out in
// _fb_kx / _fb_ky: its interaction stays in swing_fb_draw, where the hand-over writes a LOCAL `lmb`.
FB_TR_H = 30;     // one transport row
FB_ST_W = 78;     // P5's stepper: minus, the value, plus
function swing_fb_transport(ix, yt, iw, draw, edge) local(lw, tw, th, need, rows, cx, cy, hot, vlw, stx, sty, volrow, need2) (
  swing_fb_font(FB_FS_BTN, 1);
  tw = 0; th = 0; gfx_measurestr("LOOP", tw, th);
  lw = max(44, tw + 16);
  swing_fb_font(10, 1);
  vlw = 0; gfx_measurestr("VOL", vlw, th);
  // one row for PLAY, LOOP, the pitch stepper (P5) and VOL when it fits; else the stepper goes down a row, and when
  // even PLAY, LOOP and VOL do not fit, VOL goes down beside it
  need  = 28 + 8 + lw + 8 + FB_ST_W + 8 + vlw + 6 + 26;
  need2 = 28 + 8 + lw + 8 + vlw + 6 + 26;
  rows = need > iw ? 2 : 1;
  volrow = (rows == 1 || need2 <= iw) ? 0 : 1;
  stx = rows == 1 ? ix + 34 + lw + 8 : ix;
  sty = rows == 1 ? yt : yt + FB_TR_H;
  draw ? (
    // ── P5: the PITCH NUDGE (spec §7): minus, the value in semitones, plus; one semitone a step, -12..+12; a double-click
    //    on the value (or the wheel over it) -- 0. The audition only: @block makes the rate's multiplier from it, a load
    //    never carries it, and it is not saved. ──
    swing_fb_btn(stx, sty + 6, 20, FB_TR_H - 12, "-", 0, edge) ? fb_prv_semi = max(-12, fb_prv_semi - 1);
    swing_fb_btn(stx + FB_ST_W - 20, sty + 6, 20, FB_TR_H - 12, "+", 0, edge) ? fb_prv_semi = min(12, fb_prv_semi + 1);
    hot = mouse_x >= stx + 20 && mouse_x < stx + FB_ST_W - 20 && mouse_y >= sty + 4 && mouse_y < sty + FB_TR_H - 4;
    hot && edge ? ( time_precise() - _fb_semi_t < 0.35 ? fb_prv_semi = 0; _fb_semi_t = time_precise(); );
    hot && _fb_g_wheel != 0 ? ( fb_prv_semi = max(-12, min(12, fb_prv_semi + (_fb_g_wheel > 0 ? 1 : -1))); _fb_g_wheel = 0; );
    hot ? swing_tooltip_check(1703, "The audition's pitch, in semitones (-12..+12; double-click for 0). The audition only: a load keeps the file's own pitch.");
    swing_fb_font(FB_FS_BTN, fb_prv_semi != 0 && FB_FS_BTN + fb_fsz >= 10);   // digits under 10 px stay regular (wiki §4.7)
    fb_prv_semi == 0 ? strcpy(#fb_semi, "0 st") : sprintf(#fb_semi, fb_prv_semi > 0 ? "+%d st" : "%d st", fb_prv_semi);
    tw = 0; gfx_measurestr(#fb_semi, tw, th);
    fb_prv_semi != 0 ? gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, 1) : gfx_set(_fb_tc, _fb_tc, _fb_tc, hot ? 0.95 : 0.62);
    gfx_x = stx + (FB_ST_W - tw) * 0.5; gfx_y = sty + (FB_TR_H - th) * 0.5; gfx_drawstr(#fb_semi);
    // PLAY / STOP
    cx = ix + 13; cy = yt + FB_TR_H * 0.5;
    hot = (mouse_x - cx) * (mouse_x - cx) + (mouse_y - cy) * (mouse_y - cy) <= 14 * 14;
    gfx_set(fb_acc_r * (hot ? 1.08 : 1), fb_acc_g * (hot ? 1.08 : 1), fb_acc_b * (hot ? 1.04 : 1), 1);
    gfx_circle(cx, cy, 13, 1, 1);
    gfx_set(fb_acc_t, fb_acc_t, fb_acc_t, 1);
    _prv_on ? gfx_rect(cx - 4, cy - 4, 8, 8) : gfx_triangle(cx - 3, cy - 6, cx - 3, cy + 6, cx + 6, cy);
    hot && edge ? (
      // PLAY on a LONG file whose stream has ended or was cancelled: frame 0 has left the
      // ring, so the row is asked for again (verb 12, the row the player last loaded). A
      // short file, or a long one still streaming, replays / restarts from the ring.
      _prv_on ? fb_prv_cmd = 2 :
      (_prv_long && fb_prv_name >= 0) ? swing_fb_request(12, fb_prv_name, -1) : fb_prv_cmd = 1;
    );
    swing_fb_btn(ix + 34, yt + 6, lw, FB_TR_H - 12, "LOOP", fb_prv_loop, edge) ? fb_prv_loop = !fb_prv_loop;
    // VOL: the knob at the right end of its row, its word in front of it
    _fb_kx = ix + iw - 13; _fb_ky = volrow ? yt + FB_TR_H + FB_TR_H * 0.5 : yt + FB_TR_H * 0.5;
    swing_fb_font(10, 1);
    gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.5);
    gfx_x = _fb_kx - 13 - 6 - vlw; gfx_y = _fb_ky - th * 0.5; gfx_drawstr("VOL");
  );
  rows;
);

// The deck as a CARD: rounded, a hairline border, a faint shadow. Its top line: the file's name, bold; the facts under
// it; the wave in the accent (the peaks' outline, the loudness body inside it at about 28 %, on a pale track, the
// playhead warm); the transport at the bottom. (cx0, cy0, cw, ch) = the card; p = the selected row or 0; wv = the
// wave's height (0: no room); nf = the facts' lines; trn = the transport's rows.
function swing_fb_card(cx0, cy0, cw, ch, p, wv, nf, trn, edge)
  local(ix, iw, yy, lh1, lh2, _pkb, _wx, _wy, _ww, _wh, _pst, _plh, _pnx, _pc, _ply, _pmid, _pi, _pk0, _pk1,
        _pmx, _pmn, _pbd, _pj, _pkv, _pcx, _pcw, _ppx, _ptop, _pbot, ow, oh, cw2, infw, nw, nh, pw2, _pyt, _pyb)
(
  // the faint shadow, the hairline border, the card
  gfx_set(0, 0, 0, fb_light ? 0.07 : 0.22); gfx_rect(cx0 + 6, cy0 + ch, cw - 12, 1);
  gfx_set(0, 0, 0, fb_light ? 0.035 : 0.11); gfx_rect(cx0 + 9, cy0 + ch + 1, cw - 18, 1);
  gfx_set(fb_hln_r, fb_hln_g, fb_hln_b, 1); swing_fb_rr(cx0, cy0, cw, ch, 9);
  gfx_set(fb_crd_r, fb_crd_g, fb_crd_b, 1); swing_fb_rr(cx0 + 1, cy0 + 1, cw - 2, ch - 2, 8);
  ix = cx0 + 10; iw = cw - 20;
  lh1 = FB_FS_ROW + fb_fsz + 7;
  lh2 = FB_FS_STAT + fb_fsz + 3;
  yy = cy0 + 8;
  // ── the shared command channel's watchdog ──
  // BROWSE, kit loads and every sample load are gated on `gmem[KIT_GMEM_CMD]
  // == 0` and do NOTHING, silently, when it is not. One stuck command makes
  // half the instrument look broken with no clue anywhere. Say so instead.
  _fb_cmd_stuck > 120 ? (
    swing_fb_font(FB_FS_STAT, 1);
    gfx_set(fb_wrm_r, fb_wrm_g, fb_wrm_b, 1);
    swing_fb_clipstr(sprintf(#fb_tok, "command channel busy (%d) - loads blocked", gmem[KIT_GMEM_CMD]), ix, yy + 2, iw);
  ) : p ? (
    // At the right, "n of N . Category" (P1b's count, P2's category; FMT 2): dropped when the name needs the room.
    swing_fb_font(FB_FS_STAT - 1, 0);
    strcpy(#fb_dord, ""); strcpy(#fb_dcat, "");
    _fb_fmt >= 2 && _fb_dkr == fb_sel + 1 && _fb_dko > 0 ? sprintf(#fb_dord, "%d of %d", _fb_dko, _fb_fshown);
    _fb_fmt >= 2 && p[FB_R_KIND] == 0 && p[FB_R_CAT] > 0 ? eon_catname(#fb_dcat, p[FB_R_CAT] - 1);
    ow = 0; oh = 0; strlen(#fb_dord) ? gfx_measurestr(#fb_dord, ow, oh);
    cw2 = 0; strlen(#fb_dcat) ? gfx_measurestr(#fb_dcat, cw2, oh);
    infw = ow + cw2 + ((ow > 0 && cw2 > 0) ? 12 : 0);
    // the name, bold; in front of it the group's trimmed prefix, dim, when it fits (P1b: the row shows the remainder)
    swing_fb_font(FB_FS_ROW, 1);
    swing_fb_rowstr(p, #fb_dname, 0, min(p[FB_R_LEN], FB_R_NAME_MAX));
    nw = 0; nh = 0; gfx_measurestr(#fb_dname, nw, nh);
    infw > 0 && nw + 14 + infw > iw ? infw = 0;
    pw2 = 0;
    strlen(#fb_dpre) && p[FB_R_KIND] == 0 ? (
      swing_fb_font(FB_FS_ROW, 0);
      gfx_measurestr(#fb_dpre, pw2, nh);
      pw2 + nw + (infw > 0 ? infw + 14 : 0) > iw ? pw2 = 0;
      pw2 > 0 ? ( gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.45); gfx_x = ix; gfx_y = yy + (lh1 - gfx_texth) * 0.5; gfx_drawstr(#fb_dpre); );
    );
    swing_fb_font(FB_FS_ROW, 1);
    gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.95);
    swing_fb_clipstr(#fb_dname, ix + pw2, yy + (lh1 - gfx_texth) * 0.5, iw - pw2 - (infw > 0 ? infw + 14 : 0));
    infw > 0 ? (
      swing_fb_font(FB_FS_STAT - 1, 0);
      gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.50);
      gfx_x = ix + iw - infw; gfx_y = yy + (lh1 - oh) * 0.5 + 1;
      ow > 0 ? gfx_drawstr(#fb_dord);
      ow > 0 && cw2 > 0 ? ( gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.32); gfx_circle(gfx_x + 6, yy + lh1 * 0.5 + 1, 1.5, 1, 1); gfx_x += 12; );
      cw2 > 0 ? ( gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.50); gfx_drawstr(#fb_dcat); );
    );
    swing_fb_facts(p, ix, yy + lh1 + 2, iw - _fb_rootw, lh2, 1);
    // P4: the root note, a pill at the facts line's right end ("root F#3"; "root -" when no pitch was found; nothing
    // while it is worked out, on a failure, or for an answer that names another row or listing)
    _fb_rootw > 0 ? (
      swing_fb_mixset(fb_crd_r, fb_crd_g, fb_crd_b, fb_acc_r, fb_acc_g, fb_acc_b, fb_light ? 0.14 : 0.24);
      swing_fb_rr(ix + iw - _fb_rootw + 4, yy + lh1 + 2 + (lh2 - 16) * 0.5, _fb_rootw - 4, 16, 8);
      swing_fb_font(FB_FS_STAT - 1, 1);
      gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.85);
      ow = 0; gfx_measurestr(#fb_root, ow, oh);
      gfx_x = ix + iw - _fb_rootw + 4 + (_fb_rootw - 4 - ow) * 0.5; gfx_y = yy + lh1 + 2 + (lh2 - oh) * 0.5;
      gfx_drawstr(#fb_root);
      mouse_x >= ix + iw - _fb_rootw && mouse_x < ix + iw && mouse_y >= yy + lh1 && mouse_y < yy + lh1 + 2 + lh2
        ? swing_tooltip_check(1702, "The sample's root note (the pads' own detector). A dash: no clear pitch.");
    );
    // ── the wave: ALWAYS its place on the card ──
    // It holds its place whether or not a row is selected. A panel that appears
    // and disappears makes the whole strip jump every time you click, and an empty
    // frame reads as "nothing selected" perfectly well on its own.
    // Peaks over the track. Fetched once per SELECTION, never per row -- that is
    // what lets the list itself stay a plain list.
    // 2026-10-15 (the user: "can we draw the wave forms any better?"): the band
    // holds 512 columns and a loudness BODY per column (the bridge folds 8 finer
    // peaks into each: extremes -> the outline, their mean amplitude -> the body).
    // Drawn one column per PIXEL of the strip -- the old 128 bars stepped visibly --
    // and the preview's playhead over the file while it plays. No library: a
    // waveform is min / max per pixel, and the meter libs draw meters.
    wv >= 18 ? (
      _wx = ix; _wy = yy + lh1 + 2 + nf * lh2 + 6; _ww = iw; _wh = wv;
      swing_fb_mixset(fb_crd_r, fb_crd_g, fb_crd_b, fb_acc_r, fb_acc_g, fb_acc_b, fb_light ? 0.06 : 0.08);
      swing_fb_rr(_wx, _wy, _ww, _wh, 5);
      p[FB_R_KIND] == 0 && p[FB_R_EXT] != 10 ? (
        _pkb = EON_SWBPK_BASE + max(0, min(EON_SWBROWSE_SLOTS - 1, _reg_my_slot)) * EON_SWBPK_STRIDE;
        // ⭐ STEREO DRAWS AS STEREO. A stereo file gets two stacked lanes with a
        // hairline between them; mono keeps the full height and one lane. Folding
        // two channels into one hid the very thing you open a stereo sample to
        // look at -- and the facts line right above already says "2 ch", so a
        // single trace was actively contradicting it.
        _pst = p[FB_R_CH] >= 2 ? 1 : 0;
        _plh = _pst ? (_wh * 0.5 - 1) : _wh;
        _pnx = max(1, min(FB_PK_N, (_ww - 4) | 0));      // pixel columns: the track's width, at most the band's
        _pc  = 0;
        loop(_pst ? 2 : 1,
          _ply = _wy + _pc * (_wh * 0.5 + 1);
          _pmid = _ply + _plh * 0.5;
          gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.10);
          gfx_rect(_wx + 2, _pmid, _ww - 4, 1);              // this lane's centre line
          _pi = 0;
          loop(_pnx,
            // the band columns this pixel folds: [_pk0, _pk1)
            _pk0 = (_pi * FB_PK_N / _pnx) | 0;
            _pk1 = max(_pk0 + 1, ((_pi + 1) * FB_PK_N / _pnx) | 0);
            _pmx = -1; _pmn = 1; _pbd = 0; _pj = _pk0;
            loop(_pk1 - _pk0,
              _pkv = gmem[_pkb + _pc * 2 * FB_PK_N + _pj];           _pkv > _pmx ? _pmx = _pkv;
              _pkv = gmem[_pkb + _pc * 2 * FB_PK_N + FB_PK_N + _pj]; _pkv < _pmn ? _pmn = _pkv;
              _pbd += gmem[_pkb + 4 * FB_PK_N + _pc * FB_PK_N + _pj];
              _pj += 1;
            );
            _pbd /= (_pk1 - _pk0);
            _pcx = _wx + 2 + _pi * (_ww - 4) / _pnx;
            _pcw = max(1, (_ww - 4) / _pnx);
            _ptop = _pmid - max(0.5, _pmx * _plh * 0.48);
            _pbot = _pmid - min(-0.5, _pmn * _plh * 0.48);
            // the shape at a whisper, the loudness body inside it at ~28 %, the outline's two edges solid
            gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, _pc ? 0.10 : 0.12);
            gfx_rect(_pcx, _ptop, _pcw, max(1, _pbot - _ptop));
            _pbd > 0 ? (
              gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, _pc ? 0.24 : 0.28);
              gfx_rect(_pcx, _pmid - _pbd * _plh * 0.48, _pcw, max(1, _pbd * _plh * 0.96));
            );
            // the outline: one continuous line along the tops and one along the bottoms (a pixel per column reads as
            // dots wherever the shape moves faster than a pixel a column)
            gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, _pc ? 0.85 : 0.95);
            _pi > 0 ? ( gfx_line(_pcx - _pcw, _pyt, _pcx, _ptop, 1); gfx_line(_pcx - _pcw, _pyb, _pcx, _pbot - 1, 1); )
                    : ( gfx_rect(_pcx, _ptop, _pcw, 1); gfx_rect(_pcx, _pbot - 1, _pcw, 1); );
            _pyt = _ptop; _pyb = _pbot - 1;
            _pi += 1;
          );
          _pc += 1;
        );
        _pst ? (
          gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.12);
          gfx_rect(_wx + 2, _wy + _wh * 0.5, _ww - 4, 1);    // the channel split
        );
        // The playhead while the preview of THIS row plays: the player publishes its read
        // position every block (PP_PRV_RD, interleaved cells, climbing past one pass on a long
        // LOOP), shown as a fraction of one pass; the part already heard is tinted faintly.
        _prv_on && fb_prv_name == fb_sel && _prv_total_frames > 0 ? (
          _ppx = ((gmem[EON_PADPCM_HDR + PP_PRV_RD] * 0.5) % _prv_total_frames) / _prv_total_frames;
          gfx_set(fb_wrm_r, fb_wrm_g, fb_wrm_b, 0.10);
          gfx_rect(_wx + 2, _wy + 1, _ppx * (_ww - 4), _wh - 2);
          gfx_set(fb_wrm_r, fb_wrm_g, fb_wrm_b, 0.95);
          gfx_rect(_wx + 2 + _ppx * (_ww - 4), _wy + 1, 2, _wh - 2);
        );
      );
    );
  ) : (
    swing_fb_font(FB_FS_STAT, 0);
    gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.55);
    swing_fb_clipstr(_fb_fmt >= 2 ? sprintf(#fb_tok, "%d files", _fb_fshown) : sprintf(#fb_tok, "%d items", _fb_total), ix, yy + 2, iw);
    swing_fb_font(FB_FS_STAT - 1, 0);
    gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.38);
    swing_fb_clipstr("Click a sample to hear it; drag it onto a pad", ix, yy + lh1 + 2, iw);
    wv >= 18 ? (
      swing_fb_mixset(fb_crd_r, fb_crd_g, fb_crd_b, fb_acc_r, fb_acc_g, fb_acc_b, fb_light ? 0.06 : 0.08);
      swing_fb_rr(ix, yy + lh1 + 2 + nf * lh2 + 6, iw, wv, 5);
    );
  );
  swing_fb_transport(ix, cy0 + ch - 6 - trn * FB_TR_H, iw, 1, edge);
);

function swing_fb_draw(x, y, w, h)
  local(gx, px, pw, i, ry, p, kind, nlen, ci, hot, sel, listy, listh,
        vis, maxs, alive, lmb, edge, ext, _lum, _tc, _gr, _gg, _gb,
        _dc, _dr, _di, _dcx, _dcy, _dox, _doy, _dpw, _dph,
        _fy, _rh, _tw, _th, _sx, _shot, _gy, _gi, _gw, _my, _dtk, _dtf,
        _wide, _hh, _bh, _fh, _cw, _lw, _bin, _sbw, _hr, _plw, _plx, _crx, _crw, _bh2, _rfx,
        _ciw, _lh1, _lh2, _nf, _trn, _cmin, _cx0, _cy0, _ch, _wv, _rowsfit, _rx1, _rp, _chh, _tagw)
(
  // Ground colour is the user's choice. Default takes the pad TRAY, so the strip
  // reads as part of the chassis. LCD mode takes the theme's SCREEN instead --
  // that is the retro-hardware look, and on the SSL theme it is a light grey
  // panel, which is exactly the vibe rather than a bug.
  swing_fb_ground();   // the globals (the tree's own draw and the side slot read them); the locals below are this draw's copies
  _gr = _fb_gr; _gg = _fb_gg; _gb = _fb_gb; _tc = _fb_tc;
  _lum = _gr * 0.299 + _gg * 0.587 + _gb * 0.114;

  // Keys first, so a filter change is on the wire before the rows are drawn.
  swing_fb_menu_result();
  // ⛔⛔ SAY HELLO. A STRIP THAT COMES BACK OPEN NEVER ASKED FOR ANYTHING.
  // The bridge marks a slot `active` in ONE place -- eon_fb_handle_req, on the
  // first REQ_SEQ it has not seen -- and it only writes that slot's heartbeat
  // while it is active. Every swing_fb_request call site is behind a click, a
  // key or a drag; the chevron's is the one that used to open the conversation.
  // Since ser_ver 66 the strip RESTORES open, so on a project reload nobody
  // clicks anything: no request, no active slot, no heartbeat, and the face
  // reports "Browser bridge not running" at a bridge that is running perfectly.
  // ⭐ The tree has the identical bug one band over (ser_ver 67 restores fb_tree,
  // and only the TREE button posts a rebuild) -- which is why the rail came back
  // saying "No folders" rather than showing the drive it was left on.
  //
  // ⚠️⚠️ GUARDED ON `_reg_my_slot >= 0`. It starts at -1 and @block claims it on
  // first run, and swing_fb_band() CLAMPS with max(0, ...) -- so asking before
  // the claim would post this instance's request into SLOT 0, i.e. into another
  // Swing's mailbox. Waiting a frame costs nothing.
  // ⭐ ONCE PER SLOT, NOT ONCE PER LIFE (2026-10-27): `_fb_hello` holds the slot it was said in, plus one. A face can
  // leave that slot -- a peer takes it while this instance is away (swing_registry_check_owner), the copy duel mints a
  // new id, or @block's first claim lands after @gfx drew -- and the bridge heartbeats the new slot unasked because
  // the instance is live there (S7), so the dead-bridge re-ask below never fires. The rail stayed "No folders" and
  // the list showed the bridge's default folder instead of an answer (fbhello_e2e leg 3).
  fb_open && _fb_hello != _reg_my_slot + 1 && _reg_my_slot >= 0 ? (
    _fb_hello = _reg_my_slot + 1;
    swing_fb_request(0, 0, -1);
    fb_tree ? ( fbt_scroll = 0; _fbt_pagereq = -1; _fbt_flw = -1; swing_fb_tree_request(3, 0); );
  );


  // Keys: the filter box owns them while it has focus, otherwise the LIST does.
  // ⚠️ An embedded instance gets no keyboard at all, so neither runs there.
  // ⚠️ And neither runs under a MODAL (decision 6, 2026-09-15): an overlay, a
  // popup or the macro editor owns the keyboard while it is up. Without this
  // the arrows walked the list behind a popup, Enter loaded the focused row
  // onto the selected pad, and a focused filter box ate every keystroke a
  // modal's own text field was waiting for. _ui_modal_up is the modal gate's
  // own verdict (swing_ui_modal_gate), so the two can never disagree.
  // The docked keyboard: a click inside the strip gives it the keyboard, a click anywhere else in Swing takes it
  // back (the dock then hands focus back too); while it holds it, a key the dock queued stands in for `_char`
  // when REAPER delivered none (it delivers none to a docked Swing).
  // ⚠️ Against the ARGUMENTS, not px / pw: those are locals this call has not
  // assigned yet, so they held LAST call's list rect (after `px += _tw` with
  // the tree on) and a click in the rail never claimed the keys -- Down went
  // to the sequencer (sweep BRW13, 2026-10-26; the `_fy` note below has the
  // same class). The gutter is left out: its click is the chevron's.
  (mouse_cap & 1) && !fb_kbd_prev ? fb_kbd = mouse_x >= x && mouse_x < x + w - FB_GUTTER_W && mouse_y >= y && mouse_y < y + h;
  fb_kbd_prev = mouse_cap & 1;
  !_char && fb_kbd ? _char = swing_fb_dock_key();
  // The list's keys YIELD to the step sequencer while it owns the last click (seq_ui_focus): Up / Down / PgUp / PgDn /
  // Enter are both of theirs, and with the sequencer below and the strip at the side the strip draws first and ate them
  // (found in the swap's audit, round two J, 2026-10-22, with both panels on screen at once). A click in the strip
  // (fb_kbd) or anywhere else on the face takes them back; the filter box's focus is its own as ever.
  !is_embedded && !_ui_modal_up ? ( fb_filt_focus ? swing_fb_filter_keys() : (fb_kbd || !seq_ui_focus) ? _fb_want_keys = 1; );

  // The old pad-triggered audition is GONE. It loaded onto a pad and played the
  // pad, which is why it fought AUTOLOAD, overwrote the kit, and failed silently
  // when the length-change it watched for never came. AUDITION now drives the
  // browser's OWN voice (_prv_*), so it never touches a pad at all.

  // ══ MOUSE EDGES ═══════════════════════════════════════════════════════════
  // ⚠️⚠️ These went MISSING once already: a slice that removed the old audition
  // machinery took them with it, and because `edge` and `rel` are declared in
  // local() they silently read 0 rather than failing to compile. Every control
  // in the strip died at once -- chevron, AUTOLOAD, AUDITION, PLACES, the star --
  // while the panel still drew perfectly and still opened when forced. If the
  // strip ever goes visible-but-dead again, look HERE first.
  //
  // ⭐ The press edge comes from SWING, not from a shadow of our own. Swing
  // computes `lmb_down = LMB && !prev_LMB` once per @gfx pass
  // (Swing_ReaKit.jsfx:5964) and every widget in the plugin uses it;
  // swing_fb_gate stashed the real value before zeroing it for this column, so
  // _fb_g_lmbdown IS that edge, unmodified. A second shadow of the same state
  // is just a second thing that can be wrong.
  lmb  = (mouse_cap & 1) ? 1 : 0;
  // ⚠️ Nothing reads `lmb`, but it is NOT dead: EEL2 names are case-insensitive, so the
  // `LMB = ...` hand-over around the VOL knob below writes THIS local, not the global LMB.
  // Taking it out of local() would make that block zero the global LMB on every frame.
  edge = _fb_g_lmbdown;
  // Release has no house equivalent (nothing else needs one), so a shadow stays
  // for that -- and ONLY for that.
  // ⚠️⚠️ A GLOBAL, not the `rel` local. `lmb` -- declared in the same local()
  // list -- was measured reading 0 at the drag test while mouse_cap read 1 at
  // both ends of the same call, and moving the promotion off that local is what
  // finally made drag-to-pad promote. The release edge is the other half of the
  // same gesture and rides on the same kind of variable, so it moves too rather
  // than waiting to be the next thing that mysteriously does nothing.
  _fb_rel = (!(mouse_cap & 1) && _fb_lmb_prev) ? 1 : 0;
  _fb_lmb_prev = (mouse_cap & 1) ? 1 : 0;

  gx = x + w - FB_GUTTER_W;             // gutter PINNED to the window's right edge
  px = x;                               // panel opens leftward, toward the pads
  // Derived from the ANIMATED width, not from fb_open: on a close, `fb_open` is
  // already 0 while the window is still giving the width back, and a panel that
  // vanishes in one frame while its window keeps shrinking is the other half of
  // the reshape.
  pw = max(0, w - FB_GUTTER_W);

  // ── gutter + chevron ── (the redraw: drawn thinner, swing_fb_gutter_paint; the side slot's own gutter is the same)
  hot = mouse_x >= gx && mouse_x < gx + FB_GUTTER_W && mouse_y >= y && mouse_y < y + h;
  swing_fb_gutter_paint(gx, y, h, hot, fb_open);
  hot && edge ? ( fb_open = !fb_open; fb_open ? swing_fb_request(0, 0, -1); );

  // ── panel body ──
  // Three states, not two. While the strip is MOVING it draws as a plain
  // filling ground with a lit leading edge: running a breadcrumb, a toolbar,
  // 40 rows and a waveform through a dozen widths they hold for one frame each
  // is what made opening read as a blink instead of an expansion.
  (pw < 2) ? ( 0; ) : (
    // ── the folder tree takes the left of the panel ──
    // Everything below draws from px/pw, so moving them HERE is the whole
    // integration: breadcrumb, toolbar, list, status strip and every hit test
    // reflow into what is left without knowing the tree exists.
    // The width test is the fallback that matters: a docked or embedded
    // instance cannot grow its window, and a rail that leaves 60 px for
    // filenames is worse than no rail.
    // Width the rail is DRAWN at this frame: the live drag value while the
    // splitter is held, the committed one otherwise -- and never more than the
    // panel can spare. The clamp is what makes the docked case fall out for
    // free: there is no window to grow, so a wide rail simply gives the list
    // its floor back instead of squeezing it to nothing.
    _tw = max(FB_TREE_MIN,
              min(fb_split_drag ? _fb_tw_live : swing_fb_tree_w(),
                  pw - FB_LIST_MIN));
    fb_tree && pw > _tw + 90 ? (
      _sx   = px + _tw;                      // the seam, in absolute canvas px
      _shot = mouse_x >= _sx - FB_SPLIT_HIT && mouse_x < _sx + FB_SPLIT_HIT
           && mouse_y >= y && mouse_y < y + h;

      // ⚠️⚠️ THE RAIL MUST NOT SEE THE CLICK THAT GRABS THE SEAM. The seam sits
      // INSIDE the rail's own rect, and a rail row's "select" zone runs all the
      // way out to it -- so without suppressing the edge here, every grab of the
      // splitter also jumped the file list to whatever folder you grabbed next
      // to. Passing 0 costs the row nothing: 3 px is not a row click.
      swing_fb_tree_draw(px, y, _tw, h, (_shot || fb_split_drag) ? 0 : edge);

      // ⭐⭐ THE HANDLE IS ALWAYS THERE. The first version only lit the seam on
      // hover, which is backwards: a control you cannot see is a control nobody
      // knows they have, and at 26% alpha of the TEXT colour it was invisible on
      // a light theme anyway (SSL's panel is near-white, so _tc goes DARK and a
      // 2 px line at a quarter alpha disappears into the divider that was
      // already there). A grip you can see at rest is the whole affordance.
      //
      // Three states, and each one has to be obvious at a glance:
      //   rest  -- a quiet grip, enough to say "this moves"
      //   hover -- grip and seam brighten, the handle widens
      //   drag  -- the seam becomes a full-height lit rule
      //
      // ⭐ The grip is the GUTTER CHEVRON's idiom (short parallel marks), because
      // that is already the plugin's word for "grab me" and a second vocabulary
      // for the same gesture would just be noise.
      // ⚠️ This seam has no resize cursor. The side slot's width handle does
      // (swing_side_handle sets side_cur_want = IDC_SIZEWE, applied through
      // seq_ui_cursor_apply); giving this seam one too is its own decision.
      _gy = y + h * 0.5;

      // ⛔⛔ BUILT FROM LIGHT AND SHADOW, NOT FROM A TINT OF `_tc`. The first two
      // attempts both drew this as low-alpha `_tc` and both came out too faint to
      // see -- which is not bad luck, it is the method. `_tc` is chosen to be a
      // READABLE TEXT colour against the ground, so on the SSL theme it is near
      // BLACK on near-WHITE; a 1 px shape at half alpha of that lands right on
      // top of the hairline divider already there and adds nothing. Black and
      // white hairlines make a GROOVE, and a groove reads on any of the 14
      // themes because it is the same physics on all of them.
      gfx_set(0, 0, 0, fb_split_drag ? 0.42 : _shot ? 0.34 : 0.26);
      gfx_rect(_sx - 1, y, 1, h);
      gfx_set(1, 1, 1, fb_split_drag ? 0.18 : _shot ? 0.14 : 0.10);
      gfx_rect(_sx, y, 1, h);

      // Dragging: the whole rule goes to the chevron's blue, so the edge being
      // PLACED is the brightest thing on screen. Drawn under the grip, not over
      // it -- the handle has to stay legible while it is the thing you are using.
      fb_split_drag ? (
        gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, 0.9);
        gfx_rect(_sx - 1, y, 2, h);
      );

      // ── the grip: a raised PART, not a smudge ──
      // The pad takes its contrast from the GROUND's luminance, the same way the
      // text does -- lifted on a dark theme, sunk on a light one. Either way it
      // is a different value from what it sits on, which is the only thing that
      // makes a shape appear.
      // ⭐⭐ THREE STATES THAT ARE ACTUALLY THREE. The first cut separated them by
      // one pixel of width and a few points of alpha, which rendered as ONE
      // state wearing three names -- rest and hover were indistinguishable side
      // by side. The PAD ITSELF carries the state now:
      //   rest  -- neutral, a part of the chassis
      //   hover -- wider, and warmed a quarter of the way to the drag colour, so
      //            hovering PREVIEWS what grabbing will do
      //   drag  -- the pad goes fully blue with its marks knocked out dark. The
      //            handle you are holding is the brightest thing on the strip,
      //            which is the whole answer to "show me that I am dragging".
      _gw = (fb_split_drag || _shot) ? 7 : 5;
      fb_split_drag ? gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, 1) :
      _shot ? (
        _lum > 0.55 ? gfx_set(_gr * 0.80 + 0.10, _gg * 0.82 + 0.12, _gb * 0.86 + 0.16, 1)
                    : gfx_set(_gr * 1.20 + 0.14, _gg * 1.22 + 0.16, _gb * 1.26 + 0.21, 1);
      ) : (
        _lum > 0.55 ? gfx_set(_gr * 0.86, _gg * 0.86, _gb * 0.88, 1)
                    : gfx_set(_gr * 1.34 + 0.05, _gg * 1.34 + 0.05, _gb * 1.34 + 0.06, 1);
      );
      gfx_rect(_sx - _gw, _gy - FB_SPLIT_GRIP, _gw * 2, FB_SPLIT_GRIP * 2);
      // bevel: dark on the top/left, light on the bottom/right
      gfx_set(0, 0, 0, 0.38);
      gfx_rect(_sx - _gw, _gy - FB_SPLIT_GRIP, 1, FB_SPLIT_GRIP * 2);
      gfx_rect(_sx - _gw, _gy - FB_SPLIT_GRIP, _gw * 2, 1);
      gfx_set(1, 1, 1, 0.16);
      gfx_rect(_sx + _gw - 1, _gy - FB_SPLIT_GRIP, 1, FB_SPLIT_GRIP * 2);
      gfx_rect(_sx - _gw, _gy + FB_SPLIT_GRIP - 1, _gw * 2, 1);

      // Three EMBOSSED marks: a dark bar with a light one under its lip. 2 px
      // wide, because a 1 px mark at any alpha is a rounding error on screen.
      // Spanning -11..+11 so they sit centred in the 40 px pad.
      _gi = 0;
      loop(3,
        _my = _gy - 11 + _gi * 9;
        gfx_set(0, 0, 0, fb_split_drag ? 0.62 : _shot ? 0.72 : 0.60);
        gfx_rect(_sx - 3, _my, 2, 4); gfx_rect(_sx + 1, _my, 2, 4);
        gfx_set(1, 1, 1, fb_split_drag ? 0.34 : 0.28);
        gfx_rect(_sx - 3, _my + 4, 2, 1); gfx_rect(_sx + 1, _my + 4, 2, 1);
        _gi += 1;
      );

      _shot && edge ? ( fb_split_drag = 1; _fb_tw_live = _tw; );
      fb_split_drag ? (
        // Clamped against `pw`, the width the panel HAS -- so the drag can only
        // ever redistribute what is already on screen. Growing the window to
        // match happens once, on release, when the committed width steps.
        _fb_tw_live = max(FB_TREE_MIN,
                          min(min(FB_TREE_MAX, mouse_x - px), pw - FB_LIST_MIN));
        _fb_rel ? ( fb_tw_off = _fb_tw_live - FB_TREE_W; fb_split_drag = 0; );
      );

      px += _tw; pw -= _tw;
    ) : ( fb_split_drag = 0; );

  // ── the panel: the list's surface (the rail beside it is the ground itself) ──
  gfx_set(fb_lst_r, fb_lst_g, fb_lst_b, 1);
  gfx_rect(px, y, pw, h);
  gfx_set(0, 0, 0, fb_light ? 0.10 : 0.30);
  gfx_rect(px, y, 1, h);          // shadow line against the pad grid

  // ── the layout (the redraw, P1a; spec §2 "Fit") ──
  // NARROW (the side slot): the breadcrumb, the switch bar, the filter, the list, the card at the bottom. WIDE (620 px
  // and up: the browser placed below the pads, a slot dragged wide): the card takes a column at the right, the whole
  // height, and with the room the switch bar shares the breadcrumb's row. Heights grow with fb_fsz as the type does.
  // The card gives up its wave before the list goes under two rows; at the list's floor (FB_LIST_MIN) and the
  // smallest window the segment labels shorten (two rows of two at the last), the facts wrap to a second line and the
  // transport to a second row -- nothing is cut mid-control.
  _wide = pw >= 620;
  _hh = FB_HDR_H + max(0, fb_fsz);
  _bh = FB_TOOL_H + max(0, fb_fsz);
  _fh = FB_FILT_H + max(0, fb_fsz);
  _rh   = FB_ROW_H + fb_fsz;     // rows grow with the type, or it clips
  _cw = _wide ? max(280, min(380, (pw * 0.36) | 0)) : pw - 12;
  _lw = _wide ? pw - _cw - 18 : pw;            // the list's column
  _bin = _wide && _lw >= 600;                  // the switch bar on the breadcrumb's row
  _sbw = _bin ? min(380, (_lw * 0.46) | 0) : _lw - 16;

  // ── breadcrumb: BACK and UP, the folder you are in, the star and PLACES at its tail ──
  // BACK and UP are different journeys: up walks the TREE, back walks what you
  // actually DID. Jumping in via PLACES has no parent at all, so up alone leaves
  // you stranded. Both dim rather than silently doing nothing.
  swing_fb_iconbtn(px + 6, y + 4, 24, _hh - 8, 2, 0, !(_fb_flags & 32), edge)
    ? ( swing_fb_relist(); fb_scroll = 0; swing_fb_request(13, 0, -1); );
  swing_fb_iconbtn(px + 30, y + 4, 24, _hh - 8, 3, 0, (_fb_flags & 4), edge)
    ? ( swing_fb_relist(); fb_scroll = 0; swing_fb_request(2, 0, -1); );
  _hr = px + (_bin ? _lw - _sbw - 16 : _lw) - 6;     // the breadcrumb row's right end
  // PLACES sits at the tail of the breadcrumb, where a home button belongs: a pin, and its word when there is room.
  // Without it the only navigation is up and down, so reaching another library
  // means walking to the drive root and back down again.
  swing_fb_font(FB_FS_BTN, 1);
  _tw = 0; _th = 0; gfx_measurestr("PLACES", _tw, _th);
  _plw = (_lw >= 250 && _tw + 30 <= _lw * 0.32) ? _tw + 30 : 26;   // the word only where it fits beside the path
  _plx = _hr - _plw;
  hot = mouse_x >= _plx && mouse_x < _hr && mouse_y >= y + 5 && mouse_y < y + _hh - 5;
  (_fb_flags & 16) ? ( gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, 1); swing_fb_rr(_plx, y + 5, _plw, _hh - 10, (_hh - 10) * 0.5); )
                   : ( swing_fb_mixset(fb_lst_r, fb_lst_g, fb_lst_b, _tc, _tc, _tc, hot ? 0.14 : 0.07); swing_fb_rr(_plx, y + 5, _plw, _hh - 10, (_hh - 10) * 0.5); );
  (_fb_flags & 16) ? gfx_set(fb_acc_t, fb_acc_t, fb_acc_t, 1) : gfx_set(_tc, _tc, _tc, hot ? 1 : 0.75);
  swing_fb_glyph(2, _plx + 13, y + _hh * 0.5, 11);
  _plw > 30 ? (
    swing_fb_font(FB_FS_BTN, 1);
    _tw = 0; _th = 0; gfx_measurestr("PLACES", _tw, _th);
    gfx_x = _plx + 22; gfx_y = y + (_hh - _th) * 0.5; gfx_drawstr("PLACES");
  );
  hot && edge ? ( swing_fb_relist(); fb_scroll = 0; swing_fb_request(6, 0, -1); );
  // STAR the folder you are in. Without this, PLACES could only ever SHOW
  // favourites and never make one -- half a feature. FLAGS bit3 is the bridge
  // telling us whether this folder is already starred.
  // A drawn star, solid: the accent when the folder IS starred, a dim grey when
  // not, so the button states its own answer instead of just being pressable.
  swing_fb_iconbtn(_plx - 28, y + 4, 26, _hh - 8, 0,
                   (_fb_flags & 8) ? 1 : 0, 0, edge)
    ? ( swing_fb_relist(); fb_scroll = 0; swing_fb_request(11, 0, -1); );   // the bridge shows PLACES after: a new listing (sweep BRW10)
  // The path itself stays clickable as an "up" target -- same destination,
  // much bigger than the arrow.
  _crx = px + 58; _crw = max(0, _plx - 32 - _crx);
  hot = mouse_x >= _crx && mouse_x < _crx + _crw && mouse_y >= y && mouse_y < y + _hh;
  hot && !(_fb_flags & 4) ? ( swing_fb_mixset(fb_lst_r, fb_lst_g, fb_lst_b, _tc, _tc, _tc, 0.05); swing_fb_rr(_crx - 4, y + 4, _crw + 8, _hh - 8, 6); );
  // The bridge publishes the TAIL of a long path — the deepest folders are the
  // half that says where you are.
  swing_fb_crumbs(_crx, y, _crw, _hh);
  hot && edge && !(_fb_flags & 4) ? ( swing_fb_relist(); fb_scroll = 0; swing_fb_request(2, 0, -1); );

  // ── the switch bar: AUTOLOAD, AUDITION, SUBFOLDERS, TREE in one rounded track, the gear at its end ──
  _bh2 = swing_fb_segbar(_bin ? px + _lw - _sbw - 8 : px + 8, _bin ? y + 4 : y + _hh, _sbw, _bin ? _hh - 8 : _bh - 6, edge);

  // ── filter box ──
  // ⚠️⚠️ `_fy` IS SET BEFORE THE FIRST THING THAT READS IT. RF used to be drawn
  // four lines ABOVE this assignment, and an EEL2 local() persists between calls
  // rather than resetting -- so RF was placed from LAST frame's `_fy`: at y=0 on
  // the first frame the strip ever drew (button and hit box up outside the
  // panel), and one frame stale on every rack-face <-> normal-face switch, which
  // passes a different `y` into this function. Same class as the `lmb`/`edge`
  // locals that killed every control in the strip; validate.py and
  // eel_unassigned_locals both pass it, because the name IS assigned -- just
  // later than it is read.
  _fy = _bin ? y + _hh : y + _hh + _bh2 + 4;
  // Rounded, a magnifier, the placeholder "Filter this folder"; the box is the card's colour inside a hairline.
  gfx_set(fb_hln_r, fb_hln_g, fb_hln_b, 1);
  swing_fb_rr(px + 8, _fy + 3, _lw - 16, _fh - 6, (_fh - 6) * 0.5);
  gfx_set(fb_crd_r, fb_crd_g, fb_crd_b, 1);
  swing_fb_rr(px + 9, _fy + 4, _lw - 18, _fh - 8, (_fh - 8) * 0.5);
  // REFRESH sits inside the box at its right end (beside the clear cross while there is text): it is a rescan, not a
  // mode. Drawn AFTER the box's ground, which painted over it at alpha 1: a button nobody could see that still took the
  // click (sweep BRW14, 2026-10-26); the box's own hit test leaves its rect alone.
  _rfx = px + _lw - 14 - 22 - (fb_filt_len > 0 ? 22 : 0);
  swing_fb_iconbtn(_rfx, _fy + 5, 22, _fh - 10, 5, 0, 0, edge)
    ? ( swing_fb_relist(); swing_fb_request(4, 0, -1); );
  hot = mouse_x >= px + 8 && mouse_x < px + _lw - 8
        && mouse_y >= _fy + 3 && mouse_y < _fy + _fh - 3
        && !(mouse_x >= _rfx && mouse_x < _rfx + 22 + (fb_filt_len > 0 ? 22 : 0));
  // is_embedded gets no keyboard at all, so never take focus there
  hot && edge ? fb_filt_focus = is_embedded ? 0 : 1;
  edge && !hot ? fb_filt_focus = 0;
  fb_filt_focus ? (
    gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, 1);
    gfx_roundrect(px + 8, _fy + 3, _lw - 17, _fh - 7, ((_fh - 6) * 0.5) | 0, 1);
  );
  gfx_set(_tc, _tc, _tc, 0.45);
  swing_fb_glyph(0, px + 22, _fy + _fh * 0.5, 12);
  swing_fb_font(FB_FS_ROW, 0);
  fb_filt_len > 0 ? (
    gfx_set(_tc, _tc, _tc, 0.95);
    swing_fb_clipstr(#fb_filt, px + 33, _fy + (_fh - gfx_texth) * 0.5, max(0, _rfx - px - 37));
    // clear
    swing_fb_iconbtn(_rfx + 22, _fy + 5, 22, _fh - 10, 6, 0, 0, edge) ? (
      strcpy(#fb_filt, ""); fb_filt_len = 0; fb_scroll = 0; swing_fb_relist();
      swing_fb_send_filter();
    );
  ) : (
    gfx_set(_tc, _tc, _tc, 0.38);
    swing_fb_clipstr(is_embedded ? "filter needs a floating window" : "Filter this folder",
                     px + 33, _fy + (_fh - gfx_texth) * 0.5, max(0, _rfx - px - 37));
  );
  gfx_set(fb_hln_r, fb_hln_g, fb_hln_b, 1);
  gfx_rect(px + 1, _fy + _fh, _lw - 1, 1);           // the hairline that seats the list under the top block

  listy = _fy + _fh + 2;

  // P2: the chips under the filter (FMT 2; none from an older bridge, none on the places list)
  _chh = (_fb_flags & 16) ? 0 : swing_fb_chips(px + 8, listy + 3, _lw - 16, edge, 1);
  _chh > 0 ? listy += _chh + 3;

  // PLACES explains itself. It is a jump list -- starred folders, folders you
  // were in recently, and your drives -- and without a caption it just looks
  // like a folder full of oddly-named things.
  (_fb_flags & 16) ? (
    swing_fb_font(9, 1);
    gfx_set(_tc, _tc, _tc, 0.55);
    gfx_x = px + 12; gfx_y = listy + 4; gfx_drawstr("JUMP TO");
    swing_fb_font(10, 0);
    gfx_set(_tc, _tc, _tc, 0.40);
    swing_fb_clipstr("starred folders, recent ones, and your drives", px + 12, listy + 17, _lw - 20);
    listy += 32;
  );

  // ── the card's size, and so the list's ──
  // The selected row on this page (the card describes it). A selection scrolled off the page shows the count.
  p = 0; i = 0;
  loop(_fb_n,
    !p && _fb_rows[i * FB_REC + FB_R_LEN] > 0
       && _fb_rows[i * FB_REC + FB_R_RIDX] == fb_sel ? p = _fb_rows + i * FB_REC;
    i += 1;
  );
  fb_sel < 0 ? p = 0;
  _ciw = _cw - 20;
  _lh1 = FB_FS_ROW + fb_fsz + 7;
  _lh2 = FB_FS_STAT + fb_fsz + 3;
  // P4: the root pill for the deck's row (its width comes off the facts line); P1b: the group's prefix, dim in front of
  // the deck's name, when the row's label is on this page
  _fb_rootw = 0;
  p && swing_fb_root_text(fb_sel) > 0 ? (
    swing_fb_font(FB_FS_STAT - 1, 1);
    _tw = 0; _th = 0; gfx_measurestr(#fb_root, _tw, _th); _fb_rootw = _tw + 18;
  );
  strcpy(#fb_dpre, "");
  p ? (
    i = ((p - _fb_rows) / FB_REC) | 0;
    while (i > 0 && _fb_rows[(i - 1) * FB_REC + FB_R_KIND] == 0) ( i -= 1; );
    i > 0 && _fb_rows[(i - 1) * FB_REC + FB_R_KIND] == 5
      ? swing_fb_rowstr(_fb_rows + (i - 1) * FB_REC, #fb_dpre, 0, min(_fb_rows[(i - 1) * FB_REC + FB_R_LEN], FB_R_NAME_MAX));
  );
  _nf  = p ? swing_fb_facts(p, 0, 0, _ciw - _fb_rootw, _lh2, 0) : 1;
  _trn = swing_fb_transport(0, 0, _ciw, 0, 0);
  _cmin = 8 + _lh1 + 2 + _nf * _lh2 + 6 + 6 + _trn * FB_TR_H + 6;   // the card with no wave
  _wide ? (
    _cx0 = px + pw - _cw - 6; _cy0 = y + 6; _ch = h - 12;
    _wv = min(150, _ch - _cmin - 6);
    _wv < 18 ? _wv = 0;
    listh = y + h - 4 - listy;
  ) : (
    _ch = min(_cmin + 6 + 56, max(_cmin, y + h - 6 - listy - 4 - 2 * _rh));
    _wv = _ch - _cmin - 6;
    _wv < 18 ? ( _wv = 0; _ch = _cmin; );
    _cx0 = px + 6; _cy0 = y + h - 6 - _ch;
    listh = _cy0 - 4 - listy;
  );
  vis   = max(1, (listh / _rh) | 0);
  _rowsfit = max(0, (listh / _rh) | 0);             // the rows drawn and hit: whole ones only
  _rx1 = px + _lw - 4;                               // the rows' right end

  // ── bridge-not-running state, designed in rather than bolted on ──
  // The heartbeat is a counter the bridge bumps every tick. If it stops moving
  // for ~2 seconds of frames, say so plainly instead of showing a stale list
  // that looks live. (FXP_HB precedent.)
  _fb_hb == _fb_hb_last ? _fb_hb_still += 1 : _fb_hb_still = 0;
  _fb_hb_last = _fb_hb;
  alive = _fb_hb_still < 120;

  // ⭐ AND RE-ARM THE HELLO WHILE IT LOOKS DEAD. A bridge that RESTARTS mid-session
  // comes back with a fresh slot table -- `active` false again -- so it sits
  // waiting for a request that will never come. That is the same handshake
  // failure as a restored-open strip, just from the other end, and without this
  // the only cure is for the user to go and click something.
  // ⚠️ It re-asks on a TIMER rather than resetting _fb_hb_still, so a genuinely
  // dead bridge still reads as dead -- the message stays put and only the
  // question is repeated.
  !alive ? ( _fb_reask += 1;
             _fb_reask > 300 ? ( _fb_reask = 0; _fb_hello = 0; ); )
         : ( _fb_reask = 0; );

  _reg_my_slot < 0 ? (
    // no registry slot (the seventeenth Swing, or one whose slot was taken):
    // nothing of the band is ours to read or write (sweep BRW39/41)
    swing_fb_font(FB_FS_ROW, 0);
    gfx_set(fb_wrm_r, fb_wrm_g, fb_wrm_b, 1);
    swing_fb_clipstr("Registry full - no browser slot", px + 12, listy + 14, _lw - 20);
    gfx_set(_tc, _tc, _tc, 0.45);
    swing_fb_clipstr("16 Swings at most share the bridge", px + 12, listy + 32, _lw - 20);
  ) : !alive ? (
    swing_fb_font(FB_FS_ROW, 0);
    gfx_set(fb_wrm_r, fb_wrm_g, fb_wrm_b, 1);
    swing_fb_clipstr("Browser bridge not running", px + 12, listy + 14, _lw - 20);
    gfx_set(_tc, _tc, _tc, 0.45);
    swing_fb_clipstr("Start Swing's bridge script", px + 12, listy + 32, _lw - 20);
  ) : _fb_n < 1 ? (
    gfx_set(_tc, _tc, _tc, 0.45);
    swing_fb_font(FB_FS_ROW, 0);
    swing_fb_clipstr((_fb_flags & 1) ? "Reading folder..." :
                     (_fb_flags & 2) ? "Nothing playable here" : "...", px + 12, listy + 14, _lw - 20);
  ) : fb_settings_open ? ( 0; ) : (

    // ── rows ──
    // Keys here rather than at the top of the function: paging needs `vis`, and
    // `vis` is not known until the list geometry is.
    // A keyboard move that ran off the loaded page asked for a new one and
    // remembered where it was heading; land the selection now the page is here.
    // ⚠️ Here and not in swing_fb_snapshot: the snapshot sits ABOVE these
    // functions and EEL2 resolves names at parse time, so calling down from
    // there is a whole-file compile kill, not a warning.
    _fb_kbwant > 0 && (_fb_kbwant - 1) >= _fb_off
                   && (_fb_kbwant - 1) < _fb_off + min(_fb_n, vis) ? (
      swing_fb_kb_select(_fb_kbwant - 1 - _fb_off);
      _fb_kbwant = 0;
    );
    _fb_want_keys ? ( _fb_want_keys = 0; swing_fb_list_keys(vis); );
    maxs = max(0, _fb_total - vis);
    fb_scroll = max(0, min(maxs, fb_scroll));
    _fb_total > vis ? _rx1 = px + _lw - 10;          // the scrollbar's room
    _fb_fmt >= 2 ? swing_fb_pad_hashes();             // P3: what is on the pads, refreshed twice a second
    i = 0;
    loop(min(_fb_n, _rowsfit),
      _rp  = _fb_rows + i * FB_REC;
      nlen = _rp[FB_R_LEN];
      nlen > 0 ? (
        ry   = listy + i * _rh;
        kind = _rp[FB_R_KIND];   // 0 file, 1 folder, 2 parent, 3 place, 5 a group label (P1b)
        hot  = mouse_x >= px && mouse_x < px + _lw && mouse_y >= ry && mouse_y < ry + _rh;
        sel  = fb_sel >= 0 && _rp[FB_R_RIDX] >= min(fb_sel, fb_sel_b)
                           && _rp[FB_R_RIDX] <= max(fb_sel, fb_sel_b);
        // A LABEL is read, never acted on: no hover, no selection, so no press, no menu, no drag (P1b, spec §3; the
        // keyboard walk steps over it in swing_fb_kb_select). Its RIDX is -1 and never meets fb_sel >= 0 anyway.
        kind == 5 ? ( hot = 0; sel = 0; );

        // Selection = a tinted band inset 4 px with rounded ends and a 3 px accent edge on the left; hover a faint
        // tint. The rail's current folder wears the same band.
        sel ? (
          swing_fb_mixset(fb_lst_r, fb_lst_g, fb_lst_b, fb_acc_r, fb_acc_g, fb_acc_b, fb_light ? 0.16 : 0.26);
          swing_fb_rr(px + 4, ry + 1, _rx1 - px - 4, _rh - 2, (_rh - 2) * 0.5);
          gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, 1);
          swing_fb_rr(px + 5, ry + 4, 3, _rh - 8, 1.5);
        ) : hot ? (
          swing_fb_mixset(fb_lst_r, fb_lst_g, fb_lst_b, _tc, _tc, _tc, 0.06);
          swing_fb_rr(px + 4, ry + 1, _rx1 - px - 4, _rh - 2, (_rh - 2) * 0.5);
        );

        // ⚠️ `ext` is read by the icon, by the drag arming and by the click
        // handler. My icon rewrite dropped this assignment and the
        // unassigned-local guard caught it immediately -- without it every file
        // reads as extension 0, so an SFZ would load like a plain sample.
        ext = _rp[FB_R_EXT];
        kind == 5 ? (
          // ── a group LABEL (P1b): the trimmed prefix bold, the folder dim after it, its files' count at the right,
          //    a hairline under it ──
          swing_fb_font(FB_FS_BTN - 1, 0);
          sprintf(#fb_chipn, "%d", _rp[FB_R_SIZE_KB]);
          _tw = 0; _th = 0; gfx_measurestr(#fb_chipn, _tw, _th);
          gfx_set(_tc, _tc, _tc, 0.40);
          gfx_x = _rx1 - 8 - _tw; gfx_y = ry + (_rh - _th) * 0.5; gfx_drawstr(#fb_chipn);
          gfx_set(fb_hln_r, fb_hln_g, fb_hln_b, 1);
          gfx_rect(px + 10, ry + _rh - 2, max(0, _rx1 - px - 14), 1);
          ci = swing_fb_rowstr(_rp, #fb_rname, 0, min(nlen, FB_R_NAME_MAX));
          ci < nlen ? swing_fb_rowstr(_rp, #fb_rfold, ci + 1, min(nlen, FB_R_NAME_MAX)) : strcpy(#fb_rfold, "");
          swing_fb_font(FB_FS_ROW - 1, 1);
          gfx_set(_tc, _tc, _tc, 0.80);
          _sx = strlen(#fb_rname) ? swing_fb_clipstr(#fb_rname, px + 10, ry + (_rh - gfx_texth) * 0.5, max(0, _rx1 - px - 30 - _tw)) : px + 10;
          strlen(#fb_rfold) ? (
            swing_fb_font(FB_FS_ROW - 1, 0);
            gfx_set(_tc, _tc, _tc, 0.46);
            swing_fb_clipstr(#fb_rfold, _sx + (strlen(#fb_rname) ? 8 : 0), ry + (_rh - gfx_texth) * 0.5,
                             max(0, _rx1 - 16 - _tw - _sx - 8));
          );
        ) : (
        // Row icon. Colour still carries the TYPE, but the shape carries the
        // meaning -- a coloured block told you nothing on its own.
        // P2 (FMT 2): a file's glyph is its CATEGORY'S DOT, in the category's colour (the pads' hues); a ring when it
        // has none (or is not classified yet). SFZ, folders, places and ".." keep their shapes.
        kind == 0 && ext != 10 && _fb_fmt >= 2 ? (
          _rp[FB_R_CAT] > 0 ? (
            gfx_set(((_rp[FB_R_CCOL] / 65536) | 0) / 255, (((_rp[FB_R_CCOL] / 256) | 0) & 255) / 255, (_rp[FB_R_CCOL] & 255) / 255, 1);
            gfx_circle(px + 18, ry + _rh * 0.5, 4.5, 1, 1);
          ) : (
            gfx_set(_tc, _tc, _tc, 0.32);
            gfx_circle(px + 18, ry + _rh * 0.5, 4, 0, 1);
          );
        ) : (
        kind == 3 ? (
          _rp[FB_R_PLKIND] == 1 ? gfx_set(0.95, 0.70, 0.22, sel ? 1 : 0.9) :   // starred
          _rp[FB_R_PLKIND] == 3 ? gfx_set(0.55, 0.62, 0.72, sel ? 1 : 0.8)     // drive
                                : gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, sel ? 1 : 0.85);   // recent
        ) :
        kind >  0 ? ( fb_light ? gfx_set(0.80, 0.56, 0.16, sel ? 1 : 0.9) : gfx_set(0.86, 0.70, 0.38, sel ? 1 : 0.85); ) :
        ext == 10 ? ( fb_light ? gfx_set(0.28, 0.58, 0.32, 1) : gfx_set(0.55, 0.80, 0.55, sel ? 1 : 0.88); )
                  : gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, sel ? 1 : 0.82);
        // For a place row the second argument carries the PLACE kind, not a
        // file extension -- a place has no extension and the icon needs to know
        // star from recent from drive.
        swing_fb_icon(kind, kind == 3 ? _rp[FB_R_PLKIND] : ext,
                      px + 18, ry + _rh * 0.5, 13);
        );

        // P3 (FMT 2): the file is on a pad -- that pad's tag at the row's right end
        _tagw = 0;
        kind == 0 && _fb_fmt >= 2 && swing_fb_tag_of(_rp[FB_R_PHASH]) >= 0 ? (
          _tagw = swing_fb_tag_draw(_fb_tag_ap, _fb_tag_n, _rx1 - 6, ry + _rh * 0.5) + 6;
          hot && mouse_x >= _rx1 - _tagw ? swing_tooltip_check(1701, "On a pad: that pad's note (a letter in front: a pad in another bank; + more pads).");
        );

        swing_fb_font(FB_FS_ROW, 0);
        gfx_set(_tc, _tc, _tc, sel ? 1 : (kind > 0 ? 0.88 : 0.80));
        swing_fb_rowstr(_rp, #fb_rname, 0, min(nlen, FB_R_NAME_MAX));
        swing_fb_clipstr(#fb_rname, px + 31, ry + (_rh - gfx_texth) * 0.5, max(0, _rx1 - px - 31 - 6 - _tagw));
        );

        // Right-click opens the row menu. Selecting first, so the menu always
        // acts on the row you actually pointed at.
        hot && _fb_g_rmbdown ? (
          fb_menu_ridx = _rp[FB_R_RIDX]; fb_menu_kind = kind; fb_menu_ext = ext;
          fb_sel = fb_menu_ridx; fb_sel_b = fb_sel;
          strcpy(#fb_menu_name, "");
          ci = 0; loop(min(nlen, 30),
            str_setchar(#fb_menu_name, ci, _rp[FB_R_NAME + ci]); ci += 1;);
          swing_fb_menu_open(mouse_x, mouse_y);
        );

        hot && edge ? (
          // SHIFT keeps the anchor and moves the far end: that is a range. A
          // plain press on a file INSIDE the range keeps it too (fb_drag_keep):
          // it may be the start of a drag that carries the whole range, and it
          // was collapsed to the row here, before the drag could arm, so five
          // selected files travelled as one (sweep BRW15, 2026-10-26); a click
          // that never moves collapses it at the release. Anything else starts
          // a fresh single-row selection.
          fb_drag_keep = (!SHIFT && sel && kind == 0) ? 1 : 0;
          SHIFT && fb_sel >= 0 && kind == 0 ? fb_sel_b = _rp[FB_R_RIDX]
          : fb_drag_keep ? 0
                         : ( fb_sel = _rp[FB_R_RIDX]; fb_sel_b = _rp[FB_R_RIDX]; );
          sel = fb_sel >= 0 && _rp[FB_R_RIDX] >= min(fb_sel, fb_sel_b)
                            && _rp[FB_R_RIDX] <= max(fb_sel, fb_sel_b);   // the press moved it
          kind > 0 ? (
            // folder or ".." — walk into it and start the list again at the top
            fb_scroll = 0; swing_fb_relist();
            swing_fb_request(1, _rp[FB_R_RIDX], -1);
          ) : (
            // A press on a file only ARMS. Whether it was a click or a drag is
            // not knowable yet, so the load waits for the release -- otherwise
            // every drag would also load onto the focused pad on the way past.
            fb_drag_state = 1;
            fb_drag_press = _rp[FB_R_RIDX];
            // Dragging a row that is INSIDE the selection carries the whole
            // range; dragging any other row carries just that one and resets
            // the selection to it -- otherwise a stray drag would silently
            // move files the user had forgotten were still selected.
            sel ? (
              fb_drag_ridx  = min(fb_sel, fb_sel_b);
              fb_drag_count = abs(fb_sel_b - fb_sel) + 1;
            ) : (
              fb_drag_ridx  = _rp[FB_R_RIDX];
              fb_drag_count = 1;
            );
            fb_drag_row   = i;
            fb_drag_ext   = ext;
            fb_drag_pad   = -1;
            fb_drag_x0    = mouse_x;
            fb_drag_y0    = mouse_y;
          );
        );
      );
      i += 1;
    );

    // ── scrollbar, only when it means something: a thin rounded thumb ──
    _fb_total > vis ? (
      swing_fb_mixset(fb_lst_r, fb_lst_g, fb_lst_b, _tc, _tc, _tc, 0.06);
      swing_fb_rr(px + _lw - 7, listy + 2, 4, listh - 4, 2);
      swing_fb_mixset(fb_lst_r, fb_lst_g, fb_lst_b, _tc, _tc, _tc, 0.32);
      swing_fb_rr(px + _lw - 7,
                  listy + 2 + (fb_scroll / max(1, _fb_total)) * (listh - 4),
                  4, max(14, (vis / max(1, _fb_total)) * (listh - 4)), 2);
    );

    // ── wheel: consume it so the pane behind cannot also act on it ──
    // _fb_g_wheel is the copy the gate took before it zeroed the frame global.
    // Reading mouse_wheel here would find nothing -- and would ALSO mean the
    // pane behind had already been free to act on it.
    _fb_g_wheel != 0 &&
    mouse_x >= px && mouse_x < px + _lw && mouse_y >= listy && mouse_y < listy + listh ? (
      fb_scroll = max(0, min(maxs, fb_scroll - (_fb_g_wheel > 0 ? 3 : -3)));
      swing_fb_request(0, 0, -1);
    );
  );

  // ── settings ──
  // Over the list rather than beside it: the strip is 292 px and a second
  // column would leave neither usable. Things that belong to the STRIP live
  // here; things you flip while working (autoload, audition, subfolders) stay
  // out on the switch bar where they can be reached without a detour.
  fb_settings_open ? (
    gfx_set(fb_lst_r, fb_lst_g, fb_lst_b, 1);
    gfx_rect(px + 1, listy, _lw - 1, max(0, listh));

    swing_fb_font(9, 1);
    gfx_set(_tc, _tc, _tc, 0.55);
    gfx_x = px + 12; gfx_y = listy + 10; gfx_drawstr("TYPEFACE");
    swing_fb_font(FB_FS_ROW, 0);
    gfx_set(_tc, _tc, _tc, 0.95);
    gfx_x = px + 12; gfx_y = listy + 28; gfx_drawstr(swing_fb_font_name(fb_font));
    swing_fb_btn(px + _lw - 74, listy + 25, 30, 20, "<", 0, edge)
      ? fb_font = (fb_font + FB_FONT_N - 1) % FB_FONT_N;
    swing_fb_btn(px + _lw - 40, listy + 25, 30, 20, ">", 0, edge)
      ? fb_font = (fb_font + 1) % FB_FONT_N;

    swing_fb_font(9, 1);
    gfx_set(_tc, _tc, _tc, 0.55);
    gfx_x = px + 12; gfx_y = listy + 58; gfx_drawstr("SIZE");
    swing_fb_font(FB_FS_ROW, 0);
    gfx_set(_tc, _tc, _tc, 0.95);
    gfx_x = px + 12; gfx_y = listy + 76;
    gfx_drawstr(sprintf(#, "%s%d", fb_fsz >= 0 ? "+" : "", fb_fsz));
    swing_fb_btn(px + _lw - 74, listy + 73, 30, 20, "-", 0, edge)
      ? fb_fsz = max(-2, fb_fsz - 1);
    swing_fb_btn(px + _lw - 40, listy + 73, 30, 20, "+", 0, edge)
      ? fb_fsz = min(8, fb_fsz + 1);

    swing_fb_font(9, 1);
    gfx_set(_tc, _tc, _tc, 0.55);
    gfx_x = px + 12; gfx_y = listy + 106; gfx_drawstr("SKIN");
    swing_fb_btn(px + 12, listy + 124, 90, 22, "CHASSIS", !fb_lcd, edge) ? fb_lcd = 0;
    swing_fb_btn(px + 108, listy + 124, 90, 22, "LCD",     fb_lcd,  edge) ? fb_lcd = 1;

    gfx_set(_tc, _tc, _tc, 0.40);
    swing_fb_font(10, 0);
    swing_fb_clipstr("LCD paints the strip in the theme's screen", px + 12, listy + 156, _lw - 20);
    swing_fb_clipstr("colours instead of the pad tray.", px + 12, listy + 170, _lw - 20);

    swing_fb_btn(px + 12, listy + max(190, listh - 32), _lw - 24, 24, "DONE", 0, edge)
      ? fb_settings_open = 0;
  );

  // ── the deck: a card. Full detail on ONE file beats thin detail on all of them -- that is what earns it its room,
  //    and it is why there are no per-row columns above. ──
  gmem[KIT_GMEM_CMD] != 0 ? _fb_cmd_stuck += 1 : _fb_cmd_stuck = 0;
  swing_fb_card(_cx0, _cy0, _cw, _ch, p, _wv, _nf, _trn, edge);

  // The house knob so it matches the rest of the instrument.
  // ⚠️ jo_knob_interact reads lmb_down, which swing_fb_gate ZEROES over this
  // column -- hand it the copy the gate took, then put the zero back. The strip
  // paints last, but the overlays after it still read these globals.
  // The WHEEL and the RIGHT button too (sweep BRW42, 2026-10-26): the gate
  // zeroes those as well, and with only the press handed over the knob never
  // saw a wheel notch or the right-click reset while the strip was at the side.
  // (The LMB half lands in the local `lmb` -- see the top of this function -- and
  // jo_knob_interact reads mouse_cap, not LMB, so the knob does not depend on it.)
  lmb_down = _fb_g_lmbdown; LMB = _fb_g_lmbclick; rmb_down = _fb_g_rmbdown; frame_wheel = _fb_g_wheel;
  fb_prv_gain = jo_knob_interact(_fb_knob, _fb_kx, _fb_ky, 11, fb_prv_gain,
                                 0, 1, 0.7, 0);   // range, default (init at 213), no detents
  lmb_down = 0; LMB = 0; rmb_down = 0; frame_wheel = 0;
  jo_knob_draw(_fb_kx, _fb_ky, 11, fb_prv_gain, 0, 1, 0, fb_acc_r, fb_acc_g, fb_acc_b);

  // ══ drag-to-pad ═══════════════════════════════════════════════════════════
  // Last in the function, so the ghost and the target highlight land on top of
  // the pad grid -- the strip as a whole already paints after it.

  // 1 -> 2 once the pointer has actually travelled. Without the slop a shaky
  // click would register as a drag and drop somewhere the user never aimed.
  // ⚠️⚠️ READS mouse_cap DIRECTLY, not the `lmb` local set at the top of this
  // function. Measured 2026-08-29 with an injected-mouse probe: at the top of
  // the frame mouse_cap was 1 and (mouse_cap & 1) was 1, yet by the time this
  // line ran `lmb` read 0 -- so a press ARMED (state 1) and then never promoted
  // to a drag, which is exactly "nothing happens, no ghost". Whatever is
  // clobbering that local between the two points, the button state is right
  // here for the asking and a cached copy buys nothing.
  fb_drag_state == 1 && (mouse_cap & 1) &&
    (abs(mouse_x - fb_drag_x0) + abs(mouse_y - fb_drag_y0)) > FB_DRAG_SLOP ?
      fb_drag_state = 2;

  fb_drag_state == 2 ? (
    // Hit-test the pad grid. Geometry mirrors swing_grid_draw_pads exactly --
    // same origin, same stride, same face size as swing_grid_extdrag uses for
    // the big browser's OS drag, so the lit pad is the one that will receive it.
    fb_drag_pad = -1;
    _dox = grid_x + 2; _doy = grid_y + 2;
    _dpw = cell_w - 4; _dph = pad_h;
    _dr = 0;
    loop(4,
      _dc = 0;
      loop(4,
        _dcx = _dox + _dc * cell_w;
        _dcy = _doy + _dr * cell_h;
        mouse_x >= _dcx && mouse_x <= _dcx + _dpw &&
        mouse_y >= _dcy && mouse_y <= _dcy + _dph ? fb_drag_pad = (3 - _dr) * 4 + _dc;
        _dc += 1;
      );
      _dr += 1;
    );

    // The pad editor's layer tabs (published by the editor within the last quarter second): a drop there lands on that
    // layer (the user, 2026-10-22: "a very cool gesture"); over a tab the pad grid is not the target. The tabs light
    // themselves from ovl_drag_* (the run the drop fills).
    fb_drag_tab = -1;
    time_precise() - ovl_tabs_t < 0.25 && mouse_y >= ovl_tabs_y && mouse_y <= ovl_tabs_y + ovl_tabs_h ? (
      _dtk = 0; loop(MAX_LAYERS,
        mouse_x >= ovl_tabs_x + _dtk * ovl_tabs_w && mouse_x <= ovl_tabs_x + _dtk * ovl_tabs_w + ovl_tabs_w - 2 ? fb_drag_tab = _dtk;
        _dtk += 1;
      );
    );
    // ...and its waveform: the layer shown, as if dropped on that layer's tab (the owner, 2026-10-27)
    fb_drag_tab < 0 && time_precise() - ovl_wave_t < 0.25 && ovl_wave_pad == ovl_tabs_pad
      && mouse_x >= ovl_wave_x && mouse_x <= ovl_wave_x + ovl_wave_w && mouse_y >= ovl_wave_y && mouse_y <= ovl_wave_y + ovl_wave_h
      ? fb_drag_tab = ovl_wave_layer;
    fb_drag_tab >= 0 ? (
      fb_drag_pad = -1;
      _dtf = swing_layer_drop_first(ovl_tabs_pad, fb_drag_tab);
      ovl_drag_l0 = max(0, _dtf); ovl_drag_n = min(fb_drag_count, MAX_LAYERS - ovl_drag_l0); ovl_drag_t = time_precise();
    );

    // Light the landing pad, same treatment the OS-drag path uses so the two
    // gestures read identically.
    // Light the landing pad AND the run a multi-drop would fill, so the reach
    // of the gesture is visible before committing to it. A layer drop stays on
    // one pad however many files are held -- it stacks, it does not spread.
    fb_drag_pad >= 0 ? (
      _di = 0;
      loop(ALT ? 1 : min(fb_drag_count, NUM_PADS - fb_drag_pad),
        _dr  = 3 - (((fb_drag_pad + _di) / 4)|0);
        _dc  = (fb_drag_pad + _di) - ((((fb_drag_pad + _di) / 4)|0) * 4);
        _dcx = _dox + _dc * cell_w;
        _dcy = _doy + _dr * cell_h;
        gfx_set(1, 1, 1, _di == 0 ? 0.28 : 0.14);
        gfx_rect(_dcx, _dcy, _dpw, _dph);
        _di == 0 ? (
          gfx_set(1, 1, 1, 0.85);
          gfx_roundrect(_dcx - 1, _dcy - 1, _dpw + 2, _dph + 2, 4);
        );
        _di += 1;
      );
    );

    // Ghost, carrying the name. Follows the cursor even outside the canvas --
    // probe 2 proved the coordinates stay true out there.
    _di = _fb_rows + fb_drag_row * FB_REC;
    swing_fb_font(11, 0);
    // the redraw: a small card (the hairline, the card's colour), its state edge on the left
    gfx_set(fb_hln_r, fb_hln_g, fb_hln_b, 1); swing_fb_rr(mouse_x + 10, mouse_y - 10, 176, 22, 7);
    gfx_set(fb_crd_r, fb_crd_g, fb_crd_b, 1); swing_fb_rr(mouse_x + 11, mouse_y - 9, 174, 20, 6);
    // Green = will land. Amber = will land as a LAYER (Alt). Grey = nowhere.
    fb_drag_pad < 0 && fb_drag_tab < 0 ? gfx_set(0.62, 0.66, 0.72, 1)
                    : (ALT || fb_drag_tab >= 0) ? gfx_set(0.95, 0.66, 0.22, 1)
                          : gfx_set(0.30, 0.74, 0.44, 1);
    swing_fb_rr(mouse_x + 14, mouse_y - 6, 3, 14, 1.5);
    gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.95);
    fb_drag_count > 1 ? (
      gfx_x = mouse_x + 22; gfx_y = mouse_y - 1 - gfx_texth * 0.5;
      gfx_drawstr(sprintf(#, "%d files", fb_drag_count));
    ) : (
      swing_fb_rowstr(_di, #fb_gname, 0, min(_di[FB_R_LEN], FB_R_NAME_MAX));
      swing_fb_clipstr(#fb_gname, mouse_x + 22, mouse_y - 1 - gfx_texth * 0.5, 158);
    );
    fb_drag_pad >= 0 && ALT ? (
      swing_fb_font(11, 0);   // digits under 10 px stay regular (wiki §4.7)
      gfx_set(0.95, 0.72, 0.30, 1);
      gfx_x = mouse_x + 18; gfx_y = mouse_y + 14;
      _dtf = swing_pad_next_layer(swing_bp(fb_drag_pad));   // several files stack after it (the bridge's verb 7)
      fb_drag_count > 1 ? gfx_drawstr(sprintf(#, "+ LAYERS %d-%d", _dtf + 1, min(MAX_LAYERS, _dtf + fb_drag_count)))
                        : gfx_drawstr(sprintf(#, "+ LAYER %d", _dtf + 1));
    );
    fb_drag_tab >= 0 ? (
      swing_fb_font(11, 0);
      gfx_set(0.95, 0.72, 0.30, 1);
      gfx_x = mouse_x + 18; gfx_y = mouse_y + 14;
      ovl_drag_n > 1 ? gfx_drawstr(sprintf(#, "LAYERS %d-%d", ovl_drag_l0 + 1, ovl_drag_l0 + ovl_drag_n))
                     : gfx_drawstr(sprintf(#, "LAYER %d", ovl_drag_l0 + 1));
    );
  );

  // ── resolve on release ──
  _fb_rel && fb_drag_state > 0 ? (
    fb_drag_state == 2 && fb_drag_tab >= 0 && fb_drag_ext != 10 ? (
      // onto the pad editor's layer tab: the bridge takes REQ_COUNT files from the resolved layer
      // (swing_layer_drop_first; -1 = the first replaces the pad, the rest from layer 1), four layers at most
      fb_drag_layer = swing_layer_drop_first(ovl_tabs_pad, fb_drag_tab);
      swing_fb_request(7, fb_drag_ridx, ovl_tabs_pad);   // the editor's pad is a slot: absolute already
      overlay_layer = max(0, fb_drag_layer);              // the editor shows the layer the drop lands on
      sel_pad = ovl_tabs_pad;
    ) : fb_drag_state == 2 && fb_drag_pad >= 0 && fb_drag_ext != 10 ? (
      // ALT = stack as a LAYER instead of replacing the pad. Same convention
      // the big browser already uses (Swing_Browser.lua:4772), so the gesture
      // means the same thing in both places.
      // CMD 64 wants an explicit index, so pick the next free layer here --
      // clamped, because a full pad should stack on the last one rather than
      // silently do nothing; a PLAIN pad stacks on layer 1 (its sample is
      // layer 0 and gets promoted by the loader).
      ALT ? (
        fb_drag_layer = swing_pad_next_layer(swing_bp(fb_drag_pad));
        swing_fb_request(7, fb_drag_ridx, swing_bp(fb_drag_pad));   // the delivery names the ABSOLUTE pad (step 4a)
      ) : fb_drag_count > 1 ? swing_fb_request(8, fb_drag_ridx, swing_bp(fb_drag_pad))
                            : ( swing_fb_request(3, fb_drag_ridx, swing_bp(fb_drag_pad));
                                fb_preview ? fb_prv_name = fb_drag_ridx; );   // verb 3 carries REQ_AUD (sweep BRW16)
      // ⚠ The SLOT, both verbs (2026-10-15, the user: a drop on bank B..D landed on bank A). fb_drag_pad is
      // the 0..15 TILE from the hit test above; the bridge reads REQ_PAD as an absolute pad since step 4a
      // (verb 3 queues it as is, verb 8 fills from it to the end of ITS bank). Only the ALT branch had
      // been mapped. banks_adjacency_check's escape class now holds the 4x4 tile itself.
      sel_pad = swing_bp(fb_drag_pad);
      // No arming here any more: verb 3 carries REQ_AUD, so the bridge queues
      // the preview load right behind the pad load.
    ) : fb_drag_state == 1 ? (
      // Never moved, so it was a CLICK: on the row PRESSED (fb_drag_press; a
      // range press carries the range's first row in fb_drag_ridx), and a
      // range kept by a plain press inside it collapses to that row now
      // (sweep BRW15). Whether the click touches the kit is the LOAD switch's
      // business -- a drag always loads because it says where, but a click
      // should be able to mean "show me this one" and nothing more.
      // SFZ is never click-loaded either way: it is a 16-pad kit import.
      fb_drag_keep ? ( fb_sel = fb_drag_press; fb_sel_b = fb_drag_press; );
      (fb_autoload && fb_drag_ext != 10) ? (
        // verb 3 = load the pad, and (via REQ_AUD) queue the preview behind it
        swing_fb_request(3, fb_drag_press, sel_pad);
        fb_preview ? fb_prv_name = fb_drag_press;   // the row PLAY re-requests after a long file's end
      ) : (fb_preview && fb_drag_ext != 10) ? (
        // autoload OFF but audition ON: hear it without touching the kit. This
        // is the pairing the old pad-triggered audition could not express.
        swing_fb_request(12, fb_drag_press, -1);
        fb_prv_name = fb_drag_press;
      ) : swing_fb_request(5, fb_drag_press, -1);   // describe only
    );
    // dragged but released off the grid = CANCEL, deliberately doing nothing
    fb_drag_state = 0; fb_drag_pad = -1; fb_drag_tab = -1;
  );

  );  // fb_open

  // A drag must not survive the panel closing under it -- nor the audition (D-7):
  // the strip owns its player, so the frame it closes posts its STOP once.
  !fb_open ? ( fb_drag_state = 0; fb_drag_pad = -1; fb_drag_tab = -1; _fb_was_open ? fb_prv_cmd = 2; );
  _fb_was_open = fb_open;
);
