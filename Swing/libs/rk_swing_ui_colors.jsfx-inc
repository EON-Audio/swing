// rk_swing_ui_colors.jsfx-inc — Big View: COLORS (per-pad hue board)
// Second view on the Big View framework (VIEW_COLORS). Registry-only: reads
// the color engine's effective col_rgba[] + col_auto_hue[] and writes p_color
// / col_auto_mode_id — no new engine. Covers the pad-grid rect like the
// console/mapping views (own hit-testing on the restored _ov_* mouse).
//
// Opens via Shift+click the COLORS button (left-click keeps the inline panel).
// Auto-mode row (Manual / Type / Output / Rainbow) sets col_auto_mode_id; a
// 4x4 tile board shows each pad's effective color with a ghost swatch of what
// DrumType-auto would pick; a rainbow bar edits the selected pad's hue
// (manualizing the kit like the in-app picker); right-click a tile reverts
// that pad to its drum-type auto hue.
//
// Reuses swing_mapping_btn / swing_mapping_name_line (mapping lib, imported
// earlier) + the shared color helpers (rk_swing_colors).

@init

function swing_ui_colors_draw()
local(bx, by, m, cols, rows, gap, cw, ch, i, col, row, cx, cy, hov, cb, has,
      nm, gs, cat, dark, hue, barx, bary, barw, barh, bi, sx, act) (
  lmb_down = _ov_lmb_down; rmb_down = _ov_rmb_down;
  LMB = _ov_LMB; RMB = _ov_RMB; frame_wheel = _ov_wheel;

  // Keep the edit target on a playable pad (blank pads aren't colorable;
  // synth-only pads ARE — playable = sample OR enabled synth).
  !pad_is_playable(_cv_sel) ? (
    i = 0; loop(16, pad_is_playable(i) && !pad_is_playable(_cv_sel) ? _cv_sel = i; i += 1;);
  );

  // ── Backdrop + panel (violet identity) ───────────────────────────
  gfx_set(0, 0, 0, 0.45);
  gfx_rect(0, 28, gfx_w, gfx_h - 28);
  gfx_set(0.05, 0.05, 0.07, 0.98);
  gfx_rect(grid_x, grid_y, grid_w, grid_h);
  gfx_set(0.55, 0.45, 0.85, 0.55);
  gfx_rect(grid_x, grid_y, grid_w, 1);
  gfx_rect(grid_x, grid_y + grid_h - 1, grid_w, 1);
  gfx_rect(grid_x, grid_y, 1, grid_h);
  gfx_rect(grid_x + grid_w - 1, grid_y, 1, grid_h);

  // ── Title + close X ──────────────────────────────────────────────
  gfx_setfont(1, "Arial", 12, 'b');
  gfx_set(0.78, 0.68, 0.96, 0.95);
  gfx_x = grid_x + 8; gfx_y = grid_y + 4; gfx_drawstr("COLORS");
  _cv_cxb = grid_x + grid_w - 20; _cv_cyb = grid_y + 3;
  _cv_chov = mx >= _cv_cxb - 3 && mx <= _cv_cxb + 17 && my >= _cv_cyb - 2 && my <= _cv_cyb + 15;
  gfx_setfont(1, "Arial", 13, 'b');
  gfx_set(1, 1, 1, _cv_chov ? 0.95 : 0.55);
  gfx_x = _cv_cxb + 3; gfx_y = _cv_cyb; gfx_drawstr("X");

  // ── Auto-mode row: 0 Manual / 1 Type / 2 Output / 3 Rainbow ──────
  bx = grid_x + 74; by = grid_y + 4;
  m = 0; loop(4,
    m == 0 ? strcpy(#_cv_mb, "MANUAL") : m == 1 ? strcpy(#_cv_mb, "TYPE") :
    m == 2 ? strcpy(#_cv_mb, "OUTPUT") : strcpy(#_cv_mb, "RAINBOW");
    act = col_auto_mode_id == m;
    hov = mx >= bx && mx <= bx + 54 && my >= by && my <= by + 15;
    act ? gfx_set(0.45, 0.35, 0.75, 0.95) : gfx_set(0.18, 0.18, 0.24, hov ? 1.0 : 0.85);
    gfx_rect(bx, by, 54, 15);
    gfx_set(0.55, 0.50, 0.70, 0.8);
    gfx_rect(bx, by, 54, 1); gfx_rect(bx, by + 14, 54, 1);
    gfx_rect(bx, by, 1, 15); gfx_rect(bx + 53, by, 1, 15);
    gfx_setfont(1, "Arial", 9, 'b');
    gfx_set(act ? 1 : 0.82, act ? 1 : 0.84, act ? 1 : 0.9, 0.95);
    gfx_measurestr(#_cv_mb, _cv_tw, _cv_th);
    gfx_x = bx + (54 - _cv_tw) * 0.5; gfx_y = by + (15 - _cv_th) * 0.5; gfx_drawstr(#_cv_mb);
    hov && lmb_down ? ( col_auto_mode_id = m; col_dirty = 1; mark_dirty_kit(); );
    bx += 58;
    m += 1;
  );

  // ── Layout: tile board + hue bar ─────────────────────────────────
  cols = 4; rows = 4; gap = 6;
  barh = 34;
  bary = grid_y + grid_h - barh - 12;
  cx = grid_x + 12;                                  // board left
  cw = (grid_w - 24 - gap * (cols - 1)) / cols;
  ch = (bary - (grid_y + 28) - 18 - gap * (rows - 1)) / rows;

  // ── 4x4 tiles (reading order, pad 1 top-left) ────────────────────
  i = 0; loop(16,
    col = i % cols;
    row = i / cols | 0;
    cx = grid_x + 12 + col * (cw + gap);
    cy = grid_y + 28 + row * (ch + gap);
    hov = mx >= cx && mx < cx + cw && my >= cy && my < cy + ch;
    has = pad_is_playable(i);
    cb = i * 3;
    gfx_set(col_rgba[cb], col_rgba[cb + 1], col_rgba[cb + 2], has ? 1.0 : 0.4);
    gfx_rect(cx, cy, cw, ch);
    dark = (col_rgba[cb] + col_rgba[cb + 1] + col_rgba[cb + 2]) * 0.333 > 0.5;
    // selected / hover border
    i == _cv_sel ? gfx_set(1, 1, 1, 0.95) : (hov ? gfx_set(1, 1, 1, 0.5) : gfx_set(0, 0, 0, 0.5));
    gfx_rect(cx, cy, cw, 2); gfx_rect(cx, cy + ch - 2, cw, 2);
    gfx_rect(cx, cy, 2, ch); gfx_rect(cx + cw - 2, cy, 2, ch);
    // ghost swatch (top-right): what DrumType-auto would pick — loaded pads only
    has ? (
      hsl_to_rgb(swing_color_drumtype_hue(i), 0.75, 0.55);
      gfx_set(_hsl_r, _hsl_g, _hsl_b, 0.9);
      gfx_rect(cx + cw - 16, cy + 4, 12, 7);
      gfx_set(0, 0, 0, 0.5); gfx_rect(cx + cw - 16, cy + 4, 12, 1); gfx_rect(cx + cw - 16, cy + 10, 12, 1);
    );
    // pad number (top-left)
    gfx_setfont(1, "Arial", 9, 'b');
    dark ? gfx_set(0.08, 0.08, 0.1, 0.9) : gfx_set(0.98, 0.98, 1, 0.9);
    sprintf(#_cv_pl, "%d", i + 1);
    gfx_x = cx + 3; gfx_y = cy + 2; gfx_drawstr(#_cv_pl);
    // loaded: glyph + name; blank: dashed frame + EMPTY
    has ? (
      nm = get_cname_slot(i);
      strlen(nm) == 0 ? nm = get_name_slot(i);
      strlen(nm) > 0 ? (
        gs = (min(cw, ch) * 0.4) | 0;
        gs > 6 ? (
          dark ? gfx_set(0.08, 0.09, 0.11, 0.9) : gfx_set(0.95, 0.96, 0.98, 0.9);
          cat = eon_cat_for_name(nm);
          eon_draw_cat_glyph_hi(cat, (cx + cw * 0.5) | 0, (cy + ch * 0.42) | 0, gs, -1);
        );
        swing_mapping_name_line(cx + cw * 0.5, cy + ch - 15, cw - 4, nm, dark);
      );
    ) : (
      gfx_setfont(1, "Arial", 9, 0);
      gfx_set(0.48, 0.48, 0.54, 0.6);
      gfx_measurestr("EMPTY", _cv_tw, _cv_th);
      gfx_x = cx + (cw - _cv_tw) * 0.5; gfx_y = cy + (ch - _cv_th) * 0.5; gfx_drawstr("EMPTY");
    );
    // select + audition — only loaded pads become the hue-edit target
    hov && lmb_down ? (
      sel_pad = i;
      has ? ( _cv_sel = i; launch_voices_for_pad(i, p_note[i], 110, 8); );
    );
    // right-click → revert this pad to its drum-type auto hue (loaded only)
    hov && rmb_down && has ? (
      swing_color_manualize(i);
      p_color[i] = swing_color_drumtype_hue(i);
      col_dirty = 1; mark_dirty_kit();
    );
    i += 1;
  );

  // ── Hue bar + achromatic swatches for the selected pad (loaded only) ──
  barx = grid_x + 12; barw = grid_w - 24 - 62;   // leave room for W/B swatches
  has = pad_is_playable(_cv_sel);
  gfx_setfont(1, "Arial", 9, 'b');
  gfx_set(0.7, 0.7, 0.78, 0.9);
  nm = get_cname_slot(_cv_sel); strlen(nm) == 0 ? nm = get_name_slot(_cv_sel);
  sprintf(#_cv_pl, "HUE — Pad %d", _cv_sel + 1);
  gfx_x = barx; gfx_y = bary - 12; gfx_drawstr(#_cv_pl);
  has && strlen(nm) > 0 ? ( gfx_x = barx + 92; gfx_drawstr(nm); );
  has ? (
    // rainbow strip
    bi = 0; loop(barw | 0,
      sx = barx + bi;
      hsl_to_rgb(bi / barw, 0.75, 0.55);
      gfx_set(_hsl_r, _hsl_g, _hsl_b, 1);
      gfx_rect(sx, bary, 1, barh);
      bi += 1;
    );
    // current-hue marker (only when the pad is on a real hue, not W/B)
    hue = col_auto_mode_id > 0 ? col_auto_hue[_cv_sel] : p_color[_cv_sel];
    hue >= 0 ? (
      sx = barx + hue * barw;
      gfx_set(0, 0, 0, 0.9); gfx_rect(sx - 2, bary - 2, 4, barh + 4);
      gfx_set(1, 1, 1, 0.95); gfx_rect(sx - 1, bary - 2, 2, barh + 4);
    );
    // drag on the bar → set the selected pad's hue (manualize on first touch)
    mx >= barx && mx <= barx + barw && my >= bary && my <= bary + barh && lmb_down ? _cv_bar_drag = 1;
    _cv_bar_drag && LMB ? (
      hue = (mx - barx) / barw;
      hue < 0 ? hue = 0; hue > 1 ? hue = 1;
      swing_color_manualize(_cv_sel);
      p_color[_cv_sel] = hue;
      col_dirty = 1;
    );
    _cv_bar_drag && !LMB ? ( _cv_bar_drag = 0; mark_dirty_kit(); );

    // achromatic swatches: WHITE (p_color -1) / BLACK (-2), right of the bar
    bx = barx + barw + 6;
    gfx_set(0.85, 0.85, 0.88, 1); gfx_rect(bx, bary, 26, barh);
    (p_color[_cv_sel] > -1.5 && p_color[_cv_sel] < 0) ? gfx_set(1, 0.9, 0.35, 0.95) : gfx_set(0.35, 0.35, 0.4, 0.8);
    gfx_rect(bx, bary, 26, 2); gfx_rect(bx, bary + barh - 2, 26, 2); gfx_rect(bx, bary, 2, barh); gfx_rect(bx + 24, bary, 2, barh);
    mx >= bx && mx <= bx + 26 && my >= bary && my <= bary + barh && lmb_down ? ( swing_color_manualize(_cv_sel); p_color[_cv_sel] = -1; col_dirty = 1; mark_dirty_kit(); );
    bx += 30;
    gfx_set(0.11, 0.11, 0.13, 1); gfx_rect(bx, bary, 26, barh);
    (p_color[_cv_sel] <= -1.5) ? gfx_set(1, 0.9, 0.35, 0.95) : gfx_set(0.35, 0.35, 0.4, 0.8);
    gfx_rect(bx, bary, 26, 2); gfx_rect(bx, bary + barh - 2, 26, 2); gfx_rect(bx, bary, 2, barh); gfx_rect(bx + 24, bary, 2, barh);
    mx >= bx && mx <= bx + 26 && my >= bary && my <= bary + barh && lmb_down ? ( swing_color_manualize(_cv_sel); p_color[_cv_sel] = -2; col_dirty = 1; mark_dirty_kit(); );
  ) : (
    // no loaded pad selected → disabled bar + hint
    gfx_set(0.14, 0.14, 0.17, 1);
    gfx_rect(barx, bary, barw, barh);
    gfx_set(0.5, 0.5, 0.56, 0.7);
    gfx_setfont(1, "Arial", 10, 0);
    gfx_measurestr("load a sample to color a pad", _cv_tw, _cv_th);
    gfx_x = barx + (barw - _cv_tw) * 0.5; gfx_y = bary + (barh - _cv_th) * 0.5; gfx_drawstr("load a sample to color a pad");
    _cv_bar_drag = 0;
  );

  // ── Close: X or click outside ────────────────────────────────────
  _cv_out = mx < grid_x || mx > grid_x + grid_w || my < grid_y || my > grid_y + grid_h;
  lmb_down && (_cv_chov || (_cv_out && active_id == -1)) ? (
    swing_bigview_close();
    active_id = -1;
  );

  lmb_down = 0; rmb_down = 0; LMB = 0; RMB = 0; frame_wheel = 0;
);
