    p_layer_cnt[_lv_pad] > 0 ? (
      j = 0; loop(p_layer_cnt[_lv_pad],
        l_len[_lv_pad * MAX_LAYERS + j] > 0 ? _active_cnt += 1;
        j += 1;
      );
    ) : (
      s_len[_lv_pad] > SILENCE_T + 4 ? _active_cnt += 1;
    );
    ps_enable[_lv_pad] ? _active_cnt += 1;
  );
  _sum_cnt = _is_sum ? p_layer_cnt[_lv_pad] : 1;
  _sum_cur = 0;
  while(_sum_cur < _sum_cnt) (
    _is_sum ? (
      _sel_layer = _sum_cur;
      _skip_voice = l_len[_lv_pad * MAX_LAYERS + _sel_layer] <= 0;
    ) : (
      p_layer_cnt[_lv_pad] > 0 ? (
        _sel_layer = select_layer(_lv_pad, _lv_vel / 127.0, p_layer_mode[_lv_pad]);
        // MAX_LAYERS = SYN sentinel (round-robin): this hit belongs to the
        // synth — skip the sample voice, flag the synth launch below.
        _sel_layer >= MAX_LAYERS ? ( _sel_syn = 1; _skip_voice = 1; ) : _skip_voice = 0;
      ) : (
        _sel_layer = -1;
        _skip_voice = 0;
      );
    );
    !_skip_voice ? (
      // Find free voice or oldest for steal (single pass)
      vi = -1; max_age = -1; _oldest_vi = -1;
      j = 0; loop(MAX_VOICES,
        v_pos[j] < 0 && v_stage[j] == 0 ? (
          vi < 0 ? vi = j;  // take first free slot
        ) : (
          v_age[j] > max_age ? (max_age = v_age[j]; _oldest_vi = j;);
        );
        j += 1;
      );
      vi < 0 ? ( vi = _oldest_vi; );  // no free voice — steal oldest
      // Steal: vi points at an in-use voice that needs to be replaced
      vi >= 0 && (v_pos[vi] >= 0 || v_stage[vi] > 0) ? (
        // If stolen voice was still waiting (negative v_pos, pre-delay), just kill it
        v_pos[vi] < 0 ? (
          v_pos[vi] = -1; v_env[vi] = 0; v_stage[vi] = 0;
        ) : (
          swing_voice_steal_park(vi);   // into the quietest steal-fade slot, then park vi (A-2)
        );
      );
      vi >= 0 ? (
        v_slot[vi] = _lv_pad;
        v_kind[vi] = 0;   // sample voice (slot may be reused from a synth voice)
        // Reaching the local path on a STRETCH pad means the Extension was
        // unreachable, so @sample must sum this voice rather than defer to a ring
        // that will never fill. Every other mode stamps 0 and behaves as before.
        v_stfb[vi] = swing_pitch_eff(_lv_pad) == SP_PITCH_MODE_STRETCH ? 1 : 0;
        _sel_layer >= 0 && p_layer_cnt[_lv_pad] > 0 ? (
          v_layer[vi] = _sel_layer;
          _lidx = _lv_pad * MAX_LAYERS + _sel_layer;
          _slen = l_len[_lidx];
          _sstart = l_start[_lidx];
          _send = l_end[_lidx];
          _ssr = l_sr[_lidx];
        ) : (
          v_layer[vi] = 0;
          _slen = s_len[_lv_pad];
          _sstart = s_start[_lv_pad];
          _send = s_end[_lv_pad];
          _ssr = s_sr[_lv_pad];
        );
        // Clamp start/end to safe interleaved range (SILENCE_T margin for interpolation)
        _end_i = min(_send * _slen, _slen) - SILENCE_T;
        _end_i = max(0, _end_i);
        _start_i = max(0, min(_sstart * _slen, _end_i));
        // Skip launch if sample too short for safe playback
        _slen > SILENCE_T + 4 ? (
        // When MODE=Tuned, the Extension bakes the pad's audio to pitch and
        // swaps it in (~70 ms after a knob move). Playing the baked buffer at
        // native rate only sounds right ONCE the bake has caught up — until
        // then the old buffer is at the OLD pitch, which is the lag the user
        // hears. So play the RESIDUAL between the live tune and the tune the
        // current buffer is baked at (sp_baked_tune): a knob move shows up
        // INSTANTLY as a varispeed shift, and the residual returns to 0 (pure
        // duration-preserved) when the matching bake arrives. Extension absent
        // → fall back to full Repitch so the pad still tracks the knob.
        // Per-layer residual (A4/A5): each layer is baked independently, so the
        // anchor is sp_baked_tune[pad*MAX_LAYERS + selected_layer]. Layered pads
        // (Sum/VelSplit/RR) pick the sounding layer; non-layered pads (_sel_layer
        // < 0) use layer 0. Until a layer's bake lands its anchor is 0, so it
        // residual-repitches the full tune via varispeed (correct pitch, shorter
        // duration) — matching the Extension-absent fallback per layer.
        _bt_lidx = _lv_pad * MAX_LAYERS + (_sel_layer >= 0 ? _sel_layer : 0);
        // Chromatic offset: 0 for single-note pads (played == root). For a
        // chromatic pad it varispeeds the sample by the key's distance from
        // root. In Tuned mode this rides on the residual — the Extension only
        // ever bakes at p_tune (never the played note), so root plays the
        // pristine bake and off-root keys varispeed off it (no double-pitch).
        _st_off = _lv_midi - p_note[_lv_pad];
        _pt_eff = (swing_pitch_eff(_lv_pad) == SP_PITCH_MODE_TUNED ?
          (sp_pitch_ext_alive ? (p_tune[_lv_pad] - sp_baked_tune[_bt_lidx]) : p_tune[_lv_pad]) :
          p_tune[_lv_pad]) + _st_off;
        p_reverse[_lv_pad] ? (
          v_pos[vi] = _end_i;
          v_inc[vi] = -pow(2.0, _pt_eff / 12.0) * 2.0 * (_ssr > 0 ? _ssr / srate : 1.0);
        ) : (
          v_pos[vi] = _start_i;
          v_inc[vi] = pow(2.0, _pt_eff / 12.0) * 2.0 * (_ssr > 0 ? _ssr / srate : 1.0);
        );
        // Apply sample offset — absolute position in sample, clamped to trim bounds
        p_sample_offset[_lv_pad] > 0.001 ? (
          _abs_ofs = p_sample_offset[_lv_pad] * _slen;
          v_pos[vi] = max(_start_i, min(_end_i, _abs_ofs));
        );
        // Sum mode loose timing: delay non-primary layers by random 0-40 samples
        // Store real start position so delayed voice resumes at correct trim point
        v_startpos[vi] = v_pos[vi];
        // Sub-block start offset and sum-mode looseness are the same mechanism
        // -- a negative v_pos the renderer counts up -- so they simply add.
        // The +1 is the encoding, not a fudge: the renderer increments BEFORE it
        // tests, so v_pos = -N first sounds at sample N-1. Measured, not reasoned:
        // without it every repeat landed exactly one sample ahead of its step.
        _delay = _lv_ofs > 0 ? _lv_ofs + 1 : 0;
        _is_sum && _sum_cur > 0 && p_sum_tight[_lv_pad] > 0.001 ? (
          _delay += (rand(40) * p_sum_tight[_lv_pad])|0;
        );
        _delay > 0 ? v_pos[vi] = -_delay;
        v_gain[vi] = apply_vel_curve(_lv_vel / 127.0, vel_curve);
        // Sum mode: compensate gain by active (non-empty) layer count
        _comp_sum && _active_cnt > 1 ? ( v_gain[vi] = v_gain[vi] / sqrt(_active_cnt); );
        v_note[vi] = _lv_midi;   // PLAYED note (was p_note[pad]) so note-off matches the actual key
        v_age[vi] = 0; v_fastrel[vi] = 0;
        v_env[vi] = 0;
        v_decay_ct[vi] = 0;
        // One-Mixer console tie: while strip_takeover (multi-out + fresh
        // strip-sync heartbeat) the child track's D_VOL is the ONE audible
        // gain stage — the companion mirrors p_gain onto it, so applying
        // p_gain here too would square the gain. Layer/norm gains stay:
        // they're sample identity, not mix. Baked at launch (matches the
        // existing p_gain semantics; takeover flips affect new hits only).
        _tie_pg = strip_tk[_lv_pad] ? 1.0 : p_gain[_lv_pad];
        _sel_layer >= 0 && p_layer_cnt[_lv_pad] > 0 ? (
          _lidx = _lv_pad * MAX_LAYERS + _sel_layer;
          v_sg[vi] = _tie_pg * l_gain[_lidx] * (l_norm[_lidx] ? l_norm_gain[_lidx] : 1.0);
        ) : (
          v_sg[vi] = _tie_pg * (s_norm[_lv_pad] ? s_norm_gain[_lv_pad] : 1.0);
        );
        swing_voice_prep(vi);   // block constants: the buffer pointer, the trim bounds, the sum gate (slot / layer / stfb are set above)
        // v_stage MUST be set last — audio thread uses it as the gate condition.
        // Setting it before v_env/v_sg causes a race where @sample reads stale values.
        v_gen[vi] += 1;   // a new voice: a note-off queued for this slot's last one must not release it
        vi + 1 > v_hi ? v_hi = vi + 1;   // step 2c: the @sample loop must reach this slot before the gate opens
        v_stage[vi] = 1;
        ) : ( // _slen too short — kill voice
          v_pos[vi] = -1; v_env[vi] = 0; v_stage[vi] = 0;
        );
      );
    );
    _sum_cur += 1;
  );

  // ── SYN slot launch (Spec_Swing_Synth_Layer §2.2) ──────────────────────
  // Independent of the sample voices. Per layer mode: sum = always underneath;
  // vel-split = plays when vel is in the ps_ range; round-robin = when the
  // extended rotation selected it (sentinel above); single = only when the pad
  // has no sample audio (the emergent "synth pad" rule — no mode flag).
  // Stretch pads excluded: their audio path is the Extension ring.
  ps_enable[_lv_pad] && swing_pitch_eff(_lv_pad) != SP_PITCH_MODE_STRETCH ? (
    _has_smp = 0;
    p_layer_cnt[_lv_pad] > 0 ? (
      j = 0; loop(p_layer_cnt[_lv_pad],
        l_len[_lv_pad * MAX_LAYERS + j] > 0 ? _has_smp = 1;
        j += 1;
      );
    ) : (
      s_len[_lv_pad] > SILENCE_T + 4 ? _has_smp = 1;
    );
    _syn_go =
      !_has_smp ? 1 :
      p_layer_mode[_lv_pad] == 3 ? 1 :
      p_layer_mode[_lv_pad] == 1 ? (
        _syn_v = _lv_vel / 127.0;
        _syn_v >= ps_vel_lo[_lv_pad] && (_syn_v < ps_vel_hi[_lv_pad] || ps_vel_hi[_lv_pad] >= 1.0)
      ) :
      p_layer_mode[_lv_pad] == 2 ? _sel_syn :
      0;
    // Body lives in launch_syn_for_pad (defined above) so the SYN view can
    // audition the engine on its own. Sum mode splits gain across the active
    // layers; every other mode plays the synth at full level, divisor 1.
    _syn_go ? (
      launch_syn_for_pad(_lv_pad, _lv_midi, _lv_vel,
                         _comp_sum && _active_cnt > 1 ? sqrt(_active_cnt) : 1,
                         _lv_ofs);
    );
  );
  pad_flash[_lv_pad] = _lv_flash;
  swing_voice_choke_at(_lv_pad, _lv_ofs);   // duplicate-kill + choke group, local voices and Stretch pads (A-7), at the hit's sample
  );  // end of Mode != Stretch branch (Step 3b launch_voices divert)
);

// Every caller that wants a hit NOW keeps the four-argument name. EEL2 has no
// overloading, so the offset-aware version needs its own -- rather than touch
// all 20 existing call sites to append a 0.
function launch_voices_for_pad(_lv_pad, _lv_midi, _lv_vel, _lv_flash) (
  launch_voices_for_pad_ofs(_lv_pad, _lv_midi, _lv_vel, _lv_flash, 0);
);
