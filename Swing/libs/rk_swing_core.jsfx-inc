// rk_swing_core.jsfx-inc
// Swing core utility functions: name/path slots, sample loading, voice launch
// (c) EON Studios — All Rights Reserved

@init

// ─── Dirty markers ───────────────────────────────────────────────────────
// Swing keeps per-pad state in freemem arrays (not sliders). These used to
// bump hidden counter sliders (slider3 global, slider6..21 per pad) so REAPER
// would capture an undo point per pad. Since Phase 1B an edit instead raises
// gmem GS_PROJ_DIRTY, which the bridge turns into a project-dirty mark
// (prompt-to-save) with NO REAPER undo point; per-pad edits also light the
// kit's unsaved dot and queue Swing's own param undo (mark_dirty_pad). The
// counter sliders stay declared; edits no longer move them. Since 2026-10-27
// the REAPER undo point is asked for once, at the END of the gesture
// (swing_rup_*, rk_drumkit_dsp), never by a mark.
//
// Defined at the top of rk_swing_core.jsfx-inc so it's available to all
// libs imported after this one (which is everything else under libs/).
function mark_dirty() (
  // Phase 1B: signal project-dirty to the bridge instead of slider_automate,
  // so Swing changes no longer mint REAPER global-undo points (global Ctrl+Z
  // can't restore a stale Swing chunk). Save still works via @serialize. The
  // hidden counter sliders are left untouched (no @slider logic depends on
  // them — recalc is done by the per-pad callers directly).
  // 2026-10-27: a plain mark_dirty is a view or preference change (the bank on screen, a panel, a console option, the
  // sequencer's own settings) and asks for no REAPER undo point. An edit to what Swing PLAYS asks for one at its
  // gesture's end: mark_dirty_kit, mark_dirty_play, mark_dirty_pad (swing_rup_*, rk_drumkit_dsp).
  gmem[GS_PROJ_DIRTY] = 1;
);
// A setting that changes how Swing plays but is not a kit key (the master DRIVE type, the repeat's grid and feel):
// mark_dirty, and counted for its gesture's REAPER undo point like a kit edit (2026-10-27).
function mark_dirty_play() (
  mark_dirty();
  !kit_busy && !_srz_udo_hold ? ( rup_kn += 1; );
);

// Pad Banks step 4a.1 (user, 2026-09-23): Tuned and Stretch are bank A's for now. The EON Extension's per-instance
// tables are sixteen pads wide (STRETCH_CONTROL_INSTANCE_STRIDE 80, STRETCH_INST_AUDIO_STRIDE 16 x 32768): a slot
// past 15 indexes past this instance's row -- control cell 19 is bank A pad 3's pitch semitones, and pad 19's audio
// block is the NEXT instance's. So every consumer reads the EFFECTIVE mode through here: a pad outside bank A is
// Repitch whatever its stored mode says (the stored value is kept and comes back if the pad is swapped into A).
// The shared slot pool -- any sixteen pads across the banks -- is its own step.
// A pad tunes or stretches only while it holds a SPOT (sp_row, the spot map of rk_swing_block_pitch: step 3 =
// identity, bank A pad s on spot s, so a B..D pad has none and plays Repitch -- 4a.1 as before); a stored mode
// without a spot is kept and plays Repitch (§5.6).
function swing_pitch_eff(ap) ( sp_row[ap] >= 0 ? sp_pitch_mode[ap] : SP_PITCH_MODE_REPITCH; );

// May the companion mailbox's command c be taken now (Swing_ReaKit's @gfx companion block)? Held while kit_busy, but New
// Kit (4) decides at once (audit H23), and the Multi-Out adopt (5) is taken during Swing's OWN build (_mo_own: its
// right-click builder raised CMD 40 / 74 and stays kit_busy until the bridge's 99). Held there, the bridge's reset of every
// pad's output landed after the build's undo point, so an undo / redo of a build or a Rebuild did not move the outputs
// (the undo sweep's item 1, 2026-10-29: EON_Probe_UndoMap E2 / E5 judged FAIL on outs#). The Update's switch (7) too
// since 2026-10-30 (the sweep's (h)): the bridge now waits for Swing to take it before the Update's block opens, and a 7
// held for Swing's own build would only time out (it is harmless there: prep already put Swing in Multi-Out).
function swing_companion_take(c) ( !kit_busy || c == 4 || ((c == 5 || c == 7) && _mo_own); );

// The pad's source generation as the spot map publishes it: the @init epoch (sp_epoch: never 0, a multiple of
// SP_EPOCH_UNIT, below 2^30) plus sp_src_gen. A reopened or duplicated instance therefore never repeats a
// previous instance's values on the same slot (the Extension compares the SRCGEN band with !=).
function swing_spot_gen(_ssg_pad) ( sp_epoch + sp_src_gen[_ssg_pad]; );

// Is this pad's Stretch output held to the plain way right now (Plan_Swing_Pad_Banks_Tuned §5A.3's hold)?
// sp_hold is set by swing_spot_tick (rk_swing_block_pitch) when it sees a source change and cleared SP_HOLD_TICKS
// Extension heartbeats after the bridge's answer; the second term covers a change the tick has not seen yet (a
// load in THIS block, before the next tick), so even the first hit after the change cannot reach the old sound.
function swing_pitch_held(_sph_pad)
local(_sph_r)
(
  _sph_r = sp_row[_sph_pad];
  sp_hold[_sph_pad] || (_sph_r >= 0 && sp_map_gen[_sph_r] != swing_spot_gen(_sph_pad));
);

// Pad Banks step 4 (2026-10-09): which pads need a spot, which spots may be lent, and the mode stepper's refusal.
// Here, beside swing_pitch_eff, because the LCD compiles before rk_swing_block_pitch (whose swing_spot_assign
// does the lending; the long comment there says how).
function swing_spot_wants(_sw_p)
(
  (sp_pitch_mode[_sw_p] == SP_PITCH_MODE_TUNED || sp_pitch_mode[_sw_p] == SP_PITCH_MODE_STRETCH) && pad_has_audio(_sw_p);
);

// A spot that may be lent now: not draining, and its owner (if any) does not need it.
function swing_spot_idle(_si_r)
local(_si_p)
(
  _si_p = pr_pad[_si_r];
  pr_state[_si_r] != SPOT_STATE_DRAINING && (_si_p < 0 || !swing_spot_wants(_si_p));
);

// Would the mode stepper's change of _sr_p into _sr_m be refused (§5.6)? Leaving Tuned / Stretch, a pad that holds a
// spot, or one with no audio yet (it asks when audio arrives) never is. Otherwise a spot must be idle or free for it
// beyond the pads already waiting, and away from its own spot only with a bridge that answers.
function swing_spot_refuse(_sr_p, _sr_m)
local(_sr_r _sr_n _sr_w)
(
  (_sr_m != SP_PITCH_MODE_TUNED && _sr_m != SP_PITCH_MODE_STRETCH) || sp_row[_sr_p] >= 0 || !pad_has_audio(_sr_p) ? 0 : (
    !sp_br_lends ? 1 : (
      _sr_n = 0; _sr_r = 0;
      loop(NUM_PADS, (swing_spot_idle(_sr_r) || pr_state[_sr_r] == SPOT_STATE_DRAINING) ? _sr_n += 1; _sr_r += 1; );
      _sr_w = 0; _sr_r = 0;
      loop(NUM_SLOTS, _sr_r != _sr_p && sp_row[_sr_r] < 0 && swing_spot_wants(_sr_r) ? _sr_w += 1; _sr_r += 1; );
      _sr_n <= _sr_w;
    );
  );
);

// Is this pad waiting for a spot (needs one, holds none)? The LCD's line.
function swing_spot_waiting(_sw_p) ( sp_row[_sw_p] < 0 && swing_spot_wants(_sw_p); );

// Kit-scoped dirty: mark_dirty PLUS the unsaved-kit dot. For edits to state
// the KIT FILE persists that isn't pad-indexed — the 42 KIT_GLOBAL_KEYS
// (master EQ/delay/reverb/comp, repeat_div, vel_curve, note_map, multi_out,
// oneshot_global, sat_drv) and kit-content bulk ops (New Kit, reset colors,
// MIDI-learn, no-bridge swap). Before this, ONLY pad edits lit the dot —
// change the kit's whole feel and it stayed dark. ⛔Do NOT use for prefs the
// kit file does not save (midi_thru, tooltips, embed_mode, adsr_3node,
// pad_icon_mode, knob styles, map_override_locked, gfx_drv_mode): a display
// toggle showing "unsaved kit changes" teaches users to ignore the dot.
// Same !kit_busy guard as mark_dirty_pad — a kit import's edit storm is not
// a user modification.
// Step 4a (user decision 2026-09-23, "switch"): selecting a pad selects its bank too -- the grid always shows
// the pad the LCD edits. Every sel_pad assignment that comes from a note, a companion or a landed pad goes
// through here; a tile click already sits in bank_cur. A bank change is a view change: mark_dirty() so the
// project registers it (bank_cur is serialized), never an undo boundary (spec 12).
// 2026-10-27 (the owner: "a bank switch if it changes saved state" is an undo point): bank_cur is saved, so a switch
// asks for a REAPER undo point -- a weak one, which a stronger request waiting with it names instead.
function swing_select_pad(ap) local(_b) (
  sel_pad = ap;
  _b = (ap / NUM_PADS) | 0;
  _b != bank_cur ? (
    bank_cur = _b; mark_dirty(); swing_rup_want(RUP_K_BANK, _b, -1, -1, 0);
    _reg_my_slot >= 0 ? gmem[GS_INST_BANK_CUR + _reg_my_slot] = bank_cur;   // step 5a: at once (the @block publish heals)
  );
);
function mark_dirty_kit() (
  mark_dirty();
  // TEMP DIAGNOSTIC (project-open false dirty, 2026-08-05; site tags added
  // 2026-08-11): record the first setter. _kd_src 1+pad = pad-scoped (see
  // mark_dirty_pad); 1000 = kit-scoped from a GESTURE site; 1002..1009 =
  // kit-scoped from an AUTO-capable site (the caller stamps _kd_site just
  // before calling): 1002=clear_pad 1003=pad-swap 1004=new-kit/companion-4
  // 1005=companion-5 multi-out adopt (RETIRED 2026-08-11 — the adopt no
  // longer marks dirty at all; a 1005 sighting means a stale JSFX build)
  // 1006=multiout_prep 1007=syn-newkit 1008=comp-link adopt (bus Weld)
  // 1009=tone-link adopt (EON Tone).
  // ⚠ 1008/1009 cover BOTH halves of each link: the first-sight prime and a
  // later rack edit arriving over the row. Neither is a Swing gesture, and
  // until 2026-09-20 both stamped nothing and landed here as 1000 -- so the
  // one instrument built to find project-open false dirty was reporting the
  // likeliest cause of it as a user click. A 1008/1009 at project-open time
  // is legitimate but still worth a look: it means a rack was adopted.
  (!kit_busy && kit_dirty == 0) ? ( _kd_src = 1000 + _kd_site; _kd_t = time_precise(); );
  !kit_busy ? kit_dirty = 1;
  // A gesture's kit edit, counted for its REAPER undo point (swing_rup_gend, 2026-10-27). A tagged site is never a
  // gesture (the adopts, a clear, a swap, New Kit, the multi-out prep: each has its own point or none).
  !kit_busy && !_srz_udo_hold && _kd_site == 0 ? ( rup_kn += 1; );
  _kd_site = 0;   // tag is consume-once; untagged (gesture) sites read 0
);

// Returns 1 if MAP-preset application may write pad i's note, 0 if it must
// be skipped. Normally a manually-set (locked) pad is skipped; the
// map_override_locked option (slider23, MAP right-click menu) makes presets
// override locked pads too. Scope is MAP-apply ONLY — the lock still guards
// recalc_pad/root_note (rk_drumkit_dsp). map_override_locked persists in the
// FX chunk (no @serialize touch).
// A PRESET lock (p_note_lock 2, below) is not the user's: a map operation may replace it.
function swing_map_unlocked(i) (
  map_override_locked || p_note_lock[i] != 1;
);
// Step 4d (Pad Banks): a note-map preset writes ONE bank. The caller sets _mp_bank; the preset names its notes
// as bank A's layout (tile t -> note n) and they land in that bank's block, 16 notes up per bank. Clamped at
// 127; the user's locked pads keep their notes (unless the MAP override is on).
// Pad Banks audit S9 (user decision 2026-09-24): the note is PRESET-locked (p_note_lock 2). recalc_pad re-derives
// an unlocked pad as root + slot, and every pad edit, load and swap posts one -- so a preset's note in an UNLOCKED
// pad was lost to the first knob turn (GM's pad 2 fell back to chromatic, onto pad 3's note), and a preset in
// another bank that moved the shared root would have moved this one. A later preset replaces a preset lock.
function swing_map_set(t, n) local(ap) (
  ap = _mp_bank * NUM_PADS + t;
  swing_map_unlocked(ap) ? ( p_note[ap] = min(127, n + 16 * _mp_bank); p_note_lock[ap] = 2; );
);

// Per-pad dirty marker. pad_idx is an absolute slot, 0..NUM_SLOTS-1: raises
// the project-dirty signal, the kit's unsaved dot and the pad's param-undo
// pend (below). Out of range falls through to mark_dirty() so accidental
// mis-callers don't crash.
function mark_dirty_pad(pad_idx)
local(_sn)
(
  pad_idx >= 0 && pad_idx < NUM_SLOTS ? (
    // Phase 1B: project-dirty signal, NOT slider_automate — no REAPER undo point.
    gmem[GS_PROJ_DIRTY] = 1;
    // Kit-level dirty (drives the SAVE button's unsaved-changes dot). Every
    // pad mutation funnels through here, so this is the one honest hook.
    // !kit_busy excludes the mark_dirty_pad storm a kit IMPORT produces —
    // a kit is not "modified" the instant it finishes loading. Cleared on
    // save completion (bridge CMD 99 reply) and at import state-4 completion.
    // Deliberately NOT initialised in @init: a sample-rate change re-runs
    // @init, and zeroing there would silently forget unsaved edits.
    (!kit_busy && kit_dirty == 0) ? ( _kd_src = 1 + pad_idx; _kd_t = time_precise(); _kd_n = 0; );
    !kit_busy ? ( kit_dirty = 1; _kd_n += 1; );
    // Internal PARAM undo: flag this pad as edited in the current gesture so
    // the mouse-UP commit pushes one undo entry for it. Suppressed while the
    // undo engine itself is restoring (_udo_applying) to avoid self-capture.
    // The `_udo_pend &&` guard skips any pre-@init-allocation call (base 0).
    // _udo_cap_depth==0 guard: don't let a STRUCTURAL op (clear/load/swap/kit)
    // also queue a param-undo entry — otherwise undo_do would do a param undo
    // (no audio) instead of the structural restore, and the pad wouldn't come back.
    _udo_pend && !_udo_applying && _udo_cap_depth == 0 ? ( _udo_pend[pad_idx] = 1; );
  ) : (
    mark_dirty();
  );
);

// ─── Name / path string arrays ───────────────────────────────────────────
// Step 3a (2026-09-23): NUMBERED string slots, one per absolute slot 0..NUM_SLOTS-1, at the bases the
// Constants block declares (PNAME_STR_BASE / PPATH_STR_BASE / CNAME_STR_BASE, Swing_ReaKit.jsfx). Until
// step 3a these were sixteen-way ternaries over the named strings #pn0..15 / #pp0..15 / #cn0..15 -- the
// last sixteen-wide state in the engine ("16 STRING SLOTS" in the step 2b handoff). An index past the
// last slot is clamped, never allowed to run into the next base (the old #pp15 clamp, kept).
function get_name_slot(idx)  ( PNAME_STR_BASE + max(0, min(NUM_SLOTS - 1, idx | 0)); );
function get_path_slot(idx)  ( PPATH_STR_BASE + max(0, min(NUM_SLOTS - 1, idx | 0)); );
function get_cname_slot(idx) ( CNAME_STR_BASE + max(0, min(NUM_SLOTS - 1, idx | 0)); );
// The name each of the SIXTY-FOUR pads last published into the all-bank name band (2026-10-22): the publish's own
// shadows, one strcmp per pad per block in place of 32 gmem reads. Written by that publisher alone; never a user string.
function get_id64name_slot(idx) ( ID64NAME_STR_BASE + max(0, min(NUM_SLOTS - 1, idx | 0)); );
// The name each pad LAST PUBLISHED into its IDENT band (Phase 4, A O-3, 2026-09-15):
// @block compares the live cname against this with one strcmp per pad instead of
// reading the band's 32 gmem cells back every block (512 reads), and rewrites the band
// (VER bumped) only on a change. Written by the publisher alone; never a user string.
function get_idname_slot(idx) (
  idx==0?#idn0:idx==1?#idn1:idx==2?#idn2:idx==3?#idn3:
  idx==4?#idn4:idx==5?#idn5:idx==6?#idn6:idx==7?#idn7:
  idx==8?#idn8:idx==9?#idn9:idx==10?#idn10:idx==11?#idn11:
  idx==12?#idn12:idx==13?#idn13:idx==14?#idn14:#idn15;
);

// ─── The strings that travel with a swapped pad ──────────────────────────
// swap_pads (rk_drumkit_dsp) moves the numbers and the audio but no string, so
// EVERY swap site calls this one for the cname, name, path and the four layer
// paths: the inline swap below, the bridge-acked swap (_undo_pending == 5) and
// the header UNDO's swap-back (_udo_swap_req in Swing's @gfx). That last one
// had its own copy that left the layer paths out (2026-10-23, H15): after a
// swap and UNDO each layered pad kept the other's layer files, and the next
// reopen or kit save loaded the wrong samples. One copy now, so they cannot
// drift. All three callers run in @gfx (#_swap_nm is this thread's scratch).
// (swing_pad_swap_strings and swing_do_pad_swap live below swing_pad_fail_recompute, which the swap's bookkeeping
// calls -- EEL2 binds a call at definition time.)

// ─── Command-undo: per-pad name/path backup ──────────────────────────────
// The structural undo engine (rk_drumkit_dsp, imported EARLIER) can't call
// get_*_slot, so the visible name/path strings are backed up / restored HERE
// (in core, where those slot helpers exist) into the udo_s2_name char buffer:
//   [0..32] cname (gamelayer label)  [33..65] name  [66..337] path
//   [338 + li*272 .. +271] layer li path
// ⚠ 33, not 32, for each NAME: the editor's cap is PNE_MAX_LEN = 32 and a
//   32-char name needs a 33rd cell for its terminator. At 32 the last
//   character was dropped on every restore. Same fix in the preserve-live
//   shadow below -- the two are separate copies of one idea and the bug was
//   in both, so a fix to one is half a fix. (P3: LPATH strings were NOT backed
//   up before — a structural undo left stale layer paths behind, which then
//   re-serialized via the ser_ver>=11 block. The two forward swaps swapped
//   them; the header UNDO's swap-back did not until 2026-10-23, H15 -- every
//   swap site now goes through swing_pad_swap_strings, below swing_pad_fail_recompute.)
function undo_pad_names_save(pad) local(h, i, n, d, li) (
  h = get_cname_slot(pad); d = udo_s2_name;
  n = min(strlen(h), 32);  i = 0; loop(n, d[i] = str_getchar(h, i); i += 1;); d[n] = 0;
  h = get_name_slot(pad);  d = udo_s2_name + 33;
  n = min(strlen(h), 32);  i = 0; loop(n, d[i] = str_getchar(h, i); i += 1;); d[n] = 0;
  h = get_path_slot(pad);  d = udo_s2_name + 66;
  n = min(strlen(h), 271); i = 0; loop(n, d[i] = str_getchar(h, i); i += 1;); d[n] = 0;
  li = 0; loop(MAX_LAYERS,
    h = LPATH_STR_BASE + pad * MAX_LAYERS + li;
    d = udo_s2_name + 338 + li * 272;
    n = min(strlen(h), 271); i = 0; loop(n, d[i] = str_getchar(h, i); i += 1;); d[n] = 0;
    li += 1;
  );
);
function undo_pad_names_restore(pad) local(h, i, c, d, li) (
  h = get_cname_slot(pad); d = udo_s2_name;
  strcpy(h, ""); i = 0; c = d[0]; while(c != 0 && i < 32)  ( str_setchar(h, i, c); i += 1; c = d[i]; );
  h = get_name_slot(pad);  d = udo_s2_name + 33;
  strcpy(h, ""); i = 0; c = d[0]; while(c != 0 && i < 32)  ( str_setchar(h, i, c); i += 1; c = d[i]; );
  h = get_path_slot(pad);  d = udo_s2_name + 66;
  strcpy(h, ""); i = 0; c = d[0]; while(c != 0 && i < 271) ( str_setchar(h, i, c); i += 1; c = d[i]; );
  li = 0; loop(MAX_LAYERS,
    h = LPATH_STR_BASE + pad * MAX_LAYERS + li;
    d = udo_s2_name + 338 + li * 272;
    strcpy(h, ""); i = 0; c = d[0]; while(c != 0 && i < 271) ( str_setchar(h, i, c); i += 1; c = d[i]; );
    li += 1;
  );
);

// ── UI font scale ──────────────────────────────────────────────────────────
// A font size in DESIGN pixels, returned at the current surface scale.
// The geometry in this UI is proportional -- a pad cell is gfx_w/4, panels are
// fractions of gfx_w/gfx_h -- but the font sizes were literal pixels, so the
// bigger the surface got the SMALLER the text looked on it. _ui_sc (set at the
// top of @gfx) is how much bigger the surface is than the 780 the layout was
// drawn for; this turns a design size into a drawn one.
// 6 px floor: below that Arial stops being legible at any DPI, so a caller
// asking for something tiny gets tiny, not invisible.
function swing_fs(px) ( max(6, floor(px * _ui_sc + 0.5)); );

// A BOX size in design pixels, returned at the current surface scale.
// The companion to swing_fs, and the reason it exists: scaling only the type
// inside a box that keeps its pixel size makes things WORSE, not better --
// measured 2026-09-17 at _ui_sc 1.75, where the FX picker's grown title ran
// straight through its own tab row and the macro editor's CAPTURE label
// overflowed its button. Type and the box around it have to move together.
// No floor is needed: _ui_sc is itself max(1.0, ...), so a scaled box can
// never come back smaller than the design size it was tuned at.
function swing_px(px) ( floor(px * _ui_sc + 0.5); );

// ── The gain controls' travel (2026-10-29, the owner: "it can only do plus 6 on the mixer, just like the pad mixer ...
// can we increase those values?"): every fader and knob that sets a pad's, a layer's or the synth's gain runs in
// POSITION 0..1 and maps it here -- the faders gain = 4 p^3: 0 = silence, 0.5 = -6 dB, GAIN_UNITY_P (0.63) = 0 dB, 1 =
// +12 dB (it was 2 p^3: +6 at the top, unity at 0.79); the knobs their own taper below (unity at 12 o'clock, as when
// they ran 0..2 linear). The gains themselves
// are stored as before (1.0 = unity), so a saved kit or project keeps its levels; only where they sit on the travel
// moves. The kit loaders' clamps follow (0..4: rk_swing_ui_state_p2, Swing_Kit_Bridge).
GAIN_TOP = 4.0;
GAIN_UNITY_P = 0.6299605249;   // (1 / GAIN_TOP) ^ (1/3)
function swing_gain_p2g(p) ( GAIN_TOP * p * p * p );
function swing_gain_g2p(g) ( (max(0, g) / GAIN_TOP) ^ 0.3333333333 );
// The KNOBS' own taper (the same day, the owner: "bring the pad volume knobs back to 12 o'clock tho they look funny"):
// gain = 4 p^2 -- unity at 12 o'clock (KGAIN_UNITY_P 0.5), +12 dB at the top, -6 dB at 0.35. The faders keep the cube
// above (unity at ~63 %, as REAPER's own). The pad tiles' VOL, the LCD bar's GAIN, the editor's GAIN and VOL, the
// SYNTH page's LEVEL.
KGAIN_UNITY_P = 0.5;
function swing_kgain_p2g(p) ( GAIN_TOP * p * p );
function swing_kgain_g2p(g) ( sqrt(max(0, g) / GAIN_TOP) );

// The WEIGHT for text s drawn at fs px: bold, except text with a DIGIT under
// 10 px. Arial bold at 8-9 px closes 5 into 6 and 6, 9 into 8 (wiki 4.7), so a
// name the user or a kit supplies ("Kick 5") is set regular, while a name in
// letters keeps its bold. Numbers alone test fs at the call site instead.
// ⚠️ rk_thememenu_shim.jsfx-inc carries a copy for the faces that import the
// popup without this file -- change both.
function swing_txt_wt(fs, s) local(i, c, dig) (
  dig = 0;
  fs < 10 ? (
    i = 0;
    loop(strlen(s),
      c = str_getchar(s, i);
      (c >= '0' && c <= '9') ? ( dig = 1; );
      i += 1;
    );
  );
  dig ? 0 : 'b';
);

// ── Preserve-on-reload name shadow ─────────────────────────────────────────
// Same reason undo_pad_names_* live here rather than in the engine: only core
// can see get_*_slot. A preserve-live reload (project-open sidecar, or the
// undo/chunk audio repair) runs AFTER @serialize has restored the live state,
// and the kit import would otherwise write the KIT FILE's names over the ones
// the user typed -- so a pad you renamed, saved, and reopened through a repair
// path came back with the kit's name. Filed as "a known minor limitation";
// it is really project recall, which is a different thing.
// PATH is deliberately NOT shadowed here, unlike in the undo engine: on this
// route the audio is reloaded from the kit, so the path must come from the kit
// with it. Names are the user's; the path belongs to the audio.
// Pad Banks (step 3c): a preserve reload is one pass per bank, so the names snapshot covers the
// sixteen slots of the pass's bank (base = kit_load_bank * NUM_PADS); sv_pad_names is NUM_SLOTS wide.
function swing_preserve_names_save(base) local(p, h, i, n, d) (
  p = base; loop(NUM_PADS,   // this bank (step 3c)
    h = get_cname_slot(p); d = sv_pad_names + p * 66;
    n = min(strlen(h), 32); i = 0; loop(n, d[i] = str_getchar(h, i); i += 1;); d[n] = 0;
    h = get_name_slot(p);  d = sv_pad_names + p * 66 + 33;
    n = min(strlen(h), 32); i = 0; loop(n, d[i] = str_getchar(h, i); i += 1;); d[n] = 0;
    p += 1;
  );
);
function swing_preserve_names_restore(base) local(p, h, i, c, d) (
  p = base; loop(NUM_PADS,   // this bank (step 3c)
    h = get_cname_slot(p); d = sv_pad_names + p * 66;
    strcpy(h, ""); i = 0; c = d[0]; while(c != 0 && i < 32) ( str_setchar(h, i, c); i += 1; c = d[i]; );
    h = get_name_slot(p);  d = sv_pad_names + p * 66 + 33;
    strcpy(h, ""); i = 0; c = d[0]; while(c != 0 && i < 32) ( str_setchar(h, i, c); i += 1; c = d[i]; );
    p += 1;
  );
);

// Core wrapper for a per-pad structural op: record the audio+metadata backup
// (engine) AND, when this is the outermost op (depth just went to 1), back up
// this pad's names too. Call this instead of udo_struct_begin_pad from core.
function undo_begin_pad(pad) (
  udo_struct_begin_pad(pad);
  (_udo_cap_depth == 1 && udo_s2_type == 1 && !_srz_udo_hold) ? undo_pad_names_save(pad);   // no capture in a read (udo_struct_begin_pad)
);

// (Kit-level undo needs no name backup here: it reloads the temp .swing the
// bridge dumped before the op, which carries names/paths/audio itself.)

// ─── Slot wipe (Pad Banks step 3b, 2026-09-23) ─────────────────────────
// Empty a slot the way a reload of an older project does (@serialize, ser_ver 76): the regions freed,
// the lengths and layer count zeroed, the four strings emptied, the SYN slot off. The other parameters
// stay -- an empty pad is unplayable (pad_is_playable) and every load path runs clear_pad first. No undo,
// no dirty mark: the callers (the @serialize read, the import's bank wipe) hold their own bracket.
function swing_slot_wipe(ap) local(_li) (
  swing_pad_free_all(ap);
  s_len[ap] = 0; p_layer_cnt[ap] = 0; ps_enable[ap] = 0; s_dirty[ap] = 1;
  strcpy(get_name_slot(ap), ""); strcpy(get_path_slot(ap), ""); strcpy(get_cname_slot(ap), "");
  _li = 0; loop(MAX_LAYERS,
    l_len[ap * MAX_LAYERS + _li] = 0;
    strcpy(LPATH_STR_BASE + ap * MAX_LAYERS + _li, "");
    _li += 1;
  );
);

// ─── Multi-instance browser routing ─────────────────────────────────────
// Returns 1 when this JSFX instance is the one the browser is currently
// bound to (or no browser is active). Use as a guard before:
//   - processing CMD 63/64 sample loads from the browser
//   - writing browser-sync gmem fields (window size, kit name, etc.)
//   - consuming GS_PAD_SELECT_REQ
// Without this, a second Swing instance would respond to the first
// instance's browser commands and overwrite shared gmem state.
//
// Browser publishes the active instance ID into KIT_GMEM_INSTANCE on
// session start, on instance picker selection, and clears it on close.
// 0 means "no instance picked" — no JSFX acts (see below).
function _is_browser_target() (
  // Strict: only true when the user has explicitly picked this instance.
  // The earlier permissive form (also true on INSTANCE==0) caused every
  // Swing in the project to race-write the same gmem slots, which made
  // the browser pad grid + names flicker / blank out unpredictably.
  // Now: no pick = no writes. The browser auto-picks the first alive
  // instance on open, so single-instance workflows still "just work".
  gmem[KIT_GMEM_INSTANCE] == instance_id;
);

// ⭐ The kit-transfer bands (META, KIT_GMEM_PADNAMES, KIT_GMEM_AUDIOLEN) are ONE
// set of cells for every Swing in the process. While another instance holds
// KIT_GMEM_LOCK -- a save staging its kit for the bridge to read, a load staging
// one for it to adopt -- nobody else may write them. The browser-target mirrors
// (and the every-block AUDIOLEN / hue publishes) used to keep going, so saving
// Swing A while Swing B was the browser target read B's pad names out of the band
// A had just staged: 16 of 16 pads (EON_Probe_SaveBleed_probe, 2026-09-13). The
// holder itself is unaffected; its own latches (kit_busy, export/import state)
// govern it. A consumer that misses a publish for the length of a save or load
// gets it on the next block after LOCK clears.
function swing_shared_bands_free() (
  gmem[KIT_GMEM_LOCK] == 0 || gmem[KIT_GMEM_LOCK] == instance_id;
);

// The save / rename producers' bus test (bridge level 323, 2026-10-27, RR-1): CMD 0 AND no save in flight. Between
// two bank dumps a Swing older than 3.0.20 leaves the bus at CMD 0 (a 3.0.20 one keeps the 93 there), and a save or
// kit rename posted into that gap was overwritten by the saver's next CMD 1 -- or, if the bridge took it first, its
// prompt's park was. A 323 bridge names the saver in GS_KIT_SAVE_OWNER for the whole save and frees it when a save
// stops moving; below that level the test is CMD 0 alone, as before. Here, not in rk_swing_ui_state: the LCD's
// kit-name click (rk_swing_lcd) is imported before it.
function swing_save_bus_free() (
  gmem[KIT_GMEM_CMD] == 0 && (gmem[GS_BRIDGE_LEVEL] < BRIDGE_LEVEL_SAVE_TXN || gmem[GS_KIT_SAVE_OWNER] == 0);
);

// This Swing's kit name into the bus's NAME cells (KIT_GMEM_NAMELEN + KIT_GMEM_NAME, 32 chars, zero tail), as the
// payload of a CMD 12 or a rename's CMD 10 (RR-1, 2026-10-27). The bridge's SAVE (do_save_in_place) and its name form
// read those cells as "the kit on screen", but they hold the LAST kit operation's name from ANY Swing (a load's, a
// save's dump) and nothing after a REAPER restart: with two Swings, SAVE could write or offer the other one's name.
// Written in the same evaluation as the command (payload first), so no other writer comes between.
function swing_kitname_publish() local(_kn_l, _kn_i) (
  _kn_l = min(strlen(#kit_name), 32);
  gmem[KIT_GMEM_NAMELEN] = _kn_l;
  _kn_i = 0; loop(32, gmem[KIT_GMEM_NAME + _kn_i] = _kn_i < _kn_l ? str_getchar(#kit_name, _kn_i) : 0; _kn_i += 1; );
);
// The kit-name click is a RENAME (the owner, 2026-10-27: SAVE shows the current kit, SAVE AS "My Kit"): from bridge
// level 323 it hands the bridge its name and raises GS_KIT_SAVE_PREFILL before its CMD 10, and the name form starts
// at the current name; every Save As route leaves the cell 0. Below 323 nothing is written (an older bridge never
// reads or clears the cell, so a 1 left there would prefill the next Save As of a newer one).
function swing_rename_prefill() (
  gmem[GS_BRIDGE_LEVEL] >= BRIDGE_LEVEL_SAVE_TXN ? ( swing_kitname_publish(); gmem[GS_KIT_SAVE_PREFILL] = 1; );
);

// ─── Kit-import format detection ─────────────────────────────────────────
// Returns 1 if the path ends in .sfz (case-insensitive) — the only kit
// format Swing imports. Hands the file off to the Lua bridge's import
// pipeline (parse_sfz in Swing_Browser.lua).
function _is_kit_import_ext(p) local(_pl, _i, _ch) (
  _pl = strlen(p);
  _pl < 4 ? 0 : (
    strcpy(#_kie_tmp, p);
    _i = 0; loop(_pl,
      _ch = str_getchar(#_kie_tmp, _i);
      _ch >= 65 && _ch <= 90 ? str_setchar(#_kie_tmp, _i, _ch + 32);
      _i += 1;
    );
    match("*.sfz", #_kie_tmp);
  );
);

// Hand a kit-import file path to the Lua bridge by writing it to the
// shared GS_BROWSER_PATH region (same protocol the browser uses for sample
// loads, just JSFX→bridge instead of bridge→JSFX). Bridge picks up CMD 18,
// stores the path in ExtState, and opens the browser which runs import_start.
// Caller must check bridge alive + CMD idle before calling.
function _send_kit_import_to_bridge(p) local(_pl, _ci) (
  _pl = strlen(p);
  _pl > 0 && _pl < GS_BROWSER_PATH_MAX ? (
    _ci = 0; loop(_pl,
      gmem[GS_BROWSER_PATH + _ci] = str_getchar(p, _ci);
      _ci += 1;
    );
    gmem[GS_BROWSER_PATH_LEN] = _pl;
    gmem[KIT_GMEM_CMD] = 18;
  );
);

// ─── Auto-name pad from filename keywords (Sitala-style) ─────────────────
// Is this filename one the project's own SAMPLE STORE wrote? The store
// extracts a pad's audio next to the project as pad<NN>_lay<N>.wav (and
// pad<NN>_g<N>_<base>.wav for bakes) — positional storage names, never
// anything a user would want on a pad. Matches the shape only: "pad", digits,
// "_", then 'l' or 'g'. A kit loaded INTO bank B..D is stored with its bank
// first, b<N>_pad<NN>_lay<N>.wav (the bridge's eon_stage_kit_store_paths, Pad
// Banks step 3b); until 2026-10-15 that prefix failed the match, so reopening a
// saved project renamed every bank B..D pad after its storage file ("Kick" ->
// "b1_pad00_lay0"; EON_Probe_NameReopen, red on the tree before this).
function eon_name_is_store_file(_s)
local(_c, _o)
(
  // "b" + one digit + "_" first: a bank pass's file (1..3 today; any digit taken)
  _o = str_getchar(_s, 0) == 98 && (_c = str_getchar(_s, 1)) >= 49 && _c <= 57 &&
       str_getchar(_s, 2) == 95 ? 3 : 0;
  // EXACTLY two digits, which is what %02d writes -- one digit would also match
  // a user's "pad1_left.wav" and quietly stop naming that pad.
  str_getchar(_s, _o) == 112 && str_getchar(_s, _o + 1) == 97 &&
  str_getchar(_s, _o + 2) == 100 &&                              // p a d
  (_c = str_getchar(_s, _o + 3)) >= 48 && _c <= 57 &&
  (_c = str_getchar(_s, _o + 4)) >= 48 && _c <= 57 &&
  str_getchar(_s, _o + 5) == 95 ? (                              // NN then '_'
    // "lay" (a stored layer) or "g" (a bake generation)
    (str_getchar(_s, _o + 6) == 108 && str_getchar(_s, _o + 7) == 97 &&
     str_getchar(_s, _o + 8) == 121) || str_getchar(_s, _o + 6) == 103 ? 1 : 0;
  ) : 0;
);

function auto_name_from_file(pad_idx)
local(_fn, _cn, _i, _ch, _len, _last_dot)
(
  // Use the actual filename (sans extension) as the pad name. The previous
  // keyword-matching approach (kick.wav → "Kick") collapsed distinct samples
  // into the same generic label — for media-explorer drag-drop and arbitrary
  // sample names, the filename is the identifying signal the user wants in
  // the top-right corner.
  _fn = get_name_slot(pad_idx);
  _cn = get_cname_slot(pad_idx);
  // ⭐⭐ ...unless the file is one of OURS. A project that saves a marker instead
  // of embedded audio keeps each pad as <proj>/Swing/samples/kits/<kit>/padNN_
  // layN.wav, and reopening it reloads the pad FROM that file — so this
  // function renamed all sixteen pads to "pad00_lay0", "pad01_lay0" ... over
  // the good names @serialize had just restored. Reported live 2026-09-09 on a
  // saved project: right audio, wrong names, and no way back because the next
  // save then persisted the storage names as the real ones.
  // The staged-name path (GS_BROWSE_NAME_ADOPT, rk_swing_browser_load ④) fixes
  // this for FILL, which knows the kit's names; a marker reopen has no such
  // requester, so the guard belongs HERE, where every loader lands.
  // Only when the pad already HAS a name: an unnamed pad restoring from the
  // store still gets the filename, which is worth more than a blank tile.
  eon_name_is_store_file(_fn) && strlen(_cn) > 0 ? 0 : (
  _len = strlen(_fn);
  _len > 0 ? (
    strcpy(_cn, _fn);
    // Strip extension (last '.' onward) — walk backward, scope to the last
    // segment so a path like "808 v1.5/kick.wav" only loses ".wav".
    _last_dot = -1;
    _i = 0; loop(_len,
      _ch = str_getchar(_cn, _i);
      _ch == 46 ? _last_dot = _i;  // '.' = 46
      _i += 1;
    );
    _last_dot > 0 ? str_setlen(_cn, _last_dot);
  );
  );
);

// ─── Sync pad names + notes to MIDI editor via Lua bridge (CMD 52) ───────
function sync_note_names()
local(_ki, _cn, _cnl, _cj)
(
  gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 && gmem[KIT_GMEM_CMD] == 0 &&
  (gmem[KIT_GMEM_LOCK] == 0 || gmem[KIT_GMEM_LOCK] == instance_id) ? (
    gmem[KIT_GMEM_LOCK] = instance_id;  // acquire instance lock
    // Write all pad names to gmem PADNAME area
    _ki = 0; loop(NUM_PADS,
      _cn = get_cname_slot(_ki);
      _cnl = strlen(_cn);
      _cj = 0; loop(KIT_GMEM_PADNAME_LEN,
        gmem[KIT_GMEM_PADNAMES + _ki * KIT_GMEM_PADNAME_LEN + _cj] =
          _cj < _cnl ? str_getchar(_cn, _cj) : 0;
        _cj += 1;
      );
      // Write note number to metadata area (already mapped)
      gmem[KIT_GMEM_META + _ki * KIT_GMEM_META_PP + 10] = p_note[_ki];
      // Write actual audio length (non-layered) or sentinel 1 (layered).
      // Browser still detects "has audio" via non-zero check; bridge gets
      // the real length it needs for gmem-fallback streaming.
      gmem[KIT_GMEM_AUDIOLEN + _ki] =
        s_len[_ki] > 0 ? s_len[_ki] :
        (pad_has_audio(_ki) ? 1 : 0);
      _ki += 1;
    );
    gmem[KIT_GMEM_CMD] = 52;
  );
);


// ─── Per-pad disk-source fail bitmap (P4 step 3) ─────────────────────────
// pad_fail_bits bit N = pad N records a disk source that did NOT load —
// the previously-invisible marker-reload failure (loaders reset s_len/l_len
// to 0 BEFORE file_open and had no else branch, so a missing file left a
// silent blank the truncation detector could never see). Recomputed
// declaratively after every loader/clear so a successful reload self-heals
// the bit (retires the relink banner). paths_gen counts every path-affecting
// mutation; the bridge uses it to invalidate its cached CMD-87 publish.
// RUNTIME-ONLY state: never serialized, and deliberately NOT initialized in
// @init — @init can run AFTER @serialize (EEL zero-init covers first run).
// Rules mirror the @serialize marker-reload + recoverability logic:
//   layered pad    → any layer with a non-empty LPATH but no audio = fail
//   promoted-single (p_layer_cnt>0, all LPATHs empty) → no layer audio at
//                    all while the pad-main path is set = fail
//   legacy pad     → pad-main path set but s_len==0 = fail
// Pad Banks step 3b (2026-09-23): one sixteen-bit mask PER BANK. Bank A's is pad_fail_bits itself (every
// consumer -- the relink banner, GS_REB_FAIL_BITS, the ack -- is sixteen wide and reads bank A; step 4/5
// make it the visible bank's); banks 1..3 keep their own scalar. One 64-bit mask would have put a slot
// >= 53 past a double's integers and a bank-3 pad's bit into the ack as 2^63 (the first BanksKit run).
function swing_fail_mask(b) ( b == 1 ? pad_fail_bank1 : b == 2 ? pad_fail_bank2 : b == 3 ? pad_fail_bank3 : pad_fail_bits; );
function swing_fail_mask_set(b, v) (
  b == 1 ? ( pad_fail_bank1 = v; ) : ( b == 2 ? ( pad_fail_bank2 = v; ) : ( b == 3 ? ( pad_fail_bank3 = v; ) : ( pad_fail_bits = v; ); ); );
);
function swing_pad_fail_recompute(pad) local(_m, _bad, _anylp, _anyl, _li, _lx, _b, _cur) (
  _bad = 0; _anylp = 0; _anyl = 0;
  _li = 0; loop(MAX_LAYERS,
    _lx = pad * MAX_LAYERS + _li;
    strlen(LPATH_STR_BASE + _lx) > 0 ? (
      _anylp = 1;
      l_len[_lx] <= 0 ? _bad = 1;
    );
    l_len[_lx] > 0 ? _anyl = 1;
    _li += 1;
  );
  p_layer_cnt[pad] > 0 ? (
    !_anylp && !_anyl && strlen(get_path_slot(pad)) > 0 ? _bad = 1;
  ) : (
    strlen(get_path_slot(pad)) > 0 && s_len[pad] <= 0 ? _bad = 1;
  );
  _b = (pad / NUM_PADS) | 0; _m = 2 ^ (pad - _b * NUM_PADS);   // the bank's own mask, bank-relative bit (step 3b)
  _cur = swing_fail_mask(_b);
  swing_fail_mask_set(_b, _bad ? (_cur | _m) : ((_cur | _m) - _m));
  paths_gen += 1;
);

// The string half of a pad swap: cname, name, path and the layer paths. Every swap site runs swap_pads (the audio
// and the tables, rk_drumkit_dsp) and then this, so the fail bits and paths_gen are recomputed HERE for both pads:
// until 2026-10-26 no swap site did, the "samples missing" bit stayed on the old slot after the audio and the
// paths had moved, and the bridge's per-slot path cache stayed keyed to the old generation (LIB329).
function swing_pad_swap_strings(a, b) local(li, sa, sb) (
  strcpy(#_swap_nm, get_cname_slot(a)); strcpy(get_cname_slot(a), get_cname_slot(b)); strcpy(get_cname_slot(b), #_swap_nm);
  strcpy(#_swap_nm, get_name_slot(a));  strcpy(get_name_slot(a),  get_name_slot(b));  strcpy(get_name_slot(b),  #_swap_nm);
  strcpy(#_swap_nm, get_path_slot(a));  strcpy(get_path_slot(a),  get_path_slot(b));  strcpy(get_path_slot(b),  #_swap_nm);
  li = 0; loop(MAX_LAYERS,
    sa = LPATH_STR_BASE + a * MAX_LAYERS + li;
    sb = LPATH_STR_BASE + b * MAX_LAYERS + li;
    strcpy(#_swap_nm, sa); strcpy(sa, sb); strcpy(sb, #_swap_nm);
    li += 1;
  );
  swing_pad_fail_recompute(a);
  swing_pad_fail_recompute(b);
);

// ─── Shared pad swap (audio + metadata + name/path + layer paths) ─────────
// Bridge-aware: when the bridge is idle, posts the structural-op handshake
// (CMD 46, UNDO_DESC 5; the swap then runs in swing_ui_process_undo when the
// bridge acks, _undo_pending == 5); otherwise swaps inline. Either way the
// undo is Swing's own structural swap entry (udo_struct_begin_swap) -- since
// Phase 1B no REAPER undo point is made.
// Shared by the pad grid drag-swap and the Mapping view's opt-in swap.
function swing_do_pad_swap(a, b) (
  a >= 0 && b >= 0 && a != b ? (
    gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 && gmem[KIT_GMEM_CMD] == 0 ? (
      gmem[KIT_GMEM_UNDO_DESC] = 5; gmem[KIT_GMEM_CMD] = 46;
      _undo_pending = 5; _undo_pad = a; _undo_pad2 = b;
    ) : (
      swap_pads(a, b);
      swing_pad_swap_strings(a, b);
      _kd_site = 3; mark_dirty_kit();
    );
  );
);

// ─── Clear a single layer slot ──────────────────────────────────────────
function clear_layer(pad_idx, layer_idx) local(_lidx, li) (
  undo_begin_pad(pad_idx);  // Phase 2: back up this pad (audio+meta+names) for scoped structural undo
  _lidx = pad_idx * MAX_LAYERS + layer_idx;
  // A cleared layer is unbaked + its overlay waveform must re-capture on reload.
  sp_baked_tune[_lidx] = 0;
  ov_cap[_lidx] = 0;
  // Pad audio changed → bump the source generation so the Kit Bridge re-captures
  // this pad's bake/preload source for the Extension (stale-source guard).
  sp_src_gen[pad_idx] += 1;
  l_len[_lidx] = 0;
  l_start[_lidx] = 0;
  l_end[_lidx] = 1.0;
  l_sr[_lidx] = 0;
  l_norm[_lidx] = 0;
  l_norm_gain[_lidx] = 1.0;
  l_vel_lo[_lidx] = layer_idx / MAX_LAYERS;
  l_vel_hi[_lidx] = (layer_idx + 1) / MAX_LAYERS;
  l_rr_order[_lidx] = layer_idx;
  l_gain[_lidx] = 1.0;
  l_pan[_lidx] = 0; l_mute[_lidx] = 0; l_solo[_lidx] = 0;   // the layer mixer: an emptied layer starts centred, sounding
  strcpy(LPATH_STR_BASE + _lidx, "");
  // Step 2a: a cleared layer FREES its region (rk_swing_alloc) instead of zeroing it -- the
  // next load into that memory writes what it holds and zero-tails the rest of ITS region.
  // A load in flight (_clr_skip_audio: the stream drop, the kit-empty zero job) keeps the
  // regions: they are its target, or the undo capture's source until its finish frees them.
  // (Until 2026-09-23 this was a memset of what the layer held: 8 MB per layer at worst, on
  // the audio thread; measured 2026-09-08 as most of a drop's first-block stall.)
  !_clr_skip_audio ? swing_region_free(pad_idx, layer_idx + 1);
  // Recalculate layer count (find highest non-empty layer)
  p_layer_cnt[pad_idx] = 0;
  li = 0; loop(MAX_LAYERS,
    l_len[pad_idx * MAX_LAYERS + li] > 0 ? p_layer_cnt[pad_idx] = li + 1;
    li += 1;
  );
  swing_pad_fail_recompute(pad_idx);  // P4 step 3: layer removed → refresh fail bit + paths_gen
  undo_cap_end();
);

