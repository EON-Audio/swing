// rk_swing_core.jsfx-inc
// Swing core utility functions: name/path slots, sample loading, voice launch
// (c) EON Studios — All Rights Reserved

@init

// ─── Undo dirty markers ──────────────────────────────────────────────────
// REAPER captures the FX chunk for undo only when a slider VALUE actually
// changes, and coalesces rapid changes to the SAME slider into one undo
// entry. Tukan/Saike give every parameter its own slider so cross-action
// changes never coalesce.
//
// Swing keeps per-pad state in freemem arrays (not sliders), so we use
// counter sliders as proxies:
//   slider3        → global / master changes (mark_dirty())
//   slider6..21    → per-pad changes (mark_dirty_pad(idx))
//
// "Mute pad 1, solo pad 3, raise pad 12 vol" → slider6, slider8, slider17
// → 3 separate undo entries even when fast (different sliders never
// coalesce). Within a single pad, fast changes still coalesce (a knob
// drag = 1 entry, not 60), which is the desired DAW UX.
//
// Defined at the top of rk_swing_core.jsfx-inc so it's available to all
// libs imported after this one (which is everything else under libs/).
function mark_dirty() (
  // Phase 1B: signal project-dirty to the bridge instead of slider_automate,
  // so Swing changes no longer mint REAPER global-undo points (global Ctrl+Z
  // can't restore a stale Swing chunk). Save still works via @serialize. The
  // hidden counter sliders are left untouched (no @slider logic depends on
  // them — recalc is done by the per-pad callers directly).
  gmem[GS_PROJ_DIRTY] = 1;
);

// Pad Banks step 4a.1 (user, 2026-09-23): Tuned and Stretch are bank A's for now. The EON Extension's per-instance
// tables are sixteen pads wide (STRETCH_CONTROL_INSTANCE_STRIDE 80, STRETCH_INST_AUDIO_STRIDE 16 x 32768): a slot
// past 15 indexes past this instance's row -- control cell 19 is bank A pad 3's pitch semitones, and pad 19's audio
// block is the NEXT instance's. So every consumer reads the EFFECTIVE mode through here: a pad outside bank A is
// Repitch whatever its stored mode says (the stored value is kept and comes back if the pad is swapped into A).
// The shared slot pool -- any sixteen pads across the banks -- is its own step.
// A pad tunes or stretches only while it holds a SPOT (sp_row, the spot map of rk_swing_block_pitch: step 3 =
// identity, bank A pad s on spot s, so a B..D pad has none and plays Repitch -- 4a.1 as before); a stored mode
// without a spot is kept and plays Repitch (§5.6).
function swing_pitch_eff(ap) ( sp_row[ap] >= 0 ? sp_pitch_mode[ap] : SP_PITCH_MODE_REPITCH; );

// The pad's source generation as the spot map publishes it: the @init epoch (sp_epoch: never 0, a multiple of
// SP_EPOCH_UNIT, below 2^30) plus sp_src_gen. A reopened or duplicated instance therefore never repeats a
// previous instance's values on the same slot (the Extension compares the SRCGEN band with !=).
function swing_spot_gen(_ssg_pad) ( sp_epoch + sp_src_gen[_ssg_pad]; );

// Is this pad's Stretch output held to the plain way right now (Plan_Swing_Pad_Banks_Tuned §5A.3's hold)?
// sp_hold is set by swing_spot_tick (rk_swing_block_pitch) when it sees a source change and cleared SP_HOLD_TICKS
// Extension heartbeats after the bridge's answer; the second term covers a change the tick has not seen yet (a
// load in THIS block, before the next tick), so even the first hit after the change cannot reach the old sound.
function swing_pitch_held(_sph_pad)
local(_sph_r)
(
  _sph_r = sp_row[_sph_pad];
  sp_hold[_sph_pad] || (_sph_r >= 0 && sp_map_gen[_sph_r] != swing_spot_gen(_sph_pad));
);

// Pad Banks step 4 (2026-10-09): which pads need a spot, which spots may be lent, and the mode stepper's refusal.
// Here, beside swing_pitch_eff, because the LCD compiles before rk_swing_block_pitch (whose swing_spot_assign
// does the lending; the long comment there says how).
function swing_spot_wants(_sw_p)
(
  (sp_pitch_mode[_sw_p] == SP_PITCH_MODE_TUNED || sp_pitch_mode[_sw_p] == SP_PITCH_MODE_STRETCH) && pad_has_audio(_sw_p);
);

// A spot that may be lent now: not draining, and its owner (if any) does not need it.
function swing_spot_idle(_si_r)
local(_si_p)
(
  _si_p = pr_pad[_si_r];
  pr_state[_si_r] != SPOT_STATE_DRAINING && (_si_p < 0 || !swing_spot_wants(_si_p));
);

// Would the mode stepper's change of _sr_p into _sr_m be refused (§5.6)? Leaving Tuned / Stretch, a pad that holds a
// spot, or one with no audio yet (it asks when audio arrives) never is. Otherwise a spot must be idle or free for it
// beyond the pads already waiting, and away from its own spot only with a bridge that answers.
function swing_spot_refuse(_sr_p, _sr_m)
local(_sr_r _sr_n _sr_w)
(
  (_sr_m != SP_PITCH_MODE_TUNED && _sr_m != SP_PITCH_MODE_STRETCH) || sp_row[_sr_p] >= 0 || !pad_has_audio(_sr_p) ? 0 : (
    !sp_br_lends ? 1 : (
      _sr_n = 0; _sr_r = 0;
      loop(NUM_PADS, (swing_spot_idle(_sr_r) || pr_state[_sr_r] == SPOT_STATE_DRAINING) ? _sr_n += 1; _sr_r += 1; );
      _sr_w = 0; _sr_r = 0;
      loop(NUM_SLOTS, _sr_r != _sr_p && sp_row[_sr_r] < 0 && swing_spot_wants(_sr_r) ? _sr_w += 1; _sr_r += 1; );
      _sr_n <= _sr_w;
    );
  );
);

// Is this pad waiting for a spot (needs one, holds none)? The LCD's line.
function swing_spot_waiting(_sw_p) ( sp_row[_sw_p] < 0 && swing_spot_wants(_sw_p); );

// Kit-scoped dirty: mark_dirty PLUS the unsaved-kit dot. For edits to state
// the KIT FILE persists that isn't pad-indexed — the 42 KIT_GLOBAL_KEYS
// (master EQ/delay/reverb/comp, repeat_div, vel_curve, note_map, multi_out,
// oneshot_global, sat_drv) and kit-content bulk ops (New Kit, reset colors,
// MIDI-learn, no-bridge swap). Before this, ONLY pad edits lit the dot —
// change the kit's whole feel and it stayed dark. ⛔Do NOT use for prefs the
// kit file does not save (midi_thru, tooltips, embed_mode, adsr_3node,
// pad_icon_mode, knob styles, map_override_locked, gfx_drv_mode): a display
// toggle showing "unsaved kit changes" teaches users to ignore the dot.
// Same !kit_busy guard as mark_dirty_pad — a kit import's edit storm is not
// a user modification.
// Step 4a (user decision 2026-09-23, "switch"): selecting a pad selects its bank too -- the grid always shows
// the pad the LCD edits. Every sel_pad assignment that comes from a note, a companion or a landed pad goes
// through here; a tile click already sits in bank_cur. A bank change is a view change: mark_dirty() so the
// project registers it (bank_cur is serialized), never an undo boundary (spec 12).
function swing_select_pad(ap) local(_b) (
  sel_pad = ap;
  _b = (ap / NUM_PADS) | 0;
  _b != bank_cur ? (
    bank_cur = _b; mark_dirty();
    _reg_my_slot >= 0 ? gmem[GS_INST_BANK_CUR + _reg_my_slot] = bank_cur;   // step 5a: at once (the @block publish heals)
  );
);
function mark_dirty_kit() (
  mark_dirty();
  // TEMP DIAGNOSTIC (project-open false dirty, 2026-08-05; site tags added
  // 2026-08-11): record the first setter. _kd_src 1+pad = pad-scoped (see
  // mark_dirty_pad); 1000 = kit-scoped from a GESTURE site; 1002..1009 =
  // kit-scoped from an AUTO-capable site (the caller stamps _kd_site just
  // before calling): 1002=clear_pad 1003=pad-swap 1004=new-kit/companion-4
  // 1005=companion-5 multi-out adopt (RETIRED 2026-08-11 — the adopt no
  // longer marks dirty at all; a 1005 sighting means a stale JSFX build)
  // 1006=multiout_prep 1007=syn-newkit 1008=comp-link adopt (bus Weld)
  // 1009=tone-link adopt (EON Tone).
  // ⚠ 1008/1009 cover BOTH halves of each link: the first-sight prime and a
  // later rack edit arriving over the row. Neither is a Swing gesture, and
  // until 2026-09-20 both stamped nothing and landed here as 1000 -- so the
  // one instrument built to find project-open false dirty was reporting the
  // likeliest cause of it as a user click. A 1008/1009 at project-open time
  // is legitimate but still worth a look: it means a rack was adopted.
  (!kit_busy && kit_dirty == 0) ? ( _kd_src = 1000 + _kd_site; _kd_t = time_precise(); );
  !kit_busy ? kit_dirty = 1;
  _kd_site = 0;   // tag is consume-once; untagged (gesture) sites read 0
);

// Returns 1 if MAP-preset application may write pad i's note, 0 if it must
// be skipped. Normally a manually-set (locked) pad is skipped; the
// map_override_locked option (slider23, MAP right-click menu) makes presets
// override locked pads too. Scope is MAP-apply ONLY — the lock still guards
// recalc_pad/root_note (rk_drumkit_dsp). map_override_locked persists in the
// FX chunk (no @serialize touch).
// A PRESET lock (p_note_lock 2, below) is not the user's: a map operation may replace it.
function swing_map_unlocked(i) (
  map_override_locked || p_note_lock[i] != 1;
);
// Step 4d (Pad Banks): a note-map preset writes ONE bank. The caller sets _mp_bank; the preset names its notes
// as bank A's layout (tile t -> note n) and they land in that bank's block, 16 notes up per bank. Clamped at
// 127; the user's locked pads keep their notes (unless the MAP override is on).
// Pad Banks audit S9 (user decision 2026-09-24): the note is PRESET-locked (p_note_lock 2). recalc_pad re-derives
// an unlocked pad as root + slot, and every pad edit, load and swap posts one -- so a preset's note in an UNLOCKED
// pad was lost to the first knob turn (GM's pad 2 fell back to chromatic, onto pad 3's note), and a preset in
// another bank that moved the shared root would have moved this one. A later preset replaces a preset lock.
function swing_map_set(t, n) local(ap) (
  ap = _mp_bank * NUM_PADS + t;
  swing_map_unlocked(ap) ? ( p_note[ap] = min(127, n + 16 * _mp_bank); p_note_lock[ap] = 2; );
);

// Per-pad dirty marker. pad_idx is 0-based; routes to slider(6 + pad_idx)
// — slider6 = pad 1, slider21 = pad 16. Out-of-range falls through to
// the global slider3 so accidental mis-callers don't crash.
function mark_dirty_pad(pad_idx)
local(_sn)
(
  pad_idx >= 0 && pad_idx < NUM_SLOTS ? (
    // Phase 1B: project-dirty signal, NOT slider_automate — no REAPER undo point.
    gmem[GS_PROJ_DIRTY] = 1;
    // Kit-level dirty (drives the SAVE button's unsaved-changes dot). Every
    // pad mutation funnels through here, so this is the one honest hook.
    // !kit_busy excludes the mark_dirty_pad storm a kit IMPORT produces —
    // a kit is not "modified" the instant it finishes loading. Cleared on
    // save completion (bridge CMD 99 reply) and at import state-4 completion.
    // Deliberately NOT initialised in @init: a sample-rate change re-runs
    // @init, and zeroing there would silently forget unsaved edits.
    (!kit_busy && kit_dirty == 0) ? ( _kd_src = 1 + pad_idx; _kd_t = time_precise(); _kd_n = 0; );
    !kit_busy ? ( kit_dirty = 1; _kd_n += 1; );
    // Internal PARAM undo: flag this pad as edited in the current gesture so
    // the mouse-UP commit pushes one undo entry for it. Suppressed while the
    // undo engine itself is restoring (_udo_applying) to avoid self-capture.
    // The `_udo_pend &&` guard skips any pre-@init-allocation call (base 0).
    // _udo_cap_depth==0 guard: don't let a STRUCTURAL op (clear/load/swap/kit)
    // also queue a param-undo entry — otherwise undo_do would do a param undo
    // (no audio) instead of the structural restore, and the pad wouldn't come back.
    _udo_pend && !_udo_applying && _udo_cap_depth == 0 ? ( _udo_pend[pad_idx] = 1; );
  ) : (
    mark_dirty();
  );
);

// ─── Name / path string arrays ───────────────────────────────────────────
// Step 3a (2026-09-23): NUMBERED string slots, one per absolute slot 0..NUM_SLOTS-1, at the bases the
// Constants block declares (PNAME_STR_BASE / PPATH_STR_BASE / CNAME_STR_BASE, Swing_ReaKit.jsfx). Until
// step 3a these were sixteen-way ternaries over the named strings #pn0..15 / #pp0..15 / #cn0..15 -- the
// last sixteen-wide state in the engine ("16 STRING SLOTS" in the step 2b handoff). An index past the
// last slot is clamped, never allowed to run into the next base (the old #pp15 clamp, kept).
function get_name_slot(idx)  ( PNAME_STR_BASE + max(0, min(NUM_SLOTS - 1, idx | 0)); );
function get_path_slot(idx)  ( PPATH_STR_BASE + max(0, min(NUM_SLOTS - 1, idx | 0)); );
function get_cname_slot(idx) ( CNAME_STR_BASE + max(0, min(NUM_SLOTS - 1, idx | 0)); );
// The name each of the SIXTY-FOUR pads last published into the all-bank name band (2026-10-22): the publish's own
// shadows, one strcmp per pad per block in place of 32 gmem reads. Written by that publisher alone; never a user string.
function get_id64name_slot(idx) ( ID64NAME_STR_BASE + max(0, min(NUM_SLOTS - 1, idx | 0)); );
// The name each pad LAST PUBLISHED into its IDENT band (Phase 4, A O-3, 2026-09-15):
// @block compares the live cname against this with one strcmp per pad instead of
// reading the band's 32 gmem cells back every block (512 reads), and rewrites the band
// (VER bumped) only on a change. Written by the publisher alone; never a user string.
function get_idname_slot(idx) (
  idx==0?#idn0:idx==1?#idn1:idx==2?#idn2:idx==3?#idn3:
  idx==4?#idn4:idx==5?#idn5:idx==6?#idn6:idx==7?#idn7:
  idx==8?#idn8:idx==9?#idn9:idx==10?#idn10:idx==11?#idn11:
  idx==12?#idn12:idx==13?#idn13:idx==14?#idn14:#idn15;
);

// ─── The strings that travel with a swapped pad ──────────────────────────
// swap_pads (rk_drumkit_dsp) moves the numbers and the audio but no string, so
// EVERY swap site calls this one for the cname, name, path and the four layer
// paths: the inline swap below, the bridge-acked swap (_undo_pending == 5) and
// the header UNDO's swap-back (_udo_swap_req in Swing's @gfx). That last one
// had its own copy that left the layer paths out (2026-10-23, H15): after a
// swap and UNDO each layered pad kept the other's layer files, and the next
// reopen or kit save loaded the wrong samples. One copy now, so they cannot
// drift. All three callers run in @gfx (#_swap_nm is this thread's scratch).
function swing_pad_swap_strings(a, b) local(li, sa, sb) (
  strcpy(#_swap_nm, get_cname_slot(a)); strcpy(get_cname_slot(a), get_cname_slot(b)); strcpy(get_cname_slot(b), #_swap_nm);
  strcpy(#_swap_nm, get_name_slot(a));  strcpy(get_name_slot(a),  get_name_slot(b));  strcpy(get_name_slot(b),  #_swap_nm);
  strcpy(#_swap_nm, get_path_slot(a));  strcpy(get_path_slot(a),  get_path_slot(b));  strcpy(get_path_slot(b),  #_swap_nm);
  li = 0; loop(MAX_LAYERS,
    sa = LPATH_STR_BASE + a * MAX_LAYERS + li;
    sb = LPATH_STR_BASE + b * MAX_LAYERS + li;
    strcpy(#_swap_nm, sa); strcpy(sa, sb); strcpy(sb, #_swap_nm);
    li += 1;
  );
);

// ─── Shared pad swap (audio + metadata + name/path + layer paths) ─────────
// Bridge-aware: when the bridge is idle, posts a named "Swap pads" undo (the
// swap then runs in swing_ui_process_undo when the bridge acks, _undo_pending
// == 5); otherwise swaps inline and relies on mark_dirty's chunk-diff undo.
// Shared by the pad grid drag-swap and the Mapping view's opt-in swap.
function swing_do_pad_swap(a, b) (
  a >= 0 && b >= 0 && a != b ? (
    gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 && gmem[KIT_GMEM_CMD] == 0 ? (
      gmem[KIT_GMEM_UNDO_DESC] = 5; gmem[KIT_GMEM_CMD] = 46;
      _undo_pending = 5; _undo_pad = a; _undo_pad2 = b;
    ) : (
      swap_pads(a, b);
      swing_pad_swap_strings(a, b);
      _kd_site = 3; mark_dirty_kit();
    );
  );
);

// ─── Command-undo: per-pad name/path backup ──────────────────────────────
// The structural undo engine (rk_drumkit_dsp, imported EARLIER) can't call
// get_*_slot, so the visible name/path strings are backed up / restored HERE
// (in core, where those slot helpers exist) into the udo_s2_name char buffer:
//   [0..32] cname (gamelayer label)  [33..65] name  [66..337] path
//   [338 + li*272 .. +271] layer li path
// ⚠ 33, not 32, for each NAME: the editor's cap is PNE_MAX_LEN = 32 and a
//   32-char name needs a 33rd cell for its terminator. At 32 the last
//   character was dropped on every restore. Same fix in the preserve-live
//   shadow below -- the two are separate copies of one idea and the bug was
//   in both, so a fix to one is half a fix. (P3: LPATH strings were NOT backed
//   up before — a structural undo left stale layer paths behind, which then
//   re-serialized via the ser_ver>=11 block. The two forward swaps swapped
//   them; the header UNDO's swap-back did not until 2026-10-23, H15 -- every
//   swap site now goes through swing_pad_swap_strings above.)
function undo_pad_names_save(pad) local(h, i, n, d, li) (
  h = get_cname_slot(pad); d = udo_s2_name;
  n = min(strlen(h), 32);  i = 0; loop(n, d[i] = str_getchar(h, i); i += 1;); d[n] = 0;
  h = get_name_slot(pad);  d = udo_s2_name + 33;
  n = min(strlen(h), 32);  i = 0; loop(n, d[i] = str_getchar(h, i); i += 1;); d[n] = 0;
  h = get_path_slot(pad);  d = udo_s2_name + 66;
  n = min(strlen(h), 271); i = 0; loop(n, d[i] = str_getchar(h, i); i += 1;); d[n] = 0;
  li = 0; loop(MAX_LAYERS,
    h = LPATH_STR_BASE + pad * MAX_LAYERS + li;
    d = udo_s2_name + 338 + li * 272;
    n = min(strlen(h), 271); i = 0; loop(n, d[i] = str_getchar(h, i); i += 1;); d[n] = 0;
    li += 1;
  );
);
function undo_pad_names_restore(pad) local(h, i, c, d, li) (
  h = get_cname_slot(pad); d = udo_s2_name;
  strcpy(h, ""); i = 0; c = d[0]; while(c != 0 && i < 32)  ( str_setchar(h, i, c); i += 1; c = d[i]; );
  h = get_name_slot(pad);  d = udo_s2_name + 33;
  strcpy(h, ""); i = 0; c = d[0]; while(c != 0 && i < 32)  ( str_setchar(h, i, c); i += 1; c = d[i]; );
  h = get_path_slot(pad);  d = udo_s2_name + 66;
  strcpy(h, ""); i = 0; c = d[0]; while(c != 0 && i < 271) ( str_setchar(h, i, c); i += 1; c = d[i]; );
  li = 0; loop(MAX_LAYERS,
    h = LPATH_STR_BASE + pad * MAX_LAYERS + li;
    d = udo_s2_name + 338 + li * 272;
    strcpy(h, ""); i = 0; c = d[0]; while(c != 0 && i < 271) ( str_setchar(h, i, c); i += 1; c = d[i]; );
    li += 1;
  );
);

// ── UI font scale ──────────────────────────────────────────────────────────
// A font size in DESIGN pixels, returned at the current surface scale.
// The geometry in this UI is proportional -- a pad cell is gfx_w/4, panels are
// fractions of gfx_w/gfx_h -- but the font sizes were literal pixels, so the
// bigger the surface got the SMALLER the text looked on it. _ui_sc (set at the
// top of @gfx) is how much bigger the surface is than the 780 the layout was
// drawn for; this turns a design size into a drawn one.
// 6 px floor: below that Arial stops being legible at any DPI, so a caller
// asking for something tiny gets tiny, not invisible.
function swing_fs(px) ( max(6, floor(px * _ui_sc + 0.5)); );

// A BOX size in design pixels, returned at the current surface scale.
// The companion to swing_fs, and the reason it exists: scaling only the type
// inside a box that keeps its pixel size makes things WORSE, not better --
// measured 2026-09-17 at _ui_sc 1.75, where the FX picker's grown title ran
// straight through its own tab row and the macro editor's CAPTURE label
// overflowed its button. Type and the box around it have to move together.
// No floor is needed: _ui_sc is itself max(1.0, ...), so a scaled box can
// never come back smaller than the design size it was tuned at.
function swing_px(px) ( floor(px * _ui_sc + 0.5); );

// The WEIGHT for text s drawn at fs px: bold, except text with a DIGIT under
// 10 px. Arial bold at 8-9 px closes 5 into 6 and 6, 9 into 8 (wiki 4.7), so a
// name the user or a kit supplies ("Kick 5") is set regular, while a name in
// letters keeps its bold. Numbers alone test fs at the call site instead.
// ⚠️ rk_thememenu_shim.jsfx-inc carries a copy for the faces that import the
// popup without this file -- change both.
function swing_txt_wt(fs, s) local(i, c, dig) (
  dig = 0;
  fs < 10 ? (
    i = 0;
    loop(strlen(s),
      c = str_getchar(s, i);
      (c >= '0' && c <= '9') ? ( dig = 1; );
      i += 1;
    );
  );
  dig ? 0 : 'b';
);

// ── Preserve-on-reload name shadow ─────────────────────────────────────────
// Same reason undo_pad_names_* live here rather than in the engine: only core
// can see get_*_slot. A preserve-live reload (project-open sidecar, or the
// undo/chunk audio repair) runs AFTER @serialize has restored the live state,
// and the kit import would otherwise write the KIT FILE's names over the ones
// the user typed -- so a pad you renamed, saved, and reopened through a repair
// path came back with the kit's name. Filed as "a known minor limitation";
// it is really project recall, which is a different thing.
// PATH is deliberately NOT shadowed here, unlike in the undo engine: on this
// route the audio is reloaded from the kit, so the path must come from the kit
// with it. Names are the user's; the path belongs to the audio.
// Pad Banks (step 3c): a preserve reload is one pass per bank, so the names snapshot covers the
// sixteen slots of the pass's bank (base = kit_load_bank * NUM_PADS); sv_pad_names is NUM_SLOTS wide.
function swing_preserve_names_save(base) local(p, h, i, n, d) (
  p = base; loop(NUM_PADS,   // this bank (step 3c)
    h = get_cname_slot(p); d = sv_pad_names + p * 66;
    n = min(strlen(h), 32); i = 0; loop(n, d[i] = str_getchar(h, i); i += 1;); d[n] = 0;
    h = get_name_slot(p);  d = sv_pad_names + p * 66 + 33;
    n = min(strlen(h), 32); i = 0; loop(n, d[i] = str_getchar(h, i); i += 1;); d[n] = 0;
    p += 1;
  );
);
function swing_preserve_names_restore(base) local(p, h, i, c, d) (
  p = base; loop(NUM_PADS,   // this bank (step 3c)
    h = get_cname_slot(p); d = sv_pad_names + p * 66;
    strcpy(h, ""); i = 0; c = d[0]; while(c != 0 && i < 32) ( str_setchar(h, i, c); i += 1; c = d[i]; );
    h = get_name_slot(p);  d = sv_pad_names + p * 66 + 33;
    strcpy(h, ""); i = 0; c = d[0]; while(c != 0 && i < 32) ( str_setchar(h, i, c); i += 1; c = d[i]; );
    p += 1;
  );
);

// Core wrapper for a per-pad structural op: record the audio+metadata backup
// (engine) AND, when this is the outermost op (depth just went to 1), back up
// this pad's names too. Call this instead of udo_struct_begin_pad from core.
function undo_begin_pad(pad) (
  udo_struct_begin_pad(pad);
  (_udo_cap_depth == 1 && udo_s2_type == 1) ? undo_pad_names_save(pad);
);

// (Kit-level undo needs no name backup here: it reloads the temp .swing the
// bridge dumped before the op, which carries names/paths/audio itself.)

// ─── Slot wipe (Pad Banks step 3b, 2026-09-23) ─────────────────────────
// Empty a slot the way a reload of an older project does (@serialize, ser_ver 76): the regions freed,
// the lengths and layer count zeroed, the four strings emptied, the SYN slot off. The other parameters
// stay -- an empty pad is unplayable (pad_is_playable) and every load path runs clear_pad first. No undo,
// no dirty mark: the callers (the @serialize read, the import's bank wipe) hold their own bracket.
function swing_slot_wipe(ap) local(_li) (
  swing_pad_free_all(ap);
  s_len[ap] = 0; p_layer_cnt[ap] = 0; ps_enable[ap] = 0; s_dirty[ap] = 1;
  strcpy(get_name_slot(ap), ""); strcpy(get_path_slot(ap), ""); strcpy(get_cname_slot(ap), "");
  _li = 0; loop(MAX_LAYERS,
    l_len[ap * MAX_LAYERS + _li] = 0;
    strcpy(LPATH_STR_BASE + ap * MAX_LAYERS + _li, "");
    _li += 1;
  );
);

// ─── Multi-instance browser routing ─────────────────────────────────────
// Returns 1 when this JSFX instance is the one the browser is currently
// bound to (or no browser is active). Use as a guard before:
//   - processing CMD 63/64 sample loads from the browser
//   - writing browser-sync gmem fields (window size, kit name, etc.)
//   - consuming GS_PAD_SELECT_REQ
// Without this, a second Swing instance would respond to the first
// instance's browser commands and overwrite shared gmem state.
//
// Browser publishes the active instance ID into KIT_GMEM_INSTANCE on
// session start, on instance picker selection, and clears it on close.
// 0 means "no specific instance / single-instance mode" — any JSFX may act.
function _is_browser_target() (
  // Strict: only true when the user has explicitly picked this instance.
  // The earlier permissive form (also true on INSTANCE==0) caused every
  // Swing in the project to race-write the same gmem slots, which made
  // the browser pad grid + names flicker / blank out unpredictably.
  // Now: no pick = no writes. The browser auto-picks the first alive
  // instance on open, so single-instance workflows still "just work".
  gmem[KIT_GMEM_INSTANCE] == instance_id;
);

// ⭐ The kit-transfer bands (META, KIT_GMEM_PADNAMES, KIT_GMEM_AUDIOLEN) are ONE
// set of cells for every Swing in the process. While another instance holds
// KIT_GMEM_LOCK -- a save staging its kit for the bridge to read, a load staging
// one for it to adopt -- nobody else may write them. The browser-target mirrors
// (and the every-block AUDIOLEN / hue publishes) used to keep going, so saving
// Swing A while Swing B was the browser target read B's pad names out of the band
// A had just staged: 16 of 16 pads (EON_Probe_SaveBleed_probe, 2026-09-13). The
// holder itself is unaffected; its own latches (kit_busy, export/import state)
// govern it. A consumer that misses a publish for the length of a save or load
// gets it on the next block after LOCK clears.
function swing_shared_bands_free() (
  gmem[KIT_GMEM_LOCK] == 0 || gmem[KIT_GMEM_LOCK] == instance_id;
);

// ─── Kit-import format detection ─────────────────────────────────────────
// Returns 1 if the path ends in .sfz (case-insensitive) — the only kit
// format Swing imports. Hands the file off to the Lua bridge's import
// pipeline (parse_sfz in Swing_Browser.lua).
function _is_kit_import_ext(p) local(_pl, _i, _ch) (
  _pl = strlen(p);
  _pl < 4 ? 0 : (
    strcpy(#_kie_tmp, p);
    _i = 0; loop(_pl,
      _ch = str_getchar(#_kie_tmp, _i);
      _ch >= 65 && _ch <= 90 ? str_setchar(#_kie_tmp, _i, _ch + 32);
      _i += 1;
    );
    match("*.sfz", #_kie_tmp);
  );
);

// Hand a kit-import file path to the Lua bridge by writing it to the
// shared GS_BROWSER_PATH region (same protocol the browser uses for sample
// loads, just JSFX→bridge instead of bridge→JSFX). Bridge picks up CMD 18,
// stores the path in ExtState, and opens the browser which runs import_start.
// Caller must check bridge alive + CMD idle before calling.
function _send_kit_import_to_bridge(p) local(_pl, _ci) (
  _pl = strlen(p);
  _pl > 0 && _pl < GS_BROWSER_PATH_MAX ? (
    _ci = 0; loop(_pl,
      gmem[GS_BROWSER_PATH + _ci] = str_getchar(p, _ci);
      _ci += 1;
    );
    gmem[GS_BROWSER_PATH_LEN] = _pl;
    gmem[KIT_GMEM_CMD] = 18;
  );
);

// ─── Auto-name pad from filename keywords (Sitala-style) ─────────────────
// Is this filename one the project's own SAMPLE STORE wrote? The store
// extracts a pad's audio next to the project as pad<NN>_lay<N>.wav (and
// pad<NN>_g<N>_<base>.wav for bakes) — positional storage names, never
// anything a user would want on a pad. Matches the shape only: "pad", digits,
// "_", then 'l' or 'g'. A kit loaded INTO bank B..D is stored with its bank
// first, b<N>_pad<NN>_lay<N>.wav (the bridge's eon_stage_kit_store_paths, Pad
// Banks step 3b); until 2026-10-15 that prefix failed the match, so reopening a
// saved project renamed every bank B..D pad after its storage file ("Kick" ->
// "b1_pad00_lay0"; EON_Probe_NameReopen, red on the tree before this).
function eon_name_is_store_file(_s)
local(_c, _o)
(
  // "b" + one digit + "_" first: a bank pass's file (1..3 today; any digit taken)
  _o = str_getchar(_s, 0) == 98 && (_c = str_getchar(_s, 1)) >= 49 && _c <= 57 &&
       str_getchar(_s, 2) == 95 ? 3 : 0;
  // EXACTLY two digits, which is what %02d writes -- one digit would also match
  // a user's "pad1_left.wav" and quietly stop naming that pad.
  str_getchar(_s, _o) == 112 && str_getchar(_s, _o + 1) == 97 &&
  str_getchar(_s, _o + 2) == 100 &&                              // p a d
  (_c = str_getchar(_s, _o + 3)) >= 48 && _c <= 57 &&
  (_c = str_getchar(_s, _o + 4)) >= 48 && _c <= 57 &&
  str_getchar(_s, _o + 5) == 95 ? (                              // NN then '_'
    // "lay" (a stored layer) or "g" (a bake generation)
    (str_getchar(_s, _o + 6) == 108 && str_getchar(_s, _o + 7) == 97 &&
     str_getchar(_s, _o + 8) == 121) || str_getchar(_s, _o + 6) == 103 ? 1 : 0;
  ) : 0;
);

function auto_name_from_file(pad_idx)
local(_fn, _cn, _i, _ch, _len, _last_dot)
(
  // Use the actual filename (sans extension) as the pad name. The previous
  // keyword-matching approach (kick.wav → "Kick") collapsed distinct samples
  // into the same generic label — for media-explorer drag-drop and arbitrary
  // sample names, the filename is the identifying signal the user wants in
  // the top-right corner.
  _fn = get_name_slot(pad_idx);
  _cn = get_cname_slot(pad_idx);
  // ⭐⭐ ...unless the file is one of OURS. A project that saves a marker instead
  // of embedded audio keeps each pad as <proj>/Swing/samples/kits/<kit>/padNN_
  // layN.wav, and reopening it reloads the pad FROM that file — so this
  // function renamed all sixteen pads to "pad00_lay0", "pad01_lay0" ... over
  // the good names @serialize had just restored. Reported live 2026-09-09 on a
  // saved project: right audio, wrong names, and no way back because the next
  // save then persisted the storage names as the real ones.
  // The staged-name path (GS_BROWSE_NAME_ADOPT, rk_swing_browser_load ④) fixes
  // this for FILL, which knows the kit's names; a marker reopen has no such
  // requester, so the guard belongs HERE, where every loader lands.
  // Only when the pad already HAS a name: an unnamed pad restoring from the
  // store still gets the filename, which is worth more than a blank tile.
  eon_name_is_store_file(_fn) && strlen(_cn) > 0 ? 0 : (
  _len = strlen(_fn);
  _len > 0 ? (
    strcpy(_cn, _fn);
    // Strip extension (last '.' onward) — walk backward, scope to the last
    // segment so a path like "808 v1.5/kick.wav" only loses ".wav".
    _last_dot = -1;
    _i = 0; loop(_len,
      _ch = str_getchar(_cn, _i);
      _ch == 46 ? _last_dot = _i;  // '.' = 46
      _i += 1;
    );
    _last_dot > 0 ? str_setlen(_cn, _last_dot);
  );
  );
);

// ─── Sync pad names + notes to MIDI editor via Lua bridge (CMD 52) ───────
function sync_note_names()
local(_ki, _cn, _cnl, _cj)
(
  gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 && gmem[KIT_GMEM_CMD] == 0 &&
  (gmem[KIT_GMEM_LOCK] == 0 || gmem[KIT_GMEM_LOCK] == instance_id) ? (
    gmem[KIT_GMEM_LOCK] = instance_id;  // acquire instance lock
    // Write all pad names to gmem PADNAME area
    _ki = 0; loop(NUM_PADS,
      _cn = get_cname_slot(_ki);
      _cnl = strlen(_cn);
      _cj = 0; loop(KIT_GMEM_PADNAME_LEN,
        gmem[KIT_GMEM_PADNAMES + _ki * KIT_GMEM_PADNAME_LEN + _cj] =
          _cj < _cnl ? str_getchar(_cn, _cj) : 0;
        _cj += 1;
      );
      // Write note number to metadata area (already mapped)
      gmem[KIT_GMEM_META + _ki * KIT_GMEM_META_PP + 10] = p_note[_ki];
      // Write actual audio length (non-layered) or sentinel 1 (layered).
      // Browser still detects "has audio" via non-zero check; bridge gets
      // the real length it needs for gmem-fallback streaming.
      gmem[KIT_GMEM_AUDIOLEN + _ki] =
        s_len[_ki] > 0 ? s_len[_ki] :
        (pad_has_audio(_ki) ? 1 : 0);
      _ki += 1;
    );
    gmem[KIT_GMEM_CMD] = 52;
  );
);


// ─── Per-pad disk-source fail bitmap (P4 step 3) ─────────────────────────
// pad_fail_bits bit N = pad N records a disk source that did NOT load —
// the previously-invisible marker-reload failure (loaders reset s_len/l_len
// to 0 BEFORE file_open and had no else branch, so a missing file left a
// silent blank the truncation detector could never see). Recomputed
// declaratively after every loader/clear so a successful reload self-heals
// the bit (retires the relink banner). paths_gen counts every path-affecting
// mutation; the bridge uses it to invalidate its cached CMD-87 publish.
// RUNTIME-ONLY state: never serialized, and deliberately NOT initialized in
// @init — @init can run AFTER @serialize (EEL zero-init covers first run).
// Rules mirror the @serialize marker-reload + recoverability logic:
//   layered pad    → any layer with a non-empty LPATH but no audio = fail
//   promoted-single (p_layer_cnt>0, all LPATHs empty) → no layer audio at
//                    all while the pad-main path is set = fail
//   legacy pad     → pad-main path set but s_len==0 = fail
// Pad Banks step 3b (2026-09-23): one sixteen-bit mask PER BANK. Bank A's is pad_fail_bits itself (every
// consumer -- the relink banner, GS_REB_FAIL_BITS, the ack -- is sixteen wide and reads bank A; step 4/5
// make it the visible bank's); banks 1..3 keep their own scalar. One 64-bit mask would have put a slot
// >= 53 past a double's integers and a bank-3 pad's bit into the ack as 2^63 (the first BanksKit run).
function swing_fail_mask(b) ( b == 1 ? pad_fail_bank1 : b == 2 ? pad_fail_bank2 : b == 3 ? pad_fail_bank3 : pad_fail_bits; );
function swing_fail_mask_set(b, v) (
  b == 1 ? ( pad_fail_bank1 = v; ) : ( b == 2 ? ( pad_fail_bank2 = v; ) : ( b == 3 ? ( pad_fail_bank3 = v; ) : ( pad_fail_bits = v; ); ); );
);
function swing_pad_fail_recompute(pad) local(_m, _bad, _anylp, _anyl, _li, _lx, _b, _cur) (
  _bad = 0; _anylp = 0; _anyl = 0;
  _li = 0; loop(MAX_LAYERS,
    _lx = pad * MAX_LAYERS + _li;
    strlen(LPATH_STR_BASE + _lx) > 0 ? (
      _anylp = 1;
      l_len[_lx] <= 0 ? _bad = 1;
    );
    l_len[_lx] > 0 ? _anyl = 1;
    _li += 1;
  );
  p_layer_cnt[pad] > 0 ? (
    !_anylp && !_anyl && strlen(get_path_slot(pad)) > 0 ? _bad = 1;
  ) : (
    strlen(get_path_slot(pad)) > 0 && s_len[pad] <= 0 ? _bad = 1;
  );
  _m = 2 ^ pad;
  _b = (pad / NUM_PADS) | 0; _m = 2 ^ (pad - _b * NUM_PADS);   // the bank's own mask, bank-relative bit (step 3b)
  _cur = swing_fail_mask(_b);
  swing_fail_mask_set(_b, _bad ? (_cur | _m) : ((_cur | _m) - _m));
  paths_gen += 1;
);

// ─── Clear a single layer slot ──────────────────────────────────────────
function clear_layer(pad_idx, layer_idx) local(_lidx, li) (
  undo_begin_pad(pad_idx);  // Phase 2: back up this pad (audio+meta+names) for scoped structural undo
  _lidx = pad_idx * MAX_LAYERS + layer_idx;
  // A cleared layer is unbaked + its overlay waveform must re-capture on reload.
  sp_baked_tune[_lidx] = 0;
  ov_cap[_lidx] = 0;
  // Pad audio changed → bump the source generation so the Kit Bridge re-captures
  // this pad's bake/preload source for the Extension (stale-source guard).
  sp_src_gen[pad_idx] += 1;
  l_len[_lidx] = 0;
  l_start[_lidx] = 0;
  l_end[_lidx] = 1.0;
  l_sr[_lidx] = 0;
  l_norm[_lidx] = 0;
  l_norm_gain[_lidx] = 1.0;
  l_vel_lo[_lidx] = layer_idx / MAX_LAYERS;
  l_vel_hi[_lidx] = (layer_idx + 1) / MAX_LAYERS;
  l_rr_order[_lidx] = layer_idx;
  l_gain[_lidx] = 1.0;
  strcpy(LPATH_STR_BASE + _lidx, "");
  // Step 2a: a cleared layer FREES its region (rk_swing_alloc) instead of zeroing it -- the
  // next load into that memory writes what it holds and zero-tails the rest of ITS region.
  // A load in flight (_clr_skip_audio: the stream drop, the kit-empty zero job) keeps the
  // regions: they are its target, or the undo capture's source until its finish frees them.
  // (Until 2026-09-23 this was a memset of what the layer held: 8 MB per layer at worst, on
  // the audio thread; measured 2026-09-08 as most of a drop's first-block stall.)
  !_clr_skip_audio ? swing_region_free(pad_idx, layer_idx + 1);
  // Recalculate layer count (find highest non-empty layer)
  p_layer_cnt[pad_idx] = 0;
  li = 0; loop(MAX_LAYERS,
    l_len[pad_idx * MAX_LAYERS + li] > 0 ? p_layer_cnt[pad_idx] = li + 1;
    li += 1;
  );
  swing_pad_fail_recompute(pad_idx);  // P4 step 3: layer removed → refresh fail bit + paths_gen
  undo_cap_end();
);

// ─── Clear entire pad (all layers + legacy + name/path) ─────────────────
function clear_pad(i) local(li) (
  undo_begin_pad(i);  // Phase 2: back up this pad (audio+meta+names) for scoped structural undo
  s_len[i] = 0; s_start[i] = 0; s_end[i] = 1.0;
  // Eagerly clear the gmem blank signal too, so consumers (Kit Bridge
  // multi-out coloring, Drum Matrix lane sync) see the pad as blank on
  // the very next gmem read — not after the next @block runs the flush.
  // Without this, a kit-load cycle leaves the previous kit's purple-ish
  // positional hue painted on emptied multi-out tracks during the gap.
  // Pad Banks step 5c: the band is the bank on screen's sixteen tiles; an absolute i wrote past it.
  swing_pad_bank(i) == bank_cur ? gmem[KIT_GMEM_AUDIOLEN + swing_pad_tile(i)] = 0;
  s_sr[i] = 0; s_norm[i] = 0; s_norm_gain[i] = 1.0;
  s_dirty[i] = 1;
  strcpy(get_name_slot(i), "");
  strcpy(get_path_slot(i), "");
  strcpy(get_cname_slot(i), "");
  p_layer_cnt[i] = 0;
  p_layer_mode[i] = 3;
  li = 0; loop(MAX_LAYERS, clear_layer(i, li); li += 1;);
  // Step 2a: the plain region goes the way of the layers' (clear_layer above): freed, not
  // zeroed. A promoted pad has no plain region any more (the promotion moved it to layer 0),
  // so this is a no-op there and the layer pass already released everything.
  !_clr_skip_audio ? swing_region_free(i, 0);
  // Reset FX to defaults
  fx_hpf_freq[i] = 20; fx_lpf_freq[i] = 20000;
  fx_eq_lo[i] = 0; fx_eq_mid[i] = 0; fx_eq_mid2[i] = 0; fx_eq_hi[i] = 0;
  fx_eq_lo_freq[i] = 200; fx_eq_mid_freq[i] = 1000; fx_eq_mid2_freq[i] = 3000; fx_eq_hi_freq[i] = 5000;
  fx_eq_mid_q[i] = 0.8; fx_eq_mid2_q[i] = 0.8;
  fx_eq_lo_q[i] = 0.7071; fx_eq_hi_q[i] = 0.7071;
  fx_sat_drv[i] = 0; fx_drv_mode[i] = 0;
  fx_bc_rate[i] = 0; fx_bc_bits[i] = 16;
  fx_snd_dly[i] = 0; fx_snd_rvb[i] = 0; fx_snd_smash[i] = 0;
  s_skip[i] = 0; p_reverse[i] = 0; p_swapLR[i] = 0; p_stereo[i] = 0; p_oneshot[i] = -1; p_choke[i] = 0;
  p_rng_lo[i] = 0; p_rng_hi[i] = 0;  // clear chromatic range → single-note pad
  p_gain[i] = 1.0; p_pan[i] = 0; p_tune[i] = 0; p_sample_offset[i] = 0;
  p_mute[i] = 0; p_solo[i] = 0;
  p_color[i] = i / 16.0;  // default: evenly-spaced hue, matches @init in
                          // Swing_ReaKit.jsfx:423. Was 0 (= hue red), which
                          // made every pad/mixer strip red after Clear Kit.
  // NOTE: ps_* (SYN slot) is deliberately NOT reset here. clear_pad is called
  // by LOAD paths too (CMD-63 swing_browser_load_pad, kit-import empty-pad
  // clears in rk_swing_ui_state) and the user-ratified clear-semantics table
  // (Spec_Swing_Change_Map_And_Reroll §4.4b) says loads replace samples and
  // leave the synth slot alive. Explicit user Clear gestures additionally call
  // clear_pad_syn() below.
  swing_pad_fail_recompute(i);  // P4 step 3: paths wiped → fail bit clears (intentional removal)
  _kd_site = 2; mark_dirty_kit();
  undo_cap_end();
);

// Explicit user "Clear Pad" / "Clear Kit" / "New Kit" gestures say "ALL layers
// + FX" — those (and ONLY those) also reset the SYN slot. Call directly after
// clear_pad(i) at the gesture sites, never from load paths.
function clear_pad_syn(i) local() (
  ps_enable[i] = 0; ps_engine[i] = 0; ps_level[i] = 1;
  ps_vel_lo[i] = 0; ps_vel_hi[i] = 1; ps_rr_order[i] = MAX_LAYERS;
  ps_mac0[i] = 0.5; ps_mac1[i] = 0.5; ps_mac2[i] = 0.5; ps_mac3[i] = 0.5;
  ps_mac4[i] = 0.5; ps_mac5[i] = 0.5; ps_mac6[i] = 0.5; ps_mac7[i] = 0.5;
);

// ─── Memory readout + the trim mark (Spec_Swing_Pad_Banks §5.4 / §8.1, 2026-09-23) ──
// The standing figure the kit bar shows is what is LEFT of the pad-audio area, in seconds at
// the project rate ("8:32 free" -- people act on what is left). Since step 2a it is the
// allocator's figure (rk_swing_alloc): alloc_live counts REGIONS, and a region is what a load
// asked for -- rounded to a page, never shrunk on a reload, freed by a clear -- so the figure
// says what a next load can actually have, not a sum of content lengths. Every pad still
// caps at SLOT_SIZE on its own; the per-pad edge is the trim mark below. When banks land the
// kit bar narrows to the active bank and the strip carries the instrument's.
function swing_mem_used_cells() ( alloc_live; );
function swing_mem_free_secs() ( swing_alloc_free_secs(); );
// Step 4b (Pad Banks): what one BANK holds -- any playable pad, and the seconds its regions hold at each
// region's stored rate (main + layers; the pool's grant, so the sum of the four is what the pool has given).
// The strip's height where the big views start under it: the full UI only. The rack / dock face shows the strip
// too since 2026-10-15 (the user: with the mini browser open or Swing docked "it does not show me the correct bank
// i'm on"; spec 8.1 had left it out), but only over the pad grid -- a big view in the rack face covers it, so the
// views that start under it (console, FX picker) still add nothing there.
function swing_banktabs_h() ( dock_face ? 0 : swing_px(BANK_STRIP_H); );
// Is the strip on screen this frame? The full UI: always (it stands over every big view). The rack face: while the
// pad grid is what shows (no big view), in the band rk_swing_ui_state's rack header leaves between itself and the
// grid. One rule for the paint (Swing_ReaKit's two sites), the click (swing_banktabs_input) and the hit test below.
function swing_banktabs_shown() ( !dock_face || big_view_id == VIEW_NONE; );
// The pad editor is the modal on top: it is the last branch of the main @gfx's view dispatch, so it paints only when
// no picker, macro editor or big view is up. Its panel is centred over the window (a full-window dim behind it), so
// the strip's band runs under the panel: the strip paints BEFORE the editor (dimmed, the panel over it) and its
// click leaves the panel's rect to the editor's own rows (user 2026-10-13: the tabs sat over the editor's layer
// row). Outside the panel a tab click still selects the bank and closes the editor (spec 8.1). One rule for both
// passes (the main @gfx's paint order, swing_banktabs_input).
function swing_banktabs_under_editor() (
  overlay_pad >= 0 && !kmac_ed_open && rng_ov_pad < 0 && cat_ov_pad < 0 && pk_ov_pad < 0 && big_view_id == VIEW_NONE;
);
// The bank strip's select (Pad Banks step 4b; here since 4d so the MAP presets and the bank actions reach it):
// the selection moves to the same tile in the new bank, an open pad editor closes, mark_dirty (bank_cur is
// serialized) -- never an undo boundary (spec 12).
function swing_banktabs_select(b) (
  b >= 0 && b < NUM_BANKS && b != bank_cur ? (
    bank_cur = b;
    sel_pad = b * NUM_PADS + (sel_pad % NUM_PADS);   // the same tile, in the new bank
    overlay_pad = -1;                                // a pad editor open on the old bank closes
    cat_ov_pad = -1; rng_ov_pad = -1; pk_ov_pad = -1;   // ...and so do the pickers (they read the bands at the tile)
    mark_dirty();
    _reg_my_slot >= 0 ? gmem[GS_INST_BANK_CUR + _reg_my_slot] = bank_cur;   // step 5a: at once -- a build posted this frame reads it
  );
);
// The bank tab under (x, y), or -1: the strip's geometry (bt_*, rk_swing_ui_grid_pads) as of its last pass.
// Here because the kits view (imported before the grid) reads it for the drag-a-card-onto-a-tab drop (4c).
function swing_banktabs_hit(x, y) (
  swing_banktabs_shown() && bt_tabw > 0 && x >= bt_x && x < bt_x + bt_tabw * NUM_BANKS && y >= bt_y && y < bt_y + bt_h ? ((x - bt_x) / bt_tabw) | 0 : -1;
);
function swing_bank_has_sound(b) local(_i, _r) (
  _r = 0; _i = 0; loop(NUM_PADS, pad_is_playable(b * NUM_PADS + _i) ? _r = 1; _i += 1; );
  _r;
);

// ── Pad Banks Outputs step 3: choosing an output (Plan_Swing_Pad_Banks_Outputs.md 5) ─────────────────────────────
// A split pair (OUT_PAIR_SPLIT..) is FREE for slot ap when no other slot chose it, playable or not: two pads on one
// own output would share its track. Held = chosen by some slot (the "n of 10" counts).
function swing_out_split_free(p, ap) local(i, f) (
  f = 1; i = 0; loop(NUM_SLOTS, i != ap && (p_output[i] | 0) == p ? f = 0; i += 1; );
  f;
);
function swing_out_split_held() local(k, n) (
  n = 0; k = OUT_PAIR_SPLIT; loop(OUT_PAIRS - OUT_PAIR_SPLIT, !swing_out_split_free(k, -1) ? n += 1; k += 1; );
  n;
);
// Whose track the bridge made for split pair k (0..9): slot + 1, 0 = no track (or no bridge). Lua -> Swing, the
// strip band's OUT_TRK; read only to choose a pair, so a stale cell (another project, a bridge gone) costs no more
// than a less fitting choice.
function swing_out_trk_owner(k) (
  _reg_my_slot >= 0 ? gmem[GS_STRIP_BASE + _reg_my_slot * GS_STRIP_STRIDE + GS_STRIP_OFF_OUT_TRK + k] | 0 : 0;
);
// The pair "Own output" gives slot ap, or -1 when all ten are taken: a free pair whose track is already this pad's
// (put back and split off again, it gets its own track and its FX back), else a free pair nobody has a track on yet,
// else any free pair -- whose track then follows this pad (the bridge renames it and moves it to this pad's bank).
function swing_out_split_pick(ap) local(k, p, own, fresh, any, t) (
  own = -1; fresh = -1; any = -1;
  k = 0; loop(OUT_PAIRS - OUT_PAIR_SPLIT,
    p = OUT_PAIR_SPLIT + k;
    swing_out_split_free(p, ap) ? (
      t = swing_out_trk_owner(k);
      own < 0 && t == ap + 1 ? own = p;
      fresh < 0 && t == 0 ? fresh = p;
      any < 0 ? any = p;
    );
    k += 1;
  );
  own >= 0 ? own : fresh >= 0 ? fresh : any;
);
// A person's output choice, counted for the bridge (strip OUT_UREQ; 2026-10-16, the user: "the output returns to the
// bank but undo does not remove the track"): the bridge gives each one a REAPER undo point -- with the track it makes,
// when it makes one -- so Ctrl+Z takes the choice and the track back together; Swing's own UNDO leaves output choices
// alone (UDO_K_OUT). Every path a person takes calls this (the Out menu, the LCD stepper, the OUTPUTS panel, Auto
// Assign / Reset All / the MULTI toggle); a kit load, a build's adopt and the bridge's commands do not. The count is
// never reset by @init (a sample-rate change re-runs it; the bridge re-syncs on a count that went down).
// REAPER keeps an undo point only when the state it can see has changed, and a choice made in here is one it cannot
// see until it reads Swing's state again: the bridge nudges the hidden "Dirty: Global" counter (slider3) through
// the API before its point (eon_out_poke). A sliderchange on that counter from here was tried first and changed
// nothing (2026-10-16): REAPER re-reads the state for a parameter set through the API, not for one the plugin reports.
function swing_out_touched() ( out_ureq += 1; );
// Write a choice: the kit-dirty mark, the bridge's count and the OUTPUT colour mode's refresh, only when it changes.
function swing_out_set(ap, v) (
  v >= 0 && v != (p_output[ap] | 0) ? ( p_output[ap] = v; mark_dirty_pad(ap); col_dirty = 1; swing_out_touched(); );
);
// The Out menu, one builder for the pad tile, the FX overlay and the LCD stepper (they disagreed on nothing only
// because each listed Out 1-16). Bank A: Out 1-16, then the tracks of the banks that have sounds -- or the one it
// plays through now (decision 9). Banks B-D: the bank's track, or the pad's own output (greyed when all ten are
// taken). out_menu_val[result - 1] = what a pick writes: a value, -1 = take a split pair, -2 = nothing (the entry
// already chosen, the greyed one).
function swing_out_menu(ap, dest) local(b, cur, n, k, v) (
  b = swing_pad_bank(ap); cur = swing_out_pair(ap); n = 0;
  strcpy(dest, "");
  b == 0 ? (
    k = 0; loop(NUM_PADS,
      n > 0 ? strcat(dest, "|");
      cur == k ? strcat(dest, "!");
      sprintf(#_om_t, "Out %d", k + 1); strcat(dest, #_om_t);
      out_menu_val[n] = cur == k ? -2 : k; n += 1;
      k += 1;
    );
    k = 1; loop(NUM_BANKS - 1,
      v = OUT_PAIR_BANK + k - 1;
      cur == v || swing_bank_has_sound(k) ? (
        n == NUM_PADS ? strcat(dest, "||") : strcat(dest, "|");   // a separator row before the first (no result number)
        cur == v ? strcat(dest, "!");
        sprintf(#_om_t, "Bank %c", 65 + k); strcat(dest, #_om_t);
        out_menu_val[n] = cur == v ? -2 : v; n += 1;
      );
      k += 1;
    );
  ) : (
    v = cur == OUT_PAIR_BANK + b - 1;
    v ? sprintf(dest, "!Bank %c", 65 + b) : sprintf(dest, "Bank %c", 65 + b);
    out_menu_val[0] = v ? -2 : swing_pad_tile(ap);   // 0..15 = the bank's track (the step 2b default)
    cur >= OUT_PAIR_SPLIT ? (
      strcat(dest, "|!Own output"); out_menu_val[1] = -2;
    ) : swing_out_split_pick(ap) >= 0 ? (
      strcat(dest, "|Own output"); out_menu_val[1] = -1;
    ) : (
      strcat(dest, "|#^g Own output: all 10 in use"); out_menu_val[1] = -2;
    );
  );
);
function swing_out_menu_pick(ap, res) local(v) (
  ap >= 0 && ap < NUM_SLOTS && res >= 1 && res <= 32 ? (
    v = out_menu_val[res - 1];
    v == -1 ? v = swing_out_split_pick(ap);
    swing_out_set(ap, v);
  );
);
// After a kit load lands bank b's pads: a kit keeps each pad's choice as it was saved, and an own output that was
// free there may be another pad's here. A bank A pad carrying a split pair goes back to its own output; a bank B-D
// pad whose split pair another slot holds takes a free one (its bank's track when all ten are taken); a bank B-D pad
// on another bank's track goes back to its own bank's. Everything else stays: a kit loaded back where it was saved
// keeps its own outputs, and their tracks.
function swing_out_loaded(b) local(i, ap, v) (
  i = 0; loop(NUM_PADS,   // this bank: the one the kit load just landed (kit_load_bank)
    ap = b * NUM_PADS + i; v = p_output[ap] | 0;
    v >= OUT_PAIR_SPLIT && v < OUT_PAIRS ? (
      b == 0 ? p_output[ap] = i :
      !swing_out_split_free(v, ap) ? ( v = swing_out_split_pick(ap); p_output[ap] = v >= 0 ? v : i; );
    ) : b > 0 && v >= OUT_PAIR_BANK && v < OUT_PAIR_SPLIT && v != OUT_PAIR_BANK + b - 1 ? p_output[ap] = i;
    i += 1;
  );
);
// The LCD arrows and the wheel over an Out control: bank A steps through Out 1-16 (from a bank track: to Out 1 or
// Out 16); a bank B-D pad goes to its own output one way (dir > 0) and back to its bank's track the other.
function swing_out_step(ap, dir) local(v) (
  v = p_output[ap] | 0;
  swing_pad_bank(ap) == 0 ? (
    v = v >= NUM_PADS ? (dir > 0 ? 0 : NUM_PADS - 1) : (v + (dir > 0 ? 1 : -1) + NUM_PADS) % NUM_PADS;
  ) : dir > 0 ? (
    swing_out_pair(ap) < OUT_PAIR_SPLIT ? v = swing_out_split_pick(ap);
  ) : (
    swing_out_pair(ap) >= OUT_PAIR_SPLIT ? v = swing_pad_tile(ap);
  );
  swing_out_set(ap, v);
);
function swing_bank_used_secs(b) local(_i, _ap, _r, _s, _rate, _len) (
  _s = 0; _i = 0; loop(NUM_PADS,
    _ap = b * NUM_PADS + _i;
    _r = 0; loop(MAX_LAYERS + 1,
      _len = swing_region_len(_ap, _r);
      _len > 0 ? (
        _rate = _r == 0 ? s_sr[_ap] : l_sr[_ap * MAX_LAYERS + _r - 1];
        _s += _len / (2 * (_rate > 0 ? _rate : srate));
      );
      _r += 1;
    );
    _i += 1;
  );
  _s;
);
// A pad whose audio sits AT its cap was trimmed on load (swing_ldr_step stops reading at
// LDR_F_CAP, so a longer file lands exactly there) or cut on promotion. Derived from the
// lengths rather than kept as a flag: it survives a project reload, travels with a swap
// and clears with the next load or clear by itself. Returns the cap in seconds at the
// pad's stored rate (45 at 44.1k for a pad and, since 2026-09-23, for a layer too), 0 when nothing is trimmed.
function pad_trimmed_secs(i) local(_pt_l, _pt_lidx, _pt_s) (
  _pt_s = 0;
  p_layer_cnt[i] > 0 ? (
    _pt_l = 0; loop(MAX_LAYERS,
      _pt_lidx = i * MAX_LAYERS + _pt_l;
      _pt_s == 0 && l_len[_pt_lidx] >= LAYER_SIZE ? (
        _pt_s = LAYER_SIZE / (2 * (l_sr[_pt_lidx] > 0 ? l_sr[_pt_lidx] : srate));
      );
      _pt_l += 1;
    );
  ) : (
    s_len[i] >= SLOT_SIZE ? ( _pt_s = SLOT_SIZE / (2 * (s_sr[i] > 0 ? s_sr[i] : srate)); );
  );
  _pt_s;
);

// ─── Plain pads, layers, and the promotion cut ────────────────────────────
// (Spec_Swing_Long_Pad_Layer_Cap.md) A pad holding ONE sample is a PLAIN pad:
// p_layer_cnt = 0, the audio at the slot base, s_len up to SLOT_SIZE (45 s at
// 44.1k). It becomes a layered pad only when a layer >= 1 receives audio, and
// a layer holds LAYER_SIZE -- which WAS 11.3 s, so promoting a pad longer than that CUT
// it (announced on the LCD, undoable); since 2026-09-23 LAYER_SIZE == SLOT_SIZE and the cut
// below is unreachable, kept as the guard. The historical mechanism, for the record:
// (whole-slot backup). Until 2026-09-08 every load promoted the pad to a
// one-layer pad, which capped every pad at 11.3 s in playback, @serialize, the
// kit export and the kit import while s_len kept the true length — the
// header/blob mismatch of the 2026-09-07 audit.

// Layer index an "add a layer" gesture should target: a plain pad with audio
// stacks on layer 1 (layer 0 is its sample); otherwise the next free slot,
// clamped so a full pad stacks on its last layer rather than doing nothing.
function swing_pad_next_layer(pad) (
  p_layer_cnt[pad] == 0 && s_len[pad] > 0 ? 1 : min(p_layer_cnt[pad], MAX_LAYERS - 1);
);
// A browser drop on the pad editor's layer tab k (0..3; the user, 2026-10-22): the layer the first file goes to -- k
// itself when that layer holds a sound (it is replaced), else the pad's next free layer (the layers stay in order);
// -1 = the first file REPLACES the pad as a plain load (tab L1 of a plain or an empty pad) and the rest stack from
// layer 1. More files take the layers after it, four at most (the bridge's verb 7, the big browser's claim).
function swing_layer_drop_first(pad, k) local(_ld_n) (
  _ld_n = p_layer_cnt[pad] > 0 ? p_layer_cnt[pad] : (s_len[pad] > 0 ? 1 : 0);
  k == 0 && p_layer_cnt[pad] == 0 ? -1 : k < _ld_n ? k : _ld_n == 0 ? -1 : min(_ld_n, MAX_LAYERS - 1);
);

// Promote a plain pad's sample into layer 0. Since 2026-09-23 LAYER_SIZE == SLOT_SIZE, so the cut
// below never fires (kept: it is the guard, and the banner, should the two ever differ again).
// The plain REGION becomes layer 0's (banks
// step 2a: a transfer of the pointer pair, no copy, no allocation -- its size stays, so
// undo fits back in place), and the rest is metadata — plus the cut when the sample is
// longer than a layer. Safe inside an existing undo capture or standalone
// (captures are depth-counted; the outermost caller records the backup).
// Idempotent: a layered or empty pad is left alone.
function swing_pad_promote(pad)
local(_lidx, _old_len, _sr)
(
  pad >= 0 && pad < NUM_SLOTS && p_layer_cnt[pad] == 0 && s_len[pad] > 0 ? (
    undo_begin_pad(pad);
    _lidx = pad * MAX_LAYERS;
    _old_len = s_len[pad];
    // The transfer (step 2a): a stale layer-0 region on a plain pad cannot normally exist,
    // but if one does it is released rather than leaked.
    p_llen[_lidx] > 0 ? swing_region_free(pad, 1);
    swing_alloc_lock();            // a table write outside swing_region_set: under the lock, and
    swing_alloc_cancel_move();     // it abandons a compaction move in flight on this pad
    p_lptr[_lidx] = p_aptr[pad]; p_llen[_lidx] = p_alen[pad];
    p_aptr[pad] = -1; p_alen[pad] = 0;
    swing_alloc_unlock();
    _old_len > LAYER_SIZE ? (
      // The cut (unreachable since 2026-09-23, see above). Trim fractions are relative to the
      // length: a trim that lies inside the surviving LAYER_SIZE stays where it is, the rest clamps to
      // the new end; an inverted pair falls back to the whole layer.
      s_start[pad] = min(1.0, s_start[pad] * _old_len / LAYER_SIZE);
      s_end[pad]   = min(1.0, s_end[pad]   * _old_len / LAYER_SIZE);
      s_start[pad] >= s_end[pad] ? ( s_start[pad] = 0; s_end[pad] = 1.0; );
      s_len[pad] = LAYER_SIZE;
      _sr = s_sr[pad] > 0 ? s_sr[pad] : srate;
      pad_cut_warn_pad    = pad;
      pad_cut_warn_before = _old_len / (2 * _sr);
      pad_cut_warn_after  = LAYER_SIZE / (2 * _sr);
      pad_cut_warn_until  = time_precise() + 8;
      sp_src_gen[pad] += 1;   // the Extension re-captures this pad's source
    );
    l_len[_lidx]       = s_len[pad];
    l_start[_lidx]     = s_start[pad];
    l_end[_lidx]       = s_end[pad];
    l_sr[_lidx]        = s_sr[pad];
    l_norm[_lidx]      = s_norm[pad];
    l_norm_gain[_lidx] = s_norm_gain[pad];
    l_gain[_lidx]      = 1.0;
    l_vel_lo[_lidx]    = 0;
    l_vel_hi[_lidx]    = 1.0;
    l_rr_order[_lidx]  = 0;
    strcpy(LPATH_STR_BASE + _lidx, get_path_slot(pad));
    p_layer_cnt[pad] = 1;
    p_layer_mode[pad] == 0 ? p_layer_mode[pad] = 3;
    s_dirty[pad] = 1;
    undo_cap_end();
  );
);

// ─── Waveform-aware ADSR analysis ─────────────────────────────────────────
// Derives ADSR parameters from actual waveform shape. Runs at load time
// (never in @sample — sqrt is intentional and safe here).
// ─── Sliced sample loader ─────────────────────────────────────────────────
// One resumable load JOB per lane. Job 0 belongs to @block (kit import, the
// CMD-88 reload pump, CMD 63/64) and is pumped one bounded slice per block;
// job 1 belongs to the UI side (@gfx drops, @serialize reloads) and is run to
// completion in one call by the load_from_path / load_layer_from_path
// wrappers. The lanes never share state, so a drop during a kit load cannot
// corrupt the in-flight job. A job walks: open + header (begin) → read in
// slices with the peak folded in → zero the unused tail → RMS windows for the
// waveform-aware ADSR → finish (metadata, names, layer promotion, ADSR
// results, flags). Every loop inside one slice stays far under EEL2's 2^20
// iteration cap; the old one-shot loader tripped it on samples longer than
// 2^20 cells (its peak scan saw only the first 1,048,576 cells, and a mono file
// lost everything past 1,048,576 frames) — measured 2026-09-07 with
// .dev_tests/EON_Probe_LdrSlice_*. Job records live in host-allocated memory
// (swing_ldr_init) — this inc claims no freemem itself (wiki 2.4).
LDR_F_PHASE   = 0;   // 0 idle · 1 read · 2 zero tail · 3 RMS windows · 4 finish
LDR_F_PAD     = 1;
LDR_F_LAYER   = 2;   // -1 = pad main
LDR_F_HANDLE  = 3;
LDR_F_NCH     = 4;
LDR_F_SR      = 5;
LDR_F_BUF     = 6;
LDR_F_CAP     = 7;
LDR_F_POS     = 8;   // cells landed so far
LDR_F_PEAK    = 9;
LDR_F_ZPOS    = 10;  // zero-tail cursor
LDR_F_WFR     = 11;  // RMS window: frames
LDR_F_WIL     = 12;  // RMS window: interleaved cells
LDR_F_NWIN    = 13;
LDR_F_W       = 14;  // RMS window cursor
LDR_F_PKRMS   = 15;
LDR_F_PKWIN   = 16;
LDR_F_ADSR    = 17;  // 1 = the analyzer owns this pad's ADSR after the load
LDR_F_PREVCNT = 18;  // layer loads: p_layer_cnt before the load
LDR_F_OPENED  = 19;  // file_open succeeded
LDR_F_LEN     = 20;  // final cell count
LDR_F_DISP    = 21;  // step 2a: the regions this job displaced (rk_swing_alloc list, 2 * (MAX_LAYERS + 1) = 10 cells, 21..30), freed at finish / abort
LDR_F_REFUSED = 31;  // step 2a: 1 = refused for room (Spec_Swing_Pad_Banks §5.4) -- the pad is left exactly as it was
LDR_F_NEED    = 32;  // step 2a: cells the file needs, kept while the job WAITS for room (phase 6)
LDR_F_WAITN   = 33;  // step 2a: re-fits tried from phase 6 (three at most, then the load is refused)
LDR_F_STG     = 34;  // 2026-10-15: 1 = a STAGED load -- the stream lands in a staging region, the pad keeps its old sample
LDR_F_STGP    = 35;  //   until swing_ldr_stage_commit at finish. STGP / STGL = the staging region (ptr, len), the record the
LDR_F_STGL    = 36;  //   allocator settles above (swing_alloc_register_stage); 0 / 0 once committed or released.
LDR_F_RMS     = 40;  // 200-cell RMS scratch (LDR_JOB_STRIDE is 256)

function swing_ldr_init(fm) (
  ldr_job0 = fm;
  ldr_job1 = fm + LDR_JOB_STRIDE;
  memset(fm, 0, 2 * LDR_JOB_STRIDE);   // an @init re-run drops any in-flight job
  ldr_job0[LDR_F_HANDLE] = -1;
  ldr_job1[LDR_F_HANDLE] = -1;
  ldr_budget = LDR_BUDGET_MIN;         // @block rescales it from samplesblock
  fm + 2 * LDR_JOB_STRIDE;
);

// Drop an in-flight job: a newer job for the same lane, or a state machine the
// bridge abandoned mid-flight. The pad keeps the zero length begin() gave it -- or, for a
// STAGED load (never committed), the old sample it never stopped holding: the staging
// region is released and the pad is untouched.
function swing_ldr_abort(jb) local(_sp, _sl) (
  jb[LDR_F_PHASE] > 0 ? (
    jb[LDR_F_HANDLE] >= 0 ? file_close(jb[LDR_F_HANDLE]);
    jb[LDR_F_HANDLE] = -1;
    jb[LDR_F_STG] ? (
      swing_alloc_lock();
      _sp = jb[LDR_F_STGP]; _sl = jb[LDR_F_STGL];
      jb[LDR_F_STGP] = 0; jb[LDR_F_STGL] = 0; jb[LDR_F_STG] = 0;   // out of the record FIRST: the release settles
      swing_alloc_release_(_sp, _sl);
      swing_alloc_unlock();
    );
    // Step 2a: the regions this job displaced are freed here; the undo capture reads
    // through them, so it is completed first (eagerly -- an abort is rare, off the hot path).
    swing_disp_any(jb + LDR_F_DISP) ? ( udo_cow_drain(jb[LDR_F_PAD]); swing_disp_free(jb + LDR_F_DISP); );
    swing_pad_fail_recompute(jb[LDR_F_PAD]);
    undo_cap_end();
    jb[LDR_F_PHASE] = 0;
  );
);

// The target's metadata reset a load makes before it reads: the pad-main path and lengths,
// or one layer's fields. Since step 2a it runs AFTER the region fit succeeded (a refused load
// never reaches it, so the pad keeps its audio, path and lengths) and, as it always did, on
// an open failure or an unsupported file -- the pad then ends empty with the path kept and the
// fail bit set.
function swing_ldr_reset_target(jb, pad, layer, path_str) local(lidx) (
  layer < 0 ? (
    s_len[pad] = 0;  // stays 0 if the load fails
    s_sr[pad]  = 0;
    strcpy(get_path_slot(pad), path_str);
  ) : (
    lidx = pad * MAX_LAYERS + layer;
    // Freshly loaded layer = original (unbaked) audio: clear the bake anchor (so
    // the residual tracks full tune until a new bake lands, and the bridge can
    // re-capture this layer's source) and re-arm the overlay waveform capture.
    sp_baked_tune[lidx] = 0;
    ov_cap[lidx] = 0;
    l_len[lidx] = 0; l_start[lidx] = 0; l_end[lidx] = 1.0; l_sr[lidx] = 0;
    l_norm[lidx] = 0; l_norm_gain[lidx] = 1.0; l_vel_lo[lidx] = 0; l_vel_hi[lidx] = 1.0;
    l_rr_order[lidx] = layer; l_gain[lidx] = 1.0;
    strcpy(LPATH_STR_BASE + lidx, path_str);  // layer file path for serialization
  );
);

// Cells a file would need in a pad (interleaved stereo: a mono file expands to twice its
// frames), through the same open / rate-ceiling path swing_ldr_begin takes; -1 when it does
// not open or has an unsupported channel count. For a caller that must know whether a load
// fits BEFORE it clears the pad (the no-bridge CMD 63), so a refusal leaves the pad intact.
function swing_ldr_file_cells(path_str) local(f, nch, fsr, n) (
  n = -1;
  f = file_open(path_str);
  f >= 0 ? (
    file_riff(f, nch, fsr);
    fsr > STORE_RATE_MAX ? (
      file_close(f);
      f = file_open(path_str);
      f >= 0 ? ( nch = 'rqsr'; fsr = STORE_RATE_MAX; file_riff(f, nch, fsr); ) : ( nch = 0; );
    );
    (nch > 0 && nch < 3) ? ( n = file_avail(f); nch == 1 ? n = n * 2; );
    f >= 0 ? file_close(f);
  );
  n;
);

// The fit succeeded: adopt the target and start reading. Shared by swing_ldr_begin and the
// phase-6 resume (a job that waited for the compaction job to make room).
function swing_ldr_accept(jb, pad, layer, path_str, f, nch, fsr) (
  swing_ldr_reset_target(jb, pad, layer, path_str);
  jb[LDR_F_HANDLE] = f;
  jb[LDR_F_NCH] = nch;
  jb[LDR_F_SR] = fsr > 0 ? fsr : srate;
  layer < 0 ? ( s_sr[pad] = jb[LDR_F_SR]; ) : ( l_sr[pad * MAX_LAYERS + layer] = jb[LDR_F_SR]; );
  // A plain pad receiving a layer (only once the file really opened, so
  // a missed open leaves the plain pad intact): a layer >= 1 promotes its
  // sample to layer 0 first — the cut and the banner live in
  // swing_pad_promote; a layer-0 load replaces the plain sample outright,
  // so its pad-main length goes with it (playback, the kit header and the
  // Extension capture follow l_len[0] from here on).
  layer >= 1 ? swing_pad_promote(pad) :
  (layer == 0 && p_layer_cnt[pad] == 0 ? s_len[pad] = 0);
  layer < 0 ? ( jb[LDR_F_BUF] = p_aptr[pad]; jb[LDR_F_CAP] = p_alen[pad]; )
            : ( jb[LDR_F_BUF] = p_lptr[pad * MAX_LAYERS + layer]; jb[LDR_F_CAP] = p_llen[pad * MAX_LAYERS + layer]; );
  jb[LDR_F_PHASE] = 1;
);

function swing_ldr_begin(jb, pad, layer, path_str)
local(f, nch, fsr, need)
(
  jb[LDR_F_PHASE] > 0 ? swing_ldr_abort(jb);   // a new job always wins
  jb[LDR_F_PAD] = pad; jb[LDR_F_LAYER] = layer;
  jb[LDR_F_HANDLE] = -1; jb[LDR_F_NCH] = 0; jb[LDR_F_SR] = 0;
  jb[LDR_F_POS] = 0; jb[LDR_F_PEAK] = 0.00001; jb[LDR_F_ZPOS] = 0; jb[LDR_F_LEN] = 0;
  jb[LDR_F_OPENED] = 0; jb[LDR_F_ADSR] = 0; jb[LDR_F_NWIN] = 0;
  jb[LDR_F_PREVCNT] = layer < 0 ? 0 : p_layer_cnt[pad];   // layer loads: the count before the load
  jb[LDR_F_BUF] = -1; jb[LDR_F_CAP] = 0; jb[LDR_F_REFUSED] = 0;
  swing_disp_clear(jb + LDR_F_DISP);
  undo_begin_pad(pad);  // Phase 2: back up this pad (audio+meta+names) for scoped structural undo
  f = file_open(path_str);
  // Transient open miss (AV/indexer read-lock on a valid file): flag it so the
  // kit-import loop retries THIS pad next @block instead of leaving it blank
  // (2026-07-19). SET only — the loop clears it per pass.
  f < 0 ? kit_pad_open_failed = 1;
  f >= 0 ? (
    jb[LDR_F_OPENED] = 1;
    file_riff(f, nch, fsr);
    // The storage-rate ceiling on the no-bridge path (Spec_Swing_Pad_Banks §5.5, step 1c,
    // 2026-09-23). A file above STORE_RATE_MAX is re-opened with file_riff's 'rqsr'
    // request and REAPER resamples it on read. Measured by EON_Probe_Rqsr: 'rqsr' 48000 on
    // a 96k file hands back rate 48000, the REAL channel count and half the frames, with
    // the sine intact -- and a file BELOW the request is upsampled, which is why the
    // request is made only after a plain file_riff has shown the native rate is above the
    // ceiling: never upsample, a 44.1k file stays 44.1k. What file_riff hands back after
    // the request is the authority for s_sr / l_sr below, never the number asked for.
    fsr > STORE_RATE_MAX ? (
      file_close(f);
      f = file_open(path_str);
      f >= 0 ? ( nch = 'rqsr'; fsr = STORE_RATE_MAX; file_riff(f, nch, fsr); ) : ( nch = 0; );
    );
    nch > 0 && nch < 3 ? (
      // Step 2a: the region is taken HERE, sized to the file (file_avail after file_riff is
      // the samples left -- interleaved for stereo; a mono file expands to twice that),
      // before anything of the pad is touched, so a refusal leaves it exactly as it was
      // (§5.4: refusal, not truncation). A layer >= 1 on a plain pad fits its own region
      // first and promotes after; a layer 0 on a plain pad takes the plain region over
      // inside the fit. The old regions a fit replaces ride in the job's displaced list.
      need = file_avail(f); nch == 1 ? need = need * 2;
      need = max(need, 2);
      (layer < 0 ? swing_pad_fit_main(pad, need, jb + LDR_F_DISP)
                 : swing_pad_fit_layer(pad, layer, need, jb + LDR_F_DISP)) ? (
        swing_ldr_accept(jb, pad, layer, path_str, f, nch, fsr);
      ) : alc_wait ? (
        // No room now, room once the compaction job has packed the area (the fit filed the
        // request): WAIT in phase 6 with the file open. A kit import yields on a job in
        // flight, the no-bridge CMD 63 resumes it, swing_ldr_run packs synchronously; the
        // resume re-fits and adopts the target only then, so a refusal still leaves the pad
        // exactly as it was.
        jb[LDR_F_HANDLE] = f; jb[LDR_F_NCH] = nch; jb[LDR_F_SR] = fsr; jb[LDR_F_NEED] = need;
        jb[LDR_F_WAITN] = 0;
        strcpy(jb == ldr_job0 ? #_ldr_wpath0 : #_ldr_wpath1, path_str);
        jb[LDR_F_PHASE] = 6;
      ) : (
        file_close(f);
        jb[LDR_F_REFUSED] = 1;   // finish says so on the LCD and touches nothing else
        jb[LDR_F_PHASE] = 4;
      );
    ) : (
      f >= 0 ? file_close(f);   // unsupported channel count (or the reopen above failed): finish records the failure
      swing_ldr_reset_target(jb, pad, layer, path_str);
      jb[LDR_F_PHASE] = 4;
    );
  ) : (
    swing_ldr_reset_target(jb, pad, layer, path_str);
    jb[LDR_F_PHASE] = 4;
  );
);

// Stream-fed twin of swing_ldr_begin (EON_PADPCM, rk_swing_padpcm.jsfx-inc; go-live
// Stream-fed twin of swing_ldr_begin (EON_PADPCM, rk_swing_padpcm.jsfx-inc; go-live
// hardening Phase 2, 2026-09-08). The Kit Bridge already opened and decoded the
// file on the UI thread and hands the PCM over as interleaved stereo, so this
// does everything begin() does EXCEPT file_open / file_riff -- the ~30 ms stall
// that used to sit on the audio thread once per drop. `total` = the interleaved
// cell count the bridge will deliver, `fsr` its sample rate. Phase 5 = "fed by
// the stream": swing_padpcm_tick copies the cells straight into LDR_F_BUF and
// folds the peak, then hands the job to phase 2 at the stream's LAST chunk, and
// phases 2/3/4 (zero tail, RMS/ADSR, finish) run exactly as for a file read.
function swing_ldr_begin_gmem(jb, pad, layer, path_str, fsr, total)
local(lidx)
(
  jb[LDR_F_PHASE] > 0 ? swing_ldr_abort(jb);   // a new job always wins
  jb[LDR_F_PAD] = pad; jb[LDR_F_LAYER] = layer;
  jb[LDR_F_HANDLE] = -1; jb[LDR_F_NCH] = 0; jb[LDR_F_SR] = 0;
  jb[LDR_F_POS] = 0; jb[LDR_F_PEAK] = 0.00001; jb[LDR_F_ZPOS] = 0; jb[LDR_F_LEN] = 0;
  jb[LDR_F_OPENED] = 0; jb[LDR_F_ADSR] = 0; jb[LDR_F_NWIN] = 0;
  jb[LDR_F_PREVCNT] = layer < 0 ? 0 : p_layer_cnt[pad];
  jb[LDR_F_BUF] = -1; jb[LDR_F_CAP] = 0; jb[LDR_F_REFUSED] = 0;
  swing_disp_clear(jb + LDR_F_DISP);
  undo_begin_pad(pad);
  lidx = pad * MAX_LAYERS + max(layer, 0);
  total > 0 ? (
    // Step 2a: the region, sized to what the bridge will deliver. swing_padpcm_begin asked
    // swing_pad_can_fit before it cleared the pad, so this refuses only if the room went
    // between the two -- and then the pad is left as the clear left it, told on the LCD.
    (layer < 0 ? swing_pad_fit_main(pad, total, jb + LDR_F_DISP)
               : swing_pad_fit_layer(pad, layer, total, jb + LDR_F_DISP)) ? (
      swing_ldr_reset_target(jb, pad, layer, path_str);
      jb[LDR_F_OPENED] = 1;
      jb[LDR_F_NCH] = 2;                       // the stream is always interleaved stereo
      jb[LDR_F_SR] = fsr > 0 ? fsr : srate;
      layer < 0 ? ( s_sr[pad] = jb[LDR_F_SR]; ) : ( l_sr[lidx] = jb[LDR_F_SR]; );
      layer >= 1 ? swing_pad_promote(pad) :
      (layer == 0 && p_layer_cnt[pad] == 0 ? s_len[pad] = 0);
      layer < 0 ? ( jb[LDR_F_BUF] = p_aptr[pad]; jb[LDR_F_CAP] = p_alen[pad]; )
                : ( jb[LDR_F_BUF] = p_lptr[lidx]; jb[LDR_F_CAP] = p_llen[lidx]; );
      jb[LDR_F_PHASE] = 5;
    ) : (
      jb[LDR_F_REFUSED] = 1;
      jb[LDR_F_PHASE] = 4;
    );
  ) : (
    // the bridge could not decode it: the same transient class as an open miss
    swing_ldr_reset_target(jb, pad, layer, path_str);
    kit_pad_open_failed = 1;
    jb[LDR_F_PHASE] = 4;
  );
);

// THE STAGED pad-main load (2026-10-15; the user: "its like the pad goes blank then the sample loads").
// swing_ldr_begin_gmem for a CMD 63 drop whose stream lands in a STAGING region (sp / sl, taken by
// swing_alloc_take_stage) instead of the pad's own: nothing of the pad changes here -- no clear, no
// region fit, no path, no rate, its voices keep playing -- so the pad keeps its name, its waveform and its
// sound for the whole stream, the zero tail and the analysis. swing_ldr_stage_commit switches it over at
// finish, in one block. The structural undo bracket opens here as in begin_gmem (the caller took the sliced
// capture of the OLD regions first; they stay live, untouched, until the commit displaces them and the
// finish frees them once the capture has read them -- phase 2 drains it first, below).
function swing_ldr_begin_gmem_staged(jb, pad, path_str, fsr, total, sp, sl)
(
  jb[LDR_F_PHASE] > 0 ? swing_ldr_abort(jb);   // a new job always wins
  jb[LDR_F_PAD] = pad; jb[LDR_F_LAYER] = -1;
  jb[LDR_F_HANDLE] = -1; jb[LDR_F_NCH] = 2; jb[LDR_F_SR] = fsr > 0 ? fsr : srate;
  jb[LDR_F_POS] = 0; jb[LDR_F_PEAK] = 0.00001; jb[LDR_F_ZPOS] = 0; jb[LDR_F_LEN] = 0;
  jb[LDR_F_OPENED] = 1; jb[LDR_F_ADSR] = 0; jb[LDR_F_NWIN] = 0;
  jb[LDR_F_PREVCNT] = 0; jb[LDR_F_REFUSED] = 0;
  swing_disp_clear(jb + LDR_F_DISP);
  undo_begin_pad(pad);
  strcpy(#_ldr_stg_path, path_str);   // the commit stamps it: the caller's path string may be reused by then
  jb[LDR_F_STGP] = sp; jb[LDR_F_STGL] = sl; jb[LDR_F_STG] = 1;
  jb[LDR_F_BUF] = sp; jb[LDR_F_CAP] = sl;
  jb[LDR_F_PHASE] = 5;
);

// The switch-over of a staged load, at the top of swing_ldr_finish: everything begin_gmem and the CMD 63
// start used to do to the pad at the stream's FIRST chunk, now at its end. The old voices fade (10 ms, as
// before); every region the pad had goes onto the job's displaced list (live until the finish below frees
// it -- the undo capture reads through it) and leaves the pad's table; then the pad is cleared (the
// clear_pad the drop always made: FX to defaults, names, layers -- its region frees find nothing, so no
// _clr_skip_audio: this can run on the @gfx stall fallback, and that flag is the @block load's; gfx_race
// caught the first cut setting it from here); then the staging region becomes the pad's plain region, under
// the lock with the record cleared in the same hold (the allocator settles either the record or the table,
// never neither); then its target is reset (the path, the length the finish sets) and its rate set. The
// rest of swing_ldr_finish then runs exactly as for any other load.
function swing_ldr_stage_commit(jb) local(_pad, _r, _l) (
  _pad = jb[LDR_F_PAD];
  swing_voice_kill_pad_xf(_pad);
  swing_alloc_lock();
  _r = 0; loop(MAX_LAYERS + 1,
    _l = swing_region_len(_pad, _r);
    _l > 0 ? swing_disp_push_(jb + LDR_F_DISP, _r, swing_region_ptr(_pad, _r), _l);
    swing_region_set(_pad, _r, -1, 0);
    _r += 1;
  );
  swing_alloc_unlock();
  clear_pad(_pad);
  swing_alloc_lock();
  swing_region_set(_pad, 0, jb[LDR_F_STGP], jb[LDR_F_STGL]);
  jb[LDR_F_STGP] = 0; jb[LDR_F_STGL] = 0; jb[LDR_F_STG] = 0;
  swing_alloc_unlock();
  swing_ldr_reset_target(jb, _pad, -1, #_ldr_stg_path);
  s_sr[_pad] = jb[LDR_F_SR];
  jb[LDR_F_BUF] = p_aptr[_pad]; jb[LDR_F_CAP] = p_alen[_pad];
);

// Window setup for the waveform-aware ADSR pass (the old analyze_adsr
// Window setup for the waveform-aware ADSR pass (the old analyze_adsr
// preamble). Which loads analyze: a pad-main load unless the user tuned the
// pad's ADSR (right-click on the overlay clears that flag); a layer-0 load
// onto a pad that had no layers.
function swing_ldr_adsr_setup(jb)
local(pad, layer, len, sr, tot, dur, wfr, wil, nw)
(
  pad = jb[LDR_F_PAD]; layer = jb[LDR_F_LAYER]; len = jb[LDR_F_LEN]; sr = jb[LDR_F_SR];
  jb[LDR_F_ADSR] = layer < 0 ? !p_adsr_user[pad] : (layer == 0 && jb[LDR_F_PREVCNT] == 0);
  jb[LDR_F_NWIN] = 0;
  jb[LDR_F_PHASE] = 4;
  jb[LDR_F_ADSR] ? (
    tot = (len / 2)|0;
    dur = tot / max(1, sr) * 1000.0;
    // Too short → percussive defaults at finish (no windows). Otherwise cover
    // the FULL sample in up to 200 windows: ~5 ms for short hits, ~25 ms at 5 s.
    !(tot < 128 || dur < 10) ? (
      wfr = max((sr * 0.005)|0, (tot / 200)|0);
      wil = wfr * 2;
      nw  = max(1, min(200, (len / wil)|0));
      jb[LDR_F_WFR] = wfr; jb[LDR_F_WIL] = wil; jb[LDR_F_NWIN] = nw; jb[LDR_F_W] = 0;
      jb[LDR_F_PKRMS] = 0.00001; jb[LDR_F_PKWIN] = 0;
      jb[LDR_F_PHASE] = 3;
    );
  );
);

// The old analyze_adsr result derivation, reading the job's RMS windows.
function swing_ldr_adsr_finish(jb)
local(pad, _rms_buf, _num_wins, _peak_rms, _peak_win, _win_ms, _dur_ms, _post_peak,
      _body_start, _body_end, _body_sum, _body_cnt, _body_avg, _sus,
      _dec_tgt, _dec_win, _dec_found, _rel_tgt, _rel_win, _w,
      _atk_ms, _dec_ms, _rel_ms, _is_percussive)
(
  pad = jb[LDR_F_PAD];
  _num_wins = jb[LDR_F_NWIN];
  _num_wins <= 0 ? (
    // Too short — percussive defaults, no analysis
    p_attack[pad]  = 0.1;
    p_decay[pad]   = 50;
    p_sustain[pad] = 1.0;  // drum sampler: one-shots play through at full amplitude
    p_release[pad] = 30;
    p_adsr_user[pad] = 0;  // analyzer owns these values
    swing_rcp_post_pad(pad);   // @block performs (A-9a): the loader runs on either thread
  ) : (
    _rms_buf  = jb + LDR_F_RMS;
    _peak_rms = jb[LDR_F_PKRMS];
    _peak_win = jb[LDR_F_PKWIN];
    _win_ms   = jb[LDR_F_WFR] / max(1, jb[LDR_F_SR]) * 1000.0;
    _dur_ms   = ((jb[LDR_F_LEN] / 2)|0) / max(1, jb[LDR_F_SR]) * 1000.0;
    _peak_rms < 0.0001 ? (
      // Edge case: silent buffer — conservative middle defaults
      p_attack[pad]  = 5;
      p_decay[pad]   = 500;
      p_sustain[pad] = 1.0;  // drum sampler: one-shots play through at full amplitude
      p_release[pad] = 300;
      p_adsr_user[pad] = 0;  // analyzer owns these values
      swing_rcp_post_pad(pad);   // @block performs (A-9a): the loader runs on either thread
    ) : (
      // ── Attack: time from start to peak window ────────────────
      _atk_ms = max(0.1, min(500.0, _peak_win * _win_ms));
      _post_peak = _num_wins - _peak_win - 1;

      // ── Sustain: body energy (middle 30-70%) vs peak ──────────
      // This is the "held" level — how loud the sound is during its body
      _body_start = _peak_win + 1 + max(1, (_post_peak * 0.3)|0);
      _body_end   = _peak_win + 1 + max(2, (_post_peak * 0.7)|0);
      _body_start = min(_body_start, _num_wins - 1);
      _body_end   = min(_body_end, _num_wins);
      _body_sum = 0; _body_cnt = 0;
      _w = _body_start;
      loop(_body_end - _body_start,
        _w < _num_wins ? ( _body_sum += _rms_buf[_w]; _body_cnt += 1; );
        _w += 1;
      );
      _body_avg = _body_cnt > 0 ? (_body_sum / _body_cnt) : 0;
      _sus      = max(0.0, min(1.0, _body_avg / _peak_rms));

      // ── Decay: peak → where RMS reaches the body/sustain level ─
      // Use sustain-relative target: find where sound settles to its body
      _dec_tgt   = _body_avg + (_peak_rms - _body_avg) * 0.15;  // 15% above body
      _dec_tgt   = max(_dec_tgt, _peak_rms * 0.10);  // floor: -20dB from peak
      _dec_win   = _num_wins - 1;
      _dec_found = 0;
      _w = _peak_win + 1;
      loop(_post_peak,
        !_dec_found && _w < _num_wins ? (
          _rms_buf[_w] <= _dec_tgt ? (
            _dec_win = _w; _dec_found = 1;
          );
        );
        _w += 1;
      );
      !_dec_found ? (
        // Sustained sound — decay = 80% of remaining duration
        _dec_ms = max(10.0, min(5000.0, _post_peak * _win_ms * 0.8));
      ) : (
        _dec_ms = max(1.0, min(5000.0, (_dec_win - _peak_win) * _win_ms));
      );

      // ── Release: scan from end backwards for last window > 5% peak ─
      _rel_tgt = _peak_rms * 0.05;
      _rel_win = _num_wins - 1;
      _w = _num_wins - 1;
      loop(_num_wins,
        _w >= 0 && _rms_buf[_w] >= _rel_tgt ? (
          _rel_win = _w;
          _w = -1;  // break
        );
        _w -= 1;
      );
      _rel_ms = max(5.0, min(2000.0, (_num_wins - 1 - _rel_win) * _win_ms));
      // Floor: 10% of duration up to 50ms — prevents click on voice kill
      _rel_ms = max(_rel_ms, min(50.0, _dur_ms * 0.1));

      // ── Write results ─────────────────────────────────────────
      p_attack[pad]  = _atk_ms;
      p_decay[pad]   = _dec_ms;
      // Sustain: percussive vs sustained heuristic.
      //   Percussive (kick/snare/hat): body-RMS/peak-RMS is near zero, which
      //   would clamp the post-decay tail to ~5% and gut the sample. So for
      //   short bursts or front-loaded transients we force S=1.0 (the sample
      //   plays through at full amplitude — sustain is meaningless when the
      //   audio is already over by the time decay finishes).
      //   Sustained (pads/loops/vocal hits): body has real energy; the
      //   computed _sus reflects the actual held level. Floor at 0.10 so
      //   even quiet sustained sources don't disappear.
      _is_percussive = _dur_ms < 250 || (_peak_win < _num_wins * 0.05 && _dur_ms < 1000);
      _is_percussive ? (
        p_sustain[pad] = 1.0;
      ) : (
        p_sustain[pad] = max(0.10, _sus);
      );
      p_release[pad] = _rel_ms;
      p_adsr_user[pad] = 0;  // analyzer owns these values
      swing_rcp_post_pad(pad);   // @block performs (A-9a): the loader runs on either thread
    );
  );
);

// Everything the old loaders did after the read: normalization gain from the
// folded-in peak, names, layer promotion / layer metadata, ADSR results,
// the retry + fail flags, the bridge's source generation, the undo bracket.
function swing_ldr_finish(jb)
local(pad, layer, lidx, len, gain, tpath, tname, last_p, i, char, _wl, _lp)
(
  pad = jb[LDR_F_PAD]; layer = jb[LDR_F_LAYER]; len = jb[LDR_F_LEN];
  // a STAGED load switches the pad over here, in this block (swing_ldr_stage_commit); everything below then
  // runs as for any load
  jb[LDR_F_STG] && !jb[LDR_F_REFUSED] ? swing_ldr_stage_commit(jb);
  jb[LDR_F_HANDLE] >= 0 ? ( file_close(jb[LDR_F_HANDLE]); jb[LDR_F_HANDLE] = -1; );
  // Step 2a: a refused load (no room, §5.4) touched nothing -- say so on the LCD and skip the
  // bookkeeping below (NCH is 0, so it does). The regions a load that went through displaced
  // are freed here, once the sliced capture has read everything it needs from them.
  jb[LDR_F_REFUSED] ? swing_alloc_refuse_note(pad);
  swing_disp_any(jb + LDR_F_DISP) ? ( udo_cow_drain(pad); swing_disp_free(jb + LDR_F_DISP); );
  jb[LDR_F_NCH] > 0 ? (
    gain = 1.0;
    jb[LDR_F_PEAK] > 0.000001 ? ( gain = min(1.0 / jb[LDR_F_PEAK], 100.0); );
    layer < 0 ? (
      s_len[pad] = len;
      s_norm_gain[pad] = gain;
      // Extract filename → name slot, then auto-name the pad from keywords
      tname = get_name_slot(pad);
      tpath = get_path_slot(pad);
      last_p = -1; i = 0;
      while((char = str_getchar(tpath, i)) > 0) (
        (char == 47 || char == 92) ? last_p = i; i += 1;
      );
      last_p >= 0 ? strcpy_from(tname, tpath, last_p + 1) : strcpy(tname, tpath);
      auto_name_from_file(pad);
      // A single-sample load is authoritative: the pad becomes a PLAIN pad
      // (p_layer_cnt = 0 — the whole slot is its sample) and every layer's
      // metadata is wiped, layer 0's included. The wipe is what fixes the
      // "load a new sample after a kit and it's quieter" bug: with the old
      // kit's l_len still nonzero, Sum-mode voice launch divided the gain by
      // sqrt(_active_cnt). Until 2026-09-08 this promoted the pad to ONE
      // layer instead, and a layer holds LAYER_SIZE, so every pad was silently
      // cut to 11.3 s (Spec_Swing_Long_Pad_Layer_Cap). Promotion now lives in
      // swing_pad_promote and runs only when a layer >= 1 receives audio.
      len > 0 ? (
        _wl = 0;
        loop(MAX_LAYERS,
          _lp = pad * MAX_LAYERS + _wl;
          l_len[_lp]       = 0;
          l_start[_lp]     = 0;
          l_end[_lp]       = 1.0;
          l_sr[_lp]        = 0;
          l_norm[_lp]      = 0;
          l_norm_gain[_lp] = 1.0;
          l_gain[_lp]      = 1.0;
          l_vel_lo[_lp]    = _wl / MAX_LAYERS;
          l_vel_hi[_lp]    = (_wl + 1) / MAX_LAYERS;
          l_rr_order[_lp]  = _wl;
          strcpy(LPATH_STR_BASE + _lp, "");
          // The new audio is original: every bake anchor goes (2026-10-02). CMD 63 and the kit import clear_pad()
          // first, which does it; a file dropped on a pad (load_from_path: rk_swing_ui_grid_pads / _overlay) and
          // the no-embed reload did not, so a Tuned pad kept its old mark -- the new sample played at residual 0,
          // unpitched, until a bake landed, and with CMD 66's plain-pad refusal its capture was refused for good
          // (Plan_Swing_Pad_Banks_Tuned §5A.7; EON_Probe_PitchA RL). Here with the wipe, not when the load starts:
          // until now a layered pad's old layers still play, under their marks, and a load that fails keeps them.
          sp_baked_tune[_lp] = 0;
          _wl += 1;
        );
        p_layer_cnt[pad]   = 0;
        p_layer_mode[pad]  = 3;  // Sum = the safe default once layers arrive
      );
    ) : (
      lidx = pad * MAX_LAYERS + layer;
      l_len[lidx] = len;
      l_norm_gain[lidx] = gain;
      l_start[lidx] = 0;
      l_end[lidx] = 1.0;
      // Update pad layer count
      p_layer_cnt[pad] < layer + 1 ? p_layer_cnt[pad] = layer + 1;
      // Auto-name pad from first layer's filename (layer 0 only)
      layer == 0 ? (
        tname = get_name_slot(pad);
        tpath = get_path_slot(pad);
        strcpy(tpath, LPATH_STR_BASE + lidx);
        last_p = -1; i = 0;
        while((char = str_getchar(tpath, i)) > 0) (
          (char == 47 || char == 92) ? last_p = i; i += 1;
        );
        last_p >= 0 ? strcpy_from(tname, tpath, last_p + 1) : strcpy(tname, tpath);
        auto_name_from_file(pad);
      );
    );
    // Trimmed at the cap (Spec_Swing_Pad_Banks §5.4): a longer file stopped being read at
    // LDR_F_CAP and landed exactly there (the streamed route's total is pre-clamped to the
    // same cap by the bridge). Say so once on the LCD; the pad face keeps the mark for as
    // long as the sample sits at the cap (pad_trimmed_secs). Until 2026-09-23 this was
    // silent -- no flag, no banner -- and the then 11 s layer cap read as a bug on ordinary loops
    // (layers hold 45 s since the same day; the mark now means the POOL or the pad cap).
    len > 0 && len >= jb[LDR_F_CAP] ? (
      pad_trim_warn_pad   = pad;
      pad_trim_warn_layer = layer;
      pad_trim_warn_sr    = jb[LDR_F_SR] > 0 ? jb[LDR_F_SR] : srate;
      pad_trim_warn_secs  = jb[LDR_F_CAP] / (2 * pad_trim_warn_sr);
      pad_trim_warn_until = time_precise() + 8;
    );
    jb[LDR_F_ADSR] ? swing_ldr_adsr_finish(jb);
    s_dirty[pad] = 1;  // rebuild the waveform cache
  );
  // A file that OPENS but yields no audio (file_riff nch=0 when the decoder
  // init loses the same transient AV/indexer race file_open can, or a read of
  // 0) is the same transient class as an open miss — flag it for the
  // kit-import loop's per-pad retry (2026-07-19, sibling of the f<0 retry).
  jb[LDR_F_OPENED] && len <= 0 && !jb[LDR_F_REFUSED] ? kit_pad_open_failed = 1;   // a refusal is not transient: no retry
  // Pad audio changed → bump the source generation so the Kit Bridge re-captures
  // this pad's bake/preload source for the Extension (stale-source guard).
  // Bumped at the END of the load so a capture never sees a partial buffer.
  sp_src_gen[pad] += 1;
  // P4 step 3: record the disk-load outcome (covers file_open failure AND
  // unsupported channel count — both leave the length 0 with the path retained).
  swing_pad_fail_recompute(pad);
  undo_cap_end();
  jb[LDR_F_PHASE] = 0;
);

// One bounded slice of work on a job. Returns 1 when the job is idle after the
// call (finished, failed, or nothing in flight), 0 while it is still running.
// `budget` is in cells and is also the loop ceiling of every loop below.
function swing_ldr_step(jb, budget)
local(ph, f, nch, tbuf, cap, pos, left, m, n, i, src, v, peak, wfr, wil, nw, w, fi, sum, rms, rmsbuf,
      zbase, zlim, pad, layer, need)
(
  ph = jb[LDR_F_PHASE];
  ph == 1 ? (
    f = jb[LDR_F_HANDLE]; nch = jb[LDR_F_NCH];
    tbuf = jb[LDR_F_BUF]; cap = jb[LDR_F_CAP]; pos = jb[LDR_F_POS];
    peak = jb[LDR_F_PEAK];
    left = cap - pos;
    n = 0;
    nch == 2 ? (
      m = min(budget, left);
      m > 0 ? ( n = file_mem(f, tbuf + pos, m); );
      n > 0 ? (
        i = 0;
        loop(n,
          v = abs(tbuf[pos + i]); v > peak ? peak = v;
          i += 1;
        );
      );
    ) : (
      // Mono: read m samples into the upper half of the destination window,
      // then expand L=R forward in place — every write lands at or below its
      // source cell, so nothing unread is overwritten.
      m = min((budget / 2)|0, (left / 2)|0);
      m > 0 ? ( n = file_mem(f, tbuf + pos + m, m); );
      n > 0 ? (
        src = tbuf + pos + m;
        i = 0;
        loop(n,
          v = src[i];
          tbuf[pos + 2 * i] = v; tbuf[pos + 2 * i + 1] = v;
          v = abs(v); v > peak ? peak = v;
          i += 1;
        );
        n = n * 2;
      );
    );
    jb[LDR_F_PEAK] = peak;
    pos += n;
    jb[LDR_F_POS] = pos;
    (n <= 0 || pos >= cap) ? (
      file_close(f); jb[LDR_F_HANDLE] = -1;
      jb[LDR_F_LEN] = pos; jb[LDR_F_ZPOS] = pos;
      jb[LDR_F_PHASE] = 2;
    );
    0;
  ) :
  ph == 2 ? (
    // Zero the unused tail of the slot / layer region. memset is native and
    // ~50x cheaper per cell than the read slice, so it gets 16x the budget:
    // a whole 4M-cell slot clears in ~4 blocks instead of ~60, which is what
    // keeps a one-shot drum hit feeling instant (measured 2026-09-07: 14 defer
    // ticks for a 0.25 s file at the plain budget).
    tbuf = jb[LDR_F_BUF]; cap = jb[LDR_F_CAP]; pos = jb[LDR_F_ZPOS];
    m = max(0, min(budget * 16, cap - pos));   // cap = the REGION's cells since step 2a (0 for the zero job)
    // Sliced-undo barrier (rk_drumkit_dsp udo_cow_upto): the tail this is about to
    // zero can still be the only copy of the pad's OLD audio when the capture was
    // sliced. It saves what we are about to destroy and hands back how far we may
    // go; a short answer means we zero less this block and pick the rest up next
    // block. A no-op for every load whose capture copied up front.
    zbase = jb[LDR_F_LAYER] < 0 ? 0 : jb[LDR_F_LAYER] * LAYER_SIZE;   // virtual-slot coordinates (rk_swing_alloc maps them)
    m > 0 ? (
      zlim = udo_cow_upto(jb[LDR_F_PAD], zbase + pos + m) - (zbase + pos);
      zlim < m ? m = max(zlim, 0);
      m > 0 ? memset(tbuf + pos, 0, m);
      pos += m;
      jb[LDR_F_ZPOS] = pos;
    );
    // Step 2a: the region is clean. A job that DISPLACED regions (a bigger file, a drop onto
    // a layered pad, the kit-empty zero job) now drains the sliced capture a budget per
    // block -- the writer's reach no longer covers the old audio, which lives in the
    // displaced regions until finish frees them -- and only then moves on. In place, the
    // zero tail above pumped the barrier exactly as before.
    // A STAGED load (2026-10-15) drains it here too, a budget per block: its commit at finish frees the old
    // regions the capture reads through, and an undrained capture would be finished there in ONE block.
    pos >= cap ? (
      ((swing_disp_any(jb + LDR_F_DISP) || jb[LDR_F_STG]) && udo_cow_pending(jb[LDR_F_PAD])) ?
        udo_cow_upto(jb[LDR_F_PAD], UDO_VSLOT) :
        swing_ldr_adsr_setup(jb);
    );
    0;
  ) :
  ph == 3 ? (
    // RMS windows (mono mix L+R / 2): as many as cover ~budget cells, min one
    tbuf = jb[LDR_F_BUF];
    wfr = jb[LDR_F_WFR]; wil = jb[LDR_F_WIL]; nw = jb[LDR_F_NWIN]; w = jb[LDR_F_W];
    rmsbuf = jb + LDR_F_RMS;
    m = max(1, (budget / max(1, wil))|0);
    m = min(m, nw - w);
    loop(m,
      sum = 0; fi = w * wil;
      loop(wfr,
        v = (tbuf[fi] + tbuf[fi + 1]) * 0.5;
        sum += v * v;
        fi += 2;
      );
      rms = sqrt(sum / max(1, wfr));
      rmsbuf[w] = rms;
      rms > jb[LDR_F_PKRMS] ? ( jb[LDR_F_PKRMS] = rms; jb[LDR_F_PKWIN] = w; );
      w += 1;
    );
    jb[LDR_F_W] = w;
    w >= nw ? jb[LDR_F_PHASE] = 4;
    0;
  ) :
  ph == 6 ? (
    // Waiting for room (step 2a): the compaction job is packing the area (alc_req). Re-fit when
    // it is done; a fit that fails for room again re-files the request, three times at most,
    // then the load is refused with the pad exactly as it was.
    alc_req ? 0 : (
      pad = jb[LDR_F_PAD]; layer = jb[LDR_F_LAYER]; f = jb[LDR_F_HANDLE]; nch = jb[LDR_F_NCH];
      need = jb[LDR_F_NEED];
      (layer < 0 ? swing_pad_fit_main(pad, need, jb + LDR_F_DISP)
                 : swing_pad_fit_layer(pad, layer, need, jb + LDR_F_DISP)) ? (
        swing_ldr_accept(jb, pad, layer, jb == ldr_job0 ? #_ldr_wpath0 : #_ldr_wpath1, f, nch, jb[LDR_F_SR]);
      ) : (alc_wait && jb[LDR_F_WAITN] < 3) ? (
        jb[LDR_F_WAITN] += 1; alc_req = 1;
      ) : (
        f >= 0 ? file_close(f);
        jb[LDR_F_HANDLE] = -1;
        jb[LDR_F_REFUSED] = 1;
        jb[LDR_F_PHASE] = 4;
      );
      0;
    );
  ) :
  ph == 5 ? 0 :   // fed by the EON_PADPCM stream (rk_swing_padpcm); its LAST chunk hands the job to phase 2
  ph == 4 ? (
    swing_ldr_finish(jb);
    1;
  ) : 1;
);

// @block entry points: begin the job on first sight of (pad, layer), then pump
// one ldr_budget slice. Return 1 once the load has landed (or failed) so the
// caller can move on, 0 while it should hold its place and call again next
// block with the same arguments.
function swing_ldr_step_pad(pad, path_str) (
  (ldr_job0[LDR_F_PHASE] == 0 || ldr_job0[LDR_F_PAD] != pad || ldr_job0[LDR_F_LAYER] != -1) ?
    swing_ldr_begin(ldr_job0, pad, -1, path_str);
  swing_ldr_step(ldr_job0, ldr_budget);
);
function swing_ldr_step_layer(pad, layer, path_str) (
  (ldr_job0[LDR_F_PHASE] == 0 || ldr_job0[LDR_F_PAD] != pad || ldr_job0[LDR_F_LAYER] != layer) ?
    swing_ldr_begin(ldr_job0, pad, layer, path_str);
  swing_ldr_step(ldr_job0, ldr_budget);
);

// ─── A pad the new kit leaves EMPTY (Phase 4, A O-2, 2026-09-15) ─────────────
// clear_pad's four 8 MB layer memsets ran on the audio thread for every kit-empty pad
// of a VER-201 import: measured 2026-09-15 (EON_Probe_LdrStress, LdrSlice kit, 512
// samples at 48 kHz) as thirteen 20 ms blocks against a 10.7 ms period -- one overrun
// per empty pad. This runs the SAME clear_pad, minus the memsets (_clr_skip_audio, the
// stream drop's pattern), and hands the slot to the loader's phase 2, which zeroes it
// a bounded slice per block behind the sliced-undo barrier. The job has no file and no
// audio: phase 2 -> 3 (no windows: len 0) -> 4, and finish() does the pad's bookkeeping
// (source generation, fail bit, the undo bracket this opened). Inside an import the
// capture depth is held, so nothing is captured; outside one the lazy capture saves a
// slice ahead of the zeroing exactly as a drop does.
function swing_ldr_begin_zero(jb, pad) local(_zr) (
  jb[LDR_F_PHASE] > 0 ? swing_ldr_abort(jb);   // a new job always wins
  jb[LDR_F_PAD] = pad; jb[LDR_F_LAYER] = -1;
  jb[LDR_F_HANDLE] = -1; jb[LDR_F_NCH] = 0; jb[LDR_F_SR] = 0;
  jb[LDR_F_POS] = 0; jb[LDR_F_PEAK] = 0.00001; jb[LDR_F_ZPOS] = 0; jb[LDR_F_LEN] = 0;
  jb[LDR_F_OPENED] = 0; jb[LDR_F_ADSR] = 0; jb[LDR_F_PREVCNT] = 0; jb[LDR_F_NWIN] = 0;
  _udo_cap_lazy_req = 1;
  undo_begin_pad(pad);          // closed by swing_ldr_finish
  _udo_cap_lazy_req = 0;
  _clr_skip_audio = 1;
  clear_pad(pad);               // nested: raises the depth, captures nothing new
  _clr_skip_audio = 0;
  // Step 2a: every region the pad had is displaced -- kept live for the sliced capture, freed
  // by finish -- and the job has no region of its own: phase 2 only drains the capture.
  jb[LDR_F_REFUSED] = 0;
  swing_disp_clear(jb + LDR_F_DISP);
  _zr = 0; loop(MAX_LAYERS + 1,
    swing_region_len(pad, _zr) > 0 ?
      swing_disp_push_(jb + LDR_F_DISP, _zr, swing_region_ptr(pad, _zr), swing_region_len(pad, _zr));
    swing_region_set(pad, _zr, -1, 0);
    _zr += 1;
  );
  jb[LDR_F_BUF] = -1;
  jb[LDR_F_CAP] = 0;
  jb[LDR_F_PHASE] = 2;
);
// @block entry point, the swing_ldr_step_pad shape: begin on first sight of the pad,
// then pump one slice; 1 once the slot is clean, 0 while the caller must hold its place.
function swing_ldr_zero_pad(pad) (
  (ldr_job0[LDR_F_PHASE] == 0 || ldr_job0[LDR_F_PAD] != pad || ldr_job0[LDR_F_LAYER] != -1) ?
    swing_ldr_begin_zero(ldr_job0, pad);
  swing_ldr_step(ldr_job0, ldr_budget);
);

// Run a job to completion in one call (UI-side callers and the legacy VER-200
// import). Each step stays under the loop cap; a full slot takes ~8 steps.
function swing_ldr_run(jb, pad, layer, path_str) local(_t0) (
  swing_ldr_begin(jb, pad, layer, path_str);
  _t0 = time_precise();
  while (swing_ldr_step(jb, LDR_BUDGET_MAX) == 0) (
    // A job waiting for room (phase 6) on this synchronous lane packs the area itself -- the
    // same locked tick @block takes -- for a second at most; then the re-fit refuses.
    jb[LDR_F_PHASE] == 6 ? (
      swing_alloc_compact_tick();
      time_precise() - _t0 > 1.0 ? ( alc_req = 0; jb[LDR_F_WAITN] = 3; );
    );
  );
);

// ─── A load the Kit Bridge could not take (2026-09-10, plan Phase B) ──────
// Told on the LCD for 4 s (rk_swing_ui_state rung 1f). kind 1: a bridge is
// running but predates this JSFX -- every ReaPack sync produces this until
// REAPER restarts -- so the load was REFUSED and the pad left exactly as it was,
// because a restart fixes it and a file read on the audio thread does not.
// kind 0: no bridge at all (a fresh install, or it died) -- Swing read the file
// itself, the way it always could, and says so. Lives here rather than in
// rk_swing_padpcm because rk_swing_browser_load is imported before that file
// and EEL2 binds function names in file order.
// kind 2 (2026-10-16): a project or undo chunk held a saved sample length the read refused (_ser_bad, @serialize),
// so that pad came back EMPTY; 8 s, named by count -- the flag had been set since 2026-07 and never shown.
function swing_ldr_bridge_notice(kind) (
  kind == 2 ? (
    sprintf(#_ld_notice_t, "%d saved sample%s not restored", _ser_bad | 0, (_ser_bad | 0) == 1 ? "" : "s");
    strcpy(#_ld_notice_s, "A saved length was corrupt -- the pad is empty, reload it");
  ) : kind ? (
    strcpy(#_ld_notice_t, "Sample not loaded");
    strcpy(#_ld_notice_s, "Kit Bridge is out of date -- restart REAPER");
  ) : (
    strcpy(#_ld_notice_t, "Loaded without the Kit Bridge");
    strcpy(#_ld_notice_s, "It isn't running -- run Swing_Kit_Bridge from the Action List");
  );
  _ld_notice_until = time_precise() + (kind == 2 ? 8 : 4);
);

// ─── Sample loader (synchronous wrappers on the UI-side job lane) ─────────
function load_from_path(idx, path_str) (
  idx >= 0 && idx < NUM_SLOTS ? swing_ldr_run(ldr_job1, idx, -1, path_str);
);

// Set a pad's layer playback mode (0=single 1=vel-split 2=round-robin 3=sum).
// Mirrors the layer-mode popup in rk_swing_ui_grid_overlay.jsfx-inc: resets the
// RR cursor and — for vel-split — auto-assigns even velocity ranges when the
// layers still have default 0-1 ranges. A mode change never promotes a plain
// pad: it has nothing to sum or split yet, and promoting a pad longer than a
// layer would cut it (swing_pad_promote runs when a layer >= 1 lands).
// Self-contained (no GUI dependency) so the RS5k importer can drive it over
// the INCMD_LMODE channel after stacking layers via CMD 64.
function swing_layer_set_mode(pad_idx, mode)
local(_all_default, _ncnt, _base, _li)
(
  pad_idx >= 0 && pad_idx < NUM_SLOTS ? (
    p_layer_mode[pad_idx] = max(0, min(3, mode));
    p_rr_idx[pad_idx] = 0;
    // Even vel-split ranges when entering Vel-Split, only if every layer still
    // has the default 0-1 range (don't stomp user/preset edits).
    mode == 1 && p_layer_cnt[pad_idx] > 1 ? (
      _all_default = 1; _ncnt = p_layer_cnt[pad_idx];
      _li = 0; loop(_ncnt,
        _base = pad_idx * MAX_LAYERS + _li;
        (l_vel_lo[_base] > 0.001 || l_vel_hi[_base] < 0.999) ? _all_default = 0;
        _li += 1;
      );
      _all_default ? (
        _li = 0; loop(_ncnt,
          _base = pad_idx * MAX_LAYERS + _li;
          l_vel_lo[_base] = _li / _ncnt;
          l_vel_hi[_base] = (_li + 1) / _ncnt;
          _li += 1;
        );
      );
    );
  );
);

function load_layer_from_path(pad_idx, layer_idx, path_str) (
  pad_idx >= 0 && pad_idx < NUM_SLOTS && layer_idx >= 0 && layer_idx < MAX_LAYERS ?
    swing_ldr_run(ldr_job1, pad_idx, layer_idx, path_str);
);

// ─── Waveform cache builder ─────────────────────────────────────────────
function build_wv_cache(idx) local(buf, step, i, _wi, val, si, ptr, ptr_R, _wlen, _wsg, _lidx, _wli, _stereo_found, _louder, _quieter, _cum_diff, _cum_signal, _vL, _vR, _eL, _eR, _ovl, _ov_lidx, _ov_llen, _ov_dst, _ov_dstR, _ov_buf, _ov_step, _ovi, _ov_si, _ov_sg) (
  // Cache stores raw waveform shape only. User mix knobs (p_gain, l_gain)
  // are NOT applied — they're shown by their own knobs and would push the
  // wave outside the pad bounds. ADSR is NOT applied — the FX overlay
  // draws it as a separate curve. The only multiplier is normalize gain,
  // which describes the sample's intrinsic loudness so quiet samples still
  // fill the pad.
  p_layer_cnt[idx] > 0 ? (
    _wli = 0;
    while(_wli < p_layer_cnt[idx] && l_len[idx * MAX_LAYERS + _wli] <= 0) ( _wli += 1; );
    _wli >= p_layer_cnt[idx] ? _wli = 0; // fallback to 0 if all empty
    _lidx = idx * MAX_LAYERS + _wli;
    _wlen = l_len[_lidx];
    buf = p_lptr[idx * MAX_LAYERS + _wli];
    _wsg = l_norm[_lidx] ? l_norm_gain[_lidx] : 1.0;
  ) : (
    _wlen = s_len[idx];
    buf = p_aptr[idx];
    _wsg = s_norm[idx] ? s_norm_gain[idx] : 1.0;
  );
  _wlen > 0 ? (
    ptr   = wv_cache   + idx * WV_RES;
    ptr_R = wv_cache_R + idx * WV_RES;
    step = (_wlen / 2) / WV_RES;
    // Stereo detection — two checks must both pass for stereo render:
    //
    //   1. Relative L/R difference: cumulative |L-R| > 10% of total
    //      louder-channel signal. Catches the "kick stored as stereo
    //      with L≈R" case — old per-sample EPS=1e-5 fired on noise
    //      floor and rendered two near-identical halves that visually
    //      merged into one waveform wrapping around. Mirror of the
    //      browser-side check in Swing_Browser.lua generate_peaks().
    //
    //   2. Channel-balance: quieter channel >= 30% (≈ -10.5 dB) of
    //      louder. Catches "bass file with one silent channel" — would
    //      render with half flat, looks broken. Force mono in that case
    //      so the louder channel fills the pad.
    _cum_diff = 0; _cum_signal = 0;
    _eL = 0; _eR = 0;  // per-channel cumulative |amp| (energy proxy)
    i = 0; loop(WV_RES,
      _wi = p_reverse[idx] ? (WV_RES - 1 - i) : i;
      si = ((_wi * step)|0) * 2;
      _vL = buf[si];
      _vR = buf[si + 1];
      ptr  [i] = _vL * _wsg;
      ptr_R[i] = _vR * _wsg;
      _eL += abs(_vL);
      _eR += abs(_vR);
      _cum_diff   += abs(_vL - _vR);
      _cum_signal += max(abs(_vL), abs(_vR));
      i += 1;
    );
    _stereo_found = _cum_signal > 0.001 && (_cum_diff / _cum_signal) >= 0.10;
    // Channel-balance check by ENERGY (not peak). Peak-based missed
    // kicks where R had occasional loud spikes (passing 30% peak)
    // but was mostly silent (low RMS). Energy = cumulative |amp| ≈
    // area under the curve, mirrors what the user perceives as
    // "this channel carries content". 30% energy threshold matches
    // the browser preview's check in Swing_Browser.lua generate_peaks().
    _louder  = max(_eL, _eR);
    _quieter = min(_eL, _eR);
    // 30% (≈ -10.5 dB) — matches browser preview's calibrated value.
    p_stereo[idx] = _stereo_found && (_louder < 0.001 || (_quieter / _louder) >= 0.30);

    // ── Per-(pad,layer) frozen cache for the pad-detail overlay ──────────────
    // Built here (on load / s_dirty) so the overlay's overview shows the ORIGINAL
    // sample even after a Tuned bake overwrites the layer buffer with pitched
    // audio. Normalized (per-layer norm gain) to match wv_cache. Empty layers
    // are zeroed. Forward order; the overlay flips for reverse on read.
    _ovl = 0;
    loop(MAX_LAYERS,
      _ov_lidx = idx * MAX_LAYERS + _ovl;
      // GATE: rebuild this layer's frozen overlay waveform ONLY while it is still
      // original (sp_baked_tune==0) or has never been captured (ov_cap==0, the
      // reload fallback). Once baked, KEEP the frozen original so a later s_dirty
      // (offset / ADSR / gain knob) can't re-snapshot the pitched buffer and move
      // the displayed waveform. Re-armed (ov_cap=0) on layer load/clear.
      (sp_baked_tune[_ov_lidx] == 0 || ov_cap[_ov_lidx] == 0) ? (
        _ov_dst  = ov_wv_cache   + _ov_lidx * WV_RES;
        _ov_dstR = ov_wv_cache_R + _ov_lidx * WV_RES;
        _ov_llen = l_len[_ov_lidx];
        _ov_llen > 0 ? (
          _ov_buf  = p_lptr[idx * MAX_LAYERS + _ovl];
          _ov_sg   = l_norm[_ov_lidx] ? l_norm_gain[_ov_lidx] : 1.0;
          _ov_step = (_ov_llen / 2) / WV_RES;
          _ovi = 0;
          loop(WV_RES,
            _ov_si = ((_ovi * _ov_step)|0) * 2;
            _ov_dst[_ovi]  = _ov_buf[_ov_si]     * _ov_sg;
            _ov_dstR[_ovi] = _ov_buf[_ov_si + 1] * _ov_sg;
            _ovi += 1;
          );
        ) : (
          memset(_ov_dst,  0, WV_RES);
          memset(_ov_dstR, 0, WV_RES);
        );
        ov_cap[_ov_lidx] = 1;   // captured — freeze until re-armed on load/clear
      );
      _ovl += 1;
    );

    s_dirty[idx] = 0;
  );
);

// ─── Steal-fade park (A-2) ───────────────────────────────────────────────
// A stolen voice is not cut: its state moves into one of the STEAL_FADES slots past
// ─── The voice's block constants (phase V, Spec_Swing_Seq_View §16, 2026-10-14) ─────
// What the @sample voice loop used to resolve from the pad and layer tables every sample:
// the buffer pointer, the interleaved start / end positions (trim), and whether the voice
// sums into its pad's accumulator (the Stretch gate: a local voice on a Stretch pad defers
// to the Extension's ring unless it is the fallback that played because the Extension was
// unreachable). Set at launch (both kinds), when a stolen voice is parked in a fade slot,
// and for every live voice at the top of @block's voice pass -- so a trim drag, a bake that
// changes a length, or a mode flip reaches a sounding voice within a block (it used to
// within a sample; the writers run in @block and @gfx, never between two samples). The
// formulas are the loop's old ones, unchanged, so the null rig renders the same bytes.
// ONE place for them: the loop reads v_* only. SYN voices carry no buffer and always sum.
function swing_voice_prep(_vp_vi) local(_vp_si, _vp_lidx) (
  _vp_si = v_slot[_vp_vi];
  v_kind[_vp_vi] ? (
    v_bptr[_vp_vi] = 0; v_astart[_vp_vi] = 0; v_aend[_vp_vi] = 0;
    v_sum[_vp_vi] = 1;
  ) : (
    p_layer_cnt[_vp_si] > 0 ? (
      _vp_lidx = _vp_si * MAX_LAYERS + v_layer[_vp_vi];
      v_bptr[_vp_vi]   = p_lptr[_vp_lidx];
      v_astart[_vp_vi] = l_start[_vp_lidx] * l_len[_vp_lidx];
      v_aend[_vp_vi]   = (l_end[_vp_lidx] * l_len[_vp_lidx]) - SILENCE_T;
    ) : (
      v_bptr[_vp_vi]   = p_aptr[_vp_si];
      v_astart[_vp_vi] = s_start[_vp_si] * s_len[_vp_si];
      v_aend[_vp_vi]   = (s_end[_vp_si] * s_len[_vp_si]) - SILENCE_T;
    );
    // a fallback voice must be summed (v_stfb); otherwise a pad defers to its Stretch ring only while it plays Stretch,
