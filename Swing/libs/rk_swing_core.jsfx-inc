// rk_swing_core.jsfx-inc
// Swing core utility functions: name/path slots, sample loading, voice launch
// (c) EON Studios — All Rights Reserved

@init

// ─── Undo dirty markers ──────────────────────────────────────────────────
// REAPER captures the FX chunk for undo only when a slider VALUE actually
// changes, and coalesces rapid changes to the SAME slider into one undo
// entry. Tukan/Saike give every parameter its own slider so cross-action
// changes never coalesce.
//
// Swing keeps per-pad state in freemem arrays (not sliders), so we use
// counter sliders as proxies:
//   slider3        → global / master changes (mark_dirty())
//   slider6..21    → per-pad changes (mark_dirty_pad(idx))
//
// "Mute pad 1, solo pad 3, raise pad 12 vol" → slider6, slider8, slider17
// → 3 separate undo entries even when fast (different sliders never
// coalesce). Within a single pad, fast changes still coalesce (a knob
// drag = 1 entry, not 60), which is the desired DAW UX.
//
// Defined at the top of rk_swing_core.jsfx-inc so it's available to all
// libs imported after this one (which is everything else under libs/).
function mark_dirty() (
  // Phase 1B: signal project-dirty to the bridge instead of slider_automate,
  // so Swing changes no longer mint REAPER global-undo points (global Ctrl+Z
  // can't restore a stale Swing chunk). Save still works via @serialize. The
  // hidden counter sliders are left untouched (no @slider logic depends on
  // them — recalc is done by the per-pad callers directly).
  gmem[GS_PROJ_DIRTY] = 1;
);

// Kit-scoped dirty: mark_dirty PLUS the unsaved-kit dot. For edits to state
// the KIT FILE persists that isn't pad-indexed — the 42 KIT_GLOBAL_KEYS
// (master EQ/delay/reverb/comp, repeat_div, vel_curve, note_map, multi_out,
// oneshot_global, sat_drv) and kit-content bulk ops (New Kit, reset colors,
// MIDI-learn, no-bridge swap). Before this, ONLY pad edits lit the dot —
// change the kit's whole feel and it stayed dark. ⛔Do NOT use for prefs the
// kit file does not save (midi_thru, tooltips, embed_mode, adsr_3node,
// pad_icon_mode, knob styles, map_override_locked, gfx_drv_mode): a display
// toggle showing "unsaved kit changes" teaches users to ignore the dot.
// Same !kit_busy guard as mark_dirty_pad — a kit import's edit storm is not
// a user modification.
function mark_dirty_kit() (
  mark_dirty();
  // TEMP DIAGNOSTIC (project-open false dirty, 2026-08-05; site tags added
  // 2026-08-11): record the first setter. _kd_src 1+pad = pad-scoped (see
  // mark_dirty_pad); 1000 = kit-scoped from a GESTURE site; 1002..1007 =
  // kit-scoped from an AUTO-capable site (the caller stamps _kd_site just
  // before calling): 1002=clear_pad 1003=pad-swap 1004=new-kit/companion-4
  // 1005=companion-5 multi-out adopt (RETIRED 2026-08-11 — the adopt no
  // longer marks dirty at all; a 1005 sighting means a stale JSFX build)
  // 1006=multiout_prep 1007=syn-newkit.
  (!kit_busy && kit_dirty == 0) ? ( _kd_src = 1000 + _kd_site; _kd_t = time_precise(); );
  !kit_busy ? kit_dirty = 1;
  _kd_site = 0;   // tag is consume-once; untagged (gesture) sites read 0
);

// Returns 1 if MAP-preset application may write pad i's note, 0 if it must
// be skipped. Normally a manually-set (locked) pad is skipped; the
// map_override_locked option (slider23, MAP right-click menu) makes presets
// override locked pads too. Scope is MAP-apply ONLY — the lock still guards
// recalc_pad/root_note (rk_drumkit_dsp). map_override_locked persists in the
// FX chunk (no @serialize touch).
function swing_map_unlocked(i) (
  map_override_locked || !p_note_lock[i];
);

// Per-pad dirty marker. pad_idx is 0-based; routes to slider(6 + pad_idx)
// — slider6 = pad 1, slider21 = pad 16. Out-of-range falls through to
// the global slider3 so accidental mis-callers don't crash.
function mark_dirty_pad(pad_idx)
local(_sn)
(
  pad_idx >= 0 && pad_idx < NUM_PADS ? (
    // Phase 1B: project-dirty signal, NOT slider_automate — no REAPER undo point.
    gmem[GS_PROJ_DIRTY] = 1;
    // Kit-level dirty (drives the SAVE button's unsaved-changes dot). Every
    // pad mutation funnels through here, so this is the one honest hook.
    // !kit_busy excludes the mark_dirty_pad storm a kit IMPORT produces —
    // a kit is not "modified" the instant it finishes loading. Cleared on
    // save completion (bridge CMD 99 reply) and at import state-4 completion.
    // Deliberately NOT initialised in @init: a sample-rate change re-runs
    // @init, and zeroing there would silently forget unsaved edits.
    (!kit_busy && kit_dirty == 0) ? ( _kd_src = 1 + pad_idx; _kd_t = time_precise(); _kd_n = 0; );
    !kit_busy ? ( kit_dirty = 1; _kd_n += 1; );
    // Internal PARAM undo: flag this pad as edited in the current gesture so
    // the mouse-UP commit pushes one undo entry for it. Suppressed while the
    // undo engine itself is restoring (_udo_applying) to avoid self-capture.
    // The `_udo_pend &&` guard skips any pre-@init-allocation call (base 0).
    // _udo_cap_depth==0 guard: don't let a STRUCTURAL op (clear/load/swap/kit)
    // also queue a param-undo entry — otherwise undo_do would do a param undo
    // (no audio) instead of the structural restore, and the pad wouldn't come back.
    _udo_pend && !_udo_applying && _udo_cap_depth == 0 ? ( _udo_pend[pad_idx] = 1; );
  ) : (
    mark_dirty();
  );
);

// ─── Name / path string arrays ───────────────────────────────────────────
function get_name_slot(idx) (
  idx==0?#pn0:idx==1?#pn1:idx==2?#pn2:idx==3?#pn3:
  idx==4?#pn4:idx==5?#pn5:idx==6?#pn6:idx==7?#pn7:
  idx==8?#pn8:idx==9?#pn9:idx==10?#pn10:idx==11?#pn11:
  idx==12?#pn12:idx==13?#pn13:idx==14?#pn14:#pn15;
);
function get_path_slot(idx) (
  idx==0?#pp0:idx==1?#pp1:idx==2?#pp2:idx==3?#pp3:
  idx==4?#pp4:idx==5?#pp5:idx==6?#pp6:idx==7?#pp7:
  idx==8?#pp8:idx==9?#pp9:idx==10?#pp10:idx==11?#pp11:
  idx==12?#pp12:idx==13?#pp13:idx==14?#pp14:#pp15;
);
function get_cname_slot(idx) (
  idx==0?#cn0:idx==1?#cn1:idx==2?#cn2:idx==3?#cn3:
  idx==4?#cn4:idx==5?#cn5:idx==6?#cn6:idx==7?#cn7:
  idx==8?#cn8:idx==9?#cn9:idx==10?#cn10:idx==11?#cn11:
  idx==12?#cn12:idx==13?#cn13:idx==14?#cn14:#cn15;
);

// ─── Shared pad swap (audio + metadata + name/path + layer paths) ─────────
// Bridge-aware: when the bridge is idle, posts a named "Swap pads" undo (the
// swap then runs in swing_ui_process_undo when the bridge acks, _undo_pending
// == 5); otherwise swaps inline and relies on mark_dirty's chunk-diff undo.
// Shared by the pad grid drag-swap and the Mapping view's opt-in swap.
function swing_do_pad_swap(a, b) local(li, sa, sb) (
  a >= 0 && b >= 0 && a != b ? (
    gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 && gmem[KIT_GMEM_CMD] == 0 ? (
      gmem[KIT_GMEM_UNDO_DESC] = 5; gmem[KIT_GMEM_CMD] = 46;
      _undo_pending = 5; _undo_pad = a; _undo_pad2 = b;
    ) : (
      swap_pads(a, b);
      strcpy(#_swap_nm, get_cname_slot(a)); strcpy(get_cname_slot(a), get_cname_slot(b)); strcpy(get_cname_slot(b), #_swap_nm);
      strcpy(#_swap_nm, get_name_slot(a));  strcpy(get_name_slot(a),  get_name_slot(b));  strcpy(get_name_slot(b),  #_swap_nm);
      strcpy(#_swap_nm, get_path_slot(a));  strcpy(get_path_slot(a),  get_path_slot(b));  strcpy(get_path_slot(b),  #_swap_nm);
      li = 0; loop(MAX_LAYERS,
        sa = LPATH_STR_BASE + a * MAX_LAYERS + li;
        sb = LPATH_STR_BASE + b * MAX_LAYERS + li;
        strcpy(#_swap_nm, sa); strcpy(sa, sb); strcpy(sb, #_swap_nm);
        li += 1;
      );
      _kd_site = 3; mark_dirty_kit();
    );
  );
);

// ─── Command-undo: per-pad name/path backup ──────────────────────────────
// The structural undo engine (rk_drumkit_dsp, imported EARLIER) can't call
// get_*_slot, so the visible name/path strings are backed up / restored HERE
// (in core, where those slot helpers exist) into the udo_s2_name char buffer:
//   [0..31] cname (gamelayer label)  [32..63] name  [64..335] path
//   [336 + li*272 .. +271] layer li path (P3: LPATH strings were NOT backed
//   up before — a structural undo left stale layer paths behind, which then
//   re-serialized via the ser_ver>=11 block. The swap path always swapped
//   them correctly; only this non-swap path was affected.)
function undo_pad_names_save(pad) local(h, i, n, d, li) (
  h = get_cname_slot(pad); d = udo_s2_name;
  n = min(strlen(h), 31);  i = 0; loop(n, d[i] = str_getchar(h, i); i += 1;); d[n] = 0;
  h = get_name_slot(pad);  d = udo_s2_name + 32;
  n = min(strlen(h), 31);  i = 0; loop(n, d[i] = str_getchar(h, i); i += 1;); d[n] = 0;
  h = get_path_slot(pad);  d = udo_s2_name + 64;
  n = min(strlen(h), 271); i = 0; loop(n, d[i] = str_getchar(h, i); i += 1;); d[n] = 0;
  li = 0; loop(MAX_LAYERS,
    h = LPATH_STR_BASE + pad * MAX_LAYERS + li;
    d = udo_s2_name + 336 + li * 272;
    n = min(strlen(h), 271); i = 0; loop(n, d[i] = str_getchar(h, i); i += 1;); d[n] = 0;
    li += 1;
  );
);
function undo_pad_names_restore(pad) local(h, i, c, d, li) (
  h = get_cname_slot(pad); d = udo_s2_name;
  strcpy(h, ""); i = 0; c = d[0]; while(c != 0 && i < 31)  ( str_setchar(h, i, c); i += 1; c = d[i]; );
  h = get_name_slot(pad);  d = udo_s2_name + 32;
  strcpy(h, ""); i = 0; c = d[0]; while(c != 0 && i < 31)  ( str_setchar(h, i, c); i += 1; c = d[i]; );
  h = get_path_slot(pad);  d = udo_s2_name + 64;
  strcpy(h, ""); i = 0; c = d[0]; while(c != 0 && i < 271) ( str_setchar(h, i, c); i += 1; c = d[i]; );
  li = 0; loop(MAX_LAYERS,
    h = LPATH_STR_BASE + pad * MAX_LAYERS + li;
    d = udo_s2_name + 336 + li * 272;
    strcpy(h, ""); i = 0; c = d[0]; while(c != 0 && i < 271) ( str_setchar(h, i, c); i += 1; c = d[i]; );
    li += 1;
  );
);

// Core wrapper for a per-pad structural op: record the audio+metadata backup
// (engine) AND, when this is the outermost op (depth just went to 1), back up
// this pad's names too. Call this instead of udo_struct_begin_pad from core.
function undo_begin_pad(pad) (
  udo_struct_begin_pad(pad);
  (_udo_cap_depth == 1 && udo_s2_type == 1) ? undo_pad_names_save(pad);
);

// (Kit-level undo needs no name backup here: it reloads the temp .swing the
// bridge dumped before the op, which carries names/paths/audio itself.)

// ─── Multi-instance browser routing ─────────────────────────────────────
// Returns 1 when this JSFX instance is the one the browser is currently
// bound to (or no browser is active). Use as a guard before:
//   - processing CMD 63/64 sample loads from the browser
//   - writing browser-sync gmem fields (window size, kit name, etc.)
//   - consuming GS_PAD_SELECT_REQ
// Without this, a second Swing instance would respond to the first
// instance's browser commands and overwrite shared gmem state.
//
// Browser publishes the active instance ID into KIT_GMEM_INSTANCE on
// session start, on instance picker selection, and clears it on close.
// 0 means "no specific instance / single-instance mode" — any JSFX may act.
function _is_browser_target() (
  // Strict: only true when the user has explicitly picked this instance.
  // The earlier permissive form (also true on INSTANCE==0) caused every
  // Swing in the project to race-write the same gmem slots, which made
  // the browser pad grid + names flicker / blank out unpredictably.
  // Now: no pick = no writes. The browser auto-picks the first alive
  // instance on open, so single-instance workflows still "just work".
  gmem[KIT_GMEM_INSTANCE] == instance_id;
);

// ─── Kit-import format detection ─────────────────────────────────────────
// Returns 1 if the path ends in .sfz (case-insensitive) — the only kit
// format Swing imports. Hands the file off to the Lua bridge's import
// pipeline (parse_sfz in Swing_Browser.lua).
function _is_kit_import_ext(p) local(_pl, _i, _ch) (
  _pl = strlen(p);
  _pl < 4 ? 0 : (
    strcpy(#_kie_tmp, p);
    _i = 0; loop(_pl,
      _ch = str_getchar(#_kie_tmp, _i);
      _ch >= 65 && _ch <= 90 ? str_setchar(#_kie_tmp, _i, _ch + 32);
      _i += 1;
    );
    match("*.sfz", #_kie_tmp);
  );
);

// Hand a kit-import file path to the Lua bridge by writing it to the
// shared GS_BROWSER_PATH region (same protocol the browser uses for sample
// loads, just JSFX→bridge instead of bridge→JSFX). Bridge picks up CMD 18,
// stores the path in ExtState, and opens the browser which runs import_start.
// Caller must check bridge alive + CMD idle before calling.
function _send_kit_import_to_bridge(p) local(_pl, _ci) (
  _pl = strlen(p);
  _pl > 0 && _pl < GS_BROWSER_PATH_MAX ? (
    _ci = 0; loop(_pl,
      gmem[GS_BROWSER_PATH + _ci] = str_getchar(p, _ci);
      _ci += 1;
    );
    gmem[GS_BROWSER_PATH_LEN] = _pl;
    gmem[KIT_GMEM_CMD] = 18;
  );
);

// ─── Auto-name pad from filename keywords (Sitala-style) ─────────────────
// Is this filename one the project's own SAMPLE STORE wrote? The store
// extracts a pad's audio next to the project as pad<NN>_lay<N>.wav (and
// pad<NN>_g<N>_<base>.wav for bakes) — positional storage names, never
// anything a user would want on a pad. Matches the shape only: "pad", digits,
// "_", then 'l' or 'g'.
function eon_name_is_store_file(_s)
local(_c)
(
  // EXACTLY two digits, which is what %02d writes -- one digit would also match
  // a user's "pad1_left.wav" and quietly stop naming that pad.
  str_getchar(_s, 0) == 112 && str_getchar(_s, 1) == 97 &&
  str_getchar(_s, 2) == 100 &&                                   // p a d
  (_c = str_getchar(_s, 3)) >= 48 && _c <= 57 &&
  (_c = str_getchar(_s, 4)) >= 48 && _c <= 57 &&
  str_getchar(_s, 5) == 95 ? (                                   // NN then '_'
    // "lay" (a stored layer) or "g" (a bake generation)
    (str_getchar(_s, 6) == 108 && str_getchar(_s, 7) == 97 &&
     str_getchar(_s, 8) == 121) || str_getchar(_s, 6) == 103 ? 1 : 0;
  ) : 0;
);

function auto_name_from_file(pad_idx)
local(_fn, _cn, _i, _ch, _len, _last_dot)
(
  // Use the actual filename (sans extension) as the pad name. The previous
  // keyword-matching approach (kick.wav → "Kick") collapsed distinct samples
  // into the same generic label — for media-explorer drag-drop and arbitrary
  // sample names, the filename is the identifying signal the user wants in
  // the top-right corner.
  _fn = get_name_slot(pad_idx);
  _cn = get_cname_slot(pad_idx);
  // ⭐⭐ ...unless the file is one of OURS. A project that saves a marker instead
  // of embedded audio keeps each pad as <proj>/Swing/samples/kits/<kit>/padNN_
  // layN.wav, and reopening it reloads the pad FROM that file — so this
  // function renamed all sixteen pads to "pad00_lay0", "pad01_lay0" ... over
  // the good names @serialize had just restored. Reported live 2026-09-09 on a
  // saved project: right audio, wrong names, and no way back because the next
  // save then persisted the storage names as the real ones.
  // The staged-name path (GS_BROWSE_NAME_ADOPT, rk_swing_browser_load ④) fixes
  // this for FILL, which knows the kit's names; a marker reopen has no such
  // requester, so the guard belongs HERE, where every loader lands.
  // Only when the pad already HAS a name: an unnamed pad restoring from the
  // store still gets the filename, which is worth more than a blank tile.
  eon_name_is_store_file(_fn) && strlen(_cn) > 0 ? 0 : (
  _len = strlen(_fn);
  _len > 0 ? (
    strcpy(_cn, _fn);
    // Strip extension (last '.' onward) — walk backward, scope to the last
    // segment so a path like "808 v1.5/kick.wav" only loses ".wav".
    _last_dot = -1;
    _i = 0; loop(_len,
      _ch = str_getchar(_cn, _i);
      _ch == 46 ? _last_dot = _i;  // '.' = 46
      _i += 1;
    );
    _last_dot > 0 ? str_setlen(_cn, _last_dot);
  );
  );
);

// ─── Sync pad names + notes to MIDI editor via Lua bridge (CMD 52) ───────
function sync_note_names()
local(_ki, _cn, _cnl, _cj)
(
  gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 && gmem[KIT_GMEM_CMD] == 0 &&
  (gmem[KIT_GMEM_LOCK] == 0 || gmem[KIT_GMEM_LOCK] == instance_id) ? (
    gmem[KIT_GMEM_LOCK] = instance_id;  // acquire instance lock
    // Write all pad names to gmem PADNAME area
    _ki = 0; loop(NUM_PADS,
      _cn = get_cname_slot(_ki);
      _cnl = strlen(_cn);
      _cj = 0; loop(KIT_GMEM_PADNAME_LEN,
        gmem[KIT_GMEM_PADNAMES + _ki * KIT_GMEM_PADNAME_LEN + _cj] =
          _cj < _cnl ? str_getchar(_cn, _cj) : 0;
        _cj += 1;
      );
      // Write note number to metadata area (already mapped)
      gmem[KIT_GMEM_META + _ki * KIT_GMEM_META_PP + 10] = p_note[_ki];
      // Write actual audio length (non-layered) or sentinel 1 (layered).
      // Browser still detects "has audio" via non-zero check; bridge gets
      // the real length it needs for gmem-fallback streaming.
      gmem[KIT_GMEM_AUDIOLEN + _ki] =
        s_len[_ki] > 0 ? s_len[_ki] :
        (pad_has_audio(_ki) ? 1 : 0);
      _ki += 1;
    );
    gmem[KIT_GMEM_CMD] = 52;
  );
);


// ─── Per-pad disk-source fail bitmap (P4 step 3) ─────────────────────────
// pad_fail_bits bit N = pad N records a disk source that did NOT load —
// the previously-invisible marker-reload failure (loaders reset s_len/l_len
// to 0 BEFORE file_open and had no else branch, so a missing file left a
// silent blank the truncation detector could never see). Recomputed
// declaratively after every loader/clear so a successful reload self-heals
// the bit (retires the relink banner). paths_gen counts every path-affecting
// mutation; the bridge uses it to invalidate its cached CMD-87 publish.
// RUNTIME-ONLY state: never serialized, and deliberately NOT initialized in
// @init — @init can run AFTER @serialize (EEL zero-init covers first run).
// Rules mirror the @serialize marker-reload + recoverability logic:
//   layered pad    → any layer with a non-empty LPATH but no audio = fail
//   promoted-single (p_layer_cnt>0, all LPATHs empty) → no layer audio at
//                    all while the pad-main path is set = fail
//   legacy pad     → pad-main path set but s_len==0 = fail
function swing_pad_fail_recompute(pad) local(_m, _bad, _anylp, _anyl, _li, _lx) (
  _bad = 0; _anylp = 0; _anyl = 0;
  _li = 0; loop(MAX_LAYERS,
    _lx = pad * MAX_LAYERS + _li;
    strlen(LPATH_STR_BASE + _lx) > 0 ? (
      _anylp = 1;
      l_len[_lx] <= 0 ? _bad = 1;
    );
    l_len[_lx] > 0 ? _anyl = 1;
    _li += 1;
  );
  p_layer_cnt[pad] > 0 ? (
    !_anylp && !_anyl && strlen(get_path_slot(pad)) > 0 ? _bad = 1;
  ) : (
    strlen(get_path_slot(pad)) > 0 && s_len[pad] <= 0 ? _bad = 1;
  );
  _m = 2 ^ pad;
  _bad ? ( pad_fail_bits |= _m; ) : ( pad_fail_bits = (pad_fail_bits | _m) - _m; );
  paths_gen += 1;
);

// ─── Clear a single layer slot ──────────────────────────────────────────
function clear_layer(pad_idx, layer_idx) local(_lidx, li) (
  undo_begin_pad(pad_idx);  // Phase 2: back up this pad (audio+meta+names) for scoped structural undo
  _lidx = pad_idx * MAX_LAYERS + layer_idx;
  // A cleared layer is unbaked + its overlay waveform must re-capture on reload.
  sp_baked_tune[_lidx] = 0;
  ov_cap[_lidx] = 0;
  // Pad audio changed → bump the source generation so the Kit Bridge re-captures
  // this pad's bake/preload source for the Extension (stale-source guard).
  sp_src_gen[pad_idx] += 1;
  l_len[_lidx] = 0;
  l_start[_lidx] = 0;
  l_end[_lidx] = 1.0;
  l_sr[_lidx] = 0;
  l_norm[_lidx] = 0;
  l_norm_gain[_lidx] = 1.0;
  l_vel_lo[_lidx] = layer_idx / MAX_LAYERS;
  l_vel_hi[_lidx] = (layer_idx + 1) / MAX_LAYERS;
  l_rr_order[_lidx] = layer_idx;
  l_gain[_lidx] = 1.0;
  strcpy(LPATH_STR_BASE + _lidx, "");
  // The audio memset is 8 MB per layer, 32 MB per clear_pad, on the audio thread. A stream
  // drop (rk_swing_padpcm) sets _clr_skip_audio around its clear_pad because the stream
  // overwrites [0, total) and the loader's sliced phase 2 zeroes [total, SLOT_SIZE) anyway
  // (measured 2026-09-08: this memset + the undo capture were most of a drop's first-block
  // stall, not the file open). Every other caller still gets the memset.
  !_clr_skip_audio ? memset(s_audio_start + pad_idx * SLOT_SIZE + layer_idx * LAYER_SIZE, 0, LAYER_SIZE);
  // Recalculate layer count (find highest non-empty layer)
  p_layer_cnt[pad_idx] = 0;
  li = 0; loop(MAX_LAYERS,
    l_len[pad_idx * MAX_LAYERS + li] > 0 ? p_layer_cnt[pad_idx] = li + 1;
    li += 1;
  );
  swing_pad_fail_recompute(pad_idx);  // P4 step 3: layer removed → refresh fail bit + paths_gen
  undo_cap_end();
);

// ─── Clear entire pad (all layers + legacy + name/path) ─────────────────
function clear_pad(i) local(li) (
  undo_begin_pad(i);  // Phase 2: back up this pad (audio+meta+names) for scoped structural undo
  s_len[i] = 0; s_start[i] = 0; s_end[i] = 1.0;
  // Eagerly clear the gmem blank signal too, so consumers (Kit Bridge
  // multi-out coloring, Drum Matrix lane sync) see the pad as blank on
  // the very next gmem read — not after the next @block runs the flush.
  // Without this, a kit-load cycle leaves the previous kit's purple-ish
  // positional hue painted on emptied multi-out tracks during the gap.
  gmem[KIT_GMEM_AUDIOLEN + i] = 0;
  s_sr[i] = 0; s_norm[i] = 0; s_norm_gain[i] = 1.0;
  s_dirty[i] = 1;
  strcpy(get_name_slot(i), "");
  strcpy(get_path_slot(i), "");
  strcpy(get_cname_slot(i), "");
  p_layer_cnt[i] = 0;
  p_layer_mode[i] = 3;
  li = 0; loop(MAX_LAYERS, clear_layer(i, li); li += 1;);
  // Reset FX to defaults
  fx_hpf_freq[i] = 20; fx_lpf_freq[i] = 20000;
  fx_eq_lo[i] = 0; fx_eq_mid[i] = 0; fx_eq_mid2[i] = 0; fx_eq_hi[i] = 0;
  fx_eq_lo_freq[i] = 200; fx_eq_mid_freq[i] = 1000; fx_eq_mid2_freq[i] = 3000; fx_eq_hi_freq[i] = 5000;
  fx_eq_mid_q[i] = 0.8; fx_eq_mid2_q[i] = 0.8;
  fx_eq_lo_q[i] = 0.7071; fx_eq_hi_q[i] = 0.7071;
  fx_sat_drv[i] = 0; fx_drv_mode[i] = 0;
  fx_bc_rate[i] = 0; fx_bc_bits[i] = 16;
  fx_snd_dly[i] = 0; fx_snd_rvb[i] = 0; fx_snd_smash[i] = 0;
  s_skip[i] = 0; p_reverse[i] = 0; p_swapLR[i] = 0; p_stereo[i] = 0; p_oneshot[i] = -1; p_choke[i] = 0;
  p_rng_lo[i] = 0; p_rng_hi[i] = 0;  // clear chromatic range → single-note pad
  p_gain[i] = 1.0; p_pan[i] = 0; p_tune[i] = 0; p_sample_offset[i] = 0;
  p_mute[i] = 0; p_solo[i] = 0;
  p_color[i] = i / 16.0;  // default: evenly-spaced hue, matches @init in
                          // Swing_ReaKit.jsfx:423. Was 0 (= hue red), which
                          // made every pad/mixer strip red after Clear Kit.
  // NOTE: ps_* (SYN slot) is deliberately NOT reset here. clear_pad is called
  // by LOAD paths too (CMD-63 swing_browser_load_pad, kit-import empty-pad
  // clears in rk_swing_ui_state) and the user-ratified clear-semantics table
  // (Spec_Swing_Change_Map_And_Reroll §4.4b) says loads replace samples and
  // leave the synth slot alive. Explicit user Clear gestures additionally call
  // clear_pad_syn() below.
  swing_pad_fail_recompute(i);  // P4 step 3: paths wiped → fail bit clears (intentional removal)
  _kd_site = 2; mark_dirty_kit();
  undo_cap_end();
);

// Explicit user "Clear Pad" / "Clear Kit" / "New Kit" gestures say "ALL layers
// + FX" — those (and ONLY those) also reset the SYN slot. Call directly after
// clear_pad(i) at the gesture sites, never from load paths.
function clear_pad_syn(i) local() (
  ps_enable[i] = 0; ps_engine[i] = 0; ps_level[i] = 1;
  ps_vel_lo[i] = 0; ps_vel_hi[i] = 1; ps_rr_order[i] = MAX_LAYERS;
  ps_mac0[i] = 0.5; ps_mac1[i] = 0.5; ps_mac2[i] = 0.5; ps_mac3[i] = 0.5;
  ps_mac4[i] = 0.5; ps_mac5[i] = 0.5; ps_mac6[i] = 0.5; ps_mac7[i] = 0.5;
);

// ─── Plain pads, layers, and the promotion cut ────────────────────────────
// (Spec_Swing_Long_Pad_Layer_Cap.md) A pad holding ONE sample is a PLAIN pad:
// p_layer_cnt = 0, the audio at the slot base, s_len up to SLOT_SIZE (45 s at
// 44.1k). It becomes a layered pad only when a layer >= 1 receives audio, and
// a layer holds LAYER_SIZE (11.3 s), so promoting a pad longer than that CUTS
// it. The cut is announced (LCD banner, rk_swing_ui_state) and undoable
// (whole-slot backup). Until 2026-09-08 every load promoted the pad to a
// one-layer pad, which capped every pad at 11.3 s in playback, @serialize, the
// kit export and the kit import while s_len kept the true length — the
// header/blob mismatch of the 2026-09-07 audit.

// Layer index an "add a layer" gesture should target: a plain pad with audio
// stacks on layer 1 (layer 0 is its sample); otherwise the next free slot,
// clamped so a full pad stacks on its last layer rather than doing nothing.
function swing_pad_next_layer(pad) (
  p_layer_cnt[pad] == 0 && s_len[pad] > 0 ? 1 : min(p_layer_cnt[pad], MAX_LAYERS - 1);
);

// Promote a plain pad's sample into layer 0. The audio already sits at the
// layer-0 offset, so this is metadata — plus the cut when the sample is
// longer than a layer. Safe inside an existing undo capture or standalone
// (captures are depth-counted; the outermost caller records the backup).
// Idempotent: a layered or empty pad is left alone.
function swing_pad_promote(pad)
local(_lidx, _old_len, _sr)
(
  pad >= 0 && pad < NUM_PADS && p_layer_cnt[pad] == 0 && s_len[pad] > 0 ? (
    undo_begin_pad(pad);
    _lidx = pad * MAX_LAYERS;
    _old_len = s_len[pad];
    _old_len > LAYER_SIZE ? (
      // The cut. Trim fractions are relative to the length: a trim that lies
      // inside the surviving 11.3 s stays where it is, the rest clamps to
      // the new end; an inverted pair falls back to the whole layer.
      s_start[pad] = min(1.0, s_start[pad] * _old_len / LAYER_SIZE);
      s_end[pad]   = min(1.0, s_end[pad]   * _old_len / LAYER_SIZE);
      s_start[pad] >= s_end[pad] ? ( s_start[pad] = 0; s_end[pad] = 1.0; );
      s_len[pad] = LAYER_SIZE;
      _sr = s_sr[pad] > 0 ? s_sr[pad] : srate;
      pad_cut_warn_pad    = pad;
      pad_cut_warn_before = _old_len / (2 * _sr);
      pad_cut_warn_after  = LAYER_SIZE / (2 * _sr);
      pad_cut_warn_until  = time_precise() + 8;
      sp_src_gen[pad] += 1;   // the Extension re-captures this pad's source
    );
    l_len[_lidx]       = s_len[pad];
    l_start[_lidx]     = s_start[pad];
    l_end[_lidx]       = s_end[pad];
    l_sr[_lidx]        = s_sr[pad];
    l_norm[_lidx]      = s_norm[pad];
    l_norm_gain[_lidx] = s_norm_gain[pad];
    l_gain[_lidx]      = 1.0;
    l_vel_lo[_lidx]    = 0;
    l_vel_hi[_lidx]    = 1.0;
    l_rr_order[_lidx]  = 0;
    strcpy(LPATH_STR_BASE + _lidx, get_path_slot(pad));
    p_layer_cnt[pad] = 1;
    p_layer_mode[pad] == 0 ? p_layer_mode[pad] = 3;
    s_dirty[pad] = 1;
    undo_cap_end();
  );
);

// ─── Waveform-aware ADSR analysis ─────────────────────────────────────────
// Derives ADSR parameters from actual waveform shape. Runs at load time
// (never in @sample — sqrt is intentional and safe here).
// ─── Sliced sample loader ─────────────────────────────────────────────────
// One resumable load JOB per bank. Job 0 belongs to @block (kit import, the
// CMD-88 reload pump, CMD 63/64) and is pumped one bounded slice per block;
// job 1 belongs to the UI side (@gfx drops, @serialize reloads) and is run to
// completion in one call by the load_from_path / load_layer_from_path
// wrappers. The banks never share state, so a drop during a kit load cannot
// corrupt the in-flight job. A job walks: open + header (begin) → read in
// slices with the peak folded in → zero the unused tail → RMS windows for the
// waveform-aware ADSR → finish (metadata, names, layer promotion, ADSR
// results, flags). Every loop inside one slice stays far under EEL2's 2^20
// iteration cap; the old one-shot loader tripped it on samples longer than
// 2^20 cells (its peak scan saw only the first 1,048,576 cells, and a mono file
// lost everything past 1,048,576 frames) — measured 2026-09-07 with
// .dev_tests/EON_Probe_LdrSlice_*. Job records live in host-allocated memory
// (swing_ldr_init) — this inc claims no freemem itself (wiki 2.4).
LDR_F_PHASE   = 0;   // 0 idle · 1 read · 2 zero tail · 3 RMS windows · 4 finish
LDR_F_PAD     = 1;
LDR_F_LAYER   = 2;   // -1 = pad main
LDR_F_HANDLE  = 3;
LDR_F_NCH     = 4;
LDR_F_SR      = 5;
LDR_F_BUF     = 6;
LDR_F_CAP     = 7;
LDR_F_POS     = 8;   // cells landed so far
LDR_F_PEAK    = 9;
LDR_F_ZPOS    = 10;  // zero-tail cursor
LDR_F_WFR     = 11;  // RMS window: frames
LDR_F_WIL     = 12;  // RMS window: interleaved cells
LDR_F_NWIN    = 13;
LDR_F_W       = 14;  // RMS window cursor
LDR_F_PKRMS   = 15;
LDR_F_PKWIN   = 16;
LDR_F_ADSR    = 17;  // 1 = the analyzer owns this pad's ADSR after the load
LDR_F_PREVCNT = 18;  // layer loads: p_layer_cnt before the load
LDR_F_OPENED  = 19;  // file_open succeeded
LDR_F_LEN     = 20;  // final cell count
LDR_F_RMS     = 32;  // 200-cell RMS scratch (LDR_JOB_STRIDE is 256)

function swing_ldr_init(fm) (
  ldr_job0 = fm;
  ldr_job1 = fm + LDR_JOB_STRIDE;
  memset(fm, 0, 2 * LDR_JOB_STRIDE);   // an @init re-run drops any in-flight job
  ldr_job0[LDR_F_HANDLE] = -1;
  ldr_job1[LDR_F_HANDLE] = -1;
  ldr_budget = LDR_BUDGET_MIN;         // @block rescales it from samplesblock
  fm + 2 * LDR_JOB_STRIDE;
);

// Drop an in-flight job: a newer job for the same bank, or a state machine the
// bridge abandoned mid-flight. The pad keeps the zero length begin() gave it.
function swing_ldr_abort(jb) (
  jb[LDR_F_PHASE] > 0 ? (
    jb[LDR_F_HANDLE] >= 0 ? file_close(jb[LDR_F_HANDLE]);
    jb[LDR_F_HANDLE] = -1;
    swing_pad_fail_recompute(jb[LDR_F_PAD]);
    undo_cap_end();
    jb[LDR_F_PHASE] = 0;
  );
);

function swing_ldr_begin(jb, pad, layer, path_str)
local(f, nch, fsr, lidx)
(
  jb[LDR_F_PHASE] > 0 ? swing_ldr_abort(jb);   // a new job always wins
  jb[LDR_F_PAD] = pad; jb[LDR_F_LAYER] = layer;
  jb[LDR_F_HANDLE] = -1; jb[LDR_F_NCH] = 0; jb[LDR_F_SR] = 0;
  jb[LDR_F_POS] = 0; jb[LDR_F_PEAK] = 0.00001; jb[LDR_F_ZPOS] = 0; jb[LDR_F_LEN] = 0;
  jb[LDR_F_OPENED] = 0; jb[LDR_F_ADSR] = 0; jb[LDR_F_PREVCNT] = 0; jb[LDR_F_NWIN] = 0;
  undo_begin_pad(pad);  // Phase 2: back up this pad (audio+meta+names) for scoped structural undo
  layer < 0 ? (
    s_len[pad] = 0;  // reset before load; stays 0 if load fails
    s_sr[pad]  = 0;
    strcpy(get_path_slot(pad), path_str);
    jb[LDR_F_BUF] = s_audio_start + pad * SLOT_SIZE;
    jb[LDR_F_CAP] = SLOT_SIZE;
  ) : (
    lidx = pad * MAX_LAYERS + layer;
    jb[LDR_F_PREVCNT] = p_layer_cnt[pad];  // snapshot before update
    // Freshly loaded layer = original (unbaked) audio: clear the bake anchor (so
    // the residual tracks full tune until a new bake lands, and the bridge can
    // re-capture this layer's source) and re-arm the overlay waveform capture.
    sp_baked_tune[lidx] = 0;
    ov_cap[lidx] = 0;
    // Full reset before attempting load (prevents stale state on failure)
    l_len[lidx] = 0; l_start[lidx] = 0; l_end[lidx] = 1.0; l_sr[lidx] = 0;
    l_norm[lidx] = 0; l_norm_gain[lidx] = 1.0; l_vel_lo[lidx] = 0; l_vel_hi[lidx] = 1.0;
    l_rr_order[lidx] = layer; l_gain[lidx] = 1.0;
    strcpy(LPATH_STR_BASE + lidx, path_str);  // layer file path for serialization
    jb[LDR_F_BUF] = s_audio_start + pad * SLOT_SIZE + layer * LAYER_SIZE;
    jb[LDR_F_CAP] = LAYER_SIZE;
  );
  f = file_open(path_str);
  // Transient open miss (AV/indexer read-lock on a valid file): flag it so the
  // kit-import loop retries THIS pad next @block instead of leaving it blank
  // (2026-07-19). SET only — the loop clears it per pass.
  f < 0 ? kit_pad_open_failed = 1;
  f >= 0 ? (
    jb[LDR_F_OPENED] = 1;
    file_riff(f, nch, fsr);
    nch > 0 && nch < 3 ? (
      jb[LDR_F_HANDLE] = f;
      jb[LDR_F_NCH] = nch;
      jb[LDR_F_SR] = fsr > 0 ? fsr : srate;
      layer < 0 ? ( s_sr[pad] = jb[LDR_F_SR]; ) : ( l_sr[pad * MAX_LAYERS + layer] = jb[LDR_F_SR]; );
      // A plain pad receiving a layer (only once the file really opened, so
      // a missed open leaves the plain pad intact): a layer >= 1 promotes its
      // sample to layer 0 first — the cut and the banner live in
      // swing_pad_promote; a layer-0 load replaces the plain sample outright,
      // so its pad-main length goes with it (playback, the kit header and the
      // Extension capture follow l_len[0] from here on).
      layer >= 1 ? swing_pad_promote(pad) :
      (layer == 0 && p_layer_cnt[pad] == 0 ? s_len[pad] = 0);
      jb[LDR_F_PHASE] = 1;
    ) : (
      file_close(f);        // unsupported channel count: finish records the failure
      jb[LDR_F_PHASE] = 4;
    );
  ) : (
    jb[LDR_F_PHASE] = 4;
  );
);

// Stream-fed twin of swing_ldr_begin (EON_PADPCM, rk_swing_padpcm.jsfx-inc; go-live
// hardening Phase 2, 2026-09-08). The Kit Bridge already opened and decoded the
// file on the UI thread and hands the PCM over as interleaved stereo, so this
// does everything begin() does EXCEPT file_open / file_riff -- the ~30 ms stall
// that used to sit on the audio thread once per drop. `total` = the interleaved
// cell count the bridge will deliver, `fsr` its sample rate. Phase 5 = "fed by
// the stream": swing_padpcm_tick copies the cells straight into LDR_F_BUF and
// folds the peak, then hands the job to phase 2 at the stream's LAST chunk, and
// phases 2/3/4 (zero tail, RMS/ADSR, finish) run exactly as for a file read.
function swing_ldr_begin_gmem(jb, pad, layer, path_str, fsr, total)
local(lidx)
(
  jb[LDR_F_PHASE] > 0 ? swing_ldr_abort(jb);   // a new job always wins
  jb[LDR_F_PAD] = pad; jb[LDR_F_LAYER] = layer;
  jb[LDR_F_HANDLE] = -1; jb[LDR_F_NCH] = 0; jb[LDR_F_SR] = 0;
  jb[LDR_F_POS] = 0; jb[LDR_F_PEAK] = 0.00001; jb[LDR_F_ZPOS] = 0; jb[LDR_F_LEN] = 0;
  jb[LDR_F_OPENED] = 0; jb[LDR_F_ADSR] = 0; jb[LDR_F_PREVCNT] = 0; jb[LDR_F_NWIN] = 0;
  undo_begin_pad(pad);
  lidx = pad * MAX_LAYERS + max(layer, 0);
  layer < 0 ? (
    s_len[pad] = 0;
    s_sr[pad]  = 0;
    strcpy(get_path_slot(pad), path_str);
    jb[LDR_F_BUF] = s_audio_start + pad * SLOT_SIZE;
    jb[LDR_F_CAP] = SLOT_SIZE;
  ) : (
    jb[LDR_F_PREVCNT] = p_layer_cnt[pad];
    sp_baked_tune[lidx] = 0;
    ov_cap[lidx] = 0;
    l_len[lidx] = 0; l_start[lidx] = 0; l_end[lidx] = 1.0; l_sr[lidx] = 0;
    l_norm[lidx] = 0; l_norm_gain[lidx] = 1.0; l_vel_lo[lidx] = 0; l_vel_hi[lidx] = 1.0;
    l_rr_order[lidx] = layer; l_gain[lidx] = 1.0;
    strcpy(LPATH_STR_BASE + lidx, path_str);
    jb[LDR_F_BUF] = s_audio_start + pad * SLOT_SIZE + layer * LAYER_SIZE;
    jb[LDR_F_CAP] = LAYER_SIZE;
  );
  total > 0 ? (
    jb[LDR_F_OPENED] = 1;
    jb[LDR_F_NCH] = 2;                       // the stream is always interleaved stereo
    jb[LDR_F_SR] = fsr > 0 ? fsr : srate;
    layer < 0 ? ( s_sr[pad] = jb[LDR_F_SR]; ) : ( l_sr[lidx] = jb[LDR_F_SR]; );
    layer >= 1 ? swing_pad_promote(pad) :
    (layer == 0 && p_layer_cnt[pad] == 0 ? s_len[pad] = 0);
    jb[LDR_F_PHASE] = 5;
  ) : (
    // the bridge could not decode it: the same transient class as an open miss
    kit_pad_open_failed = 1;
    jb[LDR_F_PHASE] = 4;
  );
);

// Window setup for the waveform-aware ADSR pass (the old analyze_adsr
// preamble). Which loads analyze: a pad-main load unless the user tuned the
// pad's ADSR (right-click on the overlay clears that flag); a layer-0 load
// onto a pad that had no layers.
function swing_ldr_adsr_setup(jb)
local(pad, layer, len, sr, tot, dur, wfr, wil, nw)
(
  pad = jb[LDR_F_PAD]; layer = jb[LDR_F_LAYER]; len = jb[LDR_F_LEN]; sr = jb[LDR_F_SR];
  jb[LDR_F_ADSR] = layer < 0 ? !p_adsr_user[pad] : (layer == 0 && jb[LDR_F_PREVCNT] == 0);
  jb[LDR_F_NWIN] = 0;
  jb[LDR_F_PHASE] = 4;
  jb[LDR_F_ADSR] ? (
    tot = (len / 2)|0;
    dur = tot / max(1, sr) * 1000.0;
    // Too short → percussive defaults at finish (no windows). Otherwise cover
    // the FULL sample in up to 200 windows: ~5 ms for short hits, ~25 ms at 5 s.
    !(tot < 128 || dur < 10) ? (
      wfr = max((sr * 0.005)|0, (tot / 200)|0);
      wil = wfr * 2;
      nw  = max(1, min(200, (len / wil)|0));
      jb[LDR_F_WFR] = wfr; jb[LDR_F_WIL] = wil; jb[LDR_F_NWIN] = nw; jb[LDR_F_W] = 0;
      jb[LDR_F_PKRMS] = 0.00001; jb[LDR_F_PKWIN] = 0;
      jb[LDR_F_PHASE] = 3;
    );
  );
);

// The old analyze_adsr result derivation, reading the job's RMS windows.
function swing_ldr_adsr_finish(jb)
local(pad, _rms_buf, _num_wins, _peak_rms, _peak_win, _win_ms, _dur_ms, _post_peak,
      _body_start, _body_end, _body_sum, _body_cnt, _body_avg, _sus,
      _dec_tgt, _dec_win, _dec_found, _rel_tgt, _rel_win, _w,
      _atk_ms, _dec_ms, _rel_ms, _is_percussive)
(
  pad = jb[LDR_F_PAD];
  _num_wins = jb[LDR_F_NWIN];
  _num_wins <= 0 ? (
    // Too short — percussive defaults, no analysis
    p_attack[pad]  = 0.1;
    p_decay[pad]   = 50;
    p_sustain[pad] = 1.0;  // drum sampler: one-shots play through at full amplitude
    p_release[pad] = 30;
    p_adsr_user[pad] = 0;  // analyzer owns these values
    recalc_pad(pad);
  ) : (
    _rms_buf  = jb + LDR_F_RMS;
    _peak_rms = jb[LDR_F_PKRMS];
    _peak_win = jb[LDR_F_PKWIN];
    _win_ms   = jb[LDR_F_WFR] / max(1, jb[LDR_F_SR]) * 1000.0;
    _dur_ms   = ((jb[LDR_F_LEN] / 2)|0) / max(1, jb[LDR_F_SR]) * 1000.0;
    _peak_rms < 0.0001 ? (
      // Edge case: silent buffer — conservative middle defaults
      p_attack[pad]  = 5;
      p_decay[pad]   = 500;
      p_sustain[pad] = 1.0;  // drum sampler: one-shots play through at full amplitude
      p_release[pad] = 300;
      p_adsr_user[pad] = 0;  // analyzer owns these values
      recalc_pad(pad);
    ) : (
      // ── Attack: time from start to peak window ────────────────
      _atk_ms = max(0.1, min(500.0, _peak_win * _win_ms));
      _post_peak = _num_wins - _peak_win - 1;

      // ── Sustain: body energy (middle 30-70%) vs peak ──────────
      // This is the "held" level — how loud the sound is during its body
      _body_start = _peak_win + 1 + max(1, (_post_peak * 0.3)|0);
      _body_end   = _peak_win + 1 + max(2, (_post_peak * 0.7)|0);
      _body_start = min(_body_start, _num_wins - 1);
      _body_end   = min(_body_end, _num_wins);
      _body_sum = 0; _body_cnt = 0;
      _w = _body_start;
      loop(_body_end - _body_start,
        _w < _num_wins ? ( _body_sum += _rms_buf[_w]; _body_cnt += 1; );
        _w += 1;
      );
      _body_avg = _body_cnt > 0 ? (_body_sum / _body_cnt) : 0;
      _sus      = max(0.0, min(1.0, _body_avg / _peak_rms));

      // ── Decay: peak → where RMS reaches the body/sustain level ─
      // Use sustain-relative target: find where sound settles to its body
      _dec_tgt   = _body_avg + (_peak_rms - _body_avg) * 0.15;  // 15% above body
      _dec_tgt   = max(_dec_tgt, _peak_rms * 0.10);  // floor: -20dB from peak
      _dec_win   = _num_wins - 1;
      _dec_found = 0;
      _w = _peak_win + 1;
      loop(_post_peak,
        !_dec_found && _w < _num_wins ? (
          _rms_buf[_w] <= _dec_tgt ? (
            _dec_win = _w; _dec_found = 1;
          );
        );
        _w += 1;
      );
      !_dec_found ? (
        // Sustained sound — decay = 80% of remaining duration
        _dec_ms = max(10.0, min(5000.0, _post_peak * _win_ms * 0.8));
      ) : (
        _dec_ms = max(1.0, min(5000.0, (_dec_win - _peak_win) * _win_ms));
      );

      // ── Release: scan from end backwards for last window > 5% peak ─
      _rel_tgt = _peak_rms * 0.05;
      _rel_win = _num_wins - 1;
      _w = _num_wins - 1;
      loop(_num_wins,
        _w >= 0 && _rms_buf[_w] >= _rel_tgt ? (
          _rel_win = _w;
          _w = -1;  // break
        );
        _w -= 1;
      );
      _rel_ms = max(5.0, min(2000.0, (_num_wins - 1 - _rel_win) * _win_ms));
      // Floor: 10% of duration up to 50ms — prevents click on voice kill
      _rel_ms = max(_rel_ms, min(50.0, _dur_ms * 0.1));

      // ── Write results ─────────────────────────────────────────
      p_attack[pad]  = _atk_ms;
      p_decay[pad]   = _dec_ms;
      // Sustain: percussive vs sustained heuristic.
      //   Percussive (kick/snare/hat): body-RMS/peak-RMS is near zero, which
      //   would clamp the post-decay tail to ~5% and gut the sample. So for
      //   short bursts or front-loaded transients we force S=1.0 (the sample
      //   plays through at full amplitude — sustain is meaningless when the
      //   audio is already over by the time decay finishes).
      //   Sustained (pads/loops/vocal hits): body has real energy; the
      //   computed _sus reflects the actual held level. Floor at 0.10 so
      //   even quiet sustained sources don't disappear.
      _is_percussive = _dur_ms < 250 || (_peak_win < _num_wins * 0.05 && _dur_ms < 1000);
      _is_percussive ? (
        p_sustain[pad] = 1.0;
      ) : (
        p_sustain[pad] = max(0.10, _sus);
      );
      p_release[pad] = _rel_ms;
      p_adsr_user[pad] = 0;  // analyzer owns these values
      recalc_pad(pad);
    );
  );
);

// Everything the old loaders did after the read: normalization gain from the
// folded-in peak, names, layer promotion / layer metadata, ADSR results,
// the retry + fail flags, the bridge's source generation, the undo bracket.
function swing_ldr_finish(jb)
local(pad, layer, lidx, len, gain, tpath, tname, last_p, i, char, _wl, _lp)
(
  pad = jb[LDR_F_PAD]; layer = jb[LDR_F_LAYER]; len = jb[LDR_F_LEN];
  jb[LDR_F_HANDLE] >= 0 ? ( file_close(jb[LDR_F_HANDLE]); jb[LDR_F_HANDLE] = -1; );
  jb[LDR_F_NCH] > 0 ? (
    gain = 1.0;
    jb[LDR_F_PEAK] > 0.000001 ? ( gain = min(1.0 / jb[LDR_F_PEAK], 100.0); );
    layer < 0 ? (
      s_len[pad] = len;
      s_norm_gain[pad] = gain;
      // Extract filename → name slot, then auto-name the pad from keywords
      tname = get_name_slot(pad);
      tpath = get_path_slot(pad);
      last_p = -1; i = 0;
      while((char = str_getchar(tpath, i)) > 0) (
        (char == 47 || char == 92) ? last_p = i; i += 1;
      );
      last_p >= 0 ? strcpy_from(tname, tpath, last_p + 1) : strcpy(tname, tpath);
      auto_name_from_file(pad);
      // A single-sample load is authoritative: the pad becomes a PLAIN pad
      // (p_layer_cnt = 0 — the whole slot is its sample) and every layer's
      // metadata is wiped, layer 0's included. The wipe is what fixes the
      // "load a new sample after a kit and it's quieter" bug: with the old
      // kit's l_len still nonzero, Sum-mode voice launch divided the gain by
      // sqrt(_active_cnt). Until 2026-09-08 this promoted the pad to ONE
      // layer instead, and a layer holds LAYER_SIZE, so every pad was silently
      // cut to 11.3 s (Spec_Swing_Long_Pad_Layer_Cap). Promotion now lives in
      // swing_pad_promote and runs only when a layer >= 1 receives audio.
      len > 0 ? (
        _wl = 0;
        loop(MAX_LAYERS,
          _lp = pad * MAX_LAYERS + _wl;
          l_len[_lp]       = 0;
          l_start[_lp]     = 0;
          l_end[_lp]       = 1.0;
          l_sr[_lp]        = 0;
          l_norm[_lp]      = 0;
          l_norm_gain[_lp] = 1.0;
          l_gain[_lp]      = 1.0;
          l_vel_lo[_lp]    = _wl / MAX_LAYERS;
          l_vel_hi[_lp]    = (_wl + 1) / MAX_LAYERS;
          l_rr_order[_lp]  = _wl;
          strcpy(LPATH_STR_BASE + _lp, "");
          _wl += 1;
        );
        p_layer_cnt[pad]   = 0;
        p_layer_mode[pad]  = 3;  // Sum = the safe default once layers arrive
      );
    ) : (
      lidx = pad * MAX_LAYERS + layer;
      l_len[lidx] = len;
      l_norm_gain[lidx] = gain;
      l_start[lidx] = 0;
      l_end[lidx] = 1.0;
      // Update pad layer count
      p_layer_cnt[pad] < layer + 1 ? p_layer_cnt[pad] = layer + 1;
      // Auto-name pad from first layer's filename (layer 0 only)
      layer == 0 ? (
        tname = get_name_slot(pad);
        tpath = get_path_slot(pad);
        strcpy(tpath, LPATH_STR_BASE + lidx);
        last_p = -1; i = 0;
        while((char = str_getchar(tpath, i)) > 0) (
          (char == 47 || char == 92) ? last_p = i; i += 1;
        );
        last_p >= 0 ? strcpy_from(tname, tpath, last_p + 1) : strcpy(tname, tpath);
        auto_name_from_file(pad);
      );
    );
    jb[LDR_F_ADSR] ? swing_ldr_adsr_finish(jb);
    s_dirty[pad] = 1;  // rebuild the waveform cache
  );
  // A file that OPENS but yields no audio (file_riff nch=0 when the decoder
  // init loses the same transient AV/indexer race file_open can, or a read of
  // 0) is the same transient class as an open miss — flag it for the
  // kit-import loop's per-pad retry (2026-07-19, sibling of the f<0 retry).
  jb[LDR_F_OPENED] && len <= 0 ? kit_pad_open_failed = 1;
  // Pad audio changed → bump the source generation so the Kit Bridge re-captures
  // this pad's bake/preload source for the Extension (stale-source guard).
  // Bumped at the END of the load so a capture never sees a partial buffer.
  sp_src_gen[pad] += 1;
  // P4 step 3: record the disk-load outcome (covers file_open failure AND
  // unsupported channel count — both leave the length 0 with the path retained).
  swing_pad_fail_recompute(pad);
  undo_cap_end();
  jb[LDR_F_PHASE] = 0;
);

// One bounded slice of work on a job. Returns 1 when the job is idle after the
// call (finished, failed, or nothing in flight), 0 while it is still running.
// `budget` is in cells and is also the loop ceiling of every loop below.
function swing_ldr_step(jb, budget)
local(ph, f, nch, tbuf, cap, pos, left, m, n, i, src, v, peak, wfr, wil, nw, w, fi, sum, rms, rmsbuf,
      zbase, zlim)
(
  ph = jb[LDR_F_PHASE];
  ph == 1 ? (
    f = jb[LDR_F_HANDLE]; nch = jb[LDR_F_NCH];
    tbuf = jb[LDR_F_BUF]; cap = jb[LDR_F_CAP]; pos = jb[LDR_F_POS];
    peak = jb[LDR_F_PEAK];
    left = cap - pos;
    n = 0;
    nch == 2 ? (
      m = min(budget, left);
      m > 0 ? ( n = file_mem(f, tbuf + pos, m); );
      n > 0 ? (
        i = 0;
        loop(n,
          v = abs(tbuf[pos + i]); v > peak ? peak = v;
          i += 1;
        );
      );
    ) : (
      // Mono: read m samples into the upper half of the destination window,
      // then expand L=R forward in place — every write lands at or below its
      // source cell, so nothing unread is overwritten.
      m = min((budget / 2)|0, (left / 2)|0);
      m > 0 ? ( n = file_mem(f, tbuf + pos + m, m); );
      n > 0 ? (
        src = tbuf + pos + m;
        i = 0;
        loop(n,
          v = src[i];
          tbuf[pos + 2 * i] = v; tbuf[pos + 2 * i + 1] = v;
          v = abs(v); v > peak ? peak = v;
          i += 1;
        );
        n = n * 2;
      );
    );
    jb[LDR_F_PEAK] = peak;
    pos += n;
    jb[LDR_F_POS] = pos;
    (n <= 0 || pos >= cap) ? (
      file_close(f); jb[LDR_F_HANDLE] = -1;
      jb[LDR_F_LEN] = pos; jb[LDR_F_ZPOS] = pos;
      jb[LDR_F_PHASE] = 2;
    );
    0;
  ) :
  ph == 2 ? (
    // Zero the unused tail of the slot / layer region. memset is native and
    // ~50x cheaper per cell than the read slice, so it gets 16x the budget:
    // a whole 4M-cell slot clears in ~4 blocks instead of ~60, which is what
    // keeps a one-shot drum hit feeling instant (measured 2026-09-07: 14 defer
    // ticks for a 0.25 s file at the plain budget).
    tbuf = jb[LDR_F_BUF]; cap = jb[LDR_F_CAP]; pos = jb[LDR_F_ZPOS];
    m = min(budget * 16, cap - pos);
    // Sliced-undo barrier (rk_drumkit_dsp udo_cow_upto): the tail this is about to
    // zero can still be the only copy of the pad's OLD audio when the capture was
    // sliced. It saves what we are about to destroy and hands back how far we may
    // go; a short answer means we zero less this block and pick the rest up next
    // block. A no-op for every load whose capture copied up front.
    zbase = jb[LDR_F_LAYER] < 0 ? 0 : jb[LDR_F_LAYER] * LAYER_SIZE;
    zlim = udo_cow_upto(jb[LDR_F_PAD], zbase + pos + m) - (zbase + pos);
    zlim < m ? m = max(zlim, 0);
    m > 0 ? memset(tbuf + pos, 0, m);
    pos += m;
    jb[LDR_F_ZPOS] = pos;
    pos >= cap ? swing_ldr_adsr_setup(jb);
    0;
  ) :
  ph == 3 ? (
    // RMS windows (mono mix L+R / 2): as many as cover ~budget cells, min one
    tbuf = jb[LDR_F_BUF];
    wfr = jb[LDR_F_WFR]; wil = jb[LDR_F_WIL]; nw = jb[LDR_F_NWIN]; w = jb[LDR_F_W];
    rmsbuf = jb + LDR_F_RMS;
    m = max(1, (budget / max(1, wil))|0);
    m = min(m, nw - w);
    loop(m,
      sum = 0; fi = w * wil;
      loop(wfr,
        v = (tbuf[fi] + tbuf[fi + 1]) * 0.5;
        sum += v * v;
        fi += 2;
      );
      rms = sqrt(sum / max(1, wfr));
      rmsbuf[w] = rms;
      rms > jb[LDR_F_PKRMS] ? ( jb[LDR_F_PKRMS] = rms; jb[LDR_F_PKWIN] = w; );
      w += 1;
    );
    jb[LDR_F_W] = w;
    w >= nw ? jb[LDR_F_PHASE] = 4;
    0;
  ) :
  ph == 5 ? 0 :   // fed by the EON_PADPCM stream (rk_swing_padpcm); its LAST chunk hands the job to phase 2
  ph == 4 ? (
    swing_ldr_finish(jb);
    1;
  ) : 1;
);

// @block entry points: begin the job on first sight of (pad, layer), then pump
// one ldr_budget slice. Return 1 once the load has landed (or failed) so the
// caller can move on, 0 while it should hold its place and call again next
// block with the same arguments.
function swing_ldr_step_pad(pad, path_str) (
  (ldr_job0[LDR_F_PHASE] == 0 || ldr_job0[LDR_F_PAD] != pad || ldr_job0[LDR_F_LAYER] != -1) ?
    swing_ldr_begin(ldr_job0, pad, -1, path_str);
  swing_ldr_step(ldr_job0, ldr_budget);
);
function swing_ldr_step_layer(pad, layer, path_str) (
  (ldr_job0[LDR_F_PHASE] == 0 || ldr_job0[LDR_F_PAD] != pad || ldr_job0[LDR_F_LAYER] != layer) ?
    swing_ldr_begin(ldr_job0, pad, layer, path_str);
  swing_ldr_step(ldr_job0, ldr_budget);
);

// Run a job to completion in one call (UI-side callers and the legacy VER-200
// import). Each step stays under the loop cap; a full slot takes ~8 steps.
function swing_ldr_run(jb, pad, layer, path_str) (
  swing_ldr_begin(jb, pad, layer, path_str);
  while (swing_ldr_step(jb, LDR_BUDGET_MAX) == 0) ( 0; );
);

// ─── A load the Kit Bridge could not take (2026-09-10, plan Phase B) ──────
// Told on the LCD for 4 s (rk_swing_ui_state rung 1f). kind 1: a bridge is
// running but predates this JSFX -- every ReaPack sync produces this until
// REAPER restarts -- so the load was REFUSED and the pad left exactly as it was,
// because a restart fixes it and a file read on the audio thread does not.
// kind 0: no bridge at all (a fresh install, or it died) -- Swing read the file
// itself, the way it always could, and says so. Lives here rather than in
// rk_swing_padpcm because rk_swing_browser_load is imported before that file
// and EEL2 binds function names in file order.
function swing_ldr_bridge_notice(kind) (
  kind ? (
    strcpy(#_ld_notice_t, "Sample not loaded");
    strcpy(#_ld_notice_s, "Kit Bridge is out of date -- restart REAPER");
  ) : (
    strcpy(#_ld_notice_t, "Loaded without the Kit Bridge");
    strcpy(#_ld_notice_s, "It isn't running -- run Swing_Kit_Bridge from the Action List");
  );
  _ld_notice_until = time_precise() + 4;
);

// ─── Sample loader (synchronous wrappers on the UI-side job bank) ─────────
function load_from_path(idx, path_str) (
  idx >= 0 && idx < NUM_PADS ? swing_ldr_run(ldr_job1, idx, -1, path_str);
);

// Set a pad's layer playback mode (0=single 1=vel-split 2=round-robin 3=sum).
// Mirrors the layer-mode popup in rk_swing_ui_grid_overlay.jsfx-inc: resets the
// RR cursor and — for vel-split — auto-assigns even velocity ranges when the
// layers still have default 0-1 ranges. A mode change never promotes a plain
// pad: it has nothing to sum or split yet, and promoting a pad longer than a
// layer would cut it (swing_pad_promote runs when a layer >= 1 lands).
// Self-contained (no GUI dependency) so the RS5k importer can drive it over
// the INCMD_LMODE channel after stacking layers via CMD 64.
function swing_layer_set_mode(pad_idx, mode)
local(_all_default, _ncnt, _base, _li)
(
  pad_idx >= 0 && pad_idx < NUM_PADS ? (
    p_layer_mode[pad_idx] = max(0, min(3, mode));
    p_rr_idx[pad_idx] = 0;
    // Even vel-split ranges when entering Vel-Split, only if every layer still
    // has the default 0-1 range (don't stomp user/preset edits).
    mode == 1 && p_layer_cnt[pad_idx] > 1 ? (
      _all_default = 1; _ncnt = p_layer_cnt[pad_idx];
      _li = 0; loop(_ncnt,
        _base = pad_idx * MAX_LAYERS + _li;
        (l_vel_lo[_base] > 0.001 || l_vel_hi[_base] < 0.999) ? _all_default = 0;
        _li += 1;
      );
      _all_default ? (
        _li = 0; loop(_ncnt,
          _base = pad_idx * MAX_LAYERS + _li;
          l_vel_lo[_base] = _li / _ncnt;
          l_vel_hi[_base] = (_li + 1) / _ncnt;
          _li += 1;
        );
      );
    );
  );
);

function load_layer_from_path(pad_idx, layer_idx, path_str) (
  pad_idx >= 0 && pad_idx < NUM_PADS && layer_idx >= 0 && layer_idx < MAX_LAYERS ?
    swing_ldr_run(ldr_job1, pad_idx, layer_idx, path_str);
);

// ─── Waveform cache builder ─────────────────────────────────────────────
function build_wv_cache(idx) local(buf, step, i, _wi, val, si, ptr, ptr_R, _wlen, _wsg, _lidx, _wli, _stereo_found, _louder, _quieter, _cum_diff, _cum_signal, _vL, _vR, _eL, _eR, _ovl, _ov_lidx, _ov_llen, _ov_dst, _ov_dstR, _ov_buf, _ov_step, _ovi, _ov_si, _ov_sg) (
  // Cache stores raw waveform shape only. User mix knobs (p_gain, l_gain)
  // are NOT applied — they're shown by their own knobs and would push the
  // wave outside the pad bounds. ADSR is NOT applied — the FX overlay
  // draws it as a separate curve. The only multiplier is normalize gain,
  // which describes the sample's intrinsic loudness so quiet samples still
  // fill the pad.
  p_layer_cnt[idx] > 0 ? (
    _wli = 0;
    while(_wli < p_layer_cnt[idx] && l_len[idx * MAX_LAYERS + _wli] <= 0) ( _wli += 1; );
    _wli >= p_layer_cnt[idx] ? _wli = 0; // fallback to 0 if all empty
    _lidx = idx * MAX_LAYERS + _wli;
    _wlen = l_len[_lidx];
    buf = s_audio_start + idx * SLOT_SIZE + _wli * LAYER_SIZE;
    _wsg = l_norm[_lidx] ? l_norm_gain[_lidx] : 1.0;
  ) : (
    _wlen = s_len[idx];
    buf = s_audio_start + idx * SLOT_SIZE;
    _wsg = s_norm[idx] ? s_norm_gain[idx] : 1.0;
  );
  _wlen > 0 ? (
    ptr   = wv_cache   + idx * WV_RES;
    ptr_R = wv_cache_R + idx * WV_RES;
    step = (_wlen / 2) / WV_RES;
    // Stereo detection — two checks must both pass for stereo render:
    //
    //   1. Relative L/R difference: cumulative |L-R| > 10% of total
    //      louder-channel signal. Catches the "kick stored as stereo
    //      with L≈R" case — old per-sample EPS=1e-5 fired on noise
    //      floor and rendered two near-identical halves that visually
    //      merged into one waveform wrapping around. Mirror of the
    //      browser-side check in Swing_Browser.lua generate_peaks().
    //
    //   2. Channel-balance: quieter channel >= 30% (≈ -10.5 dB) of
    //      louder. Catches "bass file with one silent channel" — would
    //      render with half flat, looks broken. Force mono in that case
    //      so the louder channel fills the pad.
    _cum_diff = 0; _cum_signal = 0;
    _eL = 0; _eR = 0;  // per-channel cumulative |amp| (energy proxy)
    i = 0; loop(WV_RES,
      _wi = p_reverse[idx] ? (WV_RES - 1 - i) : i;
      si = ((_wi * step)|0) * 2;
      _vL = buf[si];
      _vR = buf[si + 1];
      ptr  [i] = _vL * _wsg;
      ptr_R[i] = _vR * _wsg;
      _eL += abs(_vL);
      _eR += abs(_vR);
      _cum_diff   += abs(_vL - _vR);
      _cum_signal += max(abs(_vL), abs(_vR));
      i += 1;
    );
    _stereo_found = _cum_signal > 0.001 && (_cum_diff / _cum_signal) >= 0.10;
    // Channel-balance check by ENERGY (not peak). Peak-based missed
    // kicks where R had occasional loud spikes (passing 30% peak)
    // but was mostly silent (low RMS). Energy = cumulative |amp| ≈
    // area under the curve, mirrors what the user perceives as
    // "this channel carries content". 30% energy threshold matches
    // the browser preview's check in Swing_Browser.lua generate_peaks().
    _louder  = max(_eL, _eR);
    _quieter = min(_eL, _eR);
    // 30% (≈ -10.5 dB) — matches browser preview's calibrated value.
    p_stereo[idx] = _stereo_found && (_louder < 0.001 || (_quieter / _louder) >= 0.30);

    // ── Per-(pad,layer) frozen cache for the pad-detail overlay ──────────────
    // Built here (on load / s_dirty) so the overlay's overview shows the ORIGINAL
    // sample even after a Tuned bake overwrites the layer buffer with pitched
    // audio. Normalized (per-layer norm gain) to match wv_cache. Empty layers
    // are zeroed. Forward order; the overlay flips for reverse on read.
    _ovl = 0;
    loop(MAX_LAYERS,
      _ov_lidx = idx * MAX_LAYERS + _ovl;
      // GATE: rebuild this layer's frozen overlay waveform ONLY while it is still
      // original (sp_baked_tune==0) or has never been captured (ov_cap==0, the
      // reload fallback). Once baked, KEEP the frozen original so a later s_dirty
      // (offset / ADSR / gain knob) can't re-snapshot the pitched buffer and move
      // the displayed waveform. Re-armed (ov_cap=0) on layer load/clear.
      (sp_baked_tune[_ov_lidx] == 0 || ov_cap[_ov_lidx] == 0) ? (
        _ov_dst  = ov_wv_cache   + _ov_lidx * WV_RES;
        _ov_dstR = ov_wv_cache_R + _ov_lidx * WV_RES;
        _ov_llen = l_len[_ov_lidx];
        _ov_llen > 0 ? (
          _ov_buf  = s_audio_start + idx * SLOT_SIZE + _ovl * LAYER_SIZE;
          _ov_sg   = l_norm[_ov_lidx] ? l_norm_gain[_ov_lidx] : 1.0;
          _ov_step = (_ov_llen / 2) / WV_RES;
          _ovi = 0;
          loop(WV_RES,
            _ov_si = ((_ovi * _ov_step)|0) * 2;
            _ov_dst[_ovi]  = _ov_buf[_ov_si]     * _ov_sg;
            _ov_dstR[_ovi] = _ov_buf[_ov_si + 1] * _ov_sg;
            _ovi += 1;
          );
        ) : (
          memset(_ov_dst,  0, WV_RES);
          memset(_ov_dstR, 0, WV_RES);
        );
        ov_cap[_ov_lidx] = 1;   // captured — freeze until re-armed on load/clear
      );
      _ovl += 1;
    );

    s_dirty[idx] = 0;
  );
);

// ─── SYN voice launch ────────────────────────────────────────────────────
// Lifted out of launch_voices_for_pad so it has TWO callers: a full pad
// trigger runs it underneath the sample voices as before, and the SYN view's
// 3D drum runs it ALONE — when you are editing the engine you need to hear
// the ENGINE, not the pad's sample layer on top of it.
//
// The body is the block that used to sit inline; the one new thing is
// _sy_gaindiv, which carries the sum-mode gain split that the full-trigger
// path applies. A solo audition passes 1.
//
// Deliberately does NOT run the choke / duplicate-kill pass, and does NOT
// touch pad_flash or p_held: those belong to a pad TRIGGER. An audition is
// one drum on its own, and its caller owns the visual feedback.
//
// ⚠️ Defined BEFORE launch_voices_for_pad_ofs on purpose — EEL2 resolves function
// references at DEFINITION time, so a call to a later-defined function
// silently kills the whole file (feedback_jsfx_import_order).
function launch_syn_for_pad(_sy_pad, _sy_midi, _sy_vel, _sy_gaindiv, _sy_ofs)
  local(vi, max_age, _oldest_vi, j, _syn_st) (
  vi = -1; max_age = -1; _oldest_vi = -1;
  j = 0; loop(MAX_VOICES,
    v_pos[j] < 0 && v_stage[j] == 0 ? (
      vi < 0 ? vi = j;
    ) : (
      v_age[j] > max_age ? (max_age = v_age[j]; _oldest_vi = j;);
    );
    j += 1;
  );
  vi < 0 ? ( vi = _oldest_vi; );
  vi >= 0 && (v_pos[vi] >= 0 || v_stage[vi] > 0) ? (
    v_pos[vi] < 0 ? (
      v_pos[vi] = -1; v_env[vi] = 0; v_stage[vi] = 0;
    ) : (
      v_slot[MAX_VOICES] = v_slot[vi]; v_pos[MAX_VOICES] = v_pos[vi];
      v_startpos[MAX_VOICES] = v_startpos[vi];
      v_gain[MAX_VOICES] = v_gain[vi];
      v_env[MAX_VOICES] = v_env[vi]; v_note[MAX_VOICES] = v_note[vi];
      v_inc[MAX_VOICES] = v_inc[vi]; v_decay_ct[MAX_VOICES] = 0;
      v_sg[MAX_VOICES] = v_sg[vi]; v_layer[MAX_VOICES] = v_layer[vi];
      v_kind[MAX_VOICES] = v_kind[vi];
      v_kind[vi] == 1 ? memcpy(v_syn_state + MAX_VOICES * RK_SYN_STATE_SIZE,
                               v_syn_state + vi * RK_SYN_STATE_SIZE, RK_SYN_STATE_SIZE);
      v_stage[MAX_VOICES] = 4; // LAST — audio thread gate
      // park the stolen slot before any state rewrite (sweep finding)
      v_stage[vi] = 0; v_pos[vi] = -1; v_env[vi] = 0;
    );
  );
  vi >= 0 ? (
    v_slot[vi] = _sy_pad;
    v_layer[vi] = 0;
    v_kind[vi] = 1;
    _syn_mac_scratch[0] = ps_mac0[_sy_pad]; _syn_mac_scratch[1] = ps_mac1[_sy_pad];
    _syn_mac_scratch[2] = ps_mac2[_sy_pad]; _syn_mac_scratch[3] = ps_mac3[_sy_pad];
    _syn_mac_scratch[4] = ps_mac4[_sy_pad]; _syn_mac_scratch[5] = ps_mac5[_sy_pad];
    _syn_mac_scratch[6] = ps_mac6[_sy_pad]; _syn_mac_scratch[7] = ps_mac7[_sy_pad];
    _syn_st = v_syn_state + vi * RK_SYN_STATE_SIZE;
    memset(_syn_st, 0, RK_SYN_STATE_SIZE);
    _syn_trig_ctr += 1;
    _syn_st[1] = 1 + ((_syn_trig_ctr * 48271) % 2147483646);   // per-hit PRNG seed
    // pad TUNE + chromatic offset -> engine pitch (Tuned-mode-native, spec §0.4)
    rk_syn_reset(ps_engine[_sy_pad], _syn_st, _syn_mac_scratch,
                 p_tune[_sy_pad] + (_sy_midi - p_note[_sy_pad]), _sy_vel / 127.0);
    // _sy_ofs > 0 parks the voice pending for that many samples (note repeat
    // firing mid-block). v_startpos 0 = a SYN voice always resumes at its start.
    v_pos[vi] = _sy_ofs > 0 ? -(_sy_ofs + 1) : 0; v_inc[vi] = 0; v_startpos[vi] = 0;
    v_quiet[vi] = 0;   // silence counter starts fresh, or a reused slot would
                       // arrive already "quiet" and retire on its first sample
    // max(1,...) so a future caller passing 0 can never divide by zero here;
    // every real divisor is sqrt(count) >= 1.
    v_gain[vi] = apply_vel_curve(_sy_vel / 127.0, vel_curve) * ps_level[_sy_pad]
                 / max(1, _sy_gaindiv);
    v_sg[vi] = strip_tk[_sy_pad] ? 1.0 : p_gain[_sy_pad];
    v_note[vi] = _sy_midi;
    v_age[vi] = 0;
    v_env[vi] = 0;
    v_decay_ct[vi] = 0;
    v_stage[vi] = 1;  // LAST — audio thread gate
  );
);

// ─── Voice launch helper (eliminates triplication across note-on + repeats) ──
// _lv_midi = the played MIDI note. For single-note (drum) pads it equals
// p_note[pad] (offset 0). For a chromatic pad it's the actual key, and the
// voice pitches by (_lv_midi - p_note[pad]) semitones. Non-MIDI callers
// (browser/preview/repeat) pass p_note[pad] so behavior is unchanged.
// _lv_ofs delays the whole launch by that many samples inside the current
// block -- the sub-block accuracy note repeat needs. 0 = start immediately,
// which is what the 4-arg launch_voices_for_pad wrapper below passes.
function launch_voices_for_pad_ofs(_lv_pad, _lv_midi, _lv_vel, _lv_flash, _lv_ofs)
  local(_is_sum, _sum_cnt, _sum_cur, _active_cnt, _sel_layer, _skip_voice, vi, _lidx,
        _slen, _sstart, _send, _ssr, max_age, _oldest_vi, j, _delay, _end_i, _start_i,
        _lv_choke, _pt_eff, _st_off, _sr_base_t, _new_rpos, _bt_lidx, _tie_pg,
        _sel_syn, _syn_go, _syn_v, _syn_st, _has_smp, _comp_sum) (
  // Step 3b: Mode=Stretch diverts to the Extension's audio_hook. Don't
  // allocate a local sinc voice; instead bump the per-pad trigger counter
  // (Extension diffs against its shadow to detect new triggers), publish
  // the current p_tune so élastique uses the right pitch ratio, and update
  // pad_flash for UI feedback. The audio_hook renders élastique into the
  // per-pad SPSC ring; JSFX @sample reads from the ring instead of running
  // the local voice loop. Pads in Mode=Repitch or Mode=Tuned fall through
  // to the existing local-voice path unchanged.
  sp_pitch_mode[_lv_pad] == SP_PITCH_MODE_STRETCH ? (
    // ── Trigger-edge ring reset (consumer-side jump) ────────────────────
    // The Extension audio_hook (producer) and JSFX @sample (consumer) run
    // on the same audio thread. REAPER's per-buffer order is:
    //   audio_hook(pre) → JSFX @block → JSFX @sample×N → audio_hook(post)
    // We're in @block right now bumping the trigger counter; the producer
    // hasn't yet seen this new trigger (its pre-FX callback already ran
    // this buffer with the OLD counter). So gmem write_pos at THIS moment
    // reflects the END of any stale tail from the prior trigger, not new
    // audio. Setting read_pos = write_pos here parks the consumer exactly
    // at the boundary; @sample drains nothing until the next audio_hook
    // services this trigger, calls voice.trigger() (Reset shifter), and
    // writes fresh stretched audio. Without this jump, @sample would
    // drain ~5ms of prior-trigger tail before reaching the new audio —
    // perceived as a doubled transient ("old tail + new attack").
    // Same-thread, single-producer/single-consumer: no race possible.
    sp_pitch_trigger_cnt[_lv_pad] += 1;
    // B1c multi-instance: stride the TRIGGER/PITCH_ST control writes AND the
    // audio-ring read_pos reset by our registry slot, same as the MODE/TUNE/
    // ALGO publish in swing_block_pitch_tick() and the @sample consumer in the
    // main JSFX. Guard on a claimed slot so a pre-claim _reg_my_slot = -1 can't
    // underflow or stomp slot 0's ring (owned by another instance). Pre-B1c the
    // ring reset used the singleton base STRETCH_AUDIO_BASE + pad*PAD_STRIDE,
    // which parked the WRONG instance's consumer whenever this instance held a
    // non-zero slot — the read_pos jump landed in slot 0's ring.
    _reg_my_slot >= 0 ? (
      atomic_set(gmem[STRETCH_PER_PAD_TRIGGER_BASE  + _reg_my_slot * STRETCH_CONTROL_INSTANCE_STRIDE + _lv_pad], sp_pitch_trigger_cnt[_lv_pad]);
      atomic_set(gmem[STRETCH_PER_PAD_PITCH_ST_BASE + _reg_my_slot * STRETCH_CONTROL_INSTANCE_STRIDE + _lv_pad], p_tune[_lv_pad]);
      _sr_base_t = STRETCH_AUDIO_BASE + _reg_my_slot * STRETCH_INST_AUDIO_STRIDE + _lv_pad * STRETCH_PAD_STRIDE;
      _new_rpos  = atomic_get(gmem[_sr_base_t + STRETCH_OFF_WRITE_POS]);
      stretch_read_pos[_lv_pad] = _new_rpos;
      atomic_set(gmem[_sr_base_t + STRETCH_OFF_READ_POS], _new_rpos);
    );
    // Held back by the @sample consumer, not here: the Extension has not seen
    // this trigger yet and will not until its next audio_hook.
    stretch_hold[_lv_pad] = _lv_ofs;
    pad_flash[_lv_pad] = _lv_flash;
  ) : (
  // Only mode 3 (Sum) stacks all layers; mode 0 uses single-layer selection
  _is_sum = p_layer_cnt[_lv_pad] > 0 && p_layer_mode[_lv_pad] == 3;
  _sel_syn = 0;
  // Count active (non-empty) layers for gain compensation. The SYN slot counts
  // as one more active layer in sum mode (spec §7: generalize the hard-coded 4).
  // A PLAIN pad (no layers, its sample at the slot base) counts as one active
  // layer too, so a plain pad + SYN slot in Sum mode keeps the 1/sqrt(2) split
  // it had while every load promoted the pad to a one-layer pad
  // (Spec_Swing_Long_Pad_Layer_Cap §4.2). _is_sum still gates the voice loop.
  _comp_sum = p_layer_mode[_lv_pad] == 3;
  _active_cnt = 0;
  _comp_sum ? (
    p_layer_cnt[_lv_pad] > 0 ? (
      j = 0; loop(p_layer_cnt[_lv_pad],
        l_len[_lv_pad * MAX_LAYERS + j] > 0 ? _active_cnt += 1;
        j += 1;
      );
    ) : (
      s_len[_lv_pad] > SILENCE_T + 4 ? _active_cnt += 1;
    );
    ps_enable[_lv_pad] ? _active_cnt += 1;
  );
  _sum_cnt = _is_sum ? p_layer_cnt[_lv_pad] : 1;
  _sum_cur = 0;
  while(_sum_cur < _sum_cnt) (
    _is_sum ? (
      _sel_layer = _sum_cur;
      _skip_voice = l_len[_lv_pad * MAX_LAYERS + _sel_layer] <= 0;
    ) : (
      p_layer_cnt[_lv_pad] > 0 ? (
        _sel_layer = select_layer(_lv_pad, _lv_vel / 127.0, p_layer_mode[_lv_pad]);
        // MAX_LAYERS = SYN sentinel (round-robin): this hit belongs to the
        // synth — skip the sample voice, flag the synth launch below.
        _sel_layer >= MAX_LAYERS ? ( _sel_syn = 1; _skip_voice = 1; ) : _skip_voice = 0;
      ) : (
        _sel_layer = -1;
        _skip_voice = 0;
      );
    );
    !_skip_voice ? (
      // Find free voice or oldest for steal (single pass)
      vi = -1; max_age = -1; _oldest_vi = -1;
      j = 0; loop(MAX_VOICES,
        v_pos[j] < 0 && v_stage[j] == 0 ? (
          vi < 0 ? vi = j;  // take first free slot
        ) : (
          v_age[j] > max_age ? (max_age = v_age[j]; _oldest_vi = j;);
        );
        j += 1;
      );
      vi < 0 ? ( vi = _oldest_vi; );  // no free voice — steal oldest
      // Steal: vi points at an in-use voice that needs to be replaced
      vi >= 0 && (v_pos[vi] >= 0 || v_stage[vi] > 0) ? (
        // If stolen voice was still waiting (negative v_pos, pre-delay), just kill it
        v_pos[vi] < 0 ? (
          v_pos[vi] = -1; v_env[vi] = 0; v_stage[vi] = 0;
        ) : (
          v_slot[MAX_VOICES] = v_slot[vi]; v_pos[MAX_VOICES] = v_pos[vi];
          v_startpos[MAX_VOICES] = v_startpos[vi];
          v_gain[MAX_VOICES] = v_gain[vi];
          v_env[MAX_VOICES] = v_env[vi]; v_note[MAX_VOICES] = v_note[vi];
          v_inc[MAX_VOICES] = v_inc[vi]; v_decay_ct[MAX_VOICES] = 0;
          v_sg[MAX_VOICES] = v_sg[vi]; v_layer[MAX_VOICES] = v_layer[vi];
          // synth voices carry their engine state into the steal-fade slot
          v_kind[MAX_VOICES] = v_kind[vi];
          v_kind[vi] == 1 ? memcpy(v_syn_state + MAX_VOICES * RK_SYN_STATE_SIZE,
                                   v_syn_state + vi * RK_SYN_STATE_SIZE, RK_SYN_STATE_SIZE);
          v_stage[MAX_VOICES] = 4; // LAST — audio thread gate
          // park the stolen slot NOW: @sample (concurrent with @gfx trigger
          // paths) must never observe a live voice mid-rewrite (sweep finding)
          v_stage[vi] = 0; v_pos[vi] = -1; v_env[vi] = 0;
        );
      );
      vi >= 0 ? (
        v_slot[vi] = _lv_pad;
        v_kind[vi] = 0;   // sample voice (slot may be reused from a synth voice)
        _sel_layer >= 0 && p_layer_cnt[_lv_pad] > 0 ? (
          v_layer[vi] = _sel_layer;
          _lidx = _lv_pad * MAX_LAYERS + _sel_layer;
          _slen = l_len[_lidx];
          _sstart = l_start[_lidx];
          _send = l_end[_lidx];
          _ssr = l_sr[_lidx];
        ) : (
          v_layer[vi] = 0;
          _slen = s_len[_lv_pad];
          _sstart = s_start[_lv_pad];
          _send = s_end[_lv_pad];
          _ssr = s_sr[_lv_pad];
        );
        // Clamp start/end to safe interleaved range (SILENCE_T margin for interpolation)
        _end_i = min(_send * _slen, _slen) - SILENCE_T;
        _end_i = max(0, _end_i);
        _start_i = max(0, min(_sstart * _slen, _end_i));
        // Skip launch if sample too short for safe playback
        _slen > SILENCE_T + 4 ? (
        // When MODE=Tuned, the Extension bakes the pad's audio to pitch and
        // swaps it in (~70 ms after a knob move). Playing the baked buffer at
        // native rate only sounds right ONCE the bake has caught up — until
        // then the old buffer is at the OLD pitch, which is the lag the user
        // hears. So play the RESIDUAL between the live tune and the tune the
        // current buffer is baked at (sp_baked_tune): a knob move shows up
        // INSTANTLY as a varispeed shift, and the residual returns to 0 (pure
        // duration-preserved) when the matching bake arrives. Extension absent
        // → fall back to full Repitch so the pad still tracks the knob.
        // Per-layer residual (A4/A5): each layer is baked independently, so the
        // anchor is sp_baked_tune[pad*MAX_LAYERS + selected_layer]. Layered pads
        // (Sum/VelSplit/RR) pick the sounding layer; non-layered pads (_sel_layer
        // < 0) use layer 0. Until a layer's bake lands its anchor is 0, so it
        // residual-repitches the full tune via varispeed (correct pitch, shorter
        // duration) — matching the Extension-absent fallback per layer.
        _bt_lidx = _lv_pad * MAX_LAYERS + (_sel_layer >= 0 ? _sel_layer : 0);
        // Chromatic offset: 0 for single-note pads (played == root). For a
        // chromatic pad it varispeeds the sample by the key's distance from
        // root. In Tuned mode this rides on the residual — the Extension only
        // ever bakes at p_tune (never the played note), so root plays the
        // pristine bake and off-root keys varispeed off it (no double-pitch).
        _st_off = _lv_midi - p_note[_lv_pad];
        _pt_eff = (sp_pitch_mode[_lv_pad] == SP_PITCH_MODE_TUNED ?
          (sp_pitch_ext_alive ? (p_tune[_lv_pad] - sp_baked_tune[_bt_lidx]) : p_tune[_lv_pad]) :
          p_tune[_lv_pad]) + _st_off;
        p_reverse[_lv_pad] ? (
          v_pos[vi] = _end_i;
          v_inc[vi] = -pow(2.0, _pt_eff / 12.0) * 2.0 * (_ssr > 0 ? _ssr / srate : 1.0);
        ) : (
          v_pos[vi] = _start_i;
          v_inc[vi] = pow(2.0, _pt_eff / 12.0) * 2.0 * (_ssr > 0 ? _ssr / srate : 1.0);
        );
        // Apply sample offset — absolute position in sample, clamped to trim bounds
        p_sample_offset[_lv_pad] > 0.001 ? (
          _abs_ofs = p_sample_offset[_lv_pad] * _slen;
          v_pos[vi] = max(_start_i, min(_end_i, _abs_ofs));
        );
        // Sum mode loose timing: delay non-primary layers by random 0-40 samples
        // Store real start position so delayed voice resumes at correct trim point
        v_startpos[vi] = v_pos[vi];
        // Sub-block start offset and sum-mode looseness are the same mechanism
        // -- a negative v_pos the renderer counts up -- so they simply add.
        // The +1 is the encoding, not a fudge: the renderer increments BEFORE it
        // tests, so v_pos = -N first sounds at sample N-1. Measured, not reasoned:
        // without it every repeat landed exactly one sample ahead of its step.
        _delay = _lv_ofs > 0 ? _lv_ofs + 1 : 0;
        _is_sum && _sum_cur > 0 && p_sum_tight[_lv_pad] > 0.001 ? (
          _delay += (rand(40) * p_sum_tight[_lv_pad])|0;
        );
        _delay > 0 ? v_pos[vi] = -_delay;
        v_gain[vi] = apply_vel_curve(_lv_vel / 127.0, vel_curve);
        // Sum mode: compensate gain by active (non-empty) layer count
        _comp_sum && _active_cnt > 1 ? ( v_gain[vi] = v_gain[vi] / sqrt(_active_cnt); );
        v_note[vi] = _lv_midi;   // PLAYED note (was p_note[pad]) so note-off matches the actual key
        v_age[vi] = 0;
        v_env[vi] = 0;
        v_decay_ct[vi] = 0;
        // One-Mixer console tie: while strip_takeover (multi-out + fresh
        // strip-sync heartbeat) the child track's D_VOL is the ONE audible
        // gain stage — the companion mirrors p_gain onto it, so applying
        // p_gain here too would square the gain. Layer/norm gains stay:
        // they're sample identity, not mix. Baked at launch (matches the
        // existing p_gain semantics; takeover flips affect new hits only).
        _tie_pg = strip_tk[_lv_pad] ? 1.0 : p_gain[_lv_pad];
        _sel_layer >= 0 && p_layer_cnt[_lv_pad] > 0 ? (
          _lidx = _lv_pad * MAX_LAYERS + _sel_layer;
          v_sg[vi] = _tie_pg * l_gain[_lidx] * (l_norm[_lidx] ? l_norm_gain[_lidx] : 1.0);
        ) : (
          v_sg[vi] = _tie_pg * (s_norm[_lv_pad] ? s_norm_gain[_lv_pad] : 1.0);
        );
        // v_stage MUST be set last — audio thread uses it as the gate condition.
        // Setting it before v_env/v_sg causes a race where @sample reads stale values.
        v_stage[vi] = 1;
        ) : ( // _slen too short — kill voice
          v_pos[vi] = -1; v_env[vi] = 0; v_stage[vi] = 0;
        );
      );
    );
    _sum_cur += 1;
  );

  // ── SYN slot launch (Spec_Swing_Synth_Layer §2.2) ──────────────────────
  // Independent of the sample voices. Per layer mode: sum = always underneath;
  // vel-split = plays when vel is in the ps_ range; round-robin = when the
  // extended rotation selected it (sentinel above); single = only when the pad
  // has no sample audio (the emergent "synth pad" rule — no mode flag).
  // Stretch pads excluded: their audio path is the Extension ring.
  ps_enable[_lv_pad] && sp_pitch_mode[_lv_pad] != SP_PITCH_MODE_STRETCH ? (
    _has_smp = 0;
    p_layer_cnt[_lv_pad] > 0 ? (
      j = 0; loop(p_layer_cnt[_lv_pad],
        l_len[_lv_pad * MAX_LAYERS + j] > 0 ? _has_smp = 1;
        j += 1;
      );
    ) : (
      s_len[_lv_pad] > SILENCE_T + 4 ? _has_smp = 1;
    );
    _syn_go =
      !_has_smp ? 1 :
      p_layer_mode[_lv_pad] == 3 ? 1 :
      p_layer_mode[_lv_pad] == 1 ? (
        _syn_v = _lv_vel / 127.0;
        _syn_v >= ps_vel_lo[_lv_pad] && (_syn_v < ps_vel_hi[_lv_pad] || ps_vel_hi[_lv_pad] >= 1.0)
      ) :
      p_layer_mode[_lv_pad] == 2 ? _sel_syn :
      0;
    // Body lives in launch_syn_for_pad (defined above) so the SYN view can
    // audition the engine on its own. Sum mode splits gain across the active
    // layers; every other mode plays the synth at full level, divisor 1.
    _syn_go ? (
      launch_syn_for_pad(_lv_pad, _lv_midi, _lv_vel,
                         _comp_sum && _active_cnt > 1 ? sqrt(_active_cnt) : 1,
                         _lv_ofs);
    );
  );
  pad_flash[_lv_pad] = _lv_flash;
  // Duplicate-kill + choke group (single pass)
  // Duplicate-kill: choke voices on same pad younger than lockout window
  // Choke group: kill voices on other pads sharing the same choke group
  _lv_choke = p_choke[_lv_pad];
  j = 0; loop(MAX_VOICES,
    v_pos[j] >= 0 && v_age[j] > 0 ? (
      v_slot[j] == _lv_pad ? (
        v_age[j] < _retrig_lockout ? ( v_stage[j] = 4; );  // duplicate-kill
      ) : (
        _lv_choke > 0 && p_choke[v_slot[j]] == _lv_choke ? ( v_stage[j] = 4; );  // choke group
      );
    );
    j += 1;
  );
  );  // end of Mode != Stretch branch (Step 3b launch_voices divert)
);

// Every caller that wants a hit NOW keeps the four-argument name. EEL2 has no
// overloading, so the offset-aware version needs its own -- rather than touch
// all 20 existing call sites to append a 0.
function launch_voices_for_pad(_lv_pad, _lv_midi, _lv_vel, _lv_flash) (
  launch_voices_for_pad_ofs(_lv_pad, _lv_midi, _lv_vel, _lv_flash, 0);
);
