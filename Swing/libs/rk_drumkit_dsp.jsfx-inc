// rk_drumkit_dsp.jsfx-inc — DSP + utility functions for Swing
// (c) EON Studios — All Rights Reserved
//
// Extracted from the main JSFX to keep it focused on
// memory layout, MIDI, serialization, and GUI.
//
// Requires the following global arrays/variables to be allocated before import:
//   p_attack, p_decay, p_sustain, p_release, p_tune, p_pan, p_note, p_note_lock
//   p_att_c, p_dec_c, p_rel_c, p_panL, p_panR
//   fx_hpf_freq, fx_lpf_freq, fx_eq_lo, fx_eq_mid, fx_eq_mid2, fx_eq_hi, fx_sat_drv, fx_drv_mode
//   fx_eq_lo_freq, fx_eq_mid_freq, fx_eq_mid2_freq, fx_eq_hi_freq
//   s_sr, root_note, srate
//   gfx_hpf_freq, gfx_lpf_freq, gfx_sat_drv
//   v_slot, v_pos, v_env, v_stage, _xf_active, _xf_pos, _xf_len, _xf_prev,
//   patch_live (the voice kill + crossfade helpers below)

@init

// ─── Voice kill + anti-pop crossfade: one discipline for every structural edit ──
// Every edit that rewrites a pad's audio while it may be sounding -- a browser or
// stream load, a native drop, a swap, a structural undo, a bake, a kit load --
// ends the pad's voices and arms the output crossfade through these two
// functions, so the browser path's behaviour (rk_swing_browser_load, CMD 63) is
// the behaviour everywhere (Audit A 2026-09-14: A-3 drops, A-4 swap and undo,
// A-5 the Wired pad pairs).
//
// swing_xf_len(len_s): the crossfade length in samples for a nominal len_s
//   seconds. Under Wired (patch_live) every pad leaves on channels 2..33 (bank A)
//   or 38..63 (the bank and split pairs, Outputs step 5) and
//   comes back through the Patchbay ring ONE BLOCK later, so the blend is
//   lengthened by a block: the pair's step still lands inside it when it
//   returns (A-5). samplesblock is the host's block size, valid in every section.
//
// swing_voice_kill_pad_xf(pad): end every voice on pad -- stage FIRST, since
//   @sample skips a stage-0 voice whatever its other cells hold, so a caller on
//   the UI thread never exposes a half-written voice -- then arm a 10 ms
//   crossfade when the last output was audible (-40 dB; below that the ramp
//   would only attenuate the next hit's transient before the @sample
//   short-circuit at -80 dB could end it). Touches globals only: callable from
//   @block and @gfx and from every inc imported after this one.
function swing_xf_len(len_s) (
  max(1, (len_s * srate)|0) + (patch_live ? samplesblock : 0);
);

// How loud the last tracked output was, summed over every pin the crossfade blends (the same channel count as the
// blend and the tracking in @sample: out_nch in multi-out / Wired, else 0/1). Every arm test and the @sample
// short-circuit read this: they read only 0/1, so in multi-out a kill on any pad but OUT 1's armed no fade and its
// track stepped to zero (PL G4, 2026-10-26). Read-only; callable from @block, @gfx and @sample.
function swing_xf_prev_level() local(_xl_i, _xl_n, _xl_s) (
  _xl_n = (multi_out || patch_live) ? min(out_nch, OUT_PAIRS * 2) : 2;
  _xl_s = 0; _xl_i = 0; loop(_xl_n, _xl_s += abs(_xf_prev[_xl_i]); _xl_i += 1;);
  _xl_s;
);

function swing_voice_kill_pad_xf(pad) local(_vk_i) (
  _vk_i = 0; loop(V_SLOTS,
    v_slot[_vk_i] == pad ? ( v_stage[_vk_i] = 0; v_env[_vk_i] = 0; v_pos[_vk_i] = -1; );
    _vk_i += 1;
  );
  !_xf_active && swing_xf_prev_level() > 0.01 ? (
    _xf_pos = 0;
    _xf_len = swing_xf_len(0.010);
    _xf_active = 1;
  );
);

// ─── Recalc REQUESTS: the UI thread asks, @block performs (A-9a) ───────────────
// recalc_fx / recalc_pad / cmp_recalc / recalc_global_fx keep scratch in static
// locals (rk_svf's setters, recalc_fx's _svf_base) and used to be entered from
// both threads at once, so a knob drag under a macro morph or a strip edit could
// hand one pad's targets to another (Audit A 2026-09-14, A-9). Every UI-thread
// caller now posts a request through these four and swing_block_rcp_settle
// (rk_swing_block) performs it at the top of the next @block. One block of
// latency, no cross-thread call.
//
// Lossless without atomics: each counter has ONE writer. The UI increments
// _rcp_req_*; @block owns _rcp_done_* and, when they differ, copies req into
// done and performs -- a post landing mid-perform differs again next block. (The
// macro engine's own kmac_rcp bits stay @block-private, as their comment says.)
function swing_rcp_post_fx(pad) ( _rcp_req_fx[pad] += 1; );
function swing_rcp_post_pad(pad) ( _rcp_req_pad[pad] += 1; );
function swing_rcp_post_cmp() ( _rcp_req_cmp += 1; );
function swing_rcp_post_master() ( _rcp_req_master += 1; );

// ─── Pad clicks and releases: the UI thread posts, @block launches (A-9b) ──────
// launch_voices_for_pad_ofs keeps scratch in static locals and writes the voice
// cells, so a pad clicked in the UI while a MIDI note launched could merge two
// launches (A-9). The UI's launch sites append here and @block performs the
// launch within a block (swing_block_gt_consume, rk_swing_block); the gate-mode
// mouse-up posts its release the same way (swing_block_gt_release). One writer
// per index: the UI owns _gt_wr / _gtr_wr (bumped LAST, after the payload),
// @block owns _gt_rd / _gtr_rd. A full ring drops the click.
function swing_gt_post(pad, note, vel, flash) local(_gp_i) (
  _gt_wr - _gt_rd < GT_RING ? (
    _gp_i = _gt_wr % GT_RING;
    _gt_pad[_gp_i] = pad; _gt_note[_gp_i] = note; _gt_vel[_gp_i] = vel; _gt_flash[_gp_i] = flash;
    _gt_wr += 1;   // LAST
  );
);
function swing_gt_post_release(pad) local(_gp_i) (
  _gtr_wr - _gtr_rd < GT_RING ? (
    _gp_i = _gtr_wr % GT_RING;
    _gtr_pad[_gp_i] = pad;
    _gtr_wr += 1;   // LAST
  );
);

// ─── HSL → RGB conversion ──────────────────────────────────────────────
// h = hue (0–1), s = saturation (0–1), l = lightness (0–1)
// Returns via globals: _hsl_r, _hsl_g, _hsl_b (0–1 each)
function hsl_to_rgb(h, s, l)
local(_c, _x, _m, _hp, _r1, _g1, _b1, _hp_mod2)
(
  _c = (1.0 - abs(2.0 * l - 1.0)) * s;
  _hp = h * 6.0;
  // Float modulo: JSFX % is integer-only, so use floor-based fmod
  _hp_mod2 = _hp - floor(_hp * 0.5) * 2.0;
  _x = _c * (1.0 - abs(_hp_mod2 - 1.0));
  _r1 = 0; _g1 = 0; _b1 = 0;
  _hp < 1 ? ( _r1 = _c; _g1 = _x; ) :
  _hp < 2 ? ( _r1 = _x; _g1 = _c; ) :
  _hp < 3 ? ( _g1 = _c; _b1 = _x; ) :
  _hp < 4 ? ( _g1 = _x; _b1 = _c; ) :
  _hp < 5 ? ( _r1 = _x; _b1 = _c; ) :
             ( _r1 = _c; _b1 = _x; );
  _m = l - _c * 0.5;
  _hsl_r = _r1 + _m;
  _hsl_g = _g1 + _m;
  _hsl_b = _b1 + _m;
);

// ─── Velocity curve ──────────────────────────────────────────────────────
// Takes 0–1 velocity, returns shaped 0–1 value
function apply_vel_curve(vel, curve) (
  curve == 1 ? vel * vel :        // soft  — need harder hits for loud
  curve == 2 ? sqrt(vel) :        // hard  — light hits still loud
  curve == 3 ? 1.0 :              // fixed — always full velocity
  vel;                             // 0 = linear (default)
);

// ─── Repeat interval (samples per division at current tempo) ─────────────
// Division map: 0=OFF, then groups of 3: straight, triplet, dotted
// 1=1/4  2=1/4T  3=1/4D   4=1/8  5=1/8T  6=1/8D
// 7=1/16 8=1/16T 9=1/16D  10=1/32 11=1/32T 12=1/32D
// 13=1/64 14=1/64T 15=1/64D
RPT_NUM_DIVS = 15;
function get_rpt_interval(div) local(beat_samples, base) (
  beat_samples = (60.0 / (tempo > 0 ? tempo : 120)) * srate;  // samples per quarter note
  div == 1  ? beat_samples :                 // 1/4
  div == 2  ? beat_samples * 2.0 / 3.0 :    // 1/4T
  div == 3  ? beat_samples * 1.5 :           // 1/4D
  div == 4  ? beat_samples * 0.5 :           // 1/8
  div == 5  ? beat_samples * 0.5 * 2.0 / 3.0 : // 1/8T
  div == 6  ? beat_samples * 0.5 * 1.5 :     // 1/8D
  div == 7  ? beat_samples * 0.25 :          // 1/16
  div == 8  ? beat_samples * 0.25 * 2.0 / 3.0 : // 1/16T
  div == 9  ? beat_samples * 0.25 * 1.5 :    // 1/16D
  div == 10 ? beat_samples * 0.125 :         // 1/32
  div == 11 ? beat_samples * 0.125 * 2.0 / 3.0 : // 1/32T
  div == 12 ? beat_samples * 0.125 * 1.5 :   // 1/32D
  div == 13 ? beat_samples * 0.0625 :        // 1/64
  div == 14 ? beat_samples * 0.0625 * 2.0 / 3.0 : // 1/64T
  div == 15 ? beat_samples * 0.0625 * 1.5 :  // 1/64D
  0;
);

// Get division display name into #_rpt_name
function get_rpt_div_name(div) (
  div == 0  ? strcpy(#_rpt_name, "OFF") :
  div == 1  ? strcpy(#_rpt_name, "1/4") :
  div == 2  ? strcpy(#_rpt_name, "1/4T") :
  div == 3  ? strcpy(#_rpt_name, "1/4D") :
  div == 4  ? strcpy(#_rpt_name, "1/8") :
  div == 5  ? strcpy(#_rpt_name, "1/8T") :
  div == 6  ? strcpy(#_rpt_name, "1/8D") :
  div == 7  ? strcpy(#_rpt_name, "1/16") :
  div == 8  ? strcpy(#_rpt_name, "1/16T") :
  div == 9  ? strcpy(#_rpt_name, "1/16D") :
  div == 10 ? strcpy(#_rpt_name, "1/32") :
  div == 11 ? strcpy(#_rpt_name, "1/32T") :
  div == 12 ? strcpy(#_rpt_name, "1/32D") :
  div == 13 ? strcpy(#_rpt_name, "1/64") :
  div == 14 ? strcpy(#_rpt_name, "1/64T") :
  div == 15 ? strcpy(#_rpt_name, "1/64D") :
  strcpy(#_rpt_name, "?");
);

// ─── DSP coefficient recalc for pad i ─────────────────────────────────────
function recalc_pad(i) (
  // Factor of 5.0 makes envelope reach ~99% of target within the specified time
  p_att_c[i]  = exp(-5.0 / max(1, p_attack[i]  * 0.001 * srate));
  p_dec_c[i]  = exp(-5.0 / max(1, p_decay[i]   * 0.001 * srate));
  p_rel_c[i]  = exp(-5.0 / max(1, p_release[i] * 0.001 * srate));
  p_panL[i] = 1.0 - max(0.0, p_pan[i]);
  p_panR[i] = 1.0 + min(0.0, p_pan[i]);
  !p_note_lock[i] ? p_note[i] = min(127, root_note + i);   // step 4d: root + slot passes 127 in bank D for a root above 64
);

// ─── Per-pad compressor coefficient recalc ───────────────────────────────
// Fixed presets by mode: PUNCH(0), GLUE(1), SQUASH(2).
// All coefficients derived from mode + srate — no per-pad tuning needed.
function recalc_pad_comp(i)
local(_mode, _amt, _atk_ms, _rel_ms, _ratio, _knee, _max_thresh, _thresh, _sr, _makeup_db)
(
  _mode = fx_cmp_mode[i] | 0;
  _amt  = max(0, min(1, fx_cmp_amt[i]));
  _sr = max(srate, 1);

  // Mode sets character (attack/release/ratio/knee) + the threshold floor
  // reached at amt = 1. Knob amt acts as a "drive into the compressor"
  // control: higher amt = lower threshold = more material above threshold
  // = more compression. This is how Sitala-style one-knob compressors work,
  // and it lets sends handle parallel compression separately.
  _mode == 0 ? ( // PUNCH: fast attack, short release, strong ratio
    _atk_ms = 1; _rel_ms = 50; _ratio = 4; _knee = 3; _max_thresh = -30;
  ) :
  _mode == 1 ? ( // GLUE: slow attack, medium release, light ratio
    _atk_ms = 30; _rel_ms = 150; _ratio = 2; _knee = 6; _max_thresh = -24;
  ) : ( // SQUASH: medium attack, long release, heavy ratio
    _atk_ms = 10; _rel_ms = 300; _ratio = 8; _knee = 2; _max_thresh = -40;
  );

  // Threshold scales with amount: 0 dB at amt=0 (effectively off — no signal
  // exceeds 0 dBFS), mode-defined floor at amt=1. Linear in dB.
  _thresh = _max_thresh * _amt;

  fx_cmp_at_c[i]      = exp(-1 / (_sr * _atk_ms * 0.001));
  fx_cmp_rel_c[i]     = exp(-1 / (_sr * _rel_ms * 0.001));
  fx_cmp_inv_ratio[i] = 1 / max(_ratio, 1.0001);
  fx_cmp_thresh[i]    = _thresh;
  fx_cmp_knee_lo[i]   = _thresh - _knee * 0.5;
  fx_cmp_knee_hi[i]   = _thresh + _knee * 0.5;
  fx_cmp_knee_inv[i]  = _knee > 0 ? 1 / (2 * _knee) : 0;
  fx_cmp_knee_lo_lin[i] = exp((_thresh - _knee * 0.5) * 0.11512925465);

  // Auto-makeup: 1/4 of theoretical max GR at threshold (was 1/2 — too
  // aggressive, masked the compression effect by boosting everything). At
  // 1/4 the makeup partially compensates for level loss but leaves the
  // compression audibly present. User can use master gain or sends for
  // parallel/wet level control.
  _makeup_db = -_thresh * (1 - 1 / _ratio) * 0.25;
  fx_cmp_makeup_lin[i] = exp(_makeup_db * 0.11512925465);
);

// ─── Per-pad FX coefficient recalc ──────────────────────────────────────
function recalc_fx(i) local(_svf_base, _sfi) (
  // Bitcrush: precompute quantization levels (avoid per-sample pow())
  fx_bc_lvl[i] = pow(2, max(1, min(16, fx_bc_bits[i] | 0)) - 1);

  // ── SVF filter retargeting (rk_svf) ──
  // Sets glide targets; coefficients chase them in @sample via svf_tick —
  // a one-pole glide with a SVF_SMOOTH_MS (12 ms) time constant, not a
  // fixed-length ramp (rk_svf.jsfx-inc documents the 2026-06-17 switch).
  // ⚠️ svf_set_* dedups the TARGET WRITE, not the arithmetic. Each setter
  // computes its pow() and tan() BEFORE handing values to svf_set_target, so
  // re-running all five costs ~10 transcendentals whether or not anything
  // moved. (The comment here used to say re-running them was cheap; it isn't,
  // and anyone budgeting this path was being misled.) Cheap ENOUGH -- a full
  // 16-pad rebuild measures well under 1% of a block -- but do not treat a
  // redundant recalc_fx as free.
  // ⭐ The dedup DOES still buy the thing it was written for: skipping the
  // target write means re-running all five filters when one knob moves does
  // not restart the others' in-progress glides. That guarantee is intact --
  // it was only the "and it's cheap" half that was wrong.
  _svf_base = svf_pad + i * SVF_PER_PAD * SVF_STEREO_SIZE;
  // HPF: 2nd-order highpass (Q from per-pad resonance knob)
  fx_hpf_freq[i] > 25 ?
    svf_set_highpass(_svf_base + SVF_PAD_HPF * SVF_STEREO_SIZE, fx_hpf_freq[i], fx_reso[i])
  : (
    svf_set_bypass(_svf_base + SVF_PAD_HPF * SVF_STEREO_SIZE);
    // Clear residual-tracking state so bypassed filter doesn't block pad sleep
    fx_hpf_stL[i] = 0; fx_hpf_stR[i] = 0;
  );
  // LPF: 2nd-order lowpass (Q from per-pad resonance knob)
  fx_lpf_freq[i] < 19500 ?
    svf_set_lowpass(_svf_base + SVF_PAD_LPF * SVF_STEREO_SIZE, fx_lpf_freq[i], fx_reso[i])
  : (
    svf_set_bypass(_svf_base + SVF_PAD_LPF * SVF_STEREO_SIZE);
    fx_lpf_stL[i] = 0; fx_lpf_stR[i] = 0;
  );
  // Low shelf: frequency from fx_eq_lo_freq[i], per-pad Q (v48; 0.7071 == old S=1.0)
  svf_set_lowshelf_q(_svf_base + SVF_PAD_LO * SVF_STEREO_SIZE, fx_eq_lo_freq[i], fx_eq_lo[i], fx_eq_lo_q[i]);
  // Mid peaking: frequency from fx_eq_mid_freq[i], per-pad Q (default 0.8)
  svf_set_bell(_svf_base + SVF_PAD_MID * SVF_STEREO_SIZE, fx_eq_mid_freq[i], fx_eq_mid[i], fx_eq_mid_q[i]);
  // Hi-mid peaking (v46 4th band): frequency from fx_eq_mid2_freq[i], per-pad Q
  svf_set_bell(_svf_base + SVF_PAD_MID2 * SVF_STEREO_SIZE, fx_eq_mid2_freq[i], fx_eq_mid2[i], fx_eq_mid2_q[i]);
  // High shelf: frequency from fx_eq_hi_freq[i], per-pad Q (v48)
  svf_set_highshelf_q(_svf_base + SVF_PAD_HI * SVF_STEREO_SIZE, fx_eq_hi_freq[i], fx_eq_hi[i], fx_eq_hi_q[i]);

  // Pad silent (same condition as process_pad_fx's signal gate, which is
  // what runs svf_tick)? Then the coefficient glide is FROZEN mid-chase —
  // svf_tick only runs while audio flows — and would resume across the
  // NEXT hit's first SVF_SMOOTH_MS (12 ms): the transient, so the first
  // hit after a silent tweak sounds like the OLD curve. No audio is
  // flowing, so snapping straight to the new targets is inaudible and the
  // next hit starts on the new curve. The glide still applies to tweaks
  // made while the pad is sounding (the case smoothing exists for).
  // fx_res[i] is the gate's fourth term (rk_drumkit_fx): a tail living in R or
  // in the EQ integrators keeps the pad awake, so a bell moved while only that
  // tail rings must glide, not snap (LIB217).
  (abs(pad_accL[i]) < 0.0000001 && abs(pad_accR[i]) < 0.0000001 &&
   abs(fx_hpf_stL[i]) < 0.0000001 && abs(fx_lpf_stL[i]) < 0.0000001 &&
   fx_res[i] <= 0) ? (
    _sfi = 0; loop(SVF_PER_PAD,
      svf_snap(_svf_base + _sfi * SVF_STEREO_SIZE);
      _sfi += 1;
    );
  );

  // Per-pad compressor coefficients (mode-dependent)
  recalc_pad_comp(i);
);

// ─── Drive mode processing (per-sample, called from @sample FX chain) ──
// Takes pre-driven stereo pair (already multiplied by 8x drive gain),
// applies selected curve, returns via _doL/_doR.
// mode: 0=SOFT, 1=TUBE, 2=TAPE, 3=FUZZ, 4=CLIP
// All curves are normalized so unity-in ≈ unity-out at moderate drive.
function drive_process(xL, xR, mode)
local(_x2L, _x2R, _absL, _absR)
(
  mode == 0 ? (
    // SOFT — rational tanh: x*(27+x²)/(27+9x²)
    _x2L = xL * xL; _x2R = xR * xR;
    _doL = xL * (27.0 + _x2L) / (27.0 + 9.0 * _x2L);
    _doR = xR * (27.0 + _x2R) / (27.0 + 9.0 * _x2R);
  ) :
  mode == 1 ? (
    // TUBE — asymmetric soft clip (even harmonics, warm 2nd-order character)
    // Positive half: softer, negative half: harder compression
    _absL = abs(xL); _absR = abs(xR);
    _doL = xL >= 0
      ? xL / (1.0 + _absL)                          // gentle positive
      : xL / (1.0 + _absL * _absL * 0.6);           // squashed negative
    _doR = xR >= 0
      ? xR / (1.0 + _absR)
      : xR / (1.0 + _absR * _absR * 0.6);
    // The asymmetry emits DC and there is NO HPF after the drive: every caller
    // follows TUBE with its own TUBE-only DC blocker (see rk_drumkit_fx.jsfx-inc).
    // The x1.2 below is output gain, not an offset.
    _doL *= 1.2; _doR *= 1.2;
  ) :
  mode == 2 ? (
    // TAPE — smooth cubic-ish saturation with gentle knee + soft limiting
    // Emulates magnetic hysteresis compression on transients
    _doL = xL > 1.0  ?  0.6667 + (xL - 1.0) / (1.0 + (xL - 1.0) * 3.0) * 0.3333
         : xL < -1.0 ? -0.6667 - (-xL - 1.0) / (1.0 + (-xL - 1.0) * 3.0) * 0.3333
         : xL - xL * xL * xL / 3.0;
    _doR = xR > 1.0  ?  0.6667 + (xR - 1.0) / (1.0 + (xR - 1.0) * 3.0) * 0.3333
         : xR < -1.0 ? -0.6667 - (-xR - 1.0) / (1.0 + (-xR - 1.0) * 3.0) * 0.3333
         : xR - xR * xR * xR / 3.0;
    // Tape tends to glue — slightly reduce output for natural compression feel
    _doL *= 1.15; _doR *= 1.15;
  ) :
  mode == 3 ? (
    // FUZZ — hard asymmetric clip with bias, gnarly transistor breakup
    // Adds odd + even harmonics, heavy coloring for aggressive drum sounds
    _doL = max(-0.7, min(1.0, xL * 1.3 + 0.1));
    _doR = max(-0.7, min(1.0, xR * 1.3 + 0.1));
    // Remove bias DC
    _doL -= 0.1; _doR -= 0.1;
  ) :
  (
    // CLIP — hard digital brick-wall, clean and punchy
    _doL = max(-1.0, min(1.0, xL));
    _doR = max(-1.0, min(1.0, xR));
  );
);

// ─── Unified master chain recalc (HPF + LPF + EQ + sat) ─────────────────
// Single function eliminates any state desync between EQ and HPF/LPF/sat.
// Called from all paths: UI drags, @slider, preset load, srate change, etc.
function recalc_global_fx() local(_bm) (
  // ── Master SVF filters (audio only — curve computes its own) ──
  // Sets one-pole glide targets; coefficients chase in @sample via svf_tick.
  // Off HPF/LPF glide to unity-dry (svf_set_bypass) so the @sample chain can
  // always-process them click-free. Magnitude matches the old RBJ biquads at
  // matching knob values (svf_parity_check.py): shelves S=1.0, bells Q=0.8,
  // HPF/LPF Q=0.707. (Those are now the DEFAULTS of the per-mode Q below.)
  _bm = svf_master;
  // HPF
  gfx_hpf_freq > 25 ?
    svf_set_highpass(_bm + SVF_MST_HPF * SVF_STEREO_SIZE, gfx_hpf_freq, 0.707)
  : svf_set_bypass(_bm + SVF_MST_HPF * SVF_STEREO_SIZE);
  // LPF
  gfx_lpf_freq < 19500 ?
    svf_set_lowpass(_bm + SVF_MST_LPF * SVF_STEREO_SIZE, gfx_lpf_freq, 0.707)
  : svf_set_bypass(_bm + SVF_MST_LPF * SVF_STEREO_SIZE);
  // EQ bands — NO ternary, flat if-blocks to avoid JSFX parse ambiguity
  // Q per MODE, wheel-adjustable (ser_ver 75): LO and HI switch between shelf
  // and bell, so each mode keeps its own Q and toggling brings back that
  // mode's shape. Shelves use the DIRECT-Q setters (rk_svf, added for the
  // per-pad EQ's v48): k = 1/Q, and Q = 1/sqrt(2) gives exactly the k = sqrt(2)
  // that the old fixed S = 1.0 produced at every gain, so the default is
  // bit-identical. Bells default to the old fixed 0.8.
  // ⚠️ SHARED with EON_Tone.jsfx: Tone must define all five gfx_eq_*_q before
  // this runs, or they read 0 and every band becomes a needle-thin spike.
  meq_lo_bell == 0 ? (
    svf_set_lowshelf_q(_bm + SVF_MST_LO * SVF_STEREO_SIZE, gfx_eq_lo_freq, gfx_eq_lo, gfx_eq_lo_sq);
  );
  meq_lo_bell != 0 ? (
    svf_set_bell(_bm + SVF_MST_LO * SVF_STEREO_SIZE, gfx_eq_lo_freq, gfx_eq_lo, gfx_eq_lo_bq);
  );
  svf_set_bell(_bm + SVF_MST_MID * SVF_STEREO_SIZE, gfx_eq_mid_freq, gfx_eq_mid, gfx_eq_mid_q);
  meq_hi_bell == 0 ? (
    svf_set_highshelf_q(_bm + SVF_MST_HI * SVF_STEREO_SIZE, gfx_eq_hi_freq, gfx_eq_hi, gfx_eq_hi_sq);
  );
  meq_hi_bell != 0 ? (
    svf_set_bell(_bm + SVF_MST_HI * SVF_STEREO_SIZE, gfx_eq_hi_freq, gfx_eq_hi, gfx_eq_hi_bq);
  );
);

// The UI's master-chain recalc: a request, performed by @block next block (A-9a).
function recalc_master_eq() ( swing_rcp_post_master(); );

// ─── Check if pad has any audio loaded ─────────────────────────────────────
// pad_has_audio = "has SAMPLE audio" (storage truth — blank-pad/embed logic
// depends on this staying sample-only).
function pad_has_audio(i) local(li) (
  s_len[i] > 0 ? 1 : (
    p_layer_cnt[i] > 0 ? (
      li = 0;
      while(li < p_layer_cnt[i] && l_len[i * MAX_LAYERS + li] <= 0) ( li += 1; );
      li < p_layer_cnt[i];
    ) : 0;
  );
);

// Trigger/preview paths use THIS: an enabled SYN slot makes a pad playable
// with no samples (the emergent synth-only pad, Spec_Swing_Synth_Layer §1).
// Defined AFTER pad_has_audio — EEL2 resolves function refs at def time.
function pad_is_playable(i) (
  pad_has_audio(i) || ps_enable[i] > 0.5;
);

// ════════════════════════════════════════════════════════════════════════
// Internal per-pad PARAM undo/redo engine (v2, Phase 1A)
//
// Swing's orange UNDO/REDO buttons formerly fired REAPER's GLOBAL Ctrl+Z
// (gmem CMD 80/81 -> bridge -> Main_OnCommand 40029/40030), which restores a
// whole-project chunk — one click could roll a loaded kit back to empty (the
// "pads 10-16 wiped after Undo" bug). This engine gives Swing a Swing-scoped,
// action-granular undo of per-pad PARAMETER edits (knob drags: tune / pan /
// vol / ADSR / FX / etc.), held in freemem, session-volatile.
//
// Capture model (wired in the @gfx frame + mark_dirty_pad):
//   * mouse-DOWN edge  -> undo_capture_baseline()  snapshots all pads (pre-edit)
//   * a param edit      -> mark_dirty_pad() sets _udo_pend[pad]
//   * mouse-UP edge    -> undo_commit_gesture()    pushes ONE entry per pad
//                         touched this gesture (one knob drag = one undo step)
//
// 1-level structural rule: any audio-structural op (clear / load / swap /
// kit / new) zeroes _udo_uc/_udo_rc inline — undoing param tweaks from
// before a structural change is meaningless. Structural (audio) undo = Phase 2.
//
// Field set = per-pad undoable scalars + per-layer metadata. NOT audio, NOT
// names/paths (param edits never change those). The pointer tables udo_fs[] /
// udo_fl[] are built once in the main @init (Swing_ReaKit.jsfx) and are the
// single source of truth for which arrays get snapshotted.
//
// Defined here (after recalc_pad/recalc_fx above, before swap_pads + the core
// clear/load functions below) so every caller can resolve these at def-time.
// Globals (udo_*, UDO_*) are set in the main @init and resolve at run-time.
// ════════════════════════════════════════════════════════════════════════

// Copy one pad's live field set into the packed slot at base `dst`.
function undo_pack(dst, pad) local(k, off, _fb, l) (
  k = 0;
  loop(UDO_NS,
    _fb = udo_fs[k];
    dst[k] = _fb[pad];
    k += 1;
  );
  off = UDO_NS;
  k = 0;
  loop(UDO_NL,
    _fb = udo_fl[k];
    l = 0;
    loop(MAX_LAYERS,
      dst[off] = _fb[pad * MAX_LAYERS + l];
      off += 1; l += 1;
    );
    k += 1;
  );
);

// Restore one pad's field set from the packed slot at base `src`.
function undo_unpack(src, pad) local(k, off, _fb, l) (
  k = 0;
  loop(UDO_NS,
    _fb = udo_fs[k];
    k == UDO_K_OUT && _udo_skip_out ? 0 : ( _fb[pad] = src[k]; );   // the output choice is REAPER's undo's (UDO_K_OUT)
    k += 1;
  );
  off = UDO_NS;
  k = 0;
  loop(UDO_NL,
    _fb = udo_fl[k];
    l = 0;
    loop(MAX_LAYERS,
      _fb[pad * MAX_LAYERS + l] = src[off];
      off += 1; l += 1;
    );
    k += 1;
  );
);

// ════════════════════════════════════════════════════════════════════════
// REAPER undo points for Swing's own edits (2026-10-27, the owner's decision 1)
//
// From Phase 1B (2026-06-29) to 3.0.20 Swing told REAPER nothing about its edits: mark_dirty only raised the project-
// dirty flag. The reason was real -- every edit then bumped a hidden counter through slider_automate, so REAPER minted
// points that held stale copies of Swing, and Swing's own UNDO button fired REAPER's global undo, which rolled whole
// kits back ("pads 10-16 wiped"). The cure left REAPER's stored copy of Swing stale instead, which the measurement of
// 2026-10-27 caught (.docs/audits/Swing_Undo_Map_Measured_2026-10-27.md): Ctrl+Z of a later step took back unrecorded
// edits and even a kit load, and an edit made after the last recorded step could be lost for good (I2, I8).
//
// Now every FINISHED gesture asks for ONE point, made by the Kit Bridge (eon_rup_tick, the EON_RUP mailbox) the wiki
// 6.23 way: an undo block around a nudge of "Dirty: Global", named for the edit ("Swing: pad 5 VOL"). REAPER's copy is
// current after every edit and Ctrl+Z takes back exactly the last one. What keeps Phase 1B's problems away: never per
// mouse move (a gesture's end only); never from a REAPER restore (_srz_udo_hold: a read asks for nothing and captures
// nothing); never for housekeeping or automation (only the face's gestures and the named user operations ask); never
// twice (a gesture that moved one of REAPER's own parameters gets REAPER's "Edit FX parameter" point, an output choice
// gets the bridge's, a press handed to a bridge command with its own point -- rup_skip -- asks for none); and Swing's
// UNDO / REDO stay Swing's own (each press is a point like any edit; REAPER restoring Swing clears them,
// swing_rup_restore_heal).
//
// Who asks: the end of a gesture (undo_commit_gesture: the mouse-up, the wheel / right-button bracket) -- the pads
// that changed (the param diff names the pad and the field), else a kit-level edit (mark_dirty_kit / mark_dirty_play
// since the gesture began), else a pad edit outside the param fields; and named operations wherever they land -- a
// sample dropped or loaded into a pad, a pad / a layer cleared and two pads swapped (the CMD 46 handshake), Clear All,
// New Kit, a rename committed, a bank switch, Swing's UNDO / REDO. A gesture's request goes out at its end; one made
// outside a gesture once RUP_SETTLE passed with no button held, or at the next press, so the next gesture never lands
// in the previous point (that press waits until the bridge made it: swing_rup_hold, 2026-10-29). Kit loads are the
// bridge's own point, made when the import lands (eon_kitpt_*).
// ════════════════════════════════════════════════════════════════════════

// The REAPER parameters the face moves through slider_automate, as one number: a gesture that moves any of them gets
// REAPER's own "Edit FX parameter" point, so it asks for no second one. Root note, MIDI thru, pad face, embed icons, the
// four knob-look rows, macro focus, NAME BAR, HOVER, BANK COLOURS, PAD WAVE. Not the master volume or the macros
// (automation plays them, and the face's moves of them mark nothing) and not the sliderchange-only ones (adsr_3node,
// map_override_locked: REAPER makes no point for those).
function swing_rup_slsum() (
  slider1 + 3 * slider22 + 5 * slider25 + 7 * slider26 + 11 * slider27 + 13 * slider28 + 17 * slider29 +
  19 * slider30 + 23 * slider41 + 29 * slider45 + 31 * slider46 + 37 * slider47 + 41 * slider48;
);
// The mark the next gesture end compares against: taken where a gesture begins and at every end.
function swing_rup_mark() (
  rup_kn0 = rup_kn; rup_sl0 = swing_rup_slsum(); rup_ou0 = out_ureq; rup_skip = 0;
);
// Ask for a point. A stronger request keeps its words over a weaker one waiting with it (a New Kit's bank switch IS
// the New Kit); two of a kind keep the latest; rup_wn counts them. Nothing while a kit loads (the bridge's load point
// covers it) or while REAPER restores Swing.
function swing_rup_want(kind, a, b, c, f) local(_p) (
  !kit_busy && !_srz_udo_hold ? (
    _p = (kind == RUP_K_UNDO || kind == RUP_K_REDO) ? 9 : (kind == RUP_K_NEWKIT || kind == RUP_K_CLEARALL) ? 8 :
         (kind == RUP_K_CLEARPAD || kind == RUP_K_CLEARLAYER || kind == RUP_K_SWAP) ? 7 : kind == RUP_K_SAMPLE ? 6 :
         (kind == RUP_K_RENAME || kind == RUP_K_BANKNAME) ? 5 : (kind == RUP_K_PAD || kind == RUP_K_PADS) ? 4 :
         kind == RUP_K_KIT ? 3 : 2;
    (!rup_want || _p >= rup_wpri) ? (
      rup_wkind = kind; rup_wa = a; rup_wb = b; rup_wc = c; rup_wf = f; rup_wpri = _p;
    );
    rup_wn = rup_want ? rup_wn + 1 : 1;
    rup_want = 1; rup_want_t = time_precise();
  );
);
// The console tie's VOL / PAN, published NOW, right before a request goes out (round 2, 2026-10-29: the typed-Ctrl+Z
// race). The bridge mirrors them into the pad tracks' faders inside the point (eon_rup_tie), but the strip band's own
// publish runs every 4th @block (Swing_ReaKit @block, "Publish the full per-pad FX state"), so a request served before
// it carried the OLD values: the point held Swing's new VOL beside the old fader, and a Ctrl+Z back to that point let
// the Strip Sync take the old fader for the user's move and write it into Swing -- the edit lost (EON_Probe_UndoMap
// K2M, 1 run in 10 with Multi-Out tracks: right after the undo Swing's pad 5 read 0.485 and its fader 0.468; 62 ms
// later Swing read 0.468). The same values the @block publish writes (bank A's sixteen lanes; a split pair's owner),
// from the same arrays, so the two writers never disagree.
function swing_rup_tie_pub() local(_rt_b, _rt_pb, _rt_i, _rt_o) (
  _reg_my_slot >= 0 && _reg_my_slot < 16 ? (
    _rt_b = GS_STRIP_BASE + _reg_my_slot * GS_STRIP_STRIDE;
    _rt_i = 0; loop(NUM_PADS,
      _rt_pb = _rt_b + GS_STRIP_PADS + _rt_i * GS_STRIP_PAD_STRIDE;
      gmem[_rt_pb + GS_STRIP_PAD_OFF_VOL] = pad_is_playable(_rt_i) ? p_gain[_rt_i] : -1;
      gmem[_rt_pb + GS_STRIP_PAD_OFF_PAN] = p_pan[_rt_i];
      _rt_i += 1;
    );
    _rt_b = GS_SPLIT_BASE + _reg_my_slot * GS_SPLIT_STRIDE;
    _rt_i = 0; loop(OUT_PAIRS - OUT_PAIR_SPLIT,
      _rt_o = strip_spl_own[_rt_i];
      _rt_o >= 0 ? (
        _rt_pb = _rt_b + _rt_i * GS_STRIP_PAD_STRIDE;
        gmem[_rt_pb + GS_STRIP_PAD_OFF_VOL] = pad_is_playable(_rt_o) ? p_gain[_rt_o] : -1;
        gmem[_rt_pb + GS_STRIP_PAD_OFF_PAN] = p_pan[_rt_o];
      );
      _rt_i += 1;
    );
  );
);
// Post the waiting request into this instance's EON_RUP row: the words first, SEQ LAST, seeded above whatever the row
// holds (a slot's earlier owner's count never hides this one's first post). The console tie's values go out before
// the SEQ too (swing_rup_tie_pub): the point the bridge makes for it mirrors the faders from them.
function swing_rup_post() local(_rb) (
  rup_want ? (
    rup_want = 0; rup_now = 0;
    _reg_my_slot >= 0 && _reg_my_slot < 16 ? (
      swing_rup_tie_pub();
      _rb = EON_RUP_BASE + _reg_my_slot * EON_RUP_STRIDE;
      gmem[_rb + 1] = rup_wkind; gmem[_rb + 2] = rup_wa; gmem[_rb + 3] = rup_wb; gmem[_rb + 4] = rup_wc;
      gmem[_rb + 5] = rup_wf; gmem[_rb + 6] = rup_wn;
      rup_seq = max(rup_seq, gmem[_rb] | 0) + 1;
      gmem[_rb] = rup_seq;
      rup_posts += 1;
      rup_post_t = time_precise();   // a typed Ctrl+Z waits for it until SERVED (swing_rup_unserved)
    );
  );
);
// Every @gfx pass (idle ones too): a gesture's request goes out at once (rup_now), one made outside a gesture once
// RUP_SETTLE passed with no button held (_hold, the caller's: the left button down, a wheel bracket open). Nothing
// while @serialize reads (a REAPER restore). A sample a browser landed (rk_swing_browser_load: @block, which only
// counts it, so the words have one writer) becomes a request here first.
function swing_rup_tick(_hold) (
  rup_ld_n != rup_ld_seen ? ( rup_ld_seen = rup_ld_n; swing_rup_want(RUP_K_SAMPLE, rup_ld_pad, rup_ld_lay, -1, 1); );
  rup_want && !_srz_udo_hold && (rup_now || (!_hold && time_precise() - rup_want_t >= RUP_SETTLE)) ? swing_rup_post();
);
// A gesture begins: whatever still waits goes out first, then the mark.
function swing_rup_gstart() (
  rup_want ? swing_rup_post();
  swing_rup_mark();
);
// The fields that differ between the packed pads at `a` and `b`, the output choice left out (UDO_K_OUT): rup_dk the
// first (a scalar's index into udo_fs, or 1000 + layer field * 10 + layer), rup_dk2 the second, rup_dn how many.
// `!=` as undo_commit_gesture's change test has it, so the two agree on what changed.
function swing_rup_diff(a, b) local(k, _cd) (
  rup_dk = -1; rup_dk2 = -1; rup_dn = 0; k = 0;
  loop(UDO_STRIDE,
    k != UDO_K_OUT && a[k] != b[k] ? (
      _cd = k < UDO_NS ? k : 1000 + (((k - UDO_NS) / MAX_LAYERS) | 0) * 10 + ((k - UDO_NS) % MAX_LAYERS);
      rup_dn == 0 ? ( rup_dk = _cd; ) : rup_dn == 1 ? ( rup_dk2 = _cd; );
      rup_dn += 1;
    );
    k += 1;
  );
);
// A gesture ended (undo_commit_gesture): _gn pads changed in the param fields (_gp the first, _gk / _gk2 its first two
// fields, _gnk how many), else what was counted since the mark. Skipped when the gesture's point is someone else's.
// A pad edit outside the param fields (none of the face's knobs or buttons) asks for nothing here: counting
// mark_dirty_pad would also count the Strip Sync's and the Pad FX window's edits landing in @block mid-gesture.
function swing_rup_gend(_gn, _gp, _gk, _gk2, _gnk) (
  !(rup_skip || _srz_udo_hold || swing_rup_slsum() != rup_sl0 || out_ureq != rup_ou0) ? (
    _gn == 1 ? swing_rup_want(RUP_K_PAD, _gp, _gk, _gk2, _gnk) :
    _gn > 1 ? swing_rup_want(RUP_K_PADS, _gn, _gp, -1, 0) :
    rup_kn != rup_kn0 ? swing_rup_want(RUP_K_KIT, 0, -1, -1, 0);
  );
  rup_want ? ( rup_now = 1; );
  swing_rup_mark();
);

// Snapshot every pad's pre-edit state into the baseline buffer. Called on the
// mouse-DOWN edge so a subsequent edit can be reverted to this state. No-op
// while we are restoring (so an undo can't re-snapshot its own result).
// The REAPER-point mark rides along (swing_rup_gstart): every caller is where a gesture begins.
function undo_capture_baseline() local(p) (
  _udo_applying ? 0 : (
    p = 0;
    loop(NUM_SLOTS,
      undo_pack(udo_base + p * UDO_STRIDE, p);
      p += 1;
    );
  );
  swing_rup_gstart();
);

// Push the baseline snapshot of `pad` as a new undo entry (drops oldest when
// the ring is full).
function undo_push_param(pad) (
  _udo_uc >= UDO_DEPTH ? (
    memcpy(udo_ust, udo_ust + UDO_STRIDE, (UDO_DEPTH - 1) * UDO_STRIDE);
    memcpy(udo_ust_pad, udo_ust_pad + 1, UDO_DEPTH - 1);
    _udo_uc = UDO_DEPTH - 1;
  );
  memcpy(udo_ust + _udo_uc * UDO_STRIDE, udo_base + pad * UDO_STRIDE, UDO_STRIDE);
  udo_ust_pad[_udo_uc] = pad;
  _udo_uc += 1;
);

// On the mouse-UP edge: commit one undo entry per pad touched this gesture.
// The gesture's REAPER point is asked for here too (swing_rup_gend), named by the first pad that changed.
function undo_commit_gesture() local(p, pushed, k, _changed, _b, _gn, _gp) (
  pushed = 0; _gn = 0; _gp = -1;
  p = 0;
  loop(NUM_SLOTS,
    _udo_pend[p] ? (
      _udo_pend[p] = 0;
      // Only record an undo entry if the pad's state ACTUALLY changed vs the
      // pre-edit baseline — a mere select/hit (mark_dirty without a real edit)
      // must not leave a no-op entry that "wastes" an undo click.
      undo_pack(udo_cmp, p);
      _b = udo_base + p * UDO_STRIDE; _changed = 0; k = 0;
      loop(UDO_STRIDE, k != UDO_K_OUT && udo_cmp[k] != _b[k] ? _changed = 1; k += 1;);   // an output choice alone is no entry (UDO_K_OUT)
      _changed ? (
        undo_push_param(p); pushed = 1;
        _gn == 0 ? ( _gp = p; swing_rup_diff(_b, udo_cmp); );   // the point's words: the first pad that changed
        _gn += 1;
      );
    );
    p += 1;
  );
  pushed ? ( _udo_rc = 0; );  // a fresh edit invalidates the redo branch
  swing_rup_gend(_gn, _gp, rup_dk, rup_dk2, rup_dn);
);
// A press waits for the point before it (the 3.0.20 release review #1, 2026-10-29). The bridge makes a request's point
// at its next tick from Swing's LIVE state (eon_rup_tick: the "Dirty: Global" nudge inside the block), and a press used
// to post what waited (swing_rup_gstart) and land its own edit in the same pass: a rename committed, then MUTE within
// the settle, and "Swing: rename pad 3" already held the mute -- Ctrl+Z of the MUTE point changed nothing, the next one
// took back both. Now, at the @gfx head, a left or right press or a wheel notch posts what waits, and while this
// instance's last request is posted but not yet SERVED (the bridge's echo, row +7) the press is held back: its buttons
// leave mouse_cap / LMB / RMB (every reader of the pass sees none; the frame tail's latch keeps 0, so the next pass sees
// the edge again) and the wheel is set aside, until the echo comes -- about one bridge tick -- or RUP_HOLD_S passed
// since the post (no bridge running, a Swing outside the active project: as before, at once). A press released while
// held is replayed as a one-pass press on the surface that held it (a quick click is never lost); a hold whose surface
// never runs again is dropped, never replayed late.
// A held press counts only where it was made (the round's Codex review, 2026-10-29): the replay -- or a button still down
// taking its own edge -- happens only while the pointer is within RUP_HOLD_PX of the press and the modifiers are the
// same. Else it would land on whatever control is under the pointer NOW (MUTE pressed on pad A, the pointer on pad B's
// MUTE when the echo came: B toggled, A did not), so that press is DROPPED -- a lost click beats a wrong edit -- and its
// button stays out of mouse_cap until it is let go (rup_hold_sw). The wheel set aside the same. A second press of a
