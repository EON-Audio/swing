  (rup_hold_sw & 1) ? ( (mouse_cap & 1) ? ( mouse_cap -= 1; LMB = 0; lmb_down = 0; ) : ( rup_hold_sw -= 1; ); );
  (rup_hold_sw & 2) ? ( (mouse_cap & 2) ? ( mouse_cap -= 2; RMB = 0; rmb_down = 0; ) : ( rup_hold_sw -= 2; ); );
  _rh_mods = mouse_cap & 60;   // Ctrl 4, Shift 8, Alt 16, Win 32
