    (rup_hold_up & 1) && lmb_down ? ( rup_hold_sw |= 1; rup_hold_extra += 1; mouse_cap -= mouse_cap & 1; LMB = 0; lmb_down = 0; );
    (rup_hold_up & 2) && rmb_down ? ( rup_hold_sw |= 2; rup_hold_extra += 1; mouse_cap -= mouse_cap & 2; RMB = 0; rmb_down = 0; );
    rup_hold_b |= (lmb_down ? 1 : 0) + (rmb_down ? 2 : 0) + (mouse_wheel != 0 ? 4 : 0);
    (rup_hold_b & 1) ? ( !(mouse_cap & 1) ? rup_hold_up |= 1; mouse_cap -= mouse_cap & 1; LMB = 0; lmb_down = 0; );
    (rup_hold_b & 2) ? ( !(mouse_cap & 2) ? rup_hold_up |= 2; mouse_cap -= mouse_cap & 2; RMB = 0; rmb_down = 0; );
    rup_hold_w += mouse_wheel; mouse_wheel = 0;
  ) : rup_hold_b && rup_hold_srf == _srf ? (
    // the echo came (or the time ran out): the held press is replayed (let go meanwhile) or takes its own edge (still
