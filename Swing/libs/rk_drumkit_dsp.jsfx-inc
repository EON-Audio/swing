    _rh_near = abs(mouse_x - rup_hold_x) <= RUP_HOLD_PX && abs(mouse_y - rup_hold_y) <= RUP_HOLD_PX && _rh_mods == rup_hold_m;
    (rup_hold_b & 1) ? (
      !_rh_near ? ( rup_hold_drop += 1; (mouse_cap & 1) ? ( rup_hold_sw |= 1; mouse_cap -= 1; LMB = 0; lmb_down = 0; ); )
                : !(mouse_cap & 1) ? ( mouse_cap |= 1; LMB = 1; lmb_down = 1; );
    );
    (rup_hold_b & 2) ? (
      !_rh_near ? ( rup_hold_drop += 1; (mouse_cap & 2) ? ( rup_hold_sw |= 2; mouse_cap -= 2; RMB = 0; rmb_down = 0; ); )
                : !(mouse_cap & 2) ? ( mouse_cap |= 2; RMB = 1; rmb_down = 1; );
    );
    (rup_hold_b & 4) ? ( _rh_near ? ( mouse_wheel += rup_hold_w; ) : ( rup_hold_drop += 1; ); );
    rup_hold_w = 0; rup_hold_b = 0; rup_hold_up = 0;
  );
);

// ──────────────────────────────────────────────────────────────────────────
// Phase 2: structural (audio) undo — 1-level WHOLE-KIT snapshot.
// The outermost structural op (clear/load/swap/kit/new) captures the entire
// kit's pre-op state — metadata + audio (byte-exact) + visible names — into one
// snapshot slot. Undoing it restores that snapshot. A re-entrancy guard
// (undo_cap_begin/end) makes nested low-level calls capture only ONCE.
// ──────────────────────────────────────────────────────────────────────────

// NOTE: pad NAME / label / path strings are not captured by THIS file:
// get_name_slot / get_cname_slot live in rk_swing_core, which is imported AFTER
// this file — referencing them here would be a def-time forward-ref compile
// error. rk_swing_core saves them instead (undo_begin_pad -> undo_pad_names_save,
// for a per-pad op), and undo_restore_struct asks @gfx to put them back (_udo_name_req ->
// undo_pad_names_restore in Swing_ReaKit.jsfx). Audio + all numeric params
// restore byte-exact here.

// ─── The backup's copy path (banks step 2a) ─────────────────────────────────
// The backup (udo_s2_audio) keeps the pre-banks slot layout as a VIRTUAL slot: the plain
// sample at [0, SLOT_SIZE), layer l at [l * LAYER_SIZE, ...). The pad's regions are no
// longer laid out that way (rk_swing_alloc), so every copy goes through the snapshot the
// capture took of them (udo_s2_srcp / udo_s2_srcl, swing_pad_regions_copy) and
// swing_slot_v2p_t maps each virtual cell onto the region that holds it. A load that
// replaces a region keeps the old one live until finish (the loader's displaced list), so
// the snapshot stays valid for as long as the op runs. Gaps -- past a short layer 0, or a
// layer the pad does not have -- are skipped, never copied.
// Copy virtual [udo_s2_extent, upto) into the backup, at most `budget` cells (-1 = all).
function udo_cow_copy(upto, budget) local(_p, _e, _n) (
  while (udo_s2_extent < upto && budget != 0) (
    _p = swing_slot_v2p_t(udo_s2_srcp, udo_s2_srcl, udo_s2_extent);
    _e = min(upto, swing_slot_vend_t(udo_s2_srcp, udo_s2_srcl, udo_s2_extent));
    _p < 0 ? ( udo_s2_extent = _e; ) : (
      _n = _e - udo_s2_extent;
      budget > 0 ? _n = min(_n, budget);
      memcpy(udo_s2_audio + udo_s2_extent, _p, _n);
      udo_s2_extent += _n;
      budget > 0 ? budget -= _n;
    );
  );
);
// Is a sliced capture of `pad` still short of its goal? (The same gate udo_cow_upto uses.)
function udo_cow_pending(pad) (
  _udo_cap_lazy && _udo_cap_depth > 0 && _udo_st_valid && udo_s2_type == 1 && udo_s2_pad == pad &&
  udo_s2_extent < _udo_cap_goal;
);
// Finish it now, whatever it costs -- for a load about to free the regions it reads from
// (the loader's finish and abort; the sliced phase 2 has normally drained it already).
function udo_cow_drain(pad) (
  udo_cow_pending(pad) ? udo_cow_copy(_udo_cap_goal, -1);
);

// Back up ONE pad's slot (audio + metadata) — the reversible record for a
// per-pad structural op. The audio copy is addressed from the slot base (no
// per-layer offset math, the source of the old last-pad bugs), and it runs
// either up front or a slice at a time -- see the SLICED note below. Scoped:
// restore touches only this pad.
function undo_capture_pad(pad) local(l, _li) (
  _udo_cap_lazy = 0;
  _udo_ready ? (
    // Back up only the cells the pad USES, not the whole 4 M-cell slot: a full-slot
    // memcpy is 32 MB on the audio thread at every drop (10-40 ms; measured 2026-09-08,
    // most of what looked like the file-open stall). Plain pad = s_len; layered = the
    // last layer's region end. The restore copies back the same cells; the length
    // fields it restores keep everything beyond them unread.
    _udo_cap_goal = s_len[pad];
    l = 0; loop(MAX_LAYERS,
      _li = pad * MAX_LAYERS + l;
      l_len[_li] > 0 ? _udo_cap_goal = max(_udo_cap_goal, l * LAYER_SIZE + l_len[_li]);
      l += 1;
    );
    _udo_cap_goal = max(0, min(_udo_cap_goal, UDO_VSLOT)) | 0;   // the virtual slot: four full layers since 2026-09-23
    // SLICED (2026-09-09): a caller that pumps udo_cow_upto before every write into
    // this slot saves nothing here -- each region is copied out a bounded slice at a
    // time, in the block before a writer destroys it, so the drop's first block costs
    // nothing instead of up to 32 MB. Everyone else still gets the copy up front,
    // because their writers (clear_pad's memsets, the file loader's read) trample the
    // slot without asking. udo_s2_extent is "cells saved" either way.
    // Step 2a: snapshot the pad's regions; every copy (eager here, sliced in udo_cow_upto)
    // reads through it, so a load that replaces a region keeps the old one live until
    // finish and the backup still sees the original audio.
    swing_pad_regions_copy(pad, udo_s2_srcp, udo_s2_srcl);
    _udo_cap_lazy = _udo_cap_lazy_req;
    udo_s2_extent = 0;
    !_udo_cap_lazy ? udo_cow_copy(_udo_cap_goal, -1);
    undo_pack(udo_st_meta, pad);
    udo_s2_aud[0] = s_len[pad]; udo_s2_aud[1] = s_sr[pad]; udo_s2_aud[2] = p_layer_cnt[pad];
    l = 0; loop(MAX_LAYERS,
      _li = pad * MAX_LAYERS + l;
      udo_s2_aud[3 + l]  = l_len[_li];
      udo_s2_aud[7 + l]  = l_sr[_li];
      udo_s2_aud[11 + l] = sp_baked_tune[_li];
      l += 1;
    );
    udo_s2_type = 1; udo_s2_pad = pad; _udo_st_valid = 1;
  );
  // any structural op drops the param branch + pending gestures (1-level rule)
  _udo_uc = 0; _udo_rc = 0;
  l = 0; loop(NUM_SLOTS, _udo_pend[l] = 0; l += 1;);
);

