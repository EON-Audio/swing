  rup_hold_b && time_precise() - rup_hold_t > RUP_HOLD_S + 0.5 ? ( rup_hold_b = 0; rup_hold_w = 0; rup_hold_up = 0; );
  (_rh_new || (rup_hold_b && rup_hold_srf == _srf)) && swing_rup_inflight() ? (
    !rup_hold_b ? (
      rup_hold_t = time_precise(); rup_hold_srf = _srf; rup_held += 1;
      rup_hold_x = mouse_x; rup_hold_y = mouse_y; rup_hold_m = _rh_mods;   // where and how the held press was made
    );
