// rk_swing_patchbay.jsfx-inc — shared map for the pad-insert loopback.
//
// Imported by BOTH sides so the protocol exists in exactly one place:
//   producer — EON_Patchbay.jsfx, last in a Swing chain
//   consumer — Swing_ReaKit.jsfx, draining at the top of its next block
//
// WHY A LOOPBACK AT ALL
//   Swing's master section (EQ, saturation, compressor, master volume,
//   limiter) reads and writes spl(0)/spl(1) only. A pad routed to any other
//   bus exits raw. That is fine when the destination is a child track with its
//   own processing, but it is exactly wrong when the user wants their own
//   compressor on the snare AND Swing's master bus — today that costs them the
//   master bus without saying so.
//
//   So the pad leaves on its channel pair (its own: bank A's sixteen and the
//   split-off pads; shared: a bank pair, a whole bank mixed), the user's plugin processes it,
//   and this ring hands it back to Swing one block later, early enough to be
//   summed in BEFORE the master section. One track, sixty-four pads over 29 pairs, each pair with a
//   real plugin chain, all still hitting the master bus.
//
// TIMING
//   The round trip is exactly ONE block — measured, not assumed
//   (.dev_tests/EON_Probe_ChainRT_*, 2026-09-06: max delay equalled max block
//   size to the sample). A latent plugin sitting between Swing and the
//   Patchbay adds exactly its own reported PDC on top, which is a readable
//   constant rather than a silent smear.
//
//   Every pad takes the identical path, so pads stay aligned with EACH OTHER
//   for free. Alignment with the rest of the project is Swing's job, via PDC.
//
// CHANNEL LAYOUT
//   Bank A's pad N rides track channels (N+1)*2 and (N+1)*2+1 — channels 2..33
//   for pads 0..15, one up from its multi-out bus. Channels 0/1 are deliberately
//   left clear: they are what the drained ring is summed INTO, and a pad sharing
//   them would arrive undelayed and flam against the others that made the trip.
//   Pad Banks Outputs step 5 (2026-10-12), the new layout: the bank B, C, D pairs
//   and the ten split-off pairs ride the channels they use in multi-out, 38..63
//   (pair p on p*2, p*2+1), and 34..37 carry the BANK PAIRS' SENDS (delay L/R,
//   reverb L/R): a bank pair is a whole bank mixed, so its pads' sends cannot be
//   taken from the returned audio with one amount the way a pair with one owner's
//   are. Swing sums them per pad (each at its own amounts; pre-pan with the tap
//   on the channel, post-pan with the tap on the bus, as every Wired pad) onto 34..37,
//   and they travel the chain beside the pairs: a latent insert, a block-size
//   change or a loop wrap delays both alike. The ring is channels 2..63 in order
//   (column = channel - 2): 62 a frame, 31 pair columns. swing_patch_col below
//   maps a Swing pair to its column (rk_swing_alloc's swing_out_wired gives the
//   channel: it is imported before this file).
//   The layout is NEGOTIATED. The Patchbay starts in the old one (16 pairs on
//   2..33, 32 a frame) and moves to the new one only when Swing proves it reads
//   it (PATCH_OFF_CONS_V2); it stamps the layout in NCH every block, and Swing
//   drains whichever layout NCH names. So an old Swing beside a new Patchbay (a
//   ReaPack sync with REAPER still running) keeps working, a new Swing beside an
//   old Patchbay gets the old routing exactly, and a block deeper than the new
//   ring keeps the old, deeper one.

@init

// ── gmem band (claimed in .refs/gmem_regions_supplement.tsv) ───────────────
PATCH_BASE          = 26804224;   // 409 * 65536, block-aligned
PATCH_INST_STRIDE   = 262144;     // 4 blocks per instance slot
PATCH_HEADER_SLOTS  = 256;
PATCH_CHANS         = 62;         // the new layout (step 5): track channels 2..63 in order
PATCH_FRAMES        = 4224;       // (262144 - 256) / 62 — any buffer up to 4224
PATCH_CHANS_V1      = 32;         // the old layout: bank A's 16 pads, stereo, channels 2..33
PATCH_FRAMES_V1     = 8184;       // (262144 - 256) / 32 — any buffer up to 8184
PATCH_PCOLS         = 31;         // pair columns of the new layout (PATCH_CHANS / 2)
PATCH_PCOLS_V1      = 16;         // ... of the old one
PATCH_BANKA_PAIRS   = 16;         // bank A's pairs: columns 0..15 in both layouts
PATCH_SEND_PC       = 16;         // the bank pairs' delay sends: pair column 16 (channels 34/35); reverb sends 17 (36/37)
PATCH_SEND_CH       = 34;         // ... their first track channel
PATCH_PAIR_HI       = 19;         // the first pair above the sends: Swing's OUT_PAIR_BANK (it must stay equal)

// Header offsets
PATCH_OFF_WPOS  = 0;   // producer (Patchbay) writes
PATCH_OFF_RPOS  = 1;   // consumer (Swing) writes
PATCH_OFF_HB    = 2;   // producer bumps once per block
PATCH_OFF_OWNER = 3;   // slot echo, so a mis-set link_slot is visible
PATCH_OFF_NCH   = 4;   // the layout the producer rings: PATCH_CHANS (new) or PATCH_CHANS_V1 (old); 0 = a Patchbay too
                       // old to stamp it (the old layout). Stamped every block (step 5); Swing reads it every block
PATCH_OFF_CONS_HB = 5; // consumer (Swing) bumps once per LIVE block: the Patchbay's "Swing is reading" lamp
// ⚠⚠ PRODUCER INCARNATION (2026-09-11). Bumped by the Patchbay whenever it
// starts writing this band from scratch -- @init, and a @slider relink onto a
// different slot. Both reset the write cursor to 0.
//
// WHY IT IS NEEDED. The two cursors below are private: the producer advances
// WPOS every sample, the consumer advances its own read position every sample,
// and NEITHER reads the other. They stay a block apart only because they
// started a block apart. The consumer's position advances only while the
// loopback is live, the producer's advances whenever the Patchbay runs at all,
// so any gap between the two -- Wired switched off and on (the bridge deletes
// and re-adds the Patchbay), a bypass, a heartbeat stall, a block-size change --
// leaves them a permanent, arbitrary distance apart. Both then walk at the same
// speed for ever, so nothing brings them back: the loopback keeps running at a
// wrong latency (up to the ring's full depth, 4224 or 8184 frames) while PDC still declares one
// block. Found by audit and confirmed in the source 2026-09-09.
//
// The consumer re-aims at WPOS on a new incarnation, and on its own
// false->true transition (which covers the cases that do NOT rebuild the
// producer). A full fix -- the producer publishing each completed block's start
// and length, the consumer draining exactly that -- is specified in the plan doc
// and would also make block-size changes exact; this is the safety half.
PATCH_OFF_GEN = 6;     // producer: incarnation counter, bumped on every fresh start (and every layout change)
PATCH_OFF_CONS_V2 = 7; // consumer (step 5 and later): the CONS_HB counter again -- the proof the Patchbay waits for
                       // before it rings the new layout (an older Swing writes CONS_HB only)
PATCH_OFF_NCH_HB = 8;  // producer (step 5 and later): its HB again, written with it every block. Swing takes the new
                       // layout only while this equals HB: an older Patchbay bumps HB alone, so a stamp of 62 left
                       // in NCH by another Patchbay can never stand for it

// The ring's first track channel, in both layouts — see CHANNEL LAYOUT above.
PATCH_CH0 = 2;

// A producer that has not bumped its heartbeat for this many consumer blocks is
// treated as gone, and Swing falls back to summing pads internally. Generous on
// purpose: going silent because a heartbeat was a beat late would be a far worse
// failure than carrying on with the loopback for a few extra blocks.
// While it stands still Swing drains nothing (2026-10-12): no frames came in, so
// the read cursor waits where the write cursor stopped and the return is silent
// until the producer beats again (a bypassed Patchbay replayed stale audio).
PATCH_HB_STALL_MAX = 16;

function swing_patch_base(slot) global(PATCH_BASE, PATCH_INST_STRIDE)
(
  PATCH_BASE + slot * PATCH_INST_STRIDE;
);

// Step 5: the ring's pair column for a Swing pair in the new layout (column = channel / 2 - 1): bank A's 0..15
// as they are, the bank and split pairs 19..31 one down (18..30). The returns 16..18 never carry a pad and
// columns 16/17 are the bank pairs' sends, so 16..18 answer -1.
function swing_patch_col(pair) global(PATCH_BANKA_PAIRS, PATCH_PAIR_HI)
(
  pair < PATCH_BANKA_PAIRS ? pair : pair < PATCH_PAIR_HI ? -1 : pair - 1;
);
