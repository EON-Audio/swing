// rk_swing_ui_grid_overlay_fx.jsfx-inc
// Swing overlay: waveform/ADSR, EQ response, FX knobs, button rows
// Sub-functions for swing_grid_draw_overlay() — zero behavioral change
// (c) EON Studios — All Rights Reserved

@init
// The room the stack leaves free above the buttons is shared (2026-10-28; the waveform alone took it until step 2:
// _ov_share, below): set to 1 by the hosts that lay the editor out in one column (the floating editor, the side panel),
// before the sections; the two-column form below the pads leaves it 0. OV_WF_GROW_MAX caps how much taller than its
// 120 px the waveform gets.
ov_wf_grow = 0;
OV_WF_GROW_MAX = 200;

// ── The folds (2026-10-28, the owner: "can we get collapsable on the sections like mixer?") ──
// The envelope knobs, the EQ, FX and the sends each sit under a slim bar (FOLD_H) that folds them away; the waveform stays
// open and takes what a fold frees (ov_wf_grow). pfx_fold holds the folded ones (1 envelope, 2 EQ, 4 FX, 8 sends; 16 the
// side panel SYNTH page's pad picker, rk_swing_ui_synthview swing_sv_pick_bar; 32 the waveform itself, below: saved,
// gate 86; a view setting, kept out of undo by swing_view_keep). A bar shows a light (amber: something in the section is
// on, grey: all off) and, folded, a line of what is on (#ov_fsum, set by the section before its bar), so a hidden effect
// cannot surprise. The heights below are the sections' own; _ov_stack_h sums them for the waveform's share.
FOLD_H = 12;            // a bar
OV_FOLD_BLK = 14;       // a section folded: its bar and 2 px
OV_ENV_OPEN_H = 68;     // the waveform's bottom to the envelope's end, open: 4, the bar, 2, the knobs (2 r), labels and values
ov_env_end = 0; ov_eq_top = 0; ov_eq_end = 0;   // where each section ended (set while they draw; the wide form moves ov_eq_top)
ov_fx_end = 0; ov_mix_y = 0;                     // the sends' end, and where one column puts the layer mixer (_ov_draw_buttons)

// The waveform folds too (2026-10-29, the owner: "should the actual pad waveform view be collapasable"; the approved
// render): a WAVE bar over its display, INSIDE its 120 (an open page lays out exactly as before), pfx_fold 32. Folded,
// the bar names the sound (its file and length; a synth pad its engine) and under it a thin strip holds a play button and
// the sound as a line; the trim handles, the envelope's handles and the zoom stay with the full view. What the fold frees
// goes to the open sections (_ov_share: the waveform takes no share folded).
OV_WAVE_BLK = 120;      // the waveform open: its bar and the display (design px; the display grows by ov_gwf)
OV_WSTRIP_H = 26;       // folded: the strip under the bar
// Where the block starts without the mode's control row (the old layer mode 0, which no new pad gets: a cleared pad and a
// load set 3): 6 under the L1..L4 tabs (op_y + 48, 20 tall). It was 54, from before the colour row moved the tabs down:
// the display covered the tabs' lower 14 px, and the WAVE bar there took their presses.
OV_WAVE_TOP0 = 74;
// Open, the display sits this much lower under its bar: the envelope's top nodes reach above it (6 in, their press 15
// round, their letters 12 up) -- with the bar 2 above, an A node's press folded the waveform (the sandbox pictures,
// 2026-10-29). The block keeps its 120: the display gives the 8 up.
OV_WAVE_GAP = 8;
function _ov_wave_blk() ( (pfx_fold & 32) ? OV_FOLD_BLK + OV_WSTRIP_H : OV_WAVE_BLK );

// The stack under the waveform for the folds as they are: the envelope, the EQ, FX and the sends (OV_EQ_H, OV_FX_ROW_H,
// OV_SND_ROW_H: rk_swing_ui_grid_overlay_fx_p2, the sections' own heights).
function _ov_stack_h() (
  ((pfx_fold & 1) ? 4 + OV_FOLD_BLK : OV_ENV_OPEN_H)
  + ((pfx_fold & 2) ? OV_FOLD_BLK : OV_FOLD_BLK + OV_EQ_H + 2)
  + ((pfx_fold & 4) ? OV_FOLD_BLK : OV_FX_ROW_H)
  + ((pfx_fold & 8) ? OV_FOLD_BLK : OV_SND_ROW_H);
);

// The page's own height in one column for pad p, design px: the top (the tabs, and the mode's control row: the
// waveform's place), the waveform's 120 (folded 40: _ov_wave_blk), the sections as folded, 8, the buttons' 66 and the
// layer mixer. The side panel scrolls by it (2026-10-28, step 2: a fold shortens the page; it was 560 + the mixer
// whatever was folded).
function swing_ov_need_d(p) (
  ((p_layer_mode[p] == 1 || p_layer_mode[p] == 2 || p_layer_mode[p] == 3) ? 100 : OV_WAVE_TOP0) + _ov_wave_blk() + _ov_stack_h() + 8 + 66
  + swing_lmix_h()
);

// ── The open sections SHARE the room (2026-10-28, step 2 of the owner's "smarter scaling ... can it adjust to which
// sections are open?"; the approved mockup: fold three and the one left gets the room). In one column (ov_wf_grow) the
// room the page has past what its sections need goes to the waveform AND the open sections together: the envelope's
// knobs and FX / sends' knobs grow (as far as their columns' width holds them), the EQ's screen grows taller, the
// waveform takes a half share. One growth t for all of them, each capped: _ov_share finds the t whose growth fills the
// spare room, or, every share at its cap, leaves the rest at the bottom. Design px, drawn at the zoom like the rest;
// a folded section takes none. Until this step the waveform alone took it (up to OV_WF_GROW_MAX).
ov_gwf = 0; ov_genv = 1; ov_geq = 0; ov_gkn = 1;   // the waveform's extra height, the envelope knobs' scale, the EQ screen's extra, FX / sends' knobs' scale
_ov_cenv = 0; _ov_ckn = 0;                         // this frame's caps (design px of a knob's diameter)
OV_GROW_EQ_MAX = 84;      // the EQ screen to 140
OV_GROW_KNOB_MAX = 1.6;   // a knob at most 1.6 x (the envelope's 13 -> 21, FX's 11 -> 18), less where its column is narrower
function _ov_share_sum(t) local(s) (
  s = (pfx_fold & 32) ? 0 : min(OV_WF_GROW_MAX, 60 * t);   // folded, the waveform takes none
  !(pfx_fold & 1) ? s += min(_ov_cenv, 26 * t);
  !(pfx_fold & 2) ? s += min(OV_GROW_EQ_MAX, 56 * t);
  !(pfx_fold & 4) ? s += min(_ov_ckn, 22 * t);
  !(pfx_fold & 8) ? s += min(_ov_ckn, 22 * t);
  s;
);
function _ov_share(spare) local(lo, hi, mid, wd) (
  ov_gwf = 0; ov_genv = 1; ov_geq = 0; ov_gkn = 1;
  wd = op_w / ov_k;   // the column's width, design px
  _ov_cenv = 26 * max(0, min(OV_GROW_KNOB_MAX, (wd / (ov_lmix_on ? 6 : 8) * 0.5 - 7) / 13) - 1);
  _ov_ckn  = 22 * max(0, min(OV_GROW_KNOB_MAX, (wd / 4 * 0.5 - 9) / 11) - 1);
  spare > 0 ? (
    lo = 0; hi = 4;   // t at 4: every share at its cap (the waveform's 200 / 60 is the last)
    _ov_share_sum(hi) <= spare ? lo = hi
    : loop(24, mid = (lo + hi) * 0.5; _ov_share_sum(mid) <= spare ? lo = mid : hi = mid; );
    ov_gwf = (pfx_fold & 32) ? 0 : min(OV_WF_GROW_MAX, 60 * lo);
    ov_genv = !(pfx_fold & 1) ? 1 + min(_ov_cenv, 26 * lo) / 26 : 1;
    ov_geq = !(pfx_fold & 2) ? min(OV_GROW_EQ_MAX, 56 * lo) : 0;
    ov_gkn = (pfx_fold & 12) != 12 ? 1 + min(_ov_ckn, 22 * lo) / 22 : 1;
  );
);

// An LCD screen under the waveform and the EQ (2026-10-28, the owner: "give this the LCD look"): Swing's LCD palette
// (lcd_bg_*: the LCD bar's, the FX view's screens), a dark bezel, a rim and a deep ground; what the display draws goes on top.
function _ov_lcd_screen(sx, sy, sw, sh) (
  ov_set(0.03, 0.04, 0.05, 1); gfx_rect(sx - 2, sy - 2, sw + 4, sh + 4);
  ov_set(lcd_bg_r * 0.70, lcd_bg_g * 0.70, lcd_bg_b * 0.70, 1); gfx_rect(sx - 1, sy - 1, sw + 2, sh + 2, 0);
  ov_set(lcd_bg_r * 0.28, lcd_bg_g * 0.28, lcd_bg_b * 0.28, 1); gfx_rect(sx, sy, sw, sh);
);

// A section's bar at y, across the editor: its chevron, its title, its light (lit = something in it is on) and, folded,
// #ov_fsum at the right. A press on the bar folds or opens the section (pfx_fold's bit).
// At the editor's zoom (ov_k: rk_swing_ui_layer_mixer), as every size below.
function _ov_fold_bar(by, bit, title, lit) local(bx, bw, bh, hov, fd, tw2, th2, cx, cy, a) (
  bx = op_x + ov_px(6); bw = op_w - ov_px(12); bh = ov_px(FOLD_H); a = ov_k;
  fd = (pfx_fold & bit) != 0;
  hov = mx >= bx && mx < bx + bw && my >= by && my < by + bh;
  ov_set(0.20, 0.21, 0.25, hov ? 1 : 0.80); gfx_rect(bx, by, bw, bh);
  ov_set(0.62, 0.64, 0.70, hov ? 1 : 0.85);
  cx = bx + ov_px(7); cy = by + bh * 0.5;
  fd ? gfx_triangle(cx - 2 * a, cy - 3 * a, cx - 2 * a, cy + 3 * a, cx + 2 * a, cy)    // folded: points right
     : gfx_triangle(cx - 3 * a, cy - 2 * a, cx + 3 * a, cy - 2 * a, cx, cy + 2 * a);   // open: points down
  ov_font(9, 'b');
  gfx_measurestr(title, tw2, th2); gfx_x = bx + ov_px(14); gfx_y = by + (bh - th2) * 0.5; gfx_drawstr(title);
  lit ? ov_set(0.88, 0.64, 0.23, 1) : ov_set(0.32, 0.33, 0.38, 1);
  gfx_circle(bx + ov_px(14) + tw2 + ov_px(7), cy, 2.5 * ov_k, 1);
  fd && strlen(#ov_fsum) > 0 ? (
    ov_font(9, 0); ov_ink(0.86, 0.72, 0.40, 1);   // (a light theme: darkened to read, ov_ink)
    gfx_measurestr(#ov_fsum, tw2, th2); gfx_x = bx + bw - ov_px(6) - tw2; gfx_y = by + (bh - th2) * 0.5; gfx_drawstr(#ov_fsum);
  );
  hov && lmb_down ? ( pfx_fold = fd ? pfx_fold - bit : pfx_fold + bit; lmb_down = 0; );
);

// Keep a promoted single's pad-level trim in step with its layer-0 trim.
//
// A pad loaded by the browser or by a drag is a PLAIN pad (p_layer_cnt 0, since
// 2026-09-08): its trim handles write s_start/s_end directly and need no mirror.
// This covers a PROMOTED SINGLE: p_layer_cnt is 1, the audio sits in layer 0, and
// that layer carries no path of its own — its source is the pad-main path.
// Dragging the trim handles on such a pad writes ONLY l_start/l_end, while
// s_start/s_end keep the 0/1 clear_pad left behind.
// That does not matter until the project is reopened in marker mode, where the
// reload rebuilds the layer FROM the pad values (load_from_path does
// l_start[_lidx] = s_start[idx]) and the dragged trim is silently wiped.
// Mirroring the pair is what makes a trim survive a save and reopen.
//
// Deliberately ONLY the promoted single. A genuine multi-layer pad has a trim
// per layer that no single pad-level pair could represent, and its reload goes
// through the stored layer paths rather than through s_start/s_end at all.
function _ov_mirror_trim_to_pad(_pad, _li)
(
  p_layer_cnt[_pad] == 1 && _li == _pad * MAX_LAYERS ? (
    s_start[_pad] = l_start[_li];
    s_end[_pad]   = l_end[_li];
  );
);

// ═══ SYNTH VOICE PREVIEW ═══════════════════════════════════════════════════
// The pad editor's waveform slot is empty on a synth pad because there is no
// sample to draw. There IS a voice though, and it is renderable: rk_syn_tick
// is a pure function over a state block, so @gfx can run the engine into its
// OWN scratch state and draw the result. Nothing here touches a live voice.
//
// ⭐ SPLIT ON PURPOSE — the engine render is cached, the ENVELOPE is not.
// A full render is tens of thousands of ticks; doing that per frame while
// someone drags an ADSR node would be unusable. But the pad envelope only
// MULTIPLIES the engine output, so the two are separable: cache the engine's
// per-column peaks (rebuilt only when the pad, engine, macros or tune change)
// and apply the envelope at draw time across 512 columns. Dragging ATK/DEC/
// SUS is then free, and it still shows the truth.
//
// ⭐ FIXED TIME WINDOW, not auto-fit. A fixed window is what makes a decay
// change VISIBLE — turn the knob and the waveform reaches further across the
// box. Auto-fitting would rescale the very thing the user is trying to see.
//
// Memory is caller-owned (freemem pattern): Swing_ReaKit @init calls
// swing_synprev_init. An inc must never claim freemem at its own @init —
// imported @init runs BEFORE the main file's `freemem = 0`.
SYNPREV_COLS = 512;      // peak columns; redrawn per frame, rebuilt rarely
SYNPREV_SEC  = 0.80;     // STARTING window. Self-scales from here -- see the
                         // tail scan in build. A fixed window cannot serve both
                         // a 30 ms tick and 8T8's SUB, which rings ~1.5 s
                         // before it even begins to fall and renders as a solid
                         // block. The scale is DRAWN so it is never a mystery,
                         // and it only moves when the sound outgrows or
                         // under-fills the box -- so an ordinary decay tweak
                         // still shows as the tail reaching further, which is
                         // the whole point of not auto-fitting every frame.
// A rebuild is SYNPREV_SEC * srate engine ticks -- ~35k, tens of ms. Fine as a
// one-off, unusable per frame, and per frame is exactly what happens when the
// DECAY macro is swept with this editor open (it writes ps_mac, which IS the
// rebuild key). So rebuilds are throttled: the picture refreshes ~8x a second
// while something is moving, which reads as live, and settles exact the moment
// it stops. Staleness can never persist -- @gfx keeps running, so the next
// frame past the gate rebuilds.
SYNPREV_MIN_S = 0.12;

function swing_synprev_init(fm) (
  synp_st  = fm; fm += RK_SYN_STATE_SIZE;   // scratch engine state, ours alone
  synp_mac = fm; fm += 8;
  synp_hi  = fm; fm += SYNPREV_COLS;        // |peak| per column, NO envelope
  // the key: [0] pad, [1] engine, [2..9] the eight macros, [10] tune, [11] the throttle's time, [12] the window
  // (seconds). The window sat in cell 9 -- the eighth macro's -- so every stale check put ps_mac7 back over the
  // fitted window: the self-fit never held, a synth pad re-rendered about eight times a second while its editor
  // was open, and the label read 0.80 s over a 0.5 s picture (LIB310).
  synp_key = fm; fm += 13;
  synp_key[0]  = -1;                         // nothing rendered yet
  synp_key[12] = SYNPREV_SEC;                // current window, seconds
  synp_key[11] = -1000;                      // ...and no throttle to wait on
                                             // (EEL2 has no 1e9-style literal)
  fm;
);

// Has anything the ENGINE render depends on changed? Envelope params are
// deliberately absent — those are applied at draw time and must not force a
// rebuild. Stores the new key as a side effect when it reports a change.
function swing_synprev_stale(_sk_pad) local(_sk_i, _sk_ch) (
  _sk_ch = synp_key[0] != _sk_pad
        || synp_key[1] != ps_engine[_sk_pad]
        || synp_key[10] != p_tune[_sk_pad];
  _sk_i = 0; loop(8,
    synp_key[2 + _sk_i] != _syn_mac_get(_sk_pad, _sk_i) ? _sk_ch = 1;
    _sk_i += 1;
  );
  // Throttle: report "not stale" until the gate opens, so the caller simply
  // keeps drawing the previous picture.
  _sk_ch && time_precise() - synp_key[11] < SYNPREV_MIN_S ? _sk_ch = 0;
  _sk_ch ? (
    synp_key[11] = time_precise();
    synp_key[0] = _sk_pad;
    synp_key[1] = ps_engine[_sk_pad];
    synp_key[10] = p_tune[_sk_pad];
    _sk_i = 0; loop(8, synp_key[2 + _sk_i] = _syn_mac_get(_sk_pad, _sk_i); _sk_i += 1;);
  );
  _sk_ch;
);

// Run the engine for SYNPREV_SEC and keep the peak per column.
// Fixed seed so the picture is stable frame to frame — the engines are
// noise-driven and a fresh seed would make the display crawl.
function swing_synprev_build(_sp_pad)
local(_sp_i, _sp_col, _sp_cw, _sp_pk, _sp_y, _sp_last, _sp_win) (
  _sp_cw = max(1, ((synp_key[12] * srate) | 0) / SYNPREV_COLS) | 0;
  memset(synp_st, 0, RK_SYN_STATE_SIZE);
  synp_st[1] = 20261;                        // nonzero seed, as the core does
  _sp_i = 0; loop(8, synp_mac[_sp_i] = _syn_mac_get(_sp_pad, _sp_i); _sp_i += 1;);
  rk_syn_reset(ps_engine[_sp_pad] | 0, synp_st, synp_mac, p_tune[_sp_pad], 1.0);
  _sp_col = 0;
  loop(SYNPREV_COLS,
    _sp_pk = 0;
    _sp_i = 0;
    loop(_sp_cw,
      _sp_y = abs(rk_syn_tick(synp_st));
      _sp_y > _sp_pk ? _sp_pk = _sp_y;
      _sp_i += 1;
    );
    synp_hi[_sp_col] = min(1.0, _sp_pk);
    _sp_col += 1;
  );
  // ── fit the window to the voice ─────────────────────────────────────────
  // Grow when the sound is still going at the right edge, shrink when it dies
  // well before it. The two thresholds are deliberately far apart: after a
  // 1.6x grow the tail lands near 0.58 of the box, comfortably above the 0.45
  // shrink trigger, so it settles instead of ping-ponging between two scales.
  // Clearing the key forces one more rebuild, which the throttle paces.
  _sp_last = 0; _sp_col = 0;
  loop(SYNPREV_COLS,
    synp_hi[_sp_col] > 0.03 ? _sp_last = _sp_col;
    _sp_col += 1;
  );
  _sp_win = synp_key[12];
  _sp_last > SYNPREV_COLS * 0.93 ? _sp_win = min(3.0, _sp_win * 1.6) :
  _sp_last < SYNPREV_COLS * 0.45 ? _sp_win = max(0.12, _sp_win * 0.625);
  _sp_win != synp_key[12] ? ( synp_key[12] = _sp_win; synp_key[0] = -1; );
);

// The WAVE bar's line (folded): the layer shown's file and the length it plays ("pad00_lay0 · 0.84 s"), its name cut
// with "~" to the bar's room; a synth pad with no sample its engine; nothing on an empty layer. Reads what
// _ov_draw_waveform_and_adsr found on view (_slen, _sstart, _send, _ovw_lidx).
function _ov_wave_sum() local(rate, n, tw, th) (
  _slen > 0 ? (
    p_layer_cnt[oi] > 0 ? swing_lmix_name(#ov_wname, LPATH_STR_BASE + _ovw_lidx) : swing_lmix_name(#ov_wname, get_path_slot(oi));
    // no file behind it (a kit carries its own audio: the sandbox pictures, 2026-10-29): the pad's name as the grid shows
    // it (its own, else its sample's), else "sample"
    strlen(#ov_wname) == 0 ? ( strcpy(#ov_wname, get_cname_slot(oi)); strlen(#ov_wname) == 0 ? swing_lmix_name(#ov_wname, get_name_slot(oi)); );
    strlen(#ov_wname) == 0 ? strcpy(#ov_wname, "sample");
    rate = p_layer_cnt[oi] > 0 ? l_sr[_ovw_lidx] : s_sr[oi]; rate <= 0 ? rate = srate;
    sprintf(#ov_wlen, " · %.2f s", (_send - _sstart) * _slen * 0.5 / max(1, rate));
    ov_font(9, 0); n = strlen(#ov_wname);
    strcpy(#ov_fsum, #ov_wname); strcat(#ov_fsum, #ov_wlen); gfx_measurestr(#ov_fsum, tw, th);
    while (tw > op_w - ov_px(100) && n > 1) (
      n -= 1; strcpy_substr(#ov_fsum, #ov_wname, 0, n); strcat(#ov_fsum, "~"); strcat(#ov_fsum, #ov_wlen);
      gfx_measurestr(#ov_fsum, tw, th);
    );
  ) : ps_enable[oi] > 0.5 ? (
    _syn_engine_name((ps_engine[oi] | 0) % 10); sprintf(#ov_fsum, "%s  T%d", #_syn_en, (((ps_engine[oi] | 0) * 0.1) | 0) + 1);
  ) : strcpy(#ov_fsum, "");
);

// The waveform folded (pfx_fold 32): its strip (wf_x .. wf_h) -- a play button at the left (the full view's centre
// button), and the sound as a line: the unzoomed view's frozen cache (a plain pad's is stored reversed, LIB312; a
// layer's takes the flip), a synth pad's rendered voice, an empty layer the hint.
function _ov_wave_strip() local(r, cx, cy, hot, x0, w0, a, j, ci, cl, cr, v, lay, tw, th)
(
  ov_scr = 1;   // a screen: THEME leaves it as it is (ov_set)
  _ov_lcd_screen(wf_x, wf_y, wf_w, wf_h);
  r = ov_px(8); cx = wf_x + ov_px(4) + r; cy = wf_y + wf_h * 0.5;
  hot = dist(mx, my, cx, cy) <= r + ov_px(2);
  ov_set(0.8, 0.8, 0.8, hot ? 0.8 : 0.5); gfx_circle(cx, cy, r, 1);
  ov_set(0.2, 0.2, 0.2, 1); gfx_triangle(cx - r * 0.3, cy - r * 0.5, cx - r * 0.3, cy + r * 0.5, cx + r * 0.55, cy);
  active_id == -1 && lmb_down && hot && pad_is_playable(oi) ? (
    swing_gt_post(oi, p_note[oi], 127, 8);
    p_held[oi] = 1; p_held_vel[oi] = 127; p_held_note[oi] = p_note[oi]; gui_held_pad = oi;
  );
  x0 = cx + r + ov_px(6); w0 = (wf_x + wf_w - ov_px(4) - x0) | 0; a = wf_h * 0.5 - ov_px(3);
  w0 > 2 ? (
    _slen > 0 ? (
      lay = p_layer_cnt[oi] > 0;
      cl = lay ? ov_wv_cache + (oi * MAX_LAYERS + overlay_layer) * WV_RES : wv_cache + oi * WV_RES;
      cr = lay ? ov_wv_cache_R + (oi * MAX_LAYERS + overlay_layer) * WV_RES : wv_cache_R + oi * WV_RES;
      ov_set(pr * 0.6 + 0.2, pgg * 0.6 + 0.2, pb * 0.6 + 0.2, 0.85);
      j = 0; loop(w0,
        ci = min(WV_RES - 1, ((lay && p_reverse[oi] ? w0 - 1 - j : j) * WV_RES / w0) | 0);
        v = min(1, max(abs(cl[ci]), abs(cr[ci]))) * a;
        gfx_line(x0 + j, cy - v, x0 + j, cy + v);
        j += 1;
      );
    ) : ps_enable[oi] > 0.5 ? (
      swing_synprev_stale(oi) ? swing_synprev_build(oi);
      _syn_engine_col(ps_engine[oi] | 0, 1.0); ov_set(_syn_ecr, _syn_ecg, _syn_ecb, 0.6);
      j = 0; loop(w0,
        v = min(1, synp_hi[min(SYNPREV_COLS - 1, (j * SYNPREV_COLS / w0) | 0)]) * a;
        gfx_line(x0 + j, cy - v, x0 + j, cy + v);
        j += 1;
      );
    ) : (
      ov_font(9, 0); ov_set(0.62, 0.65, 0.70, 1);   // readable (2026-10-29: it read 1.8:1)
      gfx_measurestr("DRAG SAMPLE HERE", tw, th);
      gfx_x = x0 + (w0 - tw) * 0.5; gfx_y = cy - th * 0.5; gfx_drawstr("DRAG SAMPLE HERE");
    );
  );
  ov_set(0.22, 0.23, 0.27, 1); gfx_rect(wf_x, wf_y, wf_w, wf_h, 0);
  ov_scr = 0;
);

function _ov_draw_waveform_and_adsr()
local(val, j, _rev_j, sample_idx, wv_cy, step, _has_ctrl_row, _wf_top, _wfd,
      _wv_use_cache, _wv_cL, _wv_cR, _ci, _sL, _sR, _wv_cj, _wv_lk, _wv_mc,
      _sp_cw, _sp_ac, _sp_dc, _sp_sus, _sp_env, _sp_stg, _sp_col, _sp_x, _sp_y)
(
    // ── Sample display: waveform + ADSR envelope overlaid ─────────────
    // Waveform positioned below tabs + optional control row, under its WAVE bar (2026-10-29: inside the block's 120, so
    // the display's bottom and all below it stay where they were); folded (pfx_fold 32) the bar and the strip
    _has_ctrl_row = (p_layer_mode[oi] == 1 || p_layer_mode[oi] == 2 || p_layer_mode[oi] == 3);
    _wf_top = op_y + ov_px(_has_ctrl_row ? 100 : OV_WAVE_TOP0);
    ovl_wbar_y = _wf_top;   // the WAVE bar's top (for the rig: the control row ends above it, _ov_draw_layers_and_mode ovl_ctrl_b)
    _wfd = (pfx_fold & 32) != 0;
    wf_y = _wf_top + ov_px(OV_FOLD_BLK + (_wfd ? 0 : OV_WAVE_GAP));
    wf_x = op_x + ov_px(10); wf_w = op_w - ov_px(20);
    // The room left free above the buttons (the owner, 2026-10-28: "a lot of space with nothing"): under the waveform the
    // sections as folded (_ov_stack_h), above the buttons (66 up from the bottom, over the mixer) 8 px. Shared by the
    // waveform and the open sections (_ov_share, step 2); the wide form shares none.
    ov_wf_grow ? _ov_share(((op_y + op_h - ov_px(66 + ov_lmix_h + 8)) - (_wf_top + ov_px(_ov_wave_blk() + _ov_stack_h()))) / ov_k)
               : ( ov_gwf = 0; ov_genv = 1; ov_geq = 0; ov_gkn = 1; );
    wf_h = _wf_top + ov_px(_wfd ? OV_FOLD_BLK + OV_WSTRIP_H : OV_WAVE_BLK + ov_gwf) - wf_y;   // the bottom where the block ends
    // The waveform as a DROP target for Swing's own browsers, as the layer tabs are (_ov_draw_layers_and_mode): their
    // drags never become an OS drop, so "DRAG SAMPLE HERE" took only Explorer's (the owner, 2026-10-27). A drop on it
    // lands on the layer shown, as an OS drop on it does (_ov_take_drop); fresh within a quarter second, as the tabs.
    overlay_layer < MAX_LAYERS ? (
      ovl_wave_t = time_precise(); ovl_wave_pad = oi; ovl_wave_layer = overlay_layer;
      ovl_wave_x = wf_x; ovl_wave_y = wf_y; ovl_wave_w = wf_w; ovl_wave_h = wf_h;
    );

    // Waveform (full frame) — show layer waveform if in layer mode, else legacy
    // If viewing a layer that has audio, show it. If empty, force _slen=0 for "DRAG SAMPLE HERE".
    // (Found before the WAVE bar, which names it.)
    _slen = 0;
    p_layer_cnt[oi] > 0 ? (
      _ovw_lidx = oi * MAX_LAYERS + overlay_layer;   // own name: @sample's voice loop owns _lidx (A-8)
      _slen = l_len[_ovw_lidx];
      _sstart = l_start[_ovw_lidx];
      _send = l_end[_ovw_lidx];
      buf = p_lptr[oi * MAX_LAYERS + overlay_layer];
      // Normalize gain only — see build_wv_cache contract (no user mix knobs).
      sg = l_norm[_ovw_lidx] ? l_norm_gain[_ovw_lidx] : 1.0;
    ) : overlay_layer == 0 ? (
      // Legacy (no layers) — only show on layer 0
      _slen = s_len[oi];
      _sstart = s_start[oi];
      _send = s_end[oi];
      buf = p_aptr[oi];
      sg = s_norm[oi] ? s_norm_gain[oi] : 1.0;
    );
    // the WAVE bar: lit while the sound plays trimmed or reversed; folded, its name and length (_ov_wave_sum; open, the
    // bar shows no line)
    _wfd ? _ov_wave_sum() : strcpy(#ov_fsum, "");
    _ov_fold_bar(_wf_top, 32, "WAVE", _slen > 0 && (_sstart > 0.0005 || _send < 0.9995 || p_reverse[oi] > 0.5));
    _wfd ? _ov_wave_strip() : (   // folded: the strip; open: the full view to the envelope's node hits (below)
    ov_scr = 1;   // a screen to the node hits: THEME leaves it and what is on it as they are (ov_set)
    _ov_lcd_screen(wf_x, wf_y, wf_w, wf_h);   // the LCD look (2026-10-28)
    _slen > 0 ? (
      // ── Mouse wheel zoom in waveform area ──
      _in_wf = mx >= wf_x && mx <= wf_x + wf_w && my >= wf_y && my <= wf_y + wf_h;
      // frame_wheel, not mouse_wheel: the @gfx head (Swing_ReaKit) copies mouse_wheel into frame_wheel and zeroes
      // it before any panel draws, so a test of mouse_wheel here never fired -- the zoom, its badge, the scroll
      // bar and the Ctrl/middle-drag scroll were unreachable (LIB311). Consumed by zeroing frame_wheel, the
      // house pattern (the mini browser's note on it).
      _in_wf && frame_wheel != 0 ? (
        _mpos_norm = (mx - wf_x) / wf_w;  // cursor position 0–1 in display
        _old_zoom = wf_zoom;
        frame_wheel > 0 ? wf_zoom = min(64, wf_zoom * 1.25) : wf_zoom = max(1, wf_zoom / 1.25);
        // Adjust scroll to keep the cursor point stable
        _view_w = 1.0 / wf_zoom;
        _cursor_norm = wf_scroll + _mpos_norm * (1.0 / _old_zoom);
        wf_scroll = _cursor_norm - _mpos_norm * _view_w;
        wf_scroll = max(0, min(1.0 - _view_w, wf_scroll));
        frame_wheel = 0;
      );

      // ── Zoom-aware rendering ──
      _view_w = 1.0 / wf_zoom;
      _view_start = wf_scroll;  // normalized 0–1 start of visible region
      _view_end = wf_scroll + _view_w;
      // Total mono samples = _slen / 2 (interleaved stereo)
      _mono_len = _slen / 2;
      _vis_s0 = (_view_start * _mono_len)|0;
      _vis_s1 = (_view_end * _mono_len)|0;
      _vis_range = max(1, _vis_s1 - _vis_s0);
      step = _vis_range / wf_w;

      // Overview (unzoomed) draws the FROZEN per-(pad,layer) cache so a Tuned
      // bake (which overwrites the layer buffer with pitched audio) does NOT
      // move the displayed waveform — the detail view shows the ORIGINAL sample,
      // matching the grid. The zoomed view keeps reading the live buffer (the
      // cache is only WV_RES points, too coarse for zoom). The cache is already
      // normalized, so its amp scale omits the per-layer norm gain (sg).
      _wv_use_cache = (wf_zoom == 1);
      _wv_use_cache ? (
        p_layer_cnt[oi] > 0 ? (
          _wv_cL = ov_wv_cache   + (oi * MAX_LAYERS + overlay_layer) * WV_RES;
          _wv_cR = ov_wv_cache_R + (oi * MAX_LAYERS + overlay_layer) * WV_RES;
        ) : (
          _wv_cL = wv_cache   + oi * WV_RES;   // legacy non-layered: per-pad cache
          _wv_cR = wv_cache_R + oi * WV_RES;
        );
      );

      // Stereo (L != R content) → top=L bottom=R; mono → single centered.
      ov_set(pr * 0.5 + 0.1, pgg * 0.5 + 0.1, pb * 0.5 + 0.1, 0.45);
      // PAD WAVE (slider48, 2026-10-27): the UNZOOMED view draws Outline / True peaks from the slot's bins
      // (rk_swing_core swing_wvb_*) when they hold the layer on view -- a plain pad, or a layered pad's first layer
      // with audio, unbaked (a baked layer keeps the frozen original the overview promises, below). Bins are raw:
      // sg (this layer's normalize gain) and the reverse flip apply here. Zoomed, and Peak, draw as before.
      _wv_lk = _wv_use_cache ? swing_wvb_use(oi) : 0;
      // Mono views draw the LOUDER channel of a pad mono by balance (wv_monoch, build_wv_cache, 2026-10-27) where the
      // view shows the audio that was judged: a plain pad, or the layer build_wv_cache chose (the bins' key holds it).
      // Another layer of the pad keeps L, as before.
      _wv_mc = (wv_monoch[oi] && (p_layer_cnt[oi] > 0 ? wvb_key[oi * WVB_KEYN + 1] == overlay_layer : 1)) ? 1 : 0;
      (_wv_lk &&
       (p_layer_cnt[oi] > 0 ? (wvb_key[oi * WVB_KEYN + 1] == overlay_layer && sp_baked_tune[oi * MAX_LAYERS + overlay_layer] == 0)
                            : wvb_key[oi * WVB_KEYN + 1] < 0)) ? (
        p_stereo[oi] ? (
          swing_grid_wvb_lane(oi, 0, _wv_lk, wf_y + wf_h * 0.25, (wf_h / 4.8) * sg, 1000000, wf_x, wf_w,
                              pr * 0.5 + 0.1, pgg * 0.5 + 0.1, pb * 0.5 + 0.1, 0.45, p_reverse[oi] > 0.5);
          swing_grid_wvb_lane(oi, 1, _wv_lk, wf_y + wf_h * 0.75, (wf_h / 4.8) * sg, 1000000, wf_x, wf_w,
                              pr * 0.5 + 0.1, pgg * 0.5 + 0.1, pb * 0.5 + 0.1, 0.45, p_reverse[oi] > 0.5);
        ) : (
          swing_grid_wvb_lane(oi, _wv_mc, _wv_lk, wf_y + wf_h * 0.5, (wf_h / 2.4) * sg, 1000000, wf_x, wf_w,
                              pr * 0.5 + 0.1, pgg * 0.5 + 0.1, pb * 0.5 + 0.1, 0.45, p_reverse[oi] > 0.5);
        );
        ov_set(pr * 0.5 + 0.1, pgg * 0.5 + 0.1, pb * 0.5 + 0.1, 0.45);
      ) : (
      p_stereo[oi] ? (
        _wf_amp_scale = (wf_h / 4.8) * (_wv_use_cache ? 1.0 : sg);
        _wv_top_cy    = wf_y + wf_h * 0.25;
        _wv_bot_cy    = wf_y + wf_h * 0.75;
        j = 0; loop(wf_w,
          _rev_j = p_reverse[oi] ? (wf_w - 1 - j) : j;
          // The per-pad cache (a PLAIN pad) is stored already reversed by build_wv_cache (the grid tile reads it
          // as is); flipping it again here drew a reversed plain pad forward while its trim markers were mirrored
          // (LIB312). The per-layer cache and the live buffer are forward: those take the flip.
          _wv_cj = (p_layer_cnt[oi] == 0) ? j : _rev_j;
          _wv_use_cache ? (
            _ci = (_wv_cj * WV_RES / wf_w)|0; _ci = min(_ci, WV_RES - 1);
            _sL = _wv_cL[_ci]; _sR = _wv_cR[_ci];
          ) : (
            sample_idx = (_vis_s0 + (_rev_j * step)|0);
            sample_idx = min(sample_idx, _mono_len - 1);
            _sL = buf[sample_idx * 2]; _sR = buf[sample_idx * 2 + 1];
          );
          val_L = abs(_sL) * _wf_amp_scale;
          val_R = abs(_sR) * _wf_amp_scale;
          gfx_line(wf_x + j, _wv_top_cy - val_L, wf_x + j, _wv_top_cy + val_L);
          gfx_line(wf_x + j, _wv_bot_cy - val_R, wf_x + j, _wv_bot_cy + val_R);
          j += 1;
        );
      ) : (
        wv_cy = wf_y + wf_h * 0.5;
        _wf_amp_scale = (wf_h / 2.4) * (_wv_use_cache ? 1.0 : sg);
        j = 0; loop(wf_w,
          _rev_j = p_reverse[oi] ? (wf_w - 1 - j) : j;
          _wv_cj = (p_layer_cnt[oi] == 0) ? j : _rev_j;   // the plain pad's cache is stored reversed (LIB312, above)
          _wv_use_cache ? (
            _ci = (_wv_cj * WV_RES / wf_w)|0; _ci = min(_ci, WV_RES - 1);
            _sL = _wv_mc ? _wv_cR[_ci] : _wv_cL[_ci];
          ) : (
            sample_idx = (_vis_s0 + (_rev_j * step)|0);
            sample_idx = min(sample_idx, _mono_len - 1);
            _sL = buf[sample_idx * 2 + _wv_mc];
          );
          val = _sL * _wf_amp_scale;  // L = R for mono
          gfx_line(wf_x + j, wv_cy - val, wf_x + j, wv_cy + val);
          j += 1;
        );
      );
      );   // (Peak, zoomed, or bins not ready: the lines above, as before the row)

      // ── Start/end trim markers (zoom-aware, mirrored when reversed) ──
      // Convert normalized start/end to pixel positions in the current view
      p_reverse[oi] ? (
        sx = wf_x + wf_w - (_send - _view_start) / _view_w * wf_w;
        ex = wf_x + wf_w - (_sstart - _view_start) / _view_w * wf_w;
      ) : (
        sx = wf_x + (_sstart - _view_start) / _view_w * wf_w;
        ex = wf_x + (_send - _view_start) / _view_w * wf_w;
      );
      mid_y = wf_y + wf_h / 2;
      // Only draw markers if they're in the visible range
      sx >= wf_x - 5 && sx <= wf_x + wf_w + 5 ? (
        ov_set(1, 1, 0, 0.7); gfx_line(sx, wf_y, sx, wf_y + wf_h);
        ov_set(1, 1, 0, 0.9); gfx_rect(sx - ov_px(2), mid_y - ov_px(15), ov_px(5), ov_px(30), 1);
      );
      ex >= wf_x - 5 && ex <= wf_x + wf_w + 5 ? (
        ov_set(1, 0.3, 0.3, 0.7); gfx_line(ex, wf_y, ex, wf_y + wf_h);
        ov_set(1, 0.3, 0.3, 0.9); gfx_rect(ex - ov_px(2), mid_y - ov_px(15), ov_px(5), ov_px(30), 1);
      );

      // ── Sample offset dim overlay (absolute position) ──
      p_sample_offset[oi] > 0.001 ? (
        _ofs_norm = p_sample_offset[oi];  // absolute 0-1 in full sample
        p_reverse[oi] ? (
          // Reverse: dim from offset to end (right side of reversed view)
          _dim_left = wf_x + wf_w - (_ofs_norm - _view_start) / _view_w * wf_w;
          _dim_right = wf_x + wf_w - (_sstart - _view_start) / _view_w * wf_w;
        ) : (
          // Forward: dim from start to offset
          _dim_left = wf_x + (_sstart - _view_start) / _view_w * wf_w;
          _dim_right = wf_x + (_ofs_norm - _view_start) / _view_w * wf_w;
        );
        _dim_left = max(wf_x, min(wf_x + wf_w, _dim_left));
        _dim_right = max(wf_x, min(wf_x + wf_w, _dim_right));
        _dim_right > _dim_left ? (
          ov_set(0.06, 0.06, 0.08, 0.7);
          gfx_rect(_dim_left, wf_y, _dim_right - _dim_left, wf_h);
        );
      );

      // ── Zero-crossing center line ──
      ov_set(0.4, 0.4, 0.4, 0.15);
      gfx_line(wf_x, wf_y + wf_h * 0.5, wf_x + wf_w, wf_y + wf_h * 0.5);

      // ── Zoom indicator (top-right of waveform) ──
      wf_zoom > 1.01 ? (
        ov_font(9, 0);   // regular: a bold 9 px "5" draws as a "6" (wiki 4.7)
        ov_set(0.7, 0.7, 0.7, 0.9);   // readable (2026-10-29: 3.5:1 at 0.6)
        sprintf(#_ztxt, "%.0fx", wf_zoom);
        gfx_measurestr(#_ztxt, tw, th);
        gfx_x = wf_x + wf_w - tw - ov_px(4); gfx_y = wf_y + ov_px(3); gfx_drawstr(#_ztxt);
        // Scroll bar indicator at bottom of waveform
        ov_set(0.5, 0.5, 0.5, 0.3);
        _sb_x = wf_x + wf_scroll * wf_w;
        _sb_w = max(4, _view_w * wf_w);
        gfx_rect(_sb_x, wf_y + wf_h - ov_px(3), _sb_w, ov_px(3));
      );

      // ── Trim drag interaction (zoom-aware with zero-crossing snap) ──
      //
      // Reverse-mode handling:
      //   When p_reverse is on, the waveform AND the handle markers
      //   mirror horizontally (the _rev_j index flip in the waveform loops
      //   and the p_reverse sx/ex swap in the handle-marker block). Means:
      //     - sx (active_id 200) is visually positioned by _send (right side)
      //     - ex (active_id 201) is visually positioned by _sstart (left side)
      //   Two corrections required for drag to feel natural:
      //     1. Mirror the X→sample mapping so dragging right means a higher
      //        sample position regardless of reverse state (the user's mouse
      //        moves with the visible handle).
      //     2. Swap which variable each active_id updates so the handle the
      //        user grabbed is the one that visibly moves.
      active_id == 200 ? (
        LMB ? (
          _raw_norm = p_reverse[oi]
            ? (_view_end - ((mx - wf_x) / wf_w) * _view_w)
            : (_view_start + ((mx - wf_x) / wf_w) * _view_w);
          // Snap to zero crossing if enabled
          wf_snap_zc ? (
            _zc_si = (_raw_norm * _mono_len)|0;
            _zc_si = max(0, min(_mono_len - 2, _zc_si));
            // Search ±64 samples for nearest zero crossing
            _best_d = 9999; _best_i = _zc_si; _zi = max(0, _zc_si - 64);
            loop(128,
              _zi < _mono_len - 1 ? (
                buf[_zi * 2] * buf[(_zi + 1) * 2] <= 0 ? (
                  _d = abs(_zi - _zc_si);
                  _d < _best_d ? ( _best_d = _d; _best_i = _zi; );
                );
              );
              _zi += 1;
            );
            _raw_norm = _best_i / _mono_len;
          );
          // Forward: sx → s_start. Reverse: sx tracks s_end (mirrored).
          p_reverse[oi] ? (
            p_layer_cnt[oi] > 0 ? (
              l_end[_ovw_lidx] = min(1, max(_raw_norm, l_start[_ovw_lidx] + 0.005));
            ) : (
              s_end[oi] = min(1, max(_raw_norm, s_start[oi] + 0.005));
            );
          ) : (
            p_layer_cnt[oi] > 0 ? (
              l_start[_ovw_lidx] = max(0, min(_raw_norm, l_end[_ovw_lidx] - 0.005));
            ) : (
              s_start[oi] = max(0, min(_raw_norm, s_end[oi] - 0.005));
            );
          );
          _ov_mirror_trim_to_pad(oi, _ovw_lidx);
          mark_dirty_pad(oi);   // the trim is an edit: the undo entry, the kit's SAVE dot, the project's dirty flag (LIB313)
        ) : active_id = -1;
      );
      active_id == 201 ? (
        LMB ? (
          _raw_norm = p_reverse[oi]
            ? (_view_end - ((mx - wf_x) / wf_w) * _view_w)
            : (_view_start + ((mx - wf_x) / wf_w) * _view_w);
          // Snap to zero crossing if enabled
          wf_snap_zc ? (
            _zc_si = (_raw_norm * _mono_len)|0;
            _zc_si = max(0, min(_mono_len - 2, _zc_si));
            _best_d = 9999; _best_i = _zc_si; _zi = max(0, _zc_si - 64);
            loop(128,
              _zi < _mono_len - 1 ? (
                buf[_zi * 2] * buf[(_zi + 1) * 2] <= 0 ? (
                  _d = abs(_zi - _zc_si);
                  _d < _best_d ? ( _best_d = _d; _best_i = _zi; );
                );
              );
              _zi += 1;
            );
            _raw_norm = _best_i / _mono_len;
          );
          // Forward: ex → s_end. Reverse: ex tracks s_start (mirrored).
          p_reverse[oi] ? (
            p_layer_cnt[oi] > 0 ? (
              l_start[_ovw_lidx] = max(0, min(_raw_norm, l_end[_ovw_lidx] - 0.005));
            ) : (
              s_start[oi] = max(0, min(_raw_norm, s_end[oi] - 0.005));
            );
          ) : (
            p_layer_cnt[oi] > 0 ? (
              l_end[_ovw_lidx] = min(1, max(_raw_norm, l_start[_ovw_lidx] + 0.005));
            ) : (
              s_end[oi] = min(1, max(_raw_norm, s_start[oi] + 0.005));
            );
          );
          _ov_mirror_trim_to_pad(oi, _ovw_lidx);
          mark_dirty_pad(oi);   // as the start handle (LIB313)
        ) : active_id = -1;
      );
      active_id == -1 && lmb_down ? (
        mx >= sx - ov_px(4) && mx <= sx + ov_px(5) && my >= mid_y - ov_px(15) && my <= mid_y + ov_px(15) ? active_id = 200;
        mx >= ex - ov_px(4) && mx <= ex + ov_px(5) && my >= mid_y - ov_px(15) && my <= mid_y + ov_px(15) ? active_id = 201;
      );

      // ── Middle-click/Ctrl+drag to scroll when zoomed ──
      _in_wf && wf_zoom > 1.01 ? (
        (mouse_cap & 64) || (CTRL && LMB) ? (  // middle mouse or ctrl+left
          _scroll_active == 0 && lmb_down ? ( _scroll_active = 1; _scroll_mx = mx; _scroll_orig = wf_scroll; );
        ) : _scroll_active = 0;
        _scroll_active && LMB ? (
          _dx = (mx - _scroll_mx) / wf_w;
          wf_scroll = max(0, min(1.0 - _view_w, _scroll_orig - _dx * _view_w));
        ) : _scroll_active = 0;
      );
    ) : ps_enable[oi] > 0.5 ? (
      // ── Synth pad: no waveform, and "DRAG SAMPLE HERE" is the wrong thing
      // to say. It reads as "this pad is empty" when the pad is a working
      // synth voice, and it is an instruction you do not want followed.
      // Name what the pad IS instead.
      //
      // ⭐ The ADSR drawn over this box is NOT decoration on a synth pad: the
      // pad envelope GATES the engine (Swing_ReaKit, SYN branch of the voice
      // render), so attack and decay here shape the synth exactly as they
      // shape a sample. That is why this slot keeps its envelope rather than
      // collapsing — the only dead thing here was the waveform.
      // Label at the top, hint at the bottom, so the envelope curve crosses
      // the middle without running through either.
      // _syn_engine_name / _syn_engine_col resolve: Swing_ReaKit.jsfx imports
      // rk_swing_ui_overlay_syn right before this file.
      // ── the voice itself, rendered ──────────────────────────────────────
      // Rebuild only when the ENGINE changed; the envelope is applied below
      // per column, so dragging ATK/DEC/SUS costs nothing.
      swing_synprev_stale(oi) ? swing_synprev_build(oi);
      // Per-COLUMN envelope coefficients: the same stage machine the voice
      // runs, stepped once per column instead of once per sample. Coarse by
      // design — this is a picture, and 512 columns is finer than the pixels.
      _sp_cw  = max(1, ((synp_key[12] * srate) | 0) / SYNPREV_COLS) | 0;
      _sp_ac  = pow(exp(-5.0 / max(1, p_attack[oi]  * 0.001 * srate)), _sp_cw);
      _sp_dc  = pow(exp(-5.0 / max(1, p_decay[oi]   * 0.001 * srate)), _sp_cw);
      _sp_sus = max(0, min(1, p_sustain[oi]));
      _sp_env = 0; _sp_stg = 1;
      _syn_engine_col(ps_engine[oi] | 0, 1.0);
      _sp_col = 0;
      loop(SYNPREV_COLS,
        _sp_stg == 1 ? (
          _sp_env = 1.0 - (1.0 - _sp_env) * _sp_ac;
          _sp_env >= 0.999 ? ( _sp_env = 1.0; _sp_stg = 2; );
        ) : _sp_stg == 2 ? (
          _sp_env = _sp_sus + (_sp_env - _sp_sus) * _sp_dc;
          _sp_env = max(_sp_sus, _sp_env);
          _sp_env <= _sp_sus + 0.001 ? ( _sp_env = _sp_sus; _sp_stg = 3; );
        ) : ( _sp_env = _sp_sus; );
        _sp_y = synp_hi[_sp_col] * _sp_env * (wf_h * 0.42);
        _sp_x = wf_x + _sp_col * wf_w / SYNPREV_COLS;
        // Body then a brighter cap, so a long quiet tail still reads.
        ov_set(_syn_ecr, _syn_ecg, _syn_ecb, 0.34);
        gfx_rect(_sp_x, wf_y + wf_h * 0.5 - _sp_y, max(1, wf_w / SYNPREV_COLS), _sp_y * 2);
        _sp_y > 0.6 ? (
          ov_set(_syn_ecr, _syn_ecg, _syn_ecb, 0.75);
          gfx_rect(_sp_x, wf_y + wf_h * 0.5 - _sp_y, max(1, wf_w / SYNPREV_COLS), 1);
          gfx_rect(_sp_x, wf_y + wf_h * 0.5 + _sp_y - 1, max(1, wf_w / SYNPREV_COLS), 1);
        );
        _sp_col += 1;
      );
      // Window length, TOP-right (the engine name is centred at +10, so the
      // two never meet). The scale MOVES, so it has to be stated
      // or a short pad and a long one look identical.
      ov_font(8, 0);
      ov_set(0.62, 0.65, 0.70, 1);   // readable (2026-10-29: 2.6:1)
      sprintf(#_ov_syn_lbl, "%.2f s", synp_key[12]);
      gfx_measurestr(#_ov_syn_lbl, tw, th);
      gfx_x = wf_x + wf_w - tw - ov_px(5); gfx_y = wf_y + ov_px(4);
      gfx_drawstr(#_ov_syn_lbl);
      ov_set(_syn_ecr, _syn_ecg, _syn_ecb, 0.70);
      _syn_engine_name((ps_engine[oi] | 0) % 10);
      sprintf(#_ov_syn_lbl, "%s  T%d", #_syn_en, (((ps_engine[oi] | 0) * 0.1) | 0) + 1);
      ov_font(13, 'b');
      gfx_measurestr(#_ov_syn_lbl, tw, th);
      gfx_x = wf_x + (wf_w - tw) / 2; gfx_y = wf_y + ov_px(10);
      gfx_drawstr(#_ov_syn_lbl);
      ov_font(9, 0);
      ov_set(0.62, 0.65, 0.70, 1);   // readable (2026-10-29: 2.8:1)
      // the hint, cut to the display's width (the zoom makes it wider than the display at the narrowest)
      gfx_measurestr("ENVELOPE GATES THE ENGINE - DROP A SAMPLE TO LAYER", tw, th);
      tw > wf_w - ov_px(8) ? ( strcpy(#_ov_syn_lbl, "DROP A SAMPLE TO LAYER"); ) : strcpy(#_ov_syn_lbl, "ENVELOPE GATES THE ENGINE - DROP A SAMPLE TO LAYER");
      gfx_measurestr(#_ov_syn_lbl, tw, th);
      gfx_x = wf_x + (wf_w - tw) / 2; gfx_y = wf_y + wf_h - th - ov_px(7);
      gfx_drawstr(#_ov_syn_lbl);
    ) : (
      ov_set(0.62, 0.65, 0.70, 1);   // readable (2026-10-29: it read 1.8:1)
      ov_font(10, 0);
      gfx_measurestr("DRAG SAMPLE HERE", tw, th);
      gfx_x = wf_x + (wf_w - tw)/2; gfx_y = wf_y + (wf_h - th)/2; gfx_drawstr("DRAG SAMPLE HERE");
    );

    // ADSR envelope overlay (same frame, on top of waveform) — 4-node design
    env_x = wf_x; env_y = wf_y; env_w = wf_w; env_h = wf_h;
    a_ms = max(1, p_attack[oi]);
    d_ms = max(1, p_decay[oi]);
    r_ms = max(1, p_release[oi]);
    sus_lv = p_sustain[oi];
    env_margin = ov_px(6);  // px inset from top/bottom

    // Fixed-zone layout: each ADSR segment gets a fixed max pixel allocation.
    // Node positions depend only on their own parameter (+ preceding for sequencing).
    // This prevents the bug where changing one parameter visually shifts other nodes.
    // Max values match the actual knob ranges.
    a_max_w  = env_w * 0.20;   // attack zone:  1-1000ms
    d_max_w  = env_w * 0.35;   // decay zone:   1-10000ms
    s_hold_w = env_w * 0.10;   // sustain hold:  fixed
    r_max_w  = env_w * 0.35;   // release zone: 1-5000ms

    // Pixel widths from parameter values (LOG scaling for time params,
    // matching the log drag mapping below). Linear scaling collapsed
    // 1-100ms decay into ~1 pixel, leaving the D node visually pinned
    // to the A node and impossible to grab. Log spreads the low end so
    // a 50ms decay sits visibly past the A node.
    //   log(value) / log(max) * width
    //   value=1   → 0 (start of zone)
    //   value=max → width (end of zone)
    a_px = min(a_max_w, log(a_ms)  / log(1000.0)  * a_max_w);
    d_px = min(d_max_w, log(d_ms)  / log(10000.0) * d_max_w);
    r_px = min(r_max_w, log(r_ms)  / log(5000.0)  * r_max_w);
    s_px = s_hold_w;

    // Node coordinates — sequential, each depends only on own + prior params.
    //
    // The envelope NEVER mirrors for reverse. The X axis of this panel is
    // PLAYBACK TIME, and the _rev_j waveform flip above already re-anchors it:
    // screen-left is whatever audio plays FIRST, in both directions. The ADSR
    // itself is direction-blind — the engine ramps attack from v_age==0, the
    // moment the note fires, wherever v_pos is walking. A second mirror here
    // (the old behaviour) cancelled the waveform flip and parked the drawn
    // attack over the audio that plays LAST — the one orientation that is
    // wrong for both ways of reading the panel.
    //
    // _adsr_dir kept as the node-math step sign (always +1 now) so the
    // coordinate chain below stays untouched.
    _adsr_dir = 1;
    n0x = env_x;
                              n0y = env_y + env_h - env_margin;   // attack start
    n1x = n0x + _adsr_dir * a_px;  n1y = env_y + env_margin;           // attack peak
    n2x = n1x + _adsr_dir * d_px;  n2y = env_y + env_margin + (env_h - env_margin*2) * (1 - sus_lv);
    n3x = n2x + _adsr_dir * s_px;  n3y = n2y;                          // sustain end
    n4x = n3x + _adsr_dir * r_px;  n4y = env_y + env_h - env_margin;   // release end

    // Filled envelope shape (semi-transparent over waveform) — 4 nodes.
    // Loop step uses _adsr_dir so the fill walks in the correct direction.
    ov_set(pr * 0.4, pgg * 0.4, pb * 0.4, 0.25);
    j = 0; loop(max(1, (a_px)|0),
      fx = n0x + _adsr_dir * j; fy = n0y + (n1y - n0y) * (j / max(1, a_px));
      gfx_line(fx, fy, fx, env_y + env_h - env_margin); j += 1;
    );
    j = 0; loop(max(1, (d_px)|0),
      fx = n1x + _adsr_dir * j; t = j / max(1, d_px); fy = n1y + (n2y - n1y) * t;
      gfx_line(fx, fy, fx, env_y + env_h - env_margin); j += 1;
    );
    j = 0; loop(max(1, (s_px)|0),
      fx = n2x + _adsr_dir * j; gfx_line(fx, n2y, fx, env_y + env_h - env_margin); j += 1;
    );
    j = 0; loop(max(1, (r_px)|0),
      fx = n3x + _adsr_dir * j; t = j / max(1, r_px); fy = n3y + (n4y - n3y) * t;
      gfx_line(fx, fy, fx, env_y + env_h - env_margin); j += 1;
    );

    // Envelope line (bright, visible over waveform) — all 5 points
    ov_set(pr * 0.5 + 0.5, pgg * 0.5 + 0.5, pb * 0.5 + 0.5, 0.85);
    gfx_line(n0x, n0y, n1x, n1y);    // attack start → attack peak
    gfx_line(n1x, n1y, n2x, n2y);    // decay → sustain
    gfx_line(n2x, n2y, n3x, n3y);    // sustain → sustain-end
    gfx_line(n3x, n3y, n4x, n4y);    // sustain-end → release

    // Draggable nodes — 4 independent nodes: A, D, S, R
    // n0 is fixed (attack start), n3 is auto-positioned (sustain end)
    nr = ov_px(7);
    _nr_hit = nr + ov_px(8);  // generous hit radius for easy grabbing
    // 3-node display (adsr_3node, gear pref): the S node vanishes and the D
    // node carries sustain on its Y axis. Purely presentational — the D node
    // ALREADY sits at sustain height (n2y derives from sus_lv), so nothing
    // about the drawn shape changes; only which handle owns the level does.
    // All four engine params stay live either way.
    ov_set(1, 0.9, 0.3, 1);   gfx_circle(n1x, n1y, nr, 1);   // A — attack peak (yellow), drag X = attack time
    ov_set(0.5, 0.8, 1, 1);   gfx_circle(n2x, n2y, nr, 1);   // D — decay end (blue), drag X = decay time (+Y = sustain in 3-node)
    !adsr_3node ? ( ov_set(0.3, 1, 0.7, 1); gfx_circle(n3x, n3y, nr, 1); );  // S — sustain level (green), drag Y = sustain level
    ov_set(1, 0.4, 0.4, 1);   gfx_circle(n4x, n4y, nr, 1);   // R — release end (red), drag X = release time

    // Node labels
    ov_font(10, 'b'); ov_set(0.75, 0.77, 0.80, 0.85);
    gfx_x = n1x - ov_px(6); gfx_y = n1y - ov_px(12); gfx_drawstr("A");
    gfx_x = n2x - ov_px(6); gfx_y = n2y + ov_px(6);  gfx_drawstr("D");
    !adsr_3node ? ( gfx_x = n3x - ov_px(6); gfx_y = n3y - ov_px(12); gfx_drawstr("S"); );
    gfx_x = n4x - ov_px(6); gfx_y = n4y + ov_px(6);  gfx_drawstr("R");

    // Node interaction (drag IDs: 210=attack, 211=decay, 212=sustain, 213=release)
    // Delta-based: capture mouse + value on mousedown, apply delta during drag.
    // Each uses its own zone width as divisor — fully decoupled.
    //
    // Time params (A/D/R) use LOG scaling: each pixel of drag scales the
    // current value by a constant factor instead of adding a fixed ms.
    // Without this, low values (1-50ms — the most musically useful range
    // for drum samples) collapse into a few pixels and become impossible
    // to dial in. Log mapping gives full pixel-resolution at the bottom
    // and faster sweeps at the top. Sustain stays linear because it's a
    // 0..1 level, not a time.
    // _adsr_dir is fixed +1 (the envelope no longer mirrors for reverse),
    // so the drag mapping is plain rightward-grows in both directions.
    active_id == 210 ? (  // A node (n1) — drag X = attack time (1..1000ms log)
      LMB ? (
        delta_px = (mx - adsr_drag_mx) * _adsr_dir;
        // log(1000) ≈ 6.91 — full drag width sweeps 1..1000ms.
        p_attack[oi] = max(1, min(1000,
          max(1, adsr_drag_val) * exp((delta_px / max(1, a_max_w)) * log(1000))
        ));
        p_adsr_user[oi] = 1;  // user-tuned — skip auto-analyze on next drag-in
        swing_rcp_post_pad(oi); s_dirty[oi] = 1; mark_dirty_pad(oi);
      ) : active_id = -1;
    );
    active_id == 211 ? (  // D node (n2) — drag X = decay time (1..10000ms log)
      LMB ? (
        delta_px = (mx - adsr_drag_mx) * _adsr_dir;
        // log(10000) ≈ 9.21. Wide range covers atmospheric tails; log
        // keeps the 1-200ms drum range precise at the bottom.
        p_decay[oi] = max(1, min(10000,
          max(1, adsr_drag_val) * exp((delta_px / max(1, d_max_w)) * log(10000))
        ));
        // 3-node display: D also owns sustain on Y (the hidden S node's job).
        // Same delta mapping as the S handler; second capture slot so both
        // axes stay drag-relative at once.
        adsr_3node ? (
          delta_py = my - adsr_drag_my;
          p_sustain[oi] = max(0, min(1, adsr_drag_val2 - delta_py / max(1, env_h - env_margin * 2)));
        );
        p_adsr_user[oi] = 1;
        swing_rcp_post_pad(oi); s_dirty[oi] = 1; mark_dirty_pad(oi);
      ) : active_id = -1;
    );
    active_id == 212 ? (  // S node (n3) — drag Y = sustain level (linear 0..1)
      LMB ? (
        // Y axis is unaffected by reverse — sustain is a level, not a time.
        delta_py = my - adsr_drag_my;
        p_sustain[oi] = max(0, min(1, adsr_drag_val - delta_py / max(1, env_h - env_margin * 2)));
        p_adsr_user[oi] = 1;
        swing_rcp_post_pad(oi); s_dirty[oi] = 1; mark_dirty_pad(oi);
      ) : active_id = -1;
    );
    active_id == 213 ? (  // R node (n4) — drag X = release time (1..5000ms log)
      LMB ? (
        delta_px = (mx - adsr_drag_mx) * _adsr_dir;
        // log(5000) ≈ 8.52. Extended for ambient/reverb-tail samples.
        p_release[oi] = max(1, min(5000,
          max(1, adsr_drag_val) * exp((delta_px / max(1, r_max_w)) * log(5000))
        ));
        p_adsr_user[oi] = 1;
        swing_rcp_post_pad(oi); s_dirty[oi] = 1; mark_dirty_pad(oi);
      ) : active_id = -1;
    );

    // Display border
    ov_set(0.22, 0.23, 0.27, 1); gfx_rect(wf_x, wf_y, wf_w, wf_h, 0);

    // Center play button
    center_x = wf_x + wf_w / 2;
    center_y = wf_y + wf_h / 2;
    ov_set(0.8, 0.8, 0.8, 0.5);
    gfx_circle(center_x, center_y, ov_px(15), 1);
    ov_set(0.2, 0.2, 0.2, 1);
    ov_font(10, 'b');
    gfx_measurestr("▶", tw, th);
    gfx_x = center_x - tw/2; gfx_y = center_y - th/2; gfx_drawstr("▶");

    // Center trigger — use proper voice launcher (handles choke groups, voice stealing)
    active_id == -1 && lmb_down && abs(mx - center_x) <= ov_px(15) && abs(my - center_y) <= ov_px(15) && pad_is_playable(oi) ? (
      swing_gt_post(oi, p_note[oi], 127, 8);
      p_held[oi] = 1; p_held_vel[oi] = 127; p_held_note[oi] = p_note[oi]; gui_held_pad = oi;
    );

    // Node hit detection — priority order with early exit (generous hit area)
    active_id == -1 && lmb_down && my >= env_y - _nr_hit && my <= env_y + env_h + _nr_hit ? (
      adsr_drag_mx = mx; adsr_drag_my = my;
      dist(mx, my, n1x, n1y) <= _nr_hit ? (
        active_id = 210; adsr_drag_val = p_attack[oi];
      ) : dist(mx, my, n2x, n2y) <= _nr_hit ? (
        active_id = 211; adsr_drag_val = p_decay[oi];
        adsr_drag_val2 = p_sustain[oi];   // 3-node: D's Y axis edits sustain
      ) : !adsr_3node && dist(mx, my, n3x, n3y) <= _nr_hit ? (
        active_id = 212; adsr_drag_val = p_sustain[oi];
      ) : dist(mx, my, n4x, n4y) <= _nr_hit ? (
        active_id = 213; adsr_drag_val = p_release[oi];
      );
    );
    ov_scr = 0;
    );   // (the full view: _wfd above)

    // (Right-click "Re-analyze ADSR" removed — auto-analysis was unreliable
    // from inside JSFX. Will be re-added when the EON Extension can do it
    // properly with the actual sample in C++ instead of a JSFX heuristic.)

    // 8 knobs: ATK, DEC, SUS, REL, GAIN, PAN, TUNE, OFS -- under the ENVELOPE bar, under the display. While the layer
    // mixer shows (ov_lmix_on, rk_swing_ui_layer_mixer) GAIN and PAN live on its gold PAD strip: six knobs, evenly
    // spread (the knob memory keeps each knob's own slot, k). Folded (pfx_fold & 1): the bar alone; the envelope's handles
    // on the display still edit it. Lit: the pad is tuned or starts late.
    knob_r = ov_px(13 * ov_genv);   // OV_ENV_OPEN_H counts on 13 (design px); ov_genv: its share of the room (step 2)
    p_tune[oi] != 0 && p_sample_offset[oi] > 0.001 ? sprintf(#ov_fsum, "TUNE %+.0f  OFS %.0f%%", p_tune[oi], p_sample_offset[oi] * 100)
    : p_tune[oi] != 0 ? sprintf(#ov_fsum, "TUNE %+.0f", p_tune[oi])
    : p_sample_offset[oi] > 0.001 ? sprintf(#ov_fsum, "OFS %.0f%%", p_sample_offset[oi] * 100)
    : strcpy(#ov_fsum, "");
    _ov_fold_bar(wf_y + wf_h + ov_px(4), 1, "ENVELOPE", p_tune[oi] != 0 || p_sample_offset[oi] > 0.001);
    krow_y = wf_y + wf_h + ov_px(4 + OV_FOLD_BLK);   // the knob row's top (the knobs' centres knob_r + 2 below)
    ov_env_end = (pfx_fold & 1) ? krow_y : wf_y + wf_h + ov_px(OV_ENV_OPEN_H + 26 * (ov_genv - 1));   // + the knobs' growth
    ov_eq_top = ov_env_end;                   // the EQ follows (the two-column form moves it: rk_swing_ui_padfx_panel)
    !(pfx_fold & 1) ? (
    k_spacing = op_w / (ov_lmix_on ? 6 : 8);

    km_base = km_pads + oi * KM_PER_PAD * KS;

    // ATK (0)
    // ATK / DEC / REL knobs use LOG scaling so the low-end (1-100ms,
    // the most musically useful range for drum samples) gets the bulk
    // of the knob travel. Same approach as the ADSR drag nodes above.
    // Implementation: normalize the time value to a 0..1 log position,
    // run the knob in that normalized space, convert back on change.
    k = 0; kcx = op_x + k_spacing * 0.5 + k * k_spacing; kcy = krow_y + knob_r + ov_px(2);
    km = km_base + k * KS;
    _atk_log_max = log(1000);
    _atk_norm    = log(max(1, p_attack[oi])) / _atk_log_max;
    _atk_def_n   = log(5)   / _atk_log_max;
    _atk_new_n = ssl_knob_interact(km, kcx, kcy, knob_r, _atk_norm, 0, 1, _atk_def_n, 0);
    _atk_new_n != _atk_norm ? (
      p_attack[oi] = max(1, min(1000, exp(_atk_new_n * _atk_log_max)));
      p_adsr_user[oi] = 1; swing_rcp_post_pad(oi); s_dirty[oi] = 1; mark_dirty_pad(oi);
    );
    ssl_knob_draw(kcx, kcy, knob_r, _atk_norm, 0, 1, 0, km[0], 0.90, 0.66, 0.20, 0);
    // Overlay label/value ink is fixed gfx_set, NOT the theme TEXT slots: this
    // overlay's surface is hardcoded dark, so a light theme's near-black TEXT
    // colour would vanish on it (labels disappeared under the EON theme).
    ov_font(9, 'b'); ov_set(0.70,0.72,0.75, 1);
    gfx_measurestr("ATK",tw,th); gfx_x=kcx-tw/2; gfx_y=kcy+knob_r+ov_px(2); gfx_drawstr("ATK");
    ov_font(9, 0);   // the value: regular, bold 8-9 px digits misread (wiki 4.7)
    sprintf(#kv,"%.0f",p_attack[oi]); gfx_measurestr(#kv,tw,th);
    ov_set(0.68,0.70,0.74,1); gfx_x=kcx-tw/2; gfx_y=kcy+knob_r+ov_px(10); gfx_drawstr(#kv);

    // DEC (1)
    k = 1; kcx = op_x + k_spacing * 0.5 + k * k_spacing; kcy = krow_y + knob_r + ov_px(2);
    km = km_base + k * KS;
    _dec_log_max = log(10000);
    _dec_norm    = log(max(1, p_decay[oi])) / _dec_log_max;
    _dec_def_n   = log(500) / _dec_log_max;
    _dec_new_n = ssl_knob_interact(km, kcx, kcy, knob_r, _dec_norm, 0, 1, _dec_def_n, 0);
    _dec_new_n != _dec_norm ? (
      p_decay[oi] = max(1, min(10000, exp(_dec_new_n * _dec_log_max)));
      p_adsr_user[oi] = 1; swing_rcp_post_pad(oi); s_dirty[oi] = 1; mark_dirty_pad(oi);
    );
    ssl_knob_draw(kcx, kcy, knob_r, _dec_norm, 0, 1, 0, km[0], 0.90, 0.66, 0.20, 0);
    ov_font(9, 'b'); ov_set(0.70,0.72,0.75, 1);
    gfx_measurestr("DEC",tw,th); gfx_x=kcx-tw/2; gfx_y=kcy+knob_r+ov_px(2); gfx_drawstr("DEC");
    ov_font(9, 0);   // the value: regular, bold 8-9 px digits misread (wiki 4.7)
    sprintf(#kv,"%.0f",p_decay[oi]); gfx_measurestr(#kv,tw,th);
    ov_set(0.68,0.70,0.74,1); gfx_x=kcx-tw/2; gfx_y=kcy+knob_r+ov_px(10); gfx_drawstr(#kv);

    // SUS (2)
    k = 2; kcx = op_x + k_spacing * 0.5 + k * k_spacing; kcy = krow_y + knob_r + ov_px(2);
    km = km_base + k * KS;
    nv = ssl_knob_interact(km, kcx, kcy, knob_r, p_sustain[oi], 0, 1.0, 1.0, 0);
    nv != p_sustain[oi] ? (p_sustain[oi] = nv; p_adsr_user[oi] = 1; s_dirty[oi] = 1; mark_dirty_pad(oi););
    ssl_knob_draw(kcx, kcy, knob_r, p_sustain[oi], 0, 1.0, 0, km[0], 0.90, 0.66, 0.20, 0);
    ov_font(9, 'b'); ov_set(0.70,0.72,0.75, 1);
    gfx_measurestr("SUS",tw,th); gfx_x=kcx-tw/2; gfx_y=kcy+knob_r+ov_px(2); gfx_drawstr("SUS");
    ov_font(9, 0);   // the value: regular, bold 8-9 px digits misread (wiki 4.7)
    sprintf(#kv,"%.0f%%",p_sustain[oi]*100); gfx_measurestr(#kv,tw,th);
    ov_set(0.68,0.70,0.74,1); gfx_x=kcx-tw/2; gfx_y=kcy+knob_r+ov_px(10); gfx_drawstr(#kv);

    // REL (3) — log scaling, see ATK comment above
    k = 3; kcx = op_x + k_spacing * 0.5 + k * k_spacing; kcy = krow_y + knob_r + ov_px(2);
    km = km_base + k * KS;
    _rel_log_max = log(5000);
    _rel_norm    = log(max(1, p_release[oi])) / _rel_log_max;
    _rel_def_n   = log(100) / _rel_log_max;
    _rel_new_n = ssl_knob_interact(km, kcx, kcy, knob_r, _rel_norm, 0, 1, _rel_def_n, 0);
    _rel_new_n != _rel_norm ? (
      p_release[oi] = max(1, min(5000, exp(_rel_new_n * _rel_log_max)));
      p_adsr_user[oi] = 1; swing_rcp_post_pad(oi); s_dirty[oi] = 1; mark_dirty_pad(oi);
    );
    ssl_knob_draw(kcx, kcy, knob_r, _rel_norm, 0, 1, 0, km[0], 0.90, 0.66, 0.20, 0);
    ov_font(9, 'b'); ov_set(0.70,0.72,0.75, 1);
    gfx_measurestr("REL",tw,th); gfx_x=kcx-tw/2; gfx_y=kcy+knob_r+ov_px(2); gfx_drawstr("REL");
    ov_font(9, 0);   // the value: regular, bold 8-9 px digits misread (wiki 4.7)
    sprintf(#kv,"%.0f",p_release[oi]); gfx_measurestr(#kv,tw,th);
    ov_set(0.68,0.70,0.74,1); gfx_x=kcx-tw/2; gfx_y=kcy+knob_r+ov_px(10); gfx_drawstr(#kv);

    !ov_lmix_on ? (   // GAIN and PAN: on the mixer's PAD strip while it shows
    // GAIN (4)
    k = 4; kcx = op_x + k_spacing * 0.5 + k * k_spacing; kcy = krow_y + knob_r + ov_px(2);
    km = km_base + k * KS;
    // in POSITION 0..1 on the gain knobs' taper (unity at 12 o'clock, +12 dB at the top, rk_swing_core swing_kgain_*; 0 .. 2 linear until 2026-10-29)
    _ov_gp = swing_kgain_g2p(p_gain[oi]);
    nv = ssl_knob_interact(km, kcx, kcy, knob_r, _ov_gp, 0, 1, KGAIN_UNITY_P, 0);
    nv != _ov_gp ? (p_gain[oi] = swing_kgain_p2g(nv); s_dirty[oi] = 1; mark_dirty_pad(oi););
    ssl_knob_draw(kcx, kcy, knob_r, swing_kgain_g2p(p_gain[oi]), 0, 1, 0, km[0], abs(p_gain[oi] - 1) > 0.001 ? 0.40 : 0.30, abs(p_gain[oi] - 1) > 0.001 ? 0.90 : 0.35, abs(p_gain[oi] - 1) > 0.001 ? 0.45 : 0.40, 0);
    ov_font(9, 'b'); ov_set(0.70,0.72,0.75,1);
    gfx_measurestr("GAIN",tw,th); gfx_x=kcx-tw/2; gfx_y=kcy+knob_r+ov_px(2); gfx_drawstr("GAIN");
    ov_font(9, 0);   // the value: regular, bold 8-9 px digits misread (wiki 4.7)
    sprintf(#kv,"%.1fdB", 20*log10(max(0.001, p_gain[oi]))); gfx_measurestr(#kv,tw,th);
    ov_set(0.68,0.70,0.74,1); gfx_x=kcx-tw/2; gfx_y=kcy+knob_r+ov_px(10); gfx_drawstr(#kv);

    // PAN (5)
    k = 5; kcx = op_x + k_spacing * 0.5 + k * k_spacing; kcy = krow_y + knob_r + ov_px(2);
    km = km_base + k * KS;
    nv = ssl_knob_interact(km, kcx, kcy, knob_r, p_pan[oi], -1.0, 1.0, 0, 0);
    nv != p_pan[oi] ? (p_pan[oi] = nv; p_panL[oi] = 1.0 - max(0.0, nv); p_panR[oi] = 1.0 + min(0.0, nv); mark_dirty_pad(oi););
    ssl_knob_draw(kcx, kcy, knob_r, p_pan[oi], -1.0, 1.0, 1, km[0], p_pan[oi] != 0 ? 0.70 : 0.30, p_pan[oi] != 0 ? 0.85 : 0.35, p_pan[oi] != 0 ? 0.30 : 0.40, 0);
    ov_font(9, 'b'); ov_set(0.70,0.72,0.75,1);
    gfx_measurestr("PAN",tw,th); gfx_x=kcx-tw/2; gfx_y=kcy+knob_r+ov_px(2); gfx_drawstr("PAN");
    ov_font(9, 0);   // the value: regular, bold 8-9 px digits misread (wiki 4.7)
    p_pan[oi] == 0 ? strcpy(#kv, "C") : sprintf(#kv, "%s%.0f", p_pan[oi]<0?"L":"R", abs(p_pan[oi])*100);
    gfx_measurestr(#kv,tw,th);
    ov_set(0.68,0.70,0.74,1); gfx_x=kcx-tw/2; gfx_y=kcy+knob_r+ov_px(10); gfx_drawstr(#kv);
    );

    // TUNE (6) — 7th column inline with other knobs
    k = 6; kcx = op_x + k_spacing * 0.5 + (ov_lmix_on ? 4 : 6) * k_spacing; kcy = krow_y + knob_r + ov_px(2);
    km = km_base + k * KS;
    nv = ssl_knob_interact(km, kcx, kcy, knob_r, p_tune[oi], -24, 24, 0, 0);
    nv != p_tune[oi] ? (p_tune[oi] = nv; swing_rcp_post_pad(oi); mark_dirty_pad(oi););
    ssl_knob_draw(kcx, kcy, knob_r, p_tune[oi], -24, 24, 1, km[0], p_tune[oi] != 0 ? 0.85 : 0.30, p_tune[oi] != 0 ? 0.45 : 0.35, p_tune[oi] != 0 ? 0.70 : 0.40, 0);
    ov_font(8, 'b'); ov_set(0.70,0.72,0.75,1);
    gfx_measurestr("TUNE",tw,th); gfx_x=kcx-tw/2; gfx_y=kcy+knob_r+ov_px(2); gfx_drawstr("TUNE");
    ov_font(8, 0);   // the value: regular, bold 8-9 px digits misread (wiki 4.7)
    sprintf(#kv,"%+.0f", p_tune[oi]); gfx_measurestr(#kv,tw,th);
    ov_set(0.68,0.70,0.74,1); gfx_x=kcx-tw/2; gfx_y=kcy+knob_r+ov_px(10); gfx_drawstr(#kv);

    // OFS (7) — sample offset
    k = 7; kcx = op_x + k_spacing * 0.5 + (ov_lmix_on ? 5 : 7) * k_spacing; kcy = krow_y + knob_r + ov_px(2);
    km = km_base + k * KS;
    nv = ssl_knob_interact(km, kcx, kcy, knob_r, p_sample_offset[oi], 0, 1.0, 0, 0);
    nv != p_sample_offset[oi] ? (p_sample_offset[oi] = nv; s_dirty[oi] = 1; mark_dirty_pad(oi););
    ssl_knob_draw(kcx, kcy, knob_r, p_sample_offset[oi], 0, 1.0, 0, km[0], 0.30, p_sample_offset[oi] > 0.001 ? 0.80 : 0.35, p_sample_offset[oi] > 0.001 ? 0.90 : 0.40, 0);
    ov_font(8, 'b'); ov_set(0.70,0.72,0.75,1);
    gfx_measurestr("OFS",tw,th); gfx_x=kcx-tw/2; gfx_y=kcy+knob_r+ov_px(2); gfx_drawstr("OFS");
    ov_font(8, 0);   // the value: regular, bold 8-9 px digits misread (wiki 4.7)
    sprintf(#kv,"%.0f%%", p_sample_offset[oi]*100); gfx_measurestr(#kv,tw,th);
    ov_set(0.68,0.70,0.74,1); gfx_x=kcx-tw/2; gfx_y=kcy+knob_r+ov_px(10); gfx_drawstr(#kv);
    );   // the envelope knobs, open

);

