// rk_auto_contrast.jsfx-inc — readable text ink for any surface colour, so labels
// never wash out as the theme changes (light themes especially). (c) EON Studios.
//
// Most themed text should use the theme's TEXT / TEXT_DIM band slots directly (the
// theme guarantees those read on its BG). Use these helpers for text drawn on a
// SUB-surface whose colour ISN'T the theme BG — an LCD, a knob cap, a coloured pad,
// or any hardcoded panel — where a fixed light/grey ink would vanish on some themes.
// They choose a near-black or near-white ink from the surface's luma (Rec.601, the
// same weighting the theme's own contrast maths use). They set gfx_r/g/b ONLY; the
// caller sets gfx_a and draws.
//
//   rk_auto_ink(sr,sg,sb);        gfx_a = 1;   gfx_drawstr(...)   // primary label
//   rk_auto_ink_dim(sr,sg,sb,.45);             gfx_drawstr(...)   // dim / secondary

@init

function rk_auto_ink(sr, sg, sb) (
  (sr * 0.299 + sg * 0.587 + sb * 0.114) > 0.55 ? (
    gfx_r = 0.12; gfx_g = 0.12; gfx_b = 0.14;   // dark ink on a light surface
  ) : (
    gfx_r = 0.93; gfx_g = 0.94; gfx_b = 0.96;   // light ink on a dark surface
  );
);

// Dim/secondary: the readable ink pulled toward the surface so it reads as subdued
// without dropping below legibility (a muted solid colour, no alpha needed).
// t in 0..1 — ~0.45 is a clear "dim", higher = fainter.
function rk_auto_ink_dim(sr, sg, sb, t) (
  rk_auto_ink(sr, sg, sb);
  gfx_r = gfx_r * (1 - t) + sr * t;
  gfx_g = gfx_g * (1 - t) + sg * t;
  gfx_b = gfx_b * (1 - t) + sb * t;
);

// Convenience: readable ink + alpha in one call (for sweeping label gfx_set sites).
function rk_auto_ink_a(sr, sg, sb, a) (
  rk_auto_ink(sr, sg, sb);
  gfx_a = a;
);

// UNIFORM label ink: a 1px dark shadow under a fixed near-white ink, so a label
// reads the SAME on every surface colour (light AND dark) without washing out.
// Unlike rk_auto_ink, this does NOT flip black/white per surface — use it where
// a consistent colour across a multi-coloured grid matters more than picking the
// per-cell optimum (e.g. Swing pad names over rainbow pads). `str` is a string
// handle (#str); sets gfx_x/gfx_y and draws at the given top-left position.
function rk_ink_label(str, x, y, a) (
  gfx_set(0, 0, 0, a * 0.72);
  gfx_x = x + 1; gfx_y = y + 1; gfx_drawstr(str);
  gfx_set(0.96, 0.96, 0.97, a);
  gfx_x = x;     gfx_y = y;     gfx_drawstr(str);
);
