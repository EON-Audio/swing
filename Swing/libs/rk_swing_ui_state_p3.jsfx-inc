// rk_swing_ui_state_p3.jsfx-inc -- part 3 of rk_swing_ui_state.jsfx-inc (5 parts), cut at a function boundary by
// .dev_tests/split_big_incs.py: REAPER's load time grows with the square of a file's size. Edit freely;
// keep each file under about 40 KB.

// ⚠️ @init IS LOAD-BEARING (.docs/wiki/02-file-structure.md).
@init

function swing_ui_misc_cmds()
local(_ki, _cj, _cn, _cnl, _cc, _ki_s)  // localized 2026-07-09: raced the @block kit-import loop (see swing_ui_process_undo note)
(
// Instance gate (audit B-6, 2026-09-14). A user save's 99 arrives with LOCK =
// the saver -- the bridge no longer auto-releases LOCK on that ack -- so only
// the saver may take it (its export state 3 does, above, and clears LOCK). An
// orphan 99 (LOCK 0: the generic "done" of loads and builds) keeps the
// broadcast refresh below. Before this gate the first idle @gfx to run took
// ANY 99: another Swing adopted the saver's staged names and colours on all 16
// pads, and the saver stayed wedged in export state 3 until a later 99.
// The LOCK test alone did not hold (sweep LIB122): the bridge releases LOCK on
// the tick after it writes the save's 99 if the saver has not taken it yet,
// and a multi-bank save lost LOCK between its dumps, so a save's 99 often read
// LOCK 0. A level-322 bridge names the save's owner for the whole save, and a
// 99 under another instance's owner is never taken here
// (swing_save_owner_free). An orphan 99 with no save in flight (owner 0, e.g.
// the Auto-Color Pads action's CMD 23) still is: that consume is how its hues
// reach the pads.
!kit_busy && gmem[KIT_GMEM_CMD] == 99
  && (gmem[KIT_GMEM_LOCK] == 0 || gmem[KIT_GMEM_LOCK] == instance_id)
  && swing_save_owner_free() ? (
  // Re-read pad names from gmem
  _ki = 0; loop(NUM_PADS,
    _ki_s = swing_bp(_ki);
    _cn = get_cname_slot(_ki_s);
    str_setlen(_cn, 0);
    _cj = 0; _cnl = 0;
    loop(KIT_GMEM_PADNAME_LEN,
      _cc = gmem[KIT_GMEM_PADNAMES + _ki * KIT_GMEM_PADNAME_LEN + _cj] | 0;
      _cc > 0 ? ( str_setchar(_cn, _cj, _cc); _cnl = _cj + 1; );
      _cj += 1;
    );
    str_setlen(_cn, _cnl);
    // Re-read color from metadata slot 12
    p_color[_ki_s] = gmem[KIT_GMEM_META + _ki * KIT_GMEM_META_PP + 12]; col_dirty = 1;
    _ki += 1;
  );
  gmem[KIT_GMEM_CMD] = 0;
  mark_dirty_pad(_undo_pad);
);

// Pad rename response: Lua bridge finished GetUserInputs (CMD 51).
// ⚠️ Nothing in Swing raises CMD 50 any more: the pad-name click opens the
// in-place editor (rk_swing_ui_grid_pads, since 2026-08-04), so this branch is
// reached only if some other writer posts CMD 50 under THIS instance's LOCK.
// Swing Lite still raises CMD 50, under its own LOCK.
//
// Multi-instance gate: only act if THIS instance owns the LOCK that
// was acquired when the rename was issued (the CMD 50 writer takes
// LOCK = its instance_id before writing the command). Without
// this gate, a second Swing instance would also see CMD=51 and apply
// the rename to ITS pad with the same index — silently overwriting
// the other instance's pad name. Also: the unconditional LOCK clear
// at the tail would release another instance's lock (the originator's
// rename is in flight and still owns the lock).
gmem[KIT_GMEM_CMD] == 51 && gmem[KIT_GMEM_LOCK] == instance_id ? (
  _rp = gmem[KIT_GMEM_PARAM1] | 0;   // pad index from CMD 50 dialog
  // Release the rename's LOCK + CMD FIRST so sync_note_names() (called
  // below) can pass its gate (CMD==0 && (LOCK==0 || LOCK==instance_id)).
  // The previous order — sync_note_names() inside the validity check,
  // CMD/LOCK clears after — meant the gate failed every time and the
  // piano-roll never got the new pad name. State 4 (kit load) has the
  // correct order; this handler just had it wrong.
  gmem[KIT_GMEM_LOCK] = 0;
  gmem[KIT_GMEM_CMD] = 0;
  _rp >= 0 && _rp < NUM_PADS ? (
    _cn = get_cname_slot(swing_bp(_rp));
    str_setlen(_cn, 0);
    _cj = 0; _cnl = 0;
    loop(KIT_GMEM_PADNAME_LEN,
      _cc = gmem[KIT_GMEM_PADNAMES + _rp * KIT_GMEM_PADNAME_LEN + _cj] | 0;
      _cc > 0 ? ( str_setchar(_cn, _cj, _cc); _cnl = _cj + 1; );
      _cj += 1;
    );
    str_setlen(_cn, _cnl);
    mark_dirty_pad(swing_bp(_rp));
    sync_note_names();
    col_dirty = 1; // re-derive auto-color from new cname
  );
);

// Peak meter decay — use pad_meterL/R (smoothed in @sample)
gi = 0; loop(NUM_PADS,
  gi_s = swing_bp(gi);
  _pk = max(pad_meterL[gi_s], pad_meterR[gi_s]);
  p_peak_hold[gi_s] = max(_pk, p_peak_hold[gi_s] * 0.92);
  gi += 1;
);

// Build dirty caches
gi = 0; loop(NUM_PADS, gi_s = swing_bp(gi); s_dirty[gi_s] ? build_wv_cache(gi_s); gi += 1;);
);

function swing_ui_set_colors() (
bg_r=0.84; bg_g=0.81; bg_b=0.76;   // warm cream body (matches iMPC housing)
hd_r=0.30; hd_g=0.30; hd_b=0.32;   // dark charcoal header strip
ac_r=0.85; ac_g=0.20; ac_b=0.12;   // AKAI red accent
ac2_r=0.28; ac2_g=0.48; ac2_b=0.72; // secondary accent (iMPC blue) — pad PAN knob etc.
sk_kp=1;                            // active theme knob style (1=SSL idle); pad knobs morph to it when a theme is live
pad_bg_r=0.58; pad_bg_g=0.57; pad_bg_b=0.55;  // iMPC grey rubber pad (lighter, more neutral)
pad_well_r=0.76; pad_well_g=0.74; pad_well_b=0.70; // cream pad well (recessed tray)
// Button colors
btn_blue_r=0.28; btn_blue_g=0.48; btn_blue_b=0.72;  // iMPC blue side buttons
btn_red_r=0.80; btn_red_g=0.18; btn_red_b=0.18;     // iMPC red (record)
btn_grey_r=0.68; btn_grey_g=0.66; btn_grey_b=0.62;   // iMPC transport grey buttons
// LCD panel colors
lcd_bg_r=0.10; lcd_bg_g=0.26; lcd_bg_b=0.35;   // deep teal LCD background
lcd_tx_r=0.70; lcd_tx_g=0.90; lcd_tx_b=0.92;   // bright LCD text

// EON unified theme — when the bridge is publishing the gmem colour band
// (gmem[GS_THEME_ID] > 0), override the housing colours from the resolved
// palette so Swing re-skins in step with the Browser / Pad-FX selector. The
// "EON" palette maps 1:1 to the defaults above, so EON looks identical and
// only Dark / Light / REAPER restyle. No band published → keep the defaults.
// Band slots (0..1 RGB, 3 floats each): BG=0, PANEL=1, ACCENT=4, ACCENT2=5.
gmem[GS_THEME_ID] > 0 ? (
  bg_r = gmem[GS_THEME_BASE+0]; bg_g = gmem[GS_THEME_BASE+1]; bg_b = gmem[GS_THEME_BASE+2];        // body   <- BG
  pad_well_r = gmem[GS_THEME_BASE+3]; pad_well_g = gmem[GS_THEME_BASE+4]; pad_well_b = gmem[GS_THEME_BASE+5]; // tray <- PANEL
  ac_r = gmem[GS_THEME_BASE+12]; ac_g = gmem[GS_THEME_BASE+13]; ac_b = gmem[GS_THEME_BASE+14];     // accent <- ACCENT
  ac2_r = gmem[GS_THEME_BASE+15]; ac2_g = gmem[GS_THEME_BASE+16]; ac2_b = gmem[GS_THEME_BASE+17];  // accent2 <- ACCENT2 (pad PAN)
  // Header strip <- ACCENT2 (the theme's secondary tone): matches the DAW for the REAPER
  // theme and gives EON/Dark their charcoal header. (Removed the brightness-guard that
  // derived a PANEL bar for light ACCENT2 — it was a fragile heuristic that mismatched
  // the REAPER theme. If one theme's ACCENT2 reads badly as a header, tune THAT theme's
  // ACCENT2 in rk_lua_theme rather than re-adding a global guess.)
  hd_r = gmem[GS_THEME_BASE+15]; hd_g = gmem[GS_THEME_BASE+16]; hd_b = gmem[GS_THEME_BASE+17];   // header <- ACCENT2
  sk_kp = gmem[GS_THEME_KNOB_P] >= 1 ? (gmem[GS_THEME_KNOB_P]|0) : 1;   // theme knob style for the pad knobs
);
);

// ── Pad-knob STYLE name (for the THEME menu's KNOB row) ────────────────────
// Knob-style index → display name written into the global #_knob_name (EEL2
// forbids #string params). Same IDs as knobs_kbsg rk_knob_draw / the Pad-FX list.
function swing_ui_knob_name(_id) (
  _id == 1  ? strcpy(#_knob_name, "SSL")       :
  _id == 2  ? strcpy(#_knob_name, "Vari-Mu")   :
  _id == 3  ? strcpy(#_knob_name, "API")       :
  _id == 4  ? strcpy(#_knob_name, "Witti")     :
  _id == 5  ? strcpy(#_knob_name, "Neve")      :
  _id == 6  ? strcpy(#_knob_name, "Joanny")    :
  _id == 7  ? strcpy(#_knob_name, "MPC")       :
  _id == 8  ? strcpy(#_knob_name, "Jog")       :
  _id == 9  ? strcpy(#_knob_name, "Rainbow")   :
  _id == 10 ? strcpy(#_knob_name, "Spice")     :
  _id == 11 ? strcpy(#_knob_name, "Encoder")   :
  _id == 12 ? strcpy(#_knob_name, "Pultec")    :
  _id == 13 ? strcpy(#_knob_name, "Ableton")   :
  _id == 14 ? strcpy(#_knob_name, "FL")        :
  _id == 15 ? strcpy(#_knob_name, "Pro Tools") :
  _id == 16 ? strcpy(#_knob_name, "FabFilter") :
  _id == 17 ? strcpy(#_knob_name, "Serum")     :
  _id == 18 ? strcpy(#_knob_name, "Roland")    :
  _id == 19 ? strcpy(#_knob_name, "Pultec Cr") :
  _id == 20 ? strcpy(#_knob_name, "Neve Alt")  :
  strcpy(#_knob_name, "Default");   // 0 / unknown
);

// ── Header caption for a value chip ────────────────────────────────────────
// The appearance chips show only their VALUE — "Mooncake", "FULL", "SSL",
// "EON" — which says nothing about what they set. This draws a dim caps
// caption immediately LEFT of a chip and returns the width it consumed, so the
// caller can shift the next (further-left) anchor by it.
//
// Returns 0 and draws NOTHING when the caption would push the chip's left edge
// past HDR_CAP_MIN_X — roughly the right edge of the "S W I N G" wordmark plus
// its subtitle. On a narrow window the cluster degrades to bare chips, which is
// today's look, rather than overlapping the branding.
//
// HDR_CAP_SEP is deliberately larger than HDR_CAP_GAP: a caption sitting an
// equal distance from the chips on both sides reads as labelling either one.
HDR_CAP_MIN_X = 160;
HDR_CAP_GAP   = 4;   // caption -> its own chip
HDR_CAP_SEP   = 6;   // extra breathing room on the caption's left
// Ink is auto-contrast against the header's ACTUAL colour, not a fixed grey:
// hd_* is the theme's ACCENT2 under a live theme, so it can land light (Light,
// PT Light) and a fixed light grey would vanish. rk_auto_ink_dim picks near-
// black or near-white from the surface luma, then pulls it back toward the
// surface — t is FAINTNESS, so hover lowers it. Kept well under the 0.45 the
// header's own subtitle uses: a caption nobody can read is not a label.
function swing_ui_hdr_cap(_lbl, _chip_x, _chip_y, _chip_h, _hot)
local(_w, _h, _used, _fs)
(
  // Font steps down (10 -> 9 -> 8) before the caption is dropped entirely —
  // a crowded row (VU picker up on a multi-out kit) used to silently lose
  // the leftmost caption, which read as "the VU picker has no label"
  // (user 2026-08-05). A smaller label beats a missing one; below 8px we
  // still drop it rather than draw the unreadable.
  _fs = 10;
  rk_font(1, _fs, 'b');
  gfx_measurestr(_lbl, _w, _h);
  while(_chip_x - _w - HDR_CAP_GAP < HDR_CAP_MIN_X && _fs > 8) (
    _fs -= 1;
    rk_font(1, _fs, 'b');
    gfx_measurestr(_lbl, _w, _h);
  );
  _used = 0;
  _chip_x - _w - HDR_CAP_GAP >= HDR_CAP_MIN_X ? (
    rk_auto_ink_dim(hd_r, hd_g, hd_b, _hot ? 0.06 : 0.22);
    gfx_a = 1;
    gfx_x = _chip_x - _w - HDR_CAP_GAP;
    gfx_y = _chip_y + (_chip_h - _h) * 0.5;
    gfx_drawstr(_lbl);
    _used = _w + HDR_CAP_GAP + HDR_CAP_SEP;
  );
  // Restore the cluster font on BOTH paths before returning — the measure above
  // already changed it, so a caption that DIDN'T fit leaks just the same. The
  // gear, EMBED, UNDO and REDO draws below set no font of their own: they
  // inherit whatever the last chip left, and their widths were measured up top
  // at Arial 11 bold. This is the exact hazard rkth_draw_chip documents when it
  // refuses to call gfx_setfont(0).
  rk_font(1, 11, 'b');
  _used;
);

// "Kit samples missing" action menu, wrapped for the same reason as the embed
// menu below: the banner click and the manual-capture mailbox open ONE menu
// from ONE string. Result indices are 1 = Relink, 2 = Load kit, 3 = Dismiss —
// see the handler further down, which is why the order must not drift.
function swing_state_relinkmenu_open(px, py) (
  swing_popup_open(px, py,
    "Relink samples folder...|Load kit...|Dismiss",
    SP_POPUP_CALLER_SAMPLES_MISSING);
);

// Embed menu (volume knobs / icons / TCP / MCP), wrapped so the header chip
// and the manual-capture mailbox open the SAME menu from ONE builder. Labels
// flip with the current state, which is exactly why it must not be duplicated.
function swing_state_embedmenu_open(px, py) (
  sprintf(#_emb_menu, "%s|%s|Show in TCP|Show in MCP",
    embed_show_knobs ? "Hide Volume Knobs" : "Show Volume Knobs",
    embed_show_icons ? "Hide Icons"        : "Show Icons");
  swing_popup_open(px, py, #_emb_menu, SP_POPUP_CALLER_EMBED_MENU);
);

// ── View-mode override menu (Spec_Swing_Dock_Mode.md) ────────────────────
// Right-click the SWING wordmark (either face) → Auto / Full UI / Rack face.
// dock_face_mode: 0 = Auto (the aspect trigger decides) · 1 = Full UI always
// · 2 = Rack face always. Serialized per instance (ser_ver 56); default 0 =
// Auto, and the variable is deliberately NEVER assigned in @init so a
// re-init can't stomp the pick. One helper carries hover tooltip, the
// opener, and the result consumer, so both faces share a single site.
function swing_ui_viewmode_click(_hx, _hy, _hw, _hh)
local(_hov, _rig_docked)
(
  _hov = mx >= _hx && mx < _hx + _hw && my >= _hy && my < _hy + _hh;
  // Left-click = the dock toggle (2026-08-26), one implementation for both
  // faces since this helper already runs in both. Docked (rig heartbeat fresh
  // + this instance flagged) -> bump POP: our pane script re-shows the float
  // and its handoff watcher does the rest. Otherwise, bridge alive -> write
  // our instance_id then bump REDOCK: the bridge selects our track and
  // launches/reuses the pane. Both cells are read-modify-write bumps (sole
  // writer = this JSFX; a reloaded instance restarting at 0 would never edge).
  // No listener -> the click does nothing and the tooltip promises nothing.
  // ⚠️ GS_RIG_ALIVE_SWING, not the shared GS_RIG_ALIVE. 2626 means "SOME pane is
  // up" and Steppa's pane stamps it too, so gating here on 2626 let a stale
  // slider42 read as docked for as long as STEPPA's pane was running -- the
  // click then posted POP to a Swing pane that was not there and did nothing
  // (2026-08-30). This cell is stamped only by EON Swing Dock.lua.
  _rig_docked = (time_precise() - gmem[GS_RIG_ALIVE_SWING]) < 2 && slider42 > 0.5;
  _hov ? (
    _rig_docked ? (
      sprintf(#tooltip, "Pop out to a floating window — right-click: view menu (%s)",
        dock_face_mode == 1 ? "Full UI" :
        dock_face_mode == 2 ? "Rack face" : "Auto");
    ) : gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? (
      sprintf(#tooltip, "Return to the dock — right-click: view menu (%s)",
        dock_face_mode == 1 ? "Full UI" :
        dock_face_mode == 2 ? "Rack face" : "Auto");
    ) : (
      sprintf(#tooltip, "View: %s — right-click for Auto / Full UI / Rack face",
        dock_face_mode == 1 ? "Full UI" :
        dock_face_mode == 2 ? "Rack face" : "Auto (by shape)");
    );
  );
  // dock_want (ser_ver 69) is the INTENT behind the click, and it outlives the
  // capture. slider42 says "the pane is holding me right now" and the pane
  // clears it on every release -- including the release that happens when the
  // user simply closes the dock tab. So a Swing that was docked, closed and
  // reopened came back floating with nobody remembering it had ever been
  // docked (2026-09-02). The re-dock hello in Swing_ReaKit.jsfx's floating
  // branch reads this flag; only the POP click clears it.
  _hov && lmb_down ? (
    _rig_docked ? (
      gmem[GS_POP_REQ_SWING] = (gmem[GS_POP_REQ_SWING]|0) + 1;
      dock_want ? ( dock_want = 0; mark_dirty(); );
      lmb_down = 0;
    ) : gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? (
      gmem[GS_REDOCK_ID_SWING]  = instance_id;
      gmem[GS_REDOCK_REQ_SWING] = (gmem[GS_REDOCK_REQ_SWING]|0) + 1;
      !dock_want ? ( dock_want = 1; mark_dirty(); );
      lmb_down = 0;
    );
  );
  _hov && rmb_down ? (
    // Rows 1-3 = this instance's face. Rows 5-8 (after the #header, which
    // counts; the || separator doesn't) = the DOCK RIG's pane layout — the
    // pick rides GS_DOCK_LAYOUT_REQ to the bridge, which relays it to
    // EON Dock Layout.lua. Labels must stay in step with that script's
    // LAYOUTS table: the 1-based index is the contract, not the text.
    sprintf(#_view_menu, "%sAuto — follow window shape|%sFull UI — always|%sRack face — always||#DOCK LAYOUT|Full rig|Beatmaking|Sound design|Pads only",
      dock_face_mode == 0 ? "^G " : "",
      dock_face_mode == 1 ? "^G " : "",
      dock_face_mode == 2 ? "^G " : "");
    // The compact switch says so (the user, 2026-10-26: show it, marked automatic): a greyed note at the END, so the
    // face rows (1-3) and the dock rows (5-8, a contract with EON Dock Layout.lua) keep their numbers.
    face_room_compact ? strcat(#_view_menu, bot_panel == 1 ? "||#Rack face while the sequencer is below the pads" : "||#Rack face for now: the panel below needs the room");
    swing_popup_open(mx, my, #_view_menu, SP_POPUP_CALLER_VIEW_MODE);
    rmb_down = 0;
  );
  swing_popup_result != 0 && swing_popup_caller_id == SP_POPUP_CALLER_VIEW_MODE ? (
    swing_popup_result >= 1 && swing_popup_result <= 3 &&
    dock_face_mode != swing_popup_result - 1 ? (
      dock_face_mode = swing_popup_result - 1;
      mark_dirty();   // undo point + project dirty, the prefs-menu idiom
    );
    swing_popup_result >= 5 && swing_popup_result <= 8 ? (
      gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? (
        gmem[GS_DOCK_LAYOUT_REQ] = swing_popup_result - 4;
      ) : (
        kit_bridge_warn = 1;   // same "bridge not running" cue as TOOLBAR
      );
    );
    swing_popup_result = 0;   // consume picks AND the -1 cancel
  );
);

// Pad Banks Outputs step 4 (Plan_Swing_Pad_Banks_Outputs.md 6): Swing's panel in the mixer. The bridge says whether
// this theme narrows the panel once the track passes 38 channels and what the user chose (the strip band's MIX_STATE:
// 0 = not that theme / no bridge -- no menu entry; 1 = not asked yet; 2 = full width, Swing's strip on Layout B; 3 =
// leave the theme alone); a click asks it to switch (MIX_REQ: 1 = use Layout B, 2 = leave it).
function swing_mix_state() (
  _reg_my_slot >= 0 ? gmem[GS_STRIP_BASE + _reg_my_slot * GS_STRIP_STRIDE + GS_STRIP_OFF_MIX_STATE] | 0 : 0;
);
function swing_mix_request(v) (
  _reg_my_slot >= 0 ? gmem[GS_STRIP_BASE + _reg_my_slot * GS_STRIP_STRIDE + GS_STRIP_OFF_MIX_REQ] = v;
);
// The gear menu, built in one place (it is rebuilt in place while the wheel turns an item).
function swing_prefs_menu() local(m) (
  sprintf(#_prefs_menu, "%s|%s|%s|%s|%s",
    midi_thru               ? "^G MIDI Thru: ON"                  : "MIDI Thru: OFF",
    tooltips_enabled        ? "^G Tooltips: ON"                   : "Tooltips: OFF",
    pad_click_selects_track ? "^G Select track on pad-click: ON"  : "Select track on pad-click: OFF",
    embed_mode == EMBED_MODE_ALWAYS ? "Embed audio: Always (self-contained)" :
    embed_mode == EMBED_MODE_NEVER  ? "Embed audio: Never (disk only)"       :
                                      "Embed audio: Auto",
    adsr_3node ? "ADSR nodes: 3 (drum — D carries sustain)" : "ADSR nodes: 4 (studio)");
  m = swing_mix_state();
  m >= 1 ? strcat(#_prefs_menu, m == 2 ? "|^G Mixer panel full width (Layout B): ON" : "|Mixer panel full width (Layout B): OFF");
);

// The THEME chip's things closed: its dropdown (rkth_open), its menu panel (thm_open) and a row's option list (a
// swing_popup with its own lifetime: swing_popup_tick runs in the shared tail, so it would outlive the panel that opened
// it). Their input lives in the full header; their draw in the tail. Called when the header folds the chip away and
// when the face turns to the rack face (Swing_ReaKit.jsfx; the small-things round's compact switch adds ways in).
function swing_theme_fold() (
  rkth_open = 0; thm_open = 0;
  swing_popup_active &&
    (swing_popup_caller_id == SP_POPUP_CALLER_THEME || swing_popup_caller_id == SP_POPUP_CALLER_EMBED_MENU)
    ? swing_popup_close(-1);
);
// ONE liveness for the bridge, by its heartbeat's AGE: the bridge stamps os.time() at ~1 Hz
// and the JSFX has no unix clock, so "stale" = the value has not MOVED for a while (== 0
// alone never caught an uncleanly exited bridge: its last stamp stays). The header's dot
// read `> 0` and the LCD banner this age, so the two disagreed: a crashed bridge kept a
// green dot, a bridge held in a file dialog by this instance's own command got the banner
// after 5 s (sweep LIB144). A command of ours in flight (kit_busy) earns a longer grace,
// since a modal dialog blocks the bridge's loop for as long as the user keeps it open.
// Idempotent within a frame: the second call sees no movement and the same age.
function swing_bridge_hb_stale() local(_v) (
  _v = gmem[KIT_GMEM_BRIDGE_ALIVE];
  _v != _hb_seen ? ( _hb_seen = _v; _hb_seen_t = time_precise(); );
  _v == 0 || (time_precise() - _hb_seen_t > (kit_busy ? 60 : 5));
);
function swing_ui_draw_header() (
  gfx_set(bg_r, bg_g, bg_b, 1); gfx_rect(0, 0, gfx_w, gfx_h);

  // Subtle brushed plastic texture effect (faint horizontal lines)
  gfx_set(0.15, 0.14, 0.13, 0.02);
  _tex_y = 31;
  loop(((gfx_h - 31) / 3)|0,
    gfx_rect(0, _tex_y, gfx_w, 1);
    _tex_y += 3;
  );

  // ── Header (28px) — dark charcoal strip with Swing branding ─────────────
  // Gradient effect: darker at top, lighter at bottom
  gfx_set(hd_r * 0.85, hd_g * 0.85, hd_b * 0.85, 1); gfx_rect(0, 0, gfx_w, 1);    // darker top
  gfx_set(hd_r, hd_g, hd_b, 1); gfx_rect(0, 1, gfx_w, 26);                        // main body
  gfx_set(hd_r * 1.1, hd_g * 1.1, hd_b * 1.1, 0.6); gfx_rect(0, 26, gfx_w, 1);    // lighter bottom
  // Bottom edge groove
  gfx_set(0.18, 0.18, 0.20, 1); gfx_rect(0, 27, gfx_w, 1);
  gfx_set(0.42, 0.42, 0.44, 0.4); gfx_rect(0, 28, gfx_w, 1); // subtle shadow line at body
  // "SWING" title with spaced letters
  rk_font(1, 16, 'b');
  // SWING wordmark stays the signature AKAI red in every theme — it's the brand
  // mark, so it does NOT follow the theme accent (which would turn it orange under
  // EON, green under SSL, etc.). Other accent elements still follow the theme.
  gfx_set(0.85, 0.20, 0.12, 1);
  gfx_measurestr("S W I N G", _wm_tw, _wm_th);
  gfx_x = 10; gfx_y = 5; gfx_drawstr("S W I N G");
  // Right-click the wordmark: view-mode override (Auto / Full UI / Rack face).
  swing_ui_viewmode_click(8, 0, _wm_tw + 6, 27);
  // Subtitle: smaller, more subdued. The ink is resolved FROM the header strip
  // rather than fixed: hd_* follows the theme's ACCENT2, which a derived REAPER
  // palette can land light or dark, and a fixed mid-grey at half alpha vanished
  // on the light half of that range. t=0.80 reproduces the charcoal-header look
  // this line has always had (fixed 0.55/0.53/0.50 at a=0.5 over hd 0.30 composites
  // to ~0.42 grey; so does a near-white ink pulled 80% back toward hd) while
  // staying legible when the strip goes pale. Same helper the captions above use.
  rk_font(1, 9, 0);
  rk_auto_ink_dim(hd_r, hd_g, hd_b, 0.80); gfx_a = 1;
  gfx_x = 78; gfx_y = 17; gfx_drawstr("by EON Studios");

  // ── Right-side button cluster (EMBED + UNDO + REDO) ──────────────────
  // Anchored to the right edge with ~90 px reserved for the BRIDGE
  // indicator + label (and the optional UPDATE button when an update
  // is available). Cluster reads left-to-right: EMBED → UNDO → REDO.
  // UNDO/REDO are color-coded (amber / green) so the user can tell
  // them apart at a glance even with the arrow glyphs.
  _btn_h   = 16;
  _btn_y   = 6;
  _btn_pad = 5;
  _btn_gap = 4;
  rk_font(1, 11, 'b');
  gfx_measurestr("↷ REDO", _redo_tw, _btn_th);
  _redo_bw = _redo_tw + _btn_pad * 2;
  gfx_measurestr("↶ UNDO", _undo_tw, _btn_th);
  _undo_bw = _undo_tw + _btn_pad * 2;
  gfx_measurestr("⚙", _thru_tw, _btn_th);   // gear glyph drives the slot width
  _thru_bw = _thru_tw + _btn_pad * 2 + 6;        // extra padding so the icon button isn't cramped
  // Anchor: REDO ends 90 px from the right edge — leaves room for the
  // BRIDGE indicator + label, with a small visual gap from the cluster.
  // Cluster reads left-to-right: THRU → UNDO → REDO.
  // ⭐ EMBED left the header 2026-09-22 (the user): it is a look-of-the-embed
  // control, so it is a row in the THEME menu now. Its MENU and its result
  // handler are untouched and still live in this file — only the chip is gone,
  // so the cluster anchors straight from UNDO.
  _redo_bx = gfx_w - 90 - _redo_bw;
  _undo_bx = _redo_bx - _undo_bw - _btn_gap;
  _thru_bx = _undo_bx - _thru_bw - _btn_gap;

  // ── THEME selector ──
  // JSFX can't SetExtState, so a pick writes the chosen theme index to
  // GS_THEME_REQ; the bridge writes the shared ExtState + republishes the
  // colour band, so every EON surface (Swing, StepSeq, Browser, Pad-FX)
  // re-skins in sync. Label reflects GS_THEME_CUR (bridge-published active
  // theme); width reserves "REAPER" so the cluster doesn't reflow on change.
  // ── THEME selector — shared rk_theme_picker widget (chip + scrollable dropdown). ──
  // Reserve the widest label ("REAPER") so the toolbar cluster doesn't reflow as the
  // theme changes. rkth_input runs HERE (header, before the grid) so an open-list click
  // never falls through; rkth_overlay_draw paints the list last (Swing_ReaKit @gfx tail).
  // TOOLBAR sits at the far right of the cluster now, THEME just left of it
  // (user 2026-08-05: swap). Geometry computed HERE because THEME's anchor
  // depends on it; TOOLBAR's draw + input stay in their own block below.
  rk_font(1, 11, 'b');
  gfx_measurestr("TOOLBAR", _tb_maxw, _tb_th2);
  _tb_bw = _tb_maxw + _btn_pad * 2;
  _tb_bx = _thru_bx - _tb_bw - _btn_gap;
  gfx_measurestr("REAPER", _thm_maxw, _thm_th2);
  _thm_bw  = _thm_maxw + _btn_pad * 2;
  _thm_bx  = _tb_bx - _thm_bw - _btn_gap;
  // Narrow-pane fold (user 2026-08-25, "buttons get in the logo's way" in a
  // docked full-UI pane): a chip whose LEFT edge would cross the wordmark
  // clearance neither draws nor takes input. Guarded per block right through
  // the cluster, so the leftmost chips vanish first and UNDO/REDO survive
  // longest. Same HDR_CAP_MIN_X the caption system already respects; anchor
  // math and popup-result consumers stay unconditional.
  _thm_bx >= HDR_CAP_MIN_X ? (
    // ⭐⭐ HOUSE RULE (2026-09-22): a LEFT click opens Swing's THEME MENU — the one
    // panel holding every appearance option this plugin has. Nothing is lost: the
    // theme list is still one RIGHT click away, and it is also the panel's first
    // row. lmb is passed to rkth_input as 0 so the widget still stores its geometry
    // for rkth_draw_chip and rkth_overlay_draw. Wheel still cycles the theme.
    // ⚠️⚠️ lmb reaches rkth_input ONLY while its list is
    // already OPEN. Shut, it is withheld so a left click on the chip opens the
    // THEME MENU rather than the widget's own list. Open, the click is the LIST'S:
    // rk_theme.jsfx-inc:118 picks the hovered row under `lmb ?`, so withholding it
    // unconditionally left the list openable by right-click and impossible to
    // choose from -- which is how it shipped in 3.0.18.
    // ⭐ _thm_lclick is gated the same way, and it must be: it is computed BEFORE the
    // call, so rkth_input zeroing lmb_down on a consumed click cannot unset it. Without
    // the gate, clicking the chip while the list is up would close the list AND open
    // the panel in one gesture.
    // The panel hangs from this chip; the core right-aligns itself to it.
    thm_anchor_x = _thm_bx; thm_anchor_y = _btn_y;
    thm_anchor_w = _thm_bw; thm_anchor_h = _btn_h;
    _thm_lclick = !rkth_open && lmb_down && mx >= _thm_bx && mx <= _thm_bx + _thm_bw && my >= _btn_y && my <= _btn_y + _btn_h;
    rkth_input(_thm_bx, _btn_y, _thm_bw, _btn_h, mx, my, rkth_open ? lmb_down : 0, rmb_down, frame_wheel, _btn_h) ? ( lmb_down = 0; frame_wheel = 0; );
    // Spend the click HERE, so thm_input's click-outside-closes test (which
    // runs later this frame) cannot immediately undo the open.
    _thm_lclick ? ( thm_open = 1 - thm_open; rkth_open = 0; lmb_down = 0; );
    rkth_draw_chip(11);
    _thm_hover = mx >= _thm_bx && mx <= _thm_bx + _thm_bw && my >= _btn_y && my <= _btn_y + _btn_h;
    _thm_hover ? (
      #tooltip = "Theme menu — click for every appearance option · right-click for the theme list · hover+wheel cycles. Syncs all EON tools.";
    );
    // Caption drawn on Swing's side, NOT inside rkth_draw_chip: that widget is
    // shared with Drum Strip and ships in the ReaKit library, and this is a
    // Swing-layout decision. Consumed width shifts the TOOLBAR anchor below.
    _thm_capw = swing_ui_hdr_cap("THEME", _thm_bx, _btn_y, _btn_h, _thm_hover);
  ) : (
    // Folded chip: close its list AND its menu, or they paint on with nothing
    // left to close them. ⚠ thm_open = 0 is NOT enough -- a row's list is a
    // swing_popup with its own lifetime, and swing_popup_tick is called
    // unconditionally in the tail, so it would outlive the panel that opened it.
    _thm_capw = 0; swing_theme_fold();
  );

  // ── TOOLBAR button — open/close the EON toolbar (bridge CMD 78). Sits just left
  //    of THEME. The bridge finds the [Floating toolbar N] titled EON and toggles
  //    it, so it works whatever slot the toolbar lives in. No LOCK (not instance-
  //    specific). Posts only if the bridge is alive and the CMD bus is idle. ──
  // _tb_bw/_tb_bx precomputed above the THEME block (swap: TOOLBAR is the
  // rightmost chip, THEME anchors off it).
  _tb_bx >= HDR_CAP_MIN_X ? (
    rk_font(1, 11, 'b');
    _tb_hover = mx >= _tb_bx && mx <= _tb_bx + _tb_bw && my >= _btn_y && my <= _btn_y + _btn_h;
    _tb_lit = gmem[GS_TOOLBAR_OPEN] > 0.5;   // bridge publishes toolbar open-state
    _tb_lit ? gfx_set(1.0, 0.66, 0.20, _tb_hover ? 1.0 : 0.95)     // open  = vivid orange
            : gfx_set(0.55, 0.40, 0.18, _tb_hover ? 0.88 : 0.62);  // closed = muted amber
    gfx_rect(_tb_bx, _btn_y, _tb_bw, _btn_h);
    gfx_set(1, 1, 1, _tb_hover ? 1.0 : 0.92);
    gfx_measurestr("TOOLBAR", _tb_lw, _tb_lh);
    gfx_x = _tb_bx + (_tb_bw - _tb_lw) * 0.5; gfx_y = _btn_y + (_btn_h - _tb_lh) * 0.5;
    gfx_drawstr("TOOLBAR");
    _tb_hover ? ( #tooltip = "Open/close the EON toolbar — found by name, works in any toolbar slot."; );
    _tb_hover && lmb_down ? (
      gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? (
        gmem[KIT_GMEM_CMD] == 0 ? ( gmem[KIT_GMEM_CMD] = 78; );
      ) : ( kit_bridge_warn = 1; );
      lmb_down = 0;
    );
  );

  // ── KNOB style selector: REMOVED from the header (the user, 2026-09-22) ──
  // "take knob out the main view now since its in the menu". The pad-knob style
  // is the THEME menu's KNOB row, which writes the same GS_THEME_KNOB_REQ this
  // chip did. swing_ui_knob_name stays — the menu row uses it (the chip's
  // _next / _prev cyclers and its _knob_capw caption width went, unused).
  // SP_POPUP_CALLER_KNOB_STYLE now has no opener and no consumer anywhere.

  // ── STRIPS view selector — remote-controls the embedded VIEW of every EON Drum
  //    Strip on THIS Swing instance (multi-out only). Click / hover-wheel cycle
  //    EQ → STRIP → STRIP+VU → FULL; the choice is written to the per-instance band
  //    (GS_STRIP_OFF_VIEW_REQ) and EON_Swing_Strip_Sync pushes it to the strips.
  //    Sits just left of the KNOB chip (its X doesn't feed the THEME/KNOB anchors,
  //    so hiding it off multi-out causes no toolbar reflow). ──
  multi_out ? (
    swing_strv_seen == 0 ? ( swing_strip_view = 3; swing_strv_seen = 1; );   // default FULL
    _strv = max(0, min(3, swing_strip_view | 0));
    _strv == 0 ? strcpy(#_strv_l, "EQ") : _strv == 1 ? strcpy(#_strv_l, "STRP") : _strv == 2 ? strcpy(#_strv_l, "S+VU") : strcpy(#_strv_l, "FULL");
    rk_font(1, 11, 'b');
    gfx_measurestr("S+VU", _strv_mw, _strv_th);
    _strv_bw = _strv_mw + _btn_pad * 2;
    _strv_bx = _thm_bx - _thm_capw - _strv_bw - _btn_gap;   // clears the THEME caption (KNOB chip removed 2026-09-22)
    _strv_bx >= HDR_CAP_MIN_X ? (
      _strv_hover = mx >= _strv_bx && mx <= _strv_bx + _strv_bw && my >= _btn_y && my <= _btn_y + _btn_h;
      gfx_set(0.35, 0.35, 0.38, _strv_hover ? 0.95 : 0.68);
      gfx_rect(_strv_bx, _btn_y, _strv_bw, _btn_h);
      gfx_set(1, 1, 1, _strv_hover ? 1.0 : 0.92);
      gfx_measurestr(#_strv_l, _strv_lw, _strv_lh);
      gfx_x = _strv_bx + (_strv_bw - _strv_lw) * 0.5; gfx_y = _btn_y + (_btn_h - _strv_lh) * 0.5;
      gfx_drawstr(#_strv_l);
      _strv_hover ? ( #tooltip = "Drum-strip view — click / hover-wheel sets the embedded view of ALL this kit's strips (EQ · Strip · Strip+VU · Full)."; );
      _strv_capw = swing_ui_hdr_cap("STRIPS", _strv_bx, _btn_y, _btn_h, _strv_hover);
      _strv_hover && lmb_down ? (
        swing_strip_view = (_strv + 1) % 4;
        _reg_my_slot >= 0 ? gmem[GS_STRIP_BASE + _reg_my_slot * GS_STRIP_STRIDE + GS_STRIP_OFF_VIEW_REQ] = swing_strip_view + 1;
        lmb_down = 0;
      );
      _strv_hover && frame_wheel != 0 ? (
        swing_strip_view = ((_strv + (frame_wheel > 0 ? 1 : -1)) + 4) % 4;
        _reg_my_slot >= 0 ? gmem[GS_STRIP_BASE + _reg_my_slot * GS_STRIP_STRIDE + GS_STRIP_OFF_VIEW_REQ] = swing_strip_view + 1;
        frame_wheel = 0;
      );
    ) : ( _strv_capw = 0; );
  );

  // ── VU FACE selector — sets the analog VU meter face on EVERY Drum Strip in this
  //    kit (multi-out only). AUTO follows the One Rack theme; or one of rk_vu's 20
  //    faces (names mirror rk_vu_theme_name; the strips draw them). Click forward /
  //    hover-wheel cycle; the choice (style+2) is written to
  //    GS_STRIP_OFF_VU_REQ and EON_Swing_Strip_Sync pushes it to the strips. Sits
  //    just left of the STRIPS chip. Per-strip override still lives on each strip. ──
  multi_out ? (
    swing_svu_seen == 0 ? ( swing_vu_style = -1; swing_svu_seen = 1; );   // default AUTO
    _svu = max(-1, min(19, swing_vu_style | 0));
    _svu <  0 ? strcpy(#_svu_l, "AUTO")          : _svu == 0  ? strcpy(#_svu_l, "Cream")        :
    _svu == 1  ? strcpy(#_svu_l, "Dark Studio")  : _svu == 2  ? strcpy(#_svu_l, "Black & Gold") :
    _svu == 3  ? strcpy(#_svu_l, "Modern White") : _svu == 4  ? strcpy(#_svu_l, "Broadcast")    :
    _svu == 5  ? strcpy(#_svu_l, "Midnight")     : _svu == 6  ? strcpy(#_svu_l, "Vintage Amber"):
    _svu == 7  ? strcpy(#_svu_l, "Olive")        : _svu == 8  ? strcpy(#_svu_l, "Ivory")        :
    _svu == 9  ? strcpy(#_svu_l, "Blackface")    : _svu == 10 ? strcpy(#_svu_l, "SSL")          :
    _svu == 11 ? strcpy(#_svu_l, "Neve")         : _svu == 12 ? strcpy(#_svu_l, "API")          :
    _svu == 13 ? strcpy(#_svu_l, "Ableton")      : _svu == 14 ? strcpy(#_svu_l, "FL Studio")    :
    _svu == 15 ? strcpy(#_svu_l, "Red")          : _svu == 16 ? strcpy(#_svu_l, "Yellow")       :
    _svu == 17 ? strcpy(#_svu_l, "Orange")       : _svu == 18 ? strcpy(#_svu_l, "Emerald")      :
                 strcpy(#_svu_l, "Cobalt");
    rk_font(1, 11, 'b');
    gfx_measurestr("Vintage Amber", _svu_mw, _svu_th);   // the widest face name
    // Caption-or-in-chip: mirror hdr_cap's LAST-RESORT fit test (8px) at the x
    // this chip is about to take. When even that caption would drop (crowded
    // multi-out row — the font stepping still gives up below 8px), the label
    // moves INSIDE the chip: a dim "VU · " prefix ahead of the face name, so
    // the picker is never unlabeled. The chip widens by the prefix and grows
    // LEFT — only caption TEXT is bound by the HDR_CAP_MIN_X wordmark guard.
    rk_font(1, 8, 'b');
    gfx_measurestr("VU", _svu_w8, _svu_th8);
    _svu_incap = _strv_bx - _strv_capw - (_svu_mw + _btn_pad * 2) - _btn_gap
                 - _svu_w8 - HDR_CAP_GAP < HDR_CAP_MIN_X;
    rk_font(1, 9, 'b');
    gfx_measurestr("VU · ", _svu_pw, _svu_pth);
    _svu_bw = _svu_mw + (_svu_incap ? _svu_pw : 0) + _btn_pad * 2;
    _svu_bx = _strv_bx - _strv_capw - _svu_bw - _btn_gap;   // clears the STRIPS caption
    _svu_bx >= HDR_CAP_MIN_X ? (
      _svu_hover = mx >= _svu_bx && mx <= _svu_bx + _svu_bw && my >= _btn_y && my <= _btn_y + _btn_h;
      gfx_set(0.35, 0.35, 0.38, _svu_hover ? 0.95 : 0.68);
      gfx_rect(_svu_bx, _btn_y, _svu_bw, _btn_h);
      _svu_incap ? (
        // font is still the 9px prefix font from the measure above
        gfx_set(1, 1, 1, _svu_hover ? 0.72 : 0.55);
        gfx_x = _svu_bx + _btn_pad; gfx_y = _btn_y + (_btn_h - _svu_pth) * 0.5;
        gfx_drawstr("VU · ");
      );
      rk_font(1, 11, 'b');
      gfx_set(1, 1, 1, _svu_hover ? 1.0 : 0.92);
      gfx_measurestr(#_svu_l, _svu_lw, _svu_lh);
      // value centred in its own zone (right of the prefix); with no prefix this
      // is byte-identical to the old full-chip centring
      gfx_x = _svu_bx + _btn_pad + (_svu_incap ? _svu_pw : 0) + (_svu_mw - _svu_lw) * 0.5;
      gfx_y = _btn_y + (_btn_h - _svu_lh) * 0.5;
      gfx_drawstr(#_svu_l);
      _svu_hover ? ( #tooltip = "VU meter face for ALL this kit's strips — click / hover-wheel cycles. AUTO follows the theme. (Each strip can still override.)"; );
      // leftmost — nothing anchors off it; skipped when the label went in-chip
      !_svu_incap ? swing_ui_hdr_cap("VU", _svu_bx, _btn_y, _btn_h, _svu_hover);
      _svu_hover && lmb_down ? (
        swing_vu_style = _svu >= 19 ? -1 : _svu + 1;
        _reg_my_slot >= 0 ? gmem[GS_STRIP_BASE + _reg_my_slot * GS_STRIP_STRIDE + GS_STRIP_OFF_VU_REQ] = swing_vu_style + 2;
        lmb_down = 0;
      );
      _svu_hover && frame_wheel != 0 ? (
        swing_vu_style = _svu + (frame_wheel > 0 ? 1 : -1);
        swing_vu_style > 19 ? swing_vu_style = -1 : swing_vu_style < -1 ? swing_vu_style = 19;
        _reg_my_slot >= 0 ? gmem[GS_STRIP_BASE + _reg_my_slot * GS_STRIP_STRIDE + GS_STRIP_OFF_VU_REQ] = swing_vu_style + 2;
        frame_wheel = 0;
      );
    );
  );

  // ── Settings gear → prefs popup ──
  // Replaces the standalone MIDI THRU button. Folds the set-once prefs into one
  // in-window swing_popup: MIDI Thru, Tooltips, and Select-track-on-pad-click.
  // The gear tints purple while MIDI Thru is ON so that state stays visible at a
  // glance (it used to be the THRU button's purple). midi_thru = slider22.
  _gear_hover = _thru_bx >= HDR_CAP_MIN_X
             && mx >= _thru_bx && mx <= _thru_bx + _thru_bw &&
                my >= _btn_y && my <= _btn_y + _btn_h;
  _thru_bx >= HDR_CAP_MIN_X ? (
    midi_thru ? (
      gfx_set(0.55, 0.30, 0.85, _gear_hover ? 1.0 : 0.85);   // purple = MIDI Thru on
    ) : (
      gfx_set(0.35, 0.35, 0.38, _gear_hover ? 0.85 : 0.65);  // neutral gray
    );
    gfx_rect(_thru_bx, _btn_y, _thru_bw, _btn_h);
    gfx_set(1, 1, 1, _gear_hover ? 1.0 : 0.95);
    gfx_measurestr("⚙", _gw, _gh);
    gfx_x = _thru_bx + (_thru_bw - _gw) * 0.5; gfx_y = _btn_y + (_btn_h - _gh) * 0.5;
    gfx_drawstr("⚙");
    _gear_hover ? ( #tooltip = "Settings — MIDI Thru · Tooltips · Select track on pad-click · Embed audio · ADSR nodes"; );
  );
  lmb_down && _gear_hover ? (
    swing_prefs_menu();
    swing_popup_open(mx, my, #_prefs_menu, SP_POPUP_CALLER_PREFS);
  );
  // Popup dispatch — pick toggles the underlying var (menu then closes).
  // Item 4 (embed policy) is tri-state: a click ADVANCES one step
  // (Auto→Always→Never→Auto); the hover-wheel below spins it in place.
  swing_popup_result > 0 && swing_popup_caller_id == SP_POPUP_CALLER_PREFS ? (
    _prefs_resp = swing_popup_result;
    swing_popup_result = 0;
    _prefs_resp == 1 ? ( midi_thru = !midi_thru; slider_automate(slider22); mark_dirty(); );
    _prefs_resp == 2 ? ( tooltips_enabled = !tooltips_enabled; mark_dirty(); );
    _prefs_resp == 3 ? ( pad_click_selects_track = !pad_click_selects_track; mark_dirty(); );
    _prefs_resp == 4 ? ( embed_mode = embed_mode >= EMBED_MODE_NEVER ? EMBED_MODE_AUTO : embed_mode + 1; mark_dirty(); );
    // Display-only: the engine keeps all four params either way, so no recalc.
    _prefs_resp == 5 ? ( adsr_3node = !adsr_3node; sliderchange(slider31); mark_dirty(); );
    // Item 6 (only on the theme that narrows the panel): ask the bridge to switch it (the answer is the user's, in
    // REAPER's settings, not the project's -- no mark_dirty).
    _prefs_resp == 6 && swing_mix_state() >= 1 ? swing_mix_request(swing_mix_state() == 2 ? 2 : 1);
  );
  swing_popup_result == -1 && swing_popup_caller_id == SP_POPUP_CALLER_PREFS ? (
    swing_popup_result = 0;
  );
  // Hover-scroll — wheel over an item flips that pref IN PLACE; the menu stays
  // open so several can be set in one go. Wheel up = ON, wheel down = OFF; only
  // act on a real change, then refresh the labels so the open menu updates.
  swing_popup_wheel != 0 && swing_popup_caller_id == SP_POPUP_CALLER_PREFS ? (
    _pw_on = swing_popup_wheel > 0;
    swing_popup_wheel_result == 1 && midi_thru != _pw_on ?               ( midi_thru = _pw_on; slider_automate(slider22); mark_dirty(); );
    swing_popup_wheel_result == 2 && tooltips_enabled != _pw_on ?        ( tooltips_enabled = _pw_on; mark_dirty(); );
    swing_popup_wheel_result == 3 && pad_click_selects_track != _pw_on ? ( pad_click_selects_track = _pw_on; mark_dirty(); );
    // Item 4 (tri-state): wheel spins the mode — up advances, down retreats.
    swing_popup_wheel_result == 4 ? (
      embed_mode = _pw_on ? (embed_mode >= EMBED_MODE_NEVER ? EMBED_MODE_AUTO : embed_mode + 1)
                          : (embed_mode <= EMBED_MODE_AUTO  ? EMBED_MODE_NEVER : embed_mode - 1);
      mark_dirty();
    );
    // Item 5 (ADSR node count): wheel up = 3-node, down = 4-node.
    swing_popup_wheel_result == 5 && adsr_3node != _pw_on ? ( adsr_3node = _pw_on; sliderchange(slider31); mark_dirty(); );
    // Item 6: wheel up = full width (Layout B), down = leave the theme alone.
    swing_popup_wheel_result == 6 && swing_mix_state() >= 1 && (swing_mix_state() == 2) != _pw_on ? swing_mix_request(_pw_on ? 1 : 2);
    swing_prefs_menu();
    swing_popup_refresh_items(#_prefs_menu);
    swing_popup_wheel = 0;
  );

  // ── EMBED: no header chip any more (the user, 2026-09-22) ──────────────
  // The button moved into the THEME menu's EMBED row, which opens the SAME
  // menu through the SAME builder (swing_state_embedmenu_open). The result
  // handler below stays here and is still the only consumer, so nothing about
  // what the menu DOES changed — only where it is opened from.
  swing_popup_result > 0 && swing_popup_caller_id == SP_POPUP_CALLER_EMBED_MENU ? (
    swing_popup_result == 1 ? ( embed_show_knobs = !embed_show_knobs; );
    swing_popup_result == 2 ? ( embed_show_icons = !embed_show_icons; slider_automate(slider26); );
    (swing_popup_result == 3 || swing_popup_result == 4) ? (
      gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 && gmem[KIT_GMEM_CMD] == 0 ? (
        gmem[KIT_GMEM_LOCK] = instance_id;
        gmem[KIT_GMEM_CMD]  = swing_popup_result == 3 ? 90 : 91;
      ) : ( kit_bridge_warn = gmem[KIT_GMEM_BRIDGE_ALIVE] <= 0 ? 1 : kit_bridge_warn; );
    );
    swing_popup_result = 0;
    mark_dirty_pad(_undo_pad);
  );
  swing_popup_result == -1 && swing_popup_caller_id == SP_POPUP_CALLER_EMBED_MENU ? (
    swing_popup_result = 0;
  );

  // ── UNDO button (amber) ──
  // Drives Swing's OWN internal param-undo engine (undo_do), NOT REAPER's
  // global Ctrl+Z — so it can never roll a loaded kit back to empty. Dimmed
  // when the internal undo ring is empty.
  _ur_avail_u = _udo_uc > 0 || _udo_st_valid;  // param entries OR a structural (audio) snapshot
  _ur_hov_u = _undo_bx >= HDR_CAP_MIN_X
           && mx >= _undo_bx && mx <= _undo_bx + _undo_bw && my >= _btn_y && my <= _btn_y + _btn_h;
  _undo_bx >= HDR_CAP_MIN_X ? (
    _ur_avail_u ? (
      // Amber pill — distinguishes UNDO from REDO at a glance
      gfx_set(0.85, 0.55, 0.20, _ur_hov_u ? 1.0 : 0.80);
    ) : (
      gfx_set(0.20, 0.20, 0.22, 0.45);
    );
    gfx_rect(_undo_bx, _btn_y, _undo_bw, _btn_h);
    gfx_set(1, 1, 1, _ur_avail_u ? (_ur_hov_u ? 1.0 : 0.98) : 0.55);
    gfx_x = _undo_bx + _btn_pad; gfx_y = _btn_y + (_btn_h - _btn_th) * 0.5;
    gfx_drawstr("↶ UNDO");
  );
  lmb_down && _ur_hov_u && _ur_avail_u ? ( undo_do(); );
  _ur_hov_u && _ur_avail_u ? (
    strcpy(#_ur_tt, "Undo last edit");
    #tooltip = #_ur_tt;
  );

  // ── REDO button (green) ──
  _ur_avail_r = _udo_rc > 0;
  _ur_hov_r = _redo_bx >= HDR_CAP_MIN_X
           && mx >= _redo_bx && mx <= _redo_bx + _redo_bw && my >= _btn_y && my <= _btn_y + _btn_h;
  _redo_bx >= HDR_CAP_MIN_X ? (
    _ur_avail_r ? (
      // Green pill — visually mirrors UNDO's amber
      gfx_set(0.30, 0.75, 0.45, _ur_hov_r ? 1.0 : 0.80);
    ) : (
      gfx_set(0.20, 0.20, 0.22, 0.45);
    );
    gfx_rect(_redo_bx, _btn_y, _redo_bw, _btn_h);
    gfx_set(1, 1, 1, _ur_avail_r ? (_ur_hov_r ? 1.0 : 0.98) : 0.55);
    gfx_x = _redo_bx + _btn_pad; gfx_y = _btn_y + (_btn_h - _btn_th) * 0.5;
    gfx_drawstr("↷ REDO");
  );
  lmb_down && _ur_hov_r && _ur_avail_r ? ( redo_do(); );
  _ur_hov_r && _ur_avail_r ? (
    strcpy(#_ur_tt, "Redo last edit");
    #tooltip = #_ur_tt;
  );

  // ── Bridge status indicator (right side of header) ──
  _hb_stale = swing_bridge_hb_stale();   // the banner's test too (one liveness, sweep LIB144)
  _bridge_alive = !_hb_stale;
  _ind_r = 4;  // dot radius
  _ind_x = gfx_w - 14;
  _ind_y = 14;
  _bridge_alive ? (
    // Green dot — bridge running
    gfx_set(0.30, 0.78, 0.45, 0.9);
    gfx_circle(_ind_x, _ind_y, _ind_r, 1);
    // Subtle glow
    gfx_set(0.30, 0.78, 0.45, 0.15);
    gfx_circle(_ind_x, _ind_y, _ind_r + 2, 1);
  ) : (
    // Red pulsing dot — bridge not running
    _pulse = 0.45 + 0.35 * sin(time_precise() * 4.0);
    gfx_set(0.85, 0.25, 0.20, _pulse);
    gfx_circle(_ind_x, _ind_y, _ind_r, 1);
  );
  // Label next to dot
  rk_font(1, 10, 'b');
  _bridge_alive ? (
    gfx_set(0.30, 0.78, 0.45, 0.95);
    gfx_measurestr("BRIDGE", _tw_b, _th_b);
    gfx_x = _ind_x - _tw_b - 6; gfx_y = _ind_y - _th_b * 0.5;
    gfx_drawstr("BRIDGE");
  ) : (
    gfx_set(0.95, 0.30, 0.25, 1.0);
    gfx_measurestr("NO BRIDGE", _tw_b, _th_b);
    gfx_x = _ind_x - _tw_b - 6; gfx_y = _ind_y - _th_b * 0.5;
    gfx_drawstr("NO BRIDGE");
  );

  // ── UPDATE button (left of bridge label, only when update available) ──
  _upd_state = gmem[GS_UPDATE_STATE];
  _upd_state == 3 ? (
    // Pulse alpha for attention
    update_dot_alpha += 0.02 * update_dot_dir;
    update_dot_alpha >= 1.0 ? ( update_dot_alpha = 1.0; update_dot_dir = -1; );
    update_dot_alpha <= 0.5 ? ( update_dot_alpha = 0.5; update_dot_dir =  1; );

    // Measure button text
    rk_font(1, 9, 'b');
    gfx_measurestr("UPDATE", _upd_tw, _upd_th);
    _upd_pad = 6;
    _upd_bw = _upd_tw + _upd_pad * 2;
    _upd_bh = 16;
    _upd_bx = _ind_x - _tw_b - 12 - _upd_bw;
    _upd_by = 14 - (_upd_bh * 0.5);

    // Hover detection
    _upd_hover = mx >= _upd_bx && mx <= _upd_bx + _upd_bw &&
                 my >= _upd_by && my <= _upd_by + _upd_bh;

    // Button background — EON red with pulse
    _upd_hover ? (
      gfx_set(0.95, 0.30, 0.18, update_dot_alpha);
    ) : (
      gfx_set(0.85, 0.20, 0.11, update_dot_alpha * 0.85);
    );
    gfx_rect(_upd_bx, _upd_by, _upd_bw, _upd_bh);

    // Button border (subtle)
    gfx_set(1, 0.4, 0.3, update_dot_alpha * 0.3);
    gfx_rect(_upd_bx, _upd_by, _upd_bw, 1);                  // top
    gfx_rect(_upd_bx, _upd_by + _upd_bh - 1, _upd_bw, 1);    // bottom
    gfx_rect(_upd_bx, _upd_by, 1, _upd_bh);                  // left
    gfx_rect(_upd_bx + _upd_bw - 1, _upd_by, 1, _upd_bh);    // right

    // Button label
    gfx_set(1, 1, 1, update_dot_alpha);
    gfx_x = _upd_bx + _upd_pad; gfx_y = _upd_by + (_upd_bh - _upd_th) * 0.5;
    gfx_drawstr("UPDATE");

    // Click handler — tell Lua to open download URL
    lmb_down && _upd_hover ? (
      gmem[GS_UPDATE_REQUEST] = 2;
    );
  );
);

