// rk_swing_ui_state.jsfx-inc
// Swing UI state machines + frame setup + header + LCD frame
// (c) EON Studios — All Rights Reserved

@init

function swing_ui_process_undo()
local(_ki, _cj, _cn, _cnl, gi, _sw_a, _sw_b, _swli, gi_s, _ki_s, _cab)  // localized 2026-07-09: @gfx writes to these globals raced the @block kit-import loop (its _ki=16 exit value wrote PHANTOM PAD 16 = pad 0 via array adjacency). _undo_* stay global (cross-section mailbox).
(
_undo_pending > 0 && gmem[KIT_GMEM_UNDO_ACK] == 1 ? (
  // Phase 2: record the right structural entry for this deferred op.
  _undo_pending == 5 ? udo_struct_begin_swap(_undo_pad, _undo_pad2)
  : (_undo_pending == 2 || _undo_pending == 3) ? udo_struct_begin_pad(_undo_pad)
  : udo_struct_begin_kit();  // 1 = clear-all, 6 = new-kit (bridge dumped pre-ACK)
  // Back up this pad's NAME too (the engine's begin can't reach get_*_slot;
  // this @gfx-side path can). Restored via _udo_name_req in @gfx on undo.
  (_undo_pending == 2 || _undo_pending == 3) ? undo_pad_names_save(_undo_pad);
  _cab = _undo_clear_banks;   // the REAPER point's words below (the branch zeroes the flag)
  _undo_pending == 1 ? (
    // CLEAR ALL — pads only. Kit name + FX chain preserved (vs. NEW which
    // wipes everything via _undo_pending == 6 → swing_new_kit_full_reset).
    _undo_clear_banks ? (
      // step 4c: the tab menu's "clear all four banks" -- every slot
      gi = 0; loop(NUM_SLOTS, clear_pad(gi); clear_pad_syn(gi); swing_rcp_post_pad(gi); s_dirty[gi] = 1; gi += 1;);
      swing_banktabs_name_clear(-1);
      _undo_clear_banks = 0;
    ) : (
      gi = 0; loop(NUM_PADS, gi_s = swing_bp(gi); clear_pad(gi_s); clear_pad_syn(gi_s); swing_rcp_post_pad(gi_s); s_dirty[gi_s] = 1; gi += 1;);
      swing_banktabs_name_clear(bank_cur);   // the bank swing_bp just cleared
    );
  ) : _undo_pending == 2 ? (
    _undo_pad >= 0 && _undo_pad < NUM_SLOTS ? ( clear_pad(_undo_pad); clear_pad_syn(_undo_pad); );   // a slot (step 4a)
  ) : _undo_pending == 6 ? (
    // NEW KIT — full reset (pads + name + FX). See rk_swing_defaults.jsfx-inc.
    swing_new_kit_full_reset();
  ) : _undo_pending == 3 ? (
    _undo_pad >= 0 && _undo_pad < NUM_SLOTS && _undo_layer >= 0 && _undo_layer < MAX_LAYERS ? (   // a slot (step 4a)
      clear_layer_eff(_undo_pad, _undo_layer);   // a plain pad's layer 0 is its sample (rk_swing_core, LIB314)
      // Clearing a layer changes the effective RR sequence; reset cursor
      // so the next hit starts at position 1. Mirrors the synchronous
      // path in rk_swing_ui_grid_overlay.jsfx-inc / overlay_fx.
      p_rr_idx[_undo_pad] = 0;
      s_dirty[_undo_pad] = 1;
    );
  ) : _undo_pending == 5 ? (
    _undo_pad >= 0 && _undo_pad2 >= 0 && _undo_pad != _undo_pad2 ? (
      swap_pads(_undo_pad, _undo_pad2);
      swing_pad_swap_strings(_undo_pad, _undo_pad2);   // cname, name, path + the layer paths (one copy, rk_swing_core)
    );
  );
  mark_dirty_pad(_undo_pad);
  col_dirty = 1;
  // Flush pad names to gmem so bridge CMD 48 can sync multi-out tracks.
  // sync_note_names() can't be used here — it sets CMD 52 which gets
  // immediately clobbered by CMD 48 below.
  _ki = 0; loop(NUM_PADS,
    _ki_s = swing_bp(_ki);
    _cn = get_cname_slot(_ki_s);
    _cnl = strlen(_cn);
    _cj = 0; loop(KIT_GMEM_PADNAME_LEN,
      gmem[KIT_GMEM_PADNAMES + _ki * KIT_GMEM_PADNAME_LEN + _cj] =
        _cj < _cnl ? str_getchar(_cn, _cj) : 0;
      _cj += 1;
    );
    _ki += 1;
  );
  // The op's REAPER undo point (2026-10-27, the owner's decisions 1 and 2): Clear All, a pad or a layer cleared, two
  // pads swapped. New Kit asks in swing_new_kit_full_reset. Ctrl+Z brings back what was there (REAPER's stored copy).
  _undo_pending == 1 ? swing_rup_want(RUP_K_CLEARALL, _cab, -1, -1, 0)
  : _undo_pending == 2 ? swing_rup_want(RUP_K_CLEARPAD, _undo_pad, -1, -1, 0)
  : _undo_pending == 3 ? swing_rup_want(RUP_K_CLEARLAYER, _undo_pad, _undo_layer, -1, 0)
  : _undo_pending == 5 ? swing_rup_want(RUP_K_SWAP, _undo_pad, _undo_pad2, -1, 0);
  undo_cap_end();  // Phase 2: close the whole-kit capture for this structural op
  gmem[KIT_GMEM_UNDO_ACK] = 0;
  gmem[KIT_GMEM_CMD] = 48;  // tell bridge to close Undo_EndBlock
  _undo_pending = 0; _undo_pad = -1; _undo_pad2 = -1; _undo_layer = -1;
);
);

// ── Big View framework primitives ─────────────────────────────────────────
// See Swing_ReaKit.jsfx (VIEW_* constants, big_view_id) for the model. These
// live here because state lib is imported before every UI lib that calls them
// (grid_pads, panels_mixer), so refs resolve at definition time.

// Open a big view: set the id and ZERO the modal-gate saves. The gate already
// ran this frame (with the view still closed), so the _ov_* copies are STALE —
// a leftover _ov_lmb_down=1 would make the view's click-outside-to-close fire
// on its own open frame. The gate repopulates them from the next frame.
// Leaving the Mapping view ends its bulk LEARN: the view arms pads only while drawn, and a
// learn left on with a pad armed in midi_learn_pad made the next MIDI note re-note that pad in
// @block and swallow the hit, with no banner left to say so (sweep LIB116). The pad editor's
// own LEARN button (midi_learn_pad without _mv_learn) is not touched.
function swing_bigview_leave_() (
  big_view_id == VIEW_MAPPING && _mv_learn ? ( _mv_learn = 0; midi_learn_pad = -1; );
);
function swing_bigview_open(id) (
  id != big_view_id ? swing_bigview_leave_();
  big_view_id = id;
  _ov_lmb_down = 0; _ov_rmb_down = 0;
  _ov_LMB = 0; _ov_RMB = 0; _ov_wheel = 0;
);
function swing_bigview_close() ( swing_bigview_leave_(); big_view_id = VIEW_NONE; );

// SYNTH view opener (rk_swing_ui_synthview.jsfx-inc). Lives HERE so the
// earlier-imported grid_pads chip/Alt-click sites resolve it at def-time.
// Closes any open pad editor: only one modal class at a time.
// 2026-10-22 (the user: "I want it all" / the overlays "for just the compact mode"): in the FULL window both openers land in
// the pad PANEL -- its SYNTH page here, its SOUND page below -- at the side or under the pads (fx_place); the big view and
// the overlay stay for the faces that have no slot to hold a panel: the embeds, and the rack face when the editor is
// placed below (it has no bottom slot). pfx_req is applied by the side slot's draw, after the width request has gone out.
// The USER's face (the small-things round): the rack face the compact switch draws while a panel under the pads leaves
// too little room keeps the full face's bottom slot, so the editor placed below still lands there.
// The bottom slot (the sequencer's gutter -- its handle -- and the panel under the pads; rk_seq_ui swing_seq_gate): the
// full face's, and since 2026-10-27 also the rack face Auto picks from a floating window's shape (the owner: "When i
// resize the floating window to compact the sequencer handle disappears i dont want that") -- and the rack face Auto
// picks when the dock rig captures this Swing (the wordmark's dock; swing_fb_can_grow 0), so docking keeps what was open
// (the owner, the same day: "if I have the sequencer, pad effects, and browser open, they all stay open once I click
// dock"; until then the panel under the pads vanished while docked). The docked pane cannot grow: the pads give the
// height (rk_seq_ui swing_seq_gate's squeeze). The user's own Rack pick (dock_face_mode 2) and the embeds keep no slot.
// To give the Rack pick the slot too, drop both `dock_face_mode == 0 &&`.
function swing_bot_slot() ( !is_embedded && (!dock_face_user || (dock_face_mode == 0 && swing_fb_can_grow())) || (!is_embedded && dock_face_mode == 0 && swing_dock_held()); );
function swing_panel_can_host() ( swing_bot_slot() || (!is_embedded && fx_place != 3); );
function swing_synthview_open(pad) (
  syn_view_pad = pad;
  swing_select_pad(pad);   // an absolute pad (step 4a)
  overlay_pad = -1;
  swing_panel_can_host() ? ( swing_bigview_close(); pfx_req = 1; pfx_page = 1; )
                         : swing_bigview_open(VIEW_SYNTH);
);

// Pad editor opener — the other half of the pair above, and for the same
// reason: only one modal class at a time.
//
// ⚠️ THIS EXISTS BECAUSE THE PAD FX STRIP WAS UNREACHABLE ON SYNTH PADS.
// The pad editor hosts the per-pad EQ, filters, comp, drive and sends
// (_ov_draw_eq_and_filters / _ov_draw_fx_knobs), and the grid's right-click
// was the ONLY thing that ever opened it — with synth-only pads deliberately
// routed to the SYNTH view instead, on the reasoning that they have no sample
// layers to edit. True of the LAYERS; the FX went with them. So on an
// all-synth kit every pad's strip was invisible, which the factory macros
// made loud: PUNCH / TONE / SPACE / DRIVE / VIBE all drive those params.
// The SYNTH view now carries a PAD FX button that lands here.
function swing_padfx_open(pad) (
  swing_bigview_close();          // no-op from the grid; the exit door from a view
  swing_panel_can_host() ? ( swing_select_pad(pad); overlay_pad = -1; pfx_req = 1; pfx_page = 0; ) : (
    overlay_pad = pad;
    overlay_layer = _ov_last_tab >= MAX_LAYERS ? 0 : _ov_last_tab;
    wf_zoom = 1.0; wf_scroll = 0.0;   // reset zoom on new pad
  );
);

// Pad input policy: true when the pad grid should receive live input. Today:
// only when NO modal (pad editor OR big view) is open — exactly the condition
// the inlined `overlay_pad < 0` guards enforced. Becomes view-aware in a later
// step (a view may opt its policy into live pads, e.g. Mapping).
function pad_input_allowed() ( overlay_pad < 0 && big_view_id == VIEW_NONE && rng_ov_pad < 0 && cat_ov_pad < 0 && pk_ov_pad < 0 && !kmac_ed_open );

function swing_ui_modal_gate() (
_raw_lmb_down = lmb_down;  // preserve for overlay backdrop-click-to-close
_raw_LMB = LMB;            // preserve for overlay backdrop-click-to-close
_raw_wheel = frame_wheel;  // preserve for popup wheel navigation (gate zeroes frame_wheel below)
// ⚠️⚠️ swing_popup_active BELONGS HERE and was missing. rk_swing_popup's own
// header states the contract -- "when swing_popup_active is non-zero,
// swing_ui_modal_gate() suppresses the underlying UI's mouse state" -- but the
// condition never tested it, so the click that PICKED a menu item also reached
// whatever the popup was covering. Reported on the mini browser's rail menu
// ("remove from list works but there is click thru"); it was true of every
// popup in the plugin, that is just the first one whose underlay does something
// visible on a click. The popup itself is unaffected: swing_popup_tick reads
// the _raw_lmb_down / _raw_LMB copies preserved immediately above.
// Published for the strip's keyboard (decision 6, 2026-09-15): the one place
// that knows a modal is up, so no second list of modals exists to drift.
_ui_modal_up = overlay_pad >= 0 || big_view_id != VIEW_NONE || rng_ov_pad >= 0 || cat_ov_pad >= 0 || pk_ov_pad >= 0 || kmac_ed_open || swing_popup_active;
_ui_modal_up ? (
  // The pad editor paints its panel UNSCALED, 420 x 560 (rk_swing_ui_grid_overlay op_w / op_h), so the gate's rect
  // is that one (2026-10-16): scaled by _ui_sc it was larger than the panel in a big window, and a click in the ring
  // between the two counted as inside the overlay while the overlay saw it outside its panel (triage 2026-10-14
  // item 14). If the panel ever scales, scale both in one place -- it does since 2026-10-28 (the editor's zoom): both
  // read swing_ov_w / swing_ov_h, which the overlay's own op_w / op_h are.
  _ov_pw = swing_ov_w(); _ov_ph = swing_ov_h();   // 420 x 560 (+ the layer mixer where the window has the room) at the zoom (rk_swing_ui_layer_mixer)
  _ov_px = (gfx_w - _ov_pw) / 2;
  _ov_py = 28 + ((ui_bot - 28 - _ov_ph) / 2);   // centred over the face, not over the sequencer's panel under it
  _in_ov = mx >= _ov_px && mx <= _ov_px + _ov_pw && my >= _ov_py && my <= _ov_py + _ov_ph;
  // Suppress ALL mouse state so underlying controls never fire while overlay is open.
  // The overlay code (drawn last) restores what it needs from _ov_* saved copies.
  _ov_lmb_down = lmb_down; _ov_rmb_down = rmb_down;
  _ov_LMB = LMB; _ov_RMB = RMB;
  _ov_wheel = frame_wheel; _ov_mx = mx; _ov_my = my;
  lmb_down = 0; rmb_down = 0; frame_wheel = 0;
  LMB = 0; RMB = 0;
);
// Custom popup menu (rk_swing_popup.jsfx-inc) — same idea: when active,
// suppress underlying UI input so clicks don't fall through. The popup tick
// reads _raw_lmb_down / _raw_LMB to detect its own clicks.
swing_popup_active ? (
  lmb_down = 0; rmb_down = 0; frame_wheel = 0;
  LMB = 0; RMB = 0;
  // ⚠️⚠️ ...and the SAVED copies too, which is what was still missing. Every
  // big view RESTORES this mouse state so its own controls work under the gate
  // (swing_panels_draw_mixer_big, swing_fxview_draw, the colours overlay, the
  // grid overlay). The block above had already stashed the REAL click into
  // _ov_* before zeroing the live vars, so a popup opened OVER one of those
  // views handed the click straight back on restore: pick "Delete" on a console
  // insert slot and the same click also landed on whatever sat under the menu.
  // Reported 2026-09-09 on the console; it was true of every overlay. Zeroing
  // the saves here means no restore site has to know about popups at all --
  // the alternative was the same guard copied into four files, and the fifth
  // would have been written without it. The popup itself is untouched: it reads
  // _raw_lmb_down / _raw_LMB / _raw_wheel, preserved at the top of this gate
  // before any of this runs. _ov_mx / _ov_my stay live on purpose so hover
  // still tracks under an open menu.
  _ov_lmb_down = 0; _ov_rmb_down = 0; _ov_LMB = 0; _ov_RMB = 0; _ov_wheel = 0;
);
);

// ── The save's owner (bridge level 322, 2026-10-27; sweep LIB121 / LIB122 with the bridge's half) ──────────────
// The bus's save codes (11 the name, 93 the next bank, 99 done, 98 cancelled, 85 a silent dump's ack) said nothing
// about whose save they answered, so with two Swings one could take the other's: an instance left in export state
// 10 or 3 (its window closed mid-save -- this tick runs in @gfx only) took the next save's 11 and dumped ITS kit
// under that name, or ate the 93 / 99 the real saver waited on and left it wedged. The sweep gated these on LOCK
// and was reverted: the bridge loses LOCK between bank dumps (its stale-LOCK self-heal fires on the CMD-0 gap), so
// every 93 went out under LOCK 0 and each multi-bank save wedged. A level-322 bridge names the saver in
// GS_KIT_SAVE_OWNER for the whole save instead (Swing_Kit_Bridge eon_save_owner_tick). An older bridge never
// writes it, so below that level these consumes take every code as before: a new Swing beside an old bridge
// cannot wedge.
function swing_save_mine() (
  gmem[GS_BRIDGE_LEVEL] < BRIDGE_LEVEL_SAVE_OWNER || gmem[GS_KIT_SAVE_OWNER] == instance_id;
);
// The idle CMD-99 consumer (swing_ui_misc_cmds) takes no other instance's SAVE 99. Owner 0 = no save in flight:
// a Lua-posted op's orphan 99 (the Auto-Color Pads action, CMD 23) still reaches an idle Swing, as it must.
function swing_save_owner_free() (
  gmem[GS_BRIDGE_LEVEL] < BRIDGE_LEVEL_SAVE_OWNER || gmem[GS_KIT_SAVE_OWNER] == 0 || gmem[GS_KIT_SAVE_OWNER] == instance_id;
);
EXPORT_ORPHAN_S = 10;   // seconds export state 10 / 3 waits on a bus that moved on without it (sweep LIB121)
// Import state 1's 99 / 98 (bridge level 323, 2026-10-27, RR-1; sweep LIB122's build half). State 1 is armed by
// this instance's own build or import (CMD 40 / 74 / 92 / 16 / 20 / 30) and by the LOAD button, and it took ANY 99 or
// 98 as the end of its op: another Swing's build or save closing, or the bridge refusing another Swing's save (a 98
// that names that saver), aborted this instance's armed load while the real requester stayed kit_busy. A 323 bridge
// keeps LOCK = the requester on every 99 and 98 (it used to release it the tick a build's 99 or a build's / load's
// failure 98 went out), so from that level either code is taken only under LOCK 0 or this instance's id,
// and neither under another instance's save owner. Below 323 (LOCK released, no pop gate) both are taken as before.
function swing_import_done_mine() (
  gmem[GS_BRIDGE_LEVEL] < BRIDGE_LEVEL_SAVE_TXN || (
    (gmem[GS_KIT_SAVE_OWNER] == 0 || gmem[GS_KIT_SAVE_OWNER] == instance_id) &&
    (gmem[KIT_GMEM_LOCK] == 0 || gmem[KIT_GMEM_LOCK] == instance_id)
  );
);

function swing_ui_export_tick()
local(_ki, _mb, _li_base, _lidx, _lj, _lo, _lpb, _pbase, _plen, _ci, _cj, _cn, _cnl,
      _knl, _gb, _j, _dump_off, _l_alen, _l_src, _lp, _lpl, _s_alen, _s_src, _tpath,
      _syb, _n, _dump_over, _ex_bank, _ka, _km, _kb, _kd, _ks, _kn, _kpass, _kold, _lmb)
// local() list added 2026-07-09 — same @gfx/@block scratch-global race class as
// swing_ui_import_tick (this one runs @gfx; its _ki loops clobbered the @block
// import's index). _ex_undo_busy_prev deliberately global (cross-invocation).
(
// ── Silent kit dump for the disk-based kit undo (bridge writes CMD 83 right
//    before a kit load / wipe). Jump straight to state 11: stage the CURRENT
//    kit (name + globals + meta + audio) to gmem; state 11 ends with CMD=1 and
//    the bridge writes the temp .swing. The bridge acks with CMD 85 (below),
//    which — unlike 99 — leaves LOCK and any pending import state untouched.
//    Instance-gated (audit B-6): the producer writes LOCK = the target instance
//    before CMD 83 (the parked bridge dump path must too when it is revived;
//    the rigs do), so only that instance stages. Ungated, any Swing whose @gfx
//    ran first took the dump and staged ITS kit under the requester's LOCK.
kit_export_state == 0 && gmem[KIT_GMEM_CMD] == 83
  && gmem[KIT_GMEM_LOCK] == instance_id ? (
  _ex_undo_busy_prev = kit_busy;  // state 11 sets kit_busy=1; CMD 85 restores this
  _ex_is_dump = 1;                // 2026-07-09: state 11 emits CMD 84 (not 1) so the
                                  // bridge disambiguates a silent-dump complete from a
                                  // user-save complete WITHOUT job bookkeeping (which
                                  // its own timeout could nil mid-stage → ack hole).
  kit_export_state = 11;
);

kit_export_state == 1 ? (
  // Phase 1: Signal Lua to prompt user for kit name + metadata
  // LOCK reacquire is belt-and-suspenders: the save button handlers in
  // rk_swing_ui_panels_controls.jsfx-inc:47 already write LOCK + CMD=10
  // atomically and skip state 1, but if any external code path ever sets
  // kit_export_state=1 without writing LOCK, this prevents the bridge's
  // stale-LOCK self-heal from clearing LOCK before the save reaches Lua.
  gmem[KIT_GMEM_LOCK] = instance_id;
  gmem[KIT_GMEM_CMD] = 10;  // ask Lua for name
  kit_export_state = 10;     // wait for name
);

// Safety net (audit B-5, 2026-09-14): a CMD 11 answered for THIS instance while
// it sits in state 0 -- a producer that posted CMD 10 without arming, or an arm
// lost to a chunk restore between the post and the reply -- is adopted here, so
// a name reply can never strand the bus at CMD 11 with our LOCK held. The LOCK
// test keeps another instance's save from being hijacked; the state-10 block
// below consumes the 11 in this same evaluation.
kit_export_state == 0 && !kit_busy && gmem[KIT_GMEM_CMD] == 11
  && gmem[KIT_GMEM_LOCK] == instance_id ? (
  kit_export_state = 10;
  kit_busy = 1;
);

// States 10 and 3 wait on the bus and take only their own save's codes (swing_save_mine, above). They give up once
// the bus has moved on without them: CMD read 0 with LOCK not ours for EXPORT_ORPHAN_S. Before: close the window
// during the name prompt or the write, the bridge's fuse clears the unconsumed 11 / 99 to 0 and drops LOCK, and on
// reopen the instance said "Saving Kit..." for good, kit_busy up (sweep LIB121). Between two bank dumps the bus also
// reads 0, but the saver is in state 11 / 12 then, never here.
// (explicit branches: `c ? (..) : x = 0` would assign to the conditional itself -- the EEL2 parse rk_drumkit_dsp warns of)
((kit_export_state == 10 || kit_export_state == 3) && gmem[KIT_GMEM_CMD] == 0 && gmem[KIT_GMEM_LOCK] != instance_id) ? (
  _ex_orph_t == 0 ? ( _ex_orph_t = time_precise(); );
  time_precise() - _ex_orph_t >= EXPORT_ORPHAN_S ? (
    kit_busy = _ex_is_dump ? _ex_undo_busy_prev : 0;   // a silent dump hands back the busy it found (the 85 path's rule)
    kit_export_state = 0; _ex_is_dump = 0; kit_export_only = 0; _ex_orph_t = 0;
  );
) : (
  _ex_orph_t = 0;
);

kit_export_state == 10 ? (
  // Phase 1b: Wait for Lua to provide name (CMD=11) or cancel (CMD=98) -- this instance's save only (swing_save_mine)
  gmem[KIT_GMEM_CMD] == 11 && swing_save_mine() ? (
    // Name ready — read it back from gmem
    _knl = gmem[KIT_GMEM_NAMELEN] | 0;
    _knl = min(_knl, 32);
    kit_export_only > 0 ? (
      // Pad Banks audit S7: "save bank X as a kit" names BANK X -- its tab -- and the instrument keeps its own
      // name. It took the instrument's, so a one-bank file renamed the whole kit everywhere it is shown.
      _n = BKNAME_STR_BASE + kit_export_only - 1;
      str_setlen(_n, 0);
      _ki = 0; loop(_knl, str_setchar(_n, _ki, gmem[KIT_GMEM_NAME + _ki] | 0); _ki += 1; );
      str_setlen(_n, _knl);
      mark_dirty();   // the bank names are saved with the project (ser_ver 77)
    ) : (
      str_setlen(#kit_name, 0);
      _ki = 0; loop(_knl,
        str_setchar(#kit_name, _ki, gmem[KIT_GMEM_NAME + _ki] | 0);
        _ki += 1;
      );
      str_setlen(#kit_name, _knl);
    );
    kit_export_state = 11;  // proceed to metadata copy
  );
  gmem[KIT_GMEM_CMD] == 98 && swing_save_mine() ? ( kit_export_state = 0; kit_busy = 0; _ex_is_dump = 0; kit_export_only = 0; gmem[KIT_GMEM_LOCK] = 0; gmem[KIT_GMEM_CMD] = 0; );
);

kit_export_state == 11 ? (
  // Phase 2: Write metadata to gmem (instant, one frame)
  gmem[KIT_GMEM_VER] = 24;
  gmem[KIT_GMEM_NPADS] = NUM_PADS;
  // Step 3b (2026-09-23): the bank this dump publishes. The sixteen-wide bands cannot grow, so the
  // bridge asks for one bank at a time (GS_KIT_EXPORT_BANK, 0 = bank A = what every save did before)
  // and writes banks 1..3 as BANK tail records. _ki stays the band index, _ka is the engine slot.
  _ex_bank = max(0, min(NUM_BANKS - 1, gmem[GS_KIT_EXPORT_BANK] | 0));
  // Kit name
  _knl = strlen(#kit_name);
  gmem[KIT_GMEM_NAMELEN] = _knl;
  _ki = 0; loop(min(_knl, 32),
    gmem[KIT_GMEM_NAME + _ki] = str_getchar(#kit_name, _ki);
    _ki += 1;
  );
  // Global settings (new in kit format v22)
  _gb = KIT_GMEM_GLOBALS;
  gmem[_gb + 0]  = repeat_div;
  gmem[_gb + 1]  = vel_curve;
  gmem[_gb + 2]  = swing_amt;
  gmem[_gb + 3]  = gfx_hpf_freq;
  gmem[_gb + 4]  = gfx_lpf_freq;
  gmem[_gb + 5]  = gfx_sat_drv;
  gmem[_gb + 6]  = dly_div;
  gmem[_gb + 7]  = dly_fb;
  gmem[_gb + 8]  = dly_mix;
  gmem[_gb + 9]  = dly_hpf_hz;
  gmem[_gb + 10] = dly_lpf_hz;
  gmem[_gb + 11] = dly_ping;
  gmem[_gb + 12] = rvb_size;
  gmem[_gb + 13] = rvb_damp;
  gmem[_gb + 14] = rvb_mix;
  gmem[_gb + 15] = rvb_width;
  gmem[_gb + 16] = gfx_eq_lo;
  gmem[_gb + 17] = gfx_eq_mid;
  gmem[_gb + 18] = gfx_eq_hi;
  gmem[_gb + 19] = gfx_lim_on;
  gmem[_gb + 20] = gfx_lim_thr;
  gmem[_gb + 21] = gfx_lim_rel;
  gmem[_gb + 22] = gfx_eq_lo_freq;
  gmem[_gb + 23] = gfx_eq_mid_freq;
  gmem[_gb + 24] = gfx_eq_hi_freq;
  gmem[_gb + 25] = meq_lo_bell;
  gmem[_gb + 26] = meq_hi_bell;
  gmem[_gb + 27] = note_map;
  gmem[_gb + 28] = multi_out;
  gmem[_gb + 29] = color_palette;
  gmem[_gb + 30] = meq_bypass;
  gmem[_gb + 31] = cmp_thresh;
  gmem[_gb + 32] = cmp_ratio;
  gmem[_gb + 33] = cmp_attack;
  gmem[_gb + 34] = cmp_release;
  gmem[_gb + 35] = cmp_knee;
  gmem[_gb + 36] = cmp_makeup;
  gmem[_gb + 37] = cmp_mix;
  gmem[_gb + 38] = cmp_bypass;
  gmem[_gb + 39] = rvb_predelay;
  gmem[_gb + 40] = rvb_hpf;
  gmem[_gb + 41] = oneshot_global;
  gmem[_gb + 42] = rvb_on;
  gmem[_gb + 43] = dly_on;
  // Master EQ Q per mode (ser_ver 75). Appended after dly_on, the same way the
  // bus enables were -- see KIT_GLOBAL_KEYS in Swing_Kit_Bridge.lua, whose order
  // this must match. Swing Lite never reaches past +41, so these are Swing's.
  gmem[_gb + 44] = gfx_eq_lo_sq;
  gmem[_gb + 45] = gfx_eq_lo_bq;
  gmem[_gb + 46] = gfx_eq_mid_q;
  gmem[_gb + 47] = gfx_eq_hi_sq;
  gmem[_gb + 48] = gfx_eq_hi_bq;
  // Per-pad metadata
  _ki = 0; loop(NUM_PADS,   // this bank (step 3b): band index _ki, engine slot _ka
    _ka = _ex_bank * NUM_PADS + _ki;
    _mb = KIT_GMEM_META + _ki * KIT_GMEM_META_PP;
    _li_base = _ka * MAX_LAYERS;
    gmem[_mb + 0]  = p_gain[_ka];
    gmem[_mb + 1]  = p_pan[_ka];
    gmem[_mb + 2]  = p_tune[_ka];
    gmem[_mb + 3]  = p_attack[_ka];
    gmem[_mb + 4]  = p_decay[_ka];
    gmem[_mb + 5]  = p_sustain[_ka];
    gmem[_mb + 6]  = p_release[_ka];
    gmem[_mb + 7]  = p_mute[_ka];
    gmem[_mb + 8]  = p_solo[_ka];
    gmem[_mb + 9]  = p_output[_ka];
    gmem[_mb + 10] = p_note[_ka] - _ex_bank * NUM_PADS;   // step 3b: a kit stores notes RELATIVE to the bank's block (bank A: identity)
    gmem[_mb + 11] = p_note_lock[_ka];
    // the hue the pad WEARS, in any bank: col_auto_hue[] is the bank on screen's sixteen tiles, and writing it for
    // bank A's pass stored the shown bank's hues as bank A's whenever B..D was on screen at the save (sweep LIB142)
    gmem[_mb + 12] = col_auto_mode_id > 0 ? swing_color_auto_hue(_ka) : p_color[_ka];
    gmem[_mb + 13] = p_choke[_ka];
    gmem[_mb + 14] = p_oneshot[_ka];
    gmem[_mb + 15] = p_reverse[_ka];
    gmem[_mb + 16] = fx_hpf_freq[_ka];
    gmem[_mb + 17] = fx_lpf_freq[_ka];
    gmem[_mb + 18] = fx_eq_lo[_ka];
    gmem[_mb + 19] = fx_eq_mid[_ka];
    gmem[_mb + 20] = fx_eq_hi[_ka];
    gmem[_mb + 21] = fx_sat_drv[_ka];
    gmem[_mb + 22] = fx_drv_mode[_ka];
    gmem[_mb + 23] = fx_bc_rate[_ka];
    gmem[_mb + 24] = fx_bc_bits[_ka];
    gmem[_mb + 25] = fx_snd_dly[_ka];
    gmem[_mb + 26] = fx_snd_rvb[_ka];
    // Smash send rides its own overflow band — META's 80-float stride is full
    // (see the GS_PAD_OFFSET_BASE note below).
    gmem[GS_PAD_SMASH_BASE + _ki] = fx_snd_smash[_ka];
    gmem[_mb + 27] = fx_eq_lo_freq[_ka];
    gmem[_mb + 28] = fx_eq_mid_freq[_ka];
    gmem[_mb + 29] = fx_eq_hi_freq[_ka];
    gmem[_mb + 30] = p_sum_tight[_ka];
    gmem[_mb + 31] = p_rpt_div[_ka];
    gmem[_mb + 32] = p_layer_cnt[_ka];
    gmem[_mb + 33] = p_layer_mode[_ka];
    gmem[_mb + 34] = s_len[_ka];
    gmem[_mb + 35] = s_start[_ka];
    gmem[_mb + 36] = s_end[_ka];
    gmem[_mb + 37] = s_sr[_ka];
    gmem[_mb + 38] = s_norm[_ka];
    gmem[_mb + 39] = s_norm_gain[_ka];
    // Per-layer data (4 layers × 10 values = 40 floats)
    _lj = 0; loop(MAX_LAYERS,
      _lo = _mb + 40 + _lj * 10;
      _lidx = _li_base + _lj;
      gmem[_lo + 0] = l_len[_lidx];
      gmem[_lo + 1] = l_start[_lidx];
      gmem[_lo + 2] = l_end[_lidx];
      gmem[_lo + 3] = l_sr[_lidx];
      gmem[_lo + 4] = l_norm[_lidx];
      gmem[_lo + 5] = l_norm_gain[_lidx];
      gmem[_lo + 6] = l_vel_lo[_lidx];
      gmem[_lo + 7] = l_vel_hi[_lidx];
      gmem[_lo + 8] = l_rr_order[_lidx];
      gmem[_lo + 9] = l_gain[_lidx];
      // the layer's bake anchor (a plain pad's is layer 0's): the bridge stores the original, not a bake (2026-10-10)
      gmem[GS_KIT_EXPORT_ANCHOR + _ki * MAX_LAYERS + _lj] = sp_baked_tune[_lidx];
      // the layer mixer (a plain pad's is layer 0's: its L1): before the anchor stamp below, which vouches for it too
      _lmb = GS_KIT_LMIX_BASE + (_ki * GS_KIT_LMIX_SLOTS + _lj) * GS_KIT_LMIX_PP;
      gmem[_lmb + 0] = l_pan[_lidx]; gmem[_lmb + 1] = l_mute[_lidx]; gmem[_lmb + 2] = l_solo[_lidx]; gmem[_lmb + 3] = l_gain[_lidx];
      _lj += 1;
    );
    // the layer mixer's SYN strip (its slot after the layers; its level = ps_level, which the SYN band also carries)
    _lmb = GS_KIT_LMIX_BASE + (_ki * GS_KIT_LMIX_SLOTS + MAX_LAYERS) * GS_KIT_LMIX_PP;
    gmem[_lmb + 0] = ps_pan[_ka]; gmem[_lmb + 1] = ps_mute[_ka]; gmem[_lmb + 2] = ps_solo[_ka]; gmem[_lmb + 3] = ps_level[_ka];
    // Sample offset (separate gmem region — META is full)
    gmem[GS_PAD_OFFSET_BASE + _ki] = p_sample_offset[_ka];
    // SYN slot (own band — META's 80-float stride is full)
    _syb = GS_SYN_META_BASE + _ki * GS_SYN_META_PP;
    gmem[_syb + 0]  = ps_enable[_ka];
    gmem[_syb + 1]  = ps_engine[_ka];
    gmem[_syb + 2]  = ps_level[_ka];
    gmem[_syb + 3]  = ps_vel_lo[_ka];
    gmem[_syb + 4]  = ps_vel_hi[_ka];
    gmem[_syb + 5]  = ps_rr_order[_ka];
    gmem[_syb + 6]  = ps_mac0[_ka];
    gmem[_syb + 7]  = ps_mac1[_ka];
    gmem[_syb + 8]  = ps_mac2[_ka];
    gmem[_syb + 9]  = ps_mac3[_ka];
    gmem[_syb + 10] = ps_mac4[_ka];
    gmem[_syb + 11] = ps_mac5[_ka];
    gmem[_syb + 12] = ps_mac6[_ka];
    gmem[_syb + 13] = ps_mac7[_ka];
    // Chromatic key-range, PACKED lo*128+hi (separate region; META full)
    gmem[GS_PAD_RANGE_BASE + _ki] = (p_rng_lo[_ka]|0) * 128 + (p_rng_hi[_ka]|0);
    // Pad name (up to 16 chars)
    _cn = get_cname_slot(_ka);
    _cnl = strlen(_cn);
    _cj = 0; loop(KIT_GMEM_PADNAME_LEN,
      gmem[KIT_GMEM_PADNAMES + _ki * KIT_GMEM_PADNAME_LEN + _cj] =
        _cj < _cnl ? str_getchar(_cn, _cj) : 0;
      _cj += 1;
    );
    _ki += 1;
  );
  gmem[GS_KIT_EXPORT_ANCHOR_ID] = instance_id;       // after every anchor: they speak for this instance's dump
  gmem[GS_KIT_EXPORT_ANCHOR_STAMP] = _ex_bank + 1;   //   of this bank
  // ─── Kit-macro model → transfer band (KMAC_KIT_BASE; kit-LEVEL, once) ──
  // +0 is the bridge→JSFX staged flag and is NEVER written here. Export-
  // gated like everything in this phase, so a bridge-staged model can never
  // be stomped by a publish. The bridge's write_kit_v4 reads +1..+390 right
  // after this frame and packs them as tail tag 2. Layout MUST match
  // eon_kmac_pack/stage in Swing_Kit_Bridge.lua.
  gmem[KMAC_KIT_BASE + 1] = 3;   // model version (v2 = +custom names; v3 = bank B..D mappings last + full counts)
  gmem[KMAC_KIT_BASE + 2] = macro1; gmem[KMAC_KIT_BASE + 3] = macro2;
  gmem[KMAC_KIT_BASE + 4] = macro3; gmem[KMAC_KIT_BASE + 5] = macro4;
  gmem[KMAC_KIT_BASE + 6] = macro5; gmem[KMAC_KIT_BASE + 7] = macro6;
  gmem[KMAC_KIT_BASE + 8] = macro7; gmem[KMAC_KIT_BASE + 9] = macro8;
  _ki = 0; loop(KMAC_N,
    gmem[KMAC_KIT_BASE + 18 + _ki] = kmac_scope[_ki];
    gmem[KMAC_KIT_BASE + 26 + _ki] = kmac_color[_ki];
    _ki += 1;
  );
  // ⭐ Model v3 (Pad Banks, 2026-09-24): kit macros reach all four banks, but a pre-banks reader (Swing 3.0.18
  // and older) clamps any pad above 15 onto pad 16 -- and applies it at once (kmac_force), so a bank B mapping
  // would change pad 16's sound there. So per macro the file carries the OLD-SAFE mappings first (ALL, SEL, a
  // bank A pad: anything an old reader can apply), then the bank B..D ones; +10+m (the count every reader has
  // always read) counts only the old-safe ones, and the new +487+m counts them all. An old reader stops at its
  // count and never sees the rest. The reorder is the FILE's: the live arrays keep the user's order (after a
  // reload the editor lists a macro's bank A rows first). Slots past a macro's count go out verbatim, as before.
  _km = 0; loop(KMAC_N,
    _kb = _km * KMAC_MAX_MAP;
    _kn = min(kmac_nmap[_km], KMAC_MAX_MAP);
    _kd = _kb;
    _kpass = 0; loop(2,
      _ks = _kb; loop(_kn,
        _kold = kmac_pad[_ks] < NUM_PADS;   // -2 / -1 / a bank A pad = what a sixteen-pad reader can apply
        (_kpass == 0 ? _kold : !_kold) ? (
          gmem[KMAC_KIT_BASE + 34 + _kd]  = kmac_pad[_ks];
          gmem[KMAC_KIT_BASE + 98 + _kd]  = kmac_pid[_ks];
          gmem[KMAC_KIT_BASE + 162 + _kd] = kmac_lo[_ks];
          gmem[KMAC_KIT_BASE + 226 + _kd] = kmac_hi[_ks];
          gmem[KMAC_KIT_BASE + 290 + _kd] = kmac_curve[_ks];
          _kd += 1;
        );
        _ks += 1;
      );
      _kpass == 0 ? ( gmem[KMAC_KIT_BASE + 10 + _km] = _kd - _kb; );   // the legacy count: old-safe rows only
      _kpass += 1;
    );
    gmem[KMAC_KIT_BASE + 487 + _km] = _kn;                                // v3: the full count
    _ks = _kb + _kn; loop(KMAC_MAX_MAP - _kn,
      gmem[KMAC_KIT_BASE + 34 + _ks]  = kmac_pad[_ks];
      gmem[KMAC_KIT_BASE + 98 + _ks]  = kmac_pid[_ks];
      gmem[KMAC_KIT_BASE + 162 + _ks] = kmac_lo[_ks];
      gmem[KMAC_KIT_BASE + 226 + _ks] = kmac_hi[_ks];
      gmem[KMAC_KIT_BASE + 290 + _ks] = kmac_curve[_ks];
      _ks += 1;
    );
    _km += 1;
  );
  _ki = 0; loop(KMAC_NSNAP * KMAC_N,
    gmem[KMAC_KIT_BASE + 354 + _ki] = kmac_snap[_ki]; _ki += 1;
  );
  _ki = 0; loop(KMAC_NSNAP,
    gmem[KMAC_KIT_BASE + 386 + _ki] = kmac_snap_has[_ki]; _ki += 1;
  );
  gmem[KMAC_KIT_BASE + 390] = kmac_snap_act;
  // model v2: custom names as char cells, KMAC_NAME_LEN per macro (0-pad)
  _ki = 0; loop(KMAC_N,
    _cn = swing_lcd_kmac_name_slot(_ki);
    _cnl = strlen(_cn);
    _cj = 0; loop(KMAC_NAME_LEN,
      gmem[KMAC_KIT_BASE + 391 + _ki * KMAC_NAME_LEN + _cj] =
        _cj < _cnl ? str_getchar(_cn, _cj) : 0;
      _cj += 1;
    );
    _ki += 1;
  );
  // ─── V2/v3 format: write per-pad file paths to gmem audio area ──
  _ki = 0; loop(NUM_PADS,   // this bank (step 3b)
    _tpath = get_path_slot(_ex_bank * NUM_PADS + _ki);
    _plen = strlen(_tpath);
    _pbase = KIT_GMEM_AUDIO + _ki * 260;
    gmem[_pbase] = _plen;
    _ci = 0; loop(min(_plen, 258),
      gmem[_pbase + 1 + _ci] = str_getchar(_tpath, _ci);
      _ci += 1;
    );
    gmem[_pbase + 1 + min(_plen, 258)] = 0;
    _ki += 1;
  );
  // ─── V4 addition: write per-layer paths to gmem after pad paths ──
  // Layout: KIT_GMEM_AUDIO + NUM_PADS*260 + (pad*MAX_LAYERS + layer) * 260
  // (NUM_PADS*MAX_LAYERS = 64 slots × 260 doubles = ~166KB, well within audio region)
  // The Lua bridge reads these to locate per-layer source files for v4 save.
  _ki = 0; loop(NUM_PADS,
    _lj = 0; loop(MAX_LAYERS,
      _lp = LPATH_STR_BASE + (_ex_bank * NUM_PADS + _ki) * MAX_LAYERS + _lj;   // this bank (step 3b)
      _lpl = strlen(_lp);
      _lpb = KIT_GMEM_AUDIO + NUM_PADS * 260 + (_ki * MAX_LAYERS + _lj) * 260;
      gmem[_lpb] = _lpl;
      _ci = 0; loop(min(_lpl, 258),
        gmem[_lpb + 1 + _ci] = str_getchar(_lp, _ci);
        _ci += 1;
      );
      gmem[_lpb + 1 + min(_lpl, 258)] = 0;
      _lj += 1;
    );
    _ki += 1;
  );

  // ─── Per-pad audio dump (SELF-CONTAINED-KIT FIX) ─────────────────────
  // Write THIS instance's internal s_audio_start[] to gmem in a region the
  // bridge can read for kits whose pads have no disk source (Choppa slices,
  // gmem-imported audio, etc.). Without this dump, the bridge falls back to
  // reading from KIT_GMEM_AUDIO + offset which state-11 just overwrote with
  // path strings — corrupted reads produce wrong-pad / blank kit saves.
  //
  // Dump layout: KIT_GMEM_AUDIO_DUMP + cumulative interleaved-sample offset.
  // Bridge reads from this region using prefix sum of s_len (non-layered) or
  // sum of l_len per layer (layered). Both halves agree on the layout.
  KIT_GMEM_AUDIO_DUMP = KIT_GMEM_AUDIO + NUM_PADS * 260 + NUM_PADS * MAX_LAYERS * 260;
  _dump_off = 0;
  // Band guard (Spec_Swing_Long_Pad_Layer_Cap §4.4): the dump must stay under
  // KIT_GMEM_AUDIO_DUMP_END — the Stretch rings start there, and the bridge's
  // paper bound for this band (64M) was four times the real room (~16.75M
  // cells for the WHOLE kit). The first blob that would cross it stops the
  // dump for good (a partial dump would desync the bridge's cumulative
  // offsets) and GS_EXPORT_OVER tells the bridge to refuse the save.
  // Loop cap: every copy walks in KIT_DUMP_CHUNK pieces, so a plain pad's
  // full slot (up to SLOT_SIZE cells) never meets EEL2's 2^20 iteration cap.
  _dump_over = 0;
  _ki = 0; loop(NUM_PADS,   // this bank (step 3b): _ka = the engine slot
    _ka = _ex_bank * NUM_PADS + _ki;
    p_layer_cnt[_ka] > 0 ? (
      // Layered: dump each active layer in order
      _lj = 0; loop(p_layer_cnt[_ka],
        _lidx = _ka * MAX_LAYERS + _lj;
        _l_alen = l_len[_lidx];
        _l_alen > 0 && !_dump_over ? (
          KIT_GMEM_AUDIO_DUMP + _dump_off + _l_alen > KIT_GMEM_AUDIO_DUMP_END ? (
            _dump_over = 1;
          ) : (
            _l_src = p_lptr[_ka * MAX_LAYERS + _lj];
            _j = 0;
            while(_j < _l_alen) (
              _n = min(_l_alen - _j, KIT_DUMP_CHUNK);
              loop(_n,
                gmem[KIT_GMEM_AUDIO_DUMP + _dump_off + _j] = _l_src[_j];
                _j += 1;
              );
            );
            _dump_off += _l_alen;
          );
        );
        _lj += 1;
      );
    ) : (
      // Plain pad: dump the pad-main audio — the whole slot is its sample
      _s_alen = s_len[_ka];
      _s_alen > 0 && !_dump_over ? (
        KIT_GMEM_AUDIO_DUMP + _dump_off + _s_alen > KIT_GMEM_AUDIO_DUMP_END ? (
          _dump_over = 1;
        ) : (
          _s_src = p_aptr[_ka];
          _j = 0;
          while(_j < _s_alen) (
            _n = min(_s_alen - _j, KIT_DUMP_CHUNK);
            loop(_n,
              gmem[KIT_GMEM_AUDIO_DUMP + _dump_off + _j] = _s_src[_j];
              _j += 1;
            );
          );
          _dump_off += _s_alen;
        );
      );
    );
    _ki += 1;
  );
  gmem[GS_EXPORT_OVER] = _dump_over;

  gmem[KIT_GMEM_VER] = 200;   // v2/v3/v4 marker (Lua decides format from gmem state)
  // Distinct completion signal (2026-07-09): 84 = silent undo-dump ready (bridge
  // acks 85, LOCK-preserving), 1 = user-save ready (bridge acks 99). Both land in
  // the state-3 waiter below; the split just removes the CMD-1 ambiguity.
  // ─── S3c: the step sequencer's patterns -> the EON_SEQ_KIT band, the kit's tail record 7 -- published in @block
  // (the walk's thread owns the patterns; seq_kit_publish, right before the walk) the block after this frame asks,
  // and state 12 below hands the bus to the bridge once it is in. A bank-only save, or a bank B..D pass of the
  // whole-kit walk, carries none (2); the walk's final pass is bank A's and carries them (1). The count cell is
  // lowered first, so a stale record is never packed should no @block answer (the audio device closed).
  gmem[EON_SEQ_KIT_BASE + 2] = 0;
  seq_kit_pub_only = (kit_export_only > 0 || _ex_bank > 0) ? 1 : 0;
  seq_kit_pub_req += 1;   // the request counter: this thread's; @block answers in seq_kit_pub_ack, its own
  _ex_t12 = time_precise();
  kit_export_state = 12;
  kit_busy = 1;
);

kit_export_state == 12 ? (
  // Phase 2b (S3c): the sequencer's record is in (the @block publish's ack met the request), or a second passed with
  // no @block to answer: the bus goes to the bridge either way (the count cell says 0 then: no record).
  seq_kit_pub_ack == seq_kit_pub_req || time_precise() - _ex_t12 > 1 ? (
    gmem[KIT_GMEM_CMD] = _ex_is_dump ? 84 : 1;
    kit_export_state = 3;        // wait for bridge acknowledgment
  );
);

kit_export_state == 3 ? (
  // Phase 3: Wait for Lua script to save and acknowledge. Every exit clears
  // _ex_is_dump so the next cycle starts as a user-save unless a fresh CMD 83
  // re-arms it (the save-button handlers set state 10 directly, skipping the
  // state-1 clear — resetting here is the single-responsibility placement).
  // 99 = bridge wrote the file. The kit on disk now matches this state, so the
  // SAVE dot goes out (kit_dirty is set by mark_dirty_pad on every edit).
  // kit_saved_at feeds the SAVE button's transient "SAVED" flash. Stamped ONLY
  // here — the OTHER CMD 99 (import ack, ~:645) means "load landed" and runs on
  // @block; stamping that one would flash SAVED after every kit load.
  // A bank-only save (kit_export_only, audit S7) wrote one bank to its own file: the instrument is not saved, so
  // its dot stays and the SAVE button does not flash.
  // Every code below is taken only for this instance's save (swing_save_mine, above swing_ui_export_tick).
  gmem[KIT_GMEM_CMD] == 99 && swing_save_mine() ? (
    kit_export_state = 0; kit_busy = 0; _ex_is_dump = 0;
    kit_export_only == 0 ? ( kit_dirty = 0; kit_saved_at = time_precise(); );
    kit_export_only = 0;
    gmem[KIT_GMEM_LOCK] = 0; gmem[KIT_GMEM_CMD] = 0;
  );
  gmem[KIT_GMEM_CMD] == 98 && swing_save_mine() ? ( kit_export_state = 0; kit_busy = 0; _ex_is_dump = 0; kit_export_only = 0; gmem[KIT_GMEM_LOCK] = 0; gmem[KIT_GMEM_CMD] = 0; );
  // 85 = silent undo-dump ack: exit the export WITHOUT touching LOCK (a
  // pending kit-load may own it); restore kit_busy to its pre-dump value.
  gmem[KIT_GMEM_CMD] == 85 && swing_save_mine() ? ( kit_export_state = 0; kit_busy = _ex_undo_busy_prev; _ex_is_dump = 0; kit_export_only = 0; gmem[KIT_GMEM_CMD] = 0; );
  // 93 = dump another bank (Pad Banks step 3b, 2026-09-23): the bridge has read what the state-11 dump
  // just published and set GS_KIT_EXPORT_BANK to the next bank; re-enter state 11 inside the SAME save
  // transaction (kit_busy up, _ex_is_dump kept), so the completion code stays 1 or 84 and the final 99 / 85
  // still closes it. Below bridge level 323 LOCK is NOT held through it (the bridge's self-heal clears it on the
  // CMD-0 gap this consume opens); the owner cell is. An older bridge never sends 93.
  // From bridge level 323 (RR-1) the 93 STAYS on the bus until state 12 writes this dump's 1 / 84 over it: the CMD-0
  // gap the consume opened let any other command land mid-save -- another Swing's, a Lua action's, the bridge's own
  // queued load (CMD 3 staged into the bands this save reads) -- and state 12 then wrote the 1 over it and it was lost.
  // A 323 bridge ends a 93 nobody answers (eon_save_dead_tick); below it the consume writes 0, as before.
  gmem[KIT_GMEM_CMD] == 93 && swing_save_mine() ? (
    gmem[GS_BRIDGE_LEVEL] < BRIDGE_LEVEL_SAVE_TXN ? ( gmem[KIT_GMEM_CMD] = 0; );
    kit_export_state = 11;
  );
);
);

