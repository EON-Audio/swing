desc:rk_synthdrums — Swing synth-layer engine library (shared, rk_syn_*)
// ============================================================================
// rk_synthdrums.jsfx-inc — per-pad drum-synth engines for the Swing SYN slot.
// Spec: .docs/specs/Spec_Swing_Synth_Layer.md (§2.4 API, §3 engine lineup).
// Probe-proven foundations (.dev_tests/synthlayer_probe.jsfx, all gates PASS
// 2026-07-29): LUT sine −130 dB / LUT exp −84 dB / LUT tanh −92 dB nulls vs
// transcendentals; Simper SVF −160 dB vs DD-101 lineage; Park-Miller ≡ rand()
// statistically; control-rate-16 swept coefficients −111 dB vs per-sample tan.
// The engines are the DD-101 parity ports (PARITY PORT LAYER below); the
// first-generation engines and their ear rulings (CYM 2-op FM, HAT 2-op PM)
// were retired 2026-08-12. The hat IS DD-101's square stack, and family 4
// (the old CYM slot) is the ride.
//
// LICENSES (ship these notices): engine voicings adapted from Saike DD-101
// "Dum Drums" (c) 2022 Joep Vanlier, MIT (github.com/JoepVanlier/JSFX,
// saikedrums v0.18 — ported from upstream, never Tukan's renamed copy).
// The full MIT text ships in Scripts' THIRD_PARTY_NOTICES.md.
// Thanks to TiaR (T. Rochebois, ReaTeam's 2op PM Synth) for the 2-op PM idea
// behind the retired first-generation hat. None of his code is here: a line and
// constant scan against his installed files found nothing shared (2026-10-29),
// and his files state no licence. Quality references: Mutable Plaits drums
// (c) Emilie Gillet, MIT; no Plaits code either.
//
// HOUSE RULES (audit-jsfx enforced): no transcendentals in @sample-rate code —
// all tan()/exp()/pow() happen in rk_syn_*_set/reset (trigger rate) or the
// @init LUT build. State is FLAT MEMORY (caller-owned freemem blocks), not EEL
// instances — Swing voices are memory slots.
//
// API (spec §2.4):
//   freemem = rk_syn_init(freemem);                     // @init once: LUTs
//   rk_syn_reset(engine, st, mac, tune, vel);           // trigger rate
//   out = rk_syn_tick(st);                              // per sample
// st  = RK_SYN_STATE_SIZE-cell voice state block (Swing's core zeroes the whole
//       block on EVERY launch, before rk_syn_reset -- launch_syn_for_pad)
// mac = RK_SYN_MACROS-cell macro block, each 0..1 (engine-interpreted, §3)
// tune = pad tune in semitones (0 = engine default pitch); vel = 0..1
// ============================================================================

@init

// Family ids 0..5 (the first-generation spec §3 rows). The live encoding is
// family + 10 * type, families 0..8 (see ENGINE DISPATCH, rk_syn_reset): these
// six are type 0 of families 0..5, and 4 is now the RIDE. Nothing in the plugin
// reads these names (the dispatch, LCD and synth view use the literal numbers);
// the dev probes do (synthlayer_probe.jsfx, EON_Probe_SrateSwitch).
RK_SYN_KICK  = 0;
RK_SYN_SNARE = 1;
RK_SYN_CLAP  = 2;
RK_SYN_HAT   = 3;
RK_SYN_CYM   = 4;
RK_SYN_TOM   = 5;

RK_SYN_MACROS     = 8;
RK_SYN_STATE_SIZE = 256;  // Spec_Synthdrums_Parity §5.3. Sized ONCE for the
                          // worst DD-101 family with a NON-OVERLAPPING layout,
                          // so no family ever needs a second bump and no engine
                          // has to union regions (union layouts are exactly how
                          // one-past-end aliasing bugs happen).
                          // measured: dd_kick 92, dd_snare 170 (63 of them the
                          // type-0 9-bandpass bank, 46 the freq shifter); the
                          // largest is the ride, 232 (RK_DDR_CELLS). rk_syn_reset
                          // keeps st[0..1] (family, seed), so an engine gets 254.
                          // Cost: Swing claims V_SLOTS * 256 = 132 * 256 =
                          // 33,792 cells (~264 KB), plus the preview's one block.

// ── DD-101 parity: his global scaling terms (saikedrums.jsfx:663-664) ──────
// max(1, srate) because srate has been reported as 0 in @init (Geraint Luff's
// ui-lib works around it: @gfx defined + UI displaying + an earlier FX holding
// pdc_delay). Unconfirmed here, but both of these are LATCHED -- computed once
// and read by every voice builder below as globals recomputed only by rk_dd_srate_init,
// so one inf at @init would ride in every voice until the next re-init.
// Re-run by swing_block_handle_srate_change after a rate change: ext_noinit = 1
// makes @init one-shot, so both used to stay at the load-time rate (A-6).
function rk_dd_srate_init() (
  rk_dd_sample_ratio = 48000 / max(1, srate);
  rk_dd_time_factor  = 2302.58509299 / max(1, srate);  // his comment: -ln(0.1)*1000,
                                                       // because he works in ms
);
rk_dd_srate_init();

// LUT geometry (probe-proven accuracies at these sizes)
RK_SYN_LUTN   = 4096;     // sine, extended +quarter for cos
RK_SYN_LUTQ   = 1024;
RK_SYN_EXPN   = 2048;     // exp over [RK_SYN_EXPMIN, 0]
RK_SYN_EXPMIN = -8;
RK_SYN_TANHN  = 1024;     // tanh over [-RK_SYN_TANHR, RK_SYN_TANHR]
RK_SYN_TANHR  = 8;

// flat-block layouts. These *_CELLS sizes (and each engine's RK_DD*_CELLS
// below) are layout documentation: no plugin code reads them; the dev probes
// read a few (RK_SYN_SVF_CELLS, RK_DDK_CELLS, RK_DD_SHIFT_CELLS).
RK_SYN_SVF_CELLS  = 7;    // g k a1 a2 a3 ic1 ic2
RK_SYN_BELL_CELLS = 8;    // g k a1 a2 a3 m1 ic1 ic2

// ── one-time LUT construction: freemem = rk_syn_init(freemem) ──────────────
function rk_syn_init(mem)
local(i, x)
global(rk_syn_sinlut, rk_syn_explut, rk_syn_tanhlut,
       RK_SYN_LUTN, RK_SYN_LUTQ, RK_SYN_EXPN, RK_SYN_EXPMIN,
       RK_SYN_TANHN, RK_SYN_TANHR)
(
  rk_syn_sinlut = mem; mem += RK_SYN_LUTN + RK_SYN_LUTQ + 2;
  i = 0;
  loop(RK_SYN_LUTN + RK_SYN_LUTQ + 2,
    rk_syn_sinlut[i] = sin(2 * $pi * i / RK_SYN_LUTN);
    i += 1;
  );
  rk_syn_explut = mem; mem += RK_SYN_EXPN + 2;
  i = 0;
  loop(RK_SYN_EXPN + 2,
    rk_syn_explut[i] = exp(RK_SYN_EXPMIN + (-RK_SYN_EXPMIN) * i / RK_SYN_EXPN);
    i += 1;
  );
  rk_syn_tanhlut = mem; mem += RK_SYN_TANHN + 2;
  i = 0;
  loop(RK_SYN_TANHN + 2,
    x = (i / RK_SYN_TANHN) * 2 * RK_SYN_TANHR - RK_SYN_TANHR;
    rk_syn_tanhlut[i] = 2 / (1 + exp(-2 * x)) - 1;
    i += 1;
  );
  mem;
);

// ── sample-rate-safe primitives (no transcendentals) ───────────────────────
function rk_syn_lut_sin(ph)
local(f, fi, i0)
global(rk_syn_sinlut, RK_SYN_LUTN)
(
  f = ph - floor(ph);
  fi = f * RK_SYN_LUTN;
  i0 = fi|0;
  fi -= i0;
  rk_syn_sinlut[i0] * (1 - fi) + rk_syn_sinlut[i0 + 1] * fi;
);

function rk_syn_lut_cos(ph)
local(f, fi, i0)
global(rk_syn_sinlut, RK_SYN_LUTN, RK_SYN_LUTQ)
(
  f = ph - floor(ph);
  fi = f * RK_SYN_LUTN;
  i0 = (fi|0) + RK_SYN_LUTQ;
  fi -= fi|0;
  rk_syn_sinlut[i0] * (1 - fi) + rk_syn_sinlut[i0 + 1] * fi;
);

function rk_syn_lut_exp(x)
local(fi, i0)
global(rk_syn_explut, RK_SYN_EXPN, RK_SYN_EXPMIN)
(
  x <= RK_SYN_EXPMIN ? rk_syn_explut[0] :
  x >= 0 ? 1 : (
    fi = (x - RK_SYN_EXPMIN) * (RK_SYN_EXPN / (-RK_SYN_EXPMIN));
    i0 = fi|0;
    fi -= i0;
    rk_syn_explut[i0] * (1 - fi) + rk_syn_explut[i0 + 1] * fi;
  );
);

function rk_syn_lut_tanh(x)
local(fi, i0)
global(rk_syn_tanhlut, RK_SYN_TANHN, RK_SYN_TANHR)
(
  x >  RK_SYN_TANHR ? 1 :
  x < -RK_SYN_TANHR ? -1 : (
    fi = (x + RK_SYN_TANHR) * (RK_SYN_TANHN / (2 * RK_SYN_TANHR));
    i0 = fi|0;
    fi -= i0;
    rk_syn_tanhlut[i0] * (1 - fi) + rk_syn_tanhlut[i0 + 1] * fi;
  );
);

// Park-Miller PRNG on a caller-owned seed cell (per-voice determinism).
// sp[0] must be seeded nonzero at reset. Returns uniform (-1, 1).
function rk_syn_prng(sp)
global()
(
  sp[0] = (sp[0] * 16807) % 2147483647;
  sp[0] * (2 / 2147483647) - 1;
);

// ── flat Simper SVF: b[0..6] = g k a1 a2 a3 ic1 ic2 ────────────────────────
// _set variants use tan(): TRIGGER RATE ONLY (or control-rate ≥16-sample
// steps with linear g interp — probe-proven transparent at −111 dB).
// No engine calls rk_syn_svf_set any more (they use the state-preserving
// rk_syn_dd_*_keep setters); it stays for .dev_tests/synthlayer_probe.jsfx.
function rk_syn_svf_set(b, fc, invq)
local(g)
global(srate)
(
  fc = min(fc, srate * 0.49);
  g = tan($pi * fc / srate);
  b[0] = g;
  b[1] = invq;
  b[2] = 1 / (1 + g * (g + invq));
  b[3] = g * b[2];
  b[4] = g * b[3];
  b[5] = b[6] = 0;
);

function rk_syn_svf_bp(b, v0)
local(v1, v2, v3)
global()
(
  v3 = v0 - b[6];
  v1 = b[2] * b[5] + b[3] * v3;
  v2 = b[6] + b[3] * b[5] + b[4] * v3;
  b[5] = 2 * v1 - b[5];
  b[6] = 2 * v2 - b[6];
  v1;
);

function rk_syn_svf_lp(b, v0)
local(v1, v2, v3)
global()
(
  v3 = v0 - b[6];
  v1 = b[2] * b[5] + b[3] * v3;
  v2 = b[6] + b[3] * b[5] + b[4] * v3;
  b[5] = 2 * v1 - b[5];
  b[6] = 2 * v2 - b[6];
  v2;
);

function rk_syn_svf_hp(b, v0)
local(v1, v2, v3)
global()
(
  v3 = v0 - b[6];
  v1 = b[2] * b[5] + b[3] * v3;
  v2 = b[6] + b[3] * b[5] + b[4] * v3;
  b[5] = 2 * v1 - b[5];
  b[6] = 2 * v2 - b[6];
  v0 - b[1] * v1 - v2;
);

// ── flat bell: b[0..7] = g k a1 a2 a3 m1 ic1 ic2 ───────────────────────────
// (set by the state-preserving rk_syn_dd_bell_set_keep / _invq_keep below)
function rk_syn_bell(b, v0)
local(v1, v2, v3)
global()
(
  v3 = v0 - b[7];
  v1 = b[2] * b[6] + b[3] * v3;
  v2 = b[7] + b[3] * b[6] + b[4] * v3;
  b[6] = 2.0 * v1 - b[6];
  b[7] = 2.0 * v2 - b[7];
  v0 + b[5] * v1;
);


// ============================================================================
// ██ PARITY PORT LAYER (Spec_Synthdrums_Parity.md) ██
// Faithful 1:1 ports of DD-101 families, named rk_syn_dd_*. The first-
// generation rk_syn_<family>_* engines they replaced were retired 2026-08-12
// (spec §9.5) after the parity harness proved the ports.
//
// Adaptations vs his source, all justified in spec §7:
//   * LUT sin/exp/tanh instead of transcendentals (probe: -130/-84/-92 dB)
//   * flat memory instead of EEL instances (Swing voices are memory slots)
//   * Park-Miller instead of rand()  -> NOISE PATH CANNOT NULL SAMPLE-EXACT.
//     The gate runs a silent-noise arm for exact parity plus a separate
//     statistical arm (spec §6.4). Harness zeroes the noise gain on both sides.
//   * per-voice prev-output cell: his `local y` is shared across instances
//     (latent polyphony bug in his source); identical for a single voice.
//   * per-voice shifter init: his runs continuous phase across hits because
//     init_cheapest_freq_shifter is called once in reinit(); identical from a
//     fresh state, which is the null-test condition.
// ============================================================================

// ── his env_tick: one-multiply attack-then-decay ───────────────────────────
// e[0]=t  e[1]=k_rise  e[2]=k_decay  e[3]=attack_samples  e[4]=val
RK_DD_ENV_CELLS = 5;

function rk_syn_dd_env_set(e, k_rise, k_decay, attack_samples)
global()
(
  e[0] = 0;
  e[1] = k_rise;
  e[2] = k_decay;
  e[3] = attack_samples;
  e[4] = 0;
);

function rk_syn_dd_env_tick(e)
global()
(
  e[0] < e[3] ? (
    e[4] += e[1] * (1.0 - e[4]);
    e[0] += 1;
  ) : (
    e[4] -= e[2] * e[4];
  );
  e[4];
);

// ── his naiveTri (aliased by design - ported as-is for parity) ─────────────
function rk_syn_dd_naive_tri(t)
local(f)
global()
(
  f = t - floor(t);
  f <= 0.5 ? (4.0 * f - 1.0) : (3.0 - 4.0 * f);
);

// ── coefficient setters that PRESERVE filter state ─────────────────────────
// His init_linearSVF* / set_bell never touch ic1eq/ic2eq, and his kick filters
// are initialised once in reinit() rather than per trigger. Our rk_syn_svf_set
// zeroes state, which would be a deviation. These variants do not.
function rk_syn_dd_svf_set_norm_keep(b, freq, res)
local(f0, g, k)
global()
(
  f0 = min(exp((1 - freq) * log(20 / 22050)), 0.98);
  g = tan(0.5 * $pi * f0);
  k = 2 - 2 * res;
  b[0] = g;
  b[1] = k;
  b[2] = 1 / (1 + g * (g + k));
  b[3] = g * b[2];
  b[4] = g * b[3];
);

// his init_linearSVF_invq(raw_freq, invq): raw Hz, k = invq directly, and it
// clamps at hsrate (srate/2) - NOT our house 0.49*srate. Matched exactly.
function rk_syn_dd_svf_set_keep(b, fc, invq)
local(g)
global(srate)
(
  fc = min(fc, 0.5 * srate);
  g = tan($pi * fc / srate);
  b[0] = g;
  b[1] = invq;
  b[2] = 1 / (1 + g * (g + invq));
  b[3] = g * b[2];
  b[4] = g * b[3];
);

function rk_syn_dd_bell_set_keep(b, fc, q, gain)
local(a, g, k)
global(srate)
(
  a = pow(10, gain / 40);
  g = tan($pi * fc / srate);
  k = 1.0 / (q * a);
  b[0] = g;
  b[1] = k;
  b[2] = 1.0 / (1.0 + g * (g + k));
  b[3] = g * b[2];
  b[4] = g * b[3];
  b[5] = k * (a * a - 1.0);
);

// ── his cheapest freq shifter (saikedrums_freq_shift.jsfx-inc) ─────────────
// s[0..13] = osc_coeff_t1 osc_coeff_t2 cos_t1_1 cos_t1_2 sin_t1_1 sin_t1_2
//            cos_t2_1 cos_t2_2 sin_t2_1 sin_t2_2 t1 t2 dt1 dt2
// s[14..29] = elliptical filter 1 state (16)   s[30..45] = filter 2 state (16)
RK_DD_SHIFT_CELLS = 46;

function rk_syn_dd_shift_set(s, shift)
local(w)
global(srate, rk_dd_sample_ratio)
(
  // The +0.001 term is his, comment: "because of mistakes of the past"
  s[12] = 2.0 * $pi * (0.250 + 0.001 * rk_dd_sample_ratio);
  s[13] = s[12] + 2.0 * $pi * shift / srate;
  s[10] = 0; s[11] = 0;

  w = s[12];
  s[0] = 2.0 * cos(w);
  s[10] += w;
  s[2] = sin(-w + s[10]);
  s[3] = sin(-2.0 * w + s[10]);
  s[4] = -cos(-w + s[10]);
  s[5] = -cos(-2.0 * w + s[10]);
  s[10] -= w;

  w = s[13];
  s[1] = 2.0 * cos(w);
  s[11] += w;
  s[6] = sin(-w + s[11]);
  s[7] = sin(-2.0 * w + s[11]);
  s[8] = -cos(-w + s[11]);
  s[9] = -cos(-2.0 * w + s[11]);
  s[11] -= w;
);

// 16th-order elliptical at 0.25 - his quick_ellip, transposed direct form II.
// e = 16-cell state block.
function rk_syn_dd_ellip(e, x)
local(y)
global()
(
  y     = 0.03974403712835188 * x + e[0];
  e[0]  = 0.11443117839583584 * x - -1.2209793606380654  * y + e[1];
  e[1]  = 0.4102732984609602  * x -  6.918940386446262   * y + e[2];
  e[2]  = 0.8255281436307241  * x - -7.438409047076798   * y + e[3];
  e[3]  = 1.6689828207164152  * x -  20.47654014058037   * y + e[4];
  e[4]  = 2.5256753272317622  * x - -19.21733444638215   * y + e[5];
  e[5]  = 3.6193770241123127  * x -  33.69411950162771   * y + e[6];
  e[6]  = 4.250403515943048   * x - -27.235417392156258  * y + e[7];
  e[7]  = 4.641846929462009   * x -  33.46680351213294   * y + e[8];
  e[8]  = 4.25040351594302    * x - -22.8021725145997    * y + e[9];
  e[9]  = 3.6193770241123016  * x -  20.29444701618275   * y + e[10];
  e[10] = 2.525675327231766   * x - -11.231790923026374  * y + e[11];
  e[11] = 1.6689828207164181  * x -  7.173357397659418   * y + e[12];
  e[12] = 0.8255281436307251  * x - -2.9956603900306376  * y + e[13];
  e[13] = 0.41027329846095995 * x -  1.2866484319363045  * y + e[14];
  e[14] = 0.11443117839583594 * x - -0.3305293493933626  * y + e[15];
  e[15] = 0.0397440371283519  * x -  0.07745428581611816 * y;
  y;
);

function rk_syn_dd_shift_tick(s, x)
local(ct1, st1, ct2, st2)
global()
(
  s[10] += s[12];
  s[11] += s[13];

  ct1 = s[0] * s[2] - s[3];  s[3] = s[2];  s[2] = ct1;
  ct2 = s[1] * s[6] - s[7];  s[7] = s[6];  s[6] = ct2;
  st1 = s[0] * s[4] - s[5];  s[5] = s[4];  s[4] = st1;
  st2 = s[1] * s[8] - s[9];  s[9] = s[8];  s[8] = st2;

  2 * (rk_syn_dd_ellip(s + 14, x * ct1) * ct2
     + rk_syn_dd_ellip(s + 30, x * st1) * st2);
);

// ============================================================================
// DD-101 KICK — all 4 types. Ported from kick_reset (line 75) / kick_tick
// (line 2213) of saikedrums_drum_elements.jsfx-inc v0.18.
//
// Reset takes HIS RAW PARAMS, not macros - the macro layer wraps this once
// parity is proven (spec §4.1). Caller supplies:
//   ktype   = kick_type 0..3
//   kpdec   = kick_pitch_decay     0..1
//   kadec   = kick_amp_decay       0..1
//   knenv   = kick_noise_envelope  0..1
//   kenv    = kick_envelope        0..0.5   (his slider caps at 0.5)
//   kbottom = log((20 + 80*kick_tune) / 22050)    <- caller computes, as he does
//   fshift  = freq_shift 0|1
//
// state: 92 cells (top index 91). Layout in the RK_DDK_* constants below.
// ============================================================================
RK_DDK_PREVY  = 0;    // his shared `local y` -> per-voice here
RK_DDK_SEED   = 1;
RK_DDK_TOSC   = 2;
RK_DDK_TOSC2  = 3;
RK_DDK_SMOOTH = 4;
RK_DDK_NLEVEL = 5;
RK_DDK_NDECAY = 6;
RK_DDK_TYPE   = 7;
RK_DDK_ENV    = 8;    // kick_envelope latched
RK_DDK_BOTTOM = 9;    // kick_bottom latched
RK_DDK_SRATIO = 10;   // sample_ratio latched
RK_DDK_FSHIFT = 11;
RK_DDK_PENV   = 12;   // pitch env   5 cells -> 12..16
RK_DDK_AENV   = 17;   // amp env     5 cells -> 17..21
RK_DDK_AHIGH  = 22;   // amp k_high_decay (his kick_stop / choke): written, never read -- the stop path is not ported
RK_DDK_NBP    = 23;   // noise BP svf     7 -> 23..29
RK_DDK_MUD    = 30;   // mud_dip bell     8 -> 30..37
RK_DDK_CLICK  = 38;   // click_boost bell 8 -> 38..45
RK_DDK_SHIFT  = 46;   // freq shifter    46 -> 46..91
RK_DDK_CELLS  = 92;

function rk_syn_dd_kick_reset(st, ktype, kpdec, kadec, knenv, kenv, kbottom, fshift)
global(srate, rk_dd_time_factor, rk_dd_sample_ratio,
       RK_DDK_PREVY, RK_DDK_SEED, RK_DDK_TOSC, RK_DDK_TOSC2, RK_DDK_SMOOTH,
       RK_DDK_NLEVEL, RK_DDK_NDECAY, RK_DDK_TYPE, RK_DDK_ENV, RK_DDK_BOTTOM,
       RK_DDK_SRATIO, RK_DDK_FSHIFT, RK_DDK_PENV, RK_DDK_AENV, RK_DDK_AHIGH,
       RK_DDK_NBP, RK_DDK_MUD, RK_DDK_CLICK, RK_DDK_SHIFT)
(
  st[RK_DDK_TYPE]   = ktype;
  st[RK_DDK_ENV]    = kenv;
  st[RK_DDK_BOTTOM] = kbottom;
  st[RK_DDK_SRATIO] = rk_dd_sample_ratio;
  st[RK_DDK_FSHIFT] = fshift;

  // his: pitch.k_rise = time_factor * 0.5   ("2 ms rise time (1/3)")
  //      pitch.k_decay = time_factor * 0.33 * exp(-4.605170185988092 * kpdec)
  //      -4.605170185988092 == ln(0.01), so the exp term is 0.01^kpdec
  //      pitch.attack_samples = 0.01 * srate
  rk_syn_dd_env_set(st + RK_DDK_PENV,
    rk_dd_time_factor * 0.5,
    rk_dd_time_factor * 0.33 * exp(-4.605170185988092 * kpdec),
    0.01 * srate);

  // his: amp.k_rise = time_factor  ("1 ms rise time (1/3)")
  //      amp.k_decay = time_factor * 0.033 * 0.01^kadec
  //      amp.attack_samples = 0.04 * srate
  //      (his comment says "100 ms"; the code is 40 ms - the CODE is ported)
  rk_syn_dd_env_set(st + RK_DDK_AENV,
    rk_dd_time_factor,
    rk_dd_time_factor * 0.033 * exp(-4.605170185988092 * kadec),
    0.04 * srate);
  st[RK_DDK_AHIGH] = 4 * st[RK_DDK_AENV + 2];

  st[RK_DDK_NLEVEL] = 2;
  st[RK_DDK_NDECAY] = rk_dd_time_factor * 13 * exp(-4.605170185988092 * knenv);

  st[RK_DDK_TOSC]   = 0;
  st[RK_DDK_TOSC2]  = 0;
  st[RK_DDK_SMOOTH] = 5;
  st[RK_DDK_PREVY]  = 0;
  st[RK_DDK_SEED] <= 0 ? st[RK_DDK_SEED] = 77777;

  // his reinit(): coefficients only, state preserved (see spec §7)
  rk_syn_dd_svf_set_norm_keep(st + RK_DDK_NBP,   0.65, 0.75);
  rk_syn_dd_bell_set_keep    (st + RK_DDK_MUD,   480,  12.0, -50);
  rk_syn_dd_bell_set_keep    (st + RK_DDK_CLICK, 3413.3, 0.5, 6.3);
  fshift ? rk_syn_dd_shift_set(st + RK_DDK_SHIFT, 7);
);

function rk_syn_dd_kick_tick(st)
local(y, ly, e, tstep, nz)
global(RK_DDK_PREVY, RK_DDK_SEED, RK_DDK_TOSC, RK_DDK_TOSC2, RK_DDK_SMOOTH,
       RK_DDK_NLEVEL, RK_DDK_NDECAY, RK_DDK_TYPE, RK_DDK_ENV, RK_DDK_BOTTOM,
       RK_DDK_SRATIO, RK_DDK_FSHIFT, RK_DDK_PENV, RK_DDK_AENV,
       RK_DDK_NBP, RK_DDK_MUD, RK_DDK_CLICK, RK_DDK_SHIFT)
(
  ly = st[RK_DDK_PREVY];
  y  = 0;

  st[RK_DDK_TYPE] == 0 ? (
    tstep = 0.5 * rk_syn_lut_exp(
      (1 - st[RK_DDK_ENV] * rk_syn_dd_env_tick(st + RK_DDK_PENV)) * st[RK_DDK_BOTTOM]
    ) * st[RK_DDK_SRATIO];
    st[RK_DDK_TOSC] += tstep;
    y = rk_syn_dd_naive_tri(st[RK_DDK_TOSC]);
    y = 0.91 * (rk_syn_lut_tanh(2 * y + 0.1) - 0.1) + 0.1 * y;
    y *= rk_syn_dd_env_tick(st + RK_DDK_AENV);
    y = rk_syn_bell(st + RK_DDK_MUD, y);
    st[RK_DDK_FSHIFT] ? y = rk_syn_dd_shift_tick(st + RK_DDK_SHIFT, y);
  ) : st[RK_DDK_TYPE] == 1 ? (
    tstep = 0.5 * rk_syn_lut_exp(
      (1 - st[RK_DDK_ENV] * rk_syn_dd_env_tick(st + RK_DDK_PENV)) * st[RK_DDK_BOTTOM]
    ) * st[RK_DDK_SRATIO];
    st[RK_DDK_TOSC] += tstep;
    y = rk_syn_dd_naive_tri(st[RK_DDK_TOSC]) * rk_syn_dd_env_tick(st + RK_DDK_AENV);
    y = 0.91 * (rk_syn_lut_tanh(2 * y + 0.1) - 0.1) + 0.1 * y;
    y = rk_syn_bell(st + RK_DDK_MUD, y);
    st[RK_DDK_FSHIFT] ? y = rk_syn_dd_shift_tick(st + RK_DDK_SHIFT, y);
  ) : st[RK_DDK_TYPE] == 2 ? (
    tstep = 0.5 * rk_syn_lut_exp(
      (1 - st[RK_DDK_ENV] * rk_syn_dd_env_tick(st + RK_DDK_PENV)) * st[RK_DDK_BOTTOM]
    ) * st[RK_DDK_SRATIO];
    st[RK_DDK_TOSC] += tstep;
    y = rk_syn_dd_naive_tri(st[RK_DDK_TOSC]);
    y = rk_syn_lut_tanh(2 * y) * rk_syn_dd_env_tick(st + RK_DDK_AENV);
    st[RK_DDK_FSHIFT] ? y = rk_syn_dd_shift_tick(st + RK_DDK_SHIFT, y);
    y = rk_syn_bell(st + RK_DDK_MUD, y);
    y = rk_syn_bell(st + RK_DDK_CLICK, y);
  ) : st[RK_DDK_TYPE] == 3 ? (
    e = rk_syn_dd_env_tick(st + RK_DDK_PENV);
    tstep = 0.5 * rk_syn_lut_exp((1 - st[RK_DDK_ENV] * e) * st[RK_DDK_BOTTOM])
          * st[RK_DDK_SRATIO];
    y = rk_syn_lut_sin(st[RK_DDK_TOSC]) * rk_syn_dd_env_tick(st + RK_DDK_AENV);

    st[RK_DDK_TOSC2] += 8 * tstep;
    st[RK_DDK_TOSC]  += tstep
      + 0.001 * e * rk_syn_lut_sin(st[RK_DDK_TOSC2]) * st[RK_DDK_SRATIO];
    st[RK_DDK_FSHIFT] ? y = y + rk_syn_dd_shift_tick(st + RK_DDK_SHIFT,
                                  (rk_syn_lut_tanh(2 * y) - y) * 0.5);
    y = rk_syn_bell(st + RK_DDK_CLICK, y);
  );

  // noise layer - his: noise_level -= noise_decay*noise_level;
  //                    y += eval_linearSVF_BP(noise_level * (rand() - 0.5))
  // ours: Park-Miller returns (-1,1), so *0.5 matches his (rand()-0.5) range
  st[RK_DDK_NLEVEL] -= st[RK_DDK_NDECAY] * st[RK_DDK_NLEVEL];
  nz = rk_syn_prng(st + RK_DDK_SEED) * 0.5;
  y += rk_syn_svf_bp(st + RK_DDK_NBP, st[RK_DDK_NLEVEL] * nz);

  // his 5-sample soft start
  st[RK_DDK_SMOOTH] > 0 ? (
    st[RK_DDK_SMOOTH] -= 1;
    y = 0.9 * ly + 0.1 * y;
  );

  st[RK_DDK_PREVY] = y;
  y;
);

// uniform [0,1) from a caller-owned Park-Miller seed - his rand() equivalent
function rk_syn_dd_rand01(sp)
global()
(
  (rk_syn_prng(sp) + 1) * 0.5;
);

// ============================================================================
// DD-101 SNARE — all 4 types. Ported from snare1_reset (130) / snare1_tick
// (174) / snare_reset (205) / snare_tick (257) of drum_elements v0.18.
//
// ⚠️ TYPE 0 IS A DIFFERENT ENGINE (his snare1_*): a 9-bandpass resonant model
// whose rand() calls are EMBEDDED INLINE in six separate expressions, summed
// with the deterministic excitation *before* the filters. There is no single
// noise gain to silence, so type 0 CANNOT be exact-nulled. It is verified by
// coefficient-level comparison (every envelope constant + all 9 filter
// coefficient sets) plus a statistical arm. Types 1-3 gate the normal way:
// their noise passes through one env, so zeroing that env's k_rise and val
// silences it on both sides.
//
// ⚠️ `snare_bottom` is TWO different quantities in his source. Global (types
// 1-3) = log((170+230*snare_tune)/22050), used in the pitch envelope. The
// LOCAL in snare1_reset = 170+230*snare_tune, raw Hz, used for filter
// frequencies, and it SHADOWS the global. Ported as two separate arguments.
//
// ⚠️ His slider is snare_type=1<0,4,1> - five positions - but reset, the stop
// dispatch and tick all branch only on 0..3. Position 4 is a DEAD slider
// position in DD-101; deliberately not replicated (spec §3.1).
//
// state: 170 cells (top index 169).
// ============================================================================
RK_DDS_PREVY  = 0;
RK_DDS_SEED   = 1;
RK_DDS_TYPE   = 2;
RK_DDS_ENVEL  = 3;    // snare_envelope latched
RK_DDS_BOTTOM = 4;    // global snare_bottom (log form) latched
RK_DDS_SRATIO = 5;
RK_DDS_FSHIFT = 6;
RK_DDS_TOSC   = 7;
RK_DDS_TOSC2  = 8;
RK_DDS_SMOOTH = 9;
RK_DDS_PENV   = 10;   // pitch env   5 -> 10..14
RK_DDS_NENV   = 15;   // noise env   5 -> 15..19
RK_DDS_AENV   = 20;   // amp env     5 -> 20..24
RK_DDS_NFAST  = 25;   // noise.fast_decay: stored for the parity harness, never read (no stop path is ported)
RK_DDS_NVOL   = 26;   // noise.vol (type 0)
// -- type 0 punch system --
RK_DDS_PST    = 27;   // punch.state
RK_DDS_PST2   = 28;
RK_DDS_PST3   = 29;
RK_DDS_PAFAST = 30;   // punch.attack_fast
RK_DDS_PTWACK = 31;
RK_DDS_PATK   = 32;
RK_DDS_PK     = 33;
RK_DDS_PK2    = 34;
RK_DDS_PK3    = 35;
RK_DDS_PKATK  = 36;
RK_DDS_PKATKF = 37;   // punch.k_atk_fast
RK_DDS_PPDEC  = 38;   // punch.pitch_decay (his reset sets it; tick never reads)
// -- type 0 filter bank, in his declaration order: bp bp8 bp2 bp3 bp4 bp5
//    bp6 bp7 bp9. 9 x RK_SYN_SVF_CELLS = 63 -> 39..101
RK_DDS_BP     = 39;
RK_DDS_BP8    = 46;
RK_DDS_BP2    = 53;
RK_DDS_BP3    = 60;
RK_DDS_BP4    = 67;
RK_DDS_BP5    = 74;
RK_DDS_BP6    = 81;
RK_DDS_BP7    = 88;
RK_DDS_BP9    = 95;
// -- types 1/2/3 --
RK_DDS_THIS   = 102;  // the snare instance's own SVF (noise BP)  102..108
RK_DDS_MUD    = 109;  // mud_dip bell                            109..116
RK_DDS_CLAP   = 117;  // his snare.clap SVF                      117..123
RK_DDS_SHIFT  = 124;  // freq shifter (12.5 Hz)                  124..169
RK_DDS_CELLS  = 170;

function rk_syn_dd_snare_reset(st, stype, sdecay, sadec, sndec, senv, sbottom,
                               stune, fshift)
local(t_s, sb, nd)
global(srate, rk_dd_time_factor, rk_dd_sample_ratio,
       RK_DDS_PREVY, RK_DDS_SEED, RK_DDS_TYPE, RK_DDS_ENVEL, RK_DDS_BOTTOM,
       RK_DDS_SRATIO, RK_DDS_FSHIFT, RK_DDS_TOSC, RK_DDS_TOSC2, RK_DDS_SMOOTH,
       RK_DDS_PENV, RK_DDS_NENV, RK_DDS_AENV, RK_DDS_NFAST, RK_DDS_NVOL,
       RK_DDS_PST, RK_DDS_PST2, RK_DDS_PST3, RK_DDS_PAFAST, RK_DDS_PTWACK,
       RK_DDS_PATK, RK_DDS_PK, RK_DDS_PK2, RK_DDS_PK3, RK_DDS_PKATK,
       RK_DDS_PKATKF, RK_DDS_PPDEC,
       RK_DDS_BP, RK_DDS_BP8, RK_DDS_BP2, RK_DDS_BP3, RK_DDS_BP4, RK_DDS_BP5,
       RK_DDS_BP6, RK_DDS_BP7, RK_DDS_BP9,
       RK_DDS_THIS, RK_DDS_MUD, RK_DDS_CLAP, RK_DDS_SHIFT)
(
  st[RK_DDS_TYPE]   = stype;
  st[RK_DDS_ENVEL]  = senv;
  st[RK_DDS_BOTTOM] = sbottom;
  st[RK_DDS_SRATIO] = rk_dd_sample_ratio;
  st[RK_DDS_FSHIFT] = fshift;
  st[RK_DDS_PREVY]  = 0;
  st[RK_DDS_SEED] <= 0 ? st[RK_DDS_SEED] = 88888;

  // his reinit(): coefficients only, filter state preserved
  rk_syn_dd_svf_set_norm_keep(st + RK_DDS_THIS, 0.66, 0.2);
  rk_syn_dd_svf_set_norm_keep(st + RK_DDS_CLAP, 0.65, 0.432);
  rk_syn_dd_bell_set_keep(st + RK_DDS_MUD, 480, 12.0, -50);
  fshift ? rk_syn_dd_shift_set(st + RK_DDS_SHIFT, 12.5);

  stype == 0 ? (
    // ── his snare1_reset ──
    t_s = 0.015 * (0.2 + 1.3 * sdecay);

    st[RK_DDS_PST]    = 1;
    st[RK_DDS_PST2]   = 1;
    st[RK_DDS_PST3]   = 1;
    st[RK_DDS_PAFAST] = 1;
    st[RK_DDS_PTWACK] = 66.6666 * senv;
    st[RK_DDS_PATK]   = 1;

    st[RK_DDS_PK]     = pow(10, -24 / (20 * t_s * srate));
    st[RK_DDS_PK2]    = pow(10, -24 / (30 * t_s * srate));
    st[RK_DDS_PK3]    = pow(10, -24 / (30 * 5 * t_s * srate));
    st[RK_DDS_PKATK]  = pow(10, -24 / (20 * 0.015 * 0.5 * srate));
    // ⚠️ his division by (1 - snare_amp_decay) blows up at sadec == 1, and
    // the A.DEC macro arrives here unclamped, so a knob at full turn reaches
    // it (audit 2026-09-04). Below 1 the attack coefficient climbs towards 1
    // (the LONGEST decay); at exactly 1 the divide goes to zero and the
    // coefficient collapses to 0 (the SHORTEST) -- a cliff at the last
    // pixel. Clamp just under 1 so full turn holds the longest decay the
    // knob was heading for, continuous with 0.999.
    st[RK_DDS_PKATKF] = pow(10, -24 / (20 * t_s * srate * (1.0 - min(sadec, 0.999))));
    st[RK_DDS_PPDEC]  = pow(10, -24 / (20 * 0.5 * srate));

    nd = sndec + 0.8;                       // his in-place param mutation
    st[RK_DDS_NVOL]  = 0.4 + 0.6 * sdecay;
    st[RK_DDS_NFAST] = rk_dd_time_factor * 0.4
                     * exp(-4.605170185988092 * (0.5 + sdecay * 0.4)) * 2;
    rk_syn_dd_env_set(st + RK_DDS_NENV,
      rk_dd_time_factor * 0.006,
      rk_dd_time_factor * 0.4 * exp(-4.605170185988092 * (0.5 + sdecay * 0.4)),
      0.07 * nd * srate);

    sb = 170 + 230 * stune;                 // raw Hz - the LOCAL snare_bottom
    rk_syn_dd_svf_set_keep(st + RK_DDS_BP,  sb,          0.03 + (1 - sdecay));
    rk_syn_dd_svf_set_keep(st + RK_DDS_BP8, sb * 1.05,   0.03);
    rk_syn_dd_svf_set_keep(st + RK_DDS_BP2, 1.25 * sb,   0.05 + 0.02 * (1 - sdecay));
    rk_syn_dd_svf_set_keep(st + RK_DDS_BP3, 1.4 * sb,    0.04);
    rk_syn_dd_svf_set_keep(st + RK_DDS_BP4, 1.575 * sb,  0.04 + 0.02 * (1 - sdecay));
    rk_syn_dd_svf_set_keep(st + RK_DDS_BP5, 2.15 * sb,   0.03 + 0.02 * (1 - sdecay));
    rk_syn_dd_svf_set_keep(st + RK_DDS_BP6, 7000,        1.4);
    rk_syn_dd_svf_set_keep(st + RK_DDS_BP7, 4000,        0.8);
    rk_syn_dd_svf_set_keep(st + RK_DDS_BP9, 700,         0.8);
  ) : (
    // ── his snare_reset, types 1/2/3 ──
    rk_syn_dd_env_set(st + RK_DDS_PENV,
      rk_dd_time_factor * (1/2),
      rk_dd_time_factor * 0.933 * exp(-4.605170185988092 * sdecay),
      0.01 * srate);

    st[RK_DDS_NFAST] = 2 * rk_dd_time_factor * 0.4
                     * exp(-4.605170185988092 * (0.6 + sndec * 0.3));
    rk_syn_dd_env_set(st + RK_DDS_NENV,
      rk_dd_time_factor * (1/1),
      rk_dd_time_factor * 0.4 * exp(-4.605170185988092 * (0.6 + sndec * 0.3)),
      0.08 * sndec * srate);

    rk_syn_dd_env_set(st + RK_DDS_AENV,
      rk_dd_time_factor * (1/1),
      rk_dd_time_factor * 0.33 * exp(-4.605170185988092 * sadec),
      0.04 * srate);        // his comment says 100 ms; the CODE is 40 ms

    st[RK_DDS_TOSC]   = 0;
    st[RK_DDS_TOSC2]  = 0;
    st[RK_DDS_SMOOTH] = 5;
  );
);

// his snare1_tick - type 0 only
function rk_syn_dd_snare1_tick(st)
local(y, ne, af, s3)
global(RK_DDS_SEED, RK_DDS_NENV, RK_DDS_NVOL,
       RK_DDS_PST, RK_DDS_PST2, RK_DDS_PST3, RK_DDS_PAFAST, RK_DDS_PTWACK,
       RK_DDS_PATK, RK_DDS_PK, RK_DDS_PK2, RK_DDS_PK3, RK_DDS_PKATK,
       RK_DDS_PKATKF,
       RK_DDS_BP, RK_DDS_BP8, RK_DDS_BP2, RK_DDS_BP3, RK_DDS_BP4, RK_DDS_BP5,
       RK_DDS_BP6, RK_DDS_BP7, RK_DDS_BP9)
(
  s3 = st[RK_DDS_PST3];
  y = 0.7 * (1.0 - st[RK_DDS_PAFAST]) * (
    0.27 * rk_syn_svf_bp(st + RK_DDS_BP,  s3) +
    0.60 * rk_syn_svf_bp(st + RK_DDS_BP8, s3 + rk_syn_dd_rand01(st + RK_DDS_SEED) - 0.5) * s3 +
    0.11 * rk_syn_svf_bp(st + RK_DDS_BP2, s3) +
    0.15 * rk_syn_svf_bp(st + RK_DDS_BP3, st[RK_DDS_PST2] + rk_syn_dd_rand01(st + RK_DDS_SEED) - 0.5) * s3 +
    0.14 * rk_syn_svf_bp(st + RK_DDS_BP4, s3) +
    0.12 * rk_syn_svf_bp(st + RK_DDS_BP5, s3)
  );

  st[RK_DDS_PTWACK] *= st[RK_DDS_PKATK];
  st[RK_DDS_PATK]   *= st[RK_DDS_PKATK];
  st[RK_DDS_PAFAST] *= st[RK_DDS_PKATKF];
  st[RK_DDS_PST]    *= st[RK_DDS_PK];
  st[RK_DDS_PST2]   *= st[RK_DDS_PK2];
  st[RK_DDS_PST3]   *= st[RK_DDS_PK3];

  ne = rk_syn_dd_env_tick(st + RK_DDS_NENV);
  af = st[RK_DDS_PAFAST];
  s3 = st[RK_DDS_PST3];

  // ⚠️ (0.3 + rand() > 0.85) is ((0.3 + rand()) > 0.85) - EEL2 binds + above >.
  // A gated noise burst, not an offset. Ported with explicit parens.
  y += 0.5 * st[RK_DDS_NVOL] * ne * rk_syn_svf_bp(st + RK_DDS_BP6,
        (rk_syn_dd_rand01(st + RK_DDS_SEED) - 0.5)
        * ((0.3 + rk_syn_dd_rand01(st + RK_DDS_SEED)) > 0.85));

  y += 1.4 * ne * st[RK_DDS_NVOL] * rk_syn_svf_bp(st + RK_DDS_BP9,
        (rk_syn_dd_rand01(st + RK_DDS_SEED) - 0.5)
        * ((0.3 + rk_syn_dd_rand01(st + RK_DDS_SEED)) > 0.85)) * (s3 * s3);

  y += 2 * min(1.0, st[RK_DDS_PTWACK]) * st[RK_DDS_NVOL] * (1.0 - af)
     * (rk_syn_svf_lp(st + RK_DDS_BP7, rk_syn_dd_rand01(st + RK_DDS_SEED) * 2 - 1)
        + 0.3 * (rk_syn_dd_rand01(st + RK_DDS_SEED) * 2 - 1)) * st[RK_DDS_PATK];

  (4 * y) / (1 + abs(y + y));
);

function rk_syn_dd_snare_tick(st)
local(y, ly, tstep, ae, ne)
global(RK_DDS_PREVY, RK_DDS_SEED, RK_DDS_TYPE, RK_DDS_ENVEL, RK_DDS_BOTTOM,
       RK_DDS_SRATIO, RK_DDS_FSHIFT, RK_DDS_TOSC, RK_DDS_SMOOTH,
       RK_DDS_PENV, RK_DDS_NENV, RK_DDS_AENV,
       RK_DDS_THIS, RK_DDS_MUD, RK_DDS_CLAP, RK_DDS_SHIFT)
(
  ly = st[RK_DDS_PREVY];
  y  = 0;

  st[RK_DDS_TYPE] == 0 ? (
    y = rk_syn_dd_snare1_tick(st);
  ) : st[RK_DDS_TYPE] == 3 ? (
    tstep = 0.5 * rk_syn_lut_exp((1 - 0.4 * st[RK_DDS_ENVEL]
              * rk_syn_dd_env_tick(st + RK_DDS_PENV)) * st[RK_DDS_BOTTOM])
          * st[RK_DDS_SRATIO];
    st[RK_DDS_TOSC] += tstep;
    y = rk_syn_dd_naive_tri(st[RK_DDS_TOSC]);
    y *= 0.3 * rk_syn_dd_env_tick(st + RK_DDS_AENV);
    y += rk_syn_svf_bp(st + RK_DDS_THIS,
           rk_syn_dd_env_tick(st + RK_DDS_NENV)
           * (rk_syn_dd_rand01(st + RK_DDS_SEED) - 0.5));
    st[RK_DDS_SMOOTH] > 0 ? (st[RK_DDS_SMOOTH] -= 1; y = 0.9 * ly + 0.1 * y;);
    y = 2 * rk_syn_bell(st + RK_DDS_MUD, y);
  ) : st[RK_DDS_TYPE] == 1 ? (
    tstep = 0.5 * rk_syn_lut_exp((1 - 0.4 * st[RK_DDS_ENVEL]
              * rk_syn_dd_env_tick(st + RK_DDS_PENV)) * st[RK_DDS_BOTTOM])
          * st[RK_DDS_SRATIO];
    st[RK_DDS_TOSC] += tstep;
    y = rk_syn_dd_naive_tri(st[RK_DDS_TOSC]);
    y = 0.91 * (rk_syn_lut_tanh(2 * y + 0.1) - 0.1) + 0.1 * y;
    // his noise-retrigger jitter: noise.val < 0.4*rand() ? noise.t = 0
    st[RK_DDS_NENV + 4] < 0.4 * rk_syn_dd_rand01(st + RK_DDS_SEED) ?
      st[RK_DDS_NENV + 0] = 0;
    ae = rk_syn_dd_env_tick(st + RK_DDS_AENV);
    y += 2 * rk_syn_dd_env_tick(st + RK_DDS_NENV)
           * (rk_syn_dd_rand01(st + RK_DDS_SEED) - 0.5);
    st[RK_DDS_SMOOTH] > 0 ? (st[RK_DDS_SMOOTH] -= 1; y = 0.9 * ly + 0.1 * y;);
    y = rk_syn_bell(st + RK_DDS_MUD, rk_syn_svf_bp(st + RK_DDS_CLAP, y)) * ae;
  ) : st[RK_DDS_TYPE] == 2 ? (
    tstep = 0.5 * rk_syn_lut_exp((1 - 0.4 * st[RK_DDS_ENVEL]
              * rk_syn_dd_env_tick(st + RK_DDS_PENV)) * st[RK_DDS_BOTTOM])
          * st[RK_DDS_SRATIO];
    st[RK_DDS_TOSC] += tstep;
    y = rk_syn_dd_naive_tri(st[RK_DDS_TOSC]);
    y = 0.91 * (rk_syn_lut_tanh(2 * y + 0.1) - 0.1) + 0.1 * y;
    ne = rk_syn_dd_env_tick(st + RK_DDS_NENV);
    ae = rk_syn_dd_env_tick(st + RK_DDS_AENV);
    y *= 0.5 * ae * ne;
    // his nonlinear cross-coupling: noise scaled by (1 - amp_env*y*y)
    y += rk_syn_svf_bp(st + RK_DDS_THIS,
           ne * ne * (rk_syn_dd_rand01(st + RK_DDS_SEED) - 0.5))
         * (1 - ae * y * y);
    st[RK_DDS_SMOOTH] > 0 ? (st[RK_DDS_SMOOTH] -= 1; y = 0.9 * ly + 0.1 * y;);
    y = rk_syn_bell(st + RK_DDS_MUD, y);
    st[RK_DDS_FSHIFT] ? y = rk_syn_dd_shift_tick(st + RK_DDS_SHIFT, y);
  );

  st[RK_DDS_PREVY] = y;
  y;
);

// ── his band-limited square family (drum_elements 34-71) ──────────────────
function rk_syn_dd_poly_aa_sq(t, dt)
global()
(
  t < dt ? ( t /= dt; t + t - t * t - 1.0 ) :
  t > 1.0 - dt ? ( t = (t - 1.0) / dt; t * t + t + t + 1.0 ) : 0;
);

function rk_syn_dd_sqs(t)
global()
(
  2.0 * (t - floor(t) > 0.5) - 1.0;
);

function rk_syn_dd_sq(t, dt, duty)
local(phase, y)
global()
(
  phase = t - floor(t);
  y = 2.0 * (phase > duty) - 1.0;
  y - rk_syn_dd_poly_aa_sq(phase, dt)
    + rk_syn_dd_poly_aa_sq(phase + (1.0 - duty) - floor(phase + (1.0 - duty)), dt);
);

// ============================================================================
// DD-101 HAT — synth types 0, 1, 2. Ported from hat_reset (948) / hat_tick
// (1155) of drum_elements v0.18.
//
// ⚠️ TYPE 3 IS NOT A SYNTH ENGINE - it is `chan.start_sample()` /
// `chan.play_channel()`, his v0.18 custom-sample feature. Out of scope: Swing
// already has sample layers. Same applies to clap/ride/rim/shaker type 3.
//
// ⭐ TYPE 1 IS THE HARDWARE-MEASURED 808. His comments give the measured duty
// cycle (D = 47.98%) and oscillator frequencies (205.3 / 369.6 / 304.4 /
// 522.7 Hz). His slider is hat_type=0<0,1,1> - it DEFAULTS TO 0 and caps at 1,
// so type 2 is unreachable in his UI and the 808 was never the default sound.
//
// ⚠️ `k1_3_rel` divides by `israte` in types 0 and 2 but by `israte_with_decay`
// in type 1. Not a typo on our part - his source genuinely differs. Exactly the
// asymmetry a re-derivation would smooth away.
//
// ⚠️ OSCILLATOR PHASES t1..t13 ARE FREE-RUNNING - hat_reset never zeroes them,
// only the sample counter `t`. Each hit catches the bank at a different phase.
// Our reset leaves them alone too, but in Swing the core zeroes the whole voice
// block on EVERY launch (launch_syn_for_pad), so every hit starts the bank at
// phase 0 -- DD-101's hit-to-hit phase variety does not happen in Swing.
//
// ⚠️ `a1_2` carries a per-hit `(0.95 + 0.1*rand())` randomisation, so no two
// triggers are identical even in his engine. The harness pins it on both sides.
//
// NOISE: all three types use rand() inline.
//   type 1 - noise term is gated by `current_hat_body`; body=0 => exact null.
//   type 2 - every rand term carries sqr(s2); a2=0 => s2 stays 0 => exact null.
//   type 0 - metal2 adds a bare `0.0044*(rand()-0.5)` that nothing gates.
//            NO exact null possible; coefficient-level parity only (spec §6.4).
//
// state: 117 cells.
// ============================================================================
RK_DDH_T     = 0;    // sample counter (his `t`), reset per trigger
RK_DDH_SEED  = 1;
RK_DDH_TYPE  = 2;
RK_DDH_BODY  = 3;    // current_hat_body
RK_DDH_PH    = 4;    // t1..t13   -> 4..16   (FREE-RUNNING: the reset never zeroes them; Swing's launch memset does)
RK_DDH_DT    = 17;   // dt1..dt13 -> 17..29
// envelope blocks: [0]=s [1]=n [2]=k_atk [3]=k_rel [4]=a [5]=k_rel_fast
RK_DDH_E12   = 30;   // his s1_2 / n1_2 / k1_2_atk / k1_2_rel / a1_2
RK_DDH_E13   = 36;
RK_DDH_E2    = 42;
RK_DDH_E3    = 48;
RK_DDH_BP    = 54;
RK_DDH_BP2   = 61;
RK_DDH_BPS1  = 68;
RK_DDH_BPS2  = 75;
RK_DDH_BPS3  = 82;
RK_DDH_LP    = 89;
RK_DDH_HP1   = 96;
RK_DDH_HP2   = 103;
RK_DDH_HP3   = 110;
RK_DDH_CELLS = 117;

function rk_syn_dd_hat_reset(st, htype, closed, hattack, hdecay, htone, hbody)
local(af, df, idec, isr_dec, isr_tone, tc, open, d7)
global(srate, RK_DDH_T, RK_DDH_SEED, RK_DDH_TYPE, RK_DDH_BODY, RK_DDH_DT,
       RK_DDH_E12, RK_DDH_E13, RK_DDH_E2, RK_DDH_E3,
       RK_DDH_BP, RK_DDH_BP2, RK_DDH_BPS1, RK_DDH_BPS2, RK_DDH_BPS3,
       RK_DDH_LP, RK_DDH_HP1, RK_DDH_HP2, RK_DDH_HP3)
(
  st[RK_DDH_TYPE] = htype;
  st[RK_DDH_BODY] = hbody;
  st[RK_DDH_T]    = 0;                    // ⚠️ phases at RK_DDH_PH are NOT reset
  st[RK_DDH_SEED] <= 0 ? st[RK_DDH_SEED] = 66666;

  open     = 1 - closed;
  tc       = 2 * htone - 1;               // his tone_ctrl
  isr_tone = (1 / srate) * (0.8 + 0.4 * htone);

  d7 = 3392.9200658769764 * isr_tone;     // shared metal base, all types
  st[RK_DDH_DT + 6]  = d7;
  st[RK_DDH_DT + 7]  = d7 * 1.4471;
  st[RK_DDH_DT + 8]  = d7 * 1.6170;
  st[RK_DDH_DT + 9]  = d7 * 1.9265;
  st[RK_DDH_DT + 10] = d7 * 2.5028;
  st[RK_DDH_DT + 11] = d7 * 2.6637;

  htype == 1 ? (
    // ── the 808. Measured: duty 47.98%, oscillators 205.3/369.6/304.4/522.7
    rk_syn_dd_svf_set_keep(st + RK_DDH_BP,  3210,     0.17228);
    rk_syn_dd_svf_set_keep(st + RK_DDH_BP2, 6963.75,  0.21733);
    rk_syn_dd_svf_set_keep(st + RK_DDH_HP1, 2477.49,  1.04538744609);
    rk_syn_dd_svf_set_keep(st + RK_DDH_HP2, 8268.56,  1.16018963454 - 0.2 * hbody);
    rk_syn_dd_svf_set_keep(st + RK_DDH_HP3, 10433.49, 0.2170202297);
    st[RK_DDH_DT + 0] = 205.3 * isr_tone;
    st[RK_DDH_DT + 1] = 369.6 * isr_tone;
    st[RK_DDH_DT + 2] = 304.4 * isr_tone;
    st[RK_DDH_DT + 3] = 522.7 * isr_tone;
  ) : htype == 0 ? (
    rk_syn_dd_svf_set_keep(st + RK_DDH_BP,   6666,                  1/2);
    rk_syn_dd_svf_set_keep(st + RK_DDH_BPS1, 1529.49 + tc * 100,    0.04);
    rk_syn_dd_svf_set_keep(st + RK_DDH_BPS2, 988.49  + tc * 100,    0.05);
    rk_syn_dd_svf_set_keep(st + RK_DDH_BPS3, 3800.49 + tc * 1000,   0.05);
    rk_syn_dd_svf_set_keep(st + RK_DDH_BP2,  6963.75,               0.21733);
    rk_syn_dd_svf_set_keep(st + RK_DDH_LP,   3000.49,               1.14538744609);
    rk_syn_dd_svf_set_keep(st + RK_DDH_HP1,  2477.49,               1.04538744609);
    rk_syn_dd_svf_set_keep(st + RK_DDH_HP2,  8268.56,               1.16018963454);
    rk_syn_dd_svf_set_keep(st + RK_DDH_HP3,  10433.49,              0.2170202297);
    st[RK_DDH_DT + 0] = 1014.3 * isr_tone;
    st[RK_DDH_DT + 1] = 1529.6 * isr_tone;
    st[RK_DDH_DT + 2] = 3737.4 * isr_tone;
    st[RK_DDH_DT + 3] = 1491.7 * isr_tone;
    st[RK_DDH_DT + 5]  = 0.825 * d7;
    st[RK_DDH_DT + 4]  = 0.406 * d7;
    st[RK_DDH_DT + 12] = 0.106 * d7;
  ) : htype == 2 ? (
    rk_syn_dd_svf_set_keep(st + RK_DDH_BP,   5666,                  1.5);
    rk_syn_dd_svf_set_keep(st + RK_DDH_BPS1, 8529.49 + tc * 100,    0.2 - 0.18 * open);
    rk_syn_dd_svf_set_keep(st + RK_DDH_BPS2, 8388.49 + tc * 100,    0.2);
    rk_syn_dd_svf_set_keep(st + RK_DDH_BPS3, 8120.49 + tc * 1000,   0.68);
    rk_syn_dd_svf_set_keep(st + RK_DDH_BP2,  1100.75,               0.51733);
    rk_syn_dd_svf_set_keep(st + RK_DDH_LP,   11100.49,              0.7538744609 + 0.5 * open);
    rk_syn_dd_svf_set_keep(st + RK_DDH_HP1,  377.49,                0.034538744609 + 0.5 * open);
    rk_syn_dd_svf_set_keep(st + RK_DDH_HP2,  770.56 + 4000 * (1 - closed) + 50 * tc,
                                             0.056018963454 + 0.5 * open);
    rk_syn_dd_svf_set_keep(st + RK_DDH_HP3,  664.49,                0.020202297 + 0.5 * open);
    st[RK_DDH_DT + 0] = 5014.3 * isr_tone;
    st[RK_DDH_DT + 1] = 4429.6 * isr_tone;
    st[RK_DDH_DT + 2] = 5737.4 * isr_tone;
    st[RK_DDH_DT + 3] = 6491.7 * isr_tone;
    st[RK_DDH_DT + 5]  = 0.825 * d7;
    st[RK_DDH_DT + 4]  = 0.406 * d7;
    st[RK_DDH_DT + 12] = 0.106 * d7;
  );

  // ── the four fitted envelopes (his comment: "Best fit curves fitting to
  //    squared exponential curves (amplitude, attack, release)") ──
  af      = pow(10, hattack - 0.5);
  df      = pow(10, -(hdecay - 0.5));
  closed ? df = df * 2;                   // closed = same voice, double decay
  idec    = 1.0 / df;
  isr_dec = (1 / srate) * df;

  st[RK_DDH_E12 + 4] = 5.886297285230614
                     * (0.5 + (idec > 1.0 ? 1.0 : idec) * 0.5)
                     * (0.95 + 0.1 * rk_syn_dd_rand01(st + RK_DDH_SEED));
  st[RK_DDH_E12 + 1] = 0.13362501578292 * srate * af;
  st[RK_DDH_E12 + 2] = 7.264430222920869 / st[RK_DDH_E12 + 1];
  st[RK_DDH_E12 + 3] = 10 * 7.264430222920869 * isr_dec / 12.830314491926522;

  st[RK_DDH_E13 + 4] = 2.446983835532773;
  st[RK_DDH_E13 + 1] = 0.0013941882299170012 * srate * af;
  st[RK_DDH_E13 + 2] = 7.264430222920869 / st[RK_DDH_E13 + 1];
  // ⚠️ israte_with_decay for type 1, plain israte for types 0 and 2. His.
  st[RK_DDH_E13 + 3] = 7.264430222920869
                     * (htype == 1 ? isr_dec : (1 / srate))
                     / 11.784588871968632;

  st[RK_DDH_E2 + 4] = 5.112817165724925;
  st[RK_DDH_E2 + 1] = 0.023312507777462504 * srate * af;
  st[RK_DDH_E2 + 2] = 7.264430222920869 / st[RK_DDH_E2 + 1];
  st[RK_DDH_E2 + 3] = 7.264430222920869 * isr_dec / 2.082148383059353;

  st[RK_DDH_E3 + 4] = 13.459926564551697;
  st[RK_DDH_E3 + 1] = 0.0014790265731799877 * srate * af;
  st[RK_DDH_E3 + 2] = 7.264430222920869 / st[RK_DDH_E3 + 1];
  st[RK_DDH_E3 + 3] = 7.264430222920869 * isr_dec / 0.21747253516471457;

  // his *_rel_fast (hat_stop): stored for the parity harness only. His stop path
  // is not ported -- a Swing choke fades the voice with the core's generic
  // v_stage = 4 release -- so no tick reads these four.
  st[RK_DDH_E12 + 5] = st[RK_DDH_E12 + 3] * 9;
  st[RK_DDH_E13 + 5] = st[RK_DDH_E13 + 3] * 2;
  st[RK_DDH_E2  + 5] = st[RK_DDH_E2  + 3] * 2;
  st[RK_DDH_E3  + 5] = st[RK_DDH_E3  + 3] * 2;
);

