// rk_synthdrums_p2.jsfx-inc -- part 2 of rk_synthdrums.jsfx-inc (3 parts), cut at a function boundary by
// .dev_tests/split_big_incs.py: REAPER's load time grows with the square of a file's size. Edit freely;
// keep each file under about 40 KB.

// ⚠️ @init IS LOAD-BEARING (.docs/wiki/02-file-structure.md).
@init

function rk_syn_dd_hat_tick(st)
local(oscs, v1, v2, v3, metal2, metal3, nz, nz2, tt, s2s, out)
global(RK_DDH_T, RK_DDH_SEED, RK_DDH_TYPE, RK_DDH_BODY, RK_DDH_PH, RK_DDH_DT,
       RK_DDH_E12, RK_DDH_E13, RK_DDH_E2, RK_DDH_E3,
       RK_DDH_BP, RK_DDH_BP2, RK_DDH_BPS1, RK_DDH_BPS2, RK_DDH_BPS3,
       RK_DDH_LP, RK_DDH_HP1, RK_DDH_HP2, RK_DDH_HP3)
(
  out = 0;
  tt  = st[RK_DDH_T];

  st[RK_DDH_PH + 0] += st[RK_DDH_DT + 0];
  st[RK_DDH_PH + 1] += st[RK_DDH_DT + 1];
  st[RK_DDH_PH + 2] += st[RK_DDH_DT + 2];
  st[RK_DDH_PH + 3] += st[RK_DDH_DT + 3];

  st[RK_DDH_TYPE] == 2 ? (
    oscs = 0.4 * (rk_syn_dd_sq(st[RK_DDH_PH + 0], st[RK_DDH_DT + 0], 0.5)
                + rk_syn_dd_sq(st[RK_DDH_PH + 1], st[RK_DDH_DT + 1], 0.5))
         + rk_syn_dd_sq(st[RK_DDH_PH + 2], st[RK_DDH_DT + 2], 0.5)
         + rk_syn_dd_sq(st[RK_DDH_PH + 3], st[RK_DDH_DT + 3], 0.5);
  ) : (
    oscs = rk_syn_dd_sq(st[RK_DDH_PH + 0], st[RK_DDH_DT + 0], 0.5)
         + rk_syn_dd_sq(st[RK_DDH_PH + 1], st[RK_DDH_DT + 1], 0.5)
         + rk_syn_dd_sq(st[RK_DDH_PH + 2], st[RK_DDH_DT + 2], 0.5)
         + rk_syn_dd_sq(st[RK_DDH_PH + 3], st[RK_DDH_DT + 3], 0.5);
  );

  st[RK_DDH_PH + 6]  += st[RK_DDH_DT + 6];
  st[RK_DDH_PH + 7]  += st[RK_DDH_DT + 7];
  st[RK_DDH_PH + 8]  += st[RK_DDH_DT + 8];
  st[RK_DDH_PH + 9]  += st[RK_DDH_DT + 9];
  st[RK_DDH_PH + 10] += st[RK_DDH_DT + 10];
  st[RK_DDH_PH + 11] += st[RK_DDH_DT + 11];

  st[RK_DDH_TYPE] == 1 ? (
    metal2 = 0.0045 * (
      rk_syn_dd_sq(st[RK_DDH_PH + 6],  st[RK_DDH_DT + 6],  0.5) +
      rk_syn_dd_sq(st[RK_DDH_PH + 7],  st[RK_DDH_DT + 7],  0.5) +
      rk_syn_dd_sq(st[RK_DDH_PH + 8],  st[RK_DDH_DT + 8],  0.5) +
      rk_syn_dd_sq(st[RK_DDH_PH + 9],  st[RK_DDH_DT + 9],  0.5) +
      rk_syn_dd_sq(st[RK_DDH_PH + 10], st[RK_DDH_DT + 10], 0.5) +
      rk_syn_dd_sq(st[RK_DDH_PH + 11], st[RK_DDH_DT + 11], 0.5));
    nz2 = rk_syn_dd_rand01(st + RK_DDH_SEED);
    oscs += 0.1 * st[RK_DDH_BODY]
          * ((nz2 * nz2 - 0.5) * st[RK_DDH_E2] * st[RK_DDH_E2]);
  ) : st[RK_DDH_TYPE] == 0 ? (
    st[RK_DDH_PH + 4]  += st[RK_DDH_DT + 4];
    st[RK_DDH_PH + 5]  += st[RK_DDH_DT + 5];
    st[RK_DDH_PH + 12] += st[RK_DDH_DT + 12];
    metal2 = 0.003 * (
      rk_syn_dd_sq(st[RK_DDH_PH + 6],  st[RK_DDH_DT + 6],  0.5) +
      rk_syn_dd_sq(st[RK_DDH_PH + 7],  st[RK_DDH_DT + 7],  0.5) +
      rk_syn_dd_sq(st[RK_DDH_PH + 8],  st[RK_DDH_DT + 8],  0.5) +
      rk_syn_dd_sq(st[RK_DDH_PH + 9],  st[RK_DDH_DT + 9],  0.5) +
      rk_syn_dd_sq(st[RK_DDH_PH + 10], st[RK_DDH_DT + 10], 0.5) +
      rk_syn_dd_sq(st[RK_DDH_PH + 11], st[RK_DDH_DT + 11], 0.5) +
      0.28 * rk_syn_dd_sq(st[RK_DDH_PH + 5],  st[RK_DDH_DT + 5],  0.5) +
      0.06 * rk_syn_dd_sq(st[RK_DDH_PH + 12], st[RK_DDH_DT + 12], 0.5) +
      0.20 * rk_syn_dd_sq(st[RK_DDH_PH + 4],  st[RK_DDH_DT + 4],  0.5))
      + 0.0044 * (rk_syn_dd_rand01(st + RK_DDH_SEED) - 0.5);
  ) : (
    metal2 = 0.002 * (
      0.85 * rk_syn_dd_sqs(st[RK_DDH_PH + 6])  +
      0.90 * rk_syn_dd_sqs(st[RK_DDH_PH + 7])  +
             rk_syn_dd_sqs(st[RK_DDH_PH + 8])  +
      0.60 * rk_syn_dd_sqs(st[RK_DDH_PH + 9])  +
      1.20 * rk_syn_dd_sqs(st[RK_DDH_PH + 10]) +
      1.30 * rk_syn_dd_sqs(st[RK_DDH_PH + 11]));
  );

  st[RK_DDH_TYPE] == 1 ? (
    v1 = 2.40728073 * rk_syn_svf_bp(st + RK_DDH_BP,  oscs);
    v2 = v3 = 3.324654 * rk_syn_svf_bp(st + RK_DDH_BP2, oscs);
  ) : st[RK_DDH_TYPE] == 0 ? (
    v2 = v3 = 1.824654 * rk_syn_svf_bp(st + RK_DDH_BP2, oscs);
  ) : (
    v2 = 1.824654 * rk_syn_svf_bp(st + RK_DDH_BP2, oscs);
  );

  // the four envelopes: s += (t < n) ? k_atk*(a - s) : -k_rel*s
  st[RK_DDH_E12] += tt < st[RK_DDH_E12 + 1] ?
    st[RK_DDH_E12 + 2] * (st[RK_DDH_E12 + 4] - st[RK_DDH_E12]) :
    -st[RK_DDH_E12 + 3] * st[RK_DDH_E12];
  st[RK_DDH_E13] += tt < st[RK_DDH_E13 + 1] ?
    st[RK_DDH_E13 + 2] * (st[RK_DDH_E13 + 4] - st[RK_DDH_E13]) :
    -st[RK_DDH_E13 + 3] * st[RK_DDH_E13];
  st[RK_DDH_E2] += tt < st[RK_DDH_E2 + 1] ?
    st[RK_DDH_E2 + 2] * (st[RK_DDH_E2 + 4] - st[RK_DDH_E2]) :
    -st[RK_DDH_E2 + 3] * st[RK_DDH_E2];
  st[RK_DDH_E3] += tt < st[RK_DDH_E3 + 1] ?
    st[RK_DDH_E3 + 2] * (st[RK_DDH_E3 + 4] - st[RK_DDH_E3]) :
    -st[RK_DDH_E3 + 3] * st[RK_DDH_E3];

  st[RK_DDH_T] = tt + 1;
  s2s = st[RK_DDH_E2] * st[RK_DDH_E2];

  st[RK_DDH_TYPE] == 1 ? (
    out = 0.00012 * (
        rk_syn_svf_hp(st + RK_DDH_HP1, v1) * st[RK_DDH_E12] * st[RK_DDH_E12]
      + 2.1493863499171737 * s2s * st[RK_DDH_E13] * st[RK_DDH_E13]
        * rk_syn_svf_hp(st + RK_DDH_HP2, v2)
      + 3.1827788623083535 * st[RK_DDH_E3] * st[RK_DDH_E3]
        * rk_syn_svf_hp(st + RK_DDH_HP3, v3))
      + metal2 * st[RK_DDH_E3];
  ) : st[RK_DDH_TYPE] == 0 ? (
    nz  = (rk_syn_dd_rand01(st + RK_DDH_SEED) - 0.5) * s2s * st[RK_DDH_E12];
    nz2 = 2 * ((rk_syn_dd_rand01(st + RK_DDH_SEED)
              * rk_syn_dd_rand01(st + RK_DDH_SEED) - 0.5) * s2s);
    out = 0.003 * (
        0.70 * rk_syn_svf_bp(st + RK_DDH_BP,   nz)
      + st[RK_DDH_BODY] * rk_syn_svf_bp(st + RK_DDH_LP, nz2)
      + 0.05 * rk_syn_svf_bp(st + RK_DDH_BPS1, nz)
      + 0.05 * rk_syn_svf_bp(st + RK_DDH_BPS2, nz)
      + 0.06 * rk_syn_svf_bp(st + RK_DDH_BPS3, nz))
      + 0.0001 * (
        1.1493863499171737 * s2s * st[RK_DDH_E13] * st[RK_DDH_E13]
        * rk_syn_svf_hp(st + RK_DDH_HP2, v2)
      + 3.1827788623083535 * st[RK_DDH_E3] * st[RK_DDH_E3]
        * rk_syn_svf_hp(st + RK_DDH_HP3, v3))
      + metal2 * st[RK_DDH_E3] * st[RK_DDH_E13];
  ) : (
    nz  = (rk_syn_dd_rand01(st + RK_DDH_SEED) - 0.5) * s2s * st[RK_DDH_E12];
    nz2 = 2 * ((rk_syn_dd_rand01(st + RK_DDH_SEED)
              * rk_syn_dd_rand01(st + RK_DDH_SEED) - 0.5) * s2s);
    // his noise3 is computed and never used - kept because it consumes a
    // rand() call and therefore shifts his sequence. Dead in his source.
    rk_syn_dd_rand01(st + RK_DDH_SEED);
    metal3 = 0.003 * (
        0.005 * rk_syn_svf_bp(st + RK_DDH_BP, nz) * s2s
      + 0.04 * st[RK_DDH_E2] * st[RK_DDH_E13] * st[RK_DDH_E2]
        * rk_syn_svf_bp(st + RK_DDH_LP, nz2)
      + 0.05 * rk_syn_svf_bp(st + RK_DDH_BPS1, nz)
      + 0.05 * rk_syn_svf_bp(st + RK_DDH_BPS2, nz))
      + (metal2 + 0.00004 * (
          rk_syn_svf_hp(st + RK_DDH_HP2, nz)
        + rk_syn_svf_hp(st + RK_DDH_HP1, nz)
        + rk_syn_svf_hp(st + RK_DDH_HP3, nz)))
        * st[RK_DDH_E3] * st[RK_DDH_E13]
      + 0.03 * v2 * st[RK_DDH_E3];
    out = metal3;
  );

  out;
);

// ============================================================================
// DD-101 CLAP — synth types 0, 1, 2. Ported from clap_reset (303) / clap_tick
// (444). Type 3 is start_sample (sampler) — out of scope.
//
// ⚠️ THE CLAP HAS NO DETERMINISTIC AUDIO PATH. All three output terms —
// attack, wash, attack_hf — are rand()-driven, and the level constants are
// fixed. Silencing the noise leaves silence, so NO output null is possible for
// any type. Verified instead by (a) nulling the ENVELOPE TRAJECTORY, which is
// fully deterministic and is the multi-impulse retrigger machine that makes a
// clap a clap, and (b) coefficient parity on the 5 filters + 3 levels.
//
// ⚠️ In his source `attack` is BOTH a bare scratch variable and a namespace
// (`attack.state`, `attack.k1`, ...). EEL2 treats those as different
// variables. Ported as separate cells + a local.
//
// state: 52 cells.
// ============================================================================
RK_DDC_SEED  = 0;
RK_DDC_TYPE  = 1;
RK_DDC_AST   = 2;    // attack.state
RK_DDC_AKC   = 3;    // attack.k_current
RK_DDC_AK1   = 4;
RK_DDC_AK2   = 5;
RK_DDC_AK3   = 6;
RK_DDC_ATH   = 7;    // attack.thresh
RK_DDC_ASN   = 8;    // attack.snap
RK_DDC_WST   = 9;    // wash.state
RK_DDC_WRT   = 10;   // wash.rate
RK_DDC_ATL   = 11;   // atk_level
RK_DDC_WSL   = 12;   // wash_level
RK_DDC_HFL   = 13;   // hf_level
RK_DDC_SR    = 14;   // type 2 oscillator rate
RK_DDC_TS    = 15;
RK_DDC_TS2   = 16;
RK_DDC_HP    = 17;
RK_DDC_BP    = 24;
RK_DDC_HP2   = 31;
RK_DDC_BP2   = 38;
RK_DDC_BP3   = 45;
RK_DDC_CELLS = 52;

function rk_syn_dd_clap_reset(st, ctype, cattack, cdecay)
local(t_s, t2_s, t3_s, t4_s, t_wash)
global(srate, RK_DDC_SEED, RK_DDC_TYPE, RK_DDC_AST, RK_DDC_AKC, RK_DDC_AK1,
       RK_DDC_AK2, RK_DDC_AK3, RK_DDC_ATH, RK_DDC_ASN, RK_DDC_WST, RK_DDC_WRT,
       RK_DDC_ATL, RK_DDC_WSL, RK_DDC_HFL, RK_DDC_SR, RK_DDC_TS, RK_DDC_TS2,
       RK_DDC_HP, RK_DDC_BP, RK_DDC_HP2, RK_DDC_BP2, RK_DDC_BP3)
(
  st[RK_DDC_TYPE] = ctype;
  st[RK_DDC_SEED] <= 0 ? st[RK_DDC_SEED] = 99999;
  st[RK_DDC_ATH]  = pow(10, -24 / 20);
  st[RK_DDC_ASN]  = 0;
  st[RK_DDC_AST]  = 1;

  ctype == 0 ? (
    // his: -24 dB at 9, 19, 33 and 240 ms via a simple multiplicative process
    t_s    = 10  * 0.001 * (0.5 + cattack);
    t2_s   = 14  * 0.001 * (0.5 + cattack);
    t3_s   = 210 * 0.001 * (0.5 + cattack + max(0, cdecay - 0.25));
    t_wash = t3_s + 240 * (0.5 + 2 * cdecay) * 0.001;

    st[RK_DDC_AK1] = pow(10, -24  / (20 * t_s  * srate));
    st[RK_DDC_AK2] = pow(10, -24  / (20 * t2_s * srate));
    st[RK_DDC_AK3] = pow(10, -100 / (20 * t3_s * srate));
    st[RK_DDC_WRT] = pow(10, -40  / (20 * t_wash * srate));
    st[RK_DDC_WST] = 1;

    rk_syn_dd_svf_set_keep(st + RK_DDC_HP,  550,  2.0);
    rk_syn_dd_svf_set_keep(st + RK_DDC_BP,  908,  1.0);
    rk_syn_dd_svf_set_keep(st + RK_DDC_HP2, 8000, 1.0);
    rk_syn_dd_svf_set_keep(st + RK_DDC_BP2, 880,  0.72);
    rk_syn_dd_svf_set_keep(st + RK_DDC_BP3, 850,  0.74);

    st[RK_DDC_ATL] = 5.25;    // 14.4 dB
    st[RK_DDC_WSL] = 0.5888;  // -11 + 6.4 dB
    st[RK_DDC_HFL] = 0.305;   // -13.5 + 0.4 + 2.8 dB
  ) : ctype == 1 ? (
    t_s    = 12  * 0.001 * (0.5 + cattack);   // his: computed, then discarded
    t2_s   = 13  * 0.001 * (0.5 + cattack);
    t3_s   = 13  * 0.001 * (0.5 + cattack);
    t4_s   = 350 * 0.001 * (0.5 + cattack);
    t_wash = 500 * (0.5 + 2 * cdecay) * 0.001;

    st[RK_DDC_AK1] = pow(10, -24  / (20 * t2_s * srate));
    st[RK_DDC_AK2] = pow(10, -24  / (20 * t3_s * srate));
    st[RK_DDC_AK3] = pow(10, -100 / (20 * t4_s * srate));
    st[RK_DDC_WRT] = pow(10, -40  / (20 * t_wash * srate));
    st[RK_DDC_WST] = 0;       // starts silent, armed at the 2nd snap

    rk_syn_dd_svf_set_keep(st + RK_DDC_HP,  650, 2.38);
    rk_syn_dd_svf_set_keep(st + RK_DDC_BP,  990, 0.5);
    rk_syn_dd_svf_set_keep(st + RK_DDC_BP2, 990, 1.0);
    rk_syn_dd_svf_set_keep(st + RK_DDC_BP3, 970, 1.0);

    st[RK_DDC_ATL] = 4.36;    // 12.8 dB
    st[RK_DDC_WSL] = 0.16;    // -16 dB
    st[RK_DDC_HFL] = 0;
  ) : ctype == 2 ? (
    // ⚠️ type 2 drives its stage times from DECAY where 0/1 use ATTACK
    t_s    = 12  * 0.001 * (0.5 + cdecay);
    t2_s   = 13  * 0.001 * (0.5 + cdecay);
    t3_s   = 13  * 0.001 * (0.5 + cdecay);
    t4_s   = 350 * 0.001 * (0.5 + cdecay);
    t_wash = 500 * (0.5 + 2 * cdecay) * 0.001;

    st[RK_DDC_AK1] = pow(10, -24  / (20 * t2_s * srate));
    st[RK_DDC_AK2] = pow(10, -24  / (20 * t3_s * srate));
    st[RK_DDC_AK3] = pow(10, -100 / (20 * t4_s * srate));
    st[RK_DDC_SR]  = 970 * (1 / srate) * (0.5 + cattack);
    st[RK_DDC_WRT] = pow(10, -40 / (20 * t_wash * srate));
    st[RK_DDC_WST] = 1;

    rk_syn_dd_svf_set_keep(st + RK_DDC_HP,  650,  2.38);
    rk_syn_dd_svf_set_keep(st + RK_DDC_HP2, 990,  0.4);
    rk_syn_dd_svf_set_keep(st + RK_DDC_BP,  990,  1.25);
    rk_syn_dd_svf_set_keep(st + RK_DDC_BP2, 990,  1.0);
    rk_syn_dd_svf_set_keep(st + RK_DDC_BP3, 1970, 1.0);

    st[RK_DDC_ATL] = 4.36;
    st[RK_DDC_WSL] = 0.26;
    st[RK_DDC_HFL] = 0.8;
  );
  st[RK_DDC_AKC] = st[RK_DDC_AK1];
);

// The deterministic half, split out so the harness can null it directly:
// advances attack.state / wash.state one sample, running the 3-snap retrigger
// machine. Returns nothing; read RK_DDC_AST / RK_DDC_WST.
function rk_syn_dd_clap_env(st)
global(RK_DDC_TYPE, RK_DDC_AST, RK_DDC_AKC, RK_DDC_AK1, RK_DDC_AK2, RK_DDC_AK3,
       RK_DDC_ATH, RK_DDC_ASN, RK_DDC_WST, RK_DDC_WRT)
(
  st[RK_DDC_AST] *= st[RK_DDC_AKC];
  st[RK_DDC_AST] < st[RK_DDC_ATH] && st[RK_DDC_ASN] < 3 ? (
    st[RK_DDC_AST] = 1;
    st[RK_DDC_ASN] += 1;
    st[RK_DDC_ASN] == 1 ? st[RK_DDC_AKC] = st[RK_DDC_AK1] :
    st[RK_DDC_ASN] == 2 ? (
      st[RK_DDC_AKC] = st[RK_DDC_AK2];
      st[RK_DDC_TYPE] == 1 ? st[RK_DDC_WST] = 1;
    ) :
    st[RK_DDC_ASN] == 3 ? st[RK_DDC_AKC] = st[RK_DDC_AK3];
  );
  st[RK_DDC_WST] *= st[RK_DDC_WRT];
);

function rk_syn_dd_clap_tick(st)
local(atk, wsh, atk_hf, srt, srt2, yy)
global(RK_DDC_SEED, RK_DDC_TYPE, RK_DDC_AST, RK_DDC_WST,
       RK_DDC_ATL, RK_DDC_WSL, RK_DDC_HFL, RK_DDC_SR, RK_DDC_TS, RK_DDC_TS2,
       RK_DDC_HP, RK_DDC_BP, RK_DDC_HP2, RK_DDC_BP2, RK_DDC_BP3)
(
  st[RK_DDC_TYPE] < 2 ? (
    rk_syn_dd_clap_env(st);
    atk = rk_syn_svf_hp(st + RK_DDC_HP,
            rk_syn_svf_bp(st + RK_DDC_BP,
              st[RK_DDC_AST] * (rk_syn_dd_rand01(st + RK_DDC_SEED) - 0.5)));
    atk_hf = st[RK_DDC_TYPE] == 0 ?
      rk_syn_svf_hp(st + RK_DDC_HP2,
        st[RK_DDC_AST] * (rk_syn_dd_rand01(st + RK_DDC_SEED) - 0.5)) : 0;
    wsh = rk_syn_svf_bp(st + RK_DDC_BP3,
            rk_syn_svf_bp(st + RK_DDC_BP2,
              st[RK_DDC_WST] * (rk_syn_dd_rand01(st + RK_DDC_SEED) - 0.5)));
  ) : (
    rk_syn_dd_clap_env(st);
    srt = st[RK_DDC_SR] * (1.0 + 1.0 * st[RK_DDC_AST]);
    st[RK_DDC_TS] += srt;
    st[RK_DDC_TS] > 1 ? st[RK_DDC_TS] = 0;
    srt2 = st[RK_DDC_SR] * (1.0 - 0.5 * st[RK_DDC_AST]);
    st[RK_DDC_TS2] += srt2;
    st[RK_DDC_TS2] > 1.0 ? st[RK_DDC_TS2] = 0;
    yy = rk_syn_dd_poly_aa_sq(st[RK_DDC_TS], srt)
       + rk_syn_dd_poly_aa_sq(st[RK_DDC_TS2], srt2);
    atk = rk_syn_svf_hp(st + RK_DDC_HP,
            rk_syn_svf_bp(st + RK_DDC_BP,
              st[RK_DDC_AST]
              * ((1.5 + 0.8 * rk_syn_dd_rand01(st + RK_DDC_SEED)) * yy)));
    atk_hf = rk_syn_svf_hp(st + RK_DDC_HP2,
               st[RK_DDC_AST] * (rk_syn_dd_rand01(st + RK_DDC_SEED) - 0.5));
    wsh = rk_syn_svf_bp(st + RK_DDC_BP3,
            rk_syn_svf_bp(st + RK_DDC_BP2,
              st[RK_DDC_WST]
              * (rk_syn_dd_rand01(st + RK_DDC_SEED) - 0.5 + 0.2 * yy)));
  );

  st[RK_DDC_ATL] * atk + st[RK_DDC_WSL] * wsh + st[RK_DDC_HFL] * atk_hf;
);

// ============================================================================
// DD-101 TOM — types 0, 1, 2. Ported from tom_synth1/2/3 _reset+_eval
// (1314-1513) and the hi/mid/low dispatch (1515-1606).
//
// ⚠️ TYPE -> ENGINE MAPPING IS NOT IN ORDER:
//      tom_type 0 -> tom_synth2      1 -> tom_synth1      2 -> tom_synth3
// ⚠️ `which` (0 hi / 1 mid / 2 low) changes core frequencies, gain and
//    low_scale, not just tune - his three toms are separate voicings, not one
//    engine transposed. Kept as a reset argument; the macro layer decides how
//    to expose it (spec §3.2 collapses the three pads into one engine).
// ⚠️ synth1's punch.dt is in RADIANS (2*pi*f*israte) for its sine recurrence;
//    synth2/3 use normalised f*israte. Different conventions, both ported.
// ⚠️ punch.t / punch.t3 are NOT reset per trigger - free-running, like the hat.
//    Our reset leaves them alone too, but Swing's core zeroes the whole voice
//    block on every launch (launch_syn_for_pad), so in Swing they start at 0
//    on every hit.
// ⚠️ synth3 calls eval_linearSVF_LP on the filter it *named* `bp`. Not a typo.
// ⚠️ synth2 and synth3 both init bp2 TWICE; the second call wins. Both kept.
// ⚠️ synth3's output ternary has no else branch, so |sqp| <= 0.001 yields 0 -
//    a gate, not a passthrough. And it quantises to 512 steps (a bitcrusher).
//
// All three types ARE exact-nullable: their rand() feeds dedicated filters
// (synth1 bp, synth2/3 lp2+bp2) which the harness zeroes, leaving the
// deterministic oscillator path intact.
//
// state: 49 cells.
// ============================================================================
RK_DDT_SEED  = 0;
RK_DDT_TYPE  = 1;
RK_DDT_PST   = 2;    // punch.state
RK_DDT_PST2  = 3;
RK_DDT_PST3  = 4;
RK_DDT_PATK  = 5;
RK_DDT_PK    = 6;
RK_DDT_PK2   = 7;
RK_DDT_PK3   = 8;
RK_DDT_PKATK = 9;
RK_DDT_PPDEC = 10;   // punch.pitch_decay
RK_DDT_DT    = 11;
RK_DDT_DT2   = 12;
RK_DDT_DT3   = 13;
RK_DDT_T     = 14;   // free-running
RK_DDT_T3    = 15;   // free-running
RK_DDT_SCOEF = 16;   // sine-recurrence coefficient (synth1)
RK_DDT_SIN1  = 17;
RK_DDT_SIN2  = 18;
RK_DDT_LOWSC = 19;   // low_scale (synth2)
RK_DDT_GAIN  = 20;
RK_DDT_LP    = 21;
RK_DDT_LP2   = 28;
RK_DDT_BP    = 35;
RK_DDT_BP2   = 42;
RK_DDT_CELLS = 49;

function rk_syn_dd_tom_reset(st, ttype, which, tune, decay)
local(t_s, w, tuning, core_freq, shift)
global(srate, RK_DDT_SEED, RK_DDT_TYPE, RK_DDT_PST, RK_DDT_PST2, RK_DDT_PST3,
       RK_DDT_PATK, RK_DDT_PK, RK_DDT_PK2, RK_DDT_PK3, RK_DDT_PKATK,
       RK_DDT_PPDEC, RK_DDT_DT, RK_DDT_DT2, RK_DDT_DT3, RK_DDT_T,
       RK_DDT_SCOEF, RK_DDT_SIN1, RK_DDT_SIN2, RK_DDT_LOWSC, RK_DDT_GAIN,
       RK_DDT_LP, RK_DDT_LP2, RK_DDT_BP, RK_DDT_BP2)
(
  st[RK_DDT_TYPE] = ttype;
  st[RK_DDT_SEED] <= 0 ? st[RK_DDT_SEED] = 33333;
  tuning = pow(2, tune - 0.5);

  ttype == 1 ? (
    // ── tom_synth1: sine recurrence + band-passed noise ──
    t_s = 0.3 * (0.5 + decay + 0.2 * (which == 2));
    st[RK_DDT_PST]   = 1 + 0.1 * (which == 2);
    st[RK_DDT_PATK]  = 1;
    st[RK_DDT_PK]    = pow(10, -24 / (20 * t_s * srate));
    st[RK_DDT_PKATK] = pow(10, -24 / (20 * 0.00025 * srate));

    core_freq = which == 0 ? 154 * tuning :
                which == 1 ? 147 * tuning : 101 * tuning;
    st[RK_DDT_DT] = 2.0 * $pi * core_freq / srate;   // RADIANS
    w = st[RK_DDT_DT];
    st[RK_DDT_SCOEF] = 2.0 * cos(w);
    st[RK_DDT_T] += st[RK_DDT_DT];
    st[RK_DDT_SIN1] = -cos(-w + st[RK_DDT_T]);
    st[RK_DDT_SIN2] = -cos(-2.0 * w + st[RK_DDT_T]);
    st[RK_DDT_T] -= st[RK_DDT_DT];

    rk_syn_dd_svf_set_keep(st + RK_DDT_BP, core_freq, 0.5);
    rk_syn_dd_svf_set_keep(st + RK_DDT_LP, 564, 1);
  ) : ttype == 0 ? (
    // ── tom_synth2: 5 naive triangles + cubic bend + 2 noise bands ──
    t_s = 0.66 * (0.5 + decay + 0.2 * (which == 2));
    st[RK_DDT_PST]   = 1 + 0.1 * (which == 2);
    st[RK_DDT_PST2]  = 1;
    st[RK_DDT_PST3]  = 1;
    st[RK_DDT_PATK]  = 1;
    st[RK_DDT_PK]    = pow(10, -24 / (20 * t_s * srate));
    st[RK_DDT_PK2]   = pow(10, -64 / (20 * t_s * srate));
    st[RK_DDT_PK3]   = pow(10, -64 / (1  * t_s * srate));
    st[RK_DDT_PKATK] = pow(10, -24 / (20 * 0.005 * srate));
    st[RK_DDT_PPDEC] = pow(10, -24 / (20 * 0.5 * srate));

    which == 0 ? (
      core_freq = 115 * tuning; shift = 30 * tuning;
      st[RK_DDT_GAIN] = 1.0; st[RK_DDT_LOWSC] = 1.0;
      st[RK_DDT_DT3] = 115 / srate;
    ) : which == 1 ? (
      core_freq = 90 * tuning; shift = 25 * tuning;
      st[RK_DDT_GAIN] = 1.0; st[RK_DDT_LOWSC] = 1.1;
      st[RK_DDT_DT3] = 105 / srate;
    ) : (
      core_freq = 81 * tuning; shift = 20 * tuning;
      st[RK_DDT_GAIN] = 0.7; st[RK_DDT_LOWSC] = 1.1;
      st[RK_DDT_DT3] = 88 / srate;
    );
    st[RK_DDT_DT]  = core_freq / srate;
    st[RK_DDT_DT2] = shift / srate;

    rk_syn_dd_svf_set_keep(st + RK_DDT_BP,  core_freq, 0.9);
    rk_syn_dd_svf_set_keep(st + RK_DDT_BP2, core_freq, 0.5);   // his, overwritten
    rk_syn_dd_svf_set_keep(st + RK_DDT_LP,  2564, 1);
    rk_syn_dd_svf_set_keep(st + RK_DDT_LP2, 444 + core_freq, 0.2);
    rk_syn_dd_svf_set_keep(st + RK_DDT_BP2, 600 + core_freq, 0.2);
  ) : ttype == 2 ? (
    // ── tom_synth3: two naive squares, 512-step quantiser ──
    t_s = 0.42 * (0.5 + decay + 0.2 * (which == 2));
    st[RK_DDT_PST]   = 1;
    st[RK_DDT_PST2]  = 1;
    st[RK_DDT_PST3]  = 1;
    st[RK_DDT_PATK]  = 1;
    st[RK_DDT_PK]    = pow(10, -24 / (20 * t_s * srate));
    st[RK_DDT_PK2]   = pow(10, -24 / (20 * t_s * srate));
    st[RK_DDT_PK3]   = pow(10, -60 / (20 * t_s * srate));
    st[RK_DDT_PKATK] = pow(10, -24 / (20 * 0.005 * srate));
    st[RK_DDT_PPDEC] = pow(10, -24 / (20 * 0.5 * srate));

    which == 0 ? ( core_freq = 130 * tuning; shift = 140 * tuning; ) :
    which == 1 ? ( core_freq = 120 * tuning; shift = 130 * tuning;
                   st[RK_DDT_DT3] = 105 / srate; ) :
                 ( core_freq = 80  * tuning; shift = 120 * tuning;
                   st[RK_DDT_DT3] = 88 / srate; );
    st[RK_DDT_DT]  = core_freq / srate;
    st[RK_DDT_DT2] = shift / srate;

    rk_syn_dd_svf_set_keep(st + RK_DDT_BP,  600, 2);
    rk_syn_dd_svf_set_keep(st + RK_DDT_BP2, core_freq, 0.5);   // his, overwritten
    rk_syn_dd_svf_set_keep(st + RK_DDT_LP,  364, 1);
    rk_syn_dd_svf_set_keep(st + RK_DDT_LP2, 444 + core_freq, 0.6);
    rk_syn_dd_svf_set_keep(st + RK_DDT_BP2, 600 + core_freq, 0.2);
  );
);

function rk_syn_dd_tom_tick(st)
local(s, y, nz, sqp)
global(RK_DDT_SEED, RK_DDT_TYPE, RK_DDT_PST, RK_DDT_PST2, RK_DDT_PST3,
       RK_DDT_PATK, RK_DDT_PK, RK_DDT_PK2, RK_DDT_PK3, RK_DDT_PKATK,
       RK_DDT_PPDEC, RK_DDT_DT, RK_DDT_DT2, RK_DDT_DT3, RK_DDT_T, RK_DDT_T3,
       RK_DDT_SCOEF, RK_DDT_SIN1, RK_DDT_SIN2, RK_DDT_LOWSC, RK_DDT_GAIN,
       RK_DDT_LP, RK_DDT_LP2, RK_DDT_BP, RK_DDT_BP2)
(
  st[RK_DDT_TYPE] == 1 ? (
    st[RK_DDT_T] += st[RK_DDT_DT];
    s = st[RK_DDT_SCOEF] * st[RK_DDT_SIN1] - st[RK_DDT_SIN2];
    st[RK_DDT_SIN2] = st[RK_DDT_SIN1];
    st[RK_DDT_SIN1] = s;
    st[RK_DDT_PST]  *= st[RK_DDT_PK];
    st[RK_DDT_PATK] *= st[RK_DDT_PKATK];
    y = (1.0 - st[RK_DDT_PATK]) * s * st[RK_DDT_PST] * st[RK_DDT_PST]
      + 0.5 * rk_syn_svf_lp(st + RK_DDT_LP,
                rk_syn_svf_bp(st + RK_DDT_BP,
                  rk_syn_dd_rand01(st + RK_DDT_SEED) - 0.5)) * st[RK_DDT_PST];
    y * 0.8;
  ) : st[RK_DDT_TYPE] == 0 ? (
    st[RK_DDT_T]  += st[RK_DDT_DT] + st[RK_DDT_DT2];
    st[RK_DDT_T3] += st[RK_DDT_DT3] + st[RK_DDT_DT2];
    st[RK_DDT_DT2] *= st[RK_DDT_PPDEC];

    s = rk_syn_svf_bp(st + RK_DDT_BP,
          rk_syn_svf_lp(st + RK_DDT_LP,
            0.6   * rk_syn_dd_naive_tri(st[RK_DDT_LOWSC] * st[RK_DDT_T]) +
            0.3   * st[RK_DDT_PST2] * rk_syn_dd_naive_tri(2.0 * st[RK_DDT_T3]) +
            0.4   * st[RK_DDT_PST2] * rk_syn_dd_naive_tri(2.9 * st[RK_DDT_T3]) +
            0.5   * rk_syn_dd_naive_tri(0.7 * st[RK_DDT_T]) +
            0.023 * rk_syn_dd_naive_tri(1.4 * st[RK_DDT_T3])));
    s += 0.31 * s * s * s * st[RK_DDT_PST2];

    st[RK_DDT_PATK] *= st[RK_DDT_PKATK];
    st[RK_DDT_PST]  *= st[RK_DDT_PK];
    st[RK_DDT_PST2] *= st[RK_DDT_PK2];
    st[RK_DDT_PST3] *= st[RK_DDT_PK3];

    nz  = rk_syn_dd_rand01(st + RK_DDT_SEED) - 0.5;
    sqp = 2.0 * st[RK_DDT_PST] * st[RK_DDT_PST] * st[RK_DDT_PST];
    y = st[RK_DDT_GAIN] * ((1.0 - st[RK_DDT_PATK]) * s * sqp
      + st[RK_DDT_GAIN] * 1.0 * rk_syn_svf_bp(st + RK_DDT_LP2, nz)
        * st[RK_DDT_PST2] * st[RK_DDT_PST2] * st[RK_DDT_PST2] * st[RK_DDT_PST2]
      + rk_syn_svf_bp(st + RK_DDT_BP2, nz) * st[RK_DDT_PST3] * st[RK_DDT_PST3]);
    0.45 * y;
  ) : (
    st[RK_DDT_T] += st[RK_DDT_DT] + st[RK_DDT_DT2];
    st[RK_DDT_DT2] *= st[RK_DDT_PPDEC];

    // ⚠️ his `bp` filter, evaluated as a LOWPASS. Not a typo in the port.
    s = rk_syn_svf_lp(st + RK_DDT_BP,
          rk_syn_svf_lp(st + RK_DDT_LP,
            0.6  * rk_syn_dd_sqs(st[RK_DDT_T]) +
            0.12 * rk_syn_dd_sqs(2.0 * st[RK_DDT_T])));

    st[RK_DDT_PATK] *= st[RK_DDT_PKATK];
    st[RK_DDT_PST]  *= st[RK_DDT_PK];
    st[RK_DDT_PST2] *= st[RK_DDT_PK2];
    st[RK_DDT_PST3] *= st[RK_DDT_PK3];

    nz  = rk_syn_dd_rand01(st + RK_DDT_SEED) - 0.5;
    sqp = 2.0 * st[RK_DDT_PST];
    sqp < 0.95 ? st[RK_DDT_PST] *= st[RK_DDT_PK] * st[RK_DDT_PK]
                                 * st[RK_DDT_PK] * st[RK_DDT_PK];
    nz = 2.0 * rk_syn_svf_bp(st + RK_DDT_LP2, nz)
           * st[RK_DDT_PST2] * st[RK_DDT_PST2]
       + rk_syn_svf_bp(st + RK_DDT_BP2, nz)
           * st[RK_DDT_PST3] * st[RK_DDT_PST3];
    sqp = (1.0 - st[RK_DDT_PATK]) * s * sqp + nz * st[RK_DDT_PST2];

    // ⚠️ no else branch: |sqp| <= 0.001 yields 0. A gate, plus a 512-step
    // quantiser. Both are his.
    0.3 * (abs(sqp) > 0.001 ? floor(sqp * 512) / 512 : 0);
  );
);

// his band-limited saw (drum_elements 48-56)
function rk_syn_dd_saw(t, dt)
local(phase, y)
global()
(
  phase = t - floor(t);
  y = 2.0 * phase - 1.0;
  y - rk_syn_dd_poly_aa_sq(phase, dt);
);

// ============================================================================
// DD-101 RIDE — synth types 0, 1, 2. Ported from ride_reset_1/2/3 (788/515/575)
// and ride_tick_1/2/3 (888/736/666). Type 3 is start_sample — out of scope.
// ⚠️ reset and tick variants are NOT co-located in his file; read by name.
//
// THREE DIFFERENT INSTRUMENTS under one name:
//   t0  the hat-t1 core reused: 4 fixed + 2 tone-swept squares at ride_duty
//   t1  saws + squares through TWO series freq shifters into 9 peak filters
//   t2  hat-t0-shaped square bank, retuned, with asymmetric duty cycles
//
// ⚠️ ALL THREE ARE UN-NULLABLE (t0: `+ 0.1*rand()` in oscs; t1: noise-driven
// throughout; t2: bare `0.0044*(rand()-0.5)` in metal2). Verified by
// coefficient parity + the bit-exact sq()/saw() primitives + ear, the route
// Checkpoint A validated on snare t0 / hat t0.
//
// ⚠️⚠️ PORTED BUG — DO NOT "FIX": in ride_reset_2 his e3.atk and e4.atk both
// divide by **e1.n**, not their own e3.n / e4.n (and e1.n is 100x smaller).
// Near-certainly copy-paste, but it defines the sound.
//
// ⚠️ DEAD CODE ported as the zeros it is: ride_tick_1's `metal2` is read but
// never assigned; ride_tick_2's whole crash block sits behind a literal `0 ?`.
//
// ⚠️ Types SHARE the filter/envelope slots — a voice is exactly one type, same
// as the hat. Do not lay them out non-overlapping; t1 alone reaches cell 230.
//
// state: 232 cells (RK_DDR_CELLS).
// ============================================================================
RK_DDR_SEED  = 0;
RK_DDR_TYPE  = 1;
RK_DDR_T     = 2;    // sample counter
RK_DDR_DUTY  = 3;    // ride_duty latched
RK_DDR_TONE  = 4;    // ride_tone latched (t0's dt5/dt6 come from it, once at launch: rk_syn_dd_ride_latch_dt56)
RK_DDR_PH    = 5;    // t1..t13   -> 5..17
RK_DDR_DT    = 18;   // dt1..dt13 -> 18..30
// envelope set A (types 0 and 2): [0]=s [1]=n [2]=k_atk [3]=k_rel [4]=a
RK_DDR_E12   = 31;
RK_DDR_E13   = 36;
RK_DDR_E2    = 41;
RK_DDR_E3    = 46;
// envelope set B (type 1): [0]=state [1]=amp [2]=n [3]=atk [4]=rel
RK_DDR_B1    = 51;
RK_DDR_B3    = 56;
RK_DDR_B4    = 61;
RK_DDR_B2S   = 66;   // e2.state (plain multiplicative decay)
RK_DDR_B2K   = 67;   // e2.k
RK_DDR_B4FR  = 68;   // e4.fast_release
// ten filter slots, shared across types (7 cells each)
//   slot:  t0/t2 role        t1 role
RK_DDR_F1    = 69;   // bp              bp_wide
RK_DDR_F2    = 76;   // bp2             peak1
RK_DDR_F3    = 83;   // hp1             peak2
RK_DDR_F4    = 90;   // hp2             peak3
RK_DDR_F5    = 97;   // hp3             peak4
RK_DDR_F6    = 104;  // bp3   (t2)      peak5
RK_DDR_F7    = 111;  // bps1  (t2)      peak6
RK_DDR_F8    = 118;  // bps2  (t2)      peak7
RK_DDR_F9    = 125;  // bps3  (t2)      peak8
RK_DDR_F10   = 132;  // lp    (t2)      peak9
RK_DDR_SH1   = 139;  // t1 only: his ride.fshift,  110 Hz -> 139..184
RK_DDR_SH2   = 185;  // t1 only: his fshift2,      0.4 Hz -> 185..230
// Pad TUNE, latched at launch for ride type 0's dt5/dt6, which come from TONE
// (rk_syn_dd_ride_latch_dt56, run by the dispatcher after this is latched).
RK_DDR_TUNEF = 231;  // 1 = no transposition
RK_DDR_CELLS = 232;

function rk_syn_dd_ride_reset(st, rtype, rattack, rdecay, rtone, rduty)
local(af, df, idec, isr_dec, isr_dec2, isr_tone, tc, d7, t_s, isr_decay)
global(srate, RK_DDR_SEED, RK_DDR_TYPE, RK_DDR_T, RK_DDR_DUTY, RK_DDR_TONE,
       RK_DDR_DT, RK_DDR_E12, RK_DDR_E13, RK_DDR_E2, RK_DDR_E3,
       RK_DDR_B1, RK_DDR_B3, RK_DDR_B4, RK_DDR_B2S, RK_DDR_B2K, RK_DDR_B4FR,
       RK_DDR_F1, RK_DDR_F2, RK_DDR_F3, RK_DDR_F4, RK_DDR_F5, RK_DDR_F6,
       RK_DDR_F7, RK_DDR_F8, RK_DDR_F9, RK_DDR_F10, RK_DDR_SH1, RK_DDR_SH2,
       RK_DDR_TUNEF)
(
  st[RK_DDR_TYPE] = rtype;
  st[RK_DDR_T]    = 0;
  st[RK_DDR_DUTY] = rduty;
  st[RK_DDR_TONE] = rtone;
  // Default the tune ratio to 1 HERE, not at the caller. The caller only writes
  // it when tune != 0, so without this a voice slot reused from a tuned pad
  // would keep that pad's ratio and detune an untuned one.
  st[RK_DDR_TUNEF] = 1;
  st[RK_DDR_SEED] <= 0 ? st[RK_DDR_SEED] = 22222;

  af = pow(10, rattack - 0.5);
  df = pow(10, -(rdecay - 0.5));
  idec     = 1.0 / df;
  isr_dec  = (1 / srate) * df;
  isr_dec2 = (1 / srate) * df / 2;

  rtype == 0 ? (
    // ── ride_reset_1: the hat-t1 core, no metal stack ──
    rk_syn_dd_svf_set_keep(st + RK_DDR_F1, 3210,     0.17228);
    rk_syn_dd_svf_set_keep(st + RK_DDR_F2, 6963.75,  0.21733);
    rk_syn_dd_svf_set_keep(st + RK_DDR_F3, 2477.49,  1.04538744609);
    rk_syn_dd_svf_set_keep(st + RK_DDR_F4, 8268.56,  1.16018963454);
    rk_syn_dd_svf_set_keep(st + RK_DDR_F5, 10433.49, 0.2170202297);
    st[RK_DDR_DT + 0] = 205.3 / srate;
    st[RK_DDR_DT + 1] = 369.6 / srate;
    st[RK_DDR_DT + 2] = 304.4 / srate;
    st[RK_DDR_DT + 3] = 522.7 / srate;

    st[RK_DDR_E12 + 4] = 5.886297285230614
      * (0.5 + (idec > 1.0 ? 1.0 : idec) * 0.5)
      * (0.95 + 0.1 * rk_syn_dd_rand01(st + RK_DDR_SEED));
    st[RK_DDR_E12 + 1] = 0.13362501578292 * srate * af;
    st[RK_DDR_E12 + 2] = 7.264430222920869 / st[RK_DDR_E12 + 1];
    // ⚠️ NO 10* factor here - the hat's type 1 has one, his ride does not.
    st[RK_DDR_E12 + 3] = 7.264430222920869 * isr_dec / 12.830314491926522;

    st[RK_DDR_E13 + 4] = 2.446983835532773;
    st[RK_DDR_E13 + 1] = 0.0013941882299170012 * srate * af;
    st[RK_DDR_E13 + 2] = 7.264430222920869 / st[RK_DDR_E13 + 1];
    st[RK_DDR_E13 + 3] = 7.264430222920869 * isr_dec / 11.784588871968632;

    st[RK_DDR_E2 + 4] = 5.112817165724925;
    st[RK_DDR_E2 + 1] = 0.023312507777462504 * srate * af;
    st[RK_DDR_E2 + 2] = 7.264430222920869 / st[RK_DDR_E2 + 1];
    st[RK_DDR_E2 + 3] = 7.264430222920869 * isr_dec / 2.082148383059353;

    st[RK_DDR_E3 + 4] = 13.459926564551697;
    st[RK_DDR_E3 + 1] = 0.0014790265731799877 * srate * af;
    st[RK_DDR_E3 + 2] = 7.264430222920869 / st[RK_DDR_E3 + 1];
    st[RK_DDR_E3 + 3] = 7.264430222920869 * isr_dec / 0.21747253516471457;
  ) : rtype == 1 ? (
    // ── ride_reset_2: peak bank + two series freq shifters ──
    rk_syn_dd_svf_set_keep(st + RK_DDR_F1,  6000,     0.5);    // bp_wide
    rk_syn_dd_svf_set_keep(st + RK_DDR_F2,  8200.75,  0.02);   // peak1
    rk_syn_dd_svf_set_keep(st + RK_DDR_F3,  5889,     0.02);   // peak2
    rk_syn_dd_svf_set_keep(st + RK_DDR_F4,  2456,     0.03);   // peak3
    rk_syn_dd_svf_set_keep(st + RK_DDR_F5,  3712.49,  0.02);   // peak4
    rk_syn_dd_svf_set_keep(st + RK_DDR_F6,  10012.49, 0.08);   // peak5
    rk_syn_dd_svf_set_keep(st + RK_DDR_F7,  12000.49, 0.1);    // peak6
    rk_syn_dd_svf_set_keep(st + RK_DDR_F8,  8200.49,  0.1);    // peak7
    rk_syn_dd_svf_set_keep(st + RK_DDR_F9,  6200.49,  1.0);    // peak8 (dead: crash)
    rk_syn_dd_svf_set_keep(st + RK_DDR_F10, 14200.49, 1.0);    // peak9 (dead: crash)
    // his ride.fshift is set once in reinit(); we own per-voice state, so both
    // shifters are initialised here.
    rk_syn_dd_shift_set(st + RK_DDR_SH1, 110);
    rk_syn_dd_shift_set(st + RK_DDR_SH2, 0.4);

    st[RK_DDR_DT + 0] = 25.3  / srate;
    st[RK_DDR_DT + 1] = 169.6 / srate * (0.5 + 0.4 * rtone);
    st[RK_DDR_DT + 2] = 304.4 / srate;
    st[RK_DDR_DT + 3] = 522.7 / srate * (0.5 + 0.6 * rtone);

    isr_decay = 1.0 / (srate * (0.3 + rdecay));
    st[RK_DDR_B1 + 1] = 0.05;                                  // e1.amp
    st[RK_DDR_B1 + 2] = 0.01 * 0.13362501578292 * srate;       // e1.n
    st[RK_DDR_B1 + 3] = 7.264430222920869 / st[RK_DDR_B1 + 2]; // e1.atk
    st[RK_DDR_B1 + 4] = 7.264430222920869 * isr_decay;         // e1.rel

    st[RK_DDR_B3 + 1] = 0.02;
    st[RK_DDR_B3 + 2] = 0.13362501578292 * srate;
    // ⚠️⚠️ HIS BUG, PORTED VERBATIM: divides by e1.n, not e3.n.
    st[RK_DDR_B3 + 3] = 7.264430222920869 / st[RK_DDR_B1 + 2];
    st[RK_DDR_B3 + 4] = 2 * 7.264430222920869 * isr_decay;

    st[RK_DDR_B4 + 1] = 0.05;
    st[RK_DDR_B4 + 2] = 0.13362501578292 * srate;
    // ⚠️⚠️ HIS BUG, PORTED VERBATIM: divides by 500 * e1.n, not e4.n.
    st[RK_DDR_B4 + 3] = 7.264430222920869 / (500 * st[RK_DDR_B1 + 2]);
    st[RK_DDR_B4 + 4] = 7.264430222920869 * isr_decay;
    st[RK_DDR_B4FR]   = 2 * st[RK_DDR_B4 + 4];

    t_s = 0.03 * (0.2 + rdecay);
    st[RK_DDR_B2S] = 0.014;
    st[RK_DDR_B2K] = pow(10, -24 / (20 * t_s * srate));
  ) : rtype == 2 ? (
    // ── ride_reset_3: hat-t0 shape, retuned ──
    tc = 2.1 * rtone - 1;
    rk_syn_dd_svf_set_keep(st + RK_DDR_F1,  4666,                   1.2);
    rk_syn_dd_svf_set_keep(st + RK_DDR_F7,  1529.49 + tc * 100,     0.08);
    rk_syn_dd_svf_set_keep(st + RK_DDR_F8,  988.49  + tc * 100,     0.13);
    rk_syn_dd_svf_set_keep(st + RK_DDR_F9,  3500.49 + tc * 1000,    0.04);
    rk_syn_dd_svf_set_keep(st + RK_DDR_F2,  3963.75 + tc * 400,     0.41733);
    rk_syn_dd_svf_set_keep(st + RK_DDR_F6,  6963.75 + tc * 400,     0.41733);
    rk_syn_dd_svf_set_keep(st + RK_DDR_F10, 3000.49,                1.14538744609);
    rk_syn_dd_svf_set_keep(st + RK_DDR_F3,  2477.49,                1.04538744609);
    rk_syn_dd_svf_set_keep(st + RK_DDR_F4,  8268.56,                1.16018963454);
    rk_syn_dd_svf_set_keep(st + RK_DDR_F5,  6633.49,                1.2170202297);

    isr_tone = (1 / srate) * (0.8 + 0.5 * rtone);
    st[RK_DDR_DT + 0] = 205.3 * isr_tone;
    st[RK_DDR_DT + 1] = 369.6 * isr_tone;
    st[RK_DDR_DT + 2] = 304.4 * isr_tone;
    st[RK_DDR_DT + 3] = 522.7 * isr_tone;
    st[RK_DDR_DT + 4] = 443.0 * isr_tone;
    st[RK_DDR_DT + 5] = 509.0 * isr_tone;
    d7 = 3892.9200658769764 * isr_tone;   // his 3392.92 sits commented out
    st[RK_DDR_DT + 6]  = d7;
    st[RK_DDR_DT + 7]  = d7 * 1.4471;
    st[RK_DDR_DT + 8]  = d7 * 1.6170;
    st[RK_DDR_DT + 9]  = d7 * 1.9265;
    st[RK_DDR_DT + 10] = d7 * 0.968;                      // NOT 2.5028
    st[RK_DDR_DT + 12] = st[RK_DDR_DT + 10] * 1.001;      // ~1 Hz beat vs dt11
    st[RK_DDR_DT + 11] = d7 * 2.6637;

    st[RK_DDR_E12 + 4] = 5.886297285230614
      * (0.5 + (idec > 1.0 ? 1.0 : idec) * 0.5)
      * (0.95 + 0.1 * rk_syn_dd_rand01(st + RK_DDR_SEED));
    st[RK_DDR_E12 + 1] = 0.13362501578292 * srate * af;
    st[RK_DDR_E12 + 2] = 7.264430222920869 / st[RK_DDR_E12 + 1];
    st[RK_DDR_E12 + 3] = 10 * 7.264430222920869 * isr_dec / 12.830314491926522;

    st[RK_DDR_E13 + 4] = 2.446983835532773;
    st[RK_DDR_E13 + 1] = 0.0013941882299170012 * srate * af;
    st[RK_DDR_E13 + 2] = 7.264430222920869 / st[RK_DDR_E13 + 1];
    st[RK_DDR_E13 + 3] = 7.264430222920869 * isr_dec2 / 11.784588871968632;

    st[RK_DDR_E2 + 4] = 5.112817165724925;
    st[RK_DDR_E2 + 1] = 0.023312507777462504 * srate * af;
    st[RK_DDR_E2 + 2] = 7.264430222920869 / st[RK_DDR_E2 + 1];
    st[RK_DDR_E2 + 3] = 7.264430222920869 * isr_dec2 / 2.082148383059353;

    st[RK_DDR_E3 + 4] = 13.459926564551697;
    st[RK_DDR_E3 + 1] = 0.0014790265731799877 * srate * af;
    st[RK_DDR_E3 + 2] = 7.264430222920869 / st[RK_DDR_E3 + 1];
    // ⚠️ 0.5417… here; the hat uses 0.2174…
    st[RK_DDR_E3 + 3] = 7.264430222920869 * isr_dec / 0.541747253516471457;
  );
);

// Ride type 0's dt5 / dt6: from TONE, piecewise about 0.5, times the pad's tune ratio -- latched ONCE here, at launch,
// after rk_syn_reset has latched TUNEF (it calls this last). The tick used to rebuild the two every sample from the
// same two launch-latched values, per voice (LIB342); this is the tick's arithmetic, so the increments are the same
// bits. Type 0 only: the other types' DT+4 / DT+5 are the reset's, scaled by the dispatcher's `*= f`.
function rk_syn_dd_ride_latch_dt56(st)
local(tn, d5, d6)
global(srate, RK_DDR_TYPE, RK_DDR_TONE, RK_DDR_TUNEF, RK_DDR_DT)
(
  st[RK_DDR_TYPE] == 0 ? (
    tn = st[RK_DDR_TONE];
    d5 = (tn < 0.5 ? 359.4 + 881.2 * tn : 450.09 + 699.8 * tn);
    d6 = (tn < 0.5 ? 254.3 + 571.4 * tn : 452.8 + 174.4 * tn);
    d5 *= st[RK_DDR_TUNEF] / srate; d6 *= st[RK_DDR_TUNEF] / srate;
    st[RK_DDR_DT + 4] = d5; st[RK_DDR_DT + 5] = d6;
  );
);

function rk_syn_dd_ride_tick(st)
local(oscs, oscs2, v1, v2, v3, metal2, nz, nz2, nz3, ss2, tt, d5, d6, tn)
global(srate,
       RK_DDR_SEED, RK_DDR_TYPE, RK_DDR_T, RK_DDR_DUTY, RK_DDR_TONE,
       RK_DDR_PH, RK_DDR_DT, RK_DDR_E12, RK_DDR_E13, RK_DDR_E2, RK_DDR_E3,
       RK_DDR_B1, RK_DDR_B3, RK_DDR_B4, RK_DDR_B2S, RK_DDR_B2K,
       RK_DDR_F1, RK_DDR_F2, RK_DDR_F3, RK_DDR_F4, RK_DDR_F5, RK_DDR_F6,
       RK_DDR_F7, RK_DDR_F8, RK_DDR_F9, RK_DDR_F10, RK_DDR_SH1, RK_DDR_SH2,
       RK_DDR_TUNEF)
(
  tt = st[RK_DDR_T];

  st[RK_DDR_TYPE] == 0 ? (
    // dt5/dt6 (TONE-swept, tune-scaled) were rebuilt here EVERY SAMPLE from two values latched at launch; since
    // 2026-10-26 rk_syn_dd_ride_latch_dt56 writes them once at launch, the same arithmetic (LIB342).
    d5 = st[RK_DDR_DT + 4]; d6 = st[RK_DDR_DT + 5];
    st[RK_DDR_PH + 0] += st[RK_DDR_DT + 0];
    st[RK_DDR_PH + 1] += st[RK_DDR_DT + 1];
    st[RK_DDR_PH + 2] += st[RK_DDR_DT + 2];
    st[RK_DDR_PH + 3] += st[RK_DDR_DT + 3];
    st[RK_DDR_PH + 4] += d5;
    st[RK_DDR_PH + 5] += d6;

    oscs = rk_syn_dd_sq(st[RK_DDR_PH+0], st[RK_DDR_DT+0], st[RK_DDR_DUTY])
         + rk_syn_dd_sq(st[RK_DDR_PH+1], st[RK_DDR_DT+1], st[RK_DDR_DUTY])
         + rk_syn_dd_sq(st[RK_DDR_PH+2], st[RK_DDR_DT+2], st[RK_DDR_DUTY])
         + rk_syn_dd_sq(st[RK_DDR_PH+3], st[RK_DDR_DT+3], st[RK_DDR_DUTY])
         + rk_syn_dd_sq(st[RK_DDR_PH+4], d5, st[RK_DDR_DUTY])
         + rk_syn_dd_sq(st[RK_DDR_PH+5], d6, st[RK_DDR_DUTY])
         + 0.1 * rk_syn_dd_rand01(st + RK_DDR_SEED);

    v1 = 2.40728073 * rk_syn_svf_bp(st + RK_DDR_F1, oscs);
    v2 = v3 = 3.324654 * rk_syn_svf_bp(st + RK_DDR_F2, oscs);

    st[RK_DDR_E12] += tt < st[RK_DDR_E12+1] ? st[RK_DDR_E12+2] * (st[RK_DDR_E12+4] - st[RK_DDR_E12]) : -st[RK_DDR_E12+3] * st[RK_DDR_E12];
    st[RK_DDR_E13] += tt < st[RK_DDR_E13+1] ? st[RK_DDR_E13+2] * (st[RK_DDR_E13+4] - st[RK_DDR_E13]) : -st[RK_DDR_E13+3] * st[RK_DDR_E13];
    st[RK_DDR_E2]  += tt < st[RK_DDR_E2+1]  ? st[RK_DDR_E2+2]  * (st[RK_DDR_E2+4]  - st[RK_DDR_E2])  : -st[RK_DDR_E2+3]  * st[RK_DDR_E2];
    st[RK_DDR_E3]  += tt < st[RK_DDR_E3+1]  ? st[RK_DDR_E3+2]  * (st[RK_DDR_E3+4]  - st[RK_DDR_E3])  : -st[RK_DDR_E3+3]  * st[RK_DDR_E3];
    st[RK_DDR_T] = tt + 1;

    // ⚠️ his `+ metal2 * s3` is DEAD - metal2 is a local he never assigns in
    // ride_tick_1. Ported as the 0 it always is.
    0.00012 * (
        rk_syn_svf_hp(st + RK_DDR_F3, v1) * st[RK_DDR_E12] * st[RK_DDR_E12]
      + 2.1493863499171737 * st[RK_DDR_E2] * st[RK_DDR_E2]
        * st[RK_DDR_E13] * st[RK_DDR_E13] * rk_syn_svf_hp(st + RK_DDR_F4, v2)
      + 3.1827788623083535 * st[RK_DDR_E3] * st[RK_DDR_E3]
        * rk_syn_svf_hp(st + RK_DDR_F5, v3));
  ) : st[RK_DDR_TYPE] == 1 ? (
    st[RK_DDR_PH + 0] += st[RK_DDR_DT + 0];
    st[RK_DDR_PH + 1] += st[RK_DDR_DT + 1];
    st[RK_DDR_PH + 2] += st[RK_DDR_DT + 2];
    st[RK_DDR_PH + 3] += st[RK_DDR_DT + 3];

    oscs = rk_syn_dd_saw(st[RK_DDR_PH+0], st[RK_DDR_DT+0])
         + rk_syn_dd_sq(st[RK_DDR_PH+1], st[RK_DDR_DT+1], st[RK_DDR_DUTY]) * st[RK_DDR_B1]
         + rk_syn_dd_saw(st[RK_DDR_PH+2], st[RK_DDR_DT+2])
         + rk_syn_dd_sq(st[RK_DDR_PH+3], st[RK_DDR_DT+3], st[RK_DDR_DUTY]);
    oscs  = rk_syn_dd_shift_tick(st + RK_DDR_SH1, oscs);
    oscs2 = rk_syn_dd_shift_tick(st + RK_DDR_SH2, oscs);
    // his crash block is behind a literal `0 ?` — dead, crash = crash_env = 0

    st[RK_DDR_B1] += tt < st[RK_DDR_B1+2] ? st[RK_DDR_B1+3] * (st[RK_DDR_B1+1] - st[RK_DDR_B1]) : -st[RK_DDR_B1+4] * st[RK_DDR_B1];
    st[RK_DDR_B3] += tt < st[RK_DDR_B3+2] ? st[RK_DDR_B3+3] * (st[RK_DDR_B3+1] - st[RK_DDR_B3]) : -st[RK_DDR_B3+4] * st[RK_DDR_B3];
    st[RK_DDR_B2S] *= st[RK_DDR_B2K];
    st[RK_DDR_B4] += tt < st[RK_DDR_B4+2] ? st[RK_DDR_B4+3] * (st[RK_DDR_B4+1] - st[RK_DDR_B4]) : -st[RK_DDR_B4+4] * st[RK_DDR_B4];
    st[RK_DDR_T] = tt + 1;

    v2 = (0.06 * st[RK_DDR_B1] + st[RK_DDR_B2S]) * (
        rk_syn_svf_bp(st + RK_DDR_F2, rk_syn_dd_rand01(st + RK_DDR_SEED) * 2.0 - 1.0)
      + rk_syn_svf_bp(st + RK_DDR_F3, rk_syn_dd_rand01(st + RK_DDR_SEED) * 2.0 - 1.0 + oscs)
      + rk_syn_svf_bp(st + RK_DDR_F4, rk_syn_dd_rand01(st + RK_DDR_SEED) * 2.0 - 1.0)
      + rk_syn_svf_bp(st + RK_DDR_F5, rk_syn_dd_rand01(st + RK_DDR_SEED) * 2.0 - 1.0)
      + rk_syn_svf_bp(st + RK_DDR_F6, rk_syn_dd_rand01(st + RK_DDR_SEED) * 2.0 - 1.0 + oscs)
      + rk_syn_svf_bp(st + RK_DDR_F7, rk_syn_dd_rand01(st + RK_DDR_SEED) * 2.0 - 1.0 + oscs));

    v3 = 0.6 * (rk_syn_svf_hp(st + RK_DDR_F1, oscs) * st[RK_DDR_B1]
              + rk_syn_svf_hp(st + RK_DDR_F8,
                  rk_syn_dd_rand01(st + RK_DDR_SEED) * 0.5 - 0.25 + 0.4 * oscs2)
                * st[RK_DDR_B3]);

    v1 = v2 + v3;
    v1 + v1;
  ) : (
    st[RK_DDR_PH + 0] += st[RK_DDR_DT + 0];
    st[RK_DDR_PH + 1] += st[RK_DDR_DT + 1];
    st[RK_DDR_PH + 2] += st[RK_DDR_DT + 2];
    st[RK_DDR_PH + 3] += st[RK_DDR_DT + 3];
    oscs = rk_syn_dd_sq(st[RK_DDR_PH+0], st[RK_DDR_DT+0], 0.5)
         + rk_syn_dd_sq(st[RK_DDR_PH+1], st[RK_DDR_DT+1], 0.5)
         + rk_syn_dd_sq(st[RK_DDR_PH+2], st[RK_DDR_DT+2], 0.5)
         + rk_syn_dd_sq(st[RK_DDR_PH+3], st[RK_DDR_DT+3], 0.5);

    st[RK_DDR_PH + 6]  += st[RK_DDR_DT + 6];
    st[RK_DDR_PH + 7]  += st[RK_DDR_DT + 7];
    st[RK_DDR_PH + 8]  += st[RK_DDR_DT + 8];
    st[RK_DDR_PH + 9]  += st[RK_DDR_DT + 9];
    st[RK_DDR_PH + 10] += st[RK_DDR_DT + 10];
    st[RK_DDR_PH + 11] += st[RK_DDR_DT + 11];
    st[RK_DDR_PH + 4]  += st[RK_DDR_DT + 4];
    st[RK_DDR_PH + 5]  += st[RK_DDR_DT + 5];
    st[RK_DDR_PH + 12] += st[RK_DDR_DT + 12];

    // ⚠️ asymmetric duty cycles: 0.15 / 0.5 / 0.5 / 0.85 / 0.25
    metal2 = 0.003 * (
        rk_syn_dd_sq(st[RK_DDR_PH+6],  st[RK_DDR_DT+6],  0.15)
      + rk_syn_dd_sq(st[RK_DDR_PH+7],  st[RK_DDR_DT+7],  0.5)
      + rk_syn_dd_sq(st[RK_DDR_PH+8],  st[RK_DDR_DT+8],  0.5)
      + rk_syn_dd_sq(st[RK_DDR_PH+9],  st[RK_DDR_DT+9],  0.85)
      + rk_syn_dd_sq(st[RK_DDR_PH+11], st[RK_DDR_DT+11], 0.25)
      + 0.009 * rk_syn_dd_sq(st[RK_DDR_PH+5], st[RK_DDR_DT+5], 0.5) * st[RK_DDR_E3]
      + 0.906 * (rk_syn_dd_sq(st[RK_DDR_PH+12], st[RK_DDR_DT+12], 0.5)
               + rk_syn_dd_sq(st[RK_DDR_PH+10], st[RK_DDR_DT+10], 0.5))
      + 0.006 * rk_syn_dd_sq(st[RK_DDR_PH+4], st[RK_DDR_DT+4], 0.5) * st[RK_DDR_E3])
      + 0.0044 * (rk_syn_dd_rand01(st + RK_DDR_SEED) - 0.5);

    v3 = v2 = 25 * rk_syn_svf_bp(st + RK_DDR_F2, oscs);

    st[RK_DDR_E12] += tt < st[RK_DDR_E12+1] ? st[RK_DDR_E12+2] * (st[RK_DDR_E12+4] - st[RK_DDR_E12]) : -st[RK_DDR_E12+3] * st[RK_DDR_E12];
    st[RK_DDR_E13] += tt < st[RK_DDR_E13+1] ? st[RK_DDR_E13+2] * (st[RK_DDR_E13+4] - st[RK_DDR_E13]) : -st[RK_DDR_E13+3] * st[RK_DDR_E13];
    st[RK_DDR_E2]  += tt < st[RK_DDR_E2+1]  ? st[RK_DDR_E2+2]  * (st[RK_DDR_E2+4]  - st[RK_DDR_E2])  : -st[RK_DDR_E2+3]  * st[RK_DDR_E2];
    st[RK_DDR_E3]  += tt < st[RK_DDR_E3+1]  ? st[RK_DDR_E3+2]  * (st[RK_DDR_E3+4]  - st[RK_DDR_E3])  : -st[RK_DDR_E3+3]  * st[RK_DDR_E3];
    st[RK_DDR_T] = tt + 1;

    ss2 = st[RK_DDR_E2] * st[RK_DDR_E2];
    nz  = (rk_syn_dd_rand01(st + RK_DDR_SEED) - 0.5) * ss2 * st[RK_DDR_E12];
    nz2 = 2 * ((rk_syn_dd_rand01(st + RK_DDR_SEED)
              * rk_syn_dd_rand01(st + RK_DDR_SEED) - 0.5) * ss2);
    nz3 = (rk_syn_dd_rand01(st + RK_DDR_SEED) - 0.5) * ss2;

    0.001 * (
        1.7   * rk_syn_svf_bp(st + RK_DDR_F6, nz)
      + 2.0   * rk_syn_svf_bp(st + RK_DDR_F1, nz3)
      + 0.2   * rk_syn_svf_bp(st + RK_DDR_F7, nz)
      + 0.35  * rk_syn_svf_bp(st + RK_DDR_F8, nz)
      + 0.416 * rk_syn_svf_bp(st + RK_DDR_F9, nz2 + nz3))
    + 0.00007 * (
        1.0493863499171737 * ss2 * st[RK_DDR_E13] * st[RK_DDR_E13]
          * rk_syn_svf_hp(st + RK_DDR_F4, v2 + 0.6 * nz2)
      + 2.1827788623083535 * st[RK_DDR_E3] * st[RK_DDR_E3]
          * rk_syn_svf_hp(st + RK_DDR_F5, v3))
    + metal2 * st[RK_DDR_E3] * st[RK_DDR_E13];
  );
);

