// knobs_kbsg_p2.jsfx-inc -- part 2 of knobs_kbsg.jsfx-inc (4 parts), cut at a function boundary by
// .dev_tests/split_big_incs.py: REAPER's load time grows with the square of a file's size. Edit freely;
// keep each file under about 40 KB.

// ⚠️ @init IS LOAD-BEARING (.docs/wiki/02-file-structure.md).
@init

// Draw: dark track arc, colored fill arc, inner circle, dot indicator
function ws_knob_draw(cx, cy, radius, value, vmin, vmax, is_sym, hover_t,
                       cr, cg, cb, bgr, bgg, bgb)
local(n_passes, pass_gap, inner_r, dot_orbit, dot_r, dot_r_h,
      scale, voffset, val_deg, val_rad, arc_alpha, start_rad, i, RAD130_)
(
  RAD130_ = 130 * $pi / 180;
  n_passes = max(2, floor(radius / 5));
  pass_gap = 0.5;
  inner_r = radius * 0.75;
  dot_orbit = radius * 0.5;
  dot_r = radius * 0.15;
  arc_alpha = lerp(0.6, 1.0, pow(hover_t, 2));
  dot_r_h = dot_r * lerp(1.0, 1.3, pow(hover_t, 2));
  scale = 260 / (vmax - vmin);
  voffset = -vmin * 260 / (vmax - vmin) - 130;
  val_deg = value * scale + voffset;
  val_rad = val_deg * $pi / 180;
  // Background track arc
  gfx_set(bgr, bgg, bgb, 1);
  i = 0;
  loop(n_passes,
    gfx_arc(cx, cy, radius - i * pass_gap, -RAD130_, RAD130_, 1);
    i += 1;
  );
  // Inner circle
  gfx_set(0.08, 0.08, 0.10, 1);
  gfx_circle(cx, cy, inner_r, 1, 1);
  // Active arc
  gfx_set(cr, cg, cb, arc_alpha);
  start_rad = is_sym ? (is_sym < 1 ? (is_sym * 2 - 1) * RAD130_ : 0) : -RAD130_;
  i = 0;
  loop(n_passes,
    gfx_arc(cx, cy, radius - i * pass_gap, start_rad, val_rad, 1);
    i += 1;
  );
  // Dot indicator
  gfx_set(cr, cg, cb, arc_alpha);
  gfx_circle(cx - sin(-val_rad) * dot_orbit,
             cy - cos(-val_rad) * dot_orbit, dot_r_h, 1);
  // Hover ring
  hover_t > 0.01 ? (
    gfx_set(cr, cg, cb, 0.3 * arc_alpha);
    gfx_circle(cx, cy, inner_r, 0);
  );
);

// Interact: continuous drag, scroll, double-click
function ws_knob_interact(mem, cx, cy, radius, cur_val, vmin, vmax, vdefault)
local(hover, d, new_val, fine, step, now)
(
  d = dist(mx, my, cx, cy);
  hover = (d <= radius);
  hover || mem[1] ? (
    mem[0] = min(mem[0] + dt * hv_speed, 1);
  ) : (
    mem[0] = max(mem[0] - dt * hv_speed, 0);
  );
  mem[6] = hover || mem[1];
  new_val = cur_val;
  mem[5] = 0;

  // Right-click resets to the caller's default. This lived only in bb/jo/sp
  // and the encoder, none of which rk_knob_interact ever reaches -- so the
  // gesture existed and no plugin using the dispatcher could fire it.
  hover && rmb_down ? ( new_val = vdefault; mem[5] = 1; );

  // Double-click
  hover && lmb_down ? (
    now = time_precise();
    (now - mem[4] < RK_DBLCLICK_T) ? ( new_val = vdefault; mem[5] = 1; );
    mem[4] = now;
  );
  // Start drag (skip if double-click just fired)
  lmb_down && hover && !mem[1] && !mem[5] ? (
    mem[1] = 2;          // pressed: rk_drag_live starts the drag past the deadzone
    mem[2] = my;
    mem[3] = cur_val;
    _rk_drag_mod = rk_drag_mods();
  );
  // Continue drag (a modifier change re-anchors it: rk_drag_mods)
  rk_drag_live(mem, LMB && !_srf_foreign, cur_val) ? (
    rk_drag_mods() != _rk_drag_mod ? ( mem[2] = my; mem[3] = cur_val; _rk_drag_mod = rk_drag_mods(); );
    fine = CTRL ? 0.1 : SHIFT ? 0.025 : 1;
    step = (mem[2] - my) / (radius * 4) * (vmax - vmin) * fine;
    new_val = clamp(mem[3] + step, vmin, vmax);
  );
  // End drag
  mem[1] && !LMB ? (
    mem[1] = 0;
    mem[5] = 1;
  );
  // Scroll
  hover && frame_wheel != 0 ? (
    step = (vmax - vmin) * (CTRL ? 0.005 : SHIFT ? 0.002 : 0.02) * frame_wheel;
    new_val = clamp(cur_val + step, vmin, vmax);
    mem[5] = 1;
    frame_wheel = 0;   // consumed (see the header)
  );
  new_val;
);


// ═══════════════════════════════════════════════════════════════════════════
// 5. SSL 4000 E
// ═══════════════════════════════════════════════════════════════════════════

// Draw: the SSL E-Series knob, measured 2026-09-24 on SSL's own photo of its
// E-Series EQ module (SSL's 4K E plug-in draws the same knob): a LARGE flat colour
// cap, a light-grey rim round it, a grey fluted skirt, and a white bar painted on
// the cap from the centre to its edge. R = the skirt's outer edge: cap 0.74R
// (0.78R at full hover — the cap grows, as before), rim to 0.88R, 24 flutes to R,
// lit from the top-left, a soft shadow below-right (it reaches ~1.12R there).
// Unchanged: a light cap (Rec.601 luma > 0.6) gets a dark bar; n_detents > 0
// draws the detent-dot ring at 1.25R.
function ssl_knob_draw(cx, cy, radius, value, vmin, vmax, is_sym, hover_t,
                        cr, cg, cb, n_detents)
local(ht, val_rad, cap, rim, i, a, sh, f, n, w, det_step, active_det, da, dx, dy)
(
  ht = hover_t * hover_t;
  val_rad = ((value - vmin) / max(0.0000001, vmax - vmin) * 260 - 130) * $pi / 180;
  cap = radius * (0.74 + 0.04 * ht);
  rim = radius * 0.88;

  // soft shadow away from the light (Studio: below-right)
  rk_lt();
  rk_lt_shadow(cx, cy, radius * 0.06, radius * 0.10, radius * 1.02, 0.18, 1);
  rk_lt_shadow(cx, cy, radius * 0.04, radius * 0.06, radius, 0.22, 1);

  // fluted skirt: lit toward the light, shade away from it; 24 flutes
  rk_lt_vdisc(cx, cy, radius, 0.66, 0.67, 0.68, 0.36, 0.36, 0.37);
  n = 24; w = max(1, radius * 0.035);
  i = 0;
  loop(n,
    a = i * 2 * $pi / n;
    sh = rk_lt_rim(a);                        // 1 facing the light (Studio: top-left), 0 away
    gfx_set(0.26 + 0.20 * sh, 0.26 + 0.20 * sh, 0.27 + 0.20 * sh, 1);
    rk_kn_ray(cx, cy, a, rim, radius - 0.5, w);
    i += 1;
  );
  gfx_set(0.20, 0.20, 0.21, 0.9); gfx_circle(cx, cy, radius, 0, 1);

  // rim: a light-grey band round the cap, lit toward the light
  n = 12;
  i = 0;
  loop(n,
    a = -$pi + i * 2 * $pi / n;
    sh = rk_lt_rim(a + $pi / n);
    f = 0.60 + 0.20 * sh;
    gfx_set(f, f + 0.01, f + 0.01, 1);
    rk_kn_band(cx, cy, cap, rim, a, a + 2 * $pi / n + 0.02);
    i += 1;
  );

  // flat colour cap, a touch lighter at the top, a dark seam at its edge
  rk_lt_vdisc(cx, cy, cap, min(cr + 0.05, 1), min(cg + 0.05, 1), min(cb + 0.05, 1), cr * 0.85, cg * 0.85, cb * 0.85);
  gfx_set(cr * 0.45, cg * 0.45, cb * 0.45, 1); gfx_circle(cx, cy, cap, 0, 1);
  gfx_set(cr * 0.45, cg * 0.45, cb * 0.45, 0.6); gfx_circle(cx, cy, cap + 0.6, 0, 1);

  // painted pointer bar, centre -> cap edge; a light cap gets a dark bar
  (cr * 0.299 + cg * 0.587 + cb * 0.114) > 0.6 ? gfx_set(0.12, 0.12, 0.14, 1) : gfx_set(0.95, 0.96, 0.96, 1);
  rk_ss_ray(cx, cy, val_rad, cap * 0.05, cap * 0.97, max(1.5, cap * 0.22));

  // Detent dots
  det_step = (vmax - vmin) / max(1, n_detents - 1);
  active_det = floor((value - vmin) / det_step + 0.5);
  i = 0;
  loop(n_detents,
    da = (-130 + i * 260 / max(1, n_detents - 1)) * $pi / 180;
    dx = cx + sin(da) * radius * 1.25;
    dy = cy - cos(da) * radius * 1.25;
    i == active_det ? (
      gfx_set(cr, cg, cb, 1);
      gfx_circle(dx, dy, radius * 0.08, 1);
    ) : (
      gfx_set(0.4, 0.4, 0.4, 0.5 + 0.3 * ht);
      gfx_circle(dx, dy, radius * 0.05, 1);
    );
    i += 1;
  );
);

// Interact: continuous drag, DETENTED scroll, double-click
function ssl_knob_interact(mem, cx, cy, radius, cur_val, vmin, vmax, vdefault, n_detents)
local(hover, d, new_val, fine, step, now, det_step, cur_det, new_det)
(
  d = dist(mx, my, cx, cy);
  hover = (d <= radius);
  hover || mem[1] ? (
    mem[0] = min(mem[0] + dt * hv_speed, 1);
  ) : (
    mem[0] = max(mem[0] - dt * hv_speed, 0);
  );
  mem[6] = hover || mem[1];
  new_val = cur_val;
  mem[5] = 0;

  // Right-click resets to the caller's default. This lived only in bb/jo/sp
  // and the encoder, none of which rk_knob_interact ever reaches -- so the
  // gesture existed and no plugin using the dispatcher could fire it.
  hover && rmb_down ? ( new_val = vdefault; mem[5] = 1; );

  // Double-click
  hover && lmb_down ? (
    now = time_precise();
    (now - mem[4] < RK_DBLCLICK_T) ? ( new_val = vdefault; mem[5] = 1; );
    mem[4] = now;
  );
  // Start drag (skip if double-click just fired)
  lmb_down && hover && !mem[1] && !mem[5] ? (
    mem[1] = 2;          // pressed: rk_drag_live starts the drag past the deadzone
    mem[2] = my;
    mem[3] = cur_val;
    _rk_drag_mod = rk_drag_mods();
  );
  // Continue drag (continuous; a modifier change re-anchors it: rk_drag_mods)
  rk_drag_live(mem, LMB && !_srf_foreign, cur_val) ? (
    rk_drag_mods() != _rk_drag_mod ? ( mem[2] = my; mem[3] = cur_val; _rk_drag_mod = rk_drag_mods(); );
    fine = CTRL ? 0.1 : SHIFT ? 0.025 : 1;
    // Scale drag travel so it always takes ~200px for full range (prevents snapping on large ranges)
    step = (mem[2] - my) / max(radius * 4, 200) * (vmax - vmin) * fine;
    new_val = clamp(mem[3] + step, vmin, vmax);
  );
  // End drag
  mem[1] && !LMB ? (
    mem[1] = 0;
    mem[5] = 1;
  );
  // Scroll — detented or smooth
  hover && frame_wheel != 0 ? (
    n_detents > 1 ? (
      // Detented: snap to discrete steps
      det_step = (vmax - vmin) / max(1, n_detents - 1);
      cur_det = floor((cur_val - vmin) / det_step + 0.5);
      new_det = clamp(cur_det + sign_of(frame_wheel), 0, n_detents - 1);
      new_val = vmin + new_det * det_step;
    ) : (
      // Smooth: 2% of range per scroll tick (fine with CTRL)
      _scl = CTRL ? 0.005 : SHIFT ? 0.002 : 0.02;
      new_val = clamp(cur_val + frame_wheel * (vmax - vmin) * _scl, vmin, vmax);
    );
    mem[5] = 1;
    frame_wheel = 0;   // consumed (see the header)
  );
  new_val;
);


// ═══════════════════════════════════════════════════════════════════════════
// 6. PULTEC EQP-1A
// ═══════════════════════════════════════════════════════════════════════════
// Interact: rk_knob_interact (ssl_knob_interact), like every style; drawn through
// rk_knob_draw style 12.

// Draw: authentic EQP-1A — black bakelite, ridged side wall, silver-white pointer
function pultec_knob_draw(cx, cy, radius, value, vmin, vmax, hover_t)
local(ht, scale, voffset, val_rad, i, ta, ra, t, sh, hwv, pxp, pyp, sxp, cyp)
(
  ht = pow(hover_t, 2);
  scale = 260 / (vmax - vmin);
  voffset = -vmin * 260 / (vmax - vmin) - 130;
  val_rad = (value * scale + voffset) * $pi / 180;
  // Warm-grey panel tick scale
  i = 0;
  loop(11,
    ta = (-130 + i * 26) * $pi / 180;
    gfx_set(0.55, 0.53, 0.47, lerp(0.40, 0.62, ht));
    gfx_line(cx + sin(ta) * radius * 0.99, cy - cos(ta) * radius * 0.99,
             cx + sin(ta) * radius * 1.12, cy - cos(ta) * radius * 1.12);
    i += 1;
  );
  // Drop shadow (away from the light) + black side wall
  rk_lt();
  rk_lt_shadow(cx, cy, 1, 2, radius, 0.50, 1);
  gfx_set(0.05, 0.05, 0.055, 1);
  gfx_circle(cx, cy, radius, 1);
  // Fine side-wall ridges
  i = 0;
  loop(36,
    ra = i / 36 * 2 * $pi;
    gfx_set(1, 1, 1, 0.06);
    gfx_line(cx + sin(ra) * radius * 0.86, cy - cos(ra) * radius * 0.86,
             cx + sin(ra) * radius * 0.99, cy - cos(ra) * radius * 0.99);
    i += 1;
  );
  // Charcoal top disc, light drifting toward the light (Studio: top-left)
  rk_lt_turn(-radius * 0.08, -radius * 0.10);
  i = 0;
  loop(9,
    t = i / 8;
    sh = rk_lt_ramp(0.065, 0.235 - 0.065, t * t);
    gfx_set(sh, sh, sh + 0.008, 1);
    // The disc swells toward the side wall on hover; the wall and the panel
    // ticks stay put, so nothing covers the scale.
    gfx_circle(cx + rk_lt_x * t, cy + rk_lt_y * t,
               radius * lerp(0.84, 0.90, ht) * (1 - t * 0.55), 1);
    i += 1;
  );
  gfx_set(1, 1, 1, lerp(0.10, 0.25, ht));
  gfx_circle(cx, cy, radius * lerp(0.84, 0.90, ht), 0);
  // Silver-white pointer line w/ dark edging (quads)
  pxp = cos(val_rad); pyp = sin(val_rad); sxp = sin(val_rad); cyp = cos(val_rad);
  hwv = radius * 0.055;
  gfx_set(0, 0, 0, 0.45);
  gfx_triangle(cx + sxp * radius * 0.14 + pxp * hwv, cy - cyp * radius * 0.14 + pyp * hwv,
               cx + sxp * radius * 0.14 - pxp * hwv, cy - cyp * radius * 0.14 - pyp * hwv,
               cx + sxp * radius * 0.82 - pxp * hwv, cy - cyp * radius * 0.82 - pyp * hwv,
               cx + sxp * radius * 0.82 + pxp * hwv, cy - cyp * radius * 0.82 + pyp * hwv);
  hwv = radius * 0.0375;
  gfx_set(0.85, 0.86, 0.89, 1);
  gfx_triangle(cx + sxp * radius * 0.14 + pxp * hwv, cy - cyp * radius * 0.14 + pyp * hwv,
               cx + sxp * radius * 0.14 - pxp * hwv, cy - cyp * radius * 0.14 - pyp * hwv,
               cx + sxp * radius * 0.80 - pxp * hwv, cy - cyp * radius * 0.80 - pyp * hwv,
               cx + sxp * radius * 0.80 + pxp * hwv, cy - cyp * radius * 0.80 + pyp * hwv);
  // Hover glow (cool silver)
  hover_t > 0.01 ? (
    gfx_set(0.70, 0.72, 0.78, 0.14 * ht);
    gfx_circle(cx, cy, radius + 2, 0);
    gfx_circle(cx, cy, radius + 3, 0);
    gfx_circle(cx, cy, radius + 4, 0);
  );
);

// Draw: Pultec Cream (style 19) — Tube-Tech PE 1C: cream body, painted black pointer
function pultec_cream_knob_draw(cx, cy, radius, value, vmin, vmax, hover_t)
local(ht, scale, voffset, val_rad, i, ta, t, hwv, pxp, pyp, sxp, cyp)
(
  ht = pow(hover_t, 2);
  scale = 260 / (vmax - vmin);
  voffset = -vmin * 260 / (vmax - vmin) - 130;
  val_rad = (value * scale + voffset) * $pi / 180;
  // Warm panel tick scale
  i = 0;
  loop(11,
    ta = (-130 + i * 26) * $pi / 180;
    gfx_set(0.62, 0.60, 0.52, lerp(0.45, 0.68, ht));
    gfx_line(cx + sin(ta) * radius * 0.99, cy - cos(ta) * radius * 0.99,
             cx + sin(ta) * radius * 1.12, cy - cos(ta) * radius * 1.12);
    i += 1;
  );
  radius = radius * (1 + 0.06 * ht);   // body swells on hover; the panel ticks stay put
  // Drop shadow (away from the light) + cream body (a gradient drifting toward the
  // light; Studio: straight up)
  rk_lt();
  rk_lt_shadow(cx, cy, 1.5, 2.5, radius * 0.92, 0.35, 1);
  rk_lt_turn(0, -radius * 0.09);
  i = 0;
  loop(7,
    t = i / 6;
    gfx_set(rk_lt_ramp(0.80, 0.94 - 0.80, t), rk_lt_ramp(0.75, 0.91 - 0.75, t), rk_lt_ramp(0.60, 0.81 - 0.60, t), 1);
    gfx_circle(cx + rk_lt_x * t, cy + rk_lt_y * t, radius * 0.92 * (1 - t * 0.50), 1);
    i += 1;
  );
  gfx_set(0.20, 0.18, 0.13, 0.8);
  gfx_circle(cx, cy, radius * 0.92, 0);
  gfx_circle(cx, cy, radius * 0.92 - 0.5, 0);
  // Painted black pointer w/ soft edging (quads)
  pxp = cos(val_rad); pyp = sin(val_rad); sxp = sin(val_rad); cyp = cos(val_rad);
  hwv = radius * 0.058;
  gfx_set(0.35, 0.32, 0.24, 0.5);
  gfx_triangle(cx + sxp * radius * 0.06 + pxp * hwv, cy - cyp * radius * 0.06 + pyp * hwv,
               cx + sxp * radius * 0.06 - pxp * hwv, cy - cyp * radius * 0.06 - pyp * hwv,
               cx + sxp * radius * 0.86 - pxp * hwv, cy - cyp * radius * 0.86 - pyp * hwv,
               cx + sxp * radius * 0.86 + pxp * hwv, cy - cyp * radius * 0.86 + pyp * hwv);
  hwv = radius * 0.0425;
  gfx_set(0.08, 0.075, 0.055, 1);
  gfx_triangle(cx + sxp * radius * 0.06 + pxp * hwv, cy - cyp * radius * 0.06 + pyp * hwv,
               cx + sxp * radius * 0.06 - pxp * hwv, cy - cyp * radius * 0.06 - pyp * hwv,
               cx + sxp * radius * 0.84 - pxp * hwv, cy - cyp * radius * 0.84 - pyp * hwv,
               cx + sxp * radius * 0.84 + pxp * hwv, cy - cyp * radius * 0.84 + pyp * hwv);
  // Hover glow (warm)
  hover_t > 0.01 ? (
    gfx_set(0.6, 0.5, 0.25, 0.12 * ht);
    gfx_circle(cx, cy, radius + 2, 0);
    gfx_circle(cx, cy, radius + 3, 0);
    gfx_circle(cx, cy, radius + 4, 0);
  );
);


// ═══════════════════════════════════════════════════════════════════════════
// 7. API 550A  (the API 550A knob: a warm-white fin knob round a blue collar and a grey cap)
// ═══════════════════════════════════════════════════════════════════════════
// Matched 2026-09-25 to API's own photo of the 550A Discrete 3 Band EQ (the HF knob).
// rb = the white body's radius. The outer knob is WARM WHITE plastic: a round body with
// three rounded lobes (at 3, 6 and 9 o'clock from the pointer, out to 1.15 rb) and a long
// tapered POINTER FIN, lit from above (#fbf8f3 on top, #8f766f in the shade below).
// Inside it sits the concentric inner knob: a BLUE collar 0.67–0.80 rb with four small
// scallops, a dark seam, and a flat warm-grey cap 0.60 rb. On the unit they are two
// controls (the collar is the frequency switch); here the white knob turns with the
// value and the collar and cap stay put. The fin tip sits at R, so rb = R / 1.6 (the
// real fin is ~9 % longer) and nothing reaches past the knob's footprint. The collar is
// the accent (dot_r/g/b). Sweep ±150° (the 550A's gain scale ends at about ±155°).
// is_sym is unused (signature parity). Hover: the knob grows 4 %.
// api_ring_draw and api_dual_interact below (the dual-concentric ring) are unchanged.
function api_knob_draw(cx, cy, radius, value, vmin, vmax, is_sym, hover_t,
                       dot_r, dot_g, dot_b)
local(ht, SW, rng, t, a, rb, i, la, lx, ly, f, ux, uy, px, py, r0, r1, w0, w1,
      x0, y0, x1, y1, tr, tg, tb, br_, bg_, bb_, fx, fy)
(
  ht = hover_t * hover_t;
  SW = 150 * $pi / 180;
  rng = vmax - vmin;
  t = abs(rng) > 0.0000001 ? min(max((value - vmin) / rng, 0), 1) : 0;
  a = -SW + t * 2 * SW;
  rb = radius / 1.6 * (1 + 0.04 * ht);
  tr = 0.98; tg = 0.965; tb = 0.95;                  // lit white (top)
  br_ = 0.58; bg_ = 0.50; bb_ = 0.47;                // shaded white (bottom)
  // (the shading below divides a height by rb: a knob of no size takes the middle shade)

  // soft shadow away from the light (Studio: below-right of the whole knob)
  rk_lt();
  rk_lt_shadow(cx, cy, rb * 0.06, rb * 0.10, rb * 1.05, 0.28, 1);

  // the fin: a tapered quad and a rounded tip, coloured by the light at its middle
  // (this knob's Studio light comes from straight above: rk_lt_shade)
  ux = sin(a); uy = -cos(a); px = -uy; py = ux;
  r0 = rb * 0.70; r1 = rb * 1.45; w0 = rb * 0.28; w1 = rb * 0.15;
  x0 = cx + ux * r0; y0 = cy + uy * r0; x1 = cx + ux * r1; y1 = cy + uy * r1;
  fx = cx + ux * rb * 1.1; fy = cy + uy * rb * 1.1;
  f = rb > 0 ? rk_lt_shade(fx - cx, fy - cy, 2.4 * rb) : 0.5;
  gfx_set(tr + (br_ - tr) * f, tg + (bg_ - tg) * f, tb + (bb_ - tb) * f, 1);
  gfx_triangle(x0 + px * w0, y0 + py * w0, x1 + px * w1, y1 + py * w1,
               x1 - px * w1, y1 - py * w1, x0 - px * w0, y0 - py * w0);
  gfx_circle(x1, y1, w1, 1, 1);

  // three lobes, each coloured by the light at its centre
  i = 1;
  loop(3,
    la = a + i * $pi / 2;
    lx = cx + sin(la) * rb * 0.85; ly = cy - cos(la) * rb * 0.85;
    f = rb > 0 ? rk_lt_shade(lx - cx, ly - cy, 2.4 * rb) : 0.5;
    gfx_set(tr + (br_ - tr) * f, tg + (bg_ - tg) * f, tb + (bb_ - tb) * f, 1);
    gfx_circle(lx, ly, rb * 0.30, 1, 1);
    i += 1;
  );

  // the round body over the roots of the fin and lobes
  rk_lt_vdisc(cx, cy, rb, tr + (br_ - tr) * 0.083, tg + (bg_ - tg) * 0.083, tb + (bb_ - tb) * 0.083,
              tr + (br_ - tr) * 0.917, tg + (bg_ - tg) * 0.917, tb + (bb_ - tb) * 0.917);
  gfx_set(tr + (br_ - tr) * 0.5, tg + (bg_ - tg) * 0.5, tb + (bb_ - tb) * 0.5, 0.6); gfx_circle(cx, cy, rb, 0, 1);

  // the inner knob: the collar with four small scallops (fixed), a dark seam, the grey cap
  gfx_set(0, 0, 0, 0.25); gfx_circle(cx, cy, rb * 0.83, 1, 1);
  i = 0;
  loop(4,
    la = $pi / 4 + i * $pi / 2;
    lx = cx + sin(la) * rb * 0.78; ly = cy - cos(la) * rb * 0.78;
    f = rb > 0 ? rk_lt_shade(lx - cx, ly - cy, 1.8 * rb) : 0.5;
    gfx_set(dot_r * (1 - 0.28 * f), dot_g * (1 - 0.28 * f), dot_b * (1 - 0.28 * f), 1);
    gfx_circle(lx, ly, rb * 0.14, 1, 1);
    i += 1;
  );
  rk_lt_vdisc(cx, cy, rb * 0.80, dot_r, dot_g, dot_b, dot_r * 0.72, dot_g * 0.72, dot_b * 0.72);
  gfx_set(dot_r * 0.5, dot_g * 0.5, dot_b * 0.5, 0.8); gfx_circle(cx, cy, rb * 0.80, 0, 1);
  gfx_set(0.10, 0.10, 0.12, 1); gfx_circle(cx, cy, rb * 0.66, 1, 1);
  rk_lt_vdisc(cx, cy, rb * 0.60, 0.80, 0.76, 0.745, 0.73, 0.69, 0.68);
  gfx_set(0.55, 0.52, 0.51, 0.7); gfx_circle(cx, cy, rb * 0.60, 0, 1);
);

// Draw outer freq ring: chrome ring with colored step dots
function api_ring_draw(cx, cy, r_in, r_out, freq_val, fmin, fmax, n_steps, hover_t,
                        rr, rg, rb)
local(ht, cd, i, da, dx, dy, active, ss, dr_)
(
  ht = pow(hover_t, 2);
  cd = lerp(0.35, 0.50, ht);
  gfx_set(cd, cd, cd + 0.02, 1);
  gfx_circle(cx, cy, r_out, 1);
  gfx_set(0.08, 0.08, 0.10, 1);
  gfx_circle(cx, cy, r_in + 1, 1);
  gfx_set(0.50, 0.50, 0.52, 1);
  gfx_circle(cx, cy, r_out, 0);
  ss = (fmax - fmin) / max(1, n_steps - 1);
  active = floor((freq_val - fmin) / ss + 0.5);
  dr_ = (r_out - r_in) * 0.25;
  i = 0;
  loop(n_steps,
    da = (-130 + i * 260 / max(1, n_steps - 1)) * $pi / 180;
    dx = cx + sin(da) * (r_in + (r_out - r_in) * 0.5);
    dy = cy - cos(da) * (r_in + (r_out - r_in) * 0.5);
    i == active ? (
      gfx_set(rr, rg, rb, 1);
      gfx_circle(dx, dy, dr_ * 1.6, 1);
    ) : (
      gfx_set(0.55, 0.55, 0.55, lerp(0.5, 0.8, ht));
      gfx_circle(dx, dy, dr_, 1);
    );
    i += 1;
  );
);

// Interact dual-concentric: drag=inner (gain), scroll=outer (freq stepped)
// Returns new inner value. Outer value stored in mo[7].
function api_dual_interact(mi, mo, cx, cy, ri, ro,
                           cur_i, imin, imax, idef,
                           cur_o, omin, omax, odef, o_steps)
local(d, hover, ni, no_, fine, step, now, ds, cd, nd)
(
  d = dist(mx, my, cx, cy);
  hover = (d <= ro);
  hover || mi[1] ? (
    mi[0] = min(mi[0] + dt * hv_speed, 1);
    mo[0] = mi[0];
  ) : (
    mi[0] = max(mi[0] - dt * hv_speed, 0);
    mo[0] = mi[0];
  );
  mi[6] = hover || mi[1];
  mo[6] = mi[6];
  ni = cur_i;
  no_ = cur_o;
  mi[5] = 0;
  mo[5] = 0;
  // Double-click reset both
  hover && lmb_down ? (
    now = time_precise();
    (now - mi[4] < 0.3) ? (
      ni = idef; mi[5] = 1;
      no_ = odef; mo[5] = 1;
    );
    mi[4] = now;
  );
  // Drag inner (skip if double-click just fired)
  lmb_down && hover && !mi[1] && !mi[5] ? (
    mi[1] = 2;           // pressed: rk_drag_live starts the drag past the deadzone
    mi[2] = my;
    mi[3] = cur_i;
    _rk_drag_mod = rk_drag_mods();
  );
  // (a modifier change re-anchors the drag: rk_drag_mods)
  rk_drag_live(mi, LMB && !_srf_foreign, cur_i) ? (
    rk_drag_mods() != _rk_drag_mod ? ( mi[2] = my; mi[3] = cur_i; _rk_drag_mod = rk_drag_mods(); );
    fine = CTRL ? 0.1 : SHIFT ? 0.025 : 1;
    step = (mi[2] - my) / (ri * 4) * (imax - imin) * fine;
    ni = clamp(mi[3] + step, imin, imax);
  );
  mi[1] && !LMB ? (
    mi[1] = 0;
    mi[5] = 1;
  );
  // Scroll outer (stepped)
  hover && frame_wheel != 0 ? (
    ds = (omax - omin) / max(1, o_steps - 1);
    cd = floor((cur_o - omin) / ds + 0.5);
    nd = clamp(cd + sign_of(frame_wheel), 0, o_steps - 1);
    no_ = omin + nd * ds;
    mo[5] = 1;
    frame_wheel = 0;   // consumed (see the header)
  );
  mo[7] = no_;
  ni;
);


// ═══════════════════════════════════════════════════════════════════════════
// 8. NEVE 1073
// ═══════════════════════════════════════════════════════════════════════════
// Uses ssl_knob_interact for interaction.

// Draw: 1073 rotary — fluted satin cap (24 scallops), satin dome, cream pointer line
function neve_knob_draw(cx, cy, radius, value, vmin, vmax, hover_t,
                         cr, cg, cb, n_det)
local(ht, ba, scale, voffset, val_rad, i, ta, ca, cpx, cpy, csx, ccy, fw,
      t, hwv, pxp, pyp, sxp, cyp, da, dx, dy, ad, ds,
      c1r, c1g, c1b, c1a, c2r, c2g, c2b)
(
  ht = pow(hover_t, 2);
  ba = lerp(0.85, 1.0, ht);
  scale = 260 / (vmax - vmin);
  voffset = -vmin * 260 / (vmax - vmin) - 130;
  val_rad = (value * scale + voffset) * $pi / 180;
  // Panel tick scale (skipped when detent dots are shown)
  n_det == 0 ? (
    gfx_set(0.63, 0.65, 0.70, lerp(0.30, 0.50, ht));
    i = 0;
    loop(11,
      ta = (-130 + i * 26) * $pi / 180;
      gfx_line(cx + sin(ta) * radius * 0.99, cy - cos(ta) * radius * 0.99,
               cx + sin(ta) * radius * 1.12, cy - cos(ta) * radius * 1.12);
      i += 1;
    );
  );
  // Drop shadow (away from the light) + fluted cap base
  rk_lt();
  rk_lt_shadow(cx, cy, 1, 2, radius, 0.35, 1);
  gfx_set(cr * 0.62, cg * 0.62, cb * 0.62, ba);
  gfx_circle(cx, cy, radius, 1);
  // 24 flutes: light crest / dark trough quads on the rim band
  fw = radius * 0.055;
  // Crest/trough colours are loop-invariant — precompute (draw ORDER kept:
  // quads overlap their neighbours, so a two-pass split would repaint wrong).
  c1r = min(cr * 1.10 + 0.10, 1); c1g = min(cg * 1.10 + 0.10, 1);
  c1b = min(cb * 1.10 + 0.10, 1); c1a = 0.45 * ba;
  c2r = cr * 0.28; c2g = cg * 0.28; c2b = cb * 0.28;
  i = 0;
  loop(24,
    ca = i / 24 * 2 * $pi;
    cpx = cos(ca); cpy = sin(ca); csx = sin(ca); ccy = cos(ca);
    gfx_set(c1r, c1g, c1b, c1a);
    gfx_triangle(cx + csx * radius * 0.80 + cpx * fw, cy - ccy * radius * 0.80 + cpy * fw,
                 cx + csx * radius * 0.80 - cpx * fw, cy - ccy * radius * 0.80 - cpy * fw,
                 cx + csx * radius * 0.985 - cpx * fw, cy - ccy * radius * 0.985 - cpy * fw,
                 cx + csx * radius * 0.985 + cpx * fw, cy - ccy * radius * 0.985 + cpy * fw);
    ca = (i + 0.5) / 24 * 2 * $pi;
    cpx = cos(ca); cpy = sin(ca); csx = sin(ca); ccy = cos(ca);
    gfx_set(c2r, c2g, c2b, 0.60);
    gfx_triangle(cx + csx * radius * 0.80 + cpx * fw, cy - ccy * radius * 0.80 + cpy * fw,
                 cx + csx * radius * 0.80 - cpx * fw, cy - ccy * radius * 0.80 - cpy * fw,
                 cx + csx * radius * 0.965 - cpx * fw, cy - ccy * radius * 0.965 - cpy * fw,
                 cx + csx * radius * 0.965 + cpx * fw, cy - ccy * radius * 0.965 + cpy * fw);
    i += 1;
  );
  gfx_set(cr * 0.30, cg * 0.30, cb * 0.30, 1);
  gfx_circle(cx, cy, radius, 0);
  gfx_circle(cx, cy, radius - 0.5, 0);
  // Satin dome, light drifting toward the light (Studio: top-left)
  rk_lt_turn(-radius * 0.09, -radius * 0.12);
  i = 0;
  loop(9,
    t = i / 8;
    gfx_set(rk_lt_ramp(cr * 0.62, min(cr * 1.20 + 0.10, 1) - cr * 0.62, t * t),
            rk_lt_ramp(cg * 0.62, min(cg * 1.20 + 0.10, 1) - cg * 0.62, t * t),
            rk_lt_ramp(cb * 0.62, min(cb * 1.20 + 0.10, 1) - cb * 0.62, t * t), 1);
    gfx_circle(cx + rk_lt_x * t, cy + rk_lt_y * t,
               radius * 0.78 * (1 - t * 0.55), 1);
    i += 1;
  );
  gfx_set(cr * 0.32, cg * 0.32, cb * 0.32, 0.9);
  gfx_circle(cx, cy, radius * 0.78, 0);
  // Cream pointer line w/ dark edging (quads)
  pxp = cos(val_rad); pyp = sin(val_rad); sxp = sin(val_rad); cyp = cos(val_rad);
  hwv = radius * 0.062;
  gfx_set(0.05, 0.04, 0.03, 0.45);
  gfx_triangle(cx + sxp * radius * 0.10 + pxp * hwv, cy - cyp * radius * 0.10 + pyp * hwv,
               cx + sxp * radius * 0.10 - pxp * hwv, cy - cyp * radius * 0.10 - pyp * hwv,
               cx + sxp * radius * 0.93 - pxp * hwv, cy - cyp * radius * 0.93 - pyp * hwv,
               cx + sxp * radius * 0.93 + pxp * hwv, cy - cyp * radius * 0.93 + pyp * hwv);
  hwv = radius * 0.0425;
  gfx_set(0.93, 0.90, 0.82, 1);
  gfx_triangle(cx + sxp * radius * 0.10 + pxp * hwv, cy - cyp * radius * 0.10 + pyp * hwv,
               cx + sxp * radius * 0.10 - pxp * hwv, cy - cyp * radius * 0.10 - pyp * hwv,
               cx + sxp * radius * 0.91 - pxp * hwv, cy - cyp * radius * 0.91 - pyp * hwv,
               cx + sxp * radius * 0.91 + pxp * hwv, cy - cyp * radius * 0.91 + pyp * hwv);
  // Hover glow
  hover_t > 0.01 ? (
    gfx_set(cr * 1.2, cg * 1.2, cb * 1.2, 0.3 * ht);
    gfx_circle(cx, cy, radius + 2, 0);
    gfx_circle(cx, cy, radius + 3, 0);
  );
  // Detent dots
  n_det > 0 ? (
    ds = (vmax - vmin) / max(1, n_det - 1);
    ad = floor((value - vmin) / ds + 0.5);
    i = 0;
    loop(n_det,
      da = (-130 + i * 260 / max(1, n_det - 1)) * $pi / 180;
      dx = cx + sin(da) * radius * 1.25;
      dy = cy - cos(da) * radius * 1.25;
      i == ad ? (
        gfx_set(1, 1, 1, ba);
        gfx_circle(dx, dy, radius * 0.06, 1);
      ) : (
        gfx_set(0.4, 0.4, 0.4, lerp(0.4, 0.7, ht));
        gfx_circle(dx, dy, radius * 0.04, 1);
      );
      i += 1;
    );
  );
);

// Draw: Neve Alt (style 20) — Heritage i73 concentric: chunky scalloped ring,
// dark groove, separate satin dome, cream pointer crossing dome AND ring
function neve_alt_knob_draw(cx, cy, radius, value, vmin, vmax, hover_t,
                             cr, cg, cb, n_det)
local(ht, ba, scale, voffset, val_rad, i, ta, ca, cpx, cpy, csx, ccy, fw, fw2,
      t, hwv, pxp, pyp, sxp, cyp, da, dx, dy, ad, ds,
      c1r, c1g, c1b, c1a, c2r, c2g, c2b)
(
  ht = pow(hover_t, 2);
  ba = lerp(0.85, 1.0, ht);
  scale = 260 / (vmax - vmin);
  voffset = -vmin * 260 / (vmax - vmin) - 130;
  val_rad = (value * scale + voffset) * $pi / 180;
  // Panel tick scale (skipped when detent dots are shown)
  n_det == 0 ? (
    gfx_set(0.65, 0.67, 0.72, lerp(0.30, 0.50, ht));
    i = 0;
    loop(11,
      ta = (-130 + i * 26) * $pi / 180;
      gfx_line(cx + sin(ta) * radius * 1.02, cy - cos(ta) * radius * 1.02,
               cx + sin(ta) * radius * 1.15, cy - cos(ta) * radius * 1.15);
      i += 1;
    );
  );
  // Drop shadow (away from the light) + ring base
  rk_lt();
  rk_lt_shadow(cx, cy, 1, 2.5, radius, 0.42, 1);
  gfx_set(cr * 0.58, cg * 0.58, cb * 0.58, ba);
  gfx_circle(cx, cy, radius, 1);
  // 14 chunky scallops: crest/trough quads across the outer ring
  fw = radius * 0.11;
  fw2 = fw * 0.9;
  // Crest/trough colours are loop-invariant — precompute (draw ORDER kept:
  // scallop quads overlap, two-pass would repaint wrong).
  c1r = min(cr * 1.15 + 0.10, 1); c1g = min(cg * 1.15 + 0.10, 1);
  c1b = min(cb * 1.15 + 0.10, 1); c1a = 0.40 * ba;
  c2r = cr * 0.22; c2g = cg * 0.22; c2b = cb * 0.22;
  i = 0;
  loop(14,
    ca = i / 14 * 2 * $pi;
    cpx = cos(ca); cpy = sin(ca); csx = sin(ca); ccy = cos(ca);
    gfx_set(c1r, c1g, c1b, c1a);
    gfx_triangle(cx + csx * radius * 0.66 + cpx * fw, cy - ccy * radius * 0.66 + cpy * fw,
                 cx + csx * radius * 0.66 - cpx * fw, cy - ccy * radius * 0.66 - cpy * fw,
                 cx + csx * radius * 0.975 - cpx * fw, cy - ccy * radius * 0.975 - cpy * fw,
                 cx + csx * radius * 0.975 + cpx * fw, cy - ccy * radius * 0.975 + cpy * fw);
    ca = (i + 0.5) / 14 * 2 * $pi;
    cpx = cos(ca); cpy = sin(ca); csx = sin(ca); ccy = cos(ca);
    gfx_set(c2r, c2g, c2b, 0.60);
    gfx_triangle(cx + csx * radius * 0.66 + cpx * fw2, cy - ccy * radius * 0.66 + cpy * fw2,
                 cx + csx * radius * 0.66 - cpx * fw2, cy - ccy * radius * 0.66 - cpy * fw2,
                 cx + csx * radius * 0.94 - cpx * fw2, cy - ccy * radius * 0.94 - cpy * fw2,
                 cx + csx * radius * 0.94 + cpx * fw2, cy - ccy * radius * 0.94 + cpy * fw2);
    i += 1;
  );
  // Light / shade on the ring, toward and away from the light (Studio: top / bottom)
  rk_lt_hi > 0 ? (
    gfx_set(1, 1, 1, min(1, 0.10 * rk_lt_hi));
    gfx_arc(cx, cy, radius - 1, -1.5 + rk_lt_dang, 1.5 + rk_lt_dang, 1);
    gfx_arc(cx, cy, radius - 2, -1.4 + rk_lt_dang, 1.4 + rk_lt_dang, 1);
  );
  rk_lt_sh > 0 ? (
    gfx_set(0, 0, 0, min(1, 0.16 * rk_lt_sh));
    gfx_arc(cx, cy, radius - 1, 1.9 + rk_lt_dang, 2.9 + rk_lt_dang, 1);
    gfx_arc(cx, cy, radius - 1, -2.9 + rk_lt_dang, -1.9 + rk_lt_dang, 1);
  );
  gfx_set(cr * 0.28, cg * 0.28, cb * 0.28, 1);
  gfx_circle(cx, cy, radius, 0);
  gfx_circle(cx, cy, radius - 0.5, 0);
  // Dark groove between ring and dome
  gfx_set(0, 0, 0, 0.55);
  gfx_circle(cx, cy, radius * 0.64, 0);
  gfx_circle(cx, cy, radius * 0.63, 0);
  gfx_circle(cx, cy, radius * 0.62, 0);
  // Inner satin dome, light drifting toward the light (Studio: top-left)
  rk_lt_turn(-radius * 0.08, -radius * 0.11);
  i = 0;
  loop(9,
    t = i / 8;
    gfx_set(rk_lt_ramp(cr * 0.55, min(cr * 1.25 + 0.10, 1) - cr * 0.55, t * t),
            rk_lt_ramp(cg * 0.55, min(cg * 1.25 + 0.10, 1) - cg * 0.55, t * t),
            rk_lt_ramp(cb * 0.55, min(cb * 1.25 + 0.10, 1) - cb * 0.55, t * t), 1);
    gfx_circle(cx + rk_lt_x * t, cy + rk_lt_y * t,
               radius * 0.58 * (1 - t * 0.55), 1);
    i += 1;
  );
  gfx_set(1, 1, 1, 0.08);
  gfx_circle(cx, cy, radius * 0.58, 0);
  // Cream pointer crossing dome and ring, w/ dark edging (quads)
  pxp = cos(val_rad); pyp = sin(val_rad); sxp = sin(val_rad); cyp = cos(val_rad);
  hwv = radius * 0.062;
  gfx_set(0.05, 0.04, 0.03, 0.45);
  gfx_triangle(cx + sxp * radius * 0.06 + pxp * hwv, cy - cyp * radius * 0.06 + pyp * hwv,
               cx + sxp * radius * 0.06 - pxp * hwv, cy - cyp * radius * 0.06 - pyp * hwv,
               cx + sxp * radius * 0.96 - pxp * hwv, cy - cyp * radius * 0.96 - pyp * hwv,
               cx + sxp * radius * 0.96 + pxp * hwv, cy - cyp * radius * 0.96 + pyp * hwv);
  hwv = radius * 0.0425;
  gfx_set(0.93, 0.90, 0.82, 1);
  gfx_triangle(cx + sxp * radius * 0.06 + pxp * hwv, cy - cyp * radius * 0.06 + pyp * hwv,
               cx + sxp * radius * 0.06 - pxp * hwv, cy - cyp * radius * 0.06 - pyp * hwv,
               cx + sxp * radius * 0.95 - pxp * hwv, cy - cyp * radius * 0.95 - pyp * hwv,
               cx + sxp * radius * 0.95 + pxp * hwv, cy - cyp * radius * 0.95 + pyp * hwv);
  // Hover glow
  hover_t > 0.01 ? (
    gfx_set(cr * 1.2, cg * 1.2, cb * 1.2, 0.3 * ht);
    gfx_circle(cx, cy, radius + 2, 0);
    gfx_circle(cx, cy, radius + 3, 0);
  );
  // Detent dots
  n_det > 0 ? (
    ds = (vmax - vmin) / max(1, n_det - 1);
    ad = floor((value - vmin) / ds + 0.5);
    i = 0;
    loop(n_det,
      da = (-130 + i * 260 / max(1, n_det - 1)) * $pi / 180;
      dx = cx + sin(da) * radius * 1.25;
      dy = cy - cos(da) * radius * 1.25;
      i == ad ? (
        gfx_set(1, 1, 1, ba);
        gfx_circle(dx, dy, radius * 0.06, 1);
      ) : (
        gfx_set(0.4, 0.4, 0.4, lerp(0.4, 0.7, ht));
        gfx_circle(dx, dy, radius * 0.04, 1);
      );
      i += 1;
    );
  );
);


// ═══════════════════════════════════════════════════════════════════════════
// 9. ENDLESS ROTARY ENCODER
// ═══════════════════════════════════════════════════════════════════════════

// Draw: the Behringer X-TOUCH MINI encoder, measured 2026-09-24 on Behringer's
// top-view product image. NO pointer — the LED collar is the display: 13
// pill-shaped bars from -140° to +140°, filling from the start to the value (the
// last one partly lit), lit pale with a soft bloom, unlit a dim shade of the
// accent, in a dark recessed well; a small black knob with a flat grey top and a
// chamfer lit from the top. The footprint is what it was (the old 16-LED ring
// reached ~1.4R): well 1.38R, bars 1.02R..1.31R, knob 0.73R (top 0.40R). Accent =
// LED colour. Hover: the knob swells 6% and its top lifts.
function encoder_draw(cx, cy, radius, value, vmin, vmax, hover_t, cr, cg, cb)
local(ht, t, pos, i, a, b, wr, k, r0, r1, w, SW)
(
  ht = hover_t * hover_t;
  t = min(max((value - vmin) / (vmax - vmin), 0), 1);
  SW = 140 * $pi / 180;
  wr = radius * 1.38;
  r0 = radius * 1.02; r1 = radius * 1.31; w = max(1.2, radius * 0.11);
  pos = t * 12;

  // recessed well: darker than any panel, dark edge
  gfx_set(0, 0, 0, 0.38); gfx_circle(cx, cy, wr, 1, 1);
  gfx_set(0, 0, 0, 0.55); gfx_circle(cx, cy, wr, 0, 1);

  // 13 LED bars, pill-shaped like the hardware's, filling to the value; a lit bar
  // blooms softly
  i = 0;
  loop(13,
    a = -SW + i * (2 * SW / 12);
    b = min(max(pos - i + 1, 0), 1);
    gfx_set(cr * 0.20, cg * 0.20, cb * 0.20, 1);                       // unlit
    rk_kn_pill(cx, cy, a, r0, r1, w);
    b > 0.02 ? (
      gfx_set(cr, cg, cb, 0.10 * b);                                     // bloom: two soft discs
      gfx_circle(cx + sin(a) * (r0 + r1) * 0.5, cy - cos(a) * (r0 + r1) * 0.5, (r1 - r0) * 0.80, 1, 1);
      gfx_set(cr, cg, cb, 0.14 * b);
      gfx_circle(cx + sin(a) * (r0 + r1) * 0.5, cy - cos(a) * (r0 + r1) * 0.5, (r1 - r0) * 0.55, 1, 1);
      // core: opaque, its colour blended unlit -> lit by b (a translucent pill would
      // double up where its rounded ends overlap the bar)
      gfx_set(cr * 0.20 + (min(cr * 0.45 + 0.55, 1) - cr * 0.20) * b,
              cg * 0.20 + (min(cg * 0.45 + 0.55, 1) - cg * 0.20) * b,
              cb * 0.20 + (min(cb * 0.45 + 0.55, 1) - cb * 0.20) * b, 1);
      rk_kn_pill(cx, cy, a, r0, r1, w);
    );
    i += 1;
  );

  // knob: black body, chamfer lit from the top, flat grey top face, no pointer
  k = radius * 0.73 * (1 + 0.06 * ht);
  rk_lt();
  rk_lt_shadow(cx, cy, k * 0.05, k * 0.09, k, 0.35, 1);
  gfx_set(0.08, 0.08, 0.08, 1); gfx_circle(cx, cy, k, 1, 1);
  rk_lt_vdisc(cx, cy, k * 0.85, 0.52, 0.52, 0.52, 0.10, 0.10, 0.10);
  gfx_set(0.29 + 0.04 * ht, 0.29 + 0.04 * ht, 0.29 + 0.04 * ht, 1); gfx_circle(cx, cy, k * 0.55, 1, 1);
  gfx_set(0.05, 0.05, 0.05, 1); gfx_circle(cx, cy, k, 0, 1);
);

// Interact: clamped vmin..vmax, drag continuous, wheel 2% / CTRL 0.5% / SHIFT 0.2% of range,
// double/right-click → vdefault
function encoder_interact(mem, cx, cy, radius, cur_val, vmin, vmax, vdefault, n_detents)
local(hover, d, new_val, step, now, _range, _scl)
(
  d = dist(mx, my, cx, cy);
  hover = (d <= radius);
  _range = vmax - vmin;
  hover || mem[1] ? (
    mem[0] = min(mem[0] + dt * hv_speed, 1);
  ) : (
    mem[0] = max(mem[0] - dt * hv_speed, 0);
  );
  mem[6] = hover || mem[1];
  new_val = cur_val;
  mem[5] = 0;
  // Right-click reset
  hover && rmb_down ? ( new_val = vdefault; mem[5] = 1; );
  // Double-click reset
  hover && lmb_down ? (
    now = time_precise();
    (now - mem[4] < RK_DBLCLICK_T) ? ( new_val = vdefault; mem[5] = 1; );
    mem[4] = now;
  );
  // Start drag (skip if reset just fired)
  lmb_down && hover && !mem[1] && !mem[5] ? (
    mem[1] = 2;          // pressed: rk_drag_live starts the drag past the deadzone
    mem[2] = my;
    mem[3] = cur_val;
    _rk_drag_mod = rk_drag_mods();
  );
  // Continue drag (CTRL=fine, SHIFT=extra-fine; a modifier change re-anchors it: rk_drag_mods)
  rk_drag_live(mem, LMB && !_srf_foreign, cur_val) ? (
    rk_drag_mods() != _rk_drag_mod ? ( mem[2] = my; mem[3] = cur_val; _rk_drag_mod = rk_drag_mods(); );
    step = (mem[2] - my) / max(radius * 4, 200) * _range * (CTRL ? 0.1 : SHIFT ? 0.025 : 1);
    new_val = clamp(mem[3] + step, vmin, vmax);
  );
  // End drag
  mem[1] && !LMB ? (
    mem[1] = 0;
    mem[5] = 1;
  );
  // Scroll (CTRL=fine 0.5%, SHIFT=extra-fine 0.2%, default=2%)
  hover && frame_wheel != 0 ? (
    _scl = CTRL ? 0.005 : SHIFT ? 0.002 : 0.02;
    new_val = clamp(cur_val + frame_wheel * _range * _scl, vmin, vmax);
    mem[5] = 1;
    frame_wheel = 0;   // consumed (see the header)
  );
  new_val;
);


// ═══════════════════════════════════════════════════════════════════════════
// 10. MPC RUBBER PAD KNOB
// ═══════════════════════════════════════════════════════════════════════════
// Domed rubber cap tinted to the accent (cr/cg/cb), raised bevel rim, white indicator
// line, 260° arc (±130°).
// Same 16-slot memory convention and ssl_knob_interact-compatible signature.
// Draw args: cx, cy, r, value, vmin, vmax, is_sym, hover_t, cr, cg, cb, bgr, bgg, bgb
// Interact: reuses ssl_knob_interact (continuous drag, detented scroll, dbl-click reset)

function mpc_knob_draw(cx, cy, radius, value, vmin, vmax, is_sym, hover_t,
                        cr, cg, cb, bgr, bgg, bgb)
local(ht, scale, voffset, val_deg, val_rad, bevel_r, cap_r, dome_r,
      ind_x1, ind_y1, ind_x2, ind_y2, n_passes, i, RAD130_, start_rad,
      arc_step, rr, glow_a)
(
  ht = pow(hover_t, 2);
  RAD130_ = 130 * $pi / 180;
  scale    = 260 / (vmax - vmin);
  voffset  = -vmin * 260 / (vmax - vmin) - 130;
  val_deg  = value * scale + voffset;
  val_rad  = val_deg * $pi / 180;

  // ── Track arc (background) ──────────────────────────────────────────────
  n_passes = max(2, floor(radius / 6));
  gfx_set(bgr, bgg, bgb, 1);
  i = 0; loop(n_passes,
    gfx_arc(cx, cy, radius - i * 0.6, -RAD130_, RAD130_, 1);
    i += 1;
  );

  // ── Active arc (accent color) ────────────────────────────────────────────
  gfx_set(cr, cg, cb, lerp(0.75, 1.0, ht));
  start_rad = is_sym ? (is_sym < 1 ? (is_sym * 2 - 1) * RAD130_ : 0) : -RAD130_;
  i = 0; loop(n_passes,
    gfx_arc(cx, cy, radius - i * 0.6, start_rad, val_rad, 1);
    i += 1;
  );

  // ── Outer bevel rim ──────────────────────────────────────────────────────
  bevel_r = radius * 0.80;
  // Dark outer shell
  gfx_set(0.10, 0.10, 0.11, 1);
  gfx_circle(cx, cy, bevel_r, 1);
  // Highlight rim (top-left catch light)
  gfx_set(lerp(0.28, 0.38, ht), lerp(0.28, 0.38, ht), lerp(0.30, 0.40, ht), 1);
  gfx_circle(cx, cy, bevel_r, 0);
  gfx_circle(cx, cy, bevel_r - 0.5, 0);

  // ── Rubber dome cap (tinted to cr/cg/cb) ───────────────────────────────
  cap_r  = bevel_r * 0.82;
  dome_r = cap_r  * 0.60;
  // Base rubber body — color-tinted
  gfx_set(lerp(cr*0.35, cr*0.50, ht), lerp(cg*0.35, cg*0.50, ht), lerp(cb*0.35, cb*0.50, ht), 1);
  gfx_circle(cx, cy, cap_r, 1);
  // Dome highlight — brighter tint, specular toward the light (Studio: top-left)
  rk_lt();
  rk_lt_turn(-cap_r * 0.18, -cap_r * 0.18);
  gfx_set(rk_lt_mix(lerp(cr*0.35, cr*0.50, ht), lerp(cr*0.65, cr*0.85, ht)),
          rk_lt_mix(lerp(cg*0.35, cg*0.50, ht), lerp(cg*0.65, cg*0.85, ht)),
          rk_lt_mix(lerp(cb*0.35, cb*0.50, ht), lerp(cb*0.65, cb*0.85, ht)), 1);
  gfx_circle(cx + rk_lt_x, cy + rk_lt_y, dome_r, 1);
  // Center recessed dark spot, away from the light
  rk_lt_turn(cap_r * 0.08, cap_r * 0.08);
  gfx_set(cr*0.12, cg*0.12, cb*0.12, 1);
  gfx_circle(cx + rk_lt_x, cy + rk_lt_y, dome_r * 0.55, 1);

  // ── Indicator line ───────────────────────────────────────────────────────
  ind_x1 = cx + sin(val_rad) * cap_r * 0.30;
  ind_y1 = cy - cos(val_rad) * cap_r * 0.30;
  ind_x2 = cx + sin(val_rad) * cap_r * 0.88;
  ind_y2 = cy - cos(val_rad) * cap_r * 0.88;
  // Thick white line (3 passes for anti-alias weight)
  gfx_set(0.92, 0.92, 0.92, lerp(0.80, 1.0, ht));
  gfx_line(ind_x1, ind_y1, ind_x2, ind_y2, 1);
  gfx_line(ind_x1 + cos(val_rad) * 0.5, ind_y1 + sin(val_rad) * 0.5,
           ind_x2 + cos(val_rad) * 0.5, ind_y2 + sin(val_rad) * 0.5, 1);
  gfx_line(ind_x1 - cos(val_rad) * 0.5, ind_y1 - sin(val_rad) * 0.5,
           ind_x2 - cos(val_rad) * 0.5, ind_y2 - sin(val_rad) * 0.5, 1);

  // ── Hover glow ring ──────────────────────────────────────────────────────
  glow_a = 0.25 * ht;
  glow_a > 0.01 ? (
    gfx_set(cr, cg, cb, glow_a);
    gfx_circle(cx, cy, bevel_r + 1.5, 0);
    gfx_circle(cx, cy, bevel_r + 2.5, 0);
  );
);

