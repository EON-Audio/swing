// rk_swing_lcd_p2.jsfx-inc -- part 2 of rk_swing_lcd.jsfx-inc (2 parts), cut at a function boundary by
// .dev_tests/split_big_incs.py: REAPER's load time grows with the square of a file's size. Edit freely;
// keep each file under about 40 KB.

// ⚠️ @init IS LOAD-BEARING (.docs/wiki/02-file-structure.md).
@init

function swing_lcd_draw_macro(_cx, _cy, _cw, _ch)
local(_mk_k, _mk_pitch, _mk_x, _mk_y, _mk_r, _mk_v, _mk_nv, _mk_mapped,
      _mk_cr, _mk_cg, _mk_cb, _mk_tw, _mk_th, _mk_cell_x, _mk_sel, _mk_st,
      _mk_lbl)
(
  // Right 54px = the EDIT ▸ rail (opens the editor overlay, slice 3);
  // knobs share the rest.
  _mk_pitch = (_cw - 54) / 8;
  _mk_r     = min(17, (_mk_pitch * 0.30)|0);
  _mk_y     = _cy + 30;

  _mk_k = 0; loop(8,
    _mk_cell_x = _cx + _mk_k * _mk_pitch;
    _mk_x      = _mk_cell_x + _mk_pitch * 0.5;
    _mk_st     = km_mac + _mk_k * KS;
    _mk_sel    = (macro_sel | 0) == _mk_k;
    _mk_mapped = kmac_nmap[_mk_k] > 0;

    // Selection plate behind the whole cell
    _mk_sel ? (
      gfx_set(lcd_bar_tx_r * 0.16, lcd_bar_tx_g * 0.16, lcd_bar_tx_b * 0.16, 0.9);
      gfx_rect(_mk_cell_x + 2, _cy + 4, _mk_pitch - 4, _ch - 10);
    );

    swing_lcd_kmac_pal(kmac_color[_mk_k] | 0);
    _mk_mapped ? (
      _mk_cr = kmac_pal_r; _mk_cg = kmac_pal_g; _mk_cb = kmac_pal_b;
    ) : (
      _mk_cr = kmac_pal_r * 0.35; _mk_cg = kmac_pal_g * 0.35; _mk_cb = kmac_pal_b * 0.35;
    );

    _mk_v = _mk_k == 0 ? macro1 : _mk_k == 1 ? macro2 : _mk_k == 2 ? macro3 :
            _mk_k == 3 ? macro4 : _mk_k == 4 ? macro5 : _mk_k == 5 ? macro6 :
            _mk_k == 6 ? macro7 : macro8;

    // Right-click = this macro's colour picker (below); see the note on the
    // LCD PAN knob in swing_lcd_draw_pad.
    _rmb_keep = rmb_down; rmb_down = 0;
    _mk_nv = mpc_knob_interact(_mk_st, _mk_x, _mk_y, _mk_r, _mk_v, 0, 1, 0, 0);
    rmb_down = _rmb_keep;
    _mk_nv != _mk_v ? (
      // Slider write + automation touch only — never mark_dirty (spec §3).
      // Masks are 2^n pow arithmetic, never (1<<n): sliders 32..39 sit past
      // the 32-bit shift range (feedback_eel2_shift_32bit).
      _mk_k == 0 ? ( macro1 = _mk_nv; ) : _mk_k == 1 ? ( macro2 = _mk_nv; ) :
      _mk_k == 2 ? ( macro3 = _mk_nv; ) : _mk_k == 3 ? ( macro4 = _mk_nv; ) :
      _mk_k == 4 ? ( macro5 = _mk_nv; ) : _mk_k == 5 ? ( macro6 = _mk_nv; ) :
      _mk_k == 6 ? ( macro7 = _mk_nv; ) : ( macro8 = _mk_nv; );
      slider_automate(2^(31 + _mk_k));
      // Touching a knob focuses it (Ableton behavior)
      (macro_sel | 0) != _mk_k ? ( macro_sel = _mk_k; slider_automate(2^40); );
      _mk_v = _mk_nv;
    );

    mpc_knob_draw(_mk_x, _mk_y, _mk_r, _mk_v, 0, 1, 0,
                  _mk_st[0], _mk_cr, _mk_cg, _mk_cb, 0.11, 0.17, 0.20);

    // ── NAME PILL (the pad-name-pill idiom): identity-colour body that
    // brightens on an EASED hover, 1px border lifting with it, white ink
    // over a shadow, caret tick = the edit affordance (click = rename, below).
    kmac_ren_k == _mk_k ? (
      strcpy(#kmac_val_lbl, #kmac_ren_buf);
      (time_precise() * 2) & 1 ? strcat(#kmac_val_lbl, "_");
    ) : (
      swing_lcd_kmac_label(_mk_k, #kmac_val_lbl);
    );
    rk_font(1, 9, swing_txt_wt(9, #kmac_val_lbl));   // a renamed "Verb 5" goes regular (wiki 4.7)
    gfx_measurestr(#kmac_val_lbl, _mk_tw, _mk_th);
    _mk_pw2 = max(30, _mk_tw + 10);
    _mk_px2 = _mk_x - _mk_pw2 * 0.5;
    _mk_py2 = _mk_y + _mk_r + 3;
    _mk_phov = mx >= _mk_px2 && mx <= _mk_px2 + _mk_pw2 &&
               my >= _mk_py2 && my <= _mk_py2 + 13;
    kmac_hv[_mk_k] += (((_mk_phov || kmac_ren_k == _mk_k) ? 1 : 0) - kmac_hv[_mk_k]) * 0.30;
    _mk_phv = kmac_hv[_mk_k];
    kmac_ren_k == _mk_k && _mk_phov ? ( kmac_ren_pillhov = 1; );
    _mk_mapped || kmac_ren_k == _mk_k ? (
      gfx_set(_mk_cr * (0.32 + 0.24 * _mk_phv), _mk_cg * (0.32 + 0.24 * _mk_phv),
              _mk_cb * (0.32 + 0.24 * _mk_phv), 0.95);
    ) : (
      gfx_set(0.10 + 0.06 * _mk_phv, 0.12 + 0.06 * _mk_phv, 0.15 + 0.06 * _mk_phv, 0.9);
    );
    gfx_rect(_mk_px2, _mk_py2, _mk_pw2, 13);
    gfx_set(1, 1, 1, 0.22 + 0.55 * _mk_phv);
    gfx_rect(_mk_px2, _mk_py2, _mk_pw2, 13, 0);
    rk_ink_label(#kmac_val_lbl, _mk_px2 + 5, _mk_py2 + 2, _mk_sel ? 1 : 0.85);
    _mk_phv > 0.05 ? (
      gfx_set(0.99, 1.0, 1.0, 0.75 * _mk_phv);
      gfx_rect(_mk_px2 + _mk_pw2 - 4, _mk_py2 + 3, 2, 7);
    );
    // click = rename RIGHT HERE on the strip (the ren tick owns the
    // keyboard every frame — no editor needed)
    _mk_phov && lmb_down && kmac_ren_k != _mk_k ? (
      (macro_sel | 0) != _mk_k ? ( macro_sel = _mk_k; slider_automate(2^40); );
      kmac_ren_k = _mk_k;
      strcpy(#kmac_ren_buf, swing_lcd_kmac_name_slot(_mk_k));
    );

    // Value readout (em-dash for unmapped)
    _mk_mapped ? sprintf(#kmac_val_lbl, "%d%%", (_mk_v * 100 + 0.5) | 0)
               : strcpy(#kmac_val_lbl, "--");
    rk_font(1, 9, 0);
    gfx_measurestr(#kmac_val_lbl, _mk_tw, _mk_th);
    gfx_set(lcd_bar_tx_r * 0.55, lcd_bar_tx_g * 0.55, lcd_bar_tx_b * 0.55, 0.9);
    gfx_x = _mk_x - _mk_tw * 0.5;
    gfx_y = _mk_y + _mk_r + 18;   // below the name pill
    gfx_drawstr(#kmac_val_lbl);

    // Click in the cell below the knob = select this macro (the name pill
    // above owns its own click = rename). Zone clamped ABOVE the snapshot
    // row (y ≥ _cy+78) so dot/morph clicks never double as selection.
    lmb_down && !_mk_phov && mx >= _mk_cell_x && mx < _mk_cell_x + _mk_pitch &&
    my >= _mk_y + _mk_r + 3 && my < _cy + 76 ? (
      (macro_sel | 0) != _mk_k ? ( macro_sel = _mk_k; slider_automate(2^40); );
    );
    // Right-click a strip knob = colour picker, same route: the editor
    // opens with the swatch row already up for this macro.
    rmb_down && abs(mx - _mk_x) <= _mk_r + 4 && abs(my - _mk_y) <= _mk_r + 4 ? (
      (macro_sel | 0) != _mk_k ? ( macro_sel = _mk_k; slider_automate(2^40); );
      kmac_ed_open = 1;
      kmac_colpick_k = _mk_k;
      _ov_lmb_down = 0; _ov_rmb_down = 0; _ov_LMB = 0; _ov_RMB = 0; _ov_wheel = 0;
    );

    _mk_k += 1;
  );

  // ── Snapshot row (slice 4): SNAP dots I..IV · CAPTURE · MORPH slider ──
  _mksn_y = _cy + 82;
  rk_font(1, 9, 'b');
  gfx_set(lcd_bar_tx_r * 0.45, lcd_bar_tx_g * 0.45, lcd_bar_tx_b * 0.45, 0.9);
  gfx_x = _cx + 6; gfx_y = _mksn_y + 3; gfx_drawstr("SNAP");
  _mksn_mod = swing_lcd_kmac_modified();
  _mk_k = 0; loop(KMAC_NSNAP,
    _mksn_x = _cx + 40 + _mk_k * 21;
    kmac_snap_has[_mk_k] ? gfx_set(0.10, 0.28, 0.32, 1) : gfx_set(0.05, 0.09, 0.12, 1);
    gfx_rect(_mksn_x, _mksn_y, 18, 16);
    kmac_snap_act == _mk_k ? (
      _mksn_mod ? gfx_set(0.95, 0.72, 0.25, 0.95) : gfx_set(0.90, 0.97, 1.00, 0.9);
    ) : gfx_set(0.22, 0.32, 0.35, 0.9);
    gfx_rect(_mksn_x, _mksn_y, 18, 16, 0);
    swing_lcd_kmac_roman(_mk_k, #kmac_val_lbl);
    rk_font(1, 8, 'b');
    gfx_measurestr(#kmac_val_lbl, _mk_tw, _mk_th);
    kmac_snap_has[_mk_k] ? gfx_set(0.45, 0.90, 0.95, 1)
                         : gfx_set(lcd_bar_tx_r * 0.35, lcd_bar_tx_g * 0.35, lcd_bar_tx_b * 0.35, 0.9);
    gfx_x = _mksn_x + (18 - _mk_tw) * 0.5; gfx_y = _mksn_y + (16 - _mk_th) * 0.5;
    gfx_drawstr(#kmac_val_lbl);
    mx >= _mksn_x && mx < _mksn_x + 18 && my >= _mksn_y && my < _mksn_y + 16 ? (
      lmb_down ? (
        CTRL ? swing_lcd_kmac_clear(_mk_k)       // ctrl+click = delete snapshot
             : swing_lcd_kmac_recall(_mk_k);     // click = recall (or just arm if empty)
      );
      rmb_down ? swing_lcd_kmac_capture(_mk_k);  // right-click = capture INTO this slot
    );
    _mk_k += 1;
  );
  _mksn_x = _cx + 40 + KMAC_NSNAP * 21 + 5;
  _mksn_hov = mx >= _mksn_x && mx < _mksn_x + 50 && my >= _mksn_y && my < _mksn_y + 16;
  gfx_set(0.16, 0.26, 0.30, _mksn_hov ? 1 : 0.85);
  gfx_rect(_mksn_x, _mksn_y, 50, 16);
  gfx_set(0.35, 0.55, 0.60, 0.9); gfx_rect(_mksn_x, _mksn_y, 50, 16, 0);
  rk_font(1, 8, 'b');
  gfx_measurestr("CAPTURE", _mk_tw, _mk_th);
  gfx_set(0.60, 0.90, 0.95, 1);
  gfx_x = _mksn_x + (50 - _mk_tw) * 0.5; gfx_y = _mksn_y + (16 - _mk_th) * 0.5;
  gfx_drawstr("CAPTURE");
  _mksn_hov && lmb_down ? swing_lcd_kmac_capture(kmac_snap_act);

  // MORPH slider — the ONE automatable morph param; drag = a real gesture,
  // so it DOES slider_automate (unlike the cosmetic knob motion it causes).
  _mksn_ready = swing_lcd_kmac_ncap() >= 2;
  _mksn_x  = _cx + 40 + KMAC_NSNAP * 21 + 62;
  _mksn_w  = (_cx + _cw - 54) - _mksn_x - 76;
  gfx_set(0.03, 0.07, 0.10, 1);
  gfx_rect(_mksn_x, _mksn_y + 4, _mksn_w, 8);
  _mksn_n = max(0, min(1, macro_morph / (KMAC_NSNAP - 1)));
  gfx_set(0.20, 0.55, 0.60, _mksn_ready ? 0.95 : 0.30);
  gfx_rect(_mksn_x, _mksn_y + 4, _mksn_n * _mksn_w, 8);
  gfx_set(0.90, 0.97, 1.00, _mksn_ready ? 0.95 : 0.35);
  gfx_rect(_mksn_x + _mksn_n * _mksn_w - 1, _mksn_y + 2, 2, 12);
  lmb_down && mx >= _mksn_x - 4 && mx <= _mksn_x + _mksn_w + 4 &&
  my >= _mksn_y && my <= _mksn_y + 16 ? ( kmac_morph_drag = 1; );
  kmac_morph_drag ? (
    LMB ? (
      macro_morph = max(0, min(1, (mx - _mksn_x) / _mksn_w)) * (KMAC_NSNAP - 1);
      slider_automate(2^39);
    ) : ( kmac_morph_drag = 0; );
  );

  // readout: "II>III 0.41" (ASCII only — multibyte arrows don't render)
  _mksn_ready ? (
    _mk_k = max(0, min(KMAC_NSNAP - 1, macro_morph));
    swing_lcd_kmac_roman(min(KMAC_NSNAP - 1, (_mk_k | 0) + 1), #kmac_val_lbl2);
    swing_lcd_kmac_roman(_mk_k | 0, #kmac_val_lbl);
    sprintf(#kmac_val_lbl, "%s>%s %.2f", #kmac_val_lbl, #kmac_val_lbl2, _mk_k - (_mk_k | 0));
  ) : strcpy(#kmac_val_lbl, "capture 2+");
  rk_font(1, 8, 0);   // regular: a bold 8 px "5" draws as a "6" (wiki 4.7)
  gfx_measurestr(#kmac_val_lbl, _mk_tw, _mk_th);
  gfx_set(lcd_bar_tx_r * 0.55, lcd_bar_tx_g * 0.55, lcd_bar_tx_b * 0.55, 0.95);
  gfx_x = _cx + _cw - 58 - _mk_tw; gfx_y = _mksn_y + 3; gfx_drawstr(#kmac_val_lbl);

  // ── EDIT ▸ rail (right edge) → macro editor overlay ──
  _mk_cell_x = _cx + _cw - 50;
  _mk_sel = mx >= _mk_cell_x && mx <= _cx + _cw - 4 &&
            my >= _cy + 16 && my <= _cy + 52;
  gfx_set(0.08 + 0.04 * _mk_sel, 0.20 + 0.06 * _mk_sel, 0.23 + 0.07 * _mk_sel, 0.95);
  gfx_rect(_mk_cell_x, _cy + 16, 46, 36);
  gfx_set(0.45, 0.90, 0.95, _mk_sel ? 1 : 0.75);
  gfx_rect(_mk_cell_x, _cy + 16, 46, 36, 0);
  rk_font(1, 9, 'b');
  gfx_measurestr("EDIT >", _mk_tw, _mk_th);
  gfx_x = _mk_cell_x + (46 - _mk_tw) * 0.5;
  gfx_y = _cy + 16 + (36 - _mk_th) * 0.5;
  gfx_drawstr("EDIT >");
  _mk_sel && lmb_down ? (
    kmac_ed_open = 1;
    // Zero the modal-gate saves on open: the gate ran THIS frame with no
    // modal active, so the _ov_* copies are STALE — a leftover
    // _ov_lmb_down=1 fires the overlay's click-outside-close on its own
    // open frame (the RANGE pill's documented flicker fix).
    _ov_lmb_down = 0; _ov_rmb_down = 0; _ov_LMB = 0; _ov_RMB = 0; _ov_wheel = 0;
  );
);

// ─── Main LCD bar draw ───────────────────────────────────────────────────
function swing_lcd_draw(_lx, _ly, _lw, _lh)
local(_cx, _cy, _cw, _ch)
(
  // Macro-rename keyboard/lifecycle tick — every frame, surface-agnostic
  swing_lcd_kmac_ren_tick();

  // Background
  gfx_set(lcd_bar_bg_r, lcd_bar_bg_g, lcd_bar_bg_b, 1);
  gfx_rect(_lx, _ly, _lw, _lh);

  // Subtle border
  gfx_set(0.02, 0.06, 0.08, 1);
  gfx_rect(_lx, _ly + _lh - 1, _lw, 1);  // bottom edge
  gfx_set(0.12, 0.18, 0.22, 0.5);
  gfx_rect(_lx, _ly, _lw, 1);  // top highlight

  // Tab row
  swing_lcd_draw_tabs(_lx, _ly, _lw);

  // Content area
  _cx = _lx + 2;
  _cy = _ly + swing_px(LCD_TAB_H);
  _cw = _lw - 4;
  _ch = _lh - swing_px(LCD_TAB_H);

  lcd_right_tab == 0 ? swing_lcd_draw_kit(_cx, _cy, _cw, _ch);
  lcd_right_tab == 1 ? swing_lcd_draw_pad(_cx, _cy, _cw, _ch);
  lcd_right_tab == 2 ? swing_lcd_draw_macro(_cx, _cy, _cw, _ch);
  // ⚠️ Publish the rect, do NOT call the page. swing_fxview_rack lives in a
  // lib imported after this one (it needs swing_bigview_open), so calling it
  // here is an unknown function at parse time -- which silently kills the
  // WHOLE importing file. Swing_ReaKit.jsfx draws it just after this returns.
  lcd_right_tab == 3 ? (
    _fxv_rack_x = _cx; _fxv_rack_y = _cy;
    _fxv_rack_w = _cw; _fxv_rack_h = _ch;
  );
);
