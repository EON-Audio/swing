// rk_swing_ui_panels_mixer.jsfx-inc
// Swing LCD mixer: 16-channel volume, pan, delay/reverb/smash sends
// Extracted from rk_swing_ui_panels.jsfx-inc — zero behavioral change
// (c) EON Studios — All Rights Reserved

@init

// Fader-law taper for the VOL strips: position p (0..1, bottom→top) maps to
// gain = 2·p³ — top = +6 dB, unity at ~79% height, matching how a REAPER
// fader feels. The old linear 0..2 map put unity at half-height and squashed
// the whole −12..0 dB working range into the bottom quarter of the strip
// (ugly next to the child-track faders the strips now mirror). Inverse via
// cube root for drawing. @gfx-only — the ^ operator never runs in @sample.
// Since 2026-10-29 the top is +12 dB (the owner: "it can only do plus 6 ... can we increase those values?"): gain = 4·p³,
// unity at ~63% -- the gain controls' one taper (rk_swing_core swing_gain_*), as REAPER's own faders top out at +12.
function swing_panels_mix_p2g(_mp) ( swing_gain_p2g(_mp) );
function swing_panels_mix_g2p(_mg) ( swing_gain_g2p(_mg) );
MIX_UNITY_P = GAIN_UNITY_P;  // swing_panels_mix_g2p(1.0) — 0 dB reference height

// Etched inset bevel for the compact page's mini-slider bars: inner shadow on
// the top + left edges, lit bottom edge — the fader slot's recipe, so the flat
// bars sit with the chrome cap below them. Drawn over the fill so the fill
// reads as recessed; alphas low enough that its colour still shows through.
function swing_panels_mix_bevel(_bx, _by, _bw, _bh) (
  gfx_set(0, 0, 0, 0.45);
  gfx_rect(_bx, _by, _bw, 1);
  gfx_rect(_bx, _by, 1, _bh);
  gfx_set(1, 1, 1, 0.10);
  gfx_rect(_bx, _by + _bh - 1, _bw, 1);
);

// House plugins the pad insert rows hide unless the console option SHOW EON
// PLUGINS is on: the Drum Strip and the Macros relay the bridge puts on every
// pad track. Matched by the hash the bridge publishes per slot (the shared
// swing_fxcard_hash over the parsed display name: "EON Drum Strip" = 841833,
// "EON Macros" = 394141) and, should a desc ever change, by the published
// name prefix. They stay in the chain and in the picker's chain column.
CI_HOUSE_H1 = 841833; CI_HOUSE_H2 = 394141;
function swing_panels_ins_is_house(_q, _k) local(_h, _np) (
  _h = _q[CI_HASH + _k];
  _h == CI_HOUSE_H1 || _h == CI_HOUSE_H2 ? 1 : (
    _np = _q + CI_NAME + _k * CI_NAMEW;
    (_np[0] | 0) >= 9 && _np[1] == 69 && _np[2] == 79 && _np[3] == 78 && _np[4] == 32
      && ((_np[5] == 68 && _np[6] == 114 && _np[7] == 117 && _np[8] == 109)         // "EON Drum"
       || (_np[5] == 77 && _np[6] == 97 && _np[7] == 99 && _np[8] == 114)) ? 1 : 0;  // "EON Macr"
  );
);

// ─── Console inserts: read the bridge's summary ───────────────────────────
// Seqlock. Odd = the bridge is mid-write, so the frame is skipped entirely
// rather than drawn from half a picture. The seq is re-read AFTER the copy:
// if it moved, the bridge wrote straight through us and the snapshot is torn,
// so it is dropped and the next frame takes a fresh one. Cheap — the bridge
// only republishes when a chain actually changes.
function swing_panels_conins_read() local(_b, _s, _p, _q, _pad, _k, _hb) (
  // C-5 here too (audit PL I7, 2026-10-26): with no registry slot (the registry full, or the
  // re-claim settle) the clamp read slot 0's band and drew ANOTHER Swing's chains on these strips.
  // Unslotted, nothing is read: no strip draws an insert row, the master's band hides, and the
  // band's message line says why. The seq resets so the first slotted frame takes a full read.
  _conins_noslot = _reg_my_slot < 0;
  _conins_noslot ? (
    _conins_stale = 0; _conins_oldfmt = 0; _conins_flags = 0; _conins_bankok = 0;
    _conins_maxn = 0; _conins_padmax = 0; _conins_seq = -1;
  ) : (
    _b = EON_CONINS_BASE
       + max(0, min(EON_CONINS_SLOTS - 1, _reg_my_slot)) * EON_CONINS_STRIDE;

    // ── Is the bridge actually there? ────────────────────────────────────────
    // ⚠️ Without this, a bridge that is not running is INDISTINGUISHABLE from
    // sixteen pads that own no track: both leave the band drawing dead dashes,
    // and the interface states a fact ("no inserts here") that it does not know.
    //
    // The beat is a COUNTER, not a clock — the face has no wall clock to compare
    // the bridge's against. All that matters is whether it moved, so a movement
    // is timestamped locally and staleness measured from that.
    // Flags: bit0 multi-out present, bit1 could not look up (no SWS).
    _conins_flags = gmem[_b + CI_FLAGS] | 0;
    _hb = gmem[_b + CI_HB];
    _hb != _conins_hb ? ( _conins_hb = _hb; _conins_hb_t = time_precise(); );
    // 2 s against a 0.5 s publish: three missed beats before crying wolf.
    _conins_stale = (_conins_hb <= 0) || (time_precise() - _conins_hb_t > 2.0);
    // ⭐ A LIVE BRIDGE RUNNING THE OLD LAYOUT is worse than a dead one: it
    // publishes confidently into a record that has since moved, and the face
    // draws the wreckage as if it were data. Twice today that surfaced as a
    // mystery (blank cards, then garbled names) rather than as a message.
    _conins_oldfmt = !_conins_stale && gmem[_b + CI_FMT] != CI_FMT_VER;
    // The strip records are the strips of the bank in CI_BANK (step 5): after a bank switch they describe the old
    // bank until the bridge's next publish, so the strips draw none of them until it lands.
    _conins_bankok = (gmem[_b + CI_BANK] | 0) == bank_cur;

    _s = gmem[_b + CI_SEQ];
    (_s & 1) == 0 && _s != _conins_seq && _s > 0 ? (
      // 17 uniform records — pads 0..15 then the MASTER at 16. It used to be
      // a header special case; making it a record means one copy loop, one
      // draw call and one decode, so none of them can drift from the others.
      _conins_maxn = 0;
      _conins_padmax = 0;   // pads only (no master): does ANY pad hold an insert?
      _pad = 0;
      loop(CI_RECS,
        _p = _b + CI_HDR + _pad * CI_PREC;
        _q = _conins_buf + _pad * CIF_REC;
        _q[CI_COUNT] = gmem[_p + CI_COUNT];
        _k = 0;
        loop(CI_CARD - CI_SLOT,   // slots + names + hashes
          _q[CI_SLOT + _k] = gmem[_p + CI_SLOT + _k];
          _k += 1;
        );
        // Resolve each slot's CARD once, here. Same trick the chain snapshot
        // uses: hashing 17 x 8 names every frame just to draw them would be
        // absurd, and the answer only changes when a publish lands.
        _k = 0;
        loop(CI_NSLOT,
          // ⭐ Look up from the BRIDGE's hash of the FULL name. Hashing the
          // truncated name here found nothing for anything longer than the
          // field -- which is most plugins, and would have made the Drum Strip
          // card invisible on the very strips it was drawn for.
          _q[CI_CARD + _k] = _q[CI_HASH + _k] > 0
            ? swing_fxcard_lookup(_q[CI_HASH + _k]) : -1;
          _k += 1;
        );
        // The FULLEST channel decides how many slots every strip draws --
        // per-strip counts would give per-strip heights, which is the one
        // thing the desk cannot have.
        // VISIBLE rows: the filled slots, minus the house plugins when the
        // console hides them (pads only -- the master strip shows all). Rows
        // map to REAL slots through CI_VIS, so every click, drag and menu
        // still names the slot the bridge published.
        _ci_vn = 0; _k = 0;
        loop(CI_NSLOT,
          _q[CI_SLOT + _k] >= 0 && !(!con_ins_house && _pad < 16 && swing_panels_ins_is_house(_q, _k)) ? (
            _q[CI_VIS + _ci_vn] = _k; _ci_vn += 1;
          );
          _k += 1;
        );
        _k = _ci_vn; loop(CI_NSLOT - _ci_vn, _q[CI_VIS + _k] = -1; _k += 1; );
        _q[CI_VISN] = _ci_vn;
        _ci_vn > _conins_maxn ? _conins_maxn = _ci_vn;
        _pad < 16 && _ci_vn > _conins_padmax ? _conins_padmax = _ci_vn;
        _pad += 1;
      );
      gmem[_b + CI_SEQ] == _s ? _conins_seq = _s;
    );
  );
);

// Category colour for a slot word. Same vocabulary the picker's rail uses, so
// a plugin is the same colour wherever you meet it.
function swing_panels_ins_col(_cat, _a) (
  _cat == 0 ? gfx_set(0.86, 0.35, 0.31, _a) :   // dynamics
  _cat == 1 ? gfx_set(0.43, 0.79, 0.43, _a) :   // EQ
  _cat == 2 ? gfx_set(0.88, 0.54, 0.16, _a) :   // saturation / drive
  _cat == 3 ? gfx_set(0.35, 0.60, 0.86, _a) :   // delay
  _cat == 4 ? gfx_set(0.60, 0.42, 0.85, _a) :   // reverb
  _cat == 5 ? gfx_set(0.85, 0.72, 0.25, _a) :   // limiter
  _cat == 6 ? gfx_set(0.30, 0.74, 0.74, _a) :   // modulation
  _cat == 7 ? gfx_set(0.80, 0.45, 0.62, _a) :   // pitch / vocal
              gfx_set(0.55, 0.60, 0.66, _a);    // everything else
);

// One strip's insert column.
//
// ⚠️ A pad only owns a REAPER track in MULTI-OUT. Every other pad plays through
// Swing's own chain and has nowhere to put a plugin, so its slots are drawn
// DEAD — a fainter dash, no + — rather than as empty add-boxes. An inviting
// +box on a pad that cannot take one is a lie the interface would be telling.
// Point the picker at one chain slot and open it. Payload first, seq LAST —
// the bridge is edge-triggered on the seq, so the target has to be in place
// before the seq announces it.
//
// The SLOT a strip shows on the bank on screen, -1 for the master (record 16).
// Taken AT THE CLICK by everything that acts later (the slot menu, the drag):
// a bank switch between the click and the action -- an EON bank action from a
// key or a toolbar while the menu is open -- must not move the aim to the other
// bank's chain (review 2026-10-12).
function swing_panels_strip_ap(_pi) ( _pi >= 16 ? -1 : swing_bp(_pi); );

// _ap: a SLOT 0..63 (swing_panels_strip_ap), -1 for the master/bus (what the
// bridge's record numbering calls it). A slot goes out as kind 1 (Pad Banks
// Outputs step 5): the bridge aims at the track or the Wired container that
// slot plays through -- bank A's pad, a bank's, a split pad's. Kind 0 (bank A's
// pair = the strip) is what older faces sent.
function swing_panels_ins_aim_do(_ap, _slot, _filled) local(_b) (
  _b = EON_FXPICK_BASE
     + max(0, min(EON_FXPICK_SLOTS - 1, _reg_my_slot)) * EON_FXPICK_STRIDE;
  gmem[_b + FXP_TGT_PAD]  = _ap;
  gmem[_b + FXP_TGT_SLOT] = _slot;
  gmem[_b + FXP_TGT_KIND] = _ap < 0 ? 0 : 1;   // a slot (step 5); the master stays kind 0
  gmem[_b + FXP_TGT_SEQ]  = gmem[_b + FXP_TGT_SEQ] + 1;   // SEQ LAST
  // STEREO with Wired OFF: an ADD on a pad is also the request to switch
  // Wired on. The insert lands on Swing's own track pinned to the pad's pair
  // either way (the bridge's pad view); Wired is what makes it audible.
  // Consumed in Swing's @gfx as CMD 41 -- the raise function lives in a
  // later import, so it cannot be called from here at compile time.
  !_filled && _ap >= 0 && (_conins_flags & 4) && (_conins_flags & 8) ? _ins_want_wired = 1;
  // ⭐ Tell the PICKER what a pick should mean, directly -- both live in this
  // same JSFX, so this needs no protocol and cannot arrive a frame late.
  // A FILLED slot is a SWAP of that slot; an EMPTY one is an INSERT, which
  // is what makes clicking an empty slot actually ADD a plugin instead of
  // opening a picker that then does something else.
  _fxv_csel = _filled ? _slot : -1;
);

// C-5 (audit C 2026-09-14): with no registry slot the latch of -1 clamped to slot 0 and
// the aim landed in slot 0's band, so the picker bridge pointed slot 0's Swing's picker
// at this instance's choice. Unslotted, the aim is dropped whole (the FX page shows the
// registry-full notice instead of a list). The body above is unchanged under its _do name.
function swing_panels_ins_aim(_ap, _slot, _filled) (
  _reg_my_slot >= 0 ? swing_panels_ins_aim_do(_ap, _slot, _filled);
);

// Aim AND navigate. Split from the aim above because a menu action has to
// point the bridge at a chain WITHOUT walking the user off the console --
// bypassing a plugin should leave you looking at the desk.
function swing_panels_ins_target(_ap, _slot, _filled) (
  swing_panels_ins_aim(_ap, _slot, _filled);
  swing_bigview_open(VIEW_FXPICK);
);

// Lift one slot's published name into #_ins_name. Length-prefixed, so there
// is no terminator to hunt for and a name cannot run off the end of the
// record. Same convention as lens_read_path and the kit tile.
function swing_panels_ins_name(_pi, _k) local(_np, _n2, _i) (
  strcpy(#_ins_name, "");
  _np = _conins_buf + _pi * CIF_REC + CI_NAME + _k * CI_NAMEW;
  _n2 = min(CI_NCHAR, max(0, _np[0] | 0));
  _n2 > 0 ? (
    _i = 0;
    loop(_n2, str_setchar(#_ins_name, _i, _np[1 + _i] | 0); _i += 1; );
    str_setlen(#_ins_name, _n2);
  );
  _n2;
);

function swing_panels_ins_band(_pi, _bx, _by, _bw, _n, _sh, _full)
         local(_q, _cnt, _k, _ks, _w, _cat, _byp, _off, _sy, _dx, _cx2, _shown,
               _hov, _ins_card, _ins_tp) (
  _q = _conins_buf + _pi * CIF_REC;
  _cnt = _q[0];

  _full ? (
    _k = 0;
    loop(_n,
      _sy = _by + _k * (_sh + swing_px(2));   // the pitch _mix_ins_h reserves (PL I9)
      // _k is the SCREEN row; _ks is the slot it shows. The viewport offset
      // (con_ins_scroll) is GLOBAL — all sixteen strips scroll together,
      // because per-strip scroll would give per-strip rows, the one thing
      // the desk cannot have. Everything that names a slot uses _ks.
      _ci_kr = _k + con_ins_scroll;                          // the visible ROW
      _ci_vcnt = _q[CI_VISN] | 0;
      _ks = _ci_kr < _ci_vcnt ? (_q[CI_VIS + _ci_kr] | 0) : -1;   // its REAL slot; -1 = an empty row
      _w = _ks >= 0 ? _q[CI_SLOT + _ks] : -1;
      // Decode ONCE, here, so the tooltip, the menu and the paint below all
      // read the same answer. Each used to decode separately, which is how
      // two views of one slot start disagreeing.
      _off = _w >= 128; _cat = _w - _off * 128;
      _byp = _cat >= 64; _cat = _cat - _byp * 64;

      // A slot is only a control when the pad owns a track. Dead slots take no
      // hover and no click — the whole point of drawing them dead is that they
      // are not offering anything.
      // UNKNOWN outranks everything: with no bridge we do not know what is
      // in this slot, and a slot we cannot read is not a slot you can click.
      _hov = !_conins_stale && _cnt >= 0 && mx >= _bx && mx <= _bx + _bw
                            && my >= _sy && my <= _sy + _sh;
      // A dead slot took no hover at all, so it could not even say WHY it
      // was dead. It is not clickable, but it is explainable.
      _cnt < 0 && !_conins_stale && mx >= _bx && mx <= _bx + _bw
               && my >= _sy && my <= _sy + _sh ?
        swing_tooltip_check(1097,
          "This pad has no REAPER track, so it has nowhere to put a plugin. "
          "Build multi-out tracks to give it inserts.");
      _conins_stale && mx >= _bx && mx <= _bx + _bw
                    && my >= _sy && my <= _sy + _sh ?
        swing_tooltip_check(1098,
          "Insert state unknown — the FX Picker bridge is not running. "
          "Run the 'EON: FX Picker bridge' action.");
      _hov ? (
        _w < 0 ? (
          // a strip on its bank's pair (step 5: banks B-D by default) shares one insert with the bank's pads
          _ins_tp = _pi < 16 ? swing_out_wpair(swing_panels_strip_ap(_pi), patch_live ? patch_v2 : 1) : -1;
          swing_tooltip_check(1100 + _pi * 8 + _ci_kr,
            !(_conins_flags & 8) ? "Empty insert slot — click to add a plugin here." :
            _ins_tp >= OUT_PAIR_BANK && _ins_tp < OUT_PAIR_SPLIT
              ? sprintf(#_ins_tip, "Empty insert slot — click to add a plugin to Bank %c's insert: every pad on Bank %c's pair hears it. Wired switches on with it.",
                        66 + _ins_tp - OUT_PAIR_BANK, 66 + _ins_tp - OUT_PAIR_BANK)
              : "Empty insert slot — click to add a plugin on this pad. Wired switches on with it.");
        ) : (
          // Name it. The bridge publishes a truncated display name per slot,
          // so the tooltip can say WHICH plugin rather than only what kind.
          swing_panels_ins_name(_pi, _ks);
          strcpy(#_ins_tip, #_ins_name);
          strlen(#_ins_tip) < 1 ? strcpy(#_ins_tip, "Insert");
          _off ? strcat(#_ins_tip, " — offline") :
          _byp ? strcat(#_ins_tip, " — bypassed") :
                 strcat(#_ins_tip, "");
          strcat(#_ins_tip, ". Click to open · right-click for options.");
          swing_tooltip_check(1100 + _pi * 8 + _ci_kr, #_ins_tip);
        );
      );
      // ⭐ A FILLED slot FLOATS its plugin; an empty one opens the picker.
      // Click used to always open the picker, which is the SWAP affordance
      // rather than what clicking a plugin means anywhere else. Aim first
      // either way, so the bridge acts on THIS pad's chain.
      //
      // A press on a FILLED slot LATCHES rather than acting: 4 px of
      // vertical travel makes it a reorder drag, release without travel is
      // the float click. Right-click stays the menu — float-on-right-click
      // was rejected because clicking a plugin to open it is the DAW
      // convention.
      _hov && lmb_down && active_id == -1 ? (
        // ⚠️ _insd_live IS THE LATCH, not active_id -- see the continuation in
        // swing_panels_draw_mixer for why the id cannot carry a gesture whose
        // meaning is decided on the RELEASE frame. 308, not 295: 295 is the
        // pad overlay's own slider.
        _w >= 0 ? ( active_id = 308; _insd_live = 1;
                    _insd_pad = _pi; _insd_slot = _ks;
                    _insd_ap = swing_panels_strip_ap(_pi); _insd_bank = bank_cur;
                    _insd_y0 = my; _insd_on = 0; )
                : (
          // COMPACT picker, over the desk -- not the full-window one that
          // replaces it. Aim first so the bridge is pointed at this pad's
          // chain before the list is asked for.
          swing_panels_ins_aim(swing_panels_strip_ap(_pi), _ks, 0);
          con_pick_open = 1; con_pick_pad = _pi; con_pick_slot = _ks; con_pick_ap = swing_bp(_pi);
          con_pick_fill = 0; con_pick_scroll = 0;
          con_pick_x = _bx; con_pick_y = _sy;
          // ⭐ CLEAR THE STALE QUERY, AND TELL THE BRIDGE. The query cells
          // survive from the big view's last search and request() alone never
          // resends them — so a picker opened after a big-view search was
          // silently filtered by text this face had nowhere to show. q_send
          // pushes the now-empty query AND the bank; the follow-up request
          // sizes the page for THIS window, because q_send's own ask is
          // scaled by _fxv_want, which is still 0 until the big view has
          // opened once — a 2-row page that read as "most plugins missing".
          swing_fxview_q_clear();
          swing_fxview_q_send();
          swing_fxview_request(0, 24);
          _cpk_qfoc = !is_embedded;   // type-to-filter from the first frame
          active_id = -1;             // ⚠️ picker path only — a filled slot
                                      // just latched the drag on active_id
        );
      );
      // RIGHT-CLICK: the slot's own menu. Remembers WHICH slot on the way in,
      // because the popup answers on a later frame by which time the pointer
      // has moved and _pi/_ks are long gone. ⚠️ The SLOT (_ks), not the screen
      // row: scrolled, a row-numbered menu would bypass or delete a plugin
      // you were not pointing at.
      _hov && rmb_down && active_id == -1 ? (
        _ins_menu_slot = _ks; _ins_menu_ap = swing_panels_strip_ap(_pi);
        _ins_menu_filled = _w >= 0;
        // Bypass and Offline are READ BACK, so they carry real ticks.
        // ⚠️ Embed cannot: REAPER exposes no way to ask whether an FX is
        // embedded, in either direction. It is drawn as an ACTION, and a tick
        // there would be a guess that goes wrong the first time someone embeds
        // from REAPER's own FX chain instead.
        _w >= 0 ? (
          strcpy(#_ins_menu, "#INSERT SLOT|Float plugin window|");
          strcat(#_ins_menu, "Open in FX picker|");
          strcat(#_ins_menu, "Embed UI in TCP|Embed UI in MCP||");
          strcat(#_ins_menu, _byp ? "!Bypass|" : "Bypass|");
          strcat(#_ins_menu, _off ? "!Offline||" : "Offline||");
          strcat(#_ins_menu, "^r Delete");
        ) : (
          strcpy(#_ins_menu, "#EMPTY SLOT|Add FX here...");
        );
        swing_popup_open(mx, my, #_ins_menu, SP_POPUP_CALLER_INS_SLOT);
      );

      _conins_stale ? (
        // UNKNOWN: no bridge, so no claim. Amber and hatched, so it reads
        // as "cannot say" rather than as the confident grey of "nothing
        // here" — the two must never look alike. Darker amber on the light
        // desk; same hue, so the vocabulary holds across finishes.
        _mix_ink ? gfx_set(0.55, 0.40, 0.08, 0.75) : gfx_set(0.72, 0.55, 0.18, 0.45);
        gfx_rect(_bx, _sy, _bw, 1); gfx_rect(_bx, _sy + _sh - 1, _bw, 1);
        gfx_rect(_bx, _sy, 1, _sh); gfx_rect(_bx + _bw - 1, _sy, 1, _sh);
        _mix_ink ? gfx_set(0.55, 0.40, 0.08, 0.35) : gfx_set(0.72, 0.55, 0.18, 0.22);
        gfx_line(_bx + 1, _sy + _sh - 2, _bx + _bw - 2, _sy + 1);
      ) : _cnt < 0 ? (
        // DEAD: pad owns no track.
        gfx_set(0.30, 0.34, 0.39, _mix_ink ? 0.55 : 0.30);
        gfx_rect(_bx, _sy, _bw, 1); gfx_rect(_bx, _sy + _sh - 1, _bw, 1);
        gfx_rect(_bx, _sy, 1, _sh); gfx_rect(_bx + _bw - 1, _sy, 1, _sh);
      ) : _w < 0 ? (
        // EMPTY but live: an add-box, and it means it. The outline colour sat
        // between the dark desks and the light one — on grey it all but
        // vanished, so the light desk gets a darker box.
        _mix_ink ? gfx_set(0.26, 0.31, 0.37, 0.75) : gfx_set(0.45, 0.52, 0.58, 0.55);
        gfx_rect(_bx, _sy, _bw, 1); gfx_rect(_bx, _sy + _sh - 1, _bw, 1);
        gfx_rect(_bx, _sy, 1, _sh); gfx_rect(_bx + _bw - 1, _sy, 1, _sh);
        gfx_rect(_bx + ((_bw / 2)|0) - 3, _sy + ((_sh / 2)|0), 7, 1);
        gfx_rect(_bx + ((_bw / 2)|0), _sy + ((_sh / 2)|0) - 3, 1, 7);
      ) : (
        // FILLED. Decoded by ARITHMETIC — see the band comment in the main
        // .jsfx for why this is not a shift.
        // A real card where the deck has one, the category colour where it
        // does not -- which also shows coverage at a glance: a flat block
        // means no art for that plugin.
        _ins_card = _q[CI_CARD + _ks];
        // ⚠️ >= 0, not > 0. -1 is the miss; 0 is a real card (the first record
        // in the deck), and testing > 0 sent it to the fallback.
        _ins_card >= 0 ? (
          gfx_a = _off ? 0.22 : (_byp ? 0.42 : 1);
          swing_fxcard_draw(_bx, _sy, _bw, _sh, _ins_card);
          gfx_a = 1;
        ) : (
          // ⭐ The SAME blank card the picker's list draws -- a category-
          // coloured face plus the category glyph -- not a flat rectangle.
          // The desk was the one place a plugin without art lost its card
          // entirely and became a colour block, which is why the colour-coded
          // ones stopped showing up here.
          gfx_a = _off ? 0.20 : (_byp ? 0.35 : 1);
          swing_fxview_blank_card(_bx, _sy, _bw, _sh,
                                  swing_fxview_bucket_hex(_cat),
                                  _q[CI_HASH + _ks], _cat);
          gfx_a = 1;
        );
        gfx_set(0, 0, 0, 0.45);
        gfx_rect(_bx, _sy, _bw, 1); gfx_rect(_bx, _sy + _sh - 1, _bw, 1);
        // Bypassed reads as struck through, not merely dimmer: dimmer alone
        // is indistinguishable from a darker category colour.
        _byp ? ( gfx_set(0.95, 0.95, 0.95, 0.75);
                 gfx_rect(_bx + 2, _sy + ((_sh / 2)|0), _bw - 4, 1); );
      );
      // Hover wash LAST so it sits over the slot rather than under it.
      // Dark wash on the light desk — a white wash over grey is no wash.
      _hov ? (
        _mix_ink ? gfx_set(0, 0, 0, 0.10) : gfx_set(1, 1, 1, 0.13);
        gfx_rect(_bx, _sy, _bw, _sh);
      );
      // Reorder drag, this strip: the grabbed slot dims, the drop target
      // wears the accent outline. The target tracks the POINTER, clamped to
      // slots the chain actually owns — dropping past the last plugin is a
      // move to the end, not a move into empty air.
      _insd_live && _insd_on && _insd_pad == _pi ? (
        _ks == _insd_slot ? (
          gfx_set(0, 0, 0, 0.35); gfx_rect(_bx, _sy, _bw, _sh);
        );
        // Screen row under the pointer, lifted into SLOT space by the same
        // viewport offset the rows were drawn with, then clamped to slots
        // the chain owns. Must match the drop's own arithmetic exactly --
        // an outline that promises a different slot than the drop takes is
        // worse than no outline.
        _ci_kr == max(0, min(max(0, _ci_vcnt - 1),
                 (((my - _by) / (_sh + swing_px(2))) | 0) + con_ins_scroll)) ? (
          gfx_set(0.45, 0.80, 0.90, 0.95);
          gfx_rect(_bx, _sy, _bw, 1); gfx_rect(_bx, _sy + _sh - 1, _bw, 1);
          gfx_rect(_bx, _sy, 1, _sh); gfx_rect(_bx + _bw - 1, _sy, 1, _sh);
        );
      );
      _k += 1;
    );
  ) : (
    // Summary bar: up to five pips and a count. Still says which slots are
    // filled and roughly what they are, which is all a folded band owes you.
    gfx_set(0, 0, 0, _mix_ink ? 0.50 : 0.32);
    gfx_rect(_bx, _by, _bw, 16);
    gfx_set(0.30, 0.62, 0.70, 0.18);
    gfx_rect(_bx, _by, _bw, 1); gfx_rect(_bx, _by + 15, _bw, 1);
    // Folded, the bar is still the way in: it opens the chain with NO slot
    // focused, so the picker's next pick ADDS at the end. Slot 0 focused
    // (as it was) turned that pick into a SWAP of slot 1 -- the hidden Drum
    // Strip on a multi-out pad, a slot that does not exist on an empty chain
    // (audit PL I1, 2026-10-26). _filled 1 = "not an add yet": the picker's
    // own add asks for Wired (swing_fxview_want_wired) when it lands.
    _hov = !_conins_stale && _cnt >= 0 && mx >= _bx && mx <= _bx + _bw
                          && my >= _by && my <= _by + 16;
    _hov ? swing_tooltip_check(1099,
      "Inserts, folded. Click to open this channel's chain in the FX picker.");
    _hov && lmb_down && active_id == -1 ? (
      swing_panels_ins_target(swing_panels_strip_ap(_pi), -1, 1); active_id = -1; );
    _conins_stale ? (
      rk_font(1, swing_fs(11), 'b');
      gfx_set(0.82, 0.63, 0.22, 0.95);
      gfx_measurestr("?", tw, th);
      gfx_x = _bx + ((_bw - tw) / 2)|0; gfx_y = _by + 4;
      gfx_drawstr("?");
    ) : _cnt < 0 ? (
      rk_font(1, swing_fs(11), 'b');
      gfx_set(0.48, 0.54, 0.60, 0.7);
      gfx_measurestr("--", tw, th);
      gfx_x = _bx + ((_bw - tw) / 2)|0; gfx_y = _by + 4;
      gfx_drawstr("--");
    ) : (
      _shown = min(5, max(1, _n));
      _dx = max(5, min(9, ((_bw - 8) / _shown)|0));
      _cx2 = _bx + ((_bw - _dx * _shown) / 2)|0;
      _k = 0;
      loop(_shown,
        // Through the VISIBLE rows, like the full band: the raw slot lit a pip
        // for the hidden Drum Strip / Macros on every multi-out strip (PL I8).
        _ks = _k < (_q[CI_VISN] | 0) ? (_q[CI_VIS + _k] | 0) : -1;
        _w = _ks >= 0 ? _q[CI_SLOT + _ks] : -1;
        _w < 0 ? gfx_set(0.16, 0.18, 0.21, 1) : (
          _off = _w >= 128; _w = _w - _off * 128;
          _byp = _w >= 64;  _cat = _w - _byp * 64;
          swing_panels_ins_col(_cat, _byp || _off ? 0.35 : 1);
        );
        gfx_rect(_cx2 + _k * _dx + 1, _by + 5, _dx - 2, 6);
        _k += 1;
      );
    );
    _hov ? (
      _mix_ink ? gfx_set(0, 0, 0, 0.08) : gfx_set(1, 1, 1, 0.10);
      gfx_rect(_bx, _by, _bw, 16);
    );
  );
);

// ─── Master strip ─────────────────────────────────────────────────────────
// ⭐ WHAT IT SHOWS FOLLOWS THE ROUTING, not a preference:
//   stereo out  — the pads summed INSIDE Swing, so the master is Swing's own
//                 output: master_db, its meter, and the bus compressor.
//   multi-out   — the pads left as 16 separate outputs and sum on their PARENT
//                 track in REAPER. That folder is the desk's master, and
//                 Swing's internal master gain is no longer where mixing
//                 happens.
// Same rule the insert slots already follow. It is one strip either way, and
// the scribble line names which one you are looking at, so it is never
// ambiguous — MASTER when Swing sums, BUS when REAPER does.
//
// ⛔ REAPER's PROJECT master is deliberately NOT an option. Swing does not own
// it, REAPER's own mixer already shows it, and two faders for one gain have no
// answer for which is right when they disagree.
//
// It is NOT a seventeenth channel: no sends, no pan, no pad colour, and its
// dynamics section is ONE compressor rather than the six pad stages — drawing
// six lamps there would imply six independent stages that do not exist.
function swing_panels_master_band(_bx, _by, _bw, _bh, _full)
         local(_gr, _h) (
  // Backing alpha was tuned against a near-black desk; on the light finish
  // 0.20 black over grey leaves the labels inside nothing to stand on.
  gfx_set(0, 0, 0, _mix_ink ? 0.45 : 0.20);
  gfx_rect(_bx, _by, _bw, _bh);
  gfx_set(0.42, 0.62, 0.72, 0.22);
  gfx_rect(_bx, _by, _bw, 1);
  gfx_rect(_bx, _by + _bh - 1, _bw, 1);

  // Gain reduction, display-smoothed, drawn downward from the top like every
  // GR meter ever built. cmp_gr_smooth is negative dB.
  _gr = min(20, max(0, -cmp_gr_smooth));

  _full ? (
    rk_font(1, swing_fs(11), 'b');
    !cmp_bypass ? gfx_set(0.72, 0.86, 0.92, 1) : gfx_set(0.48, 0.54, 0.60, 0.85);
    gfx_measurestr("WELD", tw, th);
    gfx_x = _bx + ((_bw - tw) / 2)|0; gfx_y = _by + 2;
    gfx_drawstr("WELD");
    // GR bar
    gfx_set(0.05, 0.06, 0.08, 0.9);
    gfx_rect(_bx + 4, _by + 13, _bw - 8, _bh - 17);
    _h = ((_bh - 19) * (_gr / 20))|0;
    !cmp_bypass && _h > 0 ? (
      gfx_set(0.86, 0.55, 0.28, 0.9);
      gfx_rect(_bx + 5, _by + 14, _bw - 10, _h);
    );
    rk_font(1, swing_fs(10), 'b');
    gfx_set(0.72, 0.80, 0.86, 0.95);
    sprintf(#_mst_gr, "%.0f", _gr);
    gfx_measurestr(#_mst_gr, tw, th);
    gfx_x = _bx + ((_bw - tw) / 2)|0; gfx_y = _by + _bh - 10;
    gfx_drawstr(#_mst_gr);
  ) : (
    !cmp_bypass ? gfx_set(0.86, 0.55, 0.28, _gr > 0.2 ? 1 : 0.45)
                : gfx_set(0.16, 0.18, 0.21, 1);
    gfx_circle(_bx + ((_bw / 2)|0), _by + ((_bh / 2)|0), 2.6, 1, 1);
  );
);

// ─── Swing's own chain, as a band on the strip ────────────────────────────
// The pad's fixed chain (rk_drumkit_fx.jsfx-inc): in FULL, the seven knobs the
// pad FX page has with EQ as a lamp in the band header; otherwise a bar of six
// pips, HPF · LPF · EQ · CMP · BIT · DRV (see swing_panels_sw_band). Fixed, not
// chips, because chips promise slots you can add, remove and reorder, and none
// of that is possible here; someone would have tried.
//
// On a console this is NOT an insert. It is the channel's own EQ/dynamics
// section, and it sits ABOVE the inserts: that is the signal order (the BAND
// ORDER note in the layout, 2026-09-09).
//
// "Engaged" is per stage, and each has its own off-value rather than a flag:
//   HPF 20 Hz (below audible) · LPF 20000 (above it) · the rest are zero.
// Reading the parameter instead of a separate enable bit means the lamp can
// never disagree with what the audio is doing.
function swing_panels_sw_lit(_pi, _st) (
  _st == 0 ? fx_hpf_freq[_pi] > 20.5 :
  _st == 1 ? fx_lpf_freq[_pi] < 19999 :
  _st == 2 ? (abs(fx_eq_lo[_pi]) + abs(fx_eq_mid[_pi])
            + abs(fx_eq_mid2[_pi]) + abs(fx_eq_hi[_pi])) > 0.05 :
  _st == 3 ? fx_cmp_amt[_pi] > 0.001 :
  _st == 4 ? (fx_bc_rate[_pi] > 0.001 || fx_bc_bits[_pi] < 15.5) :
             fx_sat_drv[_pi] > 0.001;
);

// Stage colour. Filter stages share a hue on purpose — they are one section of
// the circuit, and giving LPF its own colour would imply otherwise.
function swing_panels_sw_col(_st, _a) (
  _st <= 1 ? gfx_set(0.35, 0.60, 0.86, _a) :   // HPF / LPF
  _st == 2 ? gfx_set(0.43, 0.79, 0.43, _a) :   // EQ
  _st == 3 ? gfx_set(0.86, 0.35, 0.31, _a) :   // CMP
  _st == 4 ? gfx_set(0.69, 0.48, 0.82, _a) :   // BIT
             gfx_set(0.88, 0.54, 0.16, _a);    // DRV
);

// Stage colour as THREE NUMBERS. swing_panels_sw_col sets the pen, which is
// what a lamp needs; a knob is handed its colour as arguments, so the same
// palette has to be reachable both ways or the lamps and the knobs drift apart.
function swing_panels_sw_rgb(_st) (
  _st <= 1 ? ( _swk_r = 0.35; _swk_g = 0.60; _swk_b = 0.86; ) :   // HPF/LPF/RESO
  _st == 2 ? ( _swk_r = 0.43; _swk_g = 0.79; _swk_b = 0.43; ) :   // EQ
  _st == 3 ? ( _swk_r = 0.86; _swk_g = 0.35; _swk_b = 0.31; ) :   // CMP
  _st == 4 ? ( _swk_r = 0.69; _swk_g = 0.48; _swk_b = 0.82; ) :   // BIT
             ( _swk_r = 0.85; _swk_g = 0.62; _swk_b = 0.30; );    // DRV
);

// One knob's seat in the grid, by index. ROW-major: column-major would put HPF
// and RATE side by side, and the pad page's reading order -- filters, then the
// FX section -- is the whole point of aligning the two.
function swing_panels_swk_at(_bx, _by, _ix) local(_cw) (
  _cw = (_mix_bar_w / _mix_sw_cols)|0;
  _swk_cx = _bx + _cw * (_ix % _mix_sw_cols) + (_cw / 2)|0;
  _swk_cy = _by + 13 + ((_ix / _mix_sw_cols)|0) * _mix_sw_cellh + _mix_sw_krr + 1;
);

// The cap under a knob: its NAME normally, its VALUE while the pointer is on
// it. Both at once needs a row per knob the strip has not got, and a value you
// can only see by hovering is still a value you can see -- whereas a knob with
// no name is a knob you have to remember.
function swing_panels_swk_cap(_lbl, _hot) local(_tw, _th) (
  rk_font(1, swing_fs(8), 'b');
  gfx_set(0.70, 0.74, 0.78, _hot ? 1 : 0.8);
  gfx_measurestr(_lbl, _tw, _th);
  gfx_x = _swk_cx - (_tw / 2)|0;
  gfx_y = _swk_cy + _mix_sw_krr + 1;
  gfx_drawstr(_lbl);
);

function swing_panels_swk_val(_hot) local(_tw, _th) (
  _hot ? (
    rk_font(1, swing_fs(8), swing_fs(8) >= 10 ? 'b' : 0);   // a value: bold from 10 px (wiki 4.7)
    gfx_set(0.92, 0.95, 0.98, 1);
    gfx_measurestr(#swk_v, _tw, _th);
    gfx_x = _swk_cx - (_tw / 2)|0;
    gfx_y = _swk_cy + _mix_sw_krr + 1;
    gfx_drawstr(#swk_v);
  );
);

// _full: the seven knobs the pad FX page has, in its order. Otherwise a 16 px
// summary bar -- six pips, lit = engaged, which is the whole of what the bar
// has to say. The BAR keeps its EQ pip: a summary is exactly where a four-band
// curve can honestly be one lamp.
function swing_panels_sw_band(_pi, _bx, _by, _bw, _bh, _full)
         local(_st, _dx, _cx2, _hot, _km, _nv, _lg) (
  // Same light-desk deepening as the master band -- the labels keep their
  // dark-ground colours because the backing gives them their ground back.
  gfx_set(0, 0, 0, _mix_ink ? 0.45 : 0.20);
  gfx_rect(_bx, _by, _bw, _bh);
  gfx_set(0.30, 0.62, 0.70, 0.18);
  gfx_rect(_bx, _by, _bw, 1);
  gfx_rect(_bx, _by + _bh - 1, _bw, 1);

  _full ? (
    rk_font(1, swing_fs(9), 'b');
    gfx_set(0.50, 0.60, 0.66, 0.9);
    gfx_measurestr("SWING", tw, th);
    gfx_x = _bx + ((_bw - tw) / 2)|0; gfx_y = _by + 2;
    gfx_drawstr("SWING");
    // ⚠️⚠️  THE EQ LAMP, in the header rather than the grid. The pad page draws
    // EQ as a CURVE, so a knob here would invent a control that does not exist
    // over there -- and the lamp is still the only way the desk can say the EQ
    // is doing something.
    swing_panels_sw_lit(_pi, 2) ? swing_panels_sw_col(2, 1)
                                : gfx_set(0.16, 0.18, 0.21, 1);
    gfx_circle(_bx + 5, _by + 6, 2.8, 1, 1);
    mx >= _bx + 1 && mx <= _bx + 10 && my >= _by + 1 && my <= _by + 12 ?
      swing_tooltip_check(880 + _pi,
        "This pad's EQ is doing something. The curve itself lives on the pad's FX page.");

    // -- HPF -- log domain and the 25 Hz snap are the pad page's own:
    // 20 Hz reads as OFF, so the knob must not be able to sit just above it.
    swing_panels_swk_at(_bx, _by, 0);
    _hot = dist(mx, my, _swk_cx, _swk_cy) <= _mix_sw_krr + 2;
    _km  = km_console + (_pi * KM_CON_PER_PAD + 4) * KS;
    _lg  = log10(max(20, fx_hpf_freq[_pi]));
    swing_panels_sw_rgb(0);
    rk_knob_draw(_mix_kstyle, _swk_cx, _swk_cy, _mix_sw_krr, _lg,
                 log10(20), log10(8000), 0, _km[0],
                 _swk_r, _swk_g, _swk_b, 0, 0.36, 0.34, 0.32);
    _nv = ssl_knob_interact(_km, _swk_cx, _swk_cy, _mix_sw_krr, _lg,
                            log10(20), log10(8000), log10(20), 0);
    _nv != _lg ? (
      fx_hpf_freq[_pi] = pow(10, _nv);
      fx_hpf_freq[_pi] <= 25 ? fx_hpf_freq[_pi] = 20;
      swing_rcp_post_fx(_pi); mark_dirty_pad(_pi);
    );
    fx_hpf_freq[_pi] > 25 ?
      ( fx_hpf_freq[_pi] >= 1000 ? sprintf(#swk_v, "%.1fk", fx_hpf_freq[_pi] / 1000)
                                 : sprintf(#swk_v, "%.0f", fx_hpf_freq[_pi]); )
      : strcpy(#swk_v, "OFF");
    _hot ? swing_panels_swk_val(1) : swing_panels_swk_cap("HPF", 0);

    // -- LPF --
    swing_panels_swk_at(_bx, _by, 1);
    _hot = dist(mx, my, _swk_cx, _swk_cy) <= _mix_sw_krr + 2;
    _km  = km_console + (_pi * KM_CON_PER_PAD + 5) * KS;
    _lg  = log10(max(200, fx_lpf_freq[_pi]));
    swing_panels_sw_rgb(1);
    rk_knob_draw(_mix_kstyle, _swk_cx, _swk_cy, _mix_sw_krr, _lg,
                 log10(200), log10(20000), 0, _km[0],
                 _swk_r, _swk_g, _swk_b, 0, 0.36, 0.34, 0.32);
    _nv = ssl_knob_interact(_km, _swk_cx, _swk_cy, _mix_sw_krr, _lg,
                            log10(200), log10(20000), log10(20000), 0);
    _nv != _lg ? (
      fx_lpf_freq[_pi] = pow(10, _nv);
      fx_lpf_freq[_pi] >= 19500 ? fx_lpf_freq[_pi] = 20000;
      swing_rcp_post_fx(_pi); mark_dirty_pad(_pi);
    );
    fx_lpf_freq[_pi] < 19500 ?
      ( fx_lpf_freq[_pi] >= 1000 ? sprintf(#swk_v, "%.1fk", fx_lpf_freq[_pi] / 1000)
                                 : sprintf(#swk_v, "%.0f", fx_lpf_freq[_pi]); )
      : strcpy(#swk_v, "OFF");
    _hot ? swing_panels_swk_val(1) : swing_panels_swk_cap("LPF", 0);

    // -- RESO -- the filter section's third control, and the one the
    // desk was missing outright -- there was never even a lamp for it.
    swing_panels_swk_at(_bx, _by, 2);
    _hot = dist(mx, my, _swk_cx, _swk_cy) <= _mix_sw_krr + 2;
    _km  = km_console + (_pi * KM_CON_PER_PAD + 6) * KS;
    swing_panels_sw_rgb(0);
    rk_knob_draw(_mix_kstyle, _swk_cx, _swk_cy, _mix_sw_krr, fx_reso[_pi],
                 0.707, 12.0, 0, _km[0],
                 _swk_r, _swk_g, _swk_b, 0, 0.36, 0.34, 0.32);
    _nv = ssl_knob_interact(_km, _swk_cx, _swk_cy, _mix_sw_krr, fx_reso[_pi],
                            0.707, 12.0, 0.707, 0);
    _nv != fx_reso[_pi] ? ( fx_reso[_pi] = _nv; swing_rcp_post_fx(_pi); mark_dirty_pad(_pi); );
    fx_reso[_pi] > 0.75 ? sprintf(#swk_v, "%.1f", fx_reso[_pi])
                        : strcpy(#swk_v, "FLAT");
    _hot ? swing_panels_swk_val(1) : swing_panels_swk_cap("RESO", 0);

    // -- RATE -- half of what used to be the single BIT lamp.
    swing_panels_swk_at(_bx, _by, 3);
    _hot = dist(mx, my, _swk_cx, _swk_cy) <= _mix_sw_krr + 2;
    _km  = km_console + (_pi * KM_CON_PER_PAD + 7) * KS;
    swing_panels_sw_rgb(4);
    rk_knob_draw(_mix_kstyle, _swk_cx, _swk_cy, _mix_sw_krr, fx_bc_rate[_pi],
                 0, 1.0, 0, _km[0],
                 _swk_r, _swk_g, _swk_b, 0, 0.36, 0.34, 0.32);
    _nv = ssl_knob_interact(_km, _swk_cx, _swk_cy, _mix_sw_krr, fx_bc_rate[_pi],
                            0, 1.0, 0, 0);
    _nv != fx_bc_rate[_pi] ? ( fx_bc_rate[_pi] = _nv; swing_rcp_post_fx(_pi); mark_dirty_pad(_pi); );
    sprintf(#swk_v, "%.0f%%", fx_bc_rate[_pi] * 100);
    _hot ? swing_panels_swk_val(1) : swing_panels_swk_cap("RATE", 0);

    // -- BITS -- the other half. Quantised on the way in, same as the
    // pad page: a bit depth of 11.4 is not a thing.
    swing_panels_swk_at(_bx, _by, 4);
    _hot = dist(mx, my, _swk_cx, _swk_cy) <= _mix_sw_krr + 2;
    _km  = km_console + (_pi * KM_CON_PER_PAD + 8) * KS;
    swing_panels_sw_rgb(4);
    rk_knob_draw(_mix_kstyle, _swk_cx, _swk_cy, _mix_sw_krr, fx_bc_bits[_pi],
                 1, 16, 0, _km[0],
                 _swk_r, _swk_g, _swk_b, 0, 0.36, 0.34, 0.32);
    _nv = ssl_knob_interact(_km, _swk_cx, _swk_cy, _mix_sw_krr, fx_bc_bits[_pi],
                            1, 16, 16, 0);
    _nv != fx_bc_bits[_pi] ? (
      fx_bc_bits[_pi] = floor(_nv + 0.5); swing_rcp_post_fx(_pi); mark_dirty_pad(_pi);
    );
    fx_bc_bits[_pi] < 15.5 ? sprintf(#swk_v, "%.0f", fx_bc_bits[_pi])
                           : strcpy(#swk_v, "16");
    _hot ? swing_panels_swk_val(1) : swing_panels_swk_cap("BITS", 0);

    // -- DRIVE -- ⚠️⚠️ NO recalc_fx. The saturator reads its drive straight
    // in @sample, exactly as the pad page has it. Adding a recalc here would be
    // the two views disagreeing about the engine, which is the whole thing this
    // alignment exists to stop.
    swing_panels_swk_at(_bx, _by, 5);
    _hot = dist(mx, my, _swk_cx, _swk_cy) <= _mix_sw_krr + 2;
    _km  = km_console + (_pi * KM_CON_PER_PAD + 9) * KS;
    swing_panels_sw_rgb(5);
    rk_knob_draw(_mix_kstyle, _swk_cx, _swk_cy, _mix_sw_krr, fx_sat_drv[_pi],
                 0, 1.0, 0, _km[0],
                 _swk_r, _swk_g, _swk_b, 0, 0.36, 0.34, 0.32);
    _nv = ssl_knob_interact(_km, _swk_cx, _swk_cy, _mix_sw_krr, fx_sat_drv[_pi],
                            0, 1.0, 0, 0);
    _nv != fx_sat_drv[_pi] ? ( fx_sat_drv[_pi] = _nv; mark_dirty_pad(_pi); );
    sprintf(#swk_v, "%.0f%%", fx_sat_drv[_pi] * 100);
    _hot ? swing_panels_swk_val(1) : swing_panels_swk_cap("DRIVE", 0);

    // -- COMP --
    swing_panels_swk_at(_bx, _by, 6);
    _hot = dist(mx, my, _swk_cx, _swk_cy) <= _mix_sw_krr + 2;
    _km  = km_console + (_pi * KM_CON_PER_PAD + 10) * KS;
    swing_panels_sw_rgb(3);
    rk_knob_draw(_mix_kstyle, _swk_cx, _swk_cy, _mix_sw_krr, fx_cmp_amt[_pi],
                 0, 1.0, 0, _km[0],
                 _swk_r, _swk_g, _swk_b, 0, 0.36, 0.34, 0.32);
    _nv = ssl_knob_interact(_km, _swk_cx, _swk_cy, _mix_sw_krr, fx_cmp_amt[_pi],
                            0, 1.0, 0, 0);
    _nv != fx_cmp_amt[_pi] ? ( fx_cmp_amt[_pi] = _nv; swing_rcp_post_fx(_pi); mark_dirty_pad(_pi); );
    sprintf(#swk_v, "%.0f%%", fx_cmp_amt[_pi] * 100);
    _hot ? swing_panels_swk_val(1) : swing_panels_swk_cap("COMP", 0);
  ) : (
    // Six pips across the bar, spaced from the bar's own width so the row
    // stays centred at any strip size.
    _dx = max(5, min(9, ((_bw - 6) / 6)|0));
    _cx2 = _bx + ((_bw - _dx * 6) / 2)|0;
    _st = 0;
    loop(6,
      swing_panels_sw_lit(_pi, _st) ? swing_panels_sw_col(_st, 1)
                                    : gfx_set(0.16, 0.18, 0.21, 1);
      gfx_circle(_cx2 + _st * _dx + ((_dx / 2)|0), _by + ((_bh / 2)|0), 2.6, 1, 1);
      _st += 1;
    );
  );
);

