// rk_swing_block_pitch.jsfx-inc
// Swing Pitch (Part B) protocol — Repitch / Tuned / Stretch.
// (c) EON Studios — All Rights Reserved
//
// Three pad pitch modes (per-pad):
//   0 = Repitch  — local SincResampler (today's path), zero latency,
//                  duration shortens with pitch (Battery default behavior)
//   1 = Tuned    — Signalsmith BakeEngine pre-render on tune-change, zero
//                  latency at trigger, duration preserved (the 90% case)
//   2 = Stretch  — realtime ElastiqueVoice via audio_hook, PDC-declared
//                  latency, duration preserved, supports live tune modulation
//
// All slot constants MIRROR rk_lua_core.lua → core.GMEM SP_PITCH_* block.
// Single source of truth is rk_lua_core.lua.
//
// Per-pad freemem arrays (sp_pitch_mode, sp_pitch_algo) stay in the main
// Swing_ReaKit.jsfx @init because they need NUM_PADS defined first. (The
// former sp_pitch_*_shadow arrays are GONE — the v3 stateless protocol has
// no JSFX-side shadows; the Extension owns the diff/debounce.) Everything else lives here.

@init

// ─── SP_PITCH gmem slot map (MIRROR of rk_lua_core.lua SP_PITCH_* block) ──
// Single-pad-request channel — slots 1445..1449 in Swing_Media_Transfer.
// History: original per-pad-per-instance design (1024 slots @ 70 M base)
// hit the NSEEL named-segment ceiling (32 M hard) and silently dropped
// writes. Embedding in the META block was blocked (offsets 0..79 fully
// claimed by @serialize). Settled on 5 free slots and a single pending
// request at a time. Real per-pad state stays in JSFX freemem
// (sp_pitch_mode[], sp_pitch_algo[]) — gmem only carries the "bake this
// pad now" wire.
SP_PITCH_PROTOCOL_VER       = 1445;   // JSFX writes value on first @block
SP_PITCH_HEARTBEAT          = 1446;   // Extension writes counter
SP_PITCH_REQ_PAD            = 1447;   // RESERVED (legacy v2 single-pad-request) — unused in v3
SP_PITCH_REQ_SHIFT_ST       = 1448;   // RESERVED (legacy v2) — unused in v3
SP_PITCH_REQ_ALGO           = 1449;   // RESERVED (legacy v2) — unused in v3
SP_PITCH_MODE_REVERT_PAD    = 2272;   // Extension 0..15 = pad flipped OUT of Tuned (v3:
                                       // Extension owns this write); bridge re-injects
                                       // original audio + writes -1 to ack
SP_PITCH_PDC_BUDGET         = 2273;   // Extension: worst-case Stretch latency
                                       // samples; JSFX assigns to pdc_delay when
                                       // changed. 0 = no Stretch pads / Extension dead.
// ─── Diagnostic counters REMOVED 2026-07-08 ─────────────────────────────
// SP_PITCH_DIAG_TICK_COUNT lived at 2274 — the SAME cell rk_lua_core/
// Swing_ReaKit later claimed for GS_KIT_PRESERVE_LIVE ("free gap between
// 2273 and 2276"). The tick counter incremented every @block, so
// GS_KIT_PRESERVE_LIVE was PERMANENTLY nonzero on any machine running the
// pitch tick: every kit load on a deserialized instance silently became a
// preserve-live reload — state 4 restored the pre-load (project-chunk)
// params over the freshly imported kit. That is how stale/poisoned pad
// state (mute=1/out=52, vel_hi=0.25, garbage names) survived every clean
// kit load (bug B persistence, project_strip_sync_pad0_stomp).
// All three counters were write-only (no readers anywhere in the tree).
// ⚠️ 2274/2275 are GS-range cells owned by rk_lua_core's GMEM map — never
// claim "free gap" cells from this file; check rk_lua_core.lua first.

// Step 3a — per-pad MODE band in the high end of the segment. JSFX writes
// each pad's current sp_pitch_mode value here whenever it changes; the
// Extension audio_hook reads in its isPost callback to decide which pads
// need Stretch-mode processing. 16 contiguous slots, pad N at base + N.
// See EON Extension src/gmem/swing_pitch_slots.h kStretchPerPadModeBase.
STRETCH_PER_PAD_MODE_BASE       = 32524288;

// Step 3b — per-pad TRIGGER counter and PITCH_ST bands. JSFX publishes a
// monotonic counter on each note-on for a Stretch-mode pad, and the
// pad's current p_tune value, so the Extension audio_hook can voice-
// trigger élastique with the correct pitch ratio.
STRETCH_PER_PAD_TRIGGER_BASE    = 32524304;
STRETCH_PER_PAD_PITCH_ST_BASE   = 32524320;
// Step 5a: per-pad algo selector. JSFX writes sp_pitch_algo[pad] here
// on every change; Extension main thread reads, looks up the élastique
// (mode<<16)|submode quality_param via the runtime-discovered table,
// and applies it to the voice via swing_stretch_hook_set_pad_quality.
STRETCH_PER_PAD_ALGO_BASE       = 32524336;

// Phase 1 (Refined Option B): per-pad p_tune MIRROR band. JSFX blast-
// writes p_tune[i] into mirror[i] from @slider AND @block AND @gfx (with
// options:gfx_idle in the main JSFX) so the Extension's main-thread
// TimeSlice can see current tune state regardless of transport / FX-
// window state. C++ owns the diff/debounce — JSFX-side shadow is NOT
// used for this wire. This REPLACES the SP_PITCH_REQ_PAD channel as the
// canonical Tuned-bake trigger, addressing the chronic "kinda works /
// sometimes doesn't" symptom of the @block-only publish that depended
// on REAPER's audio engine being live.
//
// Mirror block address mirrors C++ src/gmem/swing_pitch_slots.h
// kStretchPerPadTuneMirrorBase (= kStretchControlBase + 64 = 32524352).
STRETCH_PER_PAD_TUNE_MIRROR_BASE = 32524352;

// B1 multi-instance: the control band is strided per registry slot. One
// instance's region = 5 fields × 16 pads = 80 slots (MODE/TRIGGER/PITCH_ST/
// ALGO/TUNE_MIRROR at +0/+16/+32/+48/+64). This instance writes only its own
// slot's region at base_field + _reg_my_slot*STRETCH_CONTROL_INSTANCE_STRIDE.
// 16 instances top out at 32524288 + 15*80 + 64 + 15 = 32525567 — still inside
// NSEEL block 496 (32524288>>16 == 32525567>>16 == 496), so the single
// allocation write below covers the whole 16-instance region. Mirrors C++
// kStretchControlInstanceStride in src/gmem/swing_pitch_slots.h.
STRETCH_CONTROL_INSTANCE_STRIDE = 80;

// Per-pad SOURCE GENERATION band. NOT part of the Extension's control protocol
// (the C++ side never reads it) — it's a JSFX→Kit-Bridge wire so the bridge can
// detect a pad whose audio was swapped (drag-drop/browser/clear) and invalidate
// the Extension's cached Tuned-bake / Stretch-preload source for it. Placed just
// ABOVE the 16-instance control region (top = base + 15*80 + 79 = 32525567), in
// the SAME NSEEL block 496 (32524288>>16 == 32525567>>16 == 32526783>>16), so the
// existing block-496 allocation covers it. Strided per registry slot exactly like
// the control bands: gmem[SRCGEN_BASE + slot*STRETCH_CONTROL_INSTANCE_STRIDE + pad].
STRETCH_PER_PAD_SRCGEN_BASE     = 32525568;
// (The Extension DOES read the SRCGEN band since 220b1ce: its Stretch preload is keyed by the value, compared
// with != and cast to uint32 -- so what is published there stays below 2^31. The paragraph above predates that.)

// ─── The pitch SPOT handshake (Plan_Swing_Pad_Banks_Tuned §5A.5; step 3, 2026-10-05) ───────────────────────────
// A spot is one of the Extension's sixteen rows per instance (its control cells, its ring, its voice, its bake
// keys). Step 3 keeps every spot on bank A pad s -- identity -- and builds the wire step 4 lends them on. MIRROR
// of rk_lua_core.lua (the names are the same on both sides: gmem_name_parity.py).
//   SPOT MAP, Swing -> bridge, slot*SPOT_MAP_STRIDE, per spot s at +s*4: +0 OWNER = the absolute pad + 1 (0 =
//     free), +1 STATE (0 free, 1 pending, 2 live, 3 draining; a draining spot writes 3 + 4 x its drain token,
//     step 4), +2 GEN = the owner's source generation (the @init epoch + sp_src_gen), written LAST; +63 MAP_VER =
//     1 (an older Swing leaves 0: the bridge then treats every spot as identity and watches the SRCGEN band as
//     before). +3 is never used: spot 15's +3 is +63. Written only in @block (swing_spot_tick).
//   SPOT ANSWER, bridge -> Swing, slot*SPOT_ANS_STRIDE: +0..15 per spot the GEN the bridge has prepared (the old
//     keys blanked, its queued reverts dropped, the owner's layer-0 source published -- a fence if Tuned);
//     +16 HB = the bridge's tick counter, +17 ANS_VER (1 = step 3, 2 = also answers drains: only a 2 is lent to);
//     +32..47 per spot the token of the drain the bridge has finished (step 4).
// Why: the Extension keeps a Stretch spot's old sound loaded until a new preparation lands, keys that
// preparation by the SRCGEN VALUE (not the path) and tells nobody when it lands (§5A.1, §5A.3). If it sees a
// new value while the OLD path is still published it prepares the old sound under the new value and stays on it
// for good. So (a) ORDER: a spot's new SRCGEN goes out only after the bridge's answer says the old path is gone
// and the new source is published; (b) HOLD: from the source change until SP_HOLD_TICKS Extension heartbeats after
// that answer, the owner's Stretch hits play the plain way (the local fallback voice, v_stfb) and its ring is
// choked, so no hit can reach the old sound. Bank A today has both holes on a re-drop and a project switch.
// The GATE: the bridge's heartbeat must MOVE (wiki 5.8) and ANS_VER must read 1; otherwise (no bridge, an older
// bridge) Swing publishes at once as before and holds nothing -- a hold nobody can end is worse than the race.
SPOT_MAP_BASE       = 32526784;
SPOT_MAP_STRIDE     = 64;
SPOT_MAP_OFF_VER    = 63;
SPOT_ANS_BASE       = 32527808;
SPOT_ANS_STRIDE     = 64;
SPOT_ANS_OFF_HB     = 16;
SPOT_ANS_OFF_VER    = 17;
SPOT_ANS_OFF_STATE  = 32;
SPOT_STATE_FREE     = 0;
SPOT_STATE_PENDING  = 1;
SPOT_STATE_LIVE     = 2;
SPOT_STATE_DRAINING = 3;
// ⚠ EEL2 names are CASE-INSENSITIVE: this was SP_HOLD_HB, the same variable as the sp_hold_hb array pointer of
// Swing_ReaKit.jsfx, so the hold's end came out as cur_hb + an address and the hold never ended (the first run,
// 2026-10-06). A constant must never share its letters with a variable.
SP_HOLD_TICKS       = 4;      // the hold ends this many Extension heartbeats after the answer (§5A.3: a margin)
SP_EPOCH_UNIT       = 65536;  // the epoch is a multiple of this; sp_src_gen rides below it

// Step 3b — per-pad audio ring buffer (SPSC). Extension audio_hook writes
// stereo interleaved samples; JSFX @sample reads them and routes to the
// pad's output. Layout (per pad, stride 32768 slots = 16382 stereo frames):
//   ring_base + STRETCH_OFF_WRITE_POS  Extension writes (frame index)
//   ring_base + STRETCH_OFF_READ_POS   JSFX writes      (frame index)
//   ring_base + STRETCH_OFF_CAPACITY   constant = STRETCH_PAD_DATA_FRAMES
//   ring_base + STRETCH_OFF_RESERVED   reserved
//   ring_base + STRETCH_HEADER_SLOTS+frame*2..+1  L,R interleaved
STRETCH_AUDIO_BASE              = 16777216;   // B1c: 256 × 65536, block-aligned
STRETCH_PAD_STRIDE              = 32768;
STRETCH_INST_AUDIO_STRIDE       = 524288;     // B1c: 16 pads × 32768 = one instance block
STRETCH_HEADER_SLOTS            = 4;
STRETCH_PAD_DATA_FRAMES         = 16382;
STRETCH_OFF_WRITE_POS           = 0;
STRETCH_OFF_READ_POS            = 1;

SP_PITCH_PROTOCOL_VER_VALUE = 4;      // v4 = B1 per-slot-strided control bands
SP_PITCH_REQ_PAD_IDLE       = -1;     // sentinel for "no pending request"

// Mode enum
SP_PITCH_MODE_REPITCH       = 0;
SP_PITCH_MODE_TUNED         = 1;
SP_PITCH_MODE_STRETCH       = 2;

// CMD 65 / 67 bake-or-revert mark (2026-10-02, Plan_Swing_Pad_Banks_Tuned §5A.4b), carried in the FRACTION of the
// pad index the Kit Bridge writes to KIT_GMEM_PARAM1: pad + 0.25 = a bake, pad + 0.5 = the leave-Tuned revert. A
// whole pad = unmarked (an older bridge): the pad's mode when the command lands decides, as before. An older Swing
// reads the pad with | 0 and never sees the mark, and nothing is left behind in another cell. The first build
// stamped KIT_GMEM_NAME + 0, which the bridge reads as the kit's name outside any import (the folder label, save in
// place, the kit-undo backfill): the swap's clear cut the name's first letter (caught before release, 2026-10-05).
SP_MARK_BAKE                = 1;      // a bake: swapped in only while the pad is still Tuned
SP_MARK_REVERT              = 2;      // the leave-Tuned revert: the ORIGINAL, unbaked whatever the mode

// The mark in a CMD 65 / 67 pad value (above): its fraction, to the nearest quarter.
function swing_pitch_mark(_pm_v)
local(_pm_f)
(
  _pm_f = _pm_v - (_pm_v | 0);
  _pm_f > 0.375 && _pm_f < 0.625 ? SP_MARK_REVERT : (_pm_f > 0.125 && _pm_f < 0.375 ? SP_MARK_BAKE : 0);
);

// ─── The spot map's one decision (§4.5: "which spot a pad uses is decided in ONE function") ──────────────────
// pr_pad[row] = the absolute pad a spot serves (-1 free), sp_row[pad] = the spot a pad holds (-1 none); both
// host-owned freemem arrays, derived, never serialized (allocated and seeded in Swing_ReaKit.jsfx @init). Step 3:
// identity -- spot s is bank A pad s, every B..D pad has no spot and plays Repitch (4a.1), exactly today's layout.
// The command bus (CMD 65 / 66 / 67) carries the SPOT in PARAM1, as the bridge always did; these map it to the pad.
function swing_spot_pad(_ssp_row)
(
  (_ssp_row >= 0 && _ssp_row < NUM_PADS) ? pr_pad[_ssp_row] : -1;
);

// swing_spot_gen (the owner's generation as the map publishes it) and swing_pitch_held (the Stretch hold) live
// in rk_swing_core.jsfx-inc beside swing_pitch_eff: the voice launcher compiles before this file.

// Algo enum (Distinct-4 mapping, 2026-06-03 — Pro has no Monophonic submode
// at runtime, so Drum uses Soloist and Tonal uses Pro+Preserve-Formants;
// resolved at runtime in elastique_mode_table.cpp, never hardcoded)
SP_PITCH_ALGO_DRUM          = 0;      // Elastique Soloist + Monophonic
SP_PITCH_ALGO_TONAL         = 1;      // Elastique Pro     + Preserve Formants
SP_PITCH_ALGO_TEXTURE       = 2;      // Elastique Pro     + Normal
SP_PITCH_ALGO_VOICE         = 3;      // Elastique Soloist + Speech

// ─── Protocol-version handshake (JSFX-owned write) ──────────────────────
// JSFX writes SP_PITCH_PROTOCOL_VER every tick (idempotent — see
// swing_block_pitch_tick). The Extension only READS this slot. v3 dropped
// the first-tick latch because @init named-pool writes can be unreliable.

// ─── Heartbeat / Extension-alive watchdog ────────────────────────────────
// The Extension writes SP_PITCH_HEARTBEAT every tick. If it hasn't advanced
// within sp_pitch_ext_grace_blocks audio blocks, we declare the Extension
// absent and force-fall-back every pad's effective mode to Repitch (0)
// wherever it's consumed. Keeps Tuned and Stretch modes non-load-bearing.
sp_pitch_ext_last_hb       = 0;
sp_pitch_ext_last_seen_blk = 0;
sp_pitch_ext_alive         = 0;
sp_pitch_block_counter     = 0;
sp_pitch_ext_grace_blocks  = 64;       // ~1.4 s @ 48 kHz / 1024-frame blocks (kept for readers; the watchdog is wall time)
SP_PITCH_GRACE_S           = 1.5;      // the watchdog's grace in wall time (2026-10-06; a render outruns a block count)
sp_pitch_ext_last_seen_t   = time_precise();   // starts alive, as the block version did, for the first grace
// Set per block beside sp_pitch_any_stretch: 1 when any pad is in Tuned or
// Stretch, i.e. when the Extension's absence is actually AUDIBLE. Read by the
// LCD mode stepper and the warning banner. Declared here so it is defined on
// the very first @gfx frame, which can run before @block has.
sp_pitch_any_ext_mode      = 0;

// ─── Step 3b/4: Force NSEEL block allocation for the high-slot bands ─────
// REAPER's named-gmem manager (NSEEL) lazily allocates 65536-slot blocks
// only when a slot in the block is WRITTEN. Reads of unallocated blocks
// return 0 and writes from the Extension's audio_hook silently no-op.
//
// B1c re-base: the Stretch audio band now lives at 16_777_216..25_165_823
// (blocks 256..383, 16 instances × 524288 slots each). The control band
// stays at 32_524_288 (block 496). Without proactive allocation, the
// Extension's audio_hook writes to the per-pad ring drop on the floor →
// JSFX @sample reads silence even with élastique rendering correctly.
//
// Fix: write a 0 to one slot per block. Each write forces NSEEL to allocate
// the block; subsequent reads/writes from either side see live memory.
//
// The ring blocks (8 per instance) can't be allocated here because this
// instance's registry slot isn't claimed until @block — so ring allocation
// is LAZY: swing_stretch_alloc_ring(_slot) runs in @block once _reg_my_slot
// settles (latched by sp_ring_alloc_slot). @init only touches the control
// band block, which is shared and slot-independent.
sp_ring_alloc_slot = -1;               // latch: which slot's rings are allocated
gmem[STRETCH_PER_PAD_MODE_BASE] = 0;   // block 496 (control band)

// ─── B1c lazy ring allocation (per registry slot) ───────────────────────
// Forces NSEEL to allocate this instance's 8 ring blocks at
// STRETCH_AUDIO_BASE + _slot*STRETCH_INST_AUDIO_STRIDE. Called from @block
// once _reg_my_slot settles, latched by sp_ring_alloc_slot so it runs once
// per slot value (re-runs if the instance re-claims a different slot after a
// collision). Pure zeros — allocation only, no protocol effect.
function swing_stretch_alloc_ring(_slot)
local(_ar_base _ar_i)
(
  _slot >= 0 ? (
    _ar_base = STRETCH_AUDIO_BASE + _slot * STRETCH_INST_AUDIO_STRIDE;
    _ar_i = 0;
    loop(8,
      gmem[_ar_base + _ar_i * 65536] = 0;
      _ar_i += 1;
    );
  );
);

// EEL2 loop()/while() silently stop at 2^20 = 1,048,576 iterations (wiki 01
// §1.7): a loop that reaches the cap just ends, no error. Cell copies whose
// count can reach SLOT_SIZE (4,000,000) run in pieces of at most this many
// cells — half the cap.
SP_SWAP_CHUNK = 524288;

// ─── CMD 65 — single-pad audio swap (Tuned-mode bake injection) ─────────
// The Lua bridge's poll_pitch_bake_results fires this CMD after writing
// a freshly baked WAV's audio to gmem (via load_audio_to_pad). Unlike the
// full kit-import state machine (states 1→2→3→4→0 — triggered by CMD 3 +
// GS_KIT_LOAD_REQ=2), this just copies ONE pad's audio from gmem into
// JSFX freemem. No clear_pad, no per-pad meta touch, no kit_busy gate —
// the pad's mode/algo/tune/gain/etc. all stay exactly as the user has
// them. Only s_len + the audio buffer change.
//
// Wire protocol:
//   gmem[KIT_GMEM_PARAM1] = pad_idx     (0..15), + 0.25 a bake / + 0.5 a revert (2026-10-02; whole = unmarked,
//                                       an older bridge)
//   gmem[KIT_GMEM_CMD]    = 65
// JSFX reads PARAM1, computes audio_off by summing prior pads' AUDIOLEN
// (mirrors the bridge's pack-by-prior-lengths layout in load_audio_to_pad),
// copies gmem[AUDIO_BASE + audio_off ..] into the pad's audio (p_aptr[pad]),
// updates s_len, clears CMD.
//
// Length safety: AUDIOLEN written by the bridge during the load is taken
// as truth (matches the actual gmem-written sample count). For Tuned-mode
// bakes the length equals the source length (Signalsmith preserves
// duration at rate_ratio=1.0), so audio_off for other pads doesn't shift.
function swing_pad_audio_swap()
local(_sp_pad, _sp_len, _sp_src_off, _sp_p, _sp_dst, _sp_j, _sp_n, _sp_ok, _sp_mk, _sp_pf)
(
  _bl_inflight = 1;   // double-dispatch latch (2026-07-27; see rk_swing_browser_load)
  _sp_pf  = gmem[KIT_GMEM_PARAM1];
  _sp_pad = swing_spot_pad(_sp_pf | 0);   // the bus carries the SPOT; its owner pad (identity in step 3; -1 = a free spot: ignored)
  _sp_mk  = swing_pitch_mark(_sp_pf);   // the bridge's bake-or-revert mark (SP_MARK_*), in the pad's fraction
  // A marked BAKE for a pad that is no longer Tuned was sent before a flip it crossed in flight: refused, the
  // buffer stays (unmarked, it landed as "the original, unbaked" and could end a drain early -- §5A.4b).
  _sp_pad >= 0 && _sp_pad < NUM_SLOTS && !(_sp_mk == SP_MARK_BAKE && sp_pitch_mode[_sp_pad] != SP_PITCH_MODE_TUNED) ? (
    // Length via PARAM3 + payload at AUDIO+0 — the CMD-67 protocol (fix
    // 2026-07-16). The old scheme read length AND offset from the AUDIOLEN
    // band, which the browser mirror blast-rewrites every @block with
    // has-audio FLAGS (1/0 for layered pads) — bridge and JSFX resolved
    // different offsets and this swap injected staged path strings / zeros
    // into pad buffers (white-stripe / blank waveforms after kit loads).
    _sp_len = gmem[KIT_GMEM_NAMELEN] | 0;
    _sp_len > 0 && _sp_len <= SLOT_SIZE ? (
      // Arm anti-click crossfade BEFORE killing voices. Mirrors the CMD 63
      // single-pad-load pattern: if the last block had audible output on
      // this instance's bus, we want a short ramp from the previous output
      // tail to silence rather than a hard step. -40 dB threshold matches
      // CMD 63's heuristic — below that the noise floor masks the cut.
      !_xf_active && abs(_xf_prev[0]) + abs(_xf_prev[1]) > 0.01 ? (
        _xf_pos    = 0;
        _xf_len    = swing_xf_len(0.010);  // 10 ms crossfade (+ a block under Wired, A-5)
        _xf_active = 1;
      );
      // Payload staged at AUDIO+0 (single transient staging, one swap per
      // bridge tick — same as CMD 67).
      // Chunked: _sp_len runs up to SLOT_SIZE = 4,000,000 and a single
      // loop(_sp_len) stopped at the 2^20 cap — the first 1,048,576 cells
      // arrived, s_len below still claimed the full length, and the tail kept
      // the old pre-bake audio (fix 2026-09-08). Outer while over pieces of at
      // most SP_SWAP_CHUNK cells (at most 8 passes), inner loop per piece. The
      // staging protocol (payload at AUDIO+0, length via NAMELEN) is unchanged.
      // Step 2a: the baked buffer replaces LAYER 0's region on a layered pad (p_aptr is dead
      // after a promotion's transfer; a layer holds LAYER_SIZE at most) or the plain region
      // -- in place when the region holds it (bakes preserve duration), else a new one.
      // Refused = the pad keeps its unbaked audio and the LCD says why. No undo capture: a
      // bake is not a structural op, and the one-shot displaced list is freed at once.
      p_layer_cnt[_sp_pad] > 0 ? _sp_len = min(_sp_len, LAYER_SIZE);
      _sp_ok = p_layer_cnt[_sp_pad] > 0 ? swing_pad_fit_layer(_sp_pad, 0, _sp_len, _al_dl_blk)
                                        : swing_pad_fit_main(_sp_pad, _sp_len, _al_dl_blk);
      swing_disp_free(_al_dl_blk);
      _sp_ok ? (
      _sp_dst = p_layer_cnt[_sp_pad] > 0 ? p_lptr[_sp_pad * MAX_LAYERS] : p_aptr[_sp_pad];
      _sp_j = 0;
      while(_sp_j < _sp_len) (
        _sp_n = min(_sp_len - _sp_j, SP_SWAP_CHUNK);
        loop(_sp_n,
          _sp_dst[_sp_j] = gmem[KIT_GMEM_AUDIO + _sp_j];
          _sp_j += 1;
        );
      );
      s_len[_sp_pad] = _sp_len;
      // Post-v201 kits deliver every pad as LAYERED (layer_cnt 1) — playback
      // reads l_len[0], not s_len. The swap writes the layer-0 region, so
      // keep l_len[0] in step (bakes are duration-preserving, but don't
      // assume): stale l_len vs new buffer misreads the tail.
      p_layer_cnt[_sp_pad] > 0 ? (
        l_len[_sp_pad * MAX_LAYERS] = min(_sp_len, LAYER_SIZE);
      );
      // The arriving buffer is baked at the current tune → the voice residual
      // (p_tune - sp_baked_tune) returns to 0, so it plays duration-preserved.
      // Until the next knob move it stays here; a move then shows up instantly
      // as a varispeed residual (see the Tuned branch in launch_voices_for_pad).
      // CMD 65 only ever delivers the pad MAIN buffer (= layer 0 region), so it
      // anchors layer 0; layers 1+ are anchored by CMD 67 (per-layer swap).
      // A swap onto a pad NOT in Tuned is the leave-Tuned revert putting the ORIGINAL back (the
      // bridge delivers bakes only while the pad is Tuned): its anchor is 0, unbaked. Anchoring it
      // at p_tune (until 2026-10-01) marked the original as baked: CMD 66 then refused a layered
      // pad's capture, and a return to Tuned played the original at residual 0, unpitched, until a
      // bake landed (the step A self-audit; EON_Probe_PitchA RT / LL). A MARKED revert is the
      // original whatever the mode (2026-10-02): a pad back in Tuned before its revert landed used
      // to get the original marked as baked, unpitched until something re-baked it (§5A.4).
      sp_baked_tune[_sp_pad * MAX_LAYERS + 0] = _sp_mk == SP_MARK_REVERT ? 0 : (sp_pitch_mode[_sp_pad] == SP_PITCH_MODE_TUNED ? p_tune[_sp_pad] : 0);
      // Kill active voices reading the buffer we just changed — but ONLY layer-0
      // voices. CMD 65 overwrites only the layer-0 region (offset 0); voices on
      // layers 1+ read their own untouched sub-buffers, so killing them here just
      // chops the pattern needlessly during the per-layer bake catch-up (CMD 67
      // kills each higher layer's voices when ITS buffer swaps). Non-layered pads
      // have all voices at v_layer 0, so this still kills them all. The crossfade
      // armed above masks the cut.
      _sp_j = 0;
      loop(V_SLOTS,
        (v_slot[_sp_j] == _sp_pad && v_layer[_sp_j] == 0) ? ( v_pos[_sp_j] = -1; v_env[_sp_j] = 0; v_stage[_sp_j] = 0; );
        _sp_j += 1;
      );
      ) : swing_alloc_refuse_note(_sp_pad);
    );
  );
  gmem[KIT_GMEM_CMD] = 0;   // consume — bridge gates next send on CMD==0
  _bl_inflight = 0;
);

// ─── CMD 66 — single-pad audio EXPORT (auto-source for source-less Stretch) ──
// The REVERSE of swing_pad_audio_swap. The Lua bridge fires this when a live
// Stretch-mode pad has NO retained source on the bridge side — audio that
// arrived via @serialize restore (preset/shortcut insert) or an FX duplicate,
// never a kit-load. Stretch streams realtime from an Extension-side preload of
// the source WAV; with no source path the StretchPreloadWorker has nothing to
// load and the pad is silent (Tuned, by contrast, just plays the original
// buffer — see Swing_Kit_Bridge.lua). We copy this pad's ORIGINAL local buffer
// (Stretch never overwrites s_audio_start — its output returns via the
// STRETCH_AUDIO ring) out to the shared AUDIO staging band at offset 0, and
// report the interleaved length + source SR in the polymorphic header slots
// KIT_GMEM_NPADS / KIT_GMEM_NAMELEN. These are ROUTED return slots, used
// deliberately instead of the KIT_GMEM_AUDIOLEN band: that band is blast-
// written ungated every @block by EVERY instance, so a sibling with audio on
// the same pad index would clobber the length before the bridge reads it.
//
// A Tuned pad is exported too (the bridge's poll_autoexport captures Tuned and
// Stretch pads, poll_layer_export the layers of Tuned ones), but never a BAKED
// buffer: after a bake it holds the already-pitched audio, and re-publishing
// that as a "source" makes the Extension bake pitch on top of pitch. Every
// branch below refuses a region whose anchor (sp_baked_tune) is not 0.
//
// Wire protocol:
//   gmem[KIT_GMEM_PARAM1]        = pad_idx   (0..15)
//   gmem[GS_PENDING_PITCH_INST]  = slot      (route — only that instance acts)
//   gmem[KIT_GMEM_CMD]           = 66
// JSFX returns:
//   gmem[KIT_GMEM_NPADS]   = interleaved sample count exported (0 = nothing)
//   gmem[KIT_GMEM_NAMELEN] = source sample rate (s_sr, else project srate)
//   gmem[KIT_GMEM_AUDIO + 0..len-1] = the pad's stereo-interleaved samples
// then clears CMD. The bridge reads NPADS/NAMELEN + the band on the next tick
// (it owns the CMD channel until then), writes a temp WAV, and publishes it.
// PARAM1 encodes BOTH pad and layer as combined = layer*NUM_PADS + pad:
//   _ep_pad   = combined % NUM_PADS    (0..15)
//   _ep_layer = (combined / NUM_PADS)  (0..MAX_LAYERS-1)
// Layer 0 → combined == pad, so the legacy Stretch auto-export (writes PARAM1
// = pad) is byte-compatible. Layer 0 exports a plain pad's plain region (s_len)
// and a layered pad's layer-0 region (l_len, p_lptr -- never p_aptr, which is -1
// on a layered pad), each only while unbaked (the plain one since 2026-10-02).
// Layer L>0 exports that layer's sub-buffer (l_len) — but ONLY while
// the layer is still ORIGINAL (sp_baked_tune anchor == 0). Once a layer has
// been baked its buffer holds pitched audio, which must NEVER be re-exported as
// a source (the Extension would bake pitch-on-pitch). The per-layer source
// auto-capture (Swing_Kit_Bridge poll_layer_export) reads this during the
// bake-settle window, before any layer bake lands, so it always sees original.
function swing_pad_audio_export()
local(_ep_comb _ep_pad _ep_layer _ep_lidx _ep_len _ep_src _ep_sr _ep_j _ep_ok _ep_n)
(
  _bl_inflight = 1;   // double-dispatch latch (2026-07-27; see rk_swing_browser_load)
  _ep_comb  = gmem[KIT_GMEM_PARAM1] | 0;
  _ep_pad   = swing_spot_pad(_ep_comb % NUM_PADS);   // the bus carries the SPOT (+ layer * NUM_PADS); its owner pad
  _ep_layer = (_ep_comb / NUM_PADS) | 0;
  _ep_len = 0;
  _ep_sr  = srate;
  _ep_ok  = _ep_pad >= 0 && _ep_pad < NUM_SLOTS && _ep_layer >= 0 && _ep_layer < MAX_LAYERS;
  _ep_ok ? (
    _ep_layer == 0 ? (
      p_layer_cnt[_ep_pad] > 0 ? (
        // A LAYERED pad's layer 0 lives in its own region, p_lptr. Since the step 2a allocator
        // (2026-09-23) a layered pad's plain pointer is -1 (a promotion moves the region to
        // layer 0, a layer-0 fit takes it over), so the old read of p_aptr here -- written when
        // layer 0 shared the plain slot's address -- copied Swing's own memory from address -1
        // (it starts with p_gain) and the Extension baked THAT (EON_Probe_PitchA, 2026-09-25).
        // s_len is no guide on a layered pad either: CMD 65 writes it there too. Same
        // already-baked refusal as layers 1+: a baked buffer holds pitched audio.
        _ep_lidx = _ep_pad * MAX_LAYERS;
        sp_baked_tune[_ep_lidx] == 0 ? (
          _ep_len = l_len[_ep_lidx] | 0;
          _ep_src = p_lptr[_ep_lidx];
          l_sr[_ep_lidx] > 0 ? _ep_sr = l_sr[_ep_lidx];
        );
        _ep_len > 0 && _ep_len <= LAYER_SIZE ? 0 : ( _ep_len = 0; );
      ) : (
        // A plain pad: its plain region, under the same already-baked refusal (2026-10-02). poll_autoexport
        // captures Tuned pads as well as Stretch ones, and a plain Tuned pad that holds its bake -- restored from
        // an embedded save, or a bridge restarted with no source -- exported the BAKE as its source: the
        // Extension baked pitch on pitch and delivered it (Plan_Swing_Pad_Banks_Tuned §5A.7; EON_Probe_PitchA FX).
        sp_baked_tune[_ep_pad * MAX_LAYERS] == 0 ? (
          _ep_len = s_len[_ep_pad] | 0;
          _ep_src = p_aptr[_ep_pad];
          s_sr[_ep_pad] > 0 ? _ep_sr = s_sr[_ep_pad];
        );
        _ep_len > 0 && _ep_len <= SLOT_SIZE ? 0 : ( _ep_len = 0; );
      );
    ) : (
      // Layer L>0: capture the ORIGINAL layer buffer for the per-layer Tuned
      // bake. Refuse if the layer has already been baked (anchor != 0) so we
      // never publish pitched audio as a source.
      _ep_lidx = _ep_pad * MAX_LAYERS + _ep_layer;
      sp_baked_tune[_ep_lidx] == 0 ? (
        _ep_len = l_len[_ep_lidx] | 0;
        _ep_src = p_lptr[_ep_pad * MAX_LAYERS + _ep_layer];
        l_sr[_ep_lidx] > 0 ? _ep_sr = l_sr[_ep_lidx];
        _ep_len > 0 && _ep_len <= LAYER_SIZE ? 0 : ( _ep_len = 0; );
      );
    );
    _ep_len > 0 ? (
      // Chunked (fix 2026-09-08, same 2^20 cap as CMD 65 above): layer 0
      // exports s_len, which runs up to SLOT_SIZE = 4,000,000, and a single
      // loop(_ep_len) stopped at 1,048,576 cells while NPADS below reported
      // the full length — the bridge's source WAV carried a stale tail. Outer
      // while over pieces of at most SP_SWAP_CHUNK cells, inner loop per
      // piece; the return slots and the staging band are unchanged.
      _ep_j = 0;
      while(_ep_j < _ep_len) (
        _ep_n = min(_ep_len - _ep_j, SP_SWAP_CHUNK);
        loop(_ep_n,
          gmem[KIT_GMEM_AUDIO + _ep_j] = _ep_src[_ep_j];
          _ep_j += 1;
        );
      );
    );
  );
  gmem[KIT_GMEM_NPADS]   = _ep_len;
  gmem[KIT_GMEM_NAMELEN] = _ep_sr;
  gmem[KIT_GMEM_CMD] = 0;   // consume — bridge gates next send on CMD==0
  _bl_inflight = 0;
);

// ─── CMD 67 — single (pad,layer) audio swap (per-layer Tuned bake injection) ──
// The per-layer sibling of CMD 65 (swing_pad_audio_swap). Velocity-layered pads
// (Sum / VelSplit / RR) sound layers 1+ as well as layer 0, so each non-empty
// layer is baked to pitch independently. CMD 65 still delivers layer 0 (the pad
// main buffer); this delivers layers 1..MAX_LAYERS-1 into their sub-buffers.
//
// Wire protocol (the bridge stages the baked layer audio at KIT_GMEM_AUDIO+0 —
// a single transient staging, one swap per bridge tick — and passes):
//   gmem[KIT_GMEM_PARAM1]        = pad_idx   (0..15), + 0.25 a bake / + 0.5 a revert (2026-10-02, as CMD 65)
//   gmem[KIT_GMEM_NPADS]         = layer_idx (1..MAX_LAYERS-1)   (slot 2 reused)
//   gmem[KIT_GMEM_NAMELEN]       = interleaved sample count       (slot 3 reused)
//   gmem[GS_PENDING_PITCH_INST]  = slot      (route — only that instance acts)
//   gmem[KIT_GMEM_CMD]           = 67
// Copies AUDIO+0..len-1 into the layer sub-buffer, sets l_len + the per-layer
// baked-tune anchor (residual -> 0 for that layer), kills the pad's voices on
// THIS layer (masked by the same anti-click crossfade as CMD 65), clears CMD.
function swing_pad_layer_audio_swap()
local(_lp_pad _lp_layer _lp_len _lp_lidx _lp_dst _lp_j _lp_ok _lp_plain _lp_n _lp_mk _lp_pf)
(
  _bl_inflight = 1;   // double-dispatch latch (2026-07-27; see rk_swing_browser_load)
  _lp_pf    = gmem[KIT_GMEM_PARAM1];
  _lp_pad   = swing_spot_pad(_lp_pf | 0);   // the bus carries the SPOT; its owner pad (as CMD 65)
  _lp_layer = gmem[KIT_GMEM_NPADS]  | 0;
  _lp_len   = gmem[KIT_GMEM_NAMELEN]| 0;
  _lp_mk    = swing_pitch_mark(_lp_pf);   // the bridge's bake-or-revert mark, in the pad's fraction (as CMD 65)
  (_lp_pad >= 0 && _lp_pad < NUM_SLOTS &&
   _lp_layer >= 0 && _lp_layer < MAX_LAYERS &&
   _lp_len > 0 && _lp_len <= LAYER_SIZE &&
   !(_lp_mk == SP_MARK_BAKE && sp_pitch_mode[_lp_pad] != SP_PITCH_MODE_TUNED)) ? (   // a stale bake: refused (CMD 65)
    // Arm anti-click crossfade BEFORE killing voices (mirrors CMD 65/63).
    !_xf_active && abs(_xf_prev[0]) + abs(_xf_prev[1]) > 0.01 ? (
      _xf_pos    = 0;
      _xf_len    = swing_xf_len(0.010);  // 10 ms crossfade (+ a block under Wired, A-5)
      _xf_active = 1;
    );
    _lp_lidx = _lp_pad * MAX_LAYERS + _lp_layer;
    // Step 2a: the layer's region, in place when it holds the length, else a new one. Layer 0
    // of a PLAIN pad is the plain region (the pad stays plain: p_layer_cnt is not touched here).
    _lp_plain = (p_layer_cnt[_lp_pad] == 0 && _lp_layer == 0);
    _lp_ok = _lp_plain ? swing_pad_fit_main(_lp_pad, _lp_len, _al_dl_blk)
                       : swing_pad_fit_layer(_lp_pad, _lp_layer, _lp_len, _al_dl_blk);
    swing_disp_free(_al_dl_blk);
    _lp_ok ? (
    _lp_dst  = _lp_plain ? p_aptr[_lp_pad] : p_lptr[_lp_pad * MAX_LAYERS + _lp_layer];
    // Chunked (2026-09-23, longer layers): _lp_len now runs to LAYER_SIZE = SLOT_SIZE = 4,000,000,
    // past EEL2's 2^20 iteration cap -- the outer-while / inner-loop shape of CMD 65 and 66 above.
    _lp_j = 0;
    while(_lp_j < _lp_len) (
      _lp_n = min(_lp_len - _lp_j, SP_SWAP_CHUNK);
      loop(_lp_n,
        _lp_dst[_lp_j] = gmem[KIT_GMEM_AUDIO + _lp_j];
        _lp_j += 1;
      );
    );
    l_len[_lp_lidx]        = _lp_len;
    // Not in Tuned = the per-layer revert's ORIGINAL: unbaked, as in CMD 65 above (2026-10-01); a marked
    // revert is unbaked in any mode (2026-10-02).
    sp_baked_tune[_lp_lidx] = _lp_mk == SP_MARK_REVERT ? 0 : (sp_pitch_mode[_lp_pad] == SP_PITCH_MODE_TUNED ? p_tune[_lp_pad] : 0);
    // NOTE: do NOT set s_dirty here. Matching CMD 65 (the layer-0/single-layer
    // swap), a Tuned bake must NOT rebuild the waveform cache — the displayed
    // waveform stays the pre-bake (original) sample shape (the tune is a knob,
    // not a re-sample). Forcing a rebuild re-rendered the pad against the baked
    // buffer and visibly shifted the waveform (cosmetic only; audio was correct).
    // The cache still rebuilds on a real sample/layer (re)load via s_dirty there.
    // Kill active voices on this pad+layer — their buffer changed underneath.
    _lp_j = 0;
    loop(V_SLOTS,
      (v_slot[_lp_j] == _lp_pad && v_layer[_lp_j] == _lp_layer) ? (
        v_pos[_lp_j] = -1; v_env[_lp_j] = 0; v_stage[_lp_j] = 0;
      );
      _lp_j += 1;
    );
    ) : swing_alloc_refuse_note(_lp_pad);
  );
  gmem[KIT_GMEM_CMD] = 0;   // consume — bridge gates next send on CMD==0
  _bl_inflight = 0;
);

// NOTE: the former standalone `swing_publish_tune_mirror()` (Refined Option
// B) is gone — its idempotent all-pad blast is now folded into
// swing_block_pitch_tick() below, alongside the MODE and ALGO bands, so a
// single publisher declares the full per-pad state in one place.

// ─── Declarative state publisher (stateless "anchor" protocol v3) ─────────
// Called from @init, @slider, @block, and @gfx (options:gfx_idle), gated to
// the LOCK-owning instance. This function does NOT diff, queue, or keep any
// shadow. Every call it idempotently blast-writes the current desired
// per-pad state (MODE / TUNE / ALGO) for all 16 pads into the named-segment
// bands, and republishes the protocol version. The Extension's 30 Hz
// reconcile (SwingPitchHost::reconcile_tuned_pads) owns ALL diff state and
// decides when to bake. No JSFX shadows, no single-pad request channel, no
// callback-timing dependence — Tuned is correct on cold start / reopen by
// construction, because the desired state is always present in gmem for the
// reconciler to act on whenever it runs.
//
// Requires from caller (main jsfx) at @init:
//   * NUM_PADS       — pad count (16)
//   * sp_pitch_mode[]/sp_pitch_algo[]/p_tune[] — current per-pad state
// (No registry-slot dependency — publishes unconditionally; see the blast
//  block below for why the old _reg_my_slot==0 gate was removed.)

// ─── Registry slot claim (single-pass) ───────────────────────────────────
// Shared by the main jsfx @init (first claim) and @block (re-claim after a
// collision vacate). Writes our instance_id + heartbeat in the SAME scan
// iteration as the slot pick — so a peer instance sees the slot taken on its
// next gmem read, not after a deferred @block write. Previously @init only
// set _reg_my_slot and the id/heartbeat were written later in @block — a
// wide TOCTOU window that let 2+ instances opening together (project-open)
// claim the SAME slot, sharing one strided band region → the multi-instance
// Tuned bake thrash (algo/PDC flicker + inst_N source cross-wiring).
// 2026-06-04.
//
// Not atomic, and it cannot be: JSFX has no lock shared between instances.
// ⛔ EEL2's atomic_* functions do NOT help -- their mutex is PER INSTANCE
// (effectProcessor::m_atomic_mutex in WDL eel_atomic.h), so they guard @gfx
// against @block inside one Swing and never exclude a peer. @init claims do not
// interleave (REAPER runs @init on the main thread, one plugin at a time), but
// @block RE-claims run on parallel worker threads -- see the two-step claim below.
//
// Globals (resolved at call time; all assigned before this is ever called):
//   instance_id, _reg_my_slot, _reg_try, _reg_try_t, _reg_claim_now,
//   GS_INST_REG_{BASE,STRIDE,MAX,TIMEOUT,SETTLE}.

// Zero a slot's inbound-command mailboxes (IN direction) as an instance takes
// it: a recycled slot may carry stale commands from a previous session/project,
// and a re-adopted own slot may carry commands addressed to the PREVIOUS
// incarnation. Neither must ever be adopted by the new owner.
function swing_registry_zero_incmd(slot)
local(_zj)
(
  _zj = 0;
  loop(INST_INCMD_STRIDE,
    gmem[INST_INCMD_BASE + slot * INST_INCMD_STRIDE + _zj] = 0;
    _zj += 1;
  );
);

// ⭐ OWNERSHIP RE-VALIDATION (2026-09-12; its own function since 2026-09-15, C-3).
// _reg_my_slot is a LATCH. Everything in the claim used to sit behind `< 0` alone, so
// an instance that once held a slot never asked again whether it still does -- and
// the @block heartbeat writer downstream stamps id+time into that latched slot with
// no check of its own. An instance that goes dormant (its @block stops running: a
// background project tab) freezes its heartbeat, its slot ages past
// GS_INST_REG_TIMEOUT, a peer legitimately takes it as stale -- and the moment the
// dormant one runs again it writes ITS id straight over the live incumbent. Both
// then stamp the same slot every block, and _reg_my_slot keys the strided per-
// instance bands (IDENT, PADMIX, INCMD, GS_STRIP, the stretch ring), so the two
// instances silently share all of them. Measured 2026-09-12: an undo-restored
// Swing woke up and knocked a Swing that had never been deleted offline
// (EON_Probe_QueueLifetime_probe).
// ⚠ This also covers the case where @init never ran at all: EEL2 zero-inits, so
// the latch reads 0 -- a VALID-looking slot index that passes every `>= 0` gate
// and points at whoever holds slot 0. Dropping the latch sends it through Pass
// A/B to a genuinely free slot instead.
// The reconciler cannot substitute for this: it scans OTHER slots for OUR id and
// never asks whether our OWN slot still holds it.
// C-3 (audit C, 2026-09-14): the claim asked this first, but the slot-keyed
// publishers at the top of @block (master link, stretch control, patch ring, the
// strip band's publish AND its mailbox consume) ran a whole block ahead of the
// claim, so a woken instance wrote one block into the new owner's bands and
// applied a Drum Strip edit addressed to the new owner to its own pad. Now it
// runs at the very top of @block, before any of them, and first inside the claim.
// It only ever drops the latch; the claim re-acquires as before.
function swing_registry_check_owner()
(
  (_reg_my_slot >= 0 &&
   gmem[GS_INST_REG_BASE + _reg_my_slot * GS_INST_REG_STRIDE] != instance_id) ? (
    _reg_my_slot = -1;   // our slot was reassigned while we were away -- re-claim
  );
);

function swing_registry_claim()
local(_si _base _id _hb _now _pick)
(
  // Ownership re-validation first (swing_registry_check_owner above, with the
  // 2026-09-12 measurement). @block runs it again at its very top since C-3, so a
  // stale latch is dropped before the slot-keyed publishers, not only here.
  swing_registry_check_owner();
  // ⭐ TWO-STEP @block CLAIM (2026-09-13). Several instances re-claiming in the
  // same audio cycle (undo restore, a vacated slot, a mass wipe) can each pick
  // the SAME free slot; the last id written wins. Claimed on the spot, the loser
  // had already published into the winner's bands and zeroed its mailboxes by
  // the time its next block noticed (measured: 320 of 320 claims used the slot
  // before anyone could object). So an @block claim writes its id as an INTENT
  // and takes the slot only if the id is still ours GS_INST_REG_SETTLE later.
  // A competing write lands microseconds after its scan, so a loser always sees
  // it and rescans having touched nothing. @init claims stay immediate
  // (_reg_claim_now = 1): no interleaving there, and @block may not run yet.
  // _reg_try = pending slot + 1, so EEL2 zero-init reads as "nothing pending".
  (_reg_my_slot < 0 && _reg_try > 0) ? (
    _base = GS_INST_REG_BASE + (_reg_try - 1) * GS_INST_REG_STRIDE;
    gmem[_base] != instance_id ? (
      _reg_try = 0;                       // a peer wrote after us: lost, rescan below
    ) : (
      (time_precise() - _reg_try_t) >= GS_INST_REG_SETTLE ? (
        _reg_my_slot = _reg_try - 1;      // survived the settle: ours
        _reg_try = 0;
        gmem[_base + 1] = time_precise();
        swing_registry_zero_incmd(_reg_my_slot);
      );
    );
  );
  (_reg_my_slot < 0 && _reg_try <= 0) ? (
    _now = time_precise();
    _pick = -1;
    // Pass A — re-adopt our own previous slot. A slot already holding OUR
    // instance_id with a zero/stale heartbeat is this instance's previous
    // incarnation (reload/recompile — registry cells persist in gmem).
    // Re-adopting keeps the slot number stable, so slot-keyed consumers
    // (strip band, StepSeq pairing, IDENT band readers) see no band change.
    // A FRESH heartbeat with our id is either a live duplicate or a
    // <TIMEOUT-old ghost — never adopt those here; the @block reconciler's
    // heartbeat-advance test tells them apart and cleans up.
    _si = 0;
    loop(GS_INST_REG_MAX,
      _base = GS_INST_REG_BASE + _si * GS_INST_REG_STRIDE;
      (_pick < 0 && gmem[_base] == instance_id &&
       (gmem[_base + 1] == 0 || (_now - gmem[_base + 1]) > GS_INST_REG_TIMEOUT)) ? (
        _pick = _si;
      );
      _si += 1;
    );
    // Pass B — first free/stale slot (original behavior). A peer's pending
    // intent carries a fresh heartbeat, so it reads as taken.
    _si = 0;
    _pick < 0 ? loop(GS_INST_REG_MAX,
      _base = GS_INST_REG_BASE + _si * GS_INST_REG_STRIDE;
      _id = gmem[_base];
      _hb = gmem[_base + 1];
      (_pick < 0 &&
       (_id == 0 || _hb == 0 || (_now - _hb) > GS_INST_REG_TIMEOUT)) ? (
        _pick = _si;
      );
      _si += 1;
    );
    _pick >= 0 ? (
      _base = GS_INST_REG_BASE + _pick * GS_INST_REG_STRIDE;
      gmem[_base + 0] = instance_id;
      gmem[_base + 1] = _now;
      _reg_claim_now ? (
        _reg_my_slot = _pick;             // @init: register on the spot
        swing_registry_zero_incmd(_pick);
      ) : (
        _reg_try = _pick + 1;             // @block: intent, confirmed after the settle
        _reg_try_t = _now;
      );
    );
  );
);

function swing_block_pitch_tick()
local(_pi _base _pp)
(
  // (Tick-counter diagnostic removed 2026-07-08 — its cell 2274 collided
  // with GS_KIT_PRESERVE_LIVE; see the note at the top of this file.)

  // Protocol version — republished EVERY tick (idempotent), NOT latched at
  // @init. Named-pool writes from @init can be unreliable (the segment may
  // not be attached that early in the instance lifecycle); republishing from
  // every context removes any dependence on an @init write landing. The
  // Extension gates its reconcile on seeing this value: it must equal the
  // C++ side's kExpectedSwingPitchProtocolVersion (swing_pitch_slots.h),
  // currently 4 — bump BOTH ends together or the reconcile stops running.
  atomic_set(gmem[SP_PITCH_PROTOCOL_VER], SP_PITCH_PROTOCOL_VER_VALUE);

  // Heartbeat watchdog — read-only snapshot of the Extension's counter.
  // Measured in WALL TIME since 2026-10-06, not in audio blocks: an offline render runs blocks far faster than the
  // Extension's main-thread timer ticks, so the block count outran the heartbeat and the watchdog declared the
  // Extension dead mid-render -- every Tuned pad after that point rendered its bake at the full varispeed on top
  // (an octave up at half length; EON_Probe_PitchA T4, five pads in one render). The 1.5 s grace is the same.
  // Kept global on purpose (wiki 4.1): this tick runs from @gfx as well as @init / @slider / @block (Swing_ReaKit.jsfx
  // @gfx, "Drive the Tuned-mode pitch chain at GUI rate"), so the watchdog's globals have two writers at once. Every
  // write is the moment's time_precise() or a fresh read of the Extension's rising heartbeat, so a lost race leaves
  // sp_pitch_ext_last_seen_t microseconds old, or counts one heartbeat a tick late -- against a 1.5 s grace
  // (gate_baseline gfx_audio accepts it, FINDINGS_LOG 2026-10-12; sp_pitch_cur_hb / _last_hb / _last_seen_blk alike).
  sp_pitch_block_counter += 1;
  sp_pitch_cur_hb = atomic_get(gmem[SP_PITCH_HEARTBEAT]);
  sp_pitch_cur_hb != sp_pitch_ext_last_hb ? (
    sp_pitch_ext_last_hb       = sp_pitch_cur_hb;
    sp_pitch_ext_last_seen_blk = sp_pitch_block_counter;
    sp_pitch_ext_last_seen_t   = time_precise();
  );
  sp_pitch_ext_alive = (time_precise() - sp_pitch_ext_last_seen_t) < SP_PITCH_GRACE_S;

  // B1 multi-instance publish — each instance writes ONLY its own band region,
  // strided by its registry slot. Because every live instance owns a distinct
  // 80-slot block there is no cross-instance contention, so the old flicker
  // (all instances blasting one singleton) is gone BY CONSTRUCTION and the
  // single-owner election it required is removed. The Extension reconciles all
  // live slots independently (each baking/rendering its own pads).
  //   Skip when we have not claimed a slot yet (_reg_my_slot < 0 — a brief
  // pre-claim / collision-vacate window): a negative base would underflow, and
  // another instance may legitimately own slot 0, so writing there would
  // corrupt its band. The slot is claimed at the END of @init (before the seed
  // publish call) and re-claimed in @block, so the gap is at most ~one tick; the
  // Extension reconcile holds last state across it (no audible effect).
  //   Also held while a pad swap is under way or not yet followed (2026-10-12): swap_pads (@gfx) moves the modes and
  // tunes with the audio at once, the spot map follows only in @block (swing_spot_tick). Published in between, a Tuned
  // pad swapped onto a plain one showed its spot as LEFT Tuned under the old map; the bridge sent the spot's original
  // to the map's owner, and with @block stopped (Swing bypassed) @gfx's CMD 65 fallback wrote it into the old pad: the
  // plain pad's sample gone (EON_Probe_PitchA -Only SW, RED before this). Held, the bands keep the pre-swap state until
  // the map has followed, then change with it. sp_swap_busy: set for the whole of swap_pads.
  _reg_my_slot >= 0 && !atomic_get(sp_swap_busy) && atomic_get(sp_swap_req) == sp_swap_done ? (
    _base = _reg_my_slot * STRETCH_CONTROL_INSTANCE_STRIDE;
    _pi = 0;
    loop(NUM_PADS,   // the spots: the pitch rings and the Extension band are sixteen per instance (spot _pi = pad pr_pad[_pi]; identity in step 3)
      // Idempotent declarative blast — every pad, every tick. Each band slot is
      // a single aligned double (naturally atomic), so atomic_set alone is
      // sufficient; no shadows, no seqlock. The Extension reconciles: it bakes
      // any Tuned pad whose published (TUNE, ALGO) differs from what it last
      // baked for THIS slot, and detects Tuned->non-Tuned via the MODE band.
      // A free spot publishes Repitch. SRCGEN is sp_pub_gen, the generation the handshake has RELEASED for the
      // spot (swing_spot_tick) -- not sp_src_gen itself: the Extension keys its Stretch preload by this value,
      // so it must not change until the bridge says the new source is the one published (§5A.3).
      _pp = pr_pad[_pi];
      atomic_set(gmem[STRETCH_PER_PAD_MODE_BASE        + _base + _pi], _pp >= 0 ? sp_pitch_mode[_pp] : SP_PITCH_MODE_REPITCH);
      atomic_set(gmem[STRETCH_PER_PAD_TUNE_MIRROR_BASE + _base + _pi], _pp >= 0 ? p_tune[_pp] : 0);
      atomic_set(gmem[STRETCH_PER_PAD_ALGO_BASE        + _base + _pi], _pp >= 0 ? sp_pitch_algo[_pp] : 0);
      atomic_set(gmem[STRETCH_PER_PAD_SRCGEN_BASE      + _base + _pi], sp_pub_gen[_pi]);
      _pi += 1;
    );
  );

  // Step 4: PDC target snapshot. The actual pdc_delay assignment lives
  // in the main JSFX @block — REAPER's audit-jsfx rule requires pdc_*
  // writes to appear textually inside an @block section, and this
  // .jsfx-inc file's contents are treated as @init by the validator
  // even though the function is CALLED from @block. So we just publish
  // the target into a global here; the caller applies it.
  //
  // Logic (B1c multi-instance): SP_PITCH_PDC_BUDGET carries the worst-case
  // élastique latency VALUE (samples at project SR), identical for every
  // instance — the Extension writes it whenever ANY live instance uses
  // Stretch. Each instance gates PDC application on ITS OWN local Stretch
  // state so a track with no Stretch pads declares 0 latency even when a
  // sibling instance is stretching. Compute this instance's any-stretch flag
  // from the local mode array (slot-independent — valid even during the brief
  // pre-claim window). When the heartbeat watchdog flips ext_alive to 0 we
  // force the target to 0 so a dead Extension doesn't leave stale latency.
  _pi = 0; sp_pitch_any_stretch = 0; sp_pitch_any_ext_mode = 0;
  loop(NUM_SLOTS,   // every pad (Pad Banks step 4): a Stretch pad declares latency only while it holds a spot (a ring)
    sp_pitch_mode[_pi] == SP_PITCH_MODE_STRETCH && sp_row[_pi] >= 0 ? sp_pitch_any_stretch = 1;
    // Does ANY pad currently ask for a mode the Extension provides? Tuned and
    // Stretch both degrade to plain varispeed repitch without it (see
    // rk_swing_core select-layer), which sounds like a bug rather than a tier.
    // The UI gates its "engine not installed" notice on this so a user who
    // never touches those modes is never nagged about something they did not
    // buy. Free to compute — this loop already runs every block.
    sp_pitch_mode[_pi] != SP_PITCH_MODE_REPITCH ? sp_pitch_any_ext_mode = 1;
    _pi += 1;
  );
  sp_pitch_pdc_target = (sp_pitch_ext_alive && sp_pitch_any_stretch)
                        ? atomic_get(gmem[SP_PITCH_PDC_BUDGET])|0
                        : 0;
);

// ─── The spot handshake, @init half: the epoch and the identity map ─────────────────────────────────────────
// Called from Swing_ReaKit.jsfx @init once the arrays exist (pr_pad, sp_row, sp_pub_gen, sp_map_gen, sp_hold,
// sp_hold_hb). The epoch salts every generation this instance publishes: a multiple of SP_EPOCH_UNIT from the
// clock, never 0, below 2^30 (the Extension casts the SRCGEN band to uint32), so a reopened instance never
// repeats a previous one's values on the same slot and sp_src_gen (bumped per load, lifted by a spot's give
// (swing_spot_give), far below 65536 a session)
// rides in the low bits. sp_pub_gen starts at 0: the first spot tick sees every spot as changed and runs the
// handshake once (an instance's first sighting is a source change to the bridge too).
function swing_spot_init()
local(_ssi_e _ssi_i)
(
  _ssi_e = time_precise() * 1000;
  _ssi_e = _ssi_e - floor(_ssi_e / 16384) * 16384;        // 0..16383
  sp_epoch = (floor(_ssi_e) + 1) * SP_EPOCH_UNIT;          // 65536 .. 2^30
  memset(sp_row, -1, NUM_SLOTS);
  _ssi_i = 0;
  loop(NUM_PADS,   // bank A: identity at @init, bank A pad s on spot s (the spots are sixteen per instance); step 4 lends from here
    pr_pad[_ssi_i] = _ssi_i;
    pr_state[_ssi_i] = SPOT_STATE_LIVE;
    pr_drain[_ssi_i] = 0;
    sp_row[_ssi_i] = _ssi_i;
    sp_pub_gen[_ssi_i] = 0;
    sp_map_gen[_ssi_i] = 0;
    _ssi_i += 1;
  );
  sp_gen_hw = 0;   // the highest GEN published on any spot this epoch (swing_spot_tick); a give lifts above it (H20)
  sp_br_last_hb = 0; sp_br_last_seen_t = time_precise(); sp_br_alive = 0;   // starts alive for one grace, as the Extension's
  sp_drain_ctr = 0;
  sp_br_lends = 0;
  sp_swap_done = sp_swap_req;   // the swap queue starts empty: a swap posted before the identity map cannot follow into it
);

// ─── Step 4: lending the spots to pads of every bank (Plan_Swing_Pad_Banks_Tuned §5, §5A, §8 step 4; 2026-10-09) ──
// A pad NEEDS a spot while its stored mode is Tuned or Stretch and it holds audio (§5.2). The spots start on bank A
// pad s (identity, today's layout) and stay there while that pad needs it. A spot whose owner does not need it is
// IDLE and may be lent: a pad that needs one and holds none takes its own spot (a bank A pad) when that one is idle,
// else the HIGHEST idle spot (the plan said lowest; changed 2026-10-09 so borrowed spots stay away from bank A's first
// pads, the ones every kit fills first). A spot with no owner is given at once. One with an owner is first DRAINED:
// it keeps publishing that owner -- now out of Tuned / Stretch, or empty -- until the bridge answers that nothing is
// left to put back for it (SPOT_ANS +32 = the map's GEN: every queued revert sent and consumed, no command in
// flight), so a revert can never carry the old owner's original into the new owner. Then it goes to the pad waiting
// (its own bank A pad first, then bank A in order, then slots 16..63), else home to its own bank A pad, else free.
// The new owner is PENDING until the bridge has prepared it (step 3's answer): the order and the hold of §5A.3 apply
// exactly as to a re-drop, and the bridge treats an owner change as a source change (the fence, the blank, a fresh
// capture). Lending needs a bridge that answers (sp_br_alive): an older bridge or none never sees the map change, the
// spots stay where they are, and a B..D pad plays Repitch as before.
// The seventeenth pad (§5.6): a pad that needs a spot while all sixteen owners need theirs WAITS -- it plays Repitch
// and keeps its stored mode -- and the mode stepper refuses a change INTO Tuned / Stretch then (swing_spot_refuse).
// Shared values (00-rules Q1): pr_pad / pr_state / sp_row are written here, in @block only, and read by @gfx (the LCD)
// and the voice launcher (@block); the drain answer is gmem from the bridge.
// swing_spot_wants / swing_spot_idle / swing_spot_refuse / swing_spot_waiting live in rk_swing_core.jsfx-inc (the LCD
// compiles before this file).

// Start draining spot _sd_r. Every drain gets a token of its own (the @init epoch + a count, published in the map's
// STATE cell as STATE + 4 x token);
// the bridge answers with it, so an answer left over from an earlier drain of the same owner -- one cancelled
// because the owner went back to Tuned -- can never end this one before its reverts are out.
function swing_spot_drain(_sd_r)
(
  pr_state[_sd_r] = SPOT_STATE_DRAINING;
  sp_drain_ctr += 1;
  pr_drain[_sd_r] = sp_epoch + sp_drain_ctr;
);

// Give spot _sg_r to pad _sg_p (-1: the spot goes free). swing_spot_assign only.
function swing_spot_give(_sg_r, _sg_p)
local(_sg_o _sg_l _sg_b)
(
  _sg_o = pr_pad[_sg_r];
  _sg_o >= 0 ? sp_row[_sg_o] = -1;
  pr_pad[_sg_r] = _sg_p;
  _sg_p >= 0 ? (
    sp_row[_sg_p] = _sg_r;
    // The seed (§5A.7): a Tuned pad whose audio has not come through the loader since @init (sp_src_gen 0) holds what
    // an embedded save restored -- its bake, at the saved tune. The first block seeds the spots it finds; a pad that
    // gets one later is seeded here, before its generation can move below.
    sp_src_gen[_sg_p] == 0 && sp_pitch_mode[_sg_p] == SP_PITCH_MODE_TUNED ? (
      _sg_l = 0;
      loop(MAX_LAYERS, sp_baked_tune[_sg_p * MAX_LAYERS + _sg_l] = p_tune[_sg_p]; _sg_l += 1; );
    );
    // A generation this spot has not published: the Extension keys a Stretch preparation by the SRCGEN VALUE, so an
    // owner whose value equalled the old owner's would keep the old owner's sound. Lifted ABOVE every generation this
    // instance has published on any spot (sp_gen_hw, swing_spot_tick; audit H20, 2026-10-23): one bump past map OR
    // pub could land on the other when the two were adjacent (no hold, or a hold released in the same tick -- the
    // new owner's Stretch hits played the old owner's sample), and the Extension may still hold an OLDER pub's
    // preparation. Every pub and every preparation was once a map value, so a value above the mark is new to all.
    swing_spot_gen(_sg_p) <= sp_gen_hw ? sp_src_gen[_sg_p] = sp_gen_hw - sp_epoch + 1;
    // The ring's read cursor parked at the producer's: the old owner's tail is nobody's now.
    _reg_my_slot >= 0 ? (
      _sg_b = STRETCH_AUDIO_BASE + _reg_my_slot * STRETCH_INST_AUDIO_STRIDE + _sg_r * STRETCH_PAD_STRIDE;
      stretch_read_pos[_sg_r] = atomic_get(gmem[_sg_b + STRETCH_OFF_WRITE_POS]) | 0;
      atomic_set(gmem[_sg_b + STRETCH_OFF_READ_POS], stretch_read_pos[_sg_r]);
    );
    pr_state[_sg_r] = SPOT_STATE_PENDING;
  ) : (
    pr_state[_sg_r] = SPOT_STATE_FREE;
  );
);

// The pad a spot drained for spot _sn_r goes to: its own bank A pad if that one waits, else the first pad waiting
// (bank A in order, then 16..63); -1 = nobody waits.
function swing_spot_next_wait(_sn_r)
local(_sn_p _sn_w)
(
  _sn_w = -1;
  sp_row[_sn_r] < 0 && swing_spot_wants(_sn_r) ? _sn_w = _sn_r : (
    _sn_p = 0;
    while(_sn_w < 0 && _sn_p < NUM_SLOTS) (
      sp_row[_sn_p] < 0 && swing_spot_wants(_sn_p) ? _sn_w = _sn_p;
      _sn_p += 1;
    );
  );
  _sn_w;
);

// Once per @block from swing_spot_tick, only while a bridge that answers runs.
function swing_spot_assign()
local(_sa_r _sa_p _sa_t _sa_d _sa_ab _sa_best)
(
  _sa_ab = SPOT_ANS_BASE + _reg_my_slot * SPOT_ANS_STRIDE;
  // 1. The drains. An owner that needs its spot again keeps it (the drain is cancelled: the bridge drops reverts
  //    queued for a pad that is Tuned again). An answered drain hands the spot over.
  _sa_r = 0;
  loop(NUM_PADS,   // bank A: the spots; spot _sa_r's own pad is bank A pad _sa_r (sp_row[_sa_r] below)
    pr_state[_sa_r] == SPOT_STATE_DRAINING ? (
      _sa_p = pr_pad[_sa_r];
      _sa_p >= 0 && swing_spot_wants(_sa_p) ? (
        pr_state[_sa_r] = SPOT_STATE_LIVE;
      ) : gmem[_sa_ab + SPOT_ANS_OFF_STATE + _sa_r] == pr_drain[_sa_r] ? (
        _sa_t = swing_spot_next_wait(_sa_r);
        _sa_t >= 0 ? swing_spot_give(_sa_r, _sa_t) : (
          _sa_p == _sa_r ? ( pr_state[_sa_r] = SPOT_STATE_LIVE; )                  // its own pad, nobody waits: stays
                         : swing_spot_give(_sa_r, sp_row[_sa_r] < 0 ? _sa_r : -1);  // home, or free
        );
      );
    );
    _sa_r += 1;
  );
  // 2. The pads waiting: each drain under way will serve one; for every other, a free spot is given at once, an
  //    idle one with an owner starts draining. Its own spot first (a bank A pad), else the highest idle spot.
  _sa_d = 0; _sa_r = 0;
  loop(NUM_PADS, pr_state[_sa_r] == SPOT_STATE_DRAINING ? _sa_d += 1; _sa_r += 1; );
  _sa_p = 0;
  loop(NUM_SLOTS,
    sp_row[_sa_p] < 0 && swing_spot_wants(_sa_p) ? (
      _sa_d > 0 ? ( _sa_d -= 1; ) : (
        _sa_best = -1;
        _sa_p < NUM_PADS && swing_spot_idle(_sa_p) ? _sa_best = _sa_p : (
          _sa_r = NUM_PADS - 1;
          while(_sa_best < 0 && _sa_r >= 0) ( swing_spot_idle(_sa_r) ? _sa_best = _sa_r; _sa_r -= 1; );
        );
        _sa_best >= 0 ? (
          pr_pad[_sa_best] < 0 ? swing_spot_give(_sa_best, _sa_p) : swing_spot_drain(_sa_best);
        );
      );
    );
    _sa_p += 1;
  );
  // 3. An idle spot away from home whose own bank A pad holds none goes back (drained first): the layout returns to
  //    identity when nothing borrows, which is what an older bridge, a restart and every rig expect.
  _sa_r = 0;
  loop(NUM_PADS,   // bank A: the spots; spot _sa_r's own pad is bank A pad _sa_r
    _sa_p = pr_pad[_sa_r];
    _sa_p != _sa_r && sp_row[_sa_r] < 0 && swing_spot_idle(_sa_r) ? (
      _sa_p < 0 ? swing_spot_give(_sa_r, _sa_r) : swing_spot_drain(_sa_r);
    );
    _sa_r += 1;
  );
);

// ─── The spot handshake, @block half (§5A.5; the order and the hold of §5A.3) ───────────────────────────────
// Runs right after swing_block_pitch_tick in @block ONLY (the map has one writer; @gfx and the bridge read it).
// Per spot: publish OWNER / STATE / GEN (GEN last). When the owner's generation differs from what the map held,
// a source change (or this instance's first block): the pad's Stretch output goes to the plain way and its
// ring is choked, and the SRCGEN publish for the spot waits. It is released when the bridge's answer for the
// spot equals the generation -- then the hold ends SP_HOLD_TICKS heartbeats later -- or at once when no new bridge
// is running (the gate: its heartbeat must move while we watch, and ANS_VER must read 1), in which case nothing
// is held: today's behaviour, for an older bridge or none. A dead Extension ends every hold too (its ring plays
// nothing; the plain way is the fallback anyway).
// Shared values (00-rules Q1): sp_src_gen is bumped from @block (CMD 63 / 64, the loader) and from @gfx (a grid
// or overlay drop, undo); this tick reads it. sp_hold / sp_hold_hb are written here and read at voice launch
// (@block). The map and the answer are gmem, per registry slot.
function swing_spot_tick()
local(_st_r _st_p _st_mb _st_ab _st_g _st_ans _st_hb _st_n _st_q _st_a _st_b)
(
  _reg_my_slot >= 0 ? (
    _st_mb = SPOT_MAP_BASE + _reg_my_slot * SPOT_MAP_STRIDE;
    _st_ab = SPOT_ANS_BASE + _reg_my_slot * SPOT_ANS_STRIDE;
    // The bridge's heartbeat: alive only while it MOVES (wiki 5.8), the Extension watchdog's grace, in wall time
    // (a render runs blocks faster than the bridge ticks).
    _st_hb = gmem[_st_ab + SPOT_ANS_OFF_HB];
    _st_hb != sp_br_last_hb ? (
      sp_br_last_hb = _st_hb;
      sp_br_last_seen_t = time_precise();
    );
    sp_br_alive = (time_precise() - sp_br_last_seen_t) < SP_PITCH_GRACE_S
                  && gmem[_st_ab + SPOT_ANS_OFF_VER] >= 1;
    // Lending needs a bridge that also answers DRAINS (ANS_VER 2, step 4): the step 3 bridge answers the handshake
    // but never a drain, so a spot drained for a waiting pad would stay draining and the pad would wait for good.
    sp_br_lends = sp_br_alive && gmem[_st_ab + SPOT_ANS_OFF_VER] >= 2;
    // Pad swaps (swap_pads, @gfx) moved pads' audio: their spots follow it, every swap in the order it was made (the
    // swap queue, read here only; Swing_ReaKit.jsfx @init). The count is read ONCE, through atomic_get (it pairs with
    // swap_pads' atomic_set): every cell below it was written before it moved. More swaps than the queue holds while
    // @block did not run (Swing bypassed): the oldest are dropped and their spots stay put -- those pads re-capture
    // anyway (the swap bumped sp_src_gen; plan §6.4).
    _st_n = atomic_get(sp_swap_req);
    (_st_n - sp_swap_done > SP_SWAP_QN) ? sp_swap_done = _st_n - SP_SWAP_QN;
    while (sp_swap_done < _st_n) (
      _st_q = sp_swap_q[sp_swap_done % SP_SWAP_QN];
      _st_a = (_st_q / NUM_SLOTS) | 0;
      _st_b = _st_q - _st_a * NUM_SLOTS;
      _st_r = sp_row[_st_a]; _st_p = sp_row[_st_b];
      sp_row[_st_a] = _st_p; sp_row[_st_b] = _st_r;
      _st_p >= 0 ? pr_pad[_st_p] = _st_a;
      _st_r >= 0 ? pr_pad[_st_r] = _st_b;
      sp_swap_done += 1;
    );
    sp_br_lends ? swing_spot_assign();   // step 4: lend, drain, hand over (nothing moves without a bridge that answers drains)
    _st_r = 0;
    loop(NUM_PADS,   // the spots: sixteen per instance
      _st_p = pr_pad[_st_r];
      _st_g = _st_p >= 0 ? swing_spot_gen(_st_p) : 0;
      gmem[_st_mb + _st_r * 4 + 0] = _st_p + 1;
      // STATE; a draining spot carries its drain's token in the same cell, STATE + 4 x token (step 4: the map has no
      // free cell -- spot 15's fourth is MAP_VER at +63, which the first build's token at +3 overwrote every block)
      gmem[_st_mb + _st_r * 4 + 1] = _st_p < 0 ? SPOT_STATE_FREE
        : (pr_state[_st_r] == SPOT_STATE_DRAINING ? SPOT_STATE_DRAINING + 4 * pr_drain[_st_r] : pr_state[_st_r]);
      atomic_set(gmem[_st_mb + _st_r * 4 + 2], _st_g);   // GEN last
      _st_p >= 0 ? (
        _st_g > sp_gen_hw ? sp_gen_hw = _st_g;   // the high-water mark of every GEN published (swing_spot_give, H20)
        // A source change (or the first block): hold the pad's Stretch output, choke its ring, wait for the answer.
        sp_map_gen[_st_r] != _st_g ? (
          sp_map_gen[_st_r] = _st_g;
          sp_hold[_st_p] = 1;
          sp_hold_hb[_st_p] = 0;
          sp_pitch_mode[_st_p] == SP_PITCH_MODE_STRETCH && stretch_choked[_st_p] == 0 ? stretch_choked[_st_p] = 1;
        );
        // The order: release the spot's SRCGEN when the bridge has prepared this generation, or at once with no
        // new bridge to wait for.
        sp_pub_gen[_st_r] != _st_g ? (
          _st_ans = gmem[_st_ab + _st_r];
          (!sp_br_alive || _st_ans == _st_g) ? (
            sp_pub_gen[_st_r] = _st_g;
            sp_hold_hb[_st_p] = sp_br_alive ? sp_pitch_cur_hb + SP_HOLD_TICKS : -1;   // -1: nothing to wait for
          );
        );
        // A new owner is LIVE once its generation is released (prepared), or at once when it does not need the spot
        // (a spot back home on a Repitch pad: no capture comes for it, so no answer either).
        pr_state[_st_r] == SPOT_STATE_PENDING && (sp_pub_gen[_st_r] == _st_g || !swing_spot_wants(_st_p)) ?
          pr_state[_st_r] = SPOT_STATE_LIVE;
        // The hold ends SP_HOLD_TICKS heartbeats after the answer; at once with no bridge or no Extension.
        sp_hold[_st_p] && sp_pub_gen[_st_r] == _st_g
          && (sp_hold_hb[_st_p] < 0 || !sp_br_alive || !sp_pitch_ext_alive || sp_pitch_cur_hb >= sp_hold_hb[_st_p]) ? (
          sp_hold[_st_p] = 0;
        );
      );
      _st_r += 1;
    );
    gmem[_st_mb + SPOT_MAP_OFF_VER] = 1;
  );
);
