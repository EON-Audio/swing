// rk_swing_ui_panels_lcd_p2.jsfx-inc -- part 2 of rk_swing_ui_panels_lcd.jsfx-inc (2 parts), cut at a function boundary by
// .dev_tests/split_big_incs.py: REAPER's load time grows with the square of a file's size. Edit freely;
// keep each file under about 40 KB.

// ⚠️ @init IS LOAD-BEARING (.docs/wiki/02-file-structure.md).
@init

function swing_panels_draw_reverb() (
    _fx_y0 = _lcd_cy + 2;
    _fx_avail_h = _lcd_ch - 6;
    _fx_label_w = (_lcd_cw * 0.38)|0;
    _fx_bar_x = _lcd_cx + _fx_label_w;
    _fx_bar_w = _lcd_cw - _fx_label_w - 4;
    rk_font(1, 9, 'b');

    // ═══════════════════════════════════════════════════════════════════
    // REVERB — Params: SIZE, DAMP, PRE, HPF, MIX, WIDTH
    // ═══════════════════════════════════════════════════════════════════
    1 ? (
      _fx_row_h = (_fx_avail_h / 7)|0;

      // ── Row 0: REVERB ON/OFF ──
      // The bus enable (ser_ver 57). "Off" used to mean SIZE = 0, which was
      // destructive (you lost the room you wanted back) AND chopped the tail
      // the instant a drag crossed the threshold.
      _fx_ry = _fx_y0;
      gfx_set(lcd_tx_r, lcd_tx_g, lcd_tx_b, 0.85);
      gfx_x = _lcd_cx + 2; gfx_y = _fx_ry; gfx_drawstr("VERB:");
      rvb_on ? gfx_set(0.25, 0.65, 0.35, 0.8) : gfx_set(0.06, 0.16, 0.20, 0.6);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_bar_w, _fx_row_h - 3);
      gfx_set(1, 1, 1, 0.9);
      rvb_on ? strcpy(#_fxv, "ON") : strcpy(#_fxv, "OFF");
      rk_font(1, 9, swing_txt_wt(9, #_fxv));   // a value with a digit: regular (wiki 4.7)
      gfx_measurestr(#_fxv, tw, th);
      gfx_x = _fx_bar_x + (_fx_bar_w - tw) / 2; gfx_y = _fx_ry; gfx_drawstr(#_fxv);
      rk_font(1, 9, 'b');
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? swing_tooltip_check(1306, "Reverb bus on/off. OFF lets the tail ring out and keeps size, damping and mix exactly where you left them.");
      lmb_down && mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? (
        rvb_on = !rvb_on; mark_dirty_kit();
      );

      // Row 1: SIZE
      _fx_ry += _fx_row_h;
      gfx_set(lcd_tx_r, lcd_tx_g, lcd_tx_b, 0.85);
      gfx_x = _lcd_cx + 2; gfx_y = _fx_ry; gfx_drawstr("SIZE:");
      gfx_set(0.06, 0.16, 0.20, 0.6);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_bar_w, _fx_row_h - 3);
      _fx_fill = (rvb_size * _fx_bar_w)|0;
      gfx_set(0.45, 0.30, 0.75, 0.7);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_fill, _fx_row_h - 3);
      gfx_set(1, 1, 1, 1);
      sprintf(#_fxv, "%.0f%%", rvb_size * 100);
      rk_font(1, 9, swing_txt_wt(9, #_fxv));   // a value with a digit: regular (wiki 4.7)
      gfx_measurestr(#_fxv, tw, th);
      gfx_x = _fx_bar_x + (_fx_bar_w - tw) / 2; gfx_y = _fx_ry; gfx_drawstr(#_fxv);
      rk_font(1, 9, 'b');
      active_id == 282 ? ( LMB ? (
        rvb_size = max(0, min(1, (mx - _fx_bar_x) / _fx_bar_w));
        mark_dirty_kit();
      ) : active_id = -1; );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? swing_tooltip_check(1300, "Reverb room size (0-100%). 0=tiny chamber, 100%=large hall. Drag or scroll.");
      active_id == -1 && lmb_down && mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? (
        active_id = 282;
      );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h && frame_wheel != 0 ? (
        rvb_size = max(0, min(1, rvb_size + frame_wheel * 0.02)); mark_dirty_kit();
      );

      // Row 2: DAMP
      _fx_ry += _fx_row_h;
      gfx_set(lcd_tx_r, lcd_tx_g, lcd_tx_b, 0.85);
      gfx_x = _lcd_cx + 2; gfx_y = _fx_ry; gfx_drawstr("DAMP:");
      gfx_set(0.06, 0.16, 0.20, 0.6);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_bar_w, _fx_row_h - 3);
      _fx_fill = (rvb_damp * _fx_bar_w)|0;
      gfx_set(0.45, 0.30, 0.75, 0.7);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_fill, _fx_row_h - 3);
      gfx_set(1, 1, 1, 1);
      sprintf(#_fxv, "%.0f%%", rvb_damp * 100);
      rk_font(1, 9, swing_txt_wt(9, #_fxv));   // a value with a digit: regular (wiki 4.7)
      gfx_measurestr(#_fxv, tw, th);
      gfx_x = _fx_bar_x + (_fx_bar_w - tw) / 2; gfx_y = _fx_ry; gfx_drawstr(#_fxv);
      rk_font(1, 9, 'b');
      active_id == 286 ? ( LMB ? (
        rvb_damp = max(0, min(1, (mx - _fx_bar_x) / _fx_bar_w));
        mark_dirty_kit();
      ) : active_id = -1; );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? swing_tooltip_check(1301, "Reverb high-frequency damping (0-100%). Higher values make the tail darker and shorter at the top end.");
      active_id == -1 && lmb_down && mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? (
        active_id = 286;
      );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h && frame_wheel != 0 ? (
        rvb_damp = max(0, min(1, rvb_damp + frame_wheel * 0.02)); mark_dirty_kit();
      );

      // Row 3: PRE (pre-delay 0-250ms)
      _fx_ry += _fx_row_h;
      gfx_set(lcd_tx_r, lcd_tx_g, lcd_tx_b, 0.85);
      gfx_x = _lcd_cx + 2; gfx_y = _fx_ry; gfx_drawstr("PRE:");
      gfx_set(0.06, 0.16, 0.20, 0.6);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_bar_w, _fx_row_h - 3);
      _fx_fill = ((rvb_predelay / 250) * _fx_bar_w)|0;
      gfx_set(0.45, 0.30, 0.75, 0.7);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_fill, _fx_row_h - 3);
      gfx_set(1, 1, 1, 1);
      sprintf(#_fxv, "%.0f ms", rvb_predelay);
      rk_font(1, 9, swing_txt_wt(9, #_fxv));   // a value with a digit: regular (wiki 4.7)
      gfx_measurestr(#_fxv, tw, th);
      gfx_x = _fx_bar_x + (_fx_bar_w - tw) / 2; gfx_y = _fx_ry; gfx_drawstr(#_fxv);
      rk_font(1, 9, 'b');
      active_id == 288 ? ( LMB ? (
        rvb_predelay = max(0, min(250, ((mx - _fx_bar_x) / _fx_bar_w) * 250));
        mark_dirty_kit();
      ) : active_id = -1; );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? swing_tooltip_check(1302, "Pre-delay before reverb tail starts (0-250 ms). Keeps the dry transient clear.");
      active_id == -1 && lmb_down && mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? (
        active_id = 288;
      );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h && frame_wheel != 0 ? (
        rvb_predelay = max(0, min(250, rvb_predelay + frame_wheel * 5)); mark_dirty_kit();
      );

      // Row 4: HPF (0-500 Hz, 0 = off)
      _fx_ry += _fx_row_h;
      gfx_set(lcd_tx_r, lcd_tx_g, lcd_tx_b, 0.85);
      gfx_x = _lcd_cx + 2; gfx_y = _fx_ry; gfx_drawstr("HPF:");
      gfx_set(0.06, 0.16, 0.20, 0.6);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_bar_w, _fx_row_h - 3);
      _fx_fill = ((rvb_hpf / 500) * _fx_bar_w)|0;
      gfx_set(0.45, 0.30, 0.75, 0.7);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_fill, _fx_row_h - 3);
      gfx_set(1, 1, 1, 1);
      rvb_hpf < 20 ? (   // the engine's own gate (rk_reverb: on from 20 Hz); "10 Hz" used to show while off (sweep LIB140)
        sprintf(#_fxv, "OFF");
      ) : (
        sprintf(#_fxv, "%.0f Hz", rvb_hpf);
      );
      rk_font(1, 9, swing_txt_wt(9, #_fxv));   // a value with a digit: regular (wiki 4.7)
      gfx_measurestr(#_fxv, tw, th);
      gfx_x = _fx_bar_x + (_fx_bar_w - tw) / 2; gfx_y = _fx_ry; gfx_drawstr(#_fxv);
      rk_font(1, 9, 'b');
      active_id == 289 ? ( LMB ? (
        rvb_hpf = max(0, min(500, ((mx - _fx_bar_x) / _fx_bar_w) * 500));
        mark_dirty_kit();
      ) : active_id = -1; );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? swing_tooltip_check(1303, "High-pass filter on the reverb send (0-500 Hz). Reduces low-end buildup. OFF below 20 Hz.");
      active_id == -1 && lmb_down && mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? (
        active_id = 289;
      );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h && frame_wheel != 0 ? (
        rvb_hpf = max(0, min(500, rvb_hpf + frame_wheel * 10)); mark_dirty_kit();
      );

      // Row 5: MIX
      _fx_ry += _fx_row_h;
      gfx_set(lcd_tx_r, lcd_tx_g, lcd_tx_b, 0.85);
      gfx_x = _lcd_cx + 2; gfx_y = _fx_ry; gfx_drawstr("MIX:");
      gfx_set(0.06, 0.16, 0.20, 0.6);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_bar_w, _fx_row_h - 3);
      _fx_fill = (rvb_mix * _fx_bar_w)|0;
      gfx_set(0.45, 0.30, 0.75, 0.7);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_fill, _fx_row_h - 3);
      gfx_set(1, 1, 1, 1);
      sprintf(#_fxv, "%.0f%%", rvb_mix * 100);
      rk_font(1, 9, swing_txt_wt(9, #_fxv));   // a value with a digit: regular (wiki 4.7)
      gfx_measurestr(#_fxv, tw, th);
      gfx_x = _fx_bar_x + (_fx_bar_w - tw) / 2; gfx_y = _fx_ry; gfx_drawstr(#_fxv);
      rk_font(1, 9, 'b');
      active_id == 283 ? ( LMB ? (
        rvb_mix = max(0, min(1, (mx - _fx_bar_x) / _fx_bar_w));
        mark_dirty_kit();
      ) : active_id = -1; );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? swing_tooltip_check(1304, "Reverb wet/dry blend (0=dry, 100%=full reverb). Drag or scroll.");
      active_id == -1 && lmb_down && mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? (
        active_id = 283;
      );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h && frame_wheel != 0 ? (
        rvb_mix = max(0, min(1, rvb_mix + frame_wheel * 0.02)); mark_dirty_kit();
      );

      // Row 6: WIDTH
      _fx_ry += _fx_row_h;
      gfx_set(lcd_tx_r, lcd_tx_g, lcd_tx_b, 0.85);
      gfx_x = _lcd_cx + 2; gfx_y = _fx_ry; gfx_drawstr("WIDTH:");
      gfx_set(0.06, 0.16, 0.20, 0.6);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_bar_w, _fx_row_h - 3);
      _fx_fill = (rvb_width * _fx_bar_w)|0;
      gfx_set(0.45, 0.30, 0.75, 0.7);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_fill, _fx_row_h - 3);
      gfx_set(1, 1, 1, 1);
      sprintf(#_fxv, "%.0f%%", rvb_width * 100);
      rk_font(1, 9, swing_txt_wt(9, #_fxv));   // a value with a digit: regular (wiki 4.7)
      gfx_measurestr(#_fxv, tw, th);
      gfx_x = _fx_bar_x + (_fx_bar_w - tw) / 2; gfx_y = _fx_ry; gfx_drawstr(#_fxv);
      rk_font(1, 9, 'b');
      active_id == 287 ? ( LMB ? (
        rvb_width = max(0, min(1, (mx - _fx_bar_x) / _fx_bar_w));
        mark_dirty_kit();
      ) : active_id = -1; );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? swing_tooltip_check(1305, "Stereo width of the reverb tail (0=mono, 100%=full stereo spread).");
      active_id == -1 && lmb_down && mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? (
        active_id = 287;
      );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h && frame_wheel != 0 ? (
        rvb_width = max(0, min(1, rvb_width + frame_wheel * 0.02)); mark_dirty_kit();
      );
    );
);

// ── Master COMP page: Weld's console card ──────────────────────────────────
// Swing's master compressor IS the EON Weld engine (rk_compressor.jsfx-inc),
// and since 2026-09-04 the page says so: the same card Weld draws in its own
// window, from libs/rk_weld_face.jsfx-inc, on both surfaces. The big view
// (VIEW_COMP, ~465x600 at the default window) stacks it PORTRAIT the way
// Weld's floating window does; the compact LCD page (~326x108) lays it out
// LANDSCAPE: meter and the two buttons on the left, six knobs in two rows on
// the right. One drawer, one rect (_lcd_c*), the aspect picks the layout.
//
// Writes go the house way: cmp_* in real units, cmp_recalc() for the engine,
// mark_dirty_kit() for undo. Knob travel for RATIO / ATTACK / RELEASE is
// ln-mapped exactly as Weld's (the ladders are printed for those positions).
// KNEE (the diode trim) is off the face on purpose, like Weld: right-click the
// RATIO knob to reach it. The GR needle is an rk_vu instance (cmp_vu) fed in
// @sample; its face follows the header VU selector when one is set, else
// Weld's cream. Per-surface knob memory: km_comp + 0..5 (big) / 6..11 (LCD),
// so a drag anchored on one surface never fights the other (Weld's lesson).

function swing_panels_comp_knob(ki, cx, cy, kr, km) local(_lv, _nv) (
  // Interact in Weld's units and travel, write to Swing's cmp_* params, and
  // set the display value + strings for the face lib. Returns nothing; the
  // caller draws the cell.
  ki == 0 ? (
    _nv = ssl_knob_interact(km, cx, cy, kr, cmp_thresh, -40, 0, -12, 0);
    _nv != cmp_thresh ? ( cmp_thresh = _nv; swing_rcp_post_cmp(); mark_dirty_kit(); );
    _cpc_dv = cmp_thresh; _cpc_dmin = -40; _cpc_dmax = 0; _cpc_dsym = 0;
    strcpy(#wface_lbl, "THRESHOLD"); sprintf(#wface_val, "%.1fdB", cmp_thresh);
  ) :
  ki == 1 ? (
    _lv = log(max(1, cmp_ratio));
    // Right-click on RATIO cycles the knee (below), not a reset; see the note on
    // the LCD PAN knob in rk_swing_lcd.
    _rmb_keep = rmb_down; rmb_down = 0;
    _nv = ssl_knob_interact(km, cx, cy, kr, _lv, 0, 2.99573227355, 1.38629436112, 0);
    rmb_down = _rmb_keep;
    _nv != _lv ? ( cmp_ratio = exp(_nv); swing_rcp_post_cmp(); mark_dirty_kit(); );
    _cpc_dv = _nv; _cpc_dmin = 0; _cpc_dmax = 2.99573227355; _cpc_dsym = 0;
    strcpy(#wface_lbl, "RATIO");
    cmp_ratio >= 20 ? strcpy(#wface_val, "LIM") : sprintf(#wface_val, "%.1f:1", cmp_ratio);
  ) :
  ki == 2 ? (
    _lv = log(max(0.1, cmp_attack));
    _nv = ssl_knob_interact(km, cx, cy, kr, _lv, -2.30258509299, 4.60517018599, 2.30258509299, 0);
    _nv != _lv ? ( cmp_attack = exp(_nv); swing_rcp_post_cmp(); mark_dirty_kit(); );
    _cpc_dv = _nv; _cpc_dmin = -2.30258509299; _cpc_dmax = 4.60517018599; _cpc_dsym = 0;
    strcpy(#wface_lbl, "ATTACK"); sprintf(#wface_val, "%.1fms", cmp_attack);
  ) :
  ki == 3 ? (
    _lv = log(max(100, cmp_release));
    _nv = ssl_knob_interact(km, cx, cy, kr, _lv, 4.60517018599, 7.09007683578, 5.29831736655, 0);
    _nv != _lv ? ( cmp_release = exp(_nv); swing_rcp_post_cmp(); mark_dirty_kit(); );
    _cpc_dv = _nv; _cpc_dmin = 4.60517018599; _cpc_dmax = 7.09007683578; _cpc_dsym = 0;
    strcpy(#wface_lbl, "RELEASE");
    cmp_auto ? strcpy(#wface_val, "AUTO") : sprintf(#wface_val, "%.0fms", cmp_release);
  ) :
  ki == 4 ? (
    _nv = ssl_knob_interact(km, cx, cy, kr, cmp_makeup, -12, 12, 0, 0);
    _nv != cmp_makeup ? ( cmp_makeup = _nv; swing_rcp_post_cmp(); mark_dirty_kit(); );
    _cpc_dv = cmp_makeup; _cpc_dmin = -12; _cpc_dmax = 12; _cpc_dsym = 1;
    strcpy(#wface_lbl, "MAKEUP"); sprintf(#wface_val, "%+.1fdB", cmp_makeup);
  ) : (
    _nv = ssl_knob_interact(km, cx, cy, kr, cmp_mix, 0, 1, 1, 0);
    _nv != cmp_mix ? ( cmp_mix = _nv; swing_rcp_post_cmp(); mark_dirty_kit(); );
    _cpc_dv = cmp_mix; _cpc_dmin = 0; _cpc_dmax = 1; _cpc_dsym = 0;
    strcpy(#wface_lbl, "MIX"); sprintf(#wface_val, "%.0f%%", cmp_mix * 100);
  );
  // (the hover-wheel is ssl_knob_interact's own: it nudges in the knob's
  // travel units, the same as Weld -- a second wheel path here doubled it)
  // right-click the RATIO knob: the knee (diode trim) lives behind the face
  ki == 1 && rmb_down && dist(mx, my, cx, cy) <= kr ? (
    cmp_knee = cmp_knee >= 12 ? 0 : cmp_knee + 3; swing_rcp_post_cmp(); mark_dirty_kit();
  );
  dist(mx, my, cx, cy) <= kr ? (
    ki == 0 ? swing_tooltip_check(1401, "Threshold (-40 to 0 dB). Compression engages above this signal level.") :
    ki == 1 ? swing_tooltip_check(1402, "Ratio, 1:1 to 20:1 (LIM). Right-click cycles the knee: the diode trim, 6 dB = the stock part.") :
    ki == 2 ? swing_tooltip_check(1403, "Attack, 0.1 to 100 ms, on the hardware ladder.") :
    ki == 3 ? swing_tooltip_check(1404, "Release, 100 ms to 1.2 s, the switch's span. AUTO hands it to the programme-dependent network.") :
    ki == 4 ? swing_tooltip_check(1407, "Makeup gain (-12 to +12 dB) after the compressor.") :
              swing_tooltip_check(1406, "Mix: dry to compressed. 100% = the whole signal through the compressor.");
  );
);


// Anvil voice: the same six cells, Anvil's controls in Anvil's units. The
// ratio knob is Anvil's stepped switch (20:1 12:1 8:1 4:1 ALL) -- continuous
// travel, snapped on write. Writes go through swing_comp_anvil_push, which is
// the engine's only door.
function swing_panels_anvil_knob(ki, cx, cy, kr, km) local(_nv, _r) (
  ki == 0 ? (
    _nv = ssl_knob_interact(km, cx, cy, kr, cmp_anv_in, -30, 24, 0, 0);
    _nv != cmp_anv_in ? ( cmp_anv_in = _nv; swing_comp_anvil_push(); mark_dirty_kit(); );
    _cpc_dv = cmp_anv_in; _cpc_dmin = -30; _cpc_dmax = 24; _cpc_dsym = 1;
    strcpy(#wface_lbl, "INPUT"); sprintf(#wface_val, "%+.1fdB", cmp_anv_in);
  ) :
  ki == 1 ? (
    // n_detents 5: a switch of five positions, so a wheel notch steps one position. With 0 a notch
    // added 2 % of the range (0.08), the snap below took it straight back, and the knob never moved
    // under the wheel (sweep LIB119). The drag keeps its snap.
    _nv = ssl_knob_interact(km, cx, cy, kr, cmp_anv_ratio, 0, 4, 3, 5);
    _r = floor(_nv + 0.5);
    _r != cmp_anv_ratio ? ( cmp_anv_ratio = _r; swing_comp_anvil_push(); mark_dirty_kit(); );
    _cpc_dv = cmp_anv_ratio; _cpc_dmin = 0; _cpc_dmax = 4; _cpc_dsym = 0;
    strcpy(#wface_lbl, "RATIO");
    cmp_anv_ratio < 0.5 ? strcpy(#wface_val, "20:1") : cmp_anv_ratio < 1.5 ? strcpy(#wface_val, "12:1") :
    cmp_anv_ratio < 2.5 ? strcpy(#wface_val, "8:1")  : cmp_anv_ratio < 3.5 ? strcpy(#wface_val, "4:1") :
    strcpy(#wface_val, "ALL");
  ) :
  ki == 2 ? (
    _nv = ssl_knob_interact(km, cx, cy, kr, cmp_anv_atk, 1, 7, 3, 0);
    _nv != cmp_anv_atk ? ( cmp_anv_atk = _nv; swing_comp_anvil_push(); mark_dirty_kit(); );
    _cpc_dv = cmp_anv_atk; _cpc_dmin = 1; _cpc_dmax = 7; _cpc_dsym = 0;
    strcpy(#wface_lbl, "ATTACK"); sprintf(#wface_val, "%.1f", cmp_anv_atk);
  ) :
  ki == 3 ? (
    _nv = ssl_knob_interact(km, cx, cy, kr, cmp_anv_rel, 1, 7, 5, 0);
    _nv != cmp_anv_rel ? ( cmp_anv_rel = _nv; swing_comp_anvil_push(); mark_dirty_kit(); );
    _cpc_dv = cmp_anv_rel; _cpc_dmin = 1; _cpc_dmax = 7; _cpc_dsym = 0;
    strcpy(#wface_lbl, "RELEASE"); sprintf(#wface_val, "%.1f", cmp_anv_rel);
  ) :
  ki == 4 ? (
    _nv = ssl_knob_interact(km, cx, cy, kr, cmp_anv_out, -24, 24, 0, 0);
    _nv != cmp_anv_out ? ( cmp_anv_out = _nv; swing_comp_anvil_push(); mark_dirty_kit(); );
    _cpc_dv = cmp_anv_out; _cpc_dmin = -24; _cpc_dmax = 24; _cpc_dsym = 1;
    strcpy(#wface_lbl, "OUTPUT"); sprintf(#wface_val, "%+.1fdB", cmp_anv_out);
  ) : (
    _nv = ssl_knob_interact(km, cx, cy, kr, cmp_anv_mix, 0, 1, 1, 0);
    _nv != cmp_anv_mix ? ( cmp_anv_mix = _nv; swing_comp_anvil_push(); mark_dirty_kit(); );
    _cpc_dv = cmp_anv_mix; _cpc_dmin = 0; _cpc_dmax = 1; _cpc_dsym = 0;
    strcpy(#wface_lbl, "MIX"); sprintf(#wface_val, "%.0f%%", cmp_anv_mix * 100);
  );
  dist(mx, my, cx, cy) <= kr ? (
    ki == 0 ? swing_tooltip_check(1410, "Input drive (-30 to +24 dB) into the FET. More drive, more limiting.") :
    ki == 1 ? swing_tooltip_check(1411, "Ratio switch: 20:1, 12:1, 8:1, 4:1, or ALL buttons in.") :
    ki == 2 ? swing_tooltip_check(1412, "Attack, 1 (slow) to 7 (fast), on Anvil's own dial.") :
    ki == 3 ? swing_tooltip_check(1413, "Release, 1 (slow) to 7 (fast), on Anvil's own dial.") :
    ki == 4 ? swing_tooltip_check(1414, "Output (-24 to +24 dB) after the circuit.") :
              swing_tooltip_check(1415, "Mix: dry to limited. 100% = the whole signal through the circuit.");
  );
);

// The selector: three chips in the header of the big view. A change is
// picked up by @block, which resets the incoming engine and pushes the
// controls; nothing here touches the audio thread.
function swing_panels_comp_voice_chips(x0, y0, cw, ch, gap) local(_hv) (
  // ⚠ While the audio-bus Weld is driving, the voice is NOT this page's to pick.
  // The compressor in circuit is the plugin the Drum Bus Options dialog put on
  // the folder, and only Weld can follow this link at all -- Anvil declares no
  // shared memory, so an Anvil on the bus could never be driven from here. A
  // live BLACK/BLUE chip would therefore change the page's face and the knob
  // set while the bus went on running Weld, and every knob the user then turned
  // would write a parameter nothing reads. So the chips REPORT instead, and the
  // link's first-sight adoption has already pulled the page to WELD to match.
  // ⭐ Delete these gates the day Weld carries the three voices itself (decided
  // 2026-09-20): the chips then become a voice post on the same mailbox.
  _hv = wface_btn_labeled(x0, y0, cw, ch, cmp_voice == 0, "WELD", "");
  _hv ? swing_tooltip_check(1416, "Master compressor voice: EON Weld, the console bus compressor.");
  _hv && lmb_down && !bcl_live && cmp_voice != 0 ? ( cmp_voice = 0; mark_dirty_kit(); );
  _hv = wface_btn_labeled(x0 + cw + gap, y0, cw, ch, cmp_voice == 1, "BLACK", "");
  _hv ? swing_tooltip_check(1417, bcl_live ?
        "The Audio bus is running EON Weld. Its rack is chosen when you build, in Drum Bus Options." :
        "Master compressor voice: EON Anvil, blackface (Rev D) FET limiting amp.");
  _hv && lmb_down && !bcl_live && cmp_voice != 1 ? ( cmp_voice = 1; mark_dirty_kit(); );
  _hv = wface_btn_labeled(x0 + 2 * (cw + gap), y0, cw, ch, cmp_voice == 2, "BLUE", "");
  _hv ? swing_tooltip_check(1418, bcl_live ?
        "The Audio bus is running EON Weld. Its rack is chosen when you build, in Drum Bus Options." :
        "Master compressor voice: EON Anvil, blue-stripe silverface (Rev A).");
  _hv && lmb_down && !bcl_live && cmp_voice != 2 ? ( cmp_voice = 2; mark_dirty_kit(); );
);

function swing_panels_draw_comp()
local(x, y, w, h, s, land, top, vu_r, vu_cx, vu_cy, vu_bot, vg, sep1, sep2, ky1, ky2, kr,
      ki, kcx, kcy, km, kp, bw, bh, bx, ax, by, hv, tw, th, face, lx, lw, rx, rw, colw, rowh) (
  x = _lcd_cx; y = _lcd_cy; w = _lcd_cw; h = _lcd_ch;
  land = h < 240;   // the LCD canvas is 108 tall; any big view is taller -- absolute, so a wide window never flips the big view into the LCD layout
  s = land ? max(0.5, min(w / 420, h / 140)) : max(0.6, min(w / 420, h / 700));
  wface_palette();
  // The plate follows the voice: Weld's console grey, Anvil's blackface, or
  // the blue-stripe silverface -- dark text on the silver, blue for the dim.
  cmp_voice == 1 ? (
    wface_bg_r = 0.135; wface_bg_g = 0.135; wface_bg_b = 0.145;
    wface_pn_r = 0.095; wface_pn_g = 0.095; wface_pn_b = 0.105;
  ) : cmp_voice == 2 ? (
    wface_bg_r = 0.640; wface_bg_g = 0.655; wface_bg_b = 0.675;
    wface_pn_r = 0.520; wface_pn_g = 0.540; wface_pn_b = 0.570;
    wface_tx_r = 0.110; wface_tx_g = 0.120; wface_tx_b = 0.140;
    wface_td_r = 0.200; wface_td_g = 0.260; wface_td_b = 0.480;
  );
  wface_sc = s;
  kp = big_view_id == VIEW_COMP ? km_comp : km_comp + 6 * KS;   // per-surface knob memory
  face = swing_vu_style >= 0 ? swing_vu_style : 0;               // header selector, else Weld's cream

  // ── the plate ──
  gfx_set(wface_bg_r, wface_bg_g, wface_bg_b, 1); gfx_rect(x, y, w, h);
  // rack screws: in the corners; the LCD card tucks them tighter so they stay
  // clear of the wordmark and the IN lamp
  kr = land ? 5 : floor(8 * s);
  wface_screw(x + kr,     y + kr,     max(2, floor((land ? 3 : 4) * s)));
  wface_screw(x + w - kr, y + kr,     max(2, floor((land ? 3 : 4) * s)));
  wface_screw(x + kr,     y + h - kr, max(2, floor((land ? 3 : 4) * s)));
  wface_screw(x + w - kr, y + h - kr, max(2, floor((land ? 3 : 4) * s)));

  !land ? (
    // ── PORTRAIT: Weld's floating stack, scaled to the big view ──
    rk_font(3, max(14, floor(26 * s)), 'b');
    gfx_set(wface_tx_r, wface_tx_g, wface_tx_b, 1);
    gfx_x = x + floor(16 * s); gfx_y = y + floor(5 * s);
    gfx_drawstr(cmp_voice > 0 ? "EON ANVIL" : "EON WELD");
    rk_font(4, max(10, floor(13 * s)), 0);
    gfx_set(wface_td_r, wface_td_g, wface_td_b, 0.9);
    gfx_drawstr(cmp_voice == 0 ? "  BUS COMPRESSOR" : cmp_voice == 1 ? "  FET LIMITING AMP  ·  BLACKFACE" : "  FET LIMITING AMP  ·  BLUE STRIPE");
    // Where the needle's reading comes from. In Multi-Out the compressor doing
    // the work is the Weld on the Audio folder, and the GR arc above is its
    // reduction, not this page's -- say so, or the meter is an unattributed
    // number. Same accent EON Output uses for "linked to Swing", so the suite
    // states the relationship the same way wherever it appears. Reads
    // "DRIVING" once this page can push values back (step 4); today it only
    // listens, and the label says only that.
    bcl_live ? (
      gfx_set(0.35, 0.80, 0.84, 0.95);
      gfx_drawstr("   ·  GR: AUDIO BUS");
    ) : bcl_foreign ? (
      // A compressor is on the folder that cannot follow this page — a stock
      // one, an FX chain, an Anvil, or something dropped in by hand. This page
      // is not driving it and has no reading to borrow from it, so say both.
      // Swing's own compressor is out of circuit here too: in Multi-Out it only
      // ever reached the pad on OUT 1, so leaving it in would be a second,
      // hidden compressor on one drum.
      gfx_set(0.85, 0.55, 0.15, 0.95);
      gfx_drawstr("   ·  AUDIO BUS COMP: NOT LINKED");
    );
    // voice chips on their own row under the wordmark -- WELD · BLACK · BLUE --
    // clear of the subtitle, which in the Anvil voices runs most of the width.
    // The header grows by the row; everything below reflows through vg.
    swing_panels_comp_voice_chips(x + floor(16 * s), y + floor(34 * s),
                                  floor(46 * s), floor(17 * s), floor(4 * s));
    top = floor(56 * s);
    vu_r  = floor(96 * s);
    vu_cx = x + w * 0.5;
    vu_cy = y + top + floor(8 * s) + vu_r * 1.4;
    vu_bot = vu_cy + vu_r * 0.3;
    kr  = floor(30 * s);
    // 176 (was 112): the limiter row lives under the IN / AUTO buttons.
    vg = max(0.85, min(2.75, (h - floor(176 * s) - (vu_bot - y)) / (329 * s)));
    sep1 = vu_bot + floor(39 * s * vg);
    ky1 = sep1 + floor(76 * s * vg);
    ky2 = ky1 + floor(150 * s * vg);
    sep2 = ky2 + kr + floor(52 * s * vg);

    rk_vu_theme(face);
    rk_vu_pal_rgb(2, wface_bg_r, wface_bg_g, wface_bg_b);
    cmp_vu.rk_vu_draw_at(vu_cx, vu_cy, vu_r, 1, -1, "GR");
    sprintf(#wface_val, "%.1f dB GR", cmp_vu.pos > 0.05 ? -cmp_vu.pos : 0);
    wface_readout(vu_cx, vu_bot + floor(9 * s), floor(min(110 * s, w - 20)), floor(18 * s),
                  0.82, 0.68, 0.40);
    wface_sep(x, sep1, w);

    ki = 0;
    loop(6,
      kcx = x + (w / 3) * (ki % 3) + (w / 6);
      kcy = ki < 3 ? ky1 : ky2;
      km = kp + ki * KS;
      cmp_voice > 0 ? swing_panels_anvil_knob(ki, kcx, kcy, kr, km) : swing_panels_comp_knob(ki, kcx, kcy, kr, km);
      wface_knob_cell(ki, kcx, kcy, kr, _cpc_dv, _cpc_dmin, _cpc_dmax, _cpc_dsym, km[0]);
      ki += 1;
    );

    wface_sep(x, sep2, w);
    bw = floor(74 * s); bh = floor(46 * s);
    bx = x + w * 0.5 - bw - floor(17 * s);
    ax = x + w * 0.5 + floor(17 * s);
    by = sep2 + floor(12 * s * vg);
  ) : (
    // ── LANDSCAPE: the LCD card. Meter + buttons left, 2x3 knobs right ──
    lx = x + floor(6 * s); lw = floor(w * 0.40);
    rx = x + lw + floor(10 * s); rw = w - lw - floor(14 * s);
    rk_font(3, max(8, floor(11 * s)), 'b');
    gfx_set(wface_tx_r, wface_tx_g, wface_tx_b, 1);
    gfx_x = lx + floor(14 * s); gfx_y = y + floor(3 * s);
    gfx_drawstr(cmp_voice > 0 ? "EON ANVIL" : "EON WELD");
    // voice chip after the name: click cycles Weld -> Anvil Black -> Anvil Blue.
    // Placed from a MEASURED name width, not the pen position, and a full
    // 12*s clear of it -- live it was clipping the wordmark's last letter.
    gfx_measurestr(cmp_voice > 0 ? "EON ANVIL" : "EON WELD", tw, th);
    bx = lx + floor(14 * s) + tw + floor(12 * s); by = y + floor(2 * s); bw = floor(28 * s); bh = max(10, floor(12 * s));
    hv = wface_btn_labeled(bx, by, bw, bh, cmp_voice > 0, cmp_voice == 0 ? "W" : cmp_voice == 1 ? "BLK" : "BLU", "");
    hv ? swing_tooltip_check(1420, bcl_live ?
         "The Audio bus is running EON Weld. Its rack is chosen when you build, in Drum Bus Options." :
         "Master compressor voice. Click to cycle: Weld, Anvil Black, Anvil Blue.");
    // Inert while the bus Weld is driving — same reason as the header chips.
    hv && lmb_down && !bcl_live ? ( cmp_voice = (cmp_voice + 1) % 3; mark_dirty_kit(); );
    // LIM chip: the master limiter in / out. Ceiling and release are in the
    // big view (Shift+click the COMP tab); the card has no room for two knobs.
    bx += bw + floor(6 * s);
    hv = wface_btn_labeled(bx, by, bw, bh, gfx_lim_on, "LIM", "");
    hv ? swing_tooltip_check(1421, "Master limiter in / out -- the brickwall after the compressor. Ceiling and release live in the big view.");
    hv && lmb_down ? ( gfx_lim_on = !gfx_lim_on; mark_dirty_kit(); );
    vu_r  = max(16, floor(min(lw / 2.7, h * 0.30)));
    vu_cx = lx + lw * 0.5;
    vu_cy = y + floor(14 * s) + vu_r * 1.4;
    vu_bot = vu_cy + vu_r * 0.3;
    rk_vu_theme(face);
    rk_vu_pal_rgb(2, wface_bg_r, wface_bg_g, wface_bg_b);
    cmp_vu.rk_vu_draw_at(vu_cx, vu_cy, vu_r, 1, -1, "GR");
    sprintf(#wface_val, "%.1f dB GR", cmp_vu.pos > 0.05 ? -cmp_vu.pos : 0);
    wface_readout(vu_cx, vu_bot + floor(3 * s), floor(min(80 * s, lw - 8)), max(10, floor(12 * s)),
                  0.82, 0.68, 0.40);
    bw = max(28, floor(lw * 0.36)); bh = max(14, floor(18 * s));
    bw = min(bw, floor((lw - floor(30 * s)) * 0.5) - floor(6 * s));   // two caps + lamps inside lw
    bx = lx + floor(22 * s);                 // the lamp sits 8*s left of the cap: clear of the screw
    ax = bx + bw + floor(14 * s);
    by = y + h - bh - floor(4 * s);

    colw = rw / 3; rowh = h / 2;
    kr = max(8, floor(min(colw * 0.30, rowh * 0.25)));
    ki = 0;
    loop(6,
      kcx = rx + colw * (ki % 3) + colw * 0.5;
      kcy = y + rowh * ((ki / 3) | 0) + floor(rowh * 0.50);
      km = kp + ki * KS;
      cmp_voice > 0 ? swing_panels_anvil_knob(ki, kcx, kcy, kr, km) : swing_panels_comp_knob(ki, kcx, kcy, kr, km);
      wface_knob_cap(ki);
      rk_knob_draw(21, kcx, kcy, kr, _cpc_dv, _cpc_dmin, _cpc_dmax, _cpc_dsym, km[0],
                   sk_kbr, sk_kbg, sk_kbb, 0, wface_bg_r, wface_bg_g, wface_bg_b);
      // short label above, value window below: the strip's embed grammar
      rk_font(5, max(7, floor(8 * s)), 'b');
      gfx_set(wface_tx_r, wface_tx_g, wface_tx_b, 0.95);
      cmp_voice > 0 ? (
        ki == 0 ? strcpy(#wface_lbl, "IN")  : ki == 1 ? strcpy(#wface_lbl, "RAT") :
        ki == 2 ? strcpy(#wface_lbl, "ATK") : ki == 3 ? strcpy(#wface_lbl, "REL") :
        ki == 4 ? strcpy(#wface_lbl, "OUT") :            strcpy(#wface_lbl, "MIX");
      ) : (
        ki == 0 ? strcpy(#wface_lbl, "THR") : ki == 1 ? strcpy(#wface_lbl, "RAT") :
        ki == 2 ? strcpy(#wface_lbl, "ATK") : ki == 3 ? strcpy(#wface_lbl, "REL") :
        ki == 4 ? strcpy(#wface_lbl, "MKP") :            strcpy(#wface_lbl, "MIX");
      );
      gfx_measurestr(#wface_lbl, tw, th);
      gfx_x = kcx - tw * 0.5; gfx_y = kcy - kr - th - floor(1 * s);
      gfx_drawstr(#wface_lbl);
      wface_readout(kcx, kcy + kr + floor(2 * s), floor(colw * 0.86), max(9, floor(11 * s)),
                    wface_ac_r, wface_ac_g, wface_ac_b);
      ki += 1;
    );
  );

  // ── IN / AUTO, both layouts ──
  hv = wface_btn_labeled(bx, by, bw, bh, !cmp_bypass, "IN", land ? "" : "COMP");
  hv ? swing_tooltip_check(1400, "IN: the compressor is in circuit. Out = bypassed, and the engine rests clean.");
  hv && lmb_down ? ( cmp_bypass = !cmp_bypass; mark_dirty_kit(); );
  cmp_voice == 0 ? (
    hv = wface_btn_labeled(ax, by, bw, bh, cmp_auto, "AUTO", land ? "" : "RELEASE");
    hv ? swing_tooltip_check(1405, "AUTO release: the programme-dependent dual-RC recovery owns the release; the RELEASE knob rests.");
    hv && lmb_down ? ( cmp_auto = !cmp_auto; swing_rcp_post_cmp(); mark_dirty_kit(); );
  ) : (
    // Anvil has no auto release; the slot shows the voice instead of a dead lamp
    hv = wface_btn_labeled(ax, by, bw, bh, 1, cmp_voice == 1 ? "BLK" : "BLU", land ? "" : "VOICE");
    hv ? swing_tooltip_check(1419, "Anvil voice in circuit. Change it with the chips in the header.");
  );

  // ── LIMITER (big view only): Swing's master-bus brickwall, the last stage
  // after the compressor. It ran with no controls from day one (in, 0 dBFS,
  // 100 ms); these are them. EON Output on the Audio bus follows them in
  // Multi-Out. State lives in gfx_lim_on / gfx_lim_thr (linear) / gfx_lim_rel,
  // saved with the kit; @block derives the release coefficient on change.
  !land ? (
    _lm_y = by + bh + floor(10 * s * vg);
    wface_sep(x, _lm_y, w);
    rk_font(4, max(9, floor(11 * s)), 'b');
    gfx_set(wface_td_r, wface_td_g, wface_td_b, 0.9);
    gfx_x = x + floor(16 * s); gfx_y = _lm_y + floor(8 * s); gfx_drawstr("LIMITER");
    rk_font(5, max(8, floor(9 * s)), 0);
    gfx_set(wface_td_r, wface_td_g, wface_td_b, 0.7);
    gfx_x = x + floor(16 * s); gfx_y = _lm_y + floor(24 * s); gfx_drawstr("brickwall, after the comp");
    // IN
    hv = wface_btn_labeled(x + floor(16 * s), _lm_y + floor(40 * s), floor(44 * s), floor(18 * s), gfx_lim_on, "IN", "");
    hv ? swing_tooltip_check(1421, "Master limiter in circuit: peaks never pass the ceiling. Out = bypassed.");
    hv && lmb_down ? ( gfx_lim_on = !gfx_lim_on; mark_dirty_kit(); );
    // CEILING: the knob speaks dB, the engine keeps it linear
    _lm_kr = floor(17 * s);
    _lm_cy = _lm_y + floor(38 * s);
    _lm_cx = x + w * 0.45;
    _lm_db = 20 * log10(max(0.001, gfx_lim_thr));
    _lm_nv = ssl_knob_interact(km_lim_thr, _lm_cx, _lm_cy, _lm_kr, _lm_db, -12, 0, 0, 0);
    _lm_nv != _lm_db ? ( gfx_lim_thr = pow(10, _lm_nv / 20); mark_dirty_kit(); );
    wface_knob_cap(4);
    rk_knob_draw(21, _lm_cx, _lm_cy, _lm_kr, _lm_db, -12, 0, 0, km_lim_thr[0],
                 sk_kbr, sk_kbg, sk_kbb, 0, wface_bg_r, wface_bg_g, wface_bg_b);
    dist(mx, my, _lm_cx, _lm_cy) <= _lm_kr + 4 ? swing_tooltip_check(1422, "Ceiling: 0 to -12 dBFS. Nothing passes it. Double-click resets to 0.");
    rk_font(5, max(7, floor(8 * s)), 'b');
    gfx_set(wface_tx_r, wface_tx_g, wface_tx_b, 0.95);
    strcpy(#wface_lbl, "CEILING"); gfx_measurestr(#wface_lbl, tw, th);
    gfx_x = _lm_cx - tw * 0.5; gfx_y = _lm_cy - _lm_kr - th - floor(1 * s); gfx_drawstr(#wface_lbl);
    sprintf(#wface_val, "%+.1f dB", _lm_db);
    wface_readout(_lm_cx, _lm_cy + _lm_kr + floor(2 * s), floor(60 * s), max(9, floor(11 * s)), wface_ac_r, wface_ac_g, wface_ac_b);
    // RELEASE: 10 ms .. 1 s, log
    _lm_cx2 = x + w * 0.70;
    _lm_t = log(max(10, min(1000, gfx_lim_rel)) / 10) / log(100);
    _lm_nt = ssl_knob_interact(km_lim_rel, _lm_cx2, _lm_cy, _lm_kr, _lm_t, 0, 1, 0.5, 0);
    _lm_nt != _lm_t ? ( gfx_lim_rel = floor(10 * pow(100, max(0, min(1, _lm_nt))) + 0.5); mark_dirty_kit(); );
    wface_knob_cap(3);
    rk_knob_draw(21, _lm_cx2, _lm_cy, _lm_kr, _lm_nt, 0, 1, 0, km_lim_rel[0],
                 sk_kbr, sk_kbg, sk_kbb, 0, wface_bg_r, wface_bg_g, wface_bg_b);
    dist(mx, my, _lm_cx2, _lm_cy) <= _lm_kr + 4 ? swing_tooltip_check(1423, "Release: how fast the limiter lets go after a peak, 10 ms to 1 s. Double-click resets to 100 ms.");
    rk_font(5, max(7, floor(8 * s)), 'b');
    gfx_set(wface_tx_r, wface_tx_g, wface_tx_b, 0.95);
    strcpy(#wface_lbl, "RELEASE"); gfx_measurestr(#wface_lbl, tw, th);
    gfx_x = _lm_cx2 - tw * 0.5; gfx_y = _lm_cy - _lm_kr - th - floor(1 * s); gfx_drawstr(#wface_lbl);
    sprintf(#wface_val, "%d ms", gfx_lim_rel);
    wface_readout(_lm_cx2, _lm_cy + _lm_kr + floor(2 * s), floor(60 * s), max(9, floor(11 * s)), wface_ac_r, wface_ac_g, wface_ac_b);
    // GR: the frame's deepest dip, right of the knobs
    _lm_gr = 20 * log10(max(0.001, gfx_lim_gr_seen));   // the frame's dip as @gfx found it, kept before the reset (sweep LIB141)
    sprintf(#wface_val, "%.1f dB", gfx_lim_on && _lm_gr < -0.05 ? _lm_gr : 0);
    wface_readout(x + w - floor(44 * s), _lm_cy - floor(6 * s), floor(56 * s), max(9, floor(12 * s)), 0.82, 0.68, 0.40);
    rk_font(5, max(7, floor(8 * s)), 'b');
    gfx_set(wface_td_r, wface_td_g, wface_td_b, 0.8);
    strcpy(#wface_lbl, "GR"); gfx_measurestr(#wface_lbl, tw, th);
    gfx_x = x + w - floor(44 * s) - tw * 0.5; gfx_y = _lm_cy - floor(6 * s) - th - floor(2 * s); gfx_drawstr(#wface_lbl);
  );

  rk_font(1, 9, 'b');   // hand the LCD its font back (Arial 9 bold)
);

// ── Full-size EQ big view — scale-up of the compact EQ curve editor ────────
// Re-points the LCD content rect (_lcd_c* + _lcd_mid_y) at the pad-grid rect
// and calls swing_panels_draw_eq(), which is already a draggable-node graph.
// Same modal pattern as swing_panels_draw_mixer_big (restore _ov_* mouse →
// draw → close → re-zero). Big View framework: VIEW_EQ.
function swing_panels_draw_eq_big()
local(sx, sy, sw, sh, smy, chov, out) (
  lmb_down = _ov_lmb_down; rmb_down = _ov_rmb_down;
  LMB = _ov_LMB; RMB = _ov_RMB; frame_wheel = _ov_wheel;

  gfx_set(0, 0, 0, 0.45);
  gfx_rect(0, 28, gfx_w, gfx_h - 28);
  gfx_set(0.05, 0.045, 0.035, 0.98);
  gfx_rect(grid_x, grid_y, grid_w, grid_h);
  gfx_set(0.85, 0.65, 0.25, 0.5);
  gfx_rect(grid_x, grid_y, grid_w, 1);
  gfx_rect(grid_x, grid_y + grid_h - 1, grid_w, 1);
  gfx_rect(grid_x, grid_y, 1, grid_h);
  gfx_rect(grid_x + grid_w - 1, grid_y, 1, grid_h);

  rk_font(1, 12, 'b');
  gfx_set(0.92, 0.75, 0.4, 0.95);
  gfx_x = grid_x + 8; gfx_y = grid_y + 4; gfx_drawstr("EQ");
  _eqb_cx = grid_x + grid_w - 20; _eqb_cy = grid_y + 3;
  chov = mx >= _eqb_cx - 3 && mx <= _eqb_cx + 17 && my >= _eqb_cy - 2 && my <= _eqb_cy + 15;
  rk_font(1, 13, 'b');
  gfx_set(1, 1, 1, chov ? 0.95 : 0.55);
  gfx_x = _eqb_cx + 3; gfx_y = _eqb_cy; gfx_drawstr("X");

  // re-point the LCD content rect at the big rect, draw the curve editor, restore
  sx = _lcd_cx; sy = _lcd_cy; sw = _lcd_cw; sh = _lcd_ch; smy = _lcd_mid_y;
  _lcd_cx = grid_x + 14; _lcd_cy = grid_y + 26;
  _lcd_cw = grid_w - 28; _lcd_ch = grid_h - 40;
  _lcd_mid_y = _lcd_cy + _lcd_ch / 2;
  swing_panels_draw_eq();
  _lcd_cx = sx; _lcd_cy = sy; _lcd_cw = sw; _lcd_ch = sh; _lcd_mid_y = smy;

  out = mx < grid_x || mx > grid_x + grid_w || my < grid_y || my > grid_y + grid_h;
  lmb_down && (chov || (out && active_id == -1)) ? (
    swing_bigview_close();
    active_id = -1;
  );

  lmb_down = 0; rmb_down = 0; LMB = 0; RMB = 0; frame_wheel = 0;
);

// ── Full-size DLY / RVB / COMP big views — scale-up of the compact FX pages ─
// Same pattern as swing_panels_draw_eq_big. mode = the compact lcd_mode
// (2=delay 3=reverb 5=comp); each compact page lays out from _lcd_c*, so
// re-pointing the rect scales it up.
function swing_panels_draw_fx_big(mode)
local(sx, sy, sw, sh, smy, chov, out) (
  lmb_down = _ov_lmb_down; rmb_down = _ov_rmb_down;
  LMB = _ov_LMB; RMB = _ov_RMB; frame_wheel = _ov_wheel;

  gfx_set(0, 0, 0, 0.45);
  gfx_rect(0, 28, gfx_w, gfx_h - 28);
  gfx_set(0.045, 0.05, 0.065, 0.98);
  gfx_rect(grid_x, grid_y, grid_w, grid_h);
  gfx_set(0.35, 0.55, 0.80, 0.5);
  gfx_rect(grid_x, grid_y, grid_w, 1);
  gfx_rect(grid_x, grid_y + grid_h - 1, grid_w, 1);
  gfx_rect(grid_x, grid_y, 1, grid_h);
  gfx_rect(grid_x + grid_w - 1, grid_y, 1, grid_h);

  rk_font(1, 12, 'b');
  gfx_set(0.65, 0.78, 0.95, 0.95);
  gfx_x = grid_x + 8; gfx_y = grid_y + 4;
  mode == 2 ? gfx_drawstr("DELAY") : mode == 3 ? gfx_drawstr("REVERB") : gfx_drawstr("COMPRESSOR");
  _eqb_cx = grid_x + grid_w - 20; _eqb_cy = grid_y + 3;
  chov = mx >= _eqb_cx - 3 && mx <= _eqb_cx + 17 && my >= _eqb_cy - 2 && my <= _eqb_cy + 15;
  rk_font(1, 13, 'b');
  gfx_set(1, 1, 1, chov ? 0.95 : 0.55);
  gfx_x = _eqb_cx + 3; gfx_y = _eqb_cy; gfx_drawstr("X");

  sx = _lcd_cx; sy = _lcd_cy; sw = _lcd_cw; sh = _lcd_ch; smy = _lcd_mid_y;
  _lcd_cx = grid_x + 14; _lcd_cy = grid_y + 26;
  _lcd_cw = grid_w - 28; _lcd_ch = grid_h - 40;
  _lcd_mid_y = _lcd_cy + _lcd_ch / 2;
  mode == 2 ? swing_panels_draw_delay() : mode == 3 ? swing_panels_draw_reverb() : swing_panels_draw_comp();
  _lcd_cx = sx; _lcd_cy = sy; _lcd_cw = sw; _lcd_ch = sh; _lcd_mid_y = smy;

  out = mx < grid_x || mx > grid_x + grid_w || my < grid_y || my > grid_y + grid_h;
  lmb_down && (chov || (out && active_id == -1)) ? (
    swing_bigview_close();
    active_id = -1;
  );

  lmb_down = 0; rmb_down = 0; LMB = 0; RMB = 0; frame_wheel = 0;
);
