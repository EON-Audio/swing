@init
__knobs_kbsg_loaded = 1;

// knobs_kbsg.jsfx-inc — EON Studios Knob Library (ReaKit) (21 Styles)
// ═══════════════════════════════════════════════════════════════════════════
// Style ids — the numbers rk_knob_draw / rk_knob_interact dispatch on. This is
// a copy of the dispatcher enum at the foot of this file; that enum is the
// source, and the two must say the same thing:
//   1  SSL 4000E        — ssl_knob_draw: light fluted skirt, big colour cap, painted bar
//                         (also what 0 / an unknown id falls back to)
//   2  Vari-Mu          — varimu_knob_draw: the Manley bar knob, white line, printed scale
//   3  API 550A         — api_knob_draw: white fin knob, blue collar (the accent), grey cap
//   4  Witti Sound      — ws_knob_draw: clean arc, dot indicator
//   5  Neve 1073        — neve_knob_draw: blue body, full-diameter wedge stripe, detents
//   6  Joanny/McFizz    — jo_knob_draw: blue pot, 4-pass shadow, box hover
//   7  MPC Rubber Pad   — mpc_knob_draw: accent-tinted rubber dome, white indicator, 260° arc
//   8  Jog Wheel        — jog_knob_draw: iMPC-style metallic jog with grip notches
//   9  Rainbow Arc      — rainbow_knob_draw: house-colour cycling arc, rimmed body, pointer
//  10  Spice Pro        — sp_knob_draw: themed arc fill (value heat + glow), sweep needle
//  11  Encoder          — encoder_draw: X-Touch Mini style 13-bar LED collar, no pointer
//  12  Pultec EQP-1A    — pultec_knob_draw: black bakelite, ridged wall, silver-white pointer
//  13  Ableton Live     — ableton_knob_draw: the Live 12 dial, thick arc band, dark needle
//  14  FL Studio        — fl_knob_draw: dark body, accent dot pointer
//  15  Pro Tools        — pt_knob_draw: very dark knurled cap, near-black pointer
//  16  FabFilter        — fabfilter_knob_draw: the Pro-G knob, dome, white scoop, tick channel
//  17  Serum            — serum_knob_draw: beveled body, glow arc, pointer + dot
//  18  Roland 808/909   — roland_knob_draw: colored plastic cap, knurled edge, white pointer
//  19  Pultec cream     — pultec_cream_knob_draw: Tube-Tech PE 1C, cream body, black pointer
//  20  Neve Alt         — neve_alt_knob_draw: Heritage i73 concentric ring + satin dome
//  21  SSL G            — sslg_knob_draw: fluted silver SSL-G console knob
// The ids are persisted (ExtState eon_knob_<theme>): APPEND ONLY, never renumber.
//
// Drawn by name, not through the dispatcher: bb_knob_draw (BirdBird),
// rotsel_knob_draw (stepped chicken-head selector, own interact rotsel_interact,
// pos = integer 0..n-1), api_ring_draw / api_dual_interact (drag=gain, scroll=freq).
//
// REQUIRED GLOBALS (set by caller each frame):
//   mx, my        — mouse_x, mouse_y
//   LMB           — mouse_cap & 1
//   lmb_down      — LMB && !prev_LMB (edge detect, computed ONCE per frame)
//   rmb_down      — RMB && !prev_RMB (right-click resets to vdefault)
//
// MODIFIER CONVENTION — every interact in this file, without exception:
//   plain drag  = coarse      wheel = 2% of range per tick
//   CTRL        = fine (0.1x) wheel = 0.5%
//   SHIFT       = extra-fine  wheel = 0.2%
// A knob that learns differently from its neighbour is the complaint this
// convention exists to prevent, so a new interact copies it rather than
// inventing a sensitivity. (Stepped wheels — detents, rotary selectors —
// move one position per tick and take no modifier.)
//   CTRL          — mouse_cap & 4
//   SHIFT         — mouse_cap & 8
//   dt            — frame delta time
//   hv_speed      — hover animation speed (typ. 11)
//   frame_wheel   — mouse_wheel / 120 (caller zeroes mouse_wheel after).
//                   A hovered widget that applies a notch zeroes frame_wheel
//                   (consumed), as the sliders, buttons, colour strip and curve
//                   already do, so one notch cannot also turn the widget whose
//                   rect sits under it (2026-10-14). The caller still owns
//                   mouse_wheel; nothing here touches it.
//   tau           — 2 * $pi
//   _srf_foreign  — OPTIONAL, 0 unless the host runs one instance on two
//                   surfaces at once. A host that embeds a face in both the
//                   TCP and the MCP must keep a drag alive on the surface the
//                   pointer is NOT over, which it does by handing that pass the
//                   owner's held LMB and pointer; otherwise the drag dies the
//                   moment the unhovered pass sees LMB 0. But the drag maths
//                   here divides by the CALLER'S radius, so the foreign pass
//                   computes a different value from the same gesture and the
//                   two alternate, frame by frame, while the button is held
//                   (measured: 0.6747 vs 0.7000 on 277x462 against 82x137).
//                   Set this on the foreign pass and every continue-drag branch
//                   below returns cur_val untouched, while the press latch and
//                   the drag state survive. Unset reads 0 in EEL2, so a host
//                   that never sets it behaves exactly as before.
//
// MEMORY CONVENTION (16 slots per instance):
//   [0]  hover_t        [1]  is_dragging (2 = pressed, still in the deadzone; 1 = dragging)
//   [2]  drag_y / start_y
//   [3]  drag_start_val [4]  last_click_time  [5]  automate_flag
//   [6]  is_active      [7]  aux_value        [8..15] type-specific
//
// Rainbow Arc extra: [8]=run time  [9..11]=colour state
// Joanny extra:    [8]=hasEntered (canChange gate)
//
// INTERACT RETURN: new slider value. Caller checks change, calls sliderchange/automate.
// ═══════════════════════════════════════════════════════════════════════════


// ─────────────────────────────────────────────────────────────────────────
// UTILITIES
// ─────────────────────────────────────────────────────────────────────────
function clamp(x, lo, hi) ( min(max(x, lo), hi); );
function lerp(a, b, t) ( a + (b - a) * t; );
function dist(x1, y1, x2, y2) ( sqrt((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1)); );
function sign_of(x) ( x < 0 ? -1 : x > 0 ? 1 : 0; );

// Double-click window, in seconds. A host may override this in its own @init
// (which runs after every import) to retune reset-on-double-click for all
// knobs and sliders at once.
RK_DBLCLICK_T = 0.3;

// The caller contract above says the host supplies tau, and most do -- but three hosts of
// the SAME knob memory (EON_Drum_Strip, EON_Output, EON_StepSeq) never did, and there the
// Roland knurl collapsed to one notch and the Spice knob froze at 6 o'clock (sweep LIB11,
// 2026-10-26: both styles read tau, and an unset EEL2 global is 0). The library seeds it;
// a host's own @init (which runs after every import) may still set it.
tau = 2 * $pi;

// The modifier pair as one number, for the drag re-anchor in every interact
// that scales its WHOLE travel from the press (sp, ws, ssl, api_dual, encoder;
// bb and jo move per frame and need none). Scaling the whole travel by the
// CURRENT modifier made the value jump when CTRL or SHIFT changed mid-drag:
// 0.7 to 0.52 on the press, back to 0.7 on the release, with the pointer
// still (the 2026-09-20 widget audit). So a drag restarts from the pointer
// and the value of the moment the modifiers change, and the new sensitivity
// applies to the travel from there. One global suffices: one pointer, one
// drag at a time, and the foreign surface pass never reaches the maths.
function rk_drag_mods() ( (CTRL ? 1 : 0) + (SHIFT ? 2 : 0); );

// Drag deadzone, in pixels. A press puts a knob in mem[1] = 2 (pressed); the
// value only starts moving once the pointer has travelled this far, so a click
// to focus, or the first half of a double-click, never nudges it. A host may
// override it in its own @init.
RK_DRAG_DEADZONE = 3;

// Hide the cursor while a knob is dragged: REAPER 7.83+ hides it ("knob mode")
// when @gfx sets mouse_cap's 65536 bit. This lib sets it on every frame of a
// drag, as REAPER's own chmaha plugins do, and REAPER writes mouse_cap afresh
// before each frame, so the bit is gone once the drag ends. Only once the drag has left the
// deadzone, so a plain click never hides it. Older REAPER ignores the bit. A host
// may set this to 0 in its @init to keep the cursor. Test mouse_cap with &, never
// == or !=, after a knob call: the bit is in it for the rest of the frame.
RK_HIDE_CURSOR = 1;

// Every knob's drag goes through here, each frame, after its press set mem[1] = 2
// and mem[2] = the press's y. `held` is the caller's own button test (with its
// !_srf_foreign where it has one). Leaving the deadzone re-anchors the drag on
// the pointer of that moment, so the value does not jump by the deadzone. Returns
// 1 while the drag is live (mem[1] = 1 and held), and hides the cursor then.
function rk_drag_live(mem, held, cur_val) (
  mem[1] == 2 && held && abs(my - mem[2]) > RK_DRAG_DEADZONE ? (
    mem[1] = 1; mem[2] = my; mem[3] = cur_val; _rk_drag_mod = rk_drag_mods();
  );
  mem[1] == 1 && held ? ( RK_HIDE_CURSOR ? (mouse_cap |= 65536); 1; ) : 0;
);


// ═══════════════════════════════════════════════════════════════════════════
// SHARED DRAWING HELPERS — SSL, Encoder, Ableton, FabFilter, FL Studio, Pro Tools, API, Vari-Mu
// ═══════════════════════════════════════════════════════════════════════════
// Up here, before every style, because EEL2 needs a function defined before any
// function that calls it.

// Thick radial line r0..r1 at clock angle a (0 = up, +CW), width w: a filled quad
// with anti-aliased long edges, in the current colour.
function rk_kn_ray(cx, cy, a, r0, r1, w)
local(ux, uy, px, py, h, x0, y0, x1, y1)
(
  ux = sin(a); uy = -cos(a);
  px = -uy; py = ux;
  h = w * 0.5;
  x0 = cx + ux * r0; y0 = cy + uy * r0;
  x1 = cx + ux * r1; y1 = cy + uy * r1;
  gfx_triangle(x0 + px * h, y0 + py * h, x1 + px * h, y1 + py * h,
               x1 - px * h, y1 - py * h, x0 - px * h, y0 - py * h);
  gfx_line(x0 + px * (h - 0.5), y0 + py * (h - 0.5), x1 + px * (h - 0.5), y1 + py * (h - 0.5), 1);
  gfx_line(x0 - px * (h - 0.5), y0 - py * (h - 0.5), x1 - px * (h - 0.5), y1 - py * (h - 0.5), 1);
);

// Filled annular band r_in..r_out between clock angles a1 < a2 (stacked 1 px arcs,
// so the ends are cut square), in the current colour.
function rk_kn_band(cx, cy, r_in, r_out, a1, a2)
local(rr)
(
  a2 > a1 ? (
    rr = r_out - 0.5;
    while (rr >= r_in + 0.5) ( gfx_arc(cx, cy, rr, a1, a2, 1); rr -= 0.6; );
    gfx_arc(cx, cy, r_in + 0.5, a1, a2, 1);
  );
);

// Fill disc(cx,cy,dd) ∩ disc(lcx,lcy,rho) in the current colour. Two discs make a
// convex lens, so every pixel row crosses it in ONE span: exact, row by row. (A
// triangle fan left a flat sliver at the lens tip.)
function rk_kn_lens(cx, cy, dd, lcx, lcy, rho)
local(i, y, dy0, dy1, hw, f, x0, x1)
(
  i = floor(max(cy - dd, lcy - rho));
  while (i <= min(cy + dd, lcy + rho)) (
    y = i + 0.5;
    dy0 = y - cy; dy1 = y - lcy;
    abs(dy0) < dd && abs(dy1) < rho ? (
      hw = sqrt(dd * dd - dy0 * dy0); f = sqrt(rho * rho - dy1 * dy1);
      x0 = max(cx - hw, lcx - f); x1 = min(cx + hw, lcx + f);
      x1 > x0 + 0.25 ? gfx_rect(floor(x0 + 0.5), i, max(1, floor(x1 + 0.5) - floor(x0 + 0.5)), 1);
    );
    i += 1;
  );
);

// A disc filled row by row with a vertical gradient: (tr,tg,tb) at the top to
// (br,bg_,bb) at the bottom. Its edge is left to an anti-aliased circle drawn after.
// Both ends of a row are rounded from the circle (2026-09-25; it used to round the
// left end and the width separately, so a row's right end could stop a pixel short
// and the right edge stair-stepped where an outline could not hide it).
function rk_kn_vdisc(cx, cy, r, tr, tg, tb, br, bg_, bb)
local(i, y, hw, f, x0, x1)
(
  i = floor(cy - r);
  while (i <= cy + r) (
    y = i + 0.5 - cy;
    hw = sqrt(max(r * r - y * y, 0)) - 0.5;
    hw > 0 ? (
      f = (y + r) / (2 * r);
      x0 = floor(cx - hw + 0.5); x1 = floor(cx + hw + 0.5);
      x1 > x0 ? (
        gfx_set(tr + (br - tr) * f, tg + (bg_ - tg) * f, tb + (bb - tb) * f, 1);
        gfx_rect(x0, i, x1 - x0, 1);
      );
    );
    i += 1;
  );
);

// A radial pill (rounded bar) r0..r1 at clock angle a, width w, current colour.
function rk_kn_pill(cx, cy, a, r0, r1, w)
local(h)
(
  h = w * 0.5;
  r1 - r0 > w ? rk_kn_ray(cx, cy, a, r0 + h, r1 - h, w);
  gfx_circle(cx + sin(a) * (r0 + h), cy - cos(a) * (r0 + h), h, 1, 1);
  gfx_circle(cx + sin(a) * (r1 - h), cy - cos(a) * (r1 - h), h, 1, 1);
);

// Supersampled drawing (rk_ss) for the parts that move with the value. gfx_triangle
// is not anti-aliased and gfx_arc is 1 px, so a pointer or a value arc drawn straight
// changes weight and steps as it turns. rk_ss draws it at 2x into an offscreen image
// and blits it back at 1x with filtering: the same edge at every angle. Only for the
// value-driven pointers and arcs (a handful per knob), never for static detail.
// A host may set, in its @init after the import:
//   RK_SS      1 = on (default), 0 = draw straight (the old look, cheapest)
//   RK_SS_IMG  the offscreen image slot (default 127), if the host uses 127
// ⚠ Only slots 0..127 work: measured in REAPER 7.83 (2026-10-26, .dev_tests/rkss_shots_run.ps1),
// an image at 128, 255, 256, 511 or 1023 takes the drawing and blits NOTHING. The suite uses
// 0, 2, 7, 32, 95, 96 and 97; 127 is free in all of it. The image only grows. A box over 512 px a side is drawn straight. The wrappers
// draw in the CURRENT colour into the image at full alpha; the colour's alpha is
// applied once, at the blit, so a pointer's overlapping parts do not double up.
RK_SS = 1; RK_SS_IMG = 127; rk_ss_iw = 0; rk_ss_ih = 0; rk_ss_on = 0;

function rk_ss_begin(x0, y0, x1, y1) local(on, w2, h2) (
  rk_ss_x = floor(min(x0, x1)) - 2; rk_ss_y = floor(min(y0, y1)) - 2;
  rk_ss_w = ceil(max(x0, x1)) + 2 - rk_ss_x; rk_ss_h = ceil(max(y0, y1)) + 2 - rk_ss_y;
  // never nests: a begin inside a begin draws straight and leaves the outer one alone;
  // a slot outside 0..127 draws straight too (it would blit nothing: the pointer would vanish)
  on = RK_SS && !rk_ss_on && rk_ss_w <= 512 && rk_ss_h <= 512 && RK_SS_IMG >= 0 && RK_SS_IMG <= 127;
  on ? (
    rk_ss_on = 1;
    rk_ss_d = gfx_dest; rk_ss_m = gfx_mode; rk_ss_a = gfx_a; rk_ss_a2 = gfx_a2;
    w2 = rk_ss_w * 2; h2 = rk_ss_h * 2;
    (w2 > rk_ss_iw || h2 > rk_ss_ih) ? (
      rk_ss_iw = max(rk_ss_iw, max(w2, 128)); rk_ss_ih = max(rk_ss_ih, max(h2, 128));
      gfx_setimgdim(RK_SS_IMG, rk_ss_iw, rk_ss_ih);
    );
    gfx_dest = RK_SS_IMG; gfx_mode = 0;
    // clear to the current colour at alpha 0 (not black), so the filtering adds no dark fringe
    gfx_a = 1; gfx_a2 = 0; gfx_rect(0, 0, w2, h2);
    gfx_a2 = 1;
  );
  on;
);
function rk_ss_end() (
  rk_ss_on ? (
    gfx_dest = rk_ss_d; gfx_a = rk_ss_a; gfx_a2 = rk_ss_a2;
    gfx_mode = rk_ss_m & 1;   // keep additive if set; source alpha and filtering on
    gfx_blit(RK_SS_IMG, 1, 0, 0, 0, rk_ss_w * 2, rk_ss_h * 2, rk_ss_x, rk_ss_y, rk_ss_w, rk_ss_h);
    gfx_mode = rk_ss_m;
    rk_ss_on = 0;
  );
);
// the 2x coordinates, between rk_ss_begin and rk_ss_end
function rk_ssx(x) ( (x - rk_ss_x) * 2; );
function rk_ssy(y) ( (y - rk_ss_y) * 2; );

// rk_kn_ray / rk_kn_band, supersampled: the same arguments and shape, smoother.
function rk_ss_ray(cx, cy, a, r0, r1, w) local(ux, uy, e) (
  ux = sin(a); uy = -cos(a); e = w + 1;
  rk_ss_begin(min(cx + ux * r0, cx + ux * r1) - e, min(cy + uy * r0, cy + uy * r1) - e,
              max(cx + ux * r0, cx + ux * r1) + e, max(cy + uy * r0, cy + uy * r1) + e) ? (
    rk_kn_ray(rk_ssx(cx), rk_ssy(cy), a, r0 * 2, r1 * 2, w * 2);
    rk_ss_end();
  ) : rk_kn_ray(cx, cy, a, r0, r1, w);
);
function rk_ss_band(cx, cy, r_in, r_out, a1, a2) (
  a2 > a1 ? (
    rk_ss_begin(cx - r_out - 1, cy - r_out - 1, cx + r_out + 1, cy + r_out + 1) ? (
      rk_kn_band(rk_ssx(cx), rk_ssy(cy), r_in * 2, r_out * 2, a1, a2);
      rk_ss_end();
    ) : rk_kn_band(cx, cy, r_in, r_out, a1, a2);
  );
);


// ═══════════════════════════════════════════════════════════════════════════
// THE LIGHT (rk_light) — one light over every knob, in five looks
// ═══════════════════════════════════════════════════════════════════════════
// Every style used to carry its own idea of where the light is: a shadow a pixel
// or two down-right, a sheen a fraction up-left, a gradient lit at the top. They
// still draw those, but through the helpers below, which all read ONE light. A
// host picks the look by setting RK_LIGHT: in its @init after the import, or at
// any point before a draw (one control can switch it just before its own draw and
// put it back after). The looks:
//   0  Studio   a soft light from the top-left: the drawing exactly as it was.
//               The default; unset reads 0, so a plugin that never sets it is unchanged.
//   1  Flat     no light: no shadow, no sheen, every gradient sits at its mid tone.
//   2  Vintage  the light low from the left and warm: dull sheens, deep warm gradients,
//               long dark shadows to the right.
//   3  Stage    one hard light from straight above: bright sheens, dark long shadows,
//               deep gradients.
//   4  Matte    the Studio light on rubber: next to no sheen, gradients at a third of
//               their depth, a soft, slightly wider shadow.
// Pointers, inks, value arcs and accents never change: only what the light does to a
// body. The gradients stay top-to-bottom in every look (the light's height, not its
// side); what turns with the light is the shadow, the sheen and the rim shading.
// rk_light_apply() turns RK_LIGHT into the numbers below; rk_lt(), first in every draw
// that uses them, recomputes only when RK_LIGHT changed. At look 0 every helper takes
// the untouched path by construction (a turn by 0, every strength 1, a depth of 1), so
// Studio is the old picture byte for byte: measured in REAPER 7.83 against the library
// before this module (.dev_tests/rklight_shots_run.ps1, 2026-10-26): 0 pixels differ.
RK_LIGHT = 0; rk_lt_look = -1;
function rk_light_apply() (
  rk_lt_look = RK_LIGHT;
  // the light's clock angle (0 = up, +CW); Studio's is the top-left, the one every style drew
  // (Vintage and Matte were pushed 2026-10-26 on the user's word: the first cut sat too close to Studio
  // at knob size. Vintage: the light low from the left, long dark shadows, dull sheens, deep warm
  // gradients. Matte: next to no sheen, gradients at a third of their depth, a soft wider shadow.)
  rk_lt_ang = RK_LIGHT == 2 ? -1.35 : RK_LIGHT == 3 ? 0 : -0.785;
  rk_lt_dang = rk_lt_ang + 0.785;                 // how far this look's light turned from Studio's
  rk_lt_c = cos(rk_lt_dang); rk_lt_s = sin(rk_lt_dang);
  rk_lt_sh = RK_LIGHT == 1 ? 0 : RK_LIGHT == 2 ? 1.7 : RK_LIGHT == 3 ? 1.5 : RK_LIGHT == 4 ? 0.8 : 1;    // shadow strength
  rk_lt_so = RK_LIGHT == 2 ? 2.2 : RK_LIGHT == 3 ? 1.6 : RK_LIGHT == 4 ? 1.3 : 1;                        // shadow reach
  rk_lt_hi = RK_LIGHT == 1 ? 0 : RK_LIGHT == 2 ? 0.45 : RK_LIGHT == 3 ? 1.6 : RK_LIGHT == 4 ? 0.08 : 1;  // sheen strength
  rk_lt_gr = RK_LIGHT == 1 ? 0 : RK_LIGHT == 2 ? 1.5 : RK_LIGHT == 3 ? 1.35 : RK_LIGHT == 4 ? 0.3 : 1;   // gradient depth
  RK_LIGHT == 2 ? ( rk_lt_wr = 1.08; rk_lt_wg = 0.97; rk_lt_wb = 0.82; )                               // the light's colour, on lit tones
                : ( rk_lt_wr = 1; rk_lt_wg = 1; rk_lt_wb = 1; );
);
function rk_lt() ( RK_LIGHT != rk_lt_look ? rk_light_apply(); );

// An offset (ox, oy) as the Studio drawing had it (down-right for a shadow, up-left for a
// sheen), turned to this look's light: the result is in rk_lt_x / rk_lt_y.
function rk_lt_turn(ox, oy) (
  rk_lt_x = ox * rk_lt_c - oy * rk_lt_s;
  rk_lt_y = ox * rk_lt_s + oy * rk_lt_c;
);
// A drop shadow: a black disc of radius r at the Studio offset (ox, oy) and alpha a (aa = the
// anti-alias flag the style used; a gfx_circle with the flag LEFT OUT smooths, so that is 1
// here, not 0 -- measured 2026-10-26: 0 moved the shadow edge of five styles), turned to
// the light, its reach and strength by the look.
function rk_lt_shadow(cx, cy, ox, oy, r, a, aa) (
  rk_lt_sh > 0 ? (
    rk_lt_turn(ox * rk_lt_so, oy * rk_lt_so);
    gfx_set(0, 0, 0, min(1, a * rk_lt_sh));
    gfx_circle(cx + rk_lt_x, cy + rk_lt_y, r, 1, aa);
  );
);
// A sheen: a filled disc in (sr, sg, sb) at alpha a, at the Studio offset (ox, oy) toward
// the light, turned to the light, its strength by the look, in the light's colour.
function rk_lt_sheen(cx, cy, ox, oy, r, sr, sg, sb, a, aa) (
  rk_lt_hi > 0 ? (
    rk_lt_turn(ox, oy);
    gfx_set(min(1, sr * rk_lt_wr), min(1, sg * rk_lt_wg), min(1, sb * rk_lt_wb), min(1, a * rk_lt_hi));
    gfx_circle(cx + rk_lt_x, cy + rk_lt_y, r, 1, aa);
  );
);
// How lit a rim is at clock angle a: 1 facing the light, 0 away from it, a flat 0.5 as the
// gradient depth falls to nothing (and held to 0..1 where a deep look would push past).
function rk_lt_rim(a) ( min(max(0.5 + 0.5 * rk_lt_gr * cos(a - rk_lt_ang), 0), 1); );
// How deep in shade a point (dx, dy) from a body's centre sits, 0 lit .. 1 shade, 0.5 at the
// centre, for the shapes whose Studio light came from straight above over a height h.
function rk_lt_shade(dx, dy, h) (
  rk_lt_turn(0, 1);
  min(max(0.5 + rk_lt_gr * (dx * rk_lt_x + dy * rk_lt_y) / h, 0), 1);
);
// A gradient step: v0 at f = 0, v0 + dv at f = 1 as Studio drew it, pulled toward the middle
// of that run as the depth falls, pushed past its ends as it grows.
function rk_lt_ramp(v0, dv, f) (
  rk_lt_gr == 1 ? v0 + dv * f : v0 + dv * 0.5 + dv * (f - 0.5) * rk_lt_gr;
);
// A lit tone over its base tone: the lit one at full sheen, the base at none.
function rk_lt_mix(base, lit) ( rk_lt_hi == 1 ? lit : base + (lit - base) * rk_lt_hi; );
// rk_kn_vdisc through the light: top (lit) to bottom (shade), the pair pulled toward its
// middle as the depth falls, the lit end in the light's colour.
function rk_lt_vdisc(cx, cy, r, tr, tg, tb, br, bg_, bb) local(mr, mg, mb) (
  rk_lt_gr == 1 && rk_lt_wr == 1 && rk_lt_wg == 1 && rk_lt_wb == 1 ? rk_kn_vdisc(cx, cy, r, tr, tg, tb, br, bg_, bb) : (
    mr = (tr + br) * 0.5; mg = (tg + bg_) * 0.5; mb = (tb + bb) * 0.5;
    rk_kn_vdisc(cx, cy, r,
      min(1, (mr + (tr - mr) * rk_lt_gr) * rk_lt_wr), min(1, (mg + (tg - mg) * rk_lt_gr) * rk_lt_wg), min(1, (mb + (tb - mb) * rk_lt_gr) * rk_lt_wb),
      max(0, mr + (br - mr) * rk_lt_gr), max(0, mg + (bg_ - mg) * rk_lt_gr), max(0, mb + (bb - mb) * rk_lt_gr));
  );
);


// ═══════════════════════════════════════════════════════════════════════════
// 1. RAINBOW ARC  (the look of BirdBird's VIC knob; EON's own code, 2026-09-21)
// ═══════════════════════════════════════════════════════════════════════════
// Globals used: bb_brightness (0 at init; lifts the colour toward white) and
// bb_tr/bb_tg/bb_tb (set by bb_palette). The bb_ names stay for existing callers.
// Two ways in: bb_knob_draw keeps colour state in mem and fades in;
// rainbow_knob_draw is stateless (the theme dispatcher's style 9).

// One of EON's six band colours (Tone's six) into bb_sr/bb_sg/bb_sb.
function bb_six(i) (
  i == 0 ? ( bb_sr = 0.92; bb_sg = 0.30; bb_sb = 0.30; ) :   // red
  i == 1 ? ( bb_sr = 0.96; bb_sg = 0.60; bb_sb = 0.18; ) :   // orange
  i == 2 ? ( bb_sr = 0.38; bb_sg = 0.86; bb_sb = 0.36; ) :   // green
  i == 3 ? ( bb_sr = 0.22; bb_sg = 0.82; bb_sb = 0.70; ) :   // teal
  i == 4 ? ( bb_sr = 0.30; bb_sg = 0.66; bb_sb = 0.96; ) :   // blue
           ( bb_sr = 0.68; bb_sg = 0.44; bb_sb = 0.96; );    // violet
);

// Palette: the six, cross-faded in a loop, 0.6 s per step; t in seconds.
// Sets bb_tr, bb_tg, bb_tb.
function bb_palette(t)
local(p, i, f, r0, g0, b0)
(
  p = t / 0.6;
  p -= floor(p / 6) * 6;
  i = floor(p);
  f = p - i;
  f = f * f * (3 - 2 * f);
  bb_six(i);
  r0 = bb_sr; g0 = bb_sg; b0 = bb_sb;
  bb_six((i + 1) % 6);
  bb_tr = r0 + (bb_sr - r0) * f;
  bb_tg = g0 + (bb_sg - g0) * f;
  bb_tb = b0 + (bb_sb - b0) * f;
  bb_tr += (1 - bb_tr) * bb_brightness;
  bb_tg += (1 - bb_tg) * bb_brightness;
  bb_tb += (1 - bb_tb) * bb_brightness;
);

// Paint: a 270-degree value arc in (cr, cg, cb) over a dim track, a dark body
// with a thin coloured rim, and a pointer ending in a dot. v and hov are 0..1.
// Angles run clockwise from 12 o'clock: lower-left to lower-right.
function rainbow_knob_paint(cx, cy, r, v, hov, cr, cg, cb)
local(a0, sweep, av, ring_w, ring_in, rr, n, body_r, s, c)
(
  r = r * (1 + 0.06 * hov);              // the whole knob swells on hover
  sweep = $pi * 1.5;
  a0 = -$pi * 0.75;
  av = a0 + v * sweep;
  ring_w = r * (0.16 + 0.04 * hov);      // a touch thicker on hover
  ring_in = r - ring_w;
  n = ceil(ring_w * 2);                   // half-pixel passes

  gfx_set(0.06 + cr * 0.2, 0.06 + cg * 0.2, 0.07 + cb * 0.2, 1);
  rr = ring_in;
  loop(n, gfx_arc(cx, cy, rr, a0, a0 + sweep, 1); rr += 0.5; );
  v > 0 ? (
    gfx_set(cr, cg, cb, 1);
    rr = ring_in;
    loop(n, gfx_arc(cx, cy, rr, a0, av, 1); rr += 0.5; );
  );

  body_r = ring_in - max(2, r * 0.08);
  gfx_set(0.10, 0.10, 0.12, 1);
  gfx_circle(cx, cy, body_r, 1, 1);
  gfx_set(cr, cg, cb, 0.55 + 0.35 * hov);
  gfx_circle(cx, cy, body_r, 0, 1);

  s = sin(av);
  c = -cos(av);
  gfx_set(cr, cg, cb, 1);
  gfx_line(cx + s * body_r * 0.35, cy + c * body_r * 0.35,
           cx + s * body_r * 0.85, cy + c * body_r * 0.85, 1);
  gfx_circle(cx + s * body_r * 0.85, cy + c * body_r * 0.85, max(1.5, r * 0.05), 1, 1);
);

// Draw with state: mem[0] = hover ramp (from bb_knob_interact), mem[8] = run
// time, mem[9..11] = colour state (eases toward the palette so it fades in).
function bb_knob_draw(cx, cy, r, value, vmin, vmax, mem)
local(v, ease)
(
  v = vmax > vmin ? min(max((value - vmin) / (vmax - vmin), 0), 1) : 0;
  // The colour loop runs while the knob is up; at zero it rests on red.
  bb_palette(v > 0 ? mem[8] : 0);
  ease = min(1, dt * 6);
  mem[9]  += (bb_tr - mem[9])  * ease;
  mem[10] += (bb_tg - mem[10]) * ease;
  mem[11] += (bb_tb - mem[11]) * ease;
  rainbow_knob_paint(cx, cy, r, v, mem[0], mem[9], mem[10], mem[11]);
  v > 0 ? ( mem[8] += dt; ) : ( mem[8] = 0; );
);

// Draw without state (theme dispatcher, style 9): the colour follows the clock
// while the knob is up and rests on red at zero. hover_t is 0..1.
function rainbow_knob_draw(cx, cy, r, value, vmin, vmax, hover_t)
local(v)
(
  v = vmax > vmin ? min(max((value - vmin) / (vmax - vmin), 0), 1) : 0;
  bb_palette(v > 0 ? time_precise() : 0);
  rainbow_knob_paint(cx, cy, r, v, hover_t, bb_tr, bb_tg, bb_tb);
);

// Interact: circular hover, drag, scroll, double/right-click reset to vdefault
function bb_knob_interact(mem, cx, cy, r, cur_val, vmin, vmax, vdefault, n_detents)
local(d, hover, new_val, now, sens, dy, _range)
(
  d = dist(mx, my, cx, cy);
  hover = (d <= r);
  _range = vmax - vmin;
  // Hover ramp (keep animating while dragging)
  hover || mem[1] ? (
    mem[0] = min(mem[0] + dt * hv_speed, 1);
  ) : (
    mem[0] = max(mem[0] - dt * hv_speed, 0);
  );
  mem[6] = hover || mem[1];
  new_val = cur_val;
  mem[5] = 0;

  // Right-click reset
  hover && rmb_down ? ( new_val = vdefault; mem[5] = 1; );
  // Double-click reset
  hover && lmb_down ? (
    now = time_precise();
    (now - mem[4] < RK_DBLCLICK_T) ? ( new_val = vdefault; mem[5] = 1; );
    mem[4] = now;
  );
  // Start drag (skip if double-click just fired)
  lmb_down && hover && !mem[1] && !mem[5] ? (
    mem[1] = 2;      // pressed: rk_drag_live starts the drag past the deadzone
    mem[2] = my;     // track last y for delta
  );
  // Continue drag (delta-per-frame)
  rk_drag_live(mem, LMB && !_srf_foreign, cur_val) ? (
    dy = mem[2] - my;
    mem[2] = my;
    sens = CTRL ? 1000 : SHIFT ? 4000 : 100;
    new_val = clamp(cur_val + dy * _range / sens, vmin, vmax);
  );
  // End drag
  mem[1] && !LMB ? (
    mem[1] = 0;
    mem[5] = 1;
  );
  // Scroll wheel (CTRL=fine 0.5%, SHIFT=extra-fine 0.2%, default=2%)
  hover && frame_wheel != 0 ? (
    new_val = clamp(cur_val + frame_wheel * _range * (CTRL ? 0.005 : SHIFT ? 0.002 : 0.02), vmin, vmax);
    mem[5] = 1;
    frame_wheel = 0;   // consumed (see the header)
  );
  new_val;
);


// ═══════════════════════════════════════════════════════════════════════════
// 2. JOANNY / McFIZZ
// ═══════════════════════════════════════════════════════════════════════════
// Blue pot with 4-pass shadow, box hover zone, canChange gate interaction.
// Body color parameterized (cr, cg, cb). Pointer auto-selects black/white.

// Draw: 4-pass shadow blur, blue body with blur, black outline, pointer
function jo_knob_draw(cx, cy, r, value, vmin, vmax, ht, cr, cg, cb)
local(shad_off, lift, dy, vr, angle, jxx, jyy, off, alpha)
(
  shad_off = lerp(3, 1, ht);
  lift = lerp(0, -2, ht);

  // 4-pass shadow (off=0..3, alpha=0.20→0.05), its strength by the light. Its offset
  // stays put in every look: the blur box below is cut to it, and a turned shadow
  // would need a wider box, which blurs the body's edge differently.
  rk_lt();
  off = 0;
  rk_lt_sh > 0 ? loop(4,
    alpha = (0.20 - off * 0.05) * rk_lt_sh;
    gfx_set(0, 0, 0, alpha);
    gfx_circle(cx + shad_off + off, cy + 2 + off + lift, r + off, 1);
    // The blur box is the shadow circle's own box, one pixel wider all round. It used to be
    // mirrored (9 px left of and 8 px above the knob, 3 px short on the right and bottom),
    // which re-blurred whatever was painted beside the knob every frame (sweep LIB126).
    gfx_x = cx + shad_off - r - 1; gfx_y = cy + 2 + lift - r - 1;
    gfx_blurto(cx + shad_off + r + off * 2 + 1, cy + 2 + lift + r + off * 2 + 1);
    off += 1;
  );

  // Body (lifted)
  dy = cy + lift;
  gfx_set(cr * 0.7, cg * 0.7, cb * 0.7, 0.8);
  gfx_circle(cx, dy, r, 1);
  gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, dy, r * 0.73, 1);
  // Blur body for soft gradient
  gfx_x = cx - r - 1; gfx_y = dy - r - 1;
  gfx_blurto(cx + 1 + r, dy + 1 + r);
  // Black outline
  gfx_set(0, 0, 0, 1);
  gfx_circle(cx, dy, r + 0.6, 0);

  // Pointer (normalized to 0–1)
  vr = clamp((value - vmin) / (vmax - vmin), 0, 1);
  angle = -2.3 + 4.6 * (vr * 0.98 + 0.02);
  jxx = sin(angle) * r;
  jyy = -cos(angle) * r;
  // Brightness-dependent pointer color
  (cr + cg + cb >= 2.3) ? gfx_set(0, 0, 0, 1) : gfx_set(1, 1, 1, 1);
  gfx_line(cx, dy, cx + jxx, dy + jyy, 1);
);

// Interact: BOX hover zone, canChange gate, CTRL fine, SHIFT extra-fine
// mem[8] = hasEntered (canChange gate)
function jo_knob_interact(mem, cx, cy, r, cur_val, vmin, vmax, vdefault, n_detents)
local(hover, new_val, now, fine, nv, box_hw, _range)
(
  // Box hover check (~1.3× radius bounding box)
  box_hw = r * 1.3;
  _range = vmax - vmin;
  hover = (mx >= cx - box_hw && mx <= cx + box_hw &&
           my >= cy - box_hw && my <= cy + box_hw);
  // Hover ramp
  hover || mem[1] ? (
    mem[0] = min(mem[0] + dt * hv_speed, 1);
  ) : (
    mem[0] = max(mem[0] - dt * hv_speed, 0);
  );
  mem[6] = hover || mem[1];
  new_val = cur_val;
  mem[5] = 0;

  // Right-click reset
  hover && rmb_down ? ( new_val = vdefault; mem[5] = 1; );
  // Scroll wheel (CTRL=fine 0.5%, SHIFT=extra-fine 0.2%, default=2%)
  hover && frame_wheel != 0 ? (
    new_val = clamp(cur_val + frame_wheel * _range * (CTRL ? 0.005 : SHIFT ? 0.002 : 0.02), vmin, vmax);
    mem[5] = 1;
    frame_wheel = 0;   // consumed (see the header)
  );

  // Double-click reset
  hover && lmb_down ? (
    now = time_precise();
    (now - mem[4] < RK_DBLCLICK_T) ? ( new_val = vdefault; mem[5] = 1; );
    mem[4] = now;
  );

  // canChange gate: must hover with no button first, THEN press to activate
  // ⚠ LEFT BUTTON ONLY (mouse_cap & 1), never all of mouse_cap: it is a bitfield
  // that also carries Shift/Ctrl/Alt and the other buttons. Testing all of it let a
  // Shift press or a right-click over the knob start a drag with no click, and kept
  // a drag alive after the button came up while Shift was still held -- moving the
  // mouse then changed the value (2026-09-13 audit). SHIFT is now a live drag
  // modifier here, which makes testing the whole bitfield worse, not merely wrong.
  hover ? (
    !(mouse_cap & 1) ? mem[8] = 1;  // hasEntered = true when hovering with no button
  ) : (
    mem[8] = 0;               // leave hover zone = reset gate
  );

  // Track start position when not dragging
  mem[1] == 0 ? mem[2] = my;

  // Activate drag only if canChange gate is open (skip if double-click just fired);
  // pressed first, rk_drag_live starts the drag past the deadzone
  !mem[1] && mem[8] && (mouse_cap & 1) && !mem[5] ? ( mem[1] = 2; );

  // Drag (delta-per-frame, CTRL=fine, SHIFT=extra-fine)
  rk_drag_live(mem, mouse_cap & 1, cur_val) ? (
    fine = CTRL ? 3000 : SHIFT ? 12000 : 300;
    nv = _range / fine * (mem[2] - my);
    new_val = clamp(cur_val + nv, vmin, vmax);
    mem[2] = my;
  );

  // Release
  !(mouse_cap & 1) ? (
    mem[1] ? mem[5] = 1;
    mem[1] = 0;
  );
  new_val;
);


// ═══════════════════════════════════════════════════════════════════════════
// 3. SPICE PRO
// ═══════════════════════════════════════════════════════════════════════════
// Themed arc-fill knob with perpendicular sweep needle (Spice v6 lineage).
// The arc wears the role hue (cr,cg,cb) instead of v6's hardcoded blue:
//   - value heat: color runs dim at low travel and full-strength at max
//     (bipolar: heat = distance from center), so the color changes as the
//     knob turns
//   - hover lifts the color toward white — the same move v6 made on its
//     blue (channel toward 1.0), generalized to any hue
//   - a soft halo outside the ring blooms with hover and value heat
//   - dim background track shows the full travel range at any value
//   - is_sym fills from center (pan/tilt-style knobs)
//   - inner ring contrast keys off the host panel luminance (bgr,bgg,bgb)
//     so the knob structure reads on light themes; unset/dark panels get
//     the classic light ring

// Draw: track + arc ring (w×fill passes), glow halo, 3-pass inner circle
// with pulse, perpendicular-sweep needle
function sp_knob_draw(cx, cy, r, value, vmin, vmax, ht, is_sym, cr, cg, cb, bgr, bgg, bgb)
local(kr, kg, kb, heat, anc, margin, w, inner, inner_pulse, arc_fill, knob_rad,
      kas, a_lo, a_hi, a_ctr, a_val, arc_steps, ir, i, rr, polar, xo_, yo_,
      nthick, steps, s, off_x, off_y, bg_luma, ring, glow_a, j,
      ex_, ey_, rw_, a_full, _vn)
(
  // Normalise to 0..1 -- the caller passes real units, as every other
  // knob in this library does (bb/jo/sp were the last three that did not).
  _vn = (value - vmin) / max(vmax - vmin, 0.0001);

  // Bipolar anchor: is_sym 1 = range midpoint; fractional 0<x<1 = normalized
  // anchor position (value-anchored sym, e.g. 12/18 for a -12..+6 dB knob)
  anc = is_sym ? (is_sym < 1 ? is_sym : 0.5) : 0;

  // Value heat: how hot the knob runs (bipolar = distance off the anchor)
  heat = is_sym ? min(1, abs(_vn - anc) / max(max(anc, 1 - anc), 0.0001)) : _vn;

  // Role hue scaled by heat, then lifted toward white on hover
  kr = cr * lerp(0.55, 1.0, heat);
  kg = cg * lerp(0.55, 1.0, heat);
  kb = cb * lerp(0.55, 1.0, heat);
  kr += (1 - kr) * 0.25 * ht;
  kg += (1 - kg) * 0.25 * ht;
  kb += (1 - kb) * 0.25 * ht;

  // Proportions from v6: margin=12, w=18, arc_fill=5, rad=0.6 (scaled to radius)
  margin = r * 12 / 55;
  w = r * 18 / 55;
  arc_fill = 3;  // 3 arcs/px radial step — full coverage (was 5: 5x overdraw)
  knob_rad = 0.6;
  kas = -tau * (1 + knob_rad / 2);
  inner = r - w - margin;
  inner_pulse = lerp(0, 2, ht);

  // Arc span: unipolar fills from the left; bipolar from the anchor
  a_val = _vn * tau * knob_rad + kas;
  a_ctr = anc * tau * knob_rad + kas;
  is_sym ? (
    a_lo = min(a_ctr, a_val); a_hi = max(a_ctr, a_val);
  ) : (
    a_lo = kas; a_hi = a_val;
  );

  // Background track (dim role hue) — full travel range, jog-style
  arc_steps = (w * arc_fill) | 0;
  rw_ = r - w;
  a_full = tau * knob_rad + kas;
  gfx_set(cr * 0.15, cg * 0.15, cb * 0.15, 0.8);
  i = 0;
  while (i < arc_steps) (
    gfx_arc(cx, cy, rw_ + i / arc_fill, kas, a_full);
    i += 1;
  );

  // Active arc ring (w * arc_fill passes)
  gfx_set(kr, kg, kb, 1);
  i = 0;
  while (i < arc_steps) (
    gfx_arc(cx, cy, rw_ + i / arc_fill, a_lo, a_hi);
    i += 1;
  );

  // Glow halo outside the ring — blooms with value heat and hover
  glow_a = lerp(0.05, 0.22, max(heat * 0.8, ht));
  j = 1;
  loop(4,
    gfx_set(kr, kg, kb, glow_a * (1 - j * 0.22));
    gfx_arc(cx, cy, r + j, a_lo, a_hi, 1);
    j += 1;
  );

  // Inner circle (3-pass outline + hover pulse), panel-contrast ink
  bg_luma = 0.299 * bgr + 0.587 * bgg + 0.114 * bgb;
  ring = bg_luma > 0.5 ? 0.22 : 0.8;
  ir = inner + inner_pulse;
  gfx_set(ring, ring, ring, 1);
  gfx_circle(cx, cy, ir, 0, 1);
  gfx_circle(cx, cy, ir - 0.5, 0, 1);
  gfx_circle(cx, cy, ir - 1, 0, 1);

  // Needle (perpendicular sweep)
  polar = (_vn * 1.01) * tau * knob_rad + kas;
  xo_ = sin(polar + tau / 2) * -1;
  yo_ = cos(polar + tau / 2);
  gfx_set(kr, kg, kb, 1);
  nthick = r * 0.15;
  // Width-derived pass count (~3.2 lines/px keeps the stacked-AA body solid);
  // was a fixed 60 regardless of needle width — 16x overdraw at r=25.
  steps = max(6, 2 * ceil(nthick * 1.5));
  ex_ = xo_ * (ir - 1);
  ey_ = yo_ * (ir - 1);
  s = -steps / 2;
  while (s <= steps / 2) (
    off_x = s / steps * yo_ * nthick;
    off_y = -s / steps * xo_ * nthick;
    gfx_line(cx + off_x, cy + off_y, cx + off_x + ex_, cy + off_y + ey_);
    s += 1;
  );
);

// Interact: circular hover, absolute drag, scroll, double/right-click reset to vdefault
function sp_knob_interact(mem, cx, cy, r, cur_val, vmin, vmax, vdefault, n_detents)
local(d, hover, new_val, now, sens, sensitivity, _range)
(
  hover = (dist(mx, my, cx, cy) <= r);
  _range = vmax - vmin;
  // Hover ramp
  hover || mem[1] ? (
    mem[0] = min(mem[0] + dt * hv_speed, 1);
  ) : (
    mem[0] = max(mem[0] - dt * hv_speed, 0);
  );
  mem[6] = hover || mem[1];
  new_val = cur_val;
  mem[5] = 0;

  // Right-click reset
  hover && rmb_down ? ( new_val = vdefault; mem[5] = 1; );
  // Scroll wheel (CTRL=fine 0.5%, SHIFT=extra-fine 0.2%, default=2%)
  hover && frame_wheel != 0 ? (
    new_val = clamp(cur_val + frame_wheel * _range * (CTRL ? 0.005 : SHIFT ? 0.002 : 0.02), vmin, vmax);
    mem[5] = 1;
    frame_wheel = 0;   // consumed (see the header)
  );

  // Double-click reset
  lmb_down && hover ? (
    now = time_precise();
    (now - mem[4] < RK_DBLCLICK_T) ? ( new_val = vdefault; mem[5] = 1; );
    mem[4] = now;
  );

  // Start drag (absolute start position, skip if double-click)
  lmb_down && !mem[1] && hover && !mem[5] ? (
    mem[1] = 2;          // pressed: rk_drag_live starts the drag past the deadzone
    mem[2] = my;         // drag_start_y
    mem[3] = cur_val;    // drag_start_val
    _rk_drag_mod = rk_drag_mods();
  );

  // Continue drag (absolute offset from start, CTRL=fine, SHIFT=extra-fine;
  // a modifier change re-anchors the drag here: rk_drag_mods)
  rk_drag_live(mem, LMB && !_srf_foreign, cur_val) ? (
    rk_drag_mods() != _rk_drag_mod ? ( mem[2] = my; mem[3] = cur_val; _rk_drag_mod = rk_drag_mods(); );
    sens = CTRL ? 0.03 : SHIFT ? 0.0075 : 0.3;
    sensitivity = (_range / r) * sens;
    new_val = clamp(mem[3] + (mem[2] - my) * sensitivity, vmin, vmax);
  );

  // Release
  !LMB ? (
    mem[1] ? mem[5] = 1;
    mem[1] = 0;
  );
  new_val;
);


// ═══════════════════════════════════════════════════════════════════════════
// 4. WITTI SOUND ARC KNOB
// ═══════════════════════════════════════════════════════════════════════════

