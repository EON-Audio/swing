// anvil_fitted.jsfx-inc -- GENERATED by export_jsfx.py. Do not edit.
// Calibrated constants for EON Anvil (fit of 2026-08-21 vs Moore Rev D data)
// plus ground-truth table nodes the plugin verifies itself against at load.

// provenance census: ASSUMED 10, DATASHEET 4, DERIVED 14, FITTED 13, GRID 36, GUIDE 1, MANUAL 1, SCHEMATIC 20, SOLVED 38, UNTAGGED 1

@init

// gain cell (BLACK voice ln_k; BLUE rebuilds with 0)
ANV_VTH   = -2;  // DATASHEET: BF245A/2N5457-class pinch-off; the real part is a U2244
ANV_IDSS  = 0.00366;  // DATASHEET: same part; not the U2244
ANV_RS    = 27000;  // SCHEMATIC: R6
ANV_LNK   = 0.493466666667;  // FITTED: LN bridge ratio; sits at its clean bound
// src_gamma: Rev D drives the FET source (C28 -> R18/R84 tap, p52);
// Rev A grounds it (p48). BLUE builds its surface with 0.
ANV_GAMMA = 0.0291666666667;  // UNTAGGED
ANV_SUBVT = 0.060065;   // FET subthreshold slope n*V_T; 0 = hard cutoff  | FITTED: JFET subthreshold slope n*V_T, n = 1.14
ANV_VREF  = 0.008;  // SOLVED: 8 mV at the FET node per full-scale sample
ANV_NV    = 513;  // GRID
ANV_NG    = 257;  // GRID
ANV_VMAX  = 0.08;  // GRID
ANV_GMIN  = -2.540585;  // SOLVED: gate span for 40 dB of range
ANV_GMAX  = 0;  // SOLVED: clamped at 0 V; a positive gate would forward-bias

// sidechain
ANV_NVT     = 0.052;  // FITTED: diode emission slope, n = 2.0; at its physical bound
ANV_ISAT    = 0.000000001;  // ASSUMED: generic silicon saturation current
ANV_RAIL    = 14;  // DERIVED: netlist solve put the ceiling at 10-14 V; fit chose 14
ANV_ASYM    = 0.35;  // FITTED: sidechain clip asymmetry; netlist did NOT settle its sign
ANV_CSM     = 0.00000022;  // SCHEMATIC: C27, the gate-node storage cap
ANV_GDIV    = 0.5;  // SCHEMATIC: R7/R9 = 2.2M/2.2M
ANV_VGREST  = -2.18940222558;   // Q-bias: 1.0 dB insertion loss  | SOLVED: the manufacturer's own Q-bias alignment: 1.0 dB insertion loss

// ratio positions: 20:1, 12:1, 8:1, 4:1, ALL (drive, diode bias, bias-net R)
ANV_DRV0  = 5943.48911649;   // 20  | DERIVED: audio ladder solve x makeup x fitted drive_scale
ANV_BIAS0 = 5.72645616684;  // DERIVED: bias ladder solve x fitted bias_scale
ANV_RTH0  = 1;  // SCHEMATIC: bias ladder Thevenin at this tap
ANV_DRV1  = 4076.23645381;   // 12  | DERIVED: audio ladder solve x makeup x fitted drive_scale
ANV_BIAS1 = 2.52135010331;  // DERIVED: bias ladder solve x fitted bias_scale
ANV_RTH1  = 660.447761194;  // SCHEMATIC: bias ladder Thevenin at this tap
ANV_DRV2  = 2790.99387078;   // 8  | DERIVED: audio ladder solve x makeup x fitted drive_scale
ANV_BIAS2 = 1.32477717293;  // DERIVED: bias ladder solve x fitted bias_scale
ANV_RTH2  = 476.567164179;  // SCHEMATIC: bias ladder Thevenin at this tap
ANV_DRV3  = 1372.79211537;   // 4  | DERIVED: audio ladder solve x makeup x fitted drive_scale
ANV_BIAS3 = 0.320510606353;  // DERIVED: bias ladder solve x fitted bias_scale
ANV_RTH3  = 141.604477612;  // SCHEMATIC: bias ladder Thevenin at this tap
ANV_DRV4  = 4010.2574415;   // ALL  | DERIVED: audio ladder solve x makeup x fitted drive_scale
ANV_BIAS4 = 11.7520555663;  // DERIVED: bias ladder solve x fitted bias_scale
ANV_RTH4  = 136;  // SCHEMATIC: bias ladder Thevenin at this tap

// diode conduction table grid: i(v, R), v 0..20 V, R 2..30000 ohm, 65 rows log-spaced
ANV_DIO_NV   = 1025;  // GRID
ANV_DIO_NR   = 65;  // GRID
ANV_DIO_VMAX = 20;  // GRID
ANV_DIO_RLO  = 2;  // GRID
ANV_DIO_RHI  = 30000;  // GRID

// tanh table (0..6, odd-extended at runtime)
ANV_TANH_N    = 1025;  // GRID
ANV_TANH_UMAX = 6.0;  // GRID

// output stage: biased Class A + DC-magnetised core (fitted)
ANV_SATV   = 44.2448204926;  // FITTED: Class A saturation voltage
ANV_ABIAS  = 0.895632654091;  // FITTED: Class A bias; at its floor -- the fit wants the stage linear
ANV_LM     = 2.3;  // ASSUMED: 5002 magnetising inductance
ANV_LAMSAT = 0.0449970877697;  // FITTED: core saturation flux; at its ceiling -- stage driven linear
ANV_LAMDC  = 0.0183127976308;  // FITTED: core DC magnetisation
ANV_RSRC   = 100;  // ASSUMED: output stage source resistance, open loop
// ⭐The output transformer is INSIDE the amplifier's feedback, not bolted
// on after it: p52 returns the primary's cold end through R34 82K into the
// amp, with R35 560 + C15 .0047 damping primary-to-secondary. Global
// feedback divides the amp's OUTPUT IMPEDANCE by (1+T), and the output
// impedance is exactly what limits how far the core's magnetising current
// can drag the output down -- so that is where the two meet.
// ANV_ZRED = 1 is the old one-way chain; smaller is a stiffer source.
// ⚠️ EXPORTED AS THE IMPEDANCE RATIO ITSELF, not as beta and not as loop
// gain, because the plugin multiplies by it directly and a reader cannot
// tell those apart from a name. CONTRACT: ANV_ZRED := 1/(1+T), so
// RSEFF = RSRC*ANV_ZRED is the closed-loop output impedance, full stop.
// (fbk in the fit is T/(1+T); 1 - fbk = 1/(1+T). Same number, and this is
// the end of the sentence where it can be misread.)
ANV_ZRED   = 0.338845507112;  // FITTED: closed-loop output impedance ratio 1/(1+T)

// Class A swing modulated by the current the load is drawing: a Class A
// stage sources freely but can only SINK its standing current, and the
// transformer IS the load. This is the only term that lets the core's
// state reach the ACTIVE device rather than just the terminal voltage.
ANV_AMPKI  = 0;  // FITTED: load-current modulation of the Class A swing (1/A)
ANV_RLOAD  = 600;  // SCHEMATIC: 600:600 output
ANV_OUTV   = 6.91;  // MANUAL: 0 dBFS = +16 dBu

// O-12-class input iron: Frohlich + Rayleigh hysteresis, symmetric, pre-cell
ANV_IX_LM    = 15;  // ASSUMED: O-12 magnetising inductance; repro spread is 9-20 H
ANV_IX_ILAMS = 26.3157894737;  // FITTED: O-12 saturation flux, inverted
ANV_IX_NUR   = 80;  // ASSUMED: Rayleigh coefficient; no authoritative low-level THD figure
ANV_IX_IRAY  = 1000;  // ASSUMED: Rayleigh fade scale
ANV_IX_RSRC  = 641;  // ASSUMED: source impedance seen by the input iron
ANV_IX_IDIV  = 0.943973428896;  // SOLVED: divider from the source and load impedances
ANV_IX_ENVS  = 0.1;       // envelope release, seconds  | ASSUMED: Rayleigh envelope release
ANV_XSCALE   = 0.00506329113924;  // unit sample -> primary volts  | SOLVED: unit sample -> primary volts
ANV_IXUP     = 1.58;        // step-up back to cell volts  | SCHEMATIC: O-12 turns ratio 1:1.58

// preamp residual. BLACK = Rev D's bipolar Q2 as a fitted biased tanh;
// BLUE = Rev A's DP6021AQ JFET common-source stage, solved. Both are
// baked into shaper tables at @init and chosen by a pointer.
ANV_PREG  = 100;  // ASSUMED: preamp level scaling
ANV_PSAT  = 7.640390625;  // FITTED: preamp residual saturation
ANV_PBIAS = 2.98829008433;  // FITTED: preamp residual bias
ANV_PSH_N = 2049;  // GRID: preamp shaper table length

// Rev A preamp (p48): R11 10K + R12 1K source, C3 6.4uF across R11 so
// the DC bias sees 11k and the signal sees 1k; R13 47K drain load.
// I = 2*b*a0^2/(s + 1 + sqrt(2s+1)), s = 2*a0*b*Rs -- the conjugate form,
// which is stable as s -> 0 where the textbook root cancels catastrophically.
ANV_A_BETA = 0.000915;  // DERIVED: i_dss/v_th^2, device shared with Q1 (13-0027 both sheets)
ANV_A_VTH  = -2;  // DATASHEET: JFET pinch-off, same device as the GR FET
ANV_A_RSAC = 1000;  // SCHEMATIC: R12 1K -- the only source R the signal sees (C3 shorts R11)
ANV_A_RL   = 47000;  // SCHEMATIC: R13 47K drain load, Rev A p48
ANV_A_IQ   = 0.00014555912626;  // SOLVED: self-bias operating current through R11+R12
ANV_A_VSDC = 1.60115038886;  // SOLVED: source DC held by C3
ANV_A_NORM = 2370.06047435;  // r_load/gain: unit slope at rest  | SOLVED: r_load / small-signal gain -- normalises to unit slope
ANV_A_DRIVE = 1.23026877081;  // +1.8 dB Rev A in-loop drive, pre-tap  | GUIDE: remaining ~1.8 dB of the +5 dB overall-gain claim, applied pre-tap

// Rev A line amp input Q4 (p48): R26 33K drain load, R27 12K + R28 560
// source with C9 6.4uF across R27, so the signal is degenerated by 560
// alone -- less than Q2's 1K, hence dirtier. Rev D has a 2N3391A here.
// ANV_A_GLINE is the line amp's closed loop from the shunt feedback drawn
// round Q5 (R29 1.2M / R30 120K); Rev D's R30 is 150K, so Rev A also runs
// 1.9 dB more line-amp gain. It sets the LEVEL at Q4's gate, so it sets
// Q4's distortion directly -- see reva_preamp for the caveat.
ANV_Q4_N    = 4097;  // GRID: Q4 table length
ANV_Q4_VMAX = 1;  // GRID: Q4 gate range; the lookup extrapolates past it
ANV_A_GLINE = 10;  // DERIVED: line amp closed loop R29/R30, Rev A 1.2M/120K
ANV_Q4_BETA = 0.000915;  // DERIVED: i_dss/v_th^2, DP6021AQ
ANV_Q4_VTH  = -2;  // DATASHEET: JFET pinch-off
ANV_Q4_RSAC = 560;  // SCHEMATIC: R28 560 -- C9 shorts R27 12K at audio
ANV_Q4_IQ   = 0.000129305552718;  // SOLVED: self-bias current through R27+R28
ANV_Q4_VSDC = 1.62407774214;  // SOLVED: source DC held by C9
ANV_Q4_NORM = 2013.6199334;  // SOLVED: R26 / small-signal gain

// knob laws (linear pots, CW = faster; printed 1..7)
// timing network, as drawn (sidechain.DiodeDetector has the derivation)
ANV_RPOT_A = 25000;   // R77 attack pot  | SCHEMATIC: R77 attack pot
ANV_R76    = 470;     // across the attack wiper with C22  | SCHEMATIC: R76, across the attack wiper
ANV_C22    = 0.000000022;  // SCHEMATIC: C22 speed-up cap
ANV_RPOT_R = 5000000; // R78 release pot  | SCHEMATIC: R78 release pot
ANV_R79    = 270000;  // across the release pot's lower segment  | SCHEMATIC: R79, across the release pot's lower segment
ANV_C19    = 0.0000068; // anode coupling (also C20)  | SCHEMATIC: C19/C20 anode coupling
ANV_R74    = 47000;   // anode return to the bias node (also R75)  | SCHEMATIC: R74/R75 anode return
ANV_RDSRC   = 15;      // follower output + diode bulk, an estimate  | ASSUMED: follower output + diode bulk resistance

