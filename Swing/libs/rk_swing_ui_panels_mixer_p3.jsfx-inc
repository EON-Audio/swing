// rk_swing_ui_panels_mixer_p3.jsfx-inc -- part 3 of rk_swing_ui_panels_mixer.jsfx-inc (3 parts), cut at a function boundary by
// .dev_tests/split_big_incs.py: REAPER's load time grows with the square of a file's size. Edit freely;
// keep each file under about 40 KB.

// ⚠️ @init IS LOAD-BEARING (.docs/wiki/02-file-structure.md).
@init

// ─── Sections panel: one checkbox row ─────────────────────────────────────
// Returns 1 when this row was clicked this frame. _ind indents sub-rows.
function swing_panels_copt_row(_rx, _ry, _rw, _on, _lbl, _ind) local(_hov, _bx) (
  // < 16, the rows' pitch and the wash's height: <= 18 overlapped the next row,
  // so a click on a row's bottom edge flipped two sections at once (PL I11).
  _hov = mx >= _rx && mx <= _rx + _rw && my >= _ry && my < _ry + 16;
  _hov ? ( gfx_set(1, 1, 1, 0.05); gfx_rect(_rx, _ry, _rw, 16); );
  // ⚠️ ON must be SOLID. The first version drew a light box with a dark 5×5
  // centre for on and a grey box with a dark 7×7 centre for off — at 9 px both
  // read as an empty outline and the panel looked entirely unchecked. Fill the
  // whole box and stamp a tick; off is an outline with nothing in it.
  _bx = _rx + 5 + _ind;
  _on ? (
    gfx_set(0.62, 0.88, 0.92, 1); gfx_rect(_bx, _ry + 4, 9, 9);
    gfx_set(0.05, 0.13, 0.16, 1);
    gfx_line(_bx + 2, _ry + 8, _bx + 4, _ry + 10);
    gfx_line(_bx + 4, _ry + 10, _bx + 7, _ry + 6);
    gfx_line(_bx + 2, _ry + 9, _bx + 4, _ry + 11);
    gfx_line(_bx + 4, _ry + 11, _bx + 7, _ry + 7);
  ) : (
    gfx_set(0.09, 0.10, 0.12, 1);   gfx_rect(_bx, _ry + 4, 9, 9);
    gfx_set(0.40, 0.46, 0.52, 0.9);
    gfx_rect(_bx, _ry + 4, 9, 1); gfx_rect(_bx, _ry + 12, 9, 1);
    gfx_rect(_bx, _ry + 4, 1, 9); gfx_rect(_bx + 8, _ry + 4, 1, 9);
  );
  rk_font(1, swing_fs(11), 'b');
  gfx_set(0.82, 0.89, 0.93, _on ? 1 : 0.62);
  gfx_x = _bx + 15; gfx_y = _ry + 4;
  gfx_drawstr(_lbl);
  _hov && lmb_down;
);

// A small segmented button (FULL / BAR, 4 / 6 / 8 / FIT). Same contract.
function swing_panels_copt_seg(_sx, _sy, _sw, _on, _lbl) local(_hov) (
  _hov = mx >= _sx && mx <= _sx + _sw && my >= _sy && my <= _sy + 12;
  _on ? gfx_set(0.25, 0.42, 0.47, 1) :
        (_hov ? gfx_set(0.16, 0.19, 0.22, 1) : gfx_set(0.10, 0.12, 0.14, 1));
  gfx_rect(_sx, _sy, _sw, 12);
  gfx_set(0.35, 0.45, 0.50, 0.7);
  gfx_rect(_sx, _sy, _sw, 1); gfx_rect(_sx, _sy + 11, _sw, 1);
  gfx_rect(_sx, _sy, 1, 12);  gfx_rect(_sx + _sw - 1, _sy, 1, 12);
  rk_font(1, swing_fs(10), 'b');
  gfx_set(0.85, 0.93, 0.96, _on ? 1 : 0.62);
  gfx_measurestr(_lbl, tw, th);
  gfx_x = _sx + (((_sw - tw) / 2) | 0); gfx_y = _sy + 2;
  gfx_drawstr(_lbl);
  _hov && lmb_down;
);

// ─── Sections panel ───────────────────────────────────────────────────────
// Drawn over the strips, after them, so it describes what is underneath.
// Returns 1 if it consumed this frame's click — the caller MUST honour that
// or every tick in here also dismisses the console behind it.
// Panel geometry, split out of the draw because the CALLER needs the rect
// BEFORE the mixer draws. The panel is painted last so it sits over the strips
// it describes — which means by the time it runs, the mixer has already
// consumed the click. Knowing the rect early is what lets the caller mask the
// mixer's input instead. Height is content-dependent but entirely predictable,
// so it costs nothing to know it up front.
function swing_panels_console_opts_rect(_cx, _cy, _cw) (
  _copt_pw = 200;
  _copt_px = _cx + _cw - _copt_pw - 10;
  _copt_py = _cy + 20;
  _copt_ph = 24 + 16 * 9 + (con_ins && con_ins_full ? 32 : 0)
                + 22 + 16 * 2 + 22 + 20 + 18 + 8;
);

function swing_panels_console_opts(_cx, _cy, _cw)
         local(_px, _py, _pw, _ph, _y, _ate, _i, _sx, _sw, _n) (
  swing_panels_console_opts_rect(_cx, _cy, _cw);
  _pw = _copt_pw; _px = _copt_px; _py = _copt_py; _ph = _copt_ph;

  // Translucent GROUND, opaque CONTROLS. The panel has to be readable and
  // the strips behind it have to stay judgeable; two passes get both, where
  // one alpha over everything would have to pick a loser. Painted twice so
  // the ground is dark enough for 9 px text without hiding what is under it.
  gfx_set(0.055, 0.065, 0.080, 0.62); gfx_rect(_px, _py, _pw, _ph);
  gfx_set(0.10, 0.115, 0.135, 0.42);  gfx_rect(_px, _py, _pw, _ph);
  gfx_set(0.30, 0.62, 0.70, 0.75);
  gfx_rect(_px, _py, _pw, 1); gfx_rect(_px, _py + _ph - 1, _pw, 1);
  gfx_rect(_px, _py, 1, _ph); gfx_rect(_px + _pw - 1, _py, 1, _ph);

  _ate = 0;
  rk_font(1, swing_fs(11), 'b');
  gfx_set(0.62, 0.75, 0.82, 1);
  gfx_x = _px + 6; gfx_y = _py + 6; gfx_drawstr("STRIP SECTIONS");
  _y = _py + 20;

  // INSERTS — the only row with both a mode and a count.
  // ⚠️⚠️ THE ROW MUST STOP SHORT OF ITS OWN BUTTONS. At full width the row's
  // 18 px hit rect covered the FULL/BAR segments sitting inside it, and the
  // row is tested FIRST -- so clicking FULL toggled the section OFF, and the
  // segments then sat behind `con_ins ?` and were never evaluated at all.
  // FULL and BAR were not merely hard to hit, they were unreachable.
  swing_panels_copt_row(_px, _y, con_ins ? _pw - 78 : _pw,
                        con_ins, "INSERTS", 0) ?
    ( con_ins = !con_ins; mark_dirty(); _ate = 1; );
  con_ins ? (
    swing_panels_copt_seg(_px + _pw - 74, _y + 2, 34, con_ins_full, "FULL") ?
      ( con_ins_full = 1; mark_dirty(); _ate = 1; );
    swing_panels_copt_seg(_px + _pw - 38, _y + 2, 32, !con_ins_full, "BAR") ?
      ( con_ins_full = 0; mark_dirty(); _ate = 1; );
  );
  _y += 16;
  con_ins && con_ins_full ? (
    rk_font(1, swing_fs(10), 0);
    gfx_set(0.52, 0.58, 0.63, 0.8);
    gfx_x = _px + 20; gfx_y = _y + 3; gfx_drawstr("SLOTS");
    _sw = 28; _sx = _px + _pw - 6 - _sw * 4 - 6;
    _i = 0;
    loop(4,
      _n = _i == 0 ? 4 : _i == 1 ? 6 : _i == 2 ? 8 : 0;
      swing_panels_copt_seg(_sx + _i * (_sw + 2), _y + 1, _sw, con_slots == _n,
                     _n == 0 ? "FIT" : _n == 4 ? "4" : _n == 6 ? "6" : "8") ?
        ( con_slots = _n; mark_dirty(); _ate = 1; );
      _i += 1;
    );
    _y += 16;
    // SHOW EON PLUGINS: the Drum Strip and the Macros relay the bridge puts
    // on every pad track. Off by default: the rows are for what YOU added.
    // Flipping it re-decodes the published records on the next frame.
    swing_panels_copt_row(_px + 14, _y, _pw - 14, con_ins_house, "SHOW EON PLUGINS", 0) ?
      ( con_ins_house = !con_ins_house; mark_dirty(); _conins_seq = -1; _ate = 1; );
    _y += 16;
  );

  // Same reserved zone as INSERTS — see the note there.
  swing_panels_copt_row(_px, _y, con_sw ? _pw - 78 : _pw,
                        con_sw, "SWING FX", 0) ?
    ( con_sw = !con_sw; mark_dirty(); _ate = 1; );
  con_sw ? (
    swing_panels_copt_seg(_px + _pw - 74, _y + 2, 34, con_sw_full, "FULL") ?
      ( con_sw_full = 1; mark_dirty(); _ate = 1; );
    swing_panels_copt_seg(_px + _pw - 38, _y + 2, 32, !con_sw_full, "BAR") ?
      ( con_sw_full = 0; mark_dirty(); _ate = 1; );
  );
  _y += 16;

  swing_panels_copt_row(_px, _y, _pw, con_sends, "SENDS", 0) ?
    ( con_sends = !con_sends; mark_dirty(); _ate = 1; ); _y += 16;
  swing_panels_copt_row(_px, _y, _pw, con_pan, "PAN", 0) ?
    ( con_pan = !con_pan; mark_dirty(); _ate = 1; ); _y += 16;
  swing_panels_copt_row(_px, _y, _pw, con_cut, "CUT / SOLO", 0) ?
    ( con_cut = !con_cut; mark_dirty(); _ate = 1; ); _y += 16;
  swing_panels_copt_row(_px, _y, _pw, con_fader, "FADER", 0) ?
    ( con_fader = !con_fader; mark_dirty(); _ate = 1; ); _y += 16;
  swing_panels_copt_row(_px, _y, _pw, con_meter, "METER", 0) ?
    ( con_meter = !con_meter; mark_dirty(); _ate = 1; ); _y += 16;
  swing_panels_copt_row(_px, _y, _pw, con_dbsc, "dB SCALE", 12) ?
    ( con_dbsc = !con_dbsc; mark_dirty(); _ate = 1; ); _y += 16;
  swing_panels_copt_row(_px, _y, _pw, con_name, "NAME", 0) ?
    ( con_name = !con_name; mark_dirty(); _ate = 1; ); _y += 16;

  rk_font(1, swing_fs(10), 'b');
  gfx_set(0.50, 0.62, 0.68, 0.95);
  gfx_x = _px + 6; gfx_y = _y + 7; gfx_drawstr("LAYOUT");
  gfx_set(0.30, 0.45, 0.50, 0.4); gfx_rect(_px + 4, _y + 3, _pw - 8, 1);
  _y += 22;
  swing_panels_copt_row(_px, _y, _pw, con_focus, "FOCUS STRIP", 0) ?
    ( con_focus = !con_focus; mark_dirty(); _ate = 1; ); _y += 16;
  swing_panels_copt_row(_px, _y, _pw, con_master, "MASTER STRIP", 0) ?
    ( con_master = !con_master; mark_dirty(); _ate = 1; ); _y += 16;

  rk_font(1, swing_fs(10), 'b');
  gfx_set(0.50, 0.62, 0.68, 0.95);
  gfx_x = _px + 6; gfx_y = _y + 7; gfx_drawstr("FINISH");
  gfx_set(0.30, 0.45, 0.50, 0.4); gfx_rect(_px + 4, _y + 3, _pw - 8, 1);
  _y += 22;
  // Swatches painted by the same function that paints the desk, so the chip
  // cannot promise a colour the console does not then use.
  _sw = 28; _sx = _px + 6; _i = 0;
  loop(6,
    _n = con_bg; con_bg = _i; swing_panels_console_bg(1); con_bg = _n;
    gfx_rect(_sx + _i * (_sw + 3), _y, _sw, 16);
    con_bg == _i ? gfx_set(0.75, 0.92, 0.95, 1) : gfx_set(0.35, 0.42, 0.47, 0.7);
    gfx_rect(_sx + _i * (_sw + 3), _y, _sw, 1);
    gfx_rect(_sx + _i * (_sw + 3), _y + 15, _sw, 1);
    gfx_rect(_sx + _i * (_sw + 3), _y, 1, 16);
    gfx_rect(_sx + _i * (_sw + 3) + _sw - 1, _y, 1, 16);
    mx >= _sx + _i * (_sw + 3) && mx <= _sx + _i * (_sw + 3) + _sw &&
    my >= _y && my <= _y + 16 && lmb_down ?
      ( con_bg = _i; mark_dirty(); _ate = 1; );
    _i += 1;
  );
  _y += 20;

  // Fader fill: how much pad colour the well wears. At full-window height the
  // floor-to-cap fill is a SLAB, and sixteen of them is most of what the eye
  // sees — so it is a choice, next to the finish it sits on. Paint only:
  // the fader's throw and zero are calibration, never options.
  rk_font(1, swing_fs(10), 'b');
  gfx_set(0.50, 0.62, 0.68, 0.95);
  gfx_x = _px + 6; gfx_y = _y + 2; gfx_drawstr("FADER FILL");
  swing_panels_copt_seg(_px + _pw - 110, _y, 34, con_wf == 0, "FULL") ?
    ( con_wf = 0; mark_dirty(); _ate = 1; );
  swing_panels_copt_seg(_px + _pw - 74, _y, 34, con_wf == 1, "EDGE") ?
    ( con_wf = 1; mark_dirty(); _ate = 1; );
  swing_panels_copt_seg(_px + _pw - 38, _y, 32, con_wf == 2, "OFF") ?
    ( con_wf = 2; mark_dirty(); _ate = 1; );

  // Any click anywhere inside the panel belongs to the panel, whether or not
  // it landed on a control — otherwise a miss falls through to "outside the
  // console" and closes the whole view.
  mx >= _px && mx <= _px + _pw && my >= _py && my <= _py + _ph && lmb_down ?
    _ate = 1;
  _ate;
);

// ─── Compact FX picker, over the console ──────────────────────────────────
// Geometry lives in its own function because the CALLER needs the rect before
// the strips draw -- the same lesson the sections panel taught: a panel that
// only knows where it is once it paints has already let the click through.
function swing_panels_pick_rect(_cx, _cy, _cw, _ch) (
  _cpk_w = 320;
  _cpk_h = min(_ch - 40, 398);   // +18 over the first cut: the search row's cost
  // Anchored to the slot you clicked, then clamped inside the console so it
  // never hangs off the edge on channel 1 or 16.
  _cpk_x = max(_cx + 6, min(_cx + _cw - _cpk_w - 6, con_pick_x - 40));
  _cpk_y = max(_cy + 22, min(_cy + _ch - _cpk_h - 6, con_pick_y));
);

// Returns 1 if it consumed this frame's click.
function swing_panels_pick_draw(_cx, _cy, _cw, _ch)
         local(_x, _y, _w, _h, _ate, _i, _ry, _rh, _n, _p, _hov, _len, _j,
               _vis, _card, _cx2, _cy2, _cw2, _crow, _more, _bp, _blen,
               _bsel, _chh, _mw, _mk_x, _mk_row, _tp) (
  swing_panels_pick_rect(_cx, _cy, _cw, _ch);
  _x = _cpk_x; _y = _cpk_y; _w = _cpk_w; _h = _cpk_h;

  // ⚠️ TAKE THE SNAPSHOT OURSELVES. _fxv_rows is only refreshed by the BIG
  // view's draw, which is not running -- the console is. Without this the
  // picker reads whatever page was last published to some other view, or
  // nothing at all, and looks empty for no visible reason.
  swing_fxview_snapshot();
  // ⚠️ AND THE BANKS. swing_fxview_banks_snap() is called from exactly one
  // other place -- inside the BIG view's draw -- so without this the chip
  // row is empty and nothing anywhere says why. Same shape as the row
  // snapshot above, which had the identical hole.
  swing_fxview_banks_snap();
  // Same escape hatch the LCD tabs needed: the ack timeout only counts up
  // in the big view's draw, so a lost ack would latch actions off here too.
  _fxv_await += 1;

  // ESC: clear the search first if there is one, then close — the big
  // view's order. A modal you cannot dismiss with the key everything else
  // uses is one people click around rather than close.
  _char == 27 ? (
    _fxv_qn > 0 ? (
      swing_fxview_q_clear(); swing_fxview_q_send();
      con_pick_scroll = 0; swing_fxview_request(0, 24);
    ) : con_pick_open = 0;
    _char = 0;                                       // consumed either way
  );
  _ate = 0;
  _rh = 30;

  // Ground: solid, unlike the sections panel. That one is translucent because
  // you are judging the strips THROUGH it; this one you are reading, and a
  // plugin list over a moving meter is unreadable.
  gfx_set(0.055, 0.065, 0.080, 0.98); gfx_rect(_x, _y, _w, _h);
  gfx_set(0.30, 0.62, 0.70, 0.75);
  gfx_rect(_x, _y, _w, 1); gfx_rect(_x, _y + _h - 1, _w, 1);
  gfx_rect(_x, _y, 1, _h); gfx_rect(_x + _w - 1, _y, 1, _h);

  // Header says WHERE the pick will land. A picker that does not name its
  // target is one you have to remember the state of.
  rk_font(1, swing_fs(11), 'b');
  gfx_set(0.62, 0.75, 0.82, 1);
  gfx_x = _x + 8; gfx_y = _y + 6;
  gfx_drawstr(con_pick_fill ? "REPLACE  " : "ADD TO  ");
  gfx_set(0.85, 0.92, 0.96, 1);
  // A strip of banks B-D that plays through its bank's pair adds to the whole BANK (its container or track is
  // shared by the bank's pads): say so. Otherwise the pad, by its label ("3", or "C3" off screen).
  // (not for MASTER: its con_pick_ap is swing_bp(16), past p_output on bank D -- Codex audit 2026-10-13)
  _tp = con_pick_pad >= 16 ? -1 : multi_out ? swing_out_pair(con_pick_ap) : swing_out_wpair(con_pick_ap, patch_live ? patch_v2 : 1);
  con_pick_pad >= 16 ? gfx_drawstr("MASTER") :
  _tp >= OUT_PAIR_BANK && _tp < OUT_PAIR_SPLIT ? (
    gfx_drawstr("BANK "); gfx_drawstr(sprintf(#_cpk_lbl, "%c", 66 + _tp - OUT_PAIR_BANK));
  ) : (
    gfx_drawstr("PAD "); swing_pad_lbl(con_pick_ap, #_cpk_lbl); gfx_drawstr(#_cpk_lbl);
  );
  // A slot number only for a REPLACE: an add opens from an empty row (slot -1),
  // lands at the chain's end, and read "SLOT 0" (PL I12).
  con_pick_slot >= 0 ? ( gfx_drawstr("  ·  SLOT "); gfx_drawnumber(con_pick_slot + 1, 0); );

  // The TOTAL, right-aligned before the X — a windowed list must never be
  // able to read as "all there is". This is the filtered total, straight
  // off the published page.
  rk_font(1, swing_fs(10), 0);
  gfx_set(0.55, 0.62, 0.68, 0.9);
  sprintf(#_cpk_tot, "%d FX", _fxv_total | 0);
  gfx_measurestr(#_cpk_tot, tw, th);
  gfx_x = _x + _w - 28 - tw; gfx_y = _y + 7;
  gfx_drawstr(#_cpk_tot);

  // Close X
  _hov = mx >= _x + _w - 20 && mx <= _x + _w - 4 &&
         my >= _y + 3 && my <= _y + 19;
  rk_font(1, swing_fs(12), 'b');
  gfx_set(1, 1, 1, _hov ? 0.95 : 0.5);
  gfx_x = _x + _w - 16; gfx_y = _y + 5; gfx_drawstr("X");
  _hov && lmb_down ? ( con_pick_open = 0; _ate = 1; );

  // ── Search, reusing the big view's ONE query engine ─────────────────────
  // Same buffer, same send — there is no second filter path to drift. The
  // box exists here because the filter it feeds was invisible before: a
  // query left behind by the big view kept shaping this list with nothing
  // on screen to say so.
  _cpk_qy = _y + 22;
  gfx_set(0.03, 0.04, 0.05, 0.9);
  gfx_rect(_x + 6, _cpk_qy, _w - 12, 18);
  _cpk_qfoc && !is_embedded ? (
    gfx_set(0.35, 0.60, 0.85, 0.75);
    gfx_rect(_x + 6, _cpk_qy, _w - 12, 1);
    gfx_rect(_x + 6, _cpk_qy + 17, _w - 12, 1);
  );
  _hov = mx >= _x + 6 && mx <= _x + _w - 6 &&
         my >= _cpk_qy && my <= _cpk_qy + 18;
  !is_embedded && lmb_down && _hov ? ( _cpk_qfoc = 1; _fxv_qc = _fxv_qn; _ate = 1; );
  !is_embedded && lmb_down && !_hov ? _cpk_qfoc = 0;
  rk_font(1, swing_fs(11), 0);
  _fxv_qn > 0 ? (
    gfx_set(0.88, 0.92, 0.96, 1);
    gfx_x = _x + 12; gfx_y = _cpk_qy + 3;
    _j = 0; tw = gfx_x;
    loop(_fxv_qn,
      _j == _fxv_qc ? tw = gfx_x;
      gfx_drawchar(_fxv_q[_j] | 0);
      _j += 1;
    );
    _fxv_qc >= _fxv_qn ? tw = gfx_x;
    // x clears — never an exit path that depends only on a key.
    rk_font(1, swing_fs(12), 'b');
    gfx_set(0.75, 0.45, 0.42,
            mx >= _x + _w - 24 && mx <= _x + _w - 6 &&
            my >= _cpk_qy && my <= _cpk_qy + 18 ? 1 : 0.55);
    gfx_x = _x + _w - 20; gfx_y = _cpk_qy + 2; gfx_drawstr("x");
    lmb_down && mx >= _x + _w - 24 && mx <= _x + _w - 6 &&
      my >= _cpk_qy && my <= _cpk_qy + 18 ? (
      swing_fxview_q_clear(); swing_fxview_q_send();
      con_pick_scroll = 0; swing_fxview_request(0, 24);
      _ate = 1;
    );
  ) : (
    gfx_set(0.38, 0.44, 0.50, 0.9);
    gfx_x = _x + 12; gfx_y = _cpk_qy + 3;
    gfx_drawstr(is_embedded ? "search needs the floating window" : "search…");
    tw = _x + 12;
  );
  // Caret. ⚠️ Fractional part taken explicitly — EEL2 % truncates BOTH
  // operands, so t % 1.0 is always 0 and the caret never blinks, silently.
  _cpk_qfoc && !is_embedded ? (
    _cpk_t = time_precise();
    _cpk_t - (_cpk_t | 0) < 0.62 ? (
      gfx_set(0.99, 1, 1, 0.9);
      gfx_rect(tw, _cpk_qy + 2, 1, 13);
    );
  );
  // Keys, only while focused: chars and backspace, CONSUMED so nothing
  // behind the box acts on them. ESC was handled above.
  _cpk_qfoc && !is_embedded && _char != 0 ? (
    _char == 8 ? (
      swing_fxview_q_del(_fxv_qc - 1);
      _fxv_qc > 0 ? _fxv_qc -= 1;
      _cpk_qdirty = 1; _char = 0;
    ) : _char >= 32 && _char <= 126 ? (
      swing_fxview_q_ins(_char);
      _cpk_qdirty = 1; _char = 0;
    );
  );
  _cpk_qdirty ? (
    _cpk_qdirty = 0;
    con_pick_scroll = 0;
    swing_fxview_q_send();
    // q_send's own ask is scaled by the BIG view's window (_fxv_want);
    // re-ask sized for this one. The bridge answers the latest request.
    swing_fxview_request(0, 24);
  );

  // ── Category chips ────────────────────────────────────────────────────
  // The bridge already publishes the bank list -- ALL, RECENT, the user's FX
  // folders, then categories by member count -- and apply_query already
  // filters by it. So this sets _fxv_bank and re-asks; it is NOT a second
  // filter path, and a second one would drift from the big view's.
  //
  // Chips, not a rail: at 320 px a left rail costs a third of the width, and
  // the width is what the plugin NAMES need.
  _cy2 = _y + 42; _cx2 = _x + 6; _crow = 0; _more = 0;   // 42: header + search row
  rk_font(1, swing_fs(11), 'b');
  // The "+N" overflow marker needs a seat of its own. It used to sit at a fixed
  // _w - 30, which is UNDER whatever chip happens to end there -- on the shipped
  // build "+23" showed as a lone "3" poking out past the last chip. Measured
  // once, at the widest count it can show, and reserved on the last row only
  // for a chip that still has successors; the final chip may run to the edge.
  gfx_measurestr("+88", _mw, th);
  _mk_x = _cx2; _mk_row = 0;
  _i = -1;
  loop(_fxv_bn + 1,
    // -1 is the ALL chip, which is "no bank" rather than a published row --
    // the rail expresses that as _fxv_bank == -1 and so does this.
    _i < 0 ? (
      strcpy(#_cpk_nm, "ALL");
      _bsel = _fxv_bank < 0;
    ) : (
      _bp = _fxv_banks + _i * FXP_TREC;
      _blen = min(24, _bp[FXP_TB_LEN] | 0);
      strcpy(#_cpk_nm, "");
      _j = 0;
      loop(_blen, str_setchar(#_cpk_nm, _j, _bp[FXP_TB_NAME + _j] | 0); _j += 1; );
      str_setlen(#_cpk_nm, _blen);
      _bsel = _fxv_bank == _i;
    );
    gfx_measurestr(#_cpk_nm, tw, th);
    _cw2 = tw + 12;
    // Wrap to a second row, then stop: two rows is the most this can spend
    // before it is taller than the list it filters.
    _cx2 + _cw2 > _x + _w - 6 ? ( _crow += 1; _cx2 = _x + 6; );
    _crow == 1 && _i < _fxv_bn - 1 && _cx2 + _cw2 > _x + _w - 6 - _mw - 3 ? _crow = 2;
    _crow > 1 ? ( _more += 1; ) : (
      _ry = _cy2 + _crow * 17;
      _hov = mx >= _cx2 && mx <= _cx2 + _cw2 && my >= _ry && my <= _ry + 14;
      _i >= 0 && (_fxv_banks + _i * FXP_TREC)[FXP_TB_KIND] == 3 ? (
        // Categories carry the ONE colour vocabulary the cards, pips and rail
        // already share -- a category must not be a different colour here.
        swing_fxview_bucket_col((_fxv_banks + _i * FXP_TREC)[FXP_TB_BUCK] | 0);
        gfx_a = _bsel ? 0.95 : (_hov ? 0.55 : 0.30);
      ) : (
        _bsel ? gfx_set(0.30, 0.52, 0.62, 0.95)
              : (_hov ? gfx_set(0.22, 0.30, 0.38, 0.9)
                      : gfx_set(0.14, 0.17, 0.21, 0.9));
      );
      gfx_rect(_cx2, _ry, _cw2, 14);
      gfx_a = 1;
      gfx_set(0.92, 0.96, 0.99, _bsel ? 1 : 0.78);
      gfx_x = _cx2 + 6; gfx_y = _ry + 2;
      gfx_drawstr(#_cpk_nm);
      _hov && lmb_down ? (
        // Same commit the rail makes: a different bank is a different result
        // set, so the scroll resets rather than holding a meaningless place.
        _fxv_bank = (_i < 0 || _fxv_bank == _i) ? -1 : _i;
        con_pick_scroll = 0;
        swing_fxview_q_send();
        // ⭐ Re-ask sized for THIS window. q_send's ask is _fxv_want*2, and
        // _fxv_want is 0 until the big view has ever opened — the bridge
        // answered a bank click with a TWO-row page, which on this face
        // looked like the bank held two plugins.
        swing_fxview_request(0, 24);
        _ate = 1;
      );
      _cx2 += _cw2 + 3;
      _mk_x = _cx2; _mk_row = _crow;   // where "+N" goes: right after the last chip drawn
    );
    _i += 1;
  );
  // No silent truncation: say how many did not fit -- in the seat reserved above.
  _more > 0 ? (
    gfx_set(0.55, 0.60, 0.66, 0.8);
    gfx_x = _mk_x; gfx_y = _cy2 + _mk_row * 17 + 2;
    gfx_drawstr("+"); gfx_drawnumber(_more, 0);
  );

  // Rows, straight off the page the bridge already published for this slot --
  // the same snapshot the big view reads, so there is no second result set to
  // keep in step.
  _chh = 42 + (min(1, _crow) + 1) * 17;
  _vis = ((_h - 6 - _chh) / _rh) | 0;
  // C-5, as the big view: unslotted, the snapshot is slot 0's page (another
  // Swing's) and swing_fxview_act refuses the pick -- so no rows, and say why (PL I13).
  _n = _reg_my_slot >= 0 ? min(_fxv_n, _vis) : 0;
  _fxv_n < 1 || _reg_my_slot < 0 ? (
    rk_font(1, swing_fs(11), 0);
    gfx_set(0.55, 0.60, 0.66, 0.8);
    gfx_x = _x + 10; gfx_y = _y + _chh + 8;
    gfx_drawstr(_reg_my_slot < 0 ? "Registry full — this Swing has no slot, so its picker is off."
              : _conins_stale ? "No bridge — the FX list is unavailable."
              : _fxv_qn > 0  ? "No matches — x or ESC clears the search."
                             : "No plugins to show yet…");
  );
  _i = 0;
  loop(_n,
    _ry = _y + _chh + _i * _rh;
    _p = _fxv_rows + _i * FXP_REC;
    _len = min(40, _p[FXP_R_LEN] | 0);
    _hov = mx >= _x + 2 && mx <= _x + _w - 2 && my >= _ry && my < _ry + _rh;
    _hov ? (
      gfx_set(0.16, 0.26, 0.34, 0.95); gfx_rect(_x + 2, _ry, _w - 4, _rh - 1);
      // Full name in the tooltip — the row clips at 40 chars and then again
      // at the panel edge, and a picker that cannot say which "Tape…" this
      // is makes you click to find out.
      strcpy(#_cpk_tip, "");
      _j = 0;
      loop(_len, str_setchar(#_cpk_tip, _j, _p[FXP_R_NAME + _j] | 0); _j += 1; );
      str_setlen(#_cpk_tip, _len);
      swing_tooltip_check(1240 + _i, #_cpk_tip);
    );
    _card = _p[FXP_R_CARD];
    _card >= 0 ? swing_fxcard_draw(_x + 6, _ry + 3, 40, 23, _card)
              : swing_fxview_blank_card(_x + 6, _ry + 3, 40, 23,
                  swing_fxview_bucket_hex(_p[FXP_R_BUCKET] | 0),
                  _p[FXP_R_RIDX], _p[FXP_R_BUCKET] | 0);
    rk_font(1, swing_fs(12), _hov ? 'b' : 0);
    gfx_set(0.86, 0.91, 0.95, _hov ? 1 : 0.85);
    gfx_x = _x + 52; gfx_y = _ry + 8;
    _j = 0;
    loop(_len,
      gfx_x <= _x + _w - 12 ? gfx_drawchar(_p[FXP_R_NAME + _j] | 0);
      _j += 1;
    );
    // ⭐ Picking CLOSES it. The whole reason this exists is that the
    // full-window picker left you in the browser after the pick, with the
    // desk you were working on hidden behind it.
    _hov && lmb_down ? (
      // AIM AGAIN, like every other act site: a float or bypass on another
      // strip while this is open (or follow_pad on a console close) re-aims
      // the bridge, and the pick landed on THAT chain under this header
      // (PL I5). The master is -1 to the bridge, not its con_pick_ap.
      swing_panels_ins_aim(con_pick_pad >= 16 ? -1 : con_pick_ap, con_pick_slot, con_pick_fill);
      swing_fxview_act(con_pick_fill ? FXA_SWAP : FXA_INSERT,
                       con_pick_slot, _p[FXP_R_RIDX] | 0);
      con_pick_open = 0;
      _ate = 1;
    );
    _i += 1;
  );

  // Wheel pages the published window rather than scrolling a local list: the
  // face only ever holds one page, so "scrolling" IS asking for a different
  // one. Clamped to the tail so the last page can't scroll off into blank.
  mx >= _x && mx <= _x + _w && my >= _y && my <= _y + _h && frame_wheel ? (
    con_pick_scroll = max(0, min(max(0, _fxv_total - _vis),
                       con_pick_scroll - (frame_wheel > 0 ? 3 : -3)));
    swing_fxview_request(con_pick_scroll, _vis);
    _ate = 1;
  );

  // Scrollbar: honest, from the PUBLISHED window (_fxv_off), so it shows
  // where the bridge actually is, not where the last ask hoped to be.
  // Wheel is the gesture; the bar is the position.
  _fxv_total > _vis && _vis > 0 ? (
    _cpk_sy = _y + _chh; _cpk_sh = _vis * _rh - 4;
    gfx_set(1, 1, 1, 0.07);
    gfx_rect(_x + _w - 5, _cpk_sy, 3, _cpk_sh);
    _cpk_th = max(8, (_cpk_sh * _vis / _fxv_total) | 0);
    _cpk_ty = ((_cpk_sh - _cpk_th) *
               max(0, min(1, _fxv_off / max(1, _fxv_total - _vis)))) | 0;
    gfx_set(0.45, 0.62, 0.72, 0.85);
    gfx_rect(_x + _w - 5, _cpk_sy + _cpk_ty, 3, _cpk_th);
  );

  // Anything inside belongs to the picker, hit or miss -- otherwise a miss
  // falls through and closes the console behind it.
  mx >= _x && mx <= _x + _w && my >= _y && my <= _y + _h && lmb_down ? _ate = 1;
  _ate;
);

// ─── Full-window console (big_view_id == VIEW_CONSOLE) ─────────────────────
// Draws the SAME mixer as a modal overlay. The modal gate
// (swing_ui_modal_gate) suppressed all mouse input this frame because a big
// view is open; restore it here for the console's own controls — exactly the
// trick the pad overlay uses via the _ov_* saved copies — and re-suppress the
// left button and the wheel before returning. Close = X button or a click
// outside the panel.
// The console used to paint into the pad-grid rect, which is what forced a
// 26 px strip. It never had to: the modal gate already dims the whole window
// below the header, so the panel can own all of it. Four numbers, and a strip
// goes 26 px → 44 px at 16 channels.
function swing_panels_draw_mixer_big() (
  // ⚠️ RMB too. The modal gate has always SAVED the right button, and this
  // function has always forgotten to restore it -- which is the entire
  // reason right-click never reached a console strip. One line.
  lmb_down = _ov_lmb_down; LMB = _ov_LMB; frame_wheel = _ov_wheel;
  rmb_down = _ov_rmb_down; RMB = _ov_RMB;

  // ── Console-hosted pad-name edit: route input the tick could not see ──
  // swing_pne_tick runs before the modal gate's saves are restored, so while
  // the console hosts an edit the tick is blind to the mouse. Same contract
  // as the tick's own handling: inside the box = caret placement and the box
  // owns the click; outside = commit, and the click stays live so whatever
  // it landed on responds normally.
  pne_pad >= 0 && pne_host_con && !is_embedded ? (
    lmb_down || rmb_down ? (
      swing_pne_mouse_in_box() ? (
        lmb_down ? swing_pne_click_caret(mx);
        lmb_down = 0; LMB = 0; rmb_down = 0; RMB = 0;
      ) : swing_pne_commit();
    );
    swing_pne_mouse_in_box() ? frame_wheel = 0;
  );

  // ── Insert-slot menu result ──────────────────────────────────────────────
  // The popup answers on a LATER frame, by which time the pointer has moved
  // and the slot that was clicked is long gone — hence _ins_menu_ap/_slot,
  // latched when the menu opened.
  //
  // Result numbers follow gfx_showmenu exactly: headers count, separators do
  // not. Filled: 1 header, 2 float, 3 open in FX picker, 4 TCP, 5 MCP,
  // 6 bypass, 7 offline, 8 delete. Empty: 1 header, 2 add.
  //
  // Every action AIMS first. The bridge resolves a verb against whatever the
  // target says, and aiming is what makes "delete slot 3" mean this pad's
  // slot 3 rather than whatever REAPER last touched.
  swing_popup_result > 0 && swing_popup_caller_id == SP_POPUP_CALLER_INS_SLOT ? (
    _insm_r = swing_popup_result;
    swing_panels_ins_aim(_ins_menu_ap, _ins_menu_slot, _ins_menu_filled);
    _ins_menu_filled ? (
      // Renumbered when Float was added at 2 -- headers count, separators
      // do not, so every row below it shifted by one.
      _insm_r == 2 ? swing_fxview_act(FXA_FLOAT,     _ins_menu_slot, -1) :
      _insm_r == 3 ? swing_bigview_open(VIEW_FXPICK) :
      _insm_r == 4 ? swing_fxview_act(FXA_EMBED_TCP, _ins_menu_slot, -1) :
      _insm_r == 5 ? swing_fxview_act(FXA_EMBED_MCP, _ins_menu_slot, -1) :
      _insm_r == 6 ? swing_fxview_act(FXA_ENABLE,    _ins_menu_slot, -1) :
      _insm_r == 7 ? swing_fxview_act(FXA_OFFLINE,   _ins_menu_slot, -1) :
      _insm_r == 8 ? swing_fxview_act(FXA_REMOVE,    _ins_menu_slot, -1);
    ) : (
      _insm_r == 2 ? swing_bigview_open(VIEW_FXPICK);
    );
    swing_popup_result = 0;   // consumed — the caller's half of the contract
  );

  _con_x = 8; _con_y = 34 + swing_banktabs_h();   // under the header and the bank strip (step 4b; none on the rack face)
  _con_w = max(120, gfx_w - 16);
  _con_h = max(120, gfx_h - 42 - swing_banktabs_h());

  // Dim everything below the header, then the console panel over all of it.
  gfx_set(0, 0, 0, 0.45);
  gfx_rect(0, 28, gfx_w, gfx_h - 28);
  swing_panels_console_bg(0.98);
  gfx_rect(_con_x, _con_y, _con_w, _con_h);
  con_bg == 5 ? gfx_set(0.35, 0.38, 0.42, 0.7) : gfx_set(0.30, 0.75, 0.85, 0.5);
  gfx_rect(_con_x, _con_y, _con_w, 1);
  gfx_rect(_con_x, _con_y + _con_h - 1, _con_w, 1);
  gfx_rect(_con_x, _con_y, 1, _con_h);
  gfx_rect(_con_x + _con_w - 1, _con_y, 1, _con_h);

  // Title + close X — through the ink, which is the entire reason the ink
  // function exists. (Its dark-desk side IS this cyan, so the dark finishes
  // are pixel-identical to what they were.)
  rk_font(1, swing_fs(12), 'b');
  swing_panels_console_ink(0.9);
  gfx_x = _con_x + 8; gfx_y = _con_y + 4;
  gfx_drawstr("CONSOLE");
  _mixb_cx = _con_x + _con_w - 20; _mixb_cy = _con_y + 3;
  _mixb_chov = mx >= _mixb_cx - 3 && mx <= _mixb_cx + 17 && my >= _mixb_cy - 2 && my <= _mixb_cy + 15;
  rk_font(1, swing_fs(13), 'b');
  con_bg == 5 ? gfx_set(0.10, 0.12, 0.15, _mixb_chov ? 0.95 : 0.60)
              : gfx_set(1, 1, 1, _mixb_chov ? 0.95 : 0.55);
  gfx_x = _mixb_cx + 3; gfx_y = _mixb_cy;
  gfx_drawstr("X");

  // Gear: opens the strip-sections panel. Sits left of the X, drawn as a
  // bracketed dot rather than a glyph — the console cannot depend on a font
  // having ⚙, and a missing glyph is an invisible button.
  _mixb_gx = _con_x + _con_w - 42; _mixb_gy = _con_y + 3;
  _mixb_ghov = mx >= _mixb_gx - 3 && mx <= _mixb_gx + 15 && my >= _mixb_gy - 2 && my <= _mixb_gy + 15;
  swing_panels_console_ink(con_opt_open ? 0.95 : (_mixb_ghov ? 0.85 : 0.5));
  gfx_rect(_mixb_gx, _mixb_gy + 2, 2, 10);
  gfx_rect(_mixb_gx + 10, _mixb_gy + 2, 2, 10);
  gfx_rect(_mixb_gx + 4, _mixb_gy + 5, 4, 4);
  _mixb_ghov ? swing_tooltip_check(1051, "Strip sections: choose what every channel shows.");

  // Re-point the LCD content rect at the panel interior and reuse the mixer.
  _mixb_sx = _lcd_cx; _mixb_sy = _lcd_cy; _mixb_sw = _lcd_cw; _mixb_sh = _lcd_ch;
  _lcd_cx = _con_x + 8;  _lcd_cy = _con_y + 20;
  // The panel FLOATS over the strips rather than pushing them narrower.
  // Squeezing 16 channels to make room changed the very thing you were
  // trying to judge — every strip got thinner the moment you opened the
  // settings, so you were never looking at the layout you were editing.
  // It is translucent instead: see swing_panels_console_opts.
  _lcd_cw = _con_w - 16;
  _lcd_ch = _con_h - 28;

  // ⚠️ INPUT MASK — the panel is painted AFTER the strips so it sits over what
  // it describes, which means the mixer has already handled the click by the
  // time the panel gets a look at it. Returning "I ate that" afterwards is too
  // late: the knob under the checkbox has already moved. So the pointer is
  // moved off-screen and the buttons cleared for the mixer's whole pass, and
  // restored immediately after. Off-screen rather than just clearing the
  // buttons, because hover states, tooltips and drag-starts all read mx/my.
  //
  // Only while active_id == -1: a fader drag that STARTED outside the panel
  // must keep tracking when the pointer wanders under it. You cannot begin a
  // gesture through the panel; you can finish one.
  swing_panels_console_opts_rect(_con_x, _con_y, _con_w);
  swing_panels_pick_rect(_con_x, _con_y, _con_w, _con_h);
  _copt_mask = active_id == -1 && (
    (con_opt_open &&
     ((mx >= _copt_px && mx <= _copt_px + _copt_pw &&
       my >= _copt_py && my <= _copt_py + _copt_ph) || _mixb_ghov))
    // The compact picker needs the SAME protection the sections panel does:
    // it floats over live strips, and a click landing on a plugin row must
    // not also move the fader beneath it.
    || (con_pick_open &&
        mx >= _cpk_x && mx <= _cpk_x + _cpk_w &&
        my >= _cpk_y && my <= _cpk_y + _cpk_h));
  _copt_mask ? (
    _copt_smx = mx; _copt_smy = my;
    _copt_slmb = lmb_down; _copt_slm2 = LMB; _copt_swh = frame_wheel;
    mx = -10000; my = -10000;
    lmb_down = 0; LMB = 0; frame_wheel = 0;
  );

  swing_panels_draw_mixer();

  _copt_mask ? (
    mx = _copt_smx; my = _copt_smy;
    lmb_down = _copt_slmb; LMB = _copt_slm2; frame_wheel = _copt_swh;
  );
  _lcd_cx = _mixb_sx; _lcd_cy = _mixb_sy; _lcd_cw = _mixb_sw; _lcd_ch = _mixb_sh;

  // Sections panel LAST, so it sits over the strips it is describing. It
  // consumes its own clicks and reports back whether it swallowed this one.
  // ⚠️ The picker paints OVER the panel but runs after it, so the panel saw a
  // click on a plugin row first and flipped the section under it (PL I6). The
  // same mask the strips get, for the picker's rect -- re-measured, because a
  // slot click in the mixer pass just above can have opened or moved it.
  _mixb_opt_ate = 0;
  con_opt_open ? (
    swing_panels_pick_rect(_con_x, _con_y, _con_w, _con_h);
    _copt_pmask = con_pick_open && mx >= _cpk_x && mx <= _cpk_x + _cpk_w &&
                  my >= _cpk_y && my <= _cpk_y + _cpk_h;
    _copt_pmask ? (
      _copt_smx = mx; _copt_smy = my; _copt_slmb = lmb_down;
      mx = -10000; my = -10000; lmb_down = 0;
    );
    _mixb_opt_ate = swing_panels_console_opts(_con_x, _con_y, _con_w);
    _copt_pmask ? ( mx = _copt_smx; my = _copt_smy; lmb_down = _copt_slmb; );
  );
  // Picker LAST: it is the newest thing on screen and the most modal.
  con_pick_open ?
    _mixb_opt_ate = swing_panels_pick_draw(_con_x, _con_y, _con_w, _con_h)
                    || _mixb_opt_ate;

  _mixb_ghov && lmb_down && active_id == -1 ? (
    con_opt_open = !con_opt_open;
    _mixb_opt_ate = 1;
  );

  // Close: X click, or click outside the panel (only when no drag is active
  // so releasing a fader drag outside the rect can't dismiss the console).
  // The sections panel gets first refusal on the click — without that, every
  // checkbox tick would also close the console behind it.
  _mixb_out = mx < _con_x || mx > _con_x + _con_w || my < _con_y || my > _con_y + _con_h;
  _mixb_opt_ate ? ( _mixb_chov = 0; _mixb_out = 0; );
  lmb_down && (_mixb_chov || (_mixb_out && active_id == -1)) ? (
    swing_bigview_close();
    active_id = -1;
  );

  lmb_down = 0; LMB = 0; frame_wheel = 0;
);

