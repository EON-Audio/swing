// rk_weld_face.jsfx-inc — EON Weld's console faceplate, the drawn parts.
// (c) EON Studios — All Rights Reserved
//
// The pieces of Weld's face that more than one host draws: the fixed console
// palette, the LED value window, the ladder marks, the push button with its
// lamp, the engraved separator, the rack screws, the knob cap colours and the
// printed ladders for the six bus-compressor knobs. EON Weld draws its own
// window from these; Swing draws its master COMP page from the same parts, so
// a change to the face lands in both places at once.
//
// Host contract (set before drawing, every frame):
//   wface_palette()   — seats the console grey palette (wface_bg/pn/tx/td/ac)
//   wface_sc          — the face scale (1.0 = the 420-wide floating card)
//   mx, my            — the host's mouse position (wface_btn reads them)
//   #wface_val / #wface_lbl / #wface_lad — the strings the parts print
// Interaction stays in the host: these functions only draw (wface_btn returns
// hover, nothing more). Fonts: every Arial font goes through rk_font below,
// which keeps each size in a slot of its own (2..15); slots 0, 1 and 16 stay
// with the host's own direct calls. Knob style 21 (the G-series knob) is what
// wface_knob_cell draws; the host's own style choice does not reach the card.
//
// ⚠️ EON_Weld.jsfx's window must stay pixel-identical across any edit here:
// .dev_tests/weld_face_shot.sh before/after + a PIL diff is the gate.

@init

// ── rk_font: one slot per font (Swing and EON Weld) ────────────────────────────
// A gfx_setfont that gives a slot a NEW size or flags makes REAPER build that font again, and the next
// text call pays for it: ~185 us, against ~1.5 us with the font unchanged (measured 2026-10-11). Swing
// re-sized slot 1 150-230 times a frame, a third of REAPER's drawing time with its window open
// (.docs/audits/Swing_Speed_Checks_Plan_2026-10-11.md). rk_font keeps each Arial (size, flags) in a slot
// of its own, 2..15: it defines the slot the first time and only selects it after that. When a fifteenth
// one turns up, the slot used longest ago is defined again (the busiest view measured needs 14).
// It lives here because this is the first drawing library BOTH hosts import (Swing, EON Weld): every
// other font user in either comes after it, and EEL2 resolves a call where the caller is defined.
//
//   rk_font(slot, size, flags) replaces gfx_setfont(slot, "Arial", size, flags). `slot` is the slot the
//     call used before the cache; only rk_font_direct reads it.
//   ⚠️ Nothing else may set slots 2..15 in Swing or EON Weld, or the cache hands out a slot whose font
//     changed behind it (.dev_tests/font_slot_check.py). Slots 0, 1 and 16 stay with the code that sets
//     them itself: rk_vu, rk_theme, the popups, the theme menu, the non-Arial faces.
//   The cache starts over when the drawing place changes (embedded or not, its size, its retina scale):
//     an embedded face and the floating window are not known to share font slots.
//   rk_font_direct = 1 turns every call back into the direct gfx_setfont (verification; nothing sets it).
//     Those direct calls overwrite slots the cache filled, so flipping it starts the cache over too
//     (measured 2026-10-11: without that, the first pages drawn after flipping back came out in old sizes).
function rk_font(slot, sz, fl) local(key, k, b, bu) (
  (gfx_ext_flags & 1) != rkf_cx_e || gfx_w != rkf_cx_w || gfx_h != rkf_cx_h || gfx_ext_retina != rkf_cx_r ||
  rk_font_direct != rkf_cx_d ? (
    rkf_cx_e = (gfx_ext_flags & 1); rkf_cx_w = gfx_w; rkf_cx_h = gfx_h; rkf_cx_r = gfx_ext_retina;
    rkf_cx_d = rk_font_direct;
    rkf_k2 = -1; rkf_k3 = -1; rkf_k4 = -1; rkf_k5 = -1; rkf_k6 = -1; rkf_k7 = -1; rkf_k8 = -1;
    rkf_k9 = -1; rkf_k10 = -1; rkf_k11 = -1; rkf_k12 = -1; rkf_k13 = -1; rkf_k14 = -1; rkf_k15 = -1;
  );
  rk_font_direct ? gfx_setfont(slot, "Arial", sz, fl) : (
    key = sz * 16777216 + fl;   // flags are up to three characters, so they stay below 2^24
    rkf_t += 1;
    k =
      rkf_k2 == key ? 2 :
      rkf_k3 == key ? 3 :
      rkf_k4 == key ? 4 :
      rkf_k5 == key ? 5 :
      rkf_k6 == key ? 6 :
      rkf_k7 == key ? 7 :
      rkf_k8 == key ? 8 :
      rkf_k9 == key ? 9 :
      rkf_k10 == key ? 10 :
      rkf_k11 == key ? 11 :
      rkf_k12 == key ? 12 :
      rkf_k13 == key ? 13 :
      rkf_k14 == key ? 14 :
      rkf_k15 == key ? 15 :
      0;
    k ? (
      gfx_setfont(k);
      k == 2 ? ( rkf_u2 = rkf_t; ) :
      k == 3 ? ( rkf_u3 = rkf_t; ) :
      k == 4 ? ( rkf_u4 = rkf_t; ) :
      k == 5 ? ( rkf_u5 = rkf_t; ) :
      k == 6 ? ( rkf_u6 = rkf_t; ) :
      k == 7 ? ( rkf_u7 = rkf_t; ) :
      k == 8 ? ( rkf_u8 = rkf_t; ) :
      k == 9 ? ( rkf_u9 = rkf_t; ) :
      k == 10 ? ( rkf_u10 = rkf_t; ) :
      k == 11 ? ( rkf_u11 = rkf_t; ) :
      k == 12 ? ( rkf_u12 = rkf_t; ) :
      k == 13 ? ( rkf_u13 = rkf_t; ) :
      k == 14 ? ( rkf_u14 = rkf_t; ) :
      k == 15 ? ( rkf_u15 = rkf_t; );
    ) : (
      b = 2; bu = rkf_u2;   // the slot used longest ago (an empty one has 0)
      rkf_u3 < bu ? ( b = 3; bu = rkf_u3; );
      rkf_u4 < bu ? ( b = 4; bu = rkf_u4; );
      rkf_u5 < bu ? ( b = 5; bu = rkf_u5; );
      rkf_u6 < bu ? ( b = 6; bu = rkf_u6; );
      rkf_u7 < bu ? ( b = 7; bu = rkf_u7; );
      rkf_u8 < bu ? ( b = 8; bu = rkf_u8; );
      rkf_u9 < bu ? ( b = 9; bu = rkf_u9; );
      rkf_u10 < bu ? ( b = 10; bu = rkf_u10; );
      rkf_u11 < bu ? ( b = 11; bu = rkf_u11; );
      rkf_u12 < bu ? ( b = 12; bu = rkf_u12; );
      rkf_u13 < bu ? ( b = 13; bu = rkf_u13; );
      rkf_u14 < bu ? ( b = 14; bu = rkf_u14; );
      rkf_u15 < bu ? ( b = 15; bu = rkf_u15; );
      gfx_setfont(b, "Arial", sz, fl);
      b == 2 ? ( rkf_k2 = key; rkf_u2 = rkf_t; );
      b == 3 ? ( rkf_k3 = key; rkf_u3 = rkf_t; );
      b == 4 ? ( rkf_k4 = key; rkf_u4 = rkf_t; );
      b == 5 ? ( rkf_k5 = key; rkf_u5 = rkf_t; );
      b == 6 ? ( rkf_k6 = key; rkf_u6 = rkf_t; );
      b == 7 ? ( rkf_k7 = key; rkf_u7 = rkf_t; );
      b == 8 ? ( rkf_k8 = key; rkf_u8 = rkf_t; );
      b == 9 ? ( rkf_k9 = key; rkf_u9 = rkf_t; );
      b == 10 ? ( rkf_k10 = key; rkf_u10 = rkf_t; );
      b == 11 ? ( rkf_k11 = key; rkf_u11 = rkf_t; );
      b == 12 ? ( rkf_k12 = key; rkf_u12 = rkf_t; );
      b == 13 ? ( rkf_k13 = key; rkf_u13 = rkf_t; );
      b == 14 ? ( rkf_k14 = key; rkf_u14 = rkf_t; );
      b == 15 ? ( rkf_k15 = key; rkf_u15 = rkf_t; );
    );
  );
);

// ── Palette: the vintage console centre-section blue-grey, one identity ──
function wface_palette() (
  wface_bg_r = 0.355; wface_bg_g = 0.385; wface_bg_b = 0.425;   // panel
  wface_tx_r = 0.940; wface_tx_g = 0.950; wface_tx_b = 0.960;   // bright text
  wface_td_r = 0.780; wface_td_g = 0.800; wface_td_b = 0.840;   // dim text, ladders
  wface_ac_r = 0.905; wface_ac_g = 0.915; wface_ac_b = 0.940;   // LED-window tint
);

// Recessed LED value window centred on cx: dark inset + tinted hairline border,
// #wface_val drawn in the tint. Same visual grammar as the return-deck readouts.
function wface_readout(cx, ry, rw, rh, tr, tg, tb) local(tw, th) (
  gfx_set(0, 0, 0, 0.50);
  gfx_rect(cx - rw * 0.5, ry, rw, rh);
  gfx_set(tr, tg, tb, 0.25);
  gfx_rect(cx - rw * 0.5, ry, rw, rh, 0);
  // Bold from 10 px only: bold Arial at 8-9 px draws 5 as 6 and 6, 9 as 8 (wiki 4.7).
  rk_font(6, max(8, floor(rh * 0.62)), floor(rh * 0.62) >= 10 ? 'b' : 0);
  gfx_measurestr(#wface_val, tw, th);
  gfx_set(tr, tg, tb, 0.95);
  gfx_x = cx - tw * 0.5; gfx_y = ry + floor((rh - th) * 0.5);
  gfx_drawstr(#wface_val);
);

// Ladder mark: detent dot on the ring + printed value at sweep position
// t (0..1 across the -130..+130 house arc). Caller sets font + #wface_lad.
function wface_ladt(cx, cy, rr, t) local(_a, _tw, _th) (
  _a = (t * 260 - 130) * $pi / 180;
  // dots follow the dim text so they read on cream AND charcoal
  gfx_set(wface_td_r, wface_td_g, wface_td_b, 0.75);
  gfx_circle(cx + sin(_a) * rr * 1.24, cy - cos(_a) * rr * 1.24, max(1, rr * 0.055), 1);
  gfx_measurestr(#wface_lad, _tw, _th);
  gfx_x = cx + sin(_a) * rr * 1.56 - _tw * 0.5;
  gfx_y = cy - cos(_a) * rr * 1.56 - _th * 0.5;
  gfx_set(wface_td_r, wface_td_g, wface_td_b, 0.95);
  gfx_drawstr(#wface_lad);
);

// Console push button: dark well, grey cap, lamp at the left. Returns hover.
function wface_btn(bx, by, bw, bh, lit) local(_hv) (
  _hv = mx >= bx && mx <= bx + bw && my >= by && my <= by + bh;
  // well + border derive from the palette: charcoal face keeps the deep
  // console well, a cream theme gets a softer recess, never a hard black
  // picture-frame on a light panel
  gfx_set(wface_bg_r * 0.30, wface_bg_g * 0.30, wface_bg_b * 0.33, 1);
  gfx_rect(bx, by, bw, bh);
  gfx_set(wface_bg_r * 0.55, wface_bg_g * 0.55, wface_bg_b * 0.58, 1);
  gfx_rect(bx, by, bw, bh, 0);
  gfx_set(_hv ? 0.86 : 0.78, _hv ? 0.87 : 0.79, _hv ? 0.89 : 0.81, 1);
  gfx_rect(bx + floor(bw * 0.11), by + floor(bh * 0.14),
           bw - floor(bw * 0.22), bh - floor(bh * 0.28));
  gfx_set(0.48, 0.49, 0.52, 1);
  gfx_rect(bx + floor(bw * 0.11), by + floor(bh * 0.14),
           bw - floor(bw * 0.22), bh - floor(bh * 0.28), 0);
  lit ? gfx_set(0.34, 0.88, 0.48, 1) : gfx_set(0.20, 0.22, 0.24, 1);
  gfx_circle(bx - floor(8 * wface_sc), by + bh * 0.5 - floor(2 * wface_sc), floor(4 * wface_sc), 1);
  gfx_set(wface_bg_r * 0.45, wface_bg_g * 0.45, wface_bg_b * 0.48, 1);
  gfx_circle(bx - floor(8 * wface_sc), by + bh * 0.5 - floor(2 * wface_sc), floor(6 * wface_sc), 0);
  _hv;
);

// Engraved hairline separator across a face that starts at x and is w wide.
function wface_sep(x, y, w) (
  gfx_set(0, 0, 0, 0.45);   gfx_rect(x + floor(24 * wface_sc), y,     w - floor(48 * wface_sc), 1);
  gfx_set(1, 1, 1, 0.05);   gfx_rect(x + floor(24 * wface_sc), y + 1, w - floor(48 * wface_sc), 1);
);

// Slotted rack-ear screw (same chrome as the return viewer).
function wface_screw(cx, cy, r) (
  gfx_set(0.05, 0.05, 0.06, 1); gfx_circle(cx, cy, r, 1, 1);
  gfx_set(0.42, 0.44, 0.48, 1); gfx_circle(cx, cy, r * 0.7, 1, 1);
  gfx_set(0.12, 0.12, 0.14, 1);
  gfx_line(cx - r * 0.5, cy, cx + r * 0.5, cy);
);

// Cap colours, G-series grammar, by knob index 0..5 (THR RAT ATK REL MKP MIX):
// white THR, green RATIO, blue timing pair, red MAKE-UP, magenta MIX (the EON
// addition, deliberately off-ladder). Writes the knob lib's sk_kb* cap colour.
function wface_knob_cap(ki) (
  ki == 0 ? ( sk_kbr = 0.87; sk_kbg = 0.88; sk_kbb = 0.90; )
  : ki == 1 ? ( sk_kbr = 0.18; sk_kbg = 0.62; sk_kbb = 0.34; )
  : ki <= 3 ? ( sk_kbr = 0.20; sk_kbg = 0.45; sk_kbb = 0.76; )
  : ki == 4 ? ( sk_kbr = 0.81; sk_kbg = 0.27; sk_kbb = 0.22; )
             : ( sk_kbr = 0.76; sk_kbg = 0.26; sk_kbb = 0.56; );
);

// The printed ladder around knob ki: the full dot ring first (13 minors,
// hardware grammar), then the majors at the real hardware parts. The log
// knobs' t-positions are ln-mapped, so the detents spread evenly.
function wface_knob_ring_ladder(ki, cx, cy, kr) local(_di, _la) (
  _di = 0;
  loop(13,
    _la = (_di / 12 * 260 - 130) * $pi / 180;
    gfx_set(wface_td_r, wface_td_g, wface_td_b, 0.5);
    gfx_circle(cx + sin(_la) * kr * 1.24, cy - cos(_la) * kr * 1.24,
               max(1, kr * 0.038), 1);
    _di += 1;
  );
  // The ladder is all numbers: bold from 10 px only (wiki 4.7).
  rk_font(5, max(7, floor(8 * wface_sc)), floor(8 * wface_sc) >= 10 ? 'b' : 0);
  ki == 0 ? (
    strcpy(#wface_lad, "-40"); wface_ladt(cx, cy, kr, 0);
    strcpy(#wface_lad, "-30"); wface_ladt(cx, cy, kr, 0.25);
    strcpy(#wface_lad, "-20"); wface_ladt(cx, cy, kr, 0.5);
    strcpy(#wface_lad, "-10"); wface_ladt(cx, cy, kr, 0.75);
    strcpy(#wface_lad, "0");   wface_ladt(cx, cy, kr, 1);
  ) :
  ki == 1 ? (
    strcpy(#wface_lad, "1");  wface_ladt(cx, cy, kr, 0);
    strcpy(#wface_lad, "2");  wface_ladt(cx, cy, kr, 0.2314);
    strcpy(#wface_lad, "4");  wface_ladt(cx, cy, kr, 0.4628);
    strcpy(#wface_lad, "10"); wface_ladt(cx, cy, kr, 0.7686);
    strcpy(#wface_lad, "20"); wface_ladt(cx, cy, kr, 1);
  ) :
  ki == 2 ? (
    // Positions on the ACTUAL 0.1..100 ms ln travel — the six hardware
    // parts at their true spots, travel end printed like RATIO's "20".
    strcpy(#wface_lad, ".1");  wface_ladt(cx, cy, kr, 0);
    strcpy(#wface_lad, ".3");  wface_ladt(cx, cy, kr, 0.15904);
    strcpy(#wface_lad, "1");   wface_ladt(cx, cy, kr, 0.33333);
    strcpy(#wface_lad, "3");   wface_ladt(cx, cy, kr, 0.49237);
    strcpy(#wface_lad, "10");  wface_ladt(cx, cy, kr, 0.66667);
    strcpy(#wface_lad, "30");  wface_ladt(cx, cy, kr, 0.82571);
    strcpy(#wface_lad, "100"); wface_ladt(cx, cy, kr, 1);
  ) :
  ki == 3 ? (
    strcpy(#wface_lad, ".1");  wface_ladt(cx, cy, kr, 0);
    strcpy(#wface_lad, ".3");  wface_ladt(cx, cy, kr, 0.4421);
    strcpy(#wface_lad, ".6");  wface_ladt(cx, cy, kr, 0.7211);
    strcpy(#wface_lad, "1.2"); wface_ladt(cx, cy, kr, 1);
  ) :
  ki == 4 ? (
    strcpy(#wface_lad, "-12"); wface_ladt(cx, cy, kr, 0);
    strcpy(#wface_lad, "0");   wface_ladt(cx, cy, kr, 0.5);
    strcpy(#wface_lad, "+12"); wface_ladt(cx, cy, kr, 1);
  ) : (
    strcpy(#wface_lad, "0");   wface_ladt(cx, cy, kr, 0);
    strcpy(#wface_lad, "50");  wface_ladt(cx, cy, kr, 0.5);
    strcpy(#wface_lad, "100"); wface_ladt(cx, cy, kr, 1);
  );
);

// The floating-card knob cell, whole: cap colour, the G-series knob, the ring
// and ladder, the LED value window below, the engraved label above. The host
// has already interacted and set the display value (dv in the knob's own
// travel units, dmin/dmax/dsym likewise), #wface_val and #wface_lbl.
// hov = the knob lib's hover_t for this knob (its per-knob mem[0]).
function wface_knob_cell(ki, cx, cy, kr, dv, dmin, dmax, dsym, hov) local(_tw, _th) (
  wface_knob_cap(ki);
  rk_knob_draw(21, cx, cy, kr, dv, dmin, dmax, dsym, hov,
               sk_kbr, sk_kbg, sk_kbb, 0, wface_bg_r, wface_bg_g, wface_bg_b);
  wface_knob_ring_ladder(ki, cx, cy, kr);
  wface_readout(cx, cy + kr + floor(24 * wface_sc), floor(64 * wface_sc), floor(16 * wface_sc),
                wface_ac_r, wface_ac_g, wface_ac_b);
  rk_font(5, max(9, floor(13 * wface_sc)), 'b');
  gfx_set(wface_tx_r, wface_tx_g, wface_tx_b, 0.95);
  gfx_measurestr(#wface_lbl, _tw, _th);
  gfx_x = cx - _tw * 0.5;
  gfx_y = cy - kr - floor(34 * wface_sc);
  gfx_drawstr(#wface_lbl);
);

// A console button with its caption under it, Weld's grammar: the cap text in
// dark ink centred on the cap, the small dim caption below. Returns hover.
function wface_btn_labeled(bx, by, bw, bh, lit, cap, caption) local(_hv, _tw, _th) (
  _hv = wface_btn(bx, by, bw, bh, lit);
  rk_font(5, max(9, floor(14 * wface_sc)), 'b');
  gfx_set(0.15, 0.15, 0.17, 1);
  gfx_measurestr(cap, _tw, _th);
  gfx_x = bx + bw * 0.5 - _tw * 0.5;
  gfx_y = by + (bh - _th) * 0.5 - floor(2 * wface_sc);
  gfx_drawstr(cap);
  rk_font(5, max(7, floor(8 * wface_sc)), 'b');
  gfx_set(wface_td_r, wface_td_g, wface_td_b, 0.85);
  gfx_measurestr(caption, _tw, _th);
  gfx_x = bx + bw * 0.5 - _tw * 0.5; gfx_y = by + bh + floor(4 * wface_sc);
  gfx_drawstr(caption);
  _hv;
);
