// rk_swing_fxcard_data.jsfx-inc — the FX picker's card recipes.
//
// GENERATED by .dev_fxpicker/gen_fxcard_data.py from
// .docs/specs/FX_Picker_Card_Sheet.html. Do not hand-edit: the sheet is the
// source of truth and every value here was extracted from it mechanically.
//
// Pairs with rk_swing_fxcard.jsfx-inc, which does the drawing. This file is
// only the table plus the name lookup.
//
// (c) EON Studios — All Rights Reserved

// ⚠️ @init IS LOAD-BEARING (.docs/wiki/02-file-structure.md).
@init

FXC_N_CARDS = 754;
FXC_N_KEYS  = 757;

// ⚠️ NO freemem HERE. Imports inline near the top of Swing_ReaKit.jsfx but
// `freemem = 0` does not run until much later, so an allocation in this file
// would take address 0 and be overwritten. The host calls this instead, and
// because the buffer is sized from FXC_REC, the constants in
// rk_swing_fxcard.jsfx-inc must already be defined -- they are, both incs
// import above the allocator. .dev_fxpicker/test_protocol.py enforces that
// ordering after it cost a session (the picker allocated ZERO cells, freemem
// never advanced, and the plugin list landed on top of col_rgba).
// The table itself is in the pieces rk_swing_fxcard_data_p<k>.jsfx-inc, imported
// right before this file: REAPER's time to load a JSFX file grows with the SQUARE
// of its size, and as one file this table cost about a second per Swing.
function swing_fxcard_data_init(mem_start)
(
  _fxc_cards = mem_start;
  _fxc_keys  = mem_start + FXC_N_CARDS * FXC_REC;
  swing_fxcard_data_init_1();
  swing_fxcard_data_init_2();
  swing_fxcard_data_init_3();
  swing_fxcard_data_init_4();
  swing_fxcard_data_init_5();
  swing_fxcard_data_init_6();
  swing_fxcard_data_init_7();
  swing_fxcard_data_init_8();
  swing_fxcard_data_init_9();
  swing_fxcard_data_init_10();
  swing_fxcard_data_init_11();
  mem_start + FXC_N_CARDS * FXC_REC + FXC_N_KEYS * 2;
);

// Normalised hash of a plugin name held as one char per cell. MUST match
// hkey() in the generator: brackets and their contents are skipped, then
// everything except letters and digits, then lower-cased.
function swing_fxcard_hash(p, len)
  local(i, c, h, d)
(
  h = 0; i = 0; d = 0;
  loop(len,
    c = p[i] | 0;
    c == 40 ? (
      d += 1;
    ) : c == 41 ? (
      d > 0 ? d -= 1;
    ) : d == 0 ? (
      c >= 65 && c <= 90 ? c += 32;
      (c >= 48 && c <= 57) || (c >= 97 && c <= 122) ?
        h = (h * 131 + c) % 1000003;
    );
    i += 1;
  );
  h;
);

// Record pointer for a hashed name, or -1. The table is (hash, card index)
// PAIRS, not one key per card, so several installed names can resolve to the
// same art. Linear over 757 entries -- resolved ONCE per published page in the
// face, never per frame.
function swing_fxcard_lookup(h)
  local(i)
(
  i = 0;
  while(i < FXC_N_KEYS && _fxc_keys[i * 2] != h ? (i += 1; 1;));
  i < FXC_N_KEYS ? _fxc_cards + _fxc_keys[i * 2 + 1] * FXC_REC : -1;
);
