// rk_biquad.jsfx-inc — Biquad (2nd-order IIR) coefficient helpers (Swing's copy)
// (c) EON Studios — All Rights Reserved
//
// RBJ Audio EQ Cookbook coefficients for DRAWING only: the bq_calc_* helpers
// return a filter's coefficients through globals (_tb0.._tb2, _ta1, _ta2) and
// bq_mag_db turns coefficients into a dB magnitude. Swing's master EQ page and
// EON Tone draw their EQ curves with them; neither runs an RBJ biquad on audio
// (the filters play on rk_svf). The setters, the per-sample process and the reset
// were removed from this copy as unused (2026-10-27); Swing Lite's own
// rk_biquad.jsfx-inc still carries them, because its tilt EQ runs on them.

@init

// ─── Compute magnitude in dB from raw coefficients (no array needed) ─────
// Matches the 4BandEQ pattern: takes coefficients directly, returns dB.
function bq_mag_db(f, cb0, cb1, cb2, ca1, ca2)
local(w, cw, c2w, sw, s2w, nr, ni, dr, di, ns, ds)
(
  w = 2.0 * $pi * f / srate;
  cw = cos(w); c2w = cos(2.0 * w);
  sw = sin(w); s2w = sin(2.0 * w);
  nr = cb0 + cb1 * cw + cb2 * c2w;
  ni = -(cb1 * sw + cb2 * s2w);
  dr = 1.0 + ca1 * cw + ca2 * c2w;
  di = -(ca1 * sw + ca2 * s2w);
  ns = nr * nr + ni * ni;
  ds = dr * dr + di * di;
  ds < pow(10, -30) ? 0 : 10.0 * log10(max(pow(10, -30), ns) / ds);
);

// ─── Shelves with DIRECT Q (display for the master EQ's per-mode Q) ──────
// Returns via globals: _tb0, _tb1, _tb2, _ta1, _ta2.
// The cookbook's slope (S) shelves with one line changed: alpha = sin(w0) / (2Q)
// instead of the slope formula. At Q = 1/sqrt(2) the two are algebraically
// identical (the slope formula gives sin(w0)/2 * sqrt(2) at S = 1), so the
// default draws exactly what the S version did. These draw what rk_svf's svf_set_*shelf_q PLAYS:
// that file documents its Q-shelf matching RBJ shelf-with-Q to < 1e-9 dB.
function bq_calc_lowshelf_q(freq, gain_db, Q)
local(A, w0, sinw, cosw, alpha, sqA, b0, b1, b2, a0, a1, a2)
(
  A     = pow(10.0, gain_db / 40.0);
  w0    = 2.0 * $pi * max(20, min(20000, freq)) / srate;
  sinw  = sin(w0);
  cosw  = cos(w0);
  alpha = sinw / (2.0 * max(0.01, Q));
  sqA   = 2.0 * sqrt(A) * alpha;
  b0 = A * ((A + 1.0) - (A - 1.0) * cosw + sqA);
  b1 = 2.0 * A * ((A - 1.0) - (A + 1.0) * cosw);
  b2 = A * ((A + 1.0) - (A - 1.0) * cosw - sqA);
  a0 = (A + 1.0) + (A - 1.0) * cosw + sqA;
  a1 = -2.0 * ((A - 1.0) + (A + 1.0) * cosw);
  a2 = (A + 1.0) + (A - 1.0) * cosw - sqA;
  _tb0 = b0 / a0; _tb1 = b1 / a0; _tb2 = b2 / a0;
  _ta1 = a1 / a0; _ta2 = a2 / a0;
);

function bq_calc_highshelf_q(freq, gain_db, Q)
local(A, w0, sinw, cosw, alpha, sqA, b0, b1, b2, a0, a1, a2)
(
  A     = pow(10.0, gain_db / 40.0);
  w0    = 2.0 * $pi * max(20, min(20000, freq)) / srate;
  sinw  = sin(w0);
  cosw  = cos(w0);
  alpha = sinw / (2.0 * max(0.01, Q));
  sqA   = 2.0 * sqrt(A) * alpha;
  b0 = A * ((A + 1.0) + (A - 1.0) * cosw + sqA);
  b1 = -2.0 * A * ((A - 1.0) + (A + 1.0) * cosw);
  b2 = A * ((A + 1.0) + (A - 1.0) * cosw - sqA);
  a0 = (A + 1.0) - (A - 1.0) * cosw + sqA;
  a1 = 2.0 * ((A - 1.0) - (A + 1.0) * cosw);
  a2 = (A + 1.0) - (A - 1.0) * cosw - sqA;
  _tb0 = b0 / a0; _tb1 = b1 / a0; _tb2 = b2 / a0;
  _ta1 = a1 / a0; _ta2 = a2 / a0;
);

// ─── Compute peaking EQ coefficients into temp vars ──────────────────────
function bq_calc_peaking(freq, gain_db, Q)
local(A, w0, sinw, cosw, alpha, b0, b1, b2, a0, a1, a2)
(
  A     = pow(10.0, gain_db / 40.0);
  w0    = 2.0 * $pi * max(20, min(20000, freq)) / srate;
  sinw  = sin(w0);
  cosw  = cos(w0);
  alpha = sinw / (2.0 * max(0.1, Q));
  b0 = 1.0 + alpha * A;
  b1 = -2.0 * cosw;
  b2 = 1.0 - alpha * A;
  a0 = 1.0 + alpha / A;
  a1 = -2.0 * cosw;
  a2 = 1.0 - alpha / A;
  _tb0 = b0 / a0; _tb1 = b1 / a0; _tb2 = b2 / a0;
  _ta1 = a1 / a0; _ta2 = a2 / a0;
);

// ─── Compute highpass coefficients into temp vars ────────────────────────
function bq_calc_highpass(freq, Q)
local(w0, sinw, cosw, alpha, b0, b1, b2, a0, a1, a2)
(
  w0    = 2.0 * $pi * max(20, min(20000, freq)) / srate;
  sinw  = sin(w0);
  cosw  = cos(w0);
  alpha = sinw / (2.0 * max(0.1, Q));
  b0 = (1.0 + cosw) / 2.0;
  b1 = -(1.0 + cosw);
  b2 = (1.0 + cosw) / 2.0;
  a0 = 1.0 + alpha;
  a1 = -2.0 * cosw;
  a2 = 1.0 - alpha;
  _tb0 = b0 / a0; _tb1 = b1 / a0; _tb2 = b2 / a0;
  _ta1 = a1 / a0; _ta2 = a2 / a0;
);

// ─── Compute lowpass coefficients into temp vars ─────────────────────────
function bq_calc_lowpass(freq, Q)
local(w0, sinw, cosw, alpha, b0, b1, b2, a0, a1, a2)
(
  w0    = 2.0 * $pi * max(20, min(20000, freq)) / srate;
  sinw  = sin(w0);
  cosw  = cos(w0);
  alpha = sinw / (2.0 * max(0.1, Q));
  b0 = (1.0 - cosw) / 2.0;
  b1 = 1.0 - cosw;
  b2 = (1.0 - cosw) / 2.0;
  a0 = 1.0 + alpha;
  a1 = -2.0 * cosw;
  a2 = 1.0 - alpha;
  _tb0 = b0 / a0; _tb1 = b1 / a0; _tb2 = b2 / a0;
  _ta1 = a1 / a0; _ta2 = a2 / a0;
);
