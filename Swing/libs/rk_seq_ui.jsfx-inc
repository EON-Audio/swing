// rk_seq_ui.jsfx-inc -- the step sequencer's face (Spec_Swing_Seq_View 7). Two homes for one grid:
//   * the PANEL UNDER THE PADS, full width, the default placement of decision 18 (built 2026-10-19 after the
//     user tried S1's full-window grid in REAPER: "i thought the seq would open in another handle the way the
//     mini browser does?"). A gutter with a chevron sits at the bottom of the full UI at all times; opening the
//     panel asks the bridge to grow the WINDOW taller (the browser's width mechanism, now for height), and the
//     panel takes exactly the height the window gains, so the pads never move. Where the window cannot grow
//     (docked, embedded, no js_ReaScriptAPI, no bridge, a screen too short) it takes the height from the pads
//     instead, down to their floor: the pads never hide (spec 7.1).
//   * the same grid as a full-window big view (VIEW_SEQ): the dock face, the embeds and the action script.
// S1: sixteen lanes, steps on / off with a velocity, each lane its length (LEN) and division (DIV), lane M / S,
// eight pattern tabs, PLAY, CLR, the page of steps shown.
// P0a, chunk 2: the KEYBOARD (arrows move the selection, Enter toggles, Delete clears, + / - velocity, PgUp / PgDn the page,
// S V P R N A the views, Space = REAPER's play / stop through the bridge; only while the panel owns the last click and
// no text box has the keys; read from _char the browser filter's way; never in an embed) and the TRANSPORT ROW (|<,
// play, stop, a bar : beat readout: the presses go to the bridge as CMD 95, the bar : beat comes back through the
// browser band, so it is REAPER's own; without the bridge the row shows the state. Its loop button went to row 2's
// LOOP in the small things round).
// The small things round (2026-10-23, the user's list; .docs/specs/Swing_Small_Things_Round_Build_Spec_2026-10-23.md):
// the lane SCRUB (press a lane's icon or chip and slide: each lane's pad sounds), the drawn PICKER (a lane's pad by pad
// or by note, right-click on the icon), toolbar row 2's LOOP and ZOOM and the cut-down preset name box, the song strip's
// DRAGS (a pattern or a region onto the chain, a chain chip along it or off it), the song print's own CMD 53, the gate
// reading the user's face (the compact switch draws the rack face over an open panel) and a closed panel no longer
// lingering after the window was enlarged.
// P0a (2026-10-20, decision 23): the lane's OWN swing (the SW box), the lane icons (the pad's category glyph, an
// option), the OPTIONS menu (icons / FOLLOW / the transport row / aim the pattern at a bank), FOLLOW (the page turns
// with the selected lane's playhead), the right-click step menu (hear the pad, roll, probability, nudge, accent, clear).
// S2a (2026-10-20, "Fix that fall thru first"): the gate claims the mouse for the gutter and the panel ahead of the face.
// Self-audit 2026-10-20: a step switched on from the grid also clears its roll's sub-velocities (seq_step_on_at);
// the target picker's menu is safe against a '|' in a pad's name.
// S2 (2026-10-19, "Go: start the per-step features"): the LANE VIEWS -- STEPS, VEL, PROB, RTCH (rolls), NUDGE, ACC
// -- each changing what a cell shows and what a click, a drag and the wheel edit (spec 14); the STEP EDITOR row
// for the selected step (velocity, probability, roll with its sub-velocities, nudge, accent) and the pattern's
// SWING, GATE, HUM V, HUM T and ACC offset; the lane's TARGET picked from its name (the bank's pads, then the other
// banks); and one REAPER undo point per finished gesture (seq_ui_undo_tick -> the bridge's CMD 94).
// Edits are single-cell writes straight into the model (spec 9): the walker reads a lane's record once per
// block, so a cell written here lands between two blocks. The one structural edit, CLR, is posted
// (seq_post_op, the op queue) and applied in @block. Pattern edits mark the project dirty (spec 8: patterns are project
// state; the SAVE KIT dot is not theirs); the panel's open state, height, page and view are view state, like
// fb_open. Imported AFTER rk_swing_ui_minibrowser (swing_fb_band, swing_fb_can_grow, FB_REQ_GROWH) and
// rk_swing_ui_state (swing_bigview_close, lcd_bg_*). (c) EON Studios -- All Rights Reserved

@init

SEQ_UI_HDR_B  = 212;   // the lane header column, design px: chip, M, S, name, LEN, DIV, SW (P0a); + the icon column with the icons on
SEQ_UI_ICON_B = 16;    // the lane icon's column at its smallest (the pad's category glyph, an option); it grows with the rows up to 34
SEQ_UI_ROW_B  = 72;    // a lane row's height cap: the sixteen rows FILL the height they are given up to this (26 until the user's look
                       // at the full face, 2026-10-20: "can the grid scale better ... because we are limited to 16 lanes")
SEQ_UI_ROW_MIN_B = 11; // ...and its floor (sixteen rows must fit the smallest window; wiki 4.11)
SEQ_UI_ROW_SCROLL_B = 24; // ...but the rows FILL only while each gets this much; shorter, they keep it and the lanes scroll
                          //   (the owner, 2026-10-27: "scroll up and down instead of trying to fit all the lanes in"; until then
                          //   the rows squeezed to the 11 px floor first). SEQ_UI_ROW_MIN_B stays the floor of the one row
                          //   shown where not even this fits.
SEQ_UI_ROW_SLIVER_B = 6;  // S5: beside an open piano roll the other lanes may shrink to this (the chip and the cells only)
SEQ_UI_ROLL_ROW_B = 18;   // S5: a roll row's height, design px (twelve rows at least, so a short roll packs them tighter)
SEQ_UI_ROLL_LEFT_B = 136; // S5: the roll's left column -- the chip 12, the buttons 76 + 4, the keyboard SEQ_UI_KEYS_B -- the lane
                          //   header is held to this while a roll is open, so the keyboard has its room with the columns hidden
SEQ_UI_KEYS_B = 44;       // S5: the keyboard's strip against the grid
SEQ_UI_RGRIP_B = 6;       // S5: the grabber's band between the compacted lanes and the roll's lane
SEQ_UI_ROLL_MIN_PC = 15;  // S5: the roll's share of the lane area, per cent, as the grabber may set it
SEQ_UI_ROLL_MAX_PC = 92;
SEQ_UI_BAR_B  = 24;    // the toolbar's first row: the title, the pattern tabs, the page, PLAY, CLR, OPT, the transport, X
SEQ_UI_BAR2_B = 22;    // its second row (P0b): the pattern tools, TRIG, the preset strip, SYNC, PRINT, MIDI -- each lit by its step
SEQ_UI_SONG_B = 22;    // the song strip's band under the toolbar (S4): the region chips and the chain; shown while SONG is on
SEQ_UI_KEYS_ROW_B = 40; // the key row under the pattern chips while KEYS is on: sixteen keys, one per pattern, across the panel
                       // (round two C; 18 px and over the tabs only until then -- the user: "far too small"); the lanes give it
                       // their height (the user's choice: "The lanes shrink to make room for the key row, as now")
SEQ_UI_KEYS_LBL_B = 62; // the key row's label zones at each end: the trigger notes' root at the left, the next pattern at the right
SEQ_TRIG_G0S = 20; SEQ_TRIG_E7 = 100; SEQ_TRIG_E8 = 112;   // KEYS ranges' first notes: G#0 (ends just below a kit's pads at 36), E7 (just above bank D's 99), E8
SEQ_UI_RUL_B  = 14;    // the step ruler
SEQ_UI_FOOT_B = 46;    // the footer: the view row (18) and the editor row (24), plus their gaps
SEQ_UI_FOOT3_B = 24;   // ...and a third row on a narrow panel: the pattern's feel under the step editor (P0b)
SEQ_UI_FOOT_ONE_B = 760; // the step editor and the pattern's feel share one row from this panel width (design px: the
                       // editor with a four-hit roll ends at 748); narrower, the feel takes the third row. The WIDTH
                       // decides, never the selection, so the lanes never jump on a click.
SEQ_UI_CELL_B = 32;    // the narrowest step cell before fewer steps are shown
SEQ_UI_VIEWS  = 6;     // STEPS, VEL, PROB, RTCH, NUDGE, ACC
SEQ_PANEL_H_B   = 424; // the panel's default height, design px (seq_h = 0): sixteen lanes at 19 px under the two toolbar rows
                       // (4 + 24 + 2 + 22 + 4), the ruler (14) and the two-row footer (46 + 4); was 400 before the second row (P0b).
                       // With SONG on the song strip takes 22 of the lanes' height (the user turns it on knowingly).
SEQ_GUTTER_H_B  = 18;  // the strip between the pads and the panel: the chevron, the status line, the drag handle
SEQ_PADS_MIN_H_B = 240; // the pads' floor under a panel that takes its height from them (the squeeze)
SEQ_H_MIN_B     = 120; // the smallest panel the handle drags to
SEQ_UI_UNDO_SETTLE = 0.35;   // s without an edit (and no button held) before a finished gesture asks for its undo point
SEQ_CLOSE_SETTLE = 1.5;      // s a closed panel's hold waits for the window to take its height back (swing_seq_gate)
seq_ui_paint = -1;     // -1 none, 0 painting steps off, 1 painting them on (a drag across cells, STEPS view)
seq_ui_last = -1;      // the last cell painted (lane * 64 + step), so a drag toggles each cell once
seq_ui_drag_l = -1;    // the lane whose LEN box is being dragged (-1 none)
seq_ui_sel_l = -1;     // the selected step (the editor row's subject): lane and step, -1 none
seq_ui_sel_s = -1;
seq_ui_cdrag = 0;      // a drag begun on a cell: 1 = a value set from the mouse's height (VEL / PROB), 2 = a nudge set sideways
seq_ui_vdrag_id = 0;   // the editor box being dragged (its id), 0 none
seq_ui_pick_lane = -1; // the lane whose target picker is open
seq_ui_drag_sw = -1;   // the lane whose SW box is being dragged (-1 none)
seq_ui_rc_l = -1;      // the step the right-click menu is open on: lane and step
seq_ui_rc_s = -1;
seq_ui_tap_until = 0;  // "hear the pad" from the step menu: the face holds the pad until this time (the host's frame-end release waits)
seq_ui_focus = 0;      // the panel owns the last click: the keyboard goes to it (cleared by a click on the face)
seq_ui_shown = 16;     // steps on a page, as of the last panel draw (the keys turn the page by it)
seq_ui_chip0 = 0;      // the first pattern chip on show (round two H): the row scrolls when the chips outgrow their room
seq_ui_chip_pat = -1;  // the pattern the row was last pulled to (the chip on screen in view); between changes the ‹ › ends and the wheel scroll it freely (audit K9)
seq_ui_cdrag_live = 0; // the MOVE view's drag went live (4 px of travel): a plain click on a hit leaves its nudge alone (audit K11)
seq_ui_ren_p = -1;     // the pattern being renamed in the face's own box on its chip (-1 none)
seq_ui_chips_x = 0; seq_ui_chips_w = 0;   // the chip area this frame (a fixed footprint: the key strip under it, the rigs)
seq_ui_plus_x = -1;   // the "+" chip's x this frame (-1 none; the rigs)
seq_ui_keys_x = 0; seq_ui_keys_w = 0;   // the key row's keys area this frame (between its label zones; the rigs)
seq_ui_trig_ovl = -1; // the first playable pad on the trigger notes in use, as of the KEYS menu's last opening (-1 none; the rigs)
seq_ui_npat_seen = 0; // the last kit-landing request taken (seq_npat_req_n, rk_seq_core)
seq_ui_msg_until = 0;  // the footer shows #seq_ui_msg until this time (a pattern tool's answer: copied, pasted, refused and why)
seq_ui_cursor = 0;     // the gutter set the resize cursor last frame (so the arrow is put back once when the mouse leaves)
seq_ui_roll_lane = -1; // S5: the lane folded out into its piano roll (one at a time; view state)
seq_ui_ns_l = -1; seq_ui_ns_s = -1; seq_ui_ns_k = -1;   // the selected note: lane, step, slot
seq_ui_nd = 0;         // a note drag: 1 move, 2 length
seq_ui_nd_grab = 0; seq_ui_nd_nx = 0;   // where in the note the mouse took it (steps); the note's left edge (px) for a length drag
seq_ui_last_len = 1;   // the length a new note takes: the last one set
seq_ui_nd_mx0 = 0; seq_ui_nd_my0 = 0; seq_ui_nd_live = 0;   // where a note press began (x and y); 1 once it moved 4 px (a click alone neither moves nor sizes)
seq_ui_want_cur = 0;  // the cursor the panel wants this frame (0 = none): sizing over a note's end, moving over a note
seq_ui_rdrag = 0; seq_ui_rdrag_t = 0;   // the roll's grabber held; the last press on it (a double-click resets the split)
seq_ui_rgrip_y = 0; seq_ui_fold_ry = 0;  // the grabber's y and the roll's lane's row y as of the last draw (the rig reads them)
seq_ui_roll_hov = 0;   // the mouse is over a roll this frame (the footer's hint)
seq_ui_chan_lane = -1; seq_ui_scale_lane = -1;   // the lane the channel / scale menu is open for
seq_ui_cdrag_s0 = 0;   // the MOVE view: the step a dragged hit started on
seq_ui_roll_y0 = 0; seq_ui_roll_rowp = 0; seq_ui_roll_base = 0; seq_ui_roll_rows = 0;   // the roll's geometry as of the last draw (the rig reads it)
seq_ui_pnav_seq = 0;   // the preset strip's NAV counter, this instance's (S3b; the bridge edge-detects it per slot)
seq_ui_preset_ack = 0; // the last seq_preset_seq the face answered with an undo point and a message
seq_ui_kit_seen = 0;   // the last seq_kit_adopted the face answered (S3c)
seq_ui_kit_pub_seen = 0;   // the last seq_kit_pubs the face looked at (a refused record is said)
seq_ui_print_seen = 0;     // the last seq_print_done the face answered (S6)
seq_ui_pmenu_pat = 0;      // the pattern the PATTERN menu was opened for (the button: the one on screen; a tab's right-click: that tab's)
seq_ui_mo_seen = 0; seq_ui_mo_t = -10;   // the mirror's pulse the face last saw, and when: the header's lamp blinks for a tenth of a second
seq_ui_bg_r = 0.10; seq_ui_bg_g = 0.26; seq_ui_bg_b = 0.35;   // the panel's background this frame (seq_ui_theme_bg)
seq_ui_pidx = 0; seq_ui_pcount = 0;   // the preset index and count the bridge published for this slot
seq_ui_plist = 0;         // the preset list is open inside the panel (S3b; view state, not saved)
seq_ui_plist_scroll = 0;  // its first visible row (of the filtered rows)
seq_ui_plist_genre = -1;  // the chips: -1 = all
seq_ui_plist_feel = -1; seq_ui_plist_role = -1;
seq_ui_plist_n = 0;       // the filtered rows (their flat indices in seq_ui_plist_ix) and the list stamp they were built for
seq_ui_plist_seq = -1; seq_ui_plist_dirty = 1;
seq_ui_psel_seq = 0;      // this instance's SELECT counter (the bridge edge-detects it per slot)
seq_ui_plist_x = 0; seq_ui_plist_row0_y = 0; seq_ui_plist_rowh = 0;   // the rows' geometry as of the last draw (the rig reads it)
seq_ui_songreq_seq = 0;   // the song commands' counter (S4; seeded above gmem's so a reload replays nothing)
seq_ui_rc_ord = 0;        // the region chip the menu is open on (its 1-based ordinal)
seq_ui_adapt_ack = 0;     // the last seq_adapt_seq the face answered (an undo point and a word)
seq_ui_song_x0 = 0; seq_ui_song_y = 0; seq_ui_song_chipw = 0;   // the strip's chips' geometry as of the last draw (the rig reads it)
// ── The small things round (2026-10-23; .docs/specs/Swing_Small_Things_Round_Build_Spec_2026-10-23.md) ──
// The lane scrub (the user: "just click the icon up and down like I could in Stepa and hear it"): a press on a lane's
// icon, or its colour chip, held -- each lane's pad sounds as the pointer crosses its row, the one before released first
seq_ui_scrub = 0;      // a scrub is held
seq_ui_scrub_l = -1;   // the lane the pointer was over last (a MIDI channel lane counts, and sounds nothing)
// The drawn picker (the user: "show like a piano and or pad view so people can make that change quickly"): a lane's pad
// chosen from the pads laid out like the grid, or by note; modal inside the panel; view state, never saved
seq_ui_pk_lane = -1;   // the lane it chooses for, -1 closed
seq_ui_pk_pat = 0;     // the pattern that lane is in (the one on screen when it opened)
seq_ui_pk_bank = 0; seq_ui_pk_tab = 0;   // the bank shown; 0 PADS, 1 PIANO
seq_ui_pk_oct = 36;    // the PIANO's lowest note (two octaves up from it)
seq_ui_pk_hov = -1;    // the pad under the pointer last frame (hover = hear, once per pad entered)
seq_ui_pk_just = 0;    // it opened this frame: the press that opened it is not one of its own
seq_ui_pk_ax = 0; seq_ui_pk_ay = 0;   // where it was opened (it opens beside that point)
seq_ui_pk_x = 0; seq_ui_pk_y = 0; seq_ui_pk_w = 0; seq_ui_pk_h = 0;   // its rect, its tile and its body's corner as of the last
seq_ui_pk_tile = 0; seq_ui_pk_gx = 0; seq_ui_pk_gy = 0;              // draw (the rigs read them)
SEQ_UI_PK_TILE_MIN_B = 36;   // a tile's smallest side, design px: below it the panel is too small and the text menu opens instead
SEQ_UI_PK_TILE_MAX_B = 64;   // ...and its largest
SEQ_UI_PK_MIN_W_B = 200;     // the picker's narrowest (the tab row: PADS PIANO and the four banks)
// The song strip's drags (the user: "The ability to drag the patterns in song mode, we never put that inside the
// sequencer"; Steppa's rules): 1 a pattern tab pressed (a drag past 6 px down), 2 a pattern or a region dragged (it is
// inserted where it drops ON THE CHAIN; dropped anywhere else, nothing), 3 a chain chip dragged (moved where it drops on
// the chain, removed when dropped well clear), 4 a region chip pressed (a drag once it moves past 6 px, like a tab: a
// click's drift is still a click)
seq_ui_sdrag = 0;
seq_ui_sdrag_pat = -1; seq_ui_sdrag_ord = 0;   // the pattern, and its region's ordinal (0 = no region: refused)
seq_ui_sdrag_from = 0; seq_ui_sdrag_v = 0;     // the chain entry dragged (1-based) and its cell when it was taken (stale check)
seq_ui_sdrag_x0 = 0; seq_ui_sdrag_y0 = 0; seq_ui_sdrag_moved = 0;
seq_ui_chn = 0;                                // the chain's chips drawn (their x and w in seq_ui_chgeo, the host's claim)
seq_ui_ch_x0 = 0; seq_ui_ch_x1 = 0;            // the chain's area along the strip
seq_ui_song_by = -100000; seq_ui_song_bh = 0;  // the strip's band (its y and height) as of the last draw
seq_ui_lf_pat = -1;    // the pattern the LOOP's region last followed (-1: not seen yet, so opening the panel moves nothing)
seq_ui_wh_pos = 0; seq_ui_wh_rep = 1; seq_ui_wh_t = -10;   // the chain chip the wheel last set (1-based), the repeats it asked, when
// toolbar row 2's geometry as of the last draw (the rigs): the name box, LOOP and ZOOM (x, w; w 0 = not shown), SONG's x
seq_ui_t2_nx = 0; seq_ui_t2_nw = 0; seq_ui_t2_lx = 0; seq_ui_t2_lw = 0; seq_ui_t2_zx = 0; seq_ui_t2_zw = 0; seq_ui_t2_rx = 0;
seq_ui_t2_kx = 0; seq_ui_t2_tx = -1;           // KEYS' right edge; the transport's x on row 2 (-1: on row 1, or off)
seq_ui_t2_lit = -1;                            // the LOOP button drawn lit (0 Off, 1 Region, 2 Song; -1 none) as of the last draw
seq_ui_t2_ax = -1;                             // the preset's < arrow's x (the > sits after the name box; -1: the arrows yielded)
// the transport's loop icon (back 2026-10-26; the owner: "bring back looping icon in the transport. With some icon options
// maybe an r or s when its looping the region vs song"), as of the last draw (the rigs): its x and y (-1: not drawn), lit,
// the letter in its ring (0 none, 'R' the region, 'S' the song); and the mode it turns on from Off (1 Region, 2 Song): the
// one last seen lit or picked, Region until then (view state: not saved)
seq_ui_tr_lx = -1; seq_ui_tr_ly = 0; seq_ui_tr_lit = 0; seq_ui_tr_ch = 0; seq_ui_loop_last = 1;
seq_ui_x_x = -1;                               // the close X's x as of the last draw (the far right of the top row since 2026-10-27; the rigs)
seq_ui_lscr = 0;                               // the lanes' scroll (2026-10-27): the first lane shown, in lane order, where they do not all fit
seq_ui_nvis = 16;                              // ...and how many are shown, as of the last draw (16: all; the rigs)
seq_ui_lsb_drag = 0; seq_ui_lsb_y0 = 0; seq_ui_lsb_k0 = 0;   // the lanes' scroll bar: its thumb dragged, from (y0, the rows above then)
seq_ui_t1_ox = 0; seq_ui_t1_fx = 0;            // row 1 as of the last draw (the rigs): OPT's right edge, the full-face button's x
seq_ui_pk_seen = 0;    // the picker was drawn since the last window pass's gate (a picker no home draws is closed there)
seq_ui_pk_rawr = 0;    // a right press on the face this window pass, taken from it while the picker is up (it closes the picker)
// The bridge level that takes the round's new requests: song ops 16 (LOOP_MODE) and 17 (INSERT_AT) and the song print's
// CMD 53. Older bridges ignore an unknown op without a word and sweep an unknown CMD, so below it LOOP is dimmed, a drop
// that would insert says so, and TO ITEM's song print refuses (the house rule: BRIDGE_LEVEL_WIRED, Swing_ReaKit).
// 319: the level the round's Kit Bridge publishes (EON_BRIDGE_LEVEL, the SONG builder's; the two must agree at the merge).
SEQ_UI_SONG_LEVEL = 319;
// The transport's own mailbox (FU-T, 2026-10-26; the owner: STOP always works, even while a kit loads). A press rides
// this Swing's slot of the SYNC band, never the kit bus a load holds: +61 the press counter (written LAST), +62 / +63 the
// action of an even / odd press (two presses inside one bridge tick both arrive). The bridge serves it every tick
// whatever the bus, LOCK or a load are doing. A bridge below SEQ_UI_TR_LEVEL knows no mailbox: CMD 95 as before.
SEQ_UI_TR_LEVEL = 321;
SEQ_UI_TR_REQ = 61; SEQ_UI_TR_ACT = 62;
seq_ui_trreq_seq = 0;     // this instance's press counter (seeded above gmem's, so a slot's earlier owner replays nothing)
function seq_ui_plist_init(_pi_base) ( seq_ui_plist_ix = _pi_base; );
seq_tr_rpt = 0;        // the transport row (P0a): REAPER's repeat state, the bar and the beat, from the bridge each frame
seq_tr_meas = 0;
seq_tr_beat = 0;
SEQ_KEY_UP = 30064; SEQ_KEY_DOWN = 1685026670; SEQ_KEY_LEFT = 1818584692; SEQ_KEY_RIGHT = 1919379572;   // gfx_getchar's names
SEQ_KEY_PGUP = 1885828464; SEQ_KEY_PGDN = 1885824110; SEQ_KEY_DEL = 6579564;
seq_h_cur = 0;         // the panel's height THIS frame, 0 closed (swing_seq_gate)
seq_gut_h = 0;         // the gutter's height this frame (0 in the rack face and the embeds)
seq_ui_take_win = 0;   // gutter + panel as of the last WINDOW pass: what _ui_sc leaves out of its height
seq_ui_mouse_own = 0;  // a press that began in the gutter or the panel: theirs until the button comes up (swing_seq_gate)
_seq_claim = 0;        // this frame's claim: the face sees nothing of the mouse, swing_seq_under_draw hands it to the panel
_seq_g_lmbdown = 0; _seq_g_rmbdown = 0; _seq_g_lmbclick = 0; _seq_g_rmbclick = 0; _seq_g_wheel = 0;   // the stash

function seq_ui_div_name(d) (
  d == 0 ? "1/4" : d == 1 ? "1/8" : d == 2 ? "1/16" : d == 3 ? "1/32" : d == 4 ? "1/4T" : d == 5 ? "1/8T" :
  d == 6 ? "1/16T" : d == 7 ? "1/8." : d == 8 ? "1/16." : "?";
);
function seq_ui_view_name(v) (
  v == 0 ? "STEPS" : v == 1 ? "VEL" : v == 2 ? "PROB" : v == 3 ? "RTCH" : v == 4 ? "MOVE" : "ACC";   // MOVE was NUDGE until S5
);

// A pattern edit happened: the project is dirty, and once the gesture settles it earns an undo point.
function seq_ui_edited() (
  mark_dirty();
  seq_ui_edit_t = time_precise();
  seq_ui_undo_wait = 1;
);
// One REAPER undo point per finished gesture, through the bridge (CMD 94: a block around the hidden counter's
// nudge, named for the pattern -- wiki 6.23: a JSFX's own state change is invisible to REAPER until something
// makes it read the state again). Posted once the edits have settled and no button is held, on an idle bus.
// Without the bridge there is no point to make: the edit is saved with the project all the same.
function seq_ui_undo_tick() (
  seq_ui_undo_wait && !LMB && time_precise() - seq_ui_edit_t > SEQ_UI_UNDO_SETTLE ? (
    gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? (
      gmem[KIT_GMEM_CMD] == 0 && !kit_busy && (gmem[KIT_GMEM_LOCK] == 0 || gmem[KIT_GMEM_LOCK] == instance_id) ? (
        gmem[KIT_GMEM_LOCK] = instance_id;
        gmem[KIT_GMEM_PARAM1] = max(0, min(SEQ_PATS - 1, seq_cur | 0));
        gmem[KIT_GMEM_CMD] = 94;
        seq_ui_undo_wait = 0;
      );
    ) : ( seq_ui_undo_wait = 0; );
  );
);
// A line in the footer for three seconds: what a pattern tool did, or why it refused. (Defined here, above the gate, since
// audit K8: the acks below say their word from the gate.)
function seq_ui_say(_sy_s) ( strcpy(#seq_ui_msg, _sy_s); seq_ui_msg_until = time_precise() + 3; );
// The name, index and count the bridge published for this slot (the name 0-ended, 31 chars at most) -> #seq_ui_pname.
function seq_ui_preset_read() local(_pr_b, _pr_i, _pr_c) (
  strcpy(#seq_ui_pname, ""); seq_ui_pidx = 0; seq_ui_pcount = 0;
  _reg_my_slot >= 0 ? (
    _pr_b = EON_SS_PCTRL_BASE + _reg_my_slot * EON_SS_PCTRL_STRIDE;
    seq_ui_pidx = gmem[_pr_b + 2] | 0; seq_ui_pcount = gmem[_pr_b + 3] | 0;
    _pr_i = 0; _pr_c = gmem[_pr_b + 16] | 0;
    while(_pr_c > 0 && _pr_i < 31) (
      sprintf(#seq_ui_pname2, "%s%c", #seq_ui_pname, _pr_c); strcpy(#seq_ui_pname, #seq_ui_pname2);
      _pr_i += 1; _pr_c = gmem[_pr_b + 16 + _pr_i] | 0;
    );
  );
);
// The engine's acks the face answers with an undo point and a word, taken on every window pass (swing_seq_gate) and not
// only while the panel draws (audit K8, 2026-10-26: with the sequencer closed a kit load's ADAPT re-aim, or a preset the
// bridge staged, left its undo point waiting for the panel to open, and the count a kit's record wants was not raised):
// a kit's patterns in (USE THEM), a preset taken, ADAPT's re-aim, the landed count. The panel draw calls it too (the rigs
// drive the draw alone); every ack compares a counter, so a second call in a frame does nothing.
function seq_ui_ack_tick() (
  seq_npat_req_n != seq_ui_npat_seen ? ( seq_ui_npat_seen = seq_npat_req_n; seq_npat = max(seq_npat, min(SEQ_PATS, seq_npat_req_v | 0)); );   // a kit landed (round two H)
  seq_kit_adopted != seq_ui_kit_seen ? (   // a kit's patterns arrived (S3c): the undo point and the word
    seq_ui_kit_seen = seq_kit_adopted; seq_ui_sel_l = -1; seq_ui_roll_lane = -1; seq_ui_edited(); seq_ui_say("The kit's patterns are in");
  );
  seq_preset_seq != seq_ui_preset_ack ? (   // the engine took a preset: the undo point and the word (S3b)
    seq_ui_preset_ack = seq_preset_seq; seq_ui_sel_l = -1; seq_ui_edited(); seq_ui_preset_read();
    sprintf(#seq_ui_lbl, "Preset: %s (%d of %d) into pattern %d", #seq_ui_pname, seq_ui_pidx + 1, seq_ui_pcount, max(0, min(SEQ_PATS - 1, seq_cur | 0)) + 1); seq_ui_say(#seq_ui_lbl);
  );
  // ADAPT took the lanes along with a kit load (S4): the undo point and the word
  seq_adapt_seq != seq_ui_adapt_ack ? ( seq_ui_adapt_ack = seq_adapt_seq; seq_ui_edited(); seq_ui_say("Kit loaded: the lanes followed the pads that moved"); );
);

// A song command to the bridge's chain engine (S4; Steppa's eon_song_cmd): the payload first, the op, the counter LAST.
// Ops: 1 append region A1, 2 remove chain entry A1, 3 move entry A1 to A2, 4 repeats of entry A1 = A2, 5 play the chain
// (or the transport), 6 stop, 7 loop, 8 clear the chain, 10 zoom to the song, 11 zoom to region A1, 13 play from region
// A1, 14 append A1 with A2 repeats, 16 LOOP_MODE (A1 0 off / 1 region A2 / 2 the song), 17 insert region A1 at chain
// position A2 (the small things round, 2026-10-23).
// ONE request per bridge tick: the mailbox has one cell per field and the bridge edge-detects the counter, so a second
// post before it looked lost the first (the loop following a pattern tab's press, then the tab's drop on the chain a
// moment later). The ops queue here, three deep, and go out SEQ_UI_SONG_GAP apart (the bridge polls ~30 times a second;
// there is no ack to wait on). The gate pumps the queue every window pass, so a closed panel still sends what it queued.
SEQ_UI_SONG_GAP = 0.2;
seq_ui_sq_n = 0; seq_ui_sq_t = -10;
function seq_ui_song_post(_sp_op, _sp_a1, _sp_a2) local(_sp_b) (
  _reg_my_slot >= 0 ? (
    _sp_b = EON_SS_SYNC_BASE + _reg_my_slot * EON_SS_SYNC_STRIDE;
    gmem[_sp_b + 45] = _sp_a1; gmem[_sp_b + 46] = _sp_a2; gmem[_sp_b + 44] = _sp_op;
    seq_ui_songreq_seq = max(seq_ui_songreq_seq, gmem[_sp_b + 47] | 0) + 1;
    gmem[_sp_b + 47] = seq_ui_songreq_seq;
  );
  seq_ui_sq_t = time_precise();
);
// A request that waited SEQ_UI_SONG_STALE (the window was shut before its turn: no pass pumped it) is dropped with the
// rest, never sent long after the click (a three-deep queue drains in 0.6 s).
SEQ_UI_SONG_STALE = 2;
function seq_ui_song_pump() (
  seq_ui_sq_n > 0 && time_precise() - seq_ui_sq_e0 > SEQ_UI_SONG_STALE ? seq_ui_sq_n = 0;
  seq_ui_sq_n > 0 && time_precise() - seq_ui_sq_t >= SEQ_UI_SONG_GAP ? (
    seq_ui_song_post(seq_ui_sq_op0, seq_ui_sq_a10, seq_ui_sq_a20);
    seq_ui_sq_op0 = seq_ui_sq_op1; seq_ui_sq_a10 = seq_ui_sq_a11; seq_ui_sq_a20 = seq_ui_sq_a21; seq_ui_sq_e0 = seq_ui_sq_e1;
    seq_ui_sq_op1 = seq_ui_sq_op2; seq_ui_sq_a11 = seq_ui_sq_a12; seq_ui_sq_a21 = seq_ui_sq_a22; seq_ui_sq_e1 = seq_ui_sq_e2;
    seq_ui_sq_n -= 1;
  );
);
// A request that only restates the last one waiting -- the repeats of the same entry (op 4: a wheel spun faster than the
// gap), the loop's mode (op 16: the latest click wins) -- takes its place instead of queueing behind it.
function seq_ui_song_cmd(_sc_op, _sc_a1, _sc_a2) local(_sc_l) (
  _reg_my_slot >= 0 ? (
    _sc_l = seq_ui_sq_n == 3 ? seq_ui_sq_op2 : seq_ui_sq_n == 2 ? seq_ui_sq_op1 : seq_ui_sq_n == 1 ? seq_ui_sq_op0 : 0;   // the last waiting
    _sc_l == _sc_op && (_sc_op == 16 || (_sc_op == 4 && (seq_ui_sq_n == 3 ? seq_ui_sq_a12 : seq_ui_sq_n == 2 ? seq_ui_sq_a11 : seq_ui_sq_a10) == _sc_a1)) ? (
      seq_ui_sq_n == 3 ? ( seq_ui_sq_a12 = _sc_a1; seq_ui_sq_a22 = _sc_a2; )
      : seq_ui_sq_n == 2 ? ( seq_ui_sq_a11 = _sc_a1; seq_ui_sq_a21 = _sc_a2; )
      : ( seq_ui_sq_a10 = _sc_a1; seq_ui_sq_a20 = _sc_a2; );
    )
    : seq_ui_sq_n == 0 ? ( seq_ui_sq_op0 = _sc_op; seq_ui_sq_a10 = _sc_a1; seq_ui_sq_a20 = _sc_a2; seq_ui_sq_e0 = time_precise(); seq_ui_sq_n = 1; )
    : seq_ui_sq_n == 1 ? ( seq_ui_sq_op1 = _sc_op; seq_ui_sq_a11 = _sc_a1; seq_ui_sq_a21 = _sc_a2; seq_ui_sq_e1 = time_precise(); seq_ui_sq_n = 2; )
    : seq_ui_sq_n == 2 ? ( seq_ui_sq_op2 = _sc_op; seq_ui_sq_a12 = _sc_a1; seq_ui_sq_a22 = _sc_a2; seq_ui_sq_e2 = time_precise(); seq_ui_sq_n = 3; )
    : ( strcpy(#seq_ui_msg, "Too quick: that change was not sent. Wait a moment and do it again."); seq_ui_msg_until = time_precise() + 3; );   // a fourth while three wait: dropped, with a word (seq_ui_say's two writes: it is defined further down)
    seq_ui_song_pump();   // at once when the last post had its time
  );
);
// LOOP Region follows the pattern the face put on screen (the small things round; the spec: "a chip click, a tab click,
// keys"): while the bridge reads REAPER's loop as a region (SONG band +5 == 1), the region playing pattern _lf_p becomes
// the loop -- one op 16, and only when it is another region than the one looped (+6). Every gesture that puts a pattern
// on screen calls this at once, with the pattern it chose: playing synced, the engine turns the screen to the
// playhead's region on the next block, so a check made a frame later would see the playhead's pattern, not the click.
// The panel's own check (swing_seq_panel_draw) takes the other changes -- a trigger note, the Drum Matrix -- while the
// song is stopped; seq_ui_lf_pat is the pattern it last took. _lf_ord: the region clicked (a region chip), 0 = the region
// playing the pattern (seq_ui_region_of's rule: the first in time).
function seq_ui_loop_follow(_lf_p, _lf_ord) local(_lf_sb, _lf_o, _lf_i) (
  seq_ui_lf_pat = _lf_p;
  seq_opt_sync && _reg_my_slot >= 0 && gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 && gmem[GS_BRIDGE_LEVEL] >= SEQ_UI_SONG_LEVEL ? (
    _lf_sb = EON_SS_SONG_BASE + _reg_my_slot * EON_SS_SONG_STRIDE;
    _lf_o = _lf_ord; _lf_i = 0;   // 1-based
    _lf_o < 1 ? ( _lf_o = 0; loop(max(0, min(64, seq_map_n | 0)), !_lf_o && (seq_map[_lf_i * 4 + 2] | 0) == _lf_p ? _lf_o = _lf_i + 1; _lf_i += 1; ); );
    (gmem[_lf_sb + 5] | 0) == 1 && _lf_o > 0 && _lf_o != (gmem[_lf_sb + 6] | 0) ? seq_ui_song_cmd(16, 1, _lf_o);
  );
);

// The panel's ask, canvas px: the user's dragged height (seq_h, saved with the project) or the default.
function swing_seq_req_h() (
  seq_h > 0 ? max(swing_px(SEQ_H_MIN_B), min(2000, seq_h | 0)) : swing_px(SEQ_PANEL_H_B);
);
// The browser's ask when it is placed below the pads (fb_place 3; round two J's swap, 2026-10-22): its dragged height
// (fb_h, gate 81, 0 = the default) or the default.
FB_BOTTOM_H_B = 300;
function swing_fb_req_h() (
  fb_h > 0 ? max(swing_px(SEQ_H_MIN_B), min(2000, fb_h | 0)) : swing_px(FB_BOTTOM_H_B);
);
// The handle's reach above the gutter (2026-10-27; the owner: "Resizing the side and bottom panels: hard to grab"). With a
// panel open below, the grab (the press, the wheel, the lit edge, the resize cursor) also takes the SEQ_GRIP_EXT px just
// above the gutter over the PADS' column: the pad well's own bottom margin (rk_swing_ui_grid_pads: the well ends 4 px
// above ui_bot and no pad control reaches into it), so no control loses a click there. The left column (the MASTER VOL
// label) and the side slot's column (its controls reach its bottom) are not taken -- there the control wins -- nor the
// corner where the side seam's own reach is (swing_side_seam_ext), nor while a gesture on the pads is live (a pad swap,
// a mini knob: the drag is theirs). Fixed px, not scaled: the well's margin does not scale.
SEQ_GRIP_EXT = 4;
function seq_ui_grip_ext(_ge_mx, _ge_my) (
  seq_gut_h > 0 && bot_panel > 0 && big_view_id == VIEW_NONE && !_grid_gesture_live && _ge_my >= ui_bot - SEQ_GRIP_EXT && _ge_my < ui_bot
    && _ge_mx >= right_x && _ge_mx < right_x + right_w - SEQ_GRIP_EXT;
);

// ── The panel's height, once per pass (the host calls this right after swing_fb_gate) ────────────────
// The browser's rule for width (swing_fb_gate_window; read its comments first), applied to height: the panel
// only ever occupies height the WINDOW HAS ALREADY BEEN GIVEN. It asks for the whole height at once -- a
// CONSTANT request, never one derived from gfx_h, which would feed back -- and takes nothing until that height
// arrives, so the pads never move and the panel appears in space that did not exist a frame earlier. The
// bridge grows the floating window downward (eon_fb_grow, the FB_REQ_GROWH word of this instance's browser
// band); a project that loads with the panel open comes with its window already tall, so the first frame
// ADOPTS that height rather than asking again, and a dock or undock re-baselines (the window means something
// else on the other side of it). Where the window cannot grow -- docked, embedded, no js_ReaScriptAPI, a bridge
// that never answers, a screen too short for the whole ask -- the panel takes the height from the pads instead,
// immediately where that is knowable and after twenty frames where it is not, down to the pads' floor.
// Window passes only; an embed pass gets no gutter and no panel. Sets seq_gut_h, seq_h_cur and ui_bot, the main
// face's bottom edge (gfx_h in the rack face and the embeds), which the layout reads instead of gfx_h.
function swing_seq_gate() local(_cap, _got, _cangrow, _req, _b, _full, _seq_in) (
  // the panel lives in the full UI; the rack face keeps the big view. The USER's face (dock_face_user: the choice or Auto's
  // pick), not the face drawn: the compact switch (the small things round, 2026-10-23) draws the rack face while the panel
  // leaves too little room, and the panel must stay -- reading dock_face here dropped the grow request, the window shrank,
  // the room came back and the face flipped back and forth. Since 2026-10-27 the rack face Auto picks from a floating
  // window's shape keeps the slot too (rk_swing_ui_state swing_bot_slot; the owner: the handle must not disappear when
  // the window is resized to the compact face); the dock rig's capture and the user's own Rack pick keep none.
  _full = swing_bot_slot();
  seq_gut_h = _full ? swing_px(SEQ_GUTTER_H_B) : 0;
  // the bottom slot's panel (round two J's swap, 2026-10-22): the sequencer unless it is placed at the side (seq_place 1),
  // the browser when it is placed below (fb_place 3), the pad editor when it is (fx_place 3; the user: "I want it all").
  // The slot's logic below reads _bot_on where it read seq_shown; the keys and the focus stay the sequencer's own.
  // Two or three below and open: the LAST OPENED is the one shown -- each takes a stamp the frame it becomes open-and-
  // below (the strip's chips and the PAD FX button re-stamp an open one to bring it to the front); the sequencer is
  // stamped last here, so a project that opens with all of them below shows the sequencer.
  _bot_sq = seq_shown && seq_place != 1; _bot_fb = fb_open && fb_place == 3; _bot_fx = pfx_open && fx_place == 3;
  _bot_fx && !_bot_fx_prev ? pfx_bstamp = (bot_stamp += 1); _bot_fb && !_bot_fb_prev ? fb_bstamp = (bot_stamp += 1); _bot_sq && !_bot_sq_prev ? seq_bstamp = (bot_stamp += 1);
  _bot_fx_prev = _bot_fx; _bot_fb_prev = _bot_fb; _bot_sq_prev = _bot_sq;
  bot_panel = 0; _bot_best = -1;
  _bot_sq && seq_bstamp > _bot_best ? ( bot_panel = 1; _bot_best = seq_bstamp; );
  _bot_fb && fb_bstamp > _bot_best ? ( bot_panel = 2; _bot_best = fb_bstamp; );
  _bot_fx && pfx_bstamp > _bot_best ? ( bot_panel = 3; _bot_best = pfx_bstamp; );
  _bot_on = bot_panel > 0;
  _req = bot_panel == 2 ? swing_fb_req_h() : bot_panel == 3 ? swing_pfx_req_h() : swing_seq_req_h();
  !is_embedded ? (
    _b = swing_fb_band();
    // canvas px; moves only with the bottom panel and its height. Only with a slot of its own (audit K16): swing_fb_band
    // clamps a slotless Swing -- the seventeenth, the first frames before @block claims one -- onto slot 0's band, where
    // its ask fought that Swing's; with no slot the bridge cannot answer and the pads give the height (the squeeze)
    _reg_my_slot >= 0 ? gmem[_b + FB_REQ_GROWH] = (_full && _bot_on) ? _req : 0;
    seq_tr_rpt = gmem[_b + FB_TR_RPT]; seq_tr_meas = gmem[_b + FB_TR_MEAS]; seq_tr_beat = gmem[_b + FB_TR_BEAT];
    seq_ui_ack_tick();    // the engine's acks (a kit's patterns, a preset, ADAPT, the landed count), panel open or not (K8)
    seq_ui_undo_tick();
    seq_ui_song_pump();   // a queued song op goes out once the last one had its time (seq_ui_song_cmd)
    // the sequencer gone from every home: its picker and its drags go with it (the big view counts as a home), and the
    // LOOP's follow forgets the pattern (opened again, the panel only notes it); a gesture ends with the button (window
    // passes only: an embed's own button says nothing about the window's press)
    !seq_shown && big_view_id != VIEW_SEQ ? ( seq_ui_pk_lane = -1; seq_ui_sdrag = 0; seq_ui_scrub = 0; seq_ui_lf_pat = -1; );
    !_raw_LMB ? seq_ui_scrub = 0;
  );
  _full ? (
    // What the panel may take this frame: the ask, but never past the pads' floor.
    // ... and never into the room a panel at the SIDE needs (the editor's 560 + its tab row): the panel below gives way
    // first, the editor's bottom is never cut while the window has the height for both (2026-10-22)
    // DOCKED (the dock rig holds this Swing: the window cannot grow; 2026-10-27, the owner: what was open stays open
    // once docked): the pads give the height down to their floor under the face actually drawn -- the rack face's own
    // header (rk_swing_ui_state's rack_hdr_h), not the full face's LCD bar -- and the side panels' height is not held
    // back: a docker is never tall enough for the editor's 560 and the panel below together, and holding it left the
    // panel below at 0 (only its handle) whenever the pad editor was open at the side.
    _cangrow = swing_fb_can_grow();
    _cap = max(0, min(_req, gfx_h - 28 - swing_px(LCD_BAR_H) - swing_px(BANK_STRIP_H) - max(swing_px(SEQ_PADS_MIN_H_B), swing_side_need_h()) - seq_gut_h));
    !_cangrow ? _cap = max(0, min(_req, gfx_h - (dock_face_user ? max(26, min(40, (gfx_h * 0.12) | 0)) : 28 + swing_px(LCD_BAR_H))
                                            - swing_px(BANK_STRIP_H) - swing_px(SEQ_PADS_MIN_H_B) - seq_gut_h));
    // ... at its own smallest height or not at all: under it the panel's toolbars and footer draw over each other (seen
    // at 56 px in a 380 px docker); the gutter -- its handle, its status line -- stays and says it is open
    !_cangrow && _cap < (bot_panel == 3 ? swing_px(PFX_BOTTOM_MIN_B) : swing_px(SEQ_H_MIN_B)) ? _cap = 0;
    _seq_h_init ? 0 : (
      _seq_base_h = _bot_on ? (gfx_h - _cap) : gfx_h;   // first frame: a window restored tall already carries the panel
      _seq_base_set = 1; _seq_h_init = 1; _seq_growp = _cangrow;
    );
    // a dock or an undock re-bases on what the window CARRIED (_seq_carry_h: all of the panel's height, or the part the
    // screen gave -- then the pads gave the rest, so they do again at once; 2026-10-27, the dock's one-to-one, the side
    // slot's twin in rk_swing_ui_minibrowser)
    _seq_growp != _cangrow ? (
      _seq_growp = _cangrow;
      _seq_base_h = (_bot_on && _seq_carry_h > 0) ? (gfx_h - _seq_carry_h) : gfx_h;
      _seq_base_set = 1; _seq_squeeze = (_bot_on && _seq_carry_h > 0 && !_seq_carry) ? 1 : 0; _seq_wait = 0;
    );
    _bot_on && !_seq_base_set ? ( _seq_base_h = gfx_h; _seq_base_set = 1; _seq_wait = 0; );
    // The closing edge (audit 2026-10-22, READ_HIGH_MEDIUM:160): the bridge gives back exactly the height it GREW, so the
    // window stops at its old height PLUS whatever the user dragged it taller by meanwhile -- and measured from the old
    // base that extra read as the panel's: _got stayed above 0, part of the panel stayed on screen with nothing open and
    // the face stayed short. The panel holds what it showed, so the base becomes the height minus that hold; the window's
    // give-back then lands _got on 0. A hold the window never takes back (no bridge, a resize during it) ends after
    // SEQ_CLOSE_SETTLE seconds. The squeeze holds nothing once closed and keeps its base (the grant comes back off it).
    !_bot_on && _seq_on_prev && _seq_base_set ? (
      !_seq_squeeze ? _seq_base_h = gfx_h - _seq_hold_prev;
      _seq_close_t = time_precise();
    );
    _got = _seq_base_set ? max(0, gfx_h - _seq_base_h) : 0;
    _bot_on ? (
      _seq_wait += 1;
      // Immediate where growth is impossible; after twenty frames where the window gave nothing or not all of it
      // (a bridge that does not answer, a screen too short): the pads give the rest.
      (!_cangrow || (_seq_wait > 20 && _got < _cap - 2)) ? _seq_squeeze = 1;
    ) : ( _seq_wait = 0; );
    // 2026-10-27 (the dock's one-to-one; the side slot's twin, rk_swing_ui_minibrowser swing_fb_gate), after the squeeze:
    // with no dock rig up the window is ours and this follows it squeezed or not (_seq_carry_h, the height carried, for
    // the relatch above); with a rig up, a squeezed frame is frozen: the dock's first frames have the canvas in the
    // docker already and slider42 not yet set ("can grow"), and in a docker shorter than the float the shrink read as
    // "the window no longer carries the panel" (tb_test.py D, through the harness).
    _cangrow && (!_seq_squeeze || !swing_dock_rig_up()) ? (
      _seq_carry   = (_bot_on && _got >= _cap - 2) ? 1 : 0;
      _seq_carry_h = _bot_on ? min(_got, _cap) : 0;
    );
    seq_h_cur = _seq_squeeze ? (_bot_on ? _cap : 0) : min(_cap, _got);
    // closed: the hold ends when the window took it back, or when it waited SEQ_CLOSE_SETTLE for that in vain
    !_bot_on && _seq_base_set && (_got < 1 || time_precise() - _seq_close_t > SEQ_CLOSE_SETTLE) ? ( _seq_base_set = 0; _seq_squeeze = 0; seq_h_cur = 0; );
    _seq_hold_prev = seq_h_cur; _seq_on_prev = _bot_on;
    seq_ui_take_win = seq_gut_h + seq_h_cur;
  ) : (
    seq_h_cur = 0;
    !is_embedded ? ( seq_ui_take_win = 0; _seq_hold_prev = 0; _seq_on_prev = 0; );   // the rack face (the user's) holds nothing: no closing edge on the way back
  );
  ui_bot = gfx_h - seq_gut_h - seq_h_cur;

  // ── The mouse claim (S2a, 2026-10-20; the user: "we have some click thru when the step seq is open") ──
  // The gutter and the panel own everything from ui_bot down, the browser strip's way (swing_fb_gate_window):
  // a press, a wheel notch or a right click that lands there is stashed here and ZEROED for the face, whose
  // handlers run between this gate and swing_seq_under_draw -- which hands the stash back to the panel and
  // leaves the rest of the frame with nothing. Before this the panel drew last and read the same globals the
  // face had already acted on, so a click on a step also landed on whatever the face keeps under that pixel.
  // A press that BEGAN here keeps the claim until the button comes up wherever the cursor goes (a cell drag, a
  // value box, the gutter's grab); a press that began on the face is never taken (a knob or a pad swap
  // wandering over the panel: _fb_yield's _grid_gesture_live, and any held button that did not start here).
  // A modal -- an overlay, a big view, a popup -- owns the frame before this gate and the claim stands down.
  // Window passes only: an embed pass in between must not reset the window's own press. Spelled lmbdown /
  // lmbclick because EEL2 names are case-insensitive (the strip's own trap).
  _full ? (
    !LMB ? seq_ui_mouse_own = 0;
    _seq_in = big_view_id == VIEW_NONE && !_ui_modal_up && !swing_popup_active && !_fb_yield
             && mx >= 0 && mx < gfx_w && ((my >= ui_bot && my < gfx_h) || seq_ui_grip_ext(mx, my));   // + the handle's reach above the gutter
    _seq_in && lmb_down ? ( seq_ui_mouse_own = 1; seq_ui_focus = bot_panel == 1 ? 1 : 0; );   // the keys follow a press on the SEQUENCER's panel; one on the browser placed below (bot_panel 2) or on the bare strip gives them up (the swap's audit)
    !_seq_in && lmb_down ? seq_ui_focus = 0;   // a click on the face takes the keys back
    !seq_shown ? seq_ui_focus = 0;
    _seq_claim = seq_ui_mouse_own || (_seq_in && !LMB);   // SEQ MOUSE CLAIM
  ) : ( _seq_claim = 0; );
  _seq_claim ? (
    _seq_g_lmbdown = lmb_down; _seq_g_rmbdown = rmb_down;
    _seq_g_lmbclick = LMB;     _seq_g_rmbclick = RMB;
    _seq_g_wheel = frame_wheel;
    lmb_down = 0; rmb_down = 0; LMB = 0; RMB = 0; frame_wheel = 0;
  ) : (
    _seq_g_lmbdown = 0; _seq_g_rmbdown = 0; _seq_g_lmbclick = 0; _seq_g_rmbclick = 0; _seq_g_wheel = 0;
  );
  // The drawn picker up (the small things round): modal for the whole WINDOW, as the popup it replaced was -- a press, a
  // right press or a wheel notch on the face outside the sequencer's home closes it and is nobody else's (the spec: "a
  // press outside closes it (the press is consumed)"). The home's own share is already stashed (the claim above; the side
  // column's by the browser's gate); the big view has the modal gate's. The picker reads the raw button (and the right
  // press kept here) to close. Only a picker drawn since the last window pass holds the face: one no home draws any more
  // (the side column folded, the panel moved) is closed here instead, so an unseen picker never takes the face's mouse.
  !is_embedded ? (
    seq_ui_pk_lane >= 0 && !seq_ui_pk_seen ? seq_ui_pk_lane = -1;
    seq_ui_pk_seen = 0; seq_ui_pk_rawr = 0;
    seq_ui_pk_lane >= 0 && !_ui_modal_up ? (
      seq_ui_pk_rawr = rmb_down;
      lmb_down = 0; rmb_down = 0; LMB = 0; RMB = 0; frame_wheel = 0;
    );
  );
);

// The button chrome in the panel's palette (the TOOLS row's bevel, on the LCD-dark panel): a fill that lifts on
// hover and sinks on a press, rounded corners (the panel's colour in the corner pixels), a light top and left
// edge, a dark bottom and right edge, a tinted fill when lit (_bc_r/g/b, 0 = the house blue). The user, 2026-10-20:
// "put some polish on those buttons!"
function seq_ui_btn_chrome(_bc_x, _bc_y, _bc_w, _bc_h, _bc_lit, _bc_hov, _bc_r, _bc_g, _bc_b) local(_bc_dn) (
  _bc_dn = _bc_hov && LMB;
  _bc_lit ? gfx_set(_bc_r, _bc_g, _bc_b, 1)
          : _bc_dn ? gfx_set(0.13, 0.18, 0.23, 1) : _bc_hov ? gfx_set(0.26, 0.33, 0.40, 1) : gfx_set(0.20, 0.26, 0.32, 1);
  gfx_rect(_bc_x, _bc_y, _bc_w, _bc_h);
  // the corners, in the panel's own colour: the rounding
  gfx_set(lcd_bg_r, lcd_bg_g, lcd_bg_b, 0.98);
  gfx_rect(_bc_x, _bc_y, 1, 1); gfx_rect(_bc_x + _bc_w - 1, _bc_y, 1, 1);
  gfx_rect(_bc_x, _bc_y + _bc_h - 1, 1, 1); gfx_rect(_bc_x + _bc_w - 1, _bc_y + _bc_h - 1, 1, 1);
  // the bevel: light above and left, dark below and right; a press drops the light edge
  gfx_set(1, 1, 1, _bc_dn ? 0.05 : (_bc_lit ? 0.32 : (_bc_hov ? 0.26 : 0.16)));
  gfx_rect(_bc_x + 1, _bc_y, _bc_w - 2, 1); gfx_rect(_bc_x, _bc_y + 1, 1, _bc_h - 2);
  gfx_set(0, 0, 0, _bc_dn ? 0.15 : 0.38);
  gfx_rect(_bc_x + 1, _bc_y + _bc_h - 1, _bc_w - 2, 1); gfx_rect(_bc_x + _bc_w - 1, _bc_y + 1, 1, _bc_h - 2);
  _bc_lit && !_bc_dn ? ( gfx_set(1, 1, 1, 0.10); gfx_rect(_bc_x + 1, _bc_y + 1, _bc_w - 2, 1); );
);
// A toolbar button. Returns 1 while the mouse is over it. Digits go regular below 10 px (wiki 4.7).
function seq_ui_btn(_bt_x, _bt_y, _bt_w, _bt_h, _bt_s, _bt_lit) local(_bt_hov, _bt_tw, _bt_th, _bt_fs) (
  _bt_hov = mx >= _bt_x && mx < _bt_x + _bt_w && my >= _bt_y && my < _bt_y + _bt_h;
  seq_ui_btn_chrome(_bt_x, _bt_y, _bt_w, _bt_h, _bt_lit, _bt_hov, 0.20, 0.62, 0.86);
  _bt_fs = swing_fs(9);
  rk_font(1, _bt_fs, swing_txt_wt(_bt_fs, _bt_s));
  gfx_set(1, 1, 1, _bt_lit ? 1 : 0.88);
  gfx_measurestr(_bt_s, _bt_tw, _bt_th);
  gfx_x = _bt_x + (_bt_w - _bt_tw) * 0.5; gfx_y = _bt_y + (_bt_h - _bt_th + (_bt_hov && LMB ? 1 : 0)) * 0.5; gfx_drawstr(_bt_s);
  _bt_hov;
);
// A reserved button (P0b): the same shape, sunk and greyed, taking no press -- the place a later step's control
// fills (the pattern tools, TRIG, the preset strip, SYNC, PRINT, MIDI, the 9-16 tab), so that step lights a
// button instead of re-laying the panel. Returns 1 while the mouse is over it (the caller shows what is coming).
function seq_ui_btn_dim(_bd_x, _bd_y, _bd_w, _bd_h, _bd_s) local(_bd_hov, _bd_tw, _bd_th, _bd_fs) (
  _bd_hov = mx >= _bd_x && mx < _bd_x + _bd_w && my >= _bd_y && my < _bd_y + _bd_h;
  gfx_set(0.16, 0.20, 0.25, 1); gfx_rect(_bd_x, _bd_y, _bd_w, _bd_h);
  gfx_set(lcd_bg_r, lcd_bg_g, lcd_bg_b, 0.98);
  gfx_rect(_bd_x, _bd_y, 1, 1); gfx_rect(_bd_x + _bd_w - 1, _bd_y, 1, 1);
  gfx_rect(_bd_x, _bd_y + _bd_h - 1, 1, 1); gfx_rect(_bd_x + _bd_w - 1, _bd_y + _bd_h - 1, 1, 1);
  gfx_set(1, 1, 1, 0.06); gfx_rect(_bd_x + 1, _bd_y, _bd_w - 2, 1); gfx_rect(_bd_x, _bd_y + 1, 1, _bd_h - 2);
  gfx_set(0, 0, 0, 0.22); gfx_rect(_bd_x + 1, _bd_y + _bd_h - 1, _bd_w - 2, 1); gfx_rect(_bd_x + _bd_w - 1, _bd_y + 1, 1, _bd_h - 2);
  _bd_fs = swing_fs(9);
  rk_font(1, _bd_fs, swing_txt_wt(_bd_fs, _bd_s));
  gfx_set(1, 1, 1, _bd_hov ? 0.5 : 0.36);
  gfx_measurestr(_bd_s, _bd_tw, _bd_th);
  gfx_x = _bd_x + (_bd_w - _bd_tw) * 0.5; gfx_y = _bd_y + (_bd_h - _bd_th) * 0.5; gfx_drawstr(_bd_s);
  _bd_hov;
);
// A string cut to a width (the small things round; the preset's name box, the picker's names): measured in the font
// set now; past _ft_w its end goes and "..." takes its place (the longest start that fits, found by halving) ->
// #seq_ui_fit, also returned. Never pass #seq_ui_fit itself. The widths start at 0 each measure (wiki 4.8).
function seq_ui_fit(_ft_s, _ft_w) local(_ft_tw, _ft_th, _ft_lo, _ft_hi, _ft_m) (
  strcpy(#seq_ui_fit, _ft_s);
  _ft_tw = 0; _ft_th = 0; gfx_measurestr(#seq_ui_fit, _ft_tw, _ft_th);
  _ft_tw > _ft_w ? (
    _ft_lo = 0; _ft_hi = strlen(_ft_s);   // a start of _ft_lo chars fits with "..." after it; the whole string does not
    while(_ft_hi - _ft_lo > 1) (
      _ft_m = floor((_ft_lo + _ft_hi) * 0.5);
      strcpy_substr(#seq_ui_fit, _ft_s, 0, _ft_m); strcat(#seq_ui_fit, "...");
      _ft_tw = 0; gfx_measurestr(#seq_ui_fit, _ft_tw, _ft_th);
      _ft_tw <= _ft_w ? _ft_lo = _ft_m : _ft_hi = _ft_m;
    );
    strcpy_substr(#seq_ui_fit, _ft_s, 0, _ft_lo); strcat(#seq_ui_fit, "...");
  );
  #seq_ui_fit;
);
// A transport button: the same chrome with its own lit colour and a drawn glyph (_tb_k: 1 to the start, 2 play,
// 3 stop, 4 loop). Returns 1 while the mouse is over it. Anti-aliased lines and arcs; the fills are plain shapes.
function seq_ui_tbtn(_tb_x, _tb_y, _tb_w, _tb_h, _tb_k, _tb_lit) local(_tb_hov, _tb_cx, _tb_cy, _tb_r, _tb_a) (
  _tb_hov = mx >= _tb_x && mx < _tb_x + _tb_w && my >= _tb_y && my < _tb_y + _tb_h;
  _tb_k == 2 ? seq_ui_btn_chrome(_tb_x, _tb_y, _tb_w, _tb_h, _tb_lit, _tb_hov, 0.22, 0.72, 0.38)
  : _tb_k == 4 ? seq_ui_btn_chrome(_tb_x, _tb_y, _tb_w, _tb_h, _tb_lit, _tb_hov, 0.92, 0.64, 0.18)
  : seq_ui_btn_chrome(_tb_x, _tb_y, _tb_w, _tb_h, 0, _tb_hov, 0.20, 0.62, 0.86);
  _tb_cx = _tb_x + _tb_w * 0.5; _tb_cy = _tb_y + _tb_h * 0.5 + (_tb_hov && LMB ? 0.5 : 0); _tb_r = _tb_h * 0.22;
  // the glyph: dark on a lit button; the loop's OFF state has its own colour, a slate blue against the amber of ON
  // (the user, 2026-10-20: "Loop icon should have a color for when its on and off")
  _tb_lit ? gfx_set(0.05, 0.08, 0.10, 0.95)
  : _tb_k == 4 ? gfx_set(0.50, 0.66, 0.88, _tb_hov ? 1 : 0.92)
  : gfx_set(1, 1, 1, _tb_hov ? 1 : 0.88);
  _tb_k == 1 ? (   // to the start: a bar and a left-pointing triangle
    gfx_rect(_tb_cx - _tb_r - 1, _tb_cy - _tb_r, 2, _tb_r * 2);
    gfx_triangle(_tb_cx + _tb_r + 1, _tb_cy - _tb_r, _tb_cx + _tb_r + 1, _tb_cy + _tb_r, _tb_cx - _tb_r + 2, _tb_cy);
    gfx_line(_tb_cx + _tb_r + 1, _tb_cy - _tb_r, _tb_cx - _tb_r + 2, _tb_cy, 1); gfx_line(_tb_cx - _tb_r + 2, _tb_cy, _tb_cx + _tb_r + 1, _tb_cy + _tb_r, 1);
  ) : _tb_k == 2 ? (   // play
    gfx_triangle(_tb_cx - _tb_r + 1, _tb_cy - _tb_r, _tb_cx - _tb_r + 1, _tb_cy + _tb_r, _tb_cx + _tb_r + 1, _tb_cy);
    gfx_line(_tb_cx - _tb_r + 1, _tb_cy - _tb_r, _tb_cx + _tb_r + 1, _tb_cy, 1); gfx_line(_tb_cx + _tb_r + 1, _tb_cy, _tb_cx - _tb_r + 1, _tb_cy + _tb_r, 1);
  ) : _tb_k == 3 ? (   // stop
    gfx_rect(_tb_cx - _tb_r + 1, _tb_cy - _tb_r + 1, _tb_r * 2 - 1, _tb_r * 2 - 1);
  ) : _tb_k == 5 || _tb_k == 6 ? (   // the full face: four corners out (5: over the whole face), or in (6: back to the panel)
    _tb_a = _tb_k == 5 ? _tb_r + 1 : _tb_r * 0.5;
    _tb_r = _tb_k == 5 ? _tb_a - _tb_r * 0.8 : _tb_a + _tb_r * 0.8;   // where the corners' legs end
    gfx_line(_tb_cx - _tb_a, _tb_cy - _tb_a, _tb_cx - _tb_r, _tb_cy - _tb_a, 1); gfx_line(_tb_cx - _tb_a, _tb_cy - _tb_a, _tb_cx - _tb_a, _tb_cy - _tb_r, 1);
    gfx_line(_tb_cx + _tb_a, _tb_cy - _tb_a, _tb_cx + _tb_r, _tb_cy - _tb_a, 1); gfx_line(_tb_cx + _tb_a, _tb_cy - _tb_a, _tb_cx + _tb_a, _tb_cy - _tb_r, 1);
    gfx_line(_tb_cx - _tb_a, _tb_cy + _tb_a, _tb_cx - _tb_r, _tb_cy + _tb_a, 1); gfx_line(_tb_cx - _tb_a, _tb_cy + _tb_a, _tb_cx - _tb_a, _tb_cy + _tb_r, 1);
    gfx_line(_tb_cx + _tb_a, _tb_cy + _tb_a, _tb_cx + _tb_r, _tb_cy + _tb_a, 1); gfx_line(_tb_cx + _tb_a, _tb_cy + _tb_a, _tb_cx + _tb_a, _tb_cy + _tb_r, 1);
  ) : (   // loop: an open ring, two turns thick, with an arrowhead at the gap
    gfx_arc(_tb_cx, _tb_cy, _tb_r, 0.75, 2 * $pi - 0.55, 1); gfx_arc(_tb_cx, _tb_cy, _tb_r - 1, 0.75, 2 * $pi - 0.55, 1);
    _tb_a = 0.75;
    gfx_triangle(_tb_cx + (_tb_r + 2.5) * sin(_tb_a), _tb_cy - (_tb_r + 2.5) * cos(_tb_a),
                 _tb_cx + (_tb_r - 3) * sin(_tb_a), _tb_cy - (_tb_r - 3) * cos(_tb_a),
                 _tb_cx + _tb_r * sin(_tb_a + 0.6), _tb_cy - _tb_r * cos(_tb_a + 0.6));
  );
  _tb_hov;
);
// The transport's loop icon (2026-10-26): the loop glyph, lit while looping, with a small letter inside its ring -- _lb_ch
// 'R' the region, 'S' the song, 0 none (REAPER's plain repeat). Returns 1 while the mouse is over it.
function seq_ui_loop_btn(_lb_x, _lb_y, _lb_w, _lb_h, _lb_lit, _lb_ch) local(_lb_hov, _lb_tw, _lb_th, _lb_fs) (
  _lb_hov = seq_ui_tbtn(_lb_x, _lb_y, _lb_w, _lb_h, 4, _lb_lit);
  _lb_ch > 0 ? (
    _lb_fs = swing_fs(7);
    rk_font(1, _lb_fs, 'b');
    _lb_lit ? gfx_set(0.05, 0.08, 0.10, 1) : gfx_set(0.50, 0.66, 0.88, 1);   // the glyph's own colour (seq_ui_tbtn)
    sprintf(#seq_ui_lbch, "%c", _lb_ch);
    _lb_tw = 0; _lb_th = 0; gfx_measurestr(#seq_ui_lbch, _lb_tw, _lb_th);
    gfx_x = _lb_x + (_lb_w - _lb_tw) * 0.5; gfx_y = _lb_y + (_lb_h - _lb_th) * 0.5 + (_lb_hov && LMB ? 0.5 : 0);
    gfx_drawstr(#seq_ui_lbch);
  );
  _lb_hov;
);

// An editor value box: a caption in the corner, the value (the caller formats it into #seq_ui_val) at the
// bottom right; the wheel steps it, a drag up / down moves it (_vb_px pixels per step). Returns the value,
// changed or not; the caller writes it back when it differs. Ids keep one drag at a time.
function seq_ui_val(_vb_id, _vb_x, _vb_y, _vb_w, _vb_h, _vb_cap, _vb_v, _vb_min, _vb_max, _vb_step, _vb_px, _vb_on)
local(_vb_hov, _vb_tw, _vb_th, _vb_nv) (
  _vb_hov = _vb_on && mx >= _vb_x && mx < _vb_x + _vb_w && my >= _vb_y && my < _vb_y + _vb_h;
  gfx_set(0.10, 0.14, 0.18, _vb_on ? (_vb_hov ? 1 : 0.85) : 0.4); gfx_rect(_vb_x, _vb_y, _vb_w, _vb_h);
  rk_font(1, swing_fs(7), 0); gfx_set(0.55, 0.62, 0.72, _vb_on ? 0.9 : 0.45);
  gfx_x = _vb_x + 3; gfx_y = _vb_y + 1; gfx_drawstr(_vb_cap);
  rk_font(1, swing_fs(9), 0); gfx_set(0.9, 0.94, 1, _vb_on ? 0.95 : 0.35);
  gfx_measurestr(#seq_ui_val, _vb_tw, _vb_th);
  gfx_x = _vb_x + _vb_w - _vb_tw - 3; gfx_y = _vb_y + _vb_h - _vb_th - 1; gfx_drawstr(#seq_ui_val);
  _vb_nv = _vb_v;
  _vb_hov && frame_wheel != 0 ? _vb_nv = _vb_v + (frame_wheel > 0 ? _vb_step : -_vb_step);
  _vb_hov && lmb_down ? ( seq_ui_vdrag_id = _vb_id; seq_ui_vdrag_y0 = my; seq_ui_vdrag_v0 = _vb_v; );
  seq_ui_vdrag_id == _vb_id && LMB && _vb_on ? _vb_nv = seq_ui_vdrag_v0 + floor((seq_ui_vdrag_y0 - my) / _vb_px) * _vb_step;
  max(_vb_min, min(_vb_max, _vb_nv));
);

// The target picker's menu: a bank's sixteen pads by name, then the other three banks, then MIDI. The result maps back
// in the consumer: 1..16 = that pad, 17..19 = the other banks in order (the menu opens again on that bank), 20 = MIDI
// channel (the channel menu opens).
function seq_ui_pick_open(_po_bank) local(_po_i, _po_nm, _po_k, _po_j) (
  strcpy(#seq_ui_menu, "");
  _po_i = 0; loop(NUM_PADS,
    _po_nm = get_cname_slot(_po_bank * NUM_PADS + _po_i);
    strlen(_po_nm) == 0 ? _po_nm = get_name_slot(_po_bank * NUM_PADS + _po_i);
    strlen(_po_nm) == 0 ? ( sprintf(#seq_ui_nm, "Pad %d", _po_i + 1); _po_nm = #seq_ui_nm; );
    // the popup splits rows on '|' (rk_swing_popup): a name holding one would shift every pick below it one pad off
    strcpy(#seq_ui_nmsafe, _po_nm);
    _po_j = 0; loop(strlen(#seq_ui_nmsafe), str_getchar(#seq_ui_nmsafe, _po_j) == '|' ? str_setchar(#seq_ui_nmsafe, _po_j, '/'); _po_j += 1; );
    sprintf(#seq_ui_lbl, "%s%c%d  %s", _po_i ? "|" : "", 65 + _po_bank, _po_i + 1, #seq_ui_nmsafe);
    strcat(#seq_ui_menu, #seq_ui_lbl);
    _po_i += 1;
  );
  _po_k = 0; loop(NUM_BANKS,
    _po_k != _po_bank ? ( sprintf(#seq_ui_lbl, "|Bank %c ...", 65 + _po_k); strcat(#seq_ui_menu, #seq_ui_lbl); );
    _po_k += 1;
  );
  strcat(#seq_ui_menu, "|MIDI channel ...");   // S5: the lane plays its notes out as MIDI instead
  seq_ui_pick_bank = _po_bank;
  swing_popup_open(mx, my, #seq_ui_menu, SP_POPUP_CALLER_SEQ_TARGET);
);

// The preset strip (S3b): previous / next = a NAV bump on this instance's slot (the direction first, the counter last);
// the bridge stages the preset and the engine takes it (rk_seq_core seq_preset_tick).
function seq_ui_preset_nav(_pn_dir) local(_pn_b) (
  _reg_my_slot >= 0 ? (
    _pn_b = EON_SS_PCTRL_BASE + _reg_my_slot * EON_SS_PCTRL_STRIDE;
    // seeded above the cell's count (the song mailbox's rule, audit K17): @init puts the counter back to 0 while the bridge
    // keeps the count it last saw, so a reopened project's first press landed on that very count and was dropped
    seq_ui_pnav_seq = max(seq_ui_pnav_seq, gmem[_pn_b] | 0) + 1;
    gmem[_pn_b + 1] = _pn_dir; gmem[_pn_b] = seq_ui_pnav_seq;
  );
);
// A 0-ended string out of gmem (at most _gs_max chars) -> #seq_ui_gstr.
function seq_ui_gmem_str(_gs_b, _gs_max) local(_gs_i, _gs_c) (
  strcpy(#seq_ui_gstr, "");
  _gs_i = 0; _gs_c = gmem[_gs_b] | 0;
  while(_gs_c > 0 && _gs_i < _gs_max) (
    sprintf(#seq_ui_gstr2, "%s%c", #seq_ui_gstr, _gs_c); strcpy(#seq_ui_gstr, #seq_ui_gstr2);
    _gs_i += 1; _gs_c = gmem[_gs_b + _gs_i] | 0;
  );
);
// The preset list (S3b): the rows that pass the chips and the typed filter, as flat indices, rebuilt when any of them
// or the bridge's list changes (a text match reads every name once: a keystroke's cost, not a frame's).
function seq_ui_plist_rebuild() local(_rb_n, _rb_i, _rb_b, _rb_ok) (
  seq_ui_plist_n = 0;
  _rb_n = max(0, min(EON_SEQ_PLIST_MAX, gmem[EON_SEQ_PLIST_BASE + 1] | 0));
  strlen(#seq_ui_plist_filt) ? sprintf(#seq_ui_plist_pat, "*%s*", #seq_ui_plist_filt);
  _rb_i = 0;
  loop(_rb_n,
    _rb_b = EON_SEQ_PLIST_BASE + 1024 + _rb_i * 48;
    _rb_ok = (seq_ui_plist_genre < 0 || (gmem[_rb_b] | 0) == seq_ui_plist_genre)
          && (seq_ui_plist_feel < 0 || (gmem[_rb_b + 1] | 0) == seq_ui_plist_feel)
          && (seq_ui_plist_role < 0 || (gmem[_rb_b + 2] | 0) == seq_ui_plist_role);
    _rb_ok && strlen(#seq_ui_plist_filt) ? ( seq_ui_gmem_str(_rb_b + 4, 43); _rb_ok = matchi(#seq_ui_plist_pat, #seq_ui_gstr); );
    _rb_ok ? ( seq_ui_plist_ix[seq_ui_plist_n] = _rb_i; seq_ui_plist_n += 1; );
    _rb_i += 1;
  );
  seq_ui_plist_scroll = max(0, min(max(0, seq_ui_plist_n - 1), seq_ui_plist_scroll | 0));
  seq_ui_plist_seq = gmem[EON_SEQ_PLIST_BASE] | 0; seq_ui_plist_dirty = 0;
);
// A row picked: the bridge's SELECT on this slot (the index first, the counter last), the same path the ReaImGui browser took.
function seq_ui_preset_select(_ps_idx) local(_ps_b) (
  _reg_my_slot >= 0 ? (
    _ps_b = EON_SS_PCTRL_BASE + _reg_my_slot * EON_SS_PCTRL_STRIDE;
    seq_ui_psel_seq = max(seq_ui_psel_seq, gmem[_ps_b + 5] | 0) + 1;   // seeded above the cell's (K17, as the NAV counter)
    gmem[_ps_b + 6] = _ps_idx; gmem[_ps_b + 5] = seq_ui_psel_seq;
  );
);
// A chip: lit when its value is the one set; a click sets it (or clears it when lit). Returns the new value.
function seq_ui_chip(_ch_x, _ch_y, _ch_w, _ch_h, _ch_s, _ch_val, _ch_cur) (
  seq_ui_btn(_ch_x, _ch_y, _ch_w, _ch_h, _ch_s, _ch_cur == _ch_val) && lmb_down ? ( _ch_cur == _ch_val ? -1 : _ch_val ) : _ch_cur;
);
// The list inside the panel (S3b; the user: "can we have our own inside the sequencer"): over the lanes, under the
// toolbar. Genre chips, then feel and role chips, the typed filter, then the rows; the wheel scrolls, a click asks the
// bridge for that preset, the one playing (CUR_IDX) is marked. Escape or a click on the name closes it (BROWSE until round two G).
function seq_ui_plist_draw(_pd_x, _pd_y, _pd_w, _pd_h)
local(_pd_n, _pd_ng, _pd_g, _pd_cx, _pd_cy, _pd_cw, _pd_ch, _pd_tw, _pd_th, _pd_rows, _pd_i, _pd_k, _pd_b, _pd_ry, _pd_hov, _pd_cur, _pd_fs, _pd_lx, _pd_lw, _pd_ly, _pd_lh, _pd_any) (
  gfx_set(lcd_bg_r * 0.85, lcd_bg_g * 0.85, lcd_bg_b * 0.85, 1); gfx_rect(_pd_x, _pd_y, _pd_w, _pd_h);
  gfx_set(0.23, 0.37, 0.54, 0.55); gfx_rect(_pd_x, _pd_y, _pd_w, 1); gfx_rect(_pd_x, _pd_y + _pd_h - 1, _pd_w, 1);
  _pd_n = max(0, min(EON_SEQ_PLIST_MAX, gmem[EON_SEQ_PLIST_BASE + 1] | 0)); _pd_ng = max(0, min(32, gmem[EON_SEQ_PLIST_BASE + 2] | 0));
  (gmem[EON_SEQ_PLIST_BASE] | 0) != seq_ui_plist_seq ? seq_ui_plist_dirty = 1;
  _pd_fs = swing_fs(9); _pd_ch = swing_px(16); _pd_cx = _pd_x + swing_px(6); _pd_cy = _pd_y + swing_px(5);
  _pd_n == 0 ? (
    rk_font(1, _pd_fs, 0); gfx_set(0.75, 0.82, 0.9, 0.9); gfx_x = _pd_cx; gfx_y = _pd_cy;
    gfx_drawstr(gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? "The preset list is on its way from the Kit Bridge (a bridge started before this build publishes none: restart it)." : "The presets need the Kit Bridge.");
  ) : (
    // the genre chips, flowing across the width
    rk_font(1, _pd_fs, 0);
    seq_ui_btn(_pd_cx, _pd_cy, swing_px(34), _pd_ch, "ALL", seq_ui_plist_genre < 0) && lmb_down && seq_ui_plist_genre >= 0 ? ( seq_ui_plist_genre = -1; seq_ui_plist_dirty = 1; );
    _pd_cx += swing_px(36);
    _pd_g = 0;
    loop(_pd_ng,
      seq_ui_gmem_str(EON_SEQ_PLIST_BASE + 64 + _pd_g * 24, 23);
      rk_font(1, _pd_fs, swing_txt_wt(_pd_fs, #seq_ui_gstr)); gfx_measurestr(#seq_ui_gstr, _pd_tw, _pd_th); _pd_cw = _pd_tw + swing_px(12);   // measured in the chip's own font
      _pd_cx + _pd_cw > _pd_x + _pd_w - swing_px(6) ? ( _pd_cx = _pd_x + swing_px(6); _pd_cy += _pd_ch + 2; );
      _pd_k = seq_ui_chip(_pd_cx, _pd_cy, _pd_cw, _pd_ch, #seq_ui_gstr, _pd_g, seq_ui_plist_genre);
      _pd_k != seq_ui_plist_genre ? ( seq_ui_plist_genre = _pd_k; seq_ui_plist_dirty = 1; );
      _pd_cx += _pd_cw + 2;
      _pd_g += 1;
    );
    // the feel and the role
    _pd_cx = _pd_x + swing_px(6); _pd_cy += _pd_ch + swing_px(4);
    _pd_k = seq_ui_chip(_pd_cx, _pd_cy, swing_px(56), _pd_ch, "Straight", 0, seq_ui_plist_feel); _pd_cx += swing_px(58);
    _pd_k = seq_ui_chip(_pd_cx, _pd_cy, swing_px(48), _pd_ch, "Swung", 1, _pd_k); _pd_cx += swing_px(50);
    _pd_k = seq_ui_chip(_pd_cx, _pd_cy, swing_px(52), _pd_ch, "Triplet", 2, _pd_k); _pd_cx += swing_px(54);
    _pd_k != seq_ui_plist_feel ? ( seq_ui_plist_feel = _pd_k; seq_ui_plist_dirty = 1; );
    _pd_cx += swing_px(10);
    _pd_k = seq_ui_chip(_pd_cx, _pd_cy, swing_px(42), _pd_ch, "Main", 0, seq_ui_plist_role); _pd_cx += swing_px(44);
    _pd_k = seq_ui_chip(_pd_cx, _pd_cy, swing_px(36), _pd_ch, "Fill", 1, _pd_k); _pd_cx += swing_px(38);
    _pd_k = seq_ui_chip(_pd_cx, _pd_cy, swing_px(42), _pd_ch, "Build", 2, _pd_k); _pd_cx += swing_px(44);
    _pd_k = seq_ui_chip(_pd_cx, _pd_cy, swing_px(44), _pd_ch, "Break", 3, _pd_k); _pd_cx += swing_px(46);
    _pd_k = seq_ui_chip(_pd_cx, _pd_cy, swing_px(40), _pd_ch, "Perc", 4, _pd_k); _pd_cx += swing_px(42);
    _pd_k != seq_ui_plist_role ? ( seq_ui_plist_role = _pd_k; seq_ui_plist_dirty = 1; );
    // the typed filter
    _pd_cx += swing_px(10);
    gfx_set(0.10, 0.14, 0.18, 0.8); gfx_rect(_pd_cx, _pd_cy, _pd_x + _pd_w - swing_px(6) - _pd_cx, _pd_ch);
    rk_font(1, _pd_fs, 0);
    strlen(#seq_ui_plist_filt) ? ( gfx_set(0.95, 0.80, 0.45, 0.95); sprintf(#seq_ui_lbl, "%s_", #seq_ui_plist_filt); )
                               : ( gfx_set(0.55, 0.62, 0.72, 0.6); strcpy(#seq_ui_lbl, "type to filter  ·  Esc closes"); );
    gfx_x = _pd_cx + swing_px(4); gfx_y = _pd_cy + (_pd_ch - _pd_fs) * 0.5; gfx_drawstr(#seq_ui_lbl);
    seq_ui_plist_dirty ? seq_ui_plist_rebuild();
    // the rows
    _pd_ly = _pd_cy + _pd_ch + swing_px(5); _pd_lx = _pd_x + swing_px(6); _pd_lw = _pd_w - swing_px(12);
    _pd_lh = max(swing_px(14), swing_px(18)); _pd_rows = max(1, floor((_pd_y + _pd_h - swing_px(4) - _pd_ly) / _pd_lh));
    seq_ui_plist_x = _pd_lx; seq_ui_plist_row0_y = _pd_ly; seq_ui_plist_rowh = _pd_lh;
    mx >= _pd_lx && mx < _pd_lx + _pd_lw && my >= _pd_ly && my < _pd_y + _pd_h && frame_wheel != 0 ? (
      seq_ui_plist_scroll = max(0, min(max(0, seq_ui_plist_n - _pd_rows), seq_ui_plist_scroll + (frame_wheel > 0 ? -3 : 3)));
    );
    _pd_cur = seq_ui_pidx;
    _pd_i = 0;
    loop(_pd_rows,
      _pd_k = seq_ui_plist_scroll + _pd_i;
      _pd_k < seq_ui_plist_n ? (
        _pd_ry = _pd_ly + _pd_i * _pd_lh;
        _pd_b = EON_SEQ_PLIST_BASE + 1024 + (seq_ui_plist_ix[_pd_k] | 0) * 48;
        _pd_hov = mx >= _pd_lx && mx < _pd_lx + _pd_lw && my >= _pd_ry && my < _pd_ry + _pd_lh;
        (seq_ui_plist_ix[_pd_k] | 0) == _pd_cur && seq_ui_pcount > 0 ? ( gfx_set(0.20, 0.62, 0.86, 0.35); gfx_rect(_pd_lx, _pd_ry, _pd_lw, _pd_lh - 1); )
        : _pd_hov ? ( gfx_set(1, 1, 1, 0.08); gfx_rect(_pd_lx, _pd_ry, _pd_lw, _pd_lh - 1); )
        : (_pd_i & 1) ? ( gfx_set(1, 1, 1, 0.025); gfx_rect(_pd_lx, _pd_ry, _pd_lw, _pd_lh - 1); );
        seq_ui_gmem_str(_pd_b + 4, 43);
        rk_font(1, _pd_fs, 0); gfx_set(0.85, 0.9, 0.96, 0.95);
        gfx_x = _pd_lx + swing_px(8); gfx_y = _pd_ry + (_pd_lh - _pd_fs) * 0.5; gfx_drawstr(#seq_ui_gstr);
        // the genre and the feel at the right, dim
        seq_ui_gmem_str(EON_SEQ_PLIST_BASE + 64 + (gmem[_pd_b] | 0) * 24, 23);
        sprintf(#seq_ui_lbl, "%s  ·  %s", #seq_ui_gstr, (gmem[_pd_b + 1] | 0) == 2 ? "triplet" : (gmem[_pd_b + 1] | 0) == 1 ? "swung" : "straight");
        gfx_set(0.55, 0.62, 0.72, 0.8); gfx_measurestr(#seq_ui_lbl, _pd_tw, _pd_th);
        gfx_x = _pd_lx + _pd_lw - _pd_tw - swing_px(8); gfx_y = _pd_ry + (_pd_lh - _pd_fs) * 0.5; gfx_drawstr(#seq_ui_lbl);
        _pd_hov && lmb_down ? seq_ui_preset_select(seq_ui_plist_ix[_pd_k] | 0);
      );
      _pd_i += 1;
    );
    seq_ui_plist_n == 0 ? ( rk_font(1, _pd_fs, 0); gfx_set(0.55, 0.62, 0.72, 0.8); gfx_x = _pd_lx + swing_px(8); gfx_y = _pd_ly + swing_px(4); gfx_drawstr("nothing matches"); );
    // the count, bottom right
    sprintf(#seq_ui_lbl, "%d of %d", seq_ui_plist_n, _pd_n);
    rk_font(1, swing_fs(8), 0); gfx_set(0.55, 0.62, 0.72, 0.8); gfx_measurestr(#seq_ui_lbl, _pd_tw, _pd_th);
    gfx_x = _pd_x + _pd_w - _pd_tw - swing_px(8); gfx_y = _pd_y + _pd_h - _pd_th - swing_px(3); gfx_drawstr(#seq_ui_lbl);
  );
);
// A region request (S4): NEW (field 16, no ordinal), RENAME (17), DELETE (19), COLOUR (54) with the ordinal in 18 first.
function seq_ui_region_req(_rr_field, _rr_ord) local(_rr_b) (
  _reg_my_slot >= 0 ? (
    _rr_b = EON_SS_SYNC_BASE + _reg_my_slot * EON_SS_SYNC_STRIDE;
    gmem[_rr_b + 18] = _rr_ord;
    gmem[_rr_b + _rr_field] = (gmem[_rr_b + _rr_field] | 0) + 1;
  );
);
// A region's name out of the map mirror (three cells of four seven-bit chars) -> #seq_ui_gstr.
function seq_ui_map_name(_mn_i) local(_mn_k, _mn_c, _mn_v, _mn_n) (
  strcpy(#seq_ui_gstr, ""); _mn_k = 0; _mn_n = 0;
  loop(3,
    _mn_v = seq_map[256 + _mn_i * 3 + _mn_k] | 0; _mn_c = 0;
    loop(4,
      _mn_n = _mn_v - 128 * floor(_mn_v / 128); _mn_v = floor(_mn_v / 128);
      _mn_n > 0 ? ( sprintf(#seq_ui_gstr2, "%s%c", #seq_ui_gstr, _mn_n); strcpy(#seq_ui_gstr, #seq_ui_gstr2); );
      _mn_c += 1;
    );
    _mn_k += 1;
  );
);
// The chain's position of the first entry on region ordinal _cp_ord (1-based), 0 none.
function seq_ui_chain_pos(_cp_ord) local(_cp_b, _cp_n, _cp_i, _cp_hit, _cp_v) (
  _cp_hit = 0;
  _reg_my_slot >= 0 ? (
    _cp_b = EON_SS_SONG_BASE + _reg_my_slot * EON_SS_SONG_STRIDE; _cp_n = max(0, min(EON_SS_SONG_ENTRY_MAX, gmem[_cp_b + 1] | 0));
    _cp_i = 0; loop(_cp_n, _cp_v = gmem[_cp_b + 8 + _cp_i * 2] | 0; !_cp_hit && (_cp_v - 256 * floor(_cp_v / 256)) == _cp_ord ? _cp_hit = _cp_i + 1; _cp_i += 1; );
  );
  _cp_hit;
);
// The region chip's menu (S4): rows 1 play from here, 2 add to the chain, 3 add x2, 4 add x4, 5 remove from the chain,
// 6 zoom to it, 7 rename, 8 delete.
function seq_ui_region_menu_open(_rm_ord) (
  seq_ui_rc_ord = _rm_ord;
  swing_popup_open(mx, my, "Play from here|Add to the chain|Add to the chain x2|Add to the chain x4|Remove from the chain|Zoom to it|Rename...|Delete the region", SP_POPUP_CALLER_SEQ_REGION);
);
// A chain entry's label -> #seq_ui_lbl (the small things round, 2026-10-23): the PATTERN its region plays -- the map's link,
// so a region moved in time keeps its number -- and "x" with the repeats past one; "-" for a region the map does not hold
// or one past the patterns. The SONG band keeps the region's ordinal (Steppa reads it that way); only the face shows patterns.
function seq_ui_chain_label(_cl_sb, _cl_i) local(_cl_v, _cl_rep, _cl_ord, _cl_p) (
  _cl_v = gmem[_cl_sb + 8 + _cl_i * 2] | 0; _cl_rep = floor(_cl_v / 256); _cl_ord = _cl_v - 256 * _cl_rep;
  _cl_p = _cl_ord >= 1 && _cl_ord <= seq_map_n ? seq_map[(_cl_ord - 1) * 4 + 2] | 0 : -1;
  _cl_p >= 0 && _cl_p < SEQ_PATS ? ( _cl_rep > 1 ? sprintf(#seq_ui_lbl, "%dx%d", _cl_p + 1, _cl_rep) : sprintf(#seq_ui_lbl, "%d", _cl_p + 1); )
                                 : ( _cl_rep > 1 ? sprintf(#seq_ui_lbl, "-x%d", _cl_rep) : strcpy(#seq_ui_lbl, "-"); );
);
// The song strip (S4), the band under the toolbar while SONG is on: CHAIN > [] CLR at the left (the chain's own transport;
// the label said SONG until the button did, 2026-10-21, the user's word; its LOOP went to the toolbar's LOOP in the small
// things round, 2026-10-23), the region chips in time order (each its colour, its name, its pattern number; the playing one
// ringed, the pattern on screen's lit; a click puts its pattern on screen, a right-click its menu, a drag onto the chain
// adds it there), + for a new region, and the CHAIN at the right: a chip per entry in play order (the round's, the user:
// "The ability to drag the patterns in song mode, we never put that inside the sequencer") -- the pattern its region
// plays, the region's colour, xN past one repeat, the entry playing ringed; a chip drags along the chain to move, off the
// strip to leave it, and the wheel over one sets its repeats (seq_ui_sdrag_tick). Everything comes from the bridge's
// bands; every change goes back as a request. The playhead's region: the engine's seq_rs_i while it plays synced. The
// chain chips' x and w go into seq_ui_chgeo (the host's claim): the drops' gap and the caret use their REAL widths.
function seq_ui_song_draw(_sd_x, _sd_y, _sd_w, _sd_h, _sd_pat)
local(_sd_bx, _sd_bh, _sd_by, _sd_sb, _sd_n, _sd_i, _sd_cw, _sd_tw, _sd_th, _sd_fs, _sd_hov, _sd_ord, _sd_p, _sd_col, _sd_r, _sd_g, _sd_b, _sd_lit, _sd_play, _sd_cur, _sd_len, _sd_v, _sd_rep, _sd_rx, _sd_on,
      _sd_t0, _sd_t1, _sd_sc, _sd_cx, _sd_end, _sd_tot, _sd_cap, _sd_uw, _sd_aw, _sd_dim) (
  gfx_set(0, 0, 0, 0.18); gfx_rect(_sd_x + 1, _sd_y, _sd_w - 2, _sd_h);
  _sd_fs = swing_fs(8); _sd_bh = _sd_h - 4; _sd_by = _sd_y + 2;
  seq_ui_song_by = _sd_y; seq_ui_song_bh = _sd_h;   // the band: where a drag drops (seq_ui_sdrag_tick)
  _sd_sb = EON_SS_SONG_BASE + max(0, _reg_my_slot) * EON_SS_SONG_STRIDE;
  _sd_len = max(0, min(EON_SS_SONG_ENTRY_MAX, gmem[_sd_sb + 1] | 0)); _sd_play = gmem[_sd_sb + 2] | 0; _sd_cur = gmem[_sd_sb + 3] | 0;
  _reg_my_slot < 0 ? ( _sd_len = 0; _sd_play = 0; _sd_cur = 0; );   // no slot (the seventeenth Swing): _sd_sb fell on slot 0's band, whose chain and lamps are not ours to show (audit K16)
  _sd_on = gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 && _reg_my_slot >= 0;
  // the chain's transport, at the left
  _sd_bx = _sd_x + swing_px(6);
  rk_font(1, _sd_fs, 'b'); gfx_set(0.55, 0.62, 0.72, 0.9); gfx_x = _sd_bx; gfx_y = _sd_by + (_sd_bh - _sd_fs) * 0.5; gfx_drawstr("CHAIN"); _sd_bx += swing_px(34);
  seq_ui_tbtn(_sd_bx, _sd_by, swing_px(20), _sd_bh, 2, _sd_play && _sd_cur > 0) && lmb_down ? seq_ui_song_cmd(5, 0, 0); _sd_bx += swing_px(22);
  seq_ui_tbtn(_sd_bx, _sd_by, swing_px(20), _sd_bh, 3, 0) && lmb_down ? seq_ui_song_cmd(6, 0, 0); _sd_bx += swing_px(22);
  seq_ui_btn(_sd_bx, _sd_by, swing_px(30), _sd_bh, "CLR", 0) && lmb_down ? seq_ui_song_cmd(8, 0, 0); _sd_bx += swing_px(32);
  mx >= _sd_x && mx < _sd_bx && my >= _sd_y && my < _sd_y + _sd_h ? swing_tooltip_check(1451, "The song chain: play it (or the transport when it is empty), stop, clear. Drag a pattern tab or a region onto the chain to add it; LOOP above repeats it.");
  _sd_bx += swing_px(8);
  // the chain, at the right: each chip its label's width and a margin, shrunk alike when together they would take more
  // than 45 % of the strip, so every entry stays on show (a chip too narrow for its label keeps its colour; hover names it)
  _sd_rx = _sd_x + _sd_w - swing_px(8);
  rk_font(1, _sd_fs, 0);   // regular: the labels are numbers, and a bold 5 reads as a 6 at 8 px (wiki 4.7)
  _sd_tot = 0; _sd_i = 0;
  loop(_sd_len,
    seq_ui_chain_label(_sd_sb, _sd_i); _sd_tw = 0; gfx_measurestr(#seq_ui_lbl, _sd_tw, _sd_th);
    _sd_tot += max(swing_px(18), _sd_tw + swing_px(8)) + swing_px(2);
    _sd_i += 1;
  );
  _sd_cap = max(swing_px(60), floor((_sd_rx - _sd_bx) * 0.45));
  _sd_uw = _sd_tot > _sd_cap ? max(swing_px(4), floor(_sd_cap / max(1, _sd_len)) - swing_px(2)) : 0;
  _sd_aw = _sd_len > 0 ? (_sd_uw > 0 ? _sd_len * (_sd_uw + swing_px(2)) : _sd_tot) : swing_px(60);   // an empty chain: a drop zone's room
  _sd_cx = _sd_rx - _sd_aw;
  seq_ui_ch_x0 = _sd_cx; seq_ui_ch_x1 = _sd_rx; seq_ui_chn = 0;
  _sd_i = 0;
  loop(_sd_len,
    _sd_v = gmem[_sd_sb + 8 + _sd_i * 2] | 0; _sd_rep = floor(_sd_v / 256); _sd_ord = _sd_v - 256 * _sd_rep;
    seq_ui_chain_label(_sd_sb, _sd_i); _sd_tw = 0; _sd_th = 0; gfx_measurestr(#seq_ui_lbl, _sd_tw, _sd_th);
    _sd_cw = _sd_uw > 0 ? _sd_uw : max(swing_px(18), _sd_tw + swing_px(8));
    // the region's colour: the band's (packed r * 65536 + g * 256 + b), else the map's, else slate
    _sd_col = gmem[_sd_sb + 9 + _sd_i * 2] | 0;
    _sd_col == 0 && _sd_ord >= 1 && _sd_ord <= seq_map_n ? _sd_col = seq_map[(_sd_ord - 1) * 4 + 3] | 0;
    _sd_r = floor(_sd_col / 65536) / 255; _sd_g = (floor(_sd_col / 256) - 256 * floor(_sd_col / 65536)) / 255; _sd_b = (_sd_col - 256 * floor(_sd_col / 256)) / 255;
    _sd_col == 0 ? ( _sd_r = 0.30; _sd_g = 0.38; _sd_b = 0.46; );
    _sd_hov = mx >= _sd_cx && mx < _sd_cx + _sd_cw && my >= _sd_by && my < _sd_by + _sd_bh;
    _sd_lit = _sd_cur == _sd_i + 1;                                  // the entry playing
    _sd_dim = seq_ui_sdrag == 3 && seq_ui_sdrag_from == _sd_i + 1;   // the one being dragged, faint in its place
    gfx_set(_sd_r, _sd_g, _sd_b, _sd_dim ? 0.25 : (_sd_hov ? 0.95 : 0.8)); gfx_rect(_sd_cx, _sd_by, _sd_cw, _sd_bh);
    _sd_lit ? ( gfx_set(0.95, 0.80, 0.45, 1); gfx_rect(_sd_cx, _sd_by, _sd_cw, 2); gfx_rect(_sd_cx, _sd_by + _sd_bh - 2, _sd_cw, 2); gfx_rect(_sd_cx, _sd_by, 2, _sd_bh); gfx_rect(_sd_cx + _sd_cw - 2, _sd_by, 2, _sd_bh); );
    _sd_cw >= _sd_tw + 4 ? (
      (_sd_r + _sd_g + _sd_b) * 0.333 > 0.55 ? gfx_set(0, 0, 0, _sd_dim ? 0.3 : 0.85) : gfx_set(1, 1, 1, _sd_dim ? 0.3 : 0.95);
      gfx_x = _sd_cx + (_sd_cw - _sd_tw) * 0.5; gfx_y = _sd_by + (_sd_bh - _sd_th) * 0.5; gfx_drawstr(#seq_ui_lbl);
    );
    seq_ui_chgeo > 0 && _sd_i < 32 ? ( seq_ui_chgeo[_sd_i * 2] = _sd_cx; seq_ui_chgeo[_sd_i * 2 + 1] = _sd_cw; seq_ui_chn = _sd_i + 1; );   // no claim (an older host): no geometry, no drops
    _sd_hov && _sd_on ? (
      // a press takes the chip at once (Steppa's rule); the wheel sets its repeats, 1..16 (an entry set past 16 by its menu only comes down)
      lmb_down ? ( seq_ui_sdrag = 3; seq_ui_sdrag_from = _sd_i + 1; seq_ui_sdrag_v = _sd_v; seq_ui_sdrag_x0 = mx; seq_ui_sdrag_y0 = my; seq_ui_sdrag_moved = 0; );
      frame_wheel != 0 ? (
        _sd_rep = max(1, _sd_rep);
        // notches faster than the bridge answers add up: from the value the last notch asked for while it is fresh (a
        // second), not from the band's that has not moved yet; the queue keeps only the latest (seq_ui_song_cmd)
        seq_ui_wh_pos == _sd_i + 1 && time_precise() - seq_ui_wh_t < 1 ? _sd_rep = seq_ui_wh_rep;
        _sd_p = max(1, min(max(16, _sd_rep), _sd_rep + (frame_wheel > 0 ? 1 : -1)));
        _sd_p != _sd_rep ? ( seq_ui_song_cmd(4, _sd_i + 1, _sd_p); seq_ui_wh_pos = _sd_i + 1; seq_ui_wh_rep = _sd_p; seq_ui_wh_t = time_precise(); );
      );
    );
    _sd_hov ? (
      _sd_p = _sd_ord >= 1 && _sd_ord <= seq_map_n ? seq_map[(_sd_ord - 1) * 4 + 2] | 0 : -1;
      _sd_p >= 0 && _sd_p < SEQ_PATS ? sprintf(#seq_ui_lbl2, "Chain entry %d: region %d, pattern %d, x%d. Drag it along the chain to move it, off the strip to take it out; the wheel sets its repeats.", _sd_i + 1, _sd_ord, _sd_p + 1, max(1, _sd_rep))
                                     : sprintf(#seq_ui_lbl2, "Chain entry %d: region %d, x%d. Drag it along the chain to move it, off the strip to take it out; the wheel sets its repeats.", _sd_i + 1, _sd_ord, max(1, _sd_rep));
      swing_tooltip_check(1484, #seq_ui_lbl2);
    );
    _sd_cx += _sd_cw + swing_px(2);
    _sd_i += 1;
  );
  // an empty chain while a pattern or a region is dragged: the zone it drops into
  _sd_len == 0 && seq_ui_sdrag == 2 ? (
    gfx_set(1, 1, 1, 0.35);
    gfx_rect(seq_ui_ch_x0, _sd_by, swing_px(60), 1); gfx_rect(seq_ui_ch_x0, _sd_by + _sd_bh - 1, swing_px(60), 1);
    gfx_rect(seq_ui_ch_x0, _sd_by, 1, _sd_bh); gfx_rect(seq_ui_ch_x0 + swing_px(60) - 1, _sd_by, 1, _sd_bh);
  );
  _sd_rx = seq_ui_ch_x0;
  _sd_len > 0 || seq_ui_sdrag == 2 ? (
    rk_font(1, _sd_fs, 'b'); gfx_set(0.55, 0.62, 0.72, 0.9); _sd_tw = 0; gfx_measurestr("CHAIN", _sd_tw, _sd_th);
    _sd_rx -= _sd_tw + swing_px(6); gfx_x = _sd_rx; gfx_y = _sd_by + (_sd_bh - _sd_fs) * 0.5; gfx_drawstr("CHAIN");
  );
  _sd_rx -= swing_px(8);
  // the regions as a TIMELINE (the toolbar pass; the user: "i need to visualize these"): each chip as long as its region
  // against the whole song's span (gaps included), the pattern number large and the name beside it, the playing region
  // ringed and the playhead drawn across; a click puts its pattern on screen, a right-click its menu, a drag onto the
  // chain adds it there
  seq_ui_song_x0 = _sd_bx; seq_ui_song_y = _sd_by;
  _sd_n = seq_map_n;
  // the span: the first region's start to the LATEST end (it was the last region's end until 2026-10-23: a region ending
  // after a later-starting one ran past the strip and was never drawn or clickable -- audit READ_HIGH_MEDIUM:161)
  _sd_t0 = _sd_n > 0 ? seq_map[0] : 0; _sd_t1 = _sd_n > 0 ? seq_map[1] : 1;
  _sd_i = 1; loop(max(0, _sd_n - 1), _sd_t1 = max(_sd_t1, seq_map[_sd_i * 4 + 1]); _sd_i += 1; );
  _sd_sc = (_sd_rx - swing_px(26) - _sd_bx) / max(0.25, _sd_t1 - _sd_t0);   // pixels a beat
  _sd_cw = _sd_n > 0 ? max(swing_px(10), (seq_map[1] - seq_map[0]) * _sd_sc - 2) : 0;
  seq_ui_song_chipw = _sd_cw;
  _sd_end = _sd_bx;
  _sd_i = 0;
  loop(_sd_n,
    _sd_cx = _sd_bx + (seq_map[_sd_i * 4] - _sd_t0) * _sd_sc; _sd_cw = max(swing_px(10), (seq_map[_sd_i * 4 + 1] - seq_map[_sd_i * 4]) * _sd_sc - 2);
    _sd_cx + _sd_cw <= _sd_rx - swing_px(26) + 1 ? (
      _sd_ord = _sd_i + 1; _sd_p = seq_map[_sd_i * 4 + 2] | 0; _sd_col = seq_map[_sd_i * 4 + 3] | 0;
      _sd_r = floor(_sd_col / 65536) / 255; _sd_g = (floor(_sd_col / 256) - 256 * floor(_sd_col / 65536)) / 255; _sd_b = (_sd_col - 256 * floor(_sd_col / 256)) / 255;
      _sd_col == 0 ? ( _sd_r = 0.30; _sd_g = 0.38; _sd_b = 0.46; );
      _sd_hov = mx >= _sd_cx && mx < _sd_cx + _sd_cw && my >= _sd_by && my < _sd_by + _sd_bh;
      _sd_lit = _sd_p == _sd_pat && _sd_p >= 0;
      gfx_set(_sd_r, _sd_g, _sd_b, _sd_lit ? 0.95 : (_sd_hov ? 0.7 : 0.5)); gfx_rect(_sd_cx, _sd_by, _sd_cw, _sd_bh);
      seq_playing && seq_opt_sync && seq_rs_i == _sd_i ? ( gfx_set(1, 1, 1, 0.9); gfx_rect(_sd_cx, _sd_by, _sd_cw, 2); gfx_rect(_sd_cx, _sd_by + _sd_bh - 2, _sd_cw, 2); gfx_rect(_sd_cx, _sd_by, 2, _sd_bh); gfx_rect(_sd_cx + _sd_cw - 2, _sd_by, 2, _sd_bh); );
      seq_ui_chain_pos(_sd_ord) ? ( gfx_set(1, 1, 1, 0.85); gfx_rect(_sd_cx + _sd_cw - 5, _sd_by + 2, 3, 3); );   // in the chain: a dot
      (_sd_r + _sd_g + _sd_b) * 0.333 > 0.55 ? gfx_set(0, 0, 0, 0.85) : gfx_set(1, 1, 1, 0.92);
      // the pattern's number, large; the region's name beside it where the chip has the room
      _sd_p >= 0 && _sd_p < SEQ_PATS ? sprintf(#seq_ui_lbl, "%d", _sd_p + 1) : strcpy(#seq_ui_lbl, "-");
      rk_font(1, swing_fs(11), 'b'); gfx_measurestr(#seq_ui_lbl, _sd_tw, _sd_th);
      _sd_cw >= _sd_tw + 4 ? ( gfx_x = _sd_cx + 3; gfx_y = _sd_by + (_sd_bh - _sd_th) * 0.5; gfx_drawstr(#seq_ui_lbl); );
      seq_ui_map_name(_sd_i);
      _sd_cw - _sd_tw - swing_px(10) >= swing_px(18) ? ( rk_font(1, _sd_fs, 0); swing_mapping_name_line(_sd_cx + _sd_tw + swing_px(6) + (_sd_cw - _sd_tw - swing_px(10)) * 0.5, _sd_by + (_sd_bh - swing_fs(8)) * 0.5, _sd_cw - _sd_tw - swing_px(10), #seq_ui_gstr, 0); );
      _sd_hov && lmb_down && _sd_p >= 0 && _sd_p < SEQ_PATS ? ( seq_cur = _sd_p; seq_ui_sel_l = -1; mark_dirty(); seq_ui_loop_follow(_sd_p, _sd_ord); );   // a lit LOOP Region moves to this region
      // ...and the press arms a drag: once it moves past 6 px, the region rides to the chain (inserted where it drops on
      // the chain; let go anywhere else, the click stays a click)
      _sd_hov && lmb_down && _sd_on ? ( seq_ui_sdrag = 4; seq_ui_sdrag_ord = _sd_ord; seq_ui_sdrag_pat = _sd_p; seq_ui_sdrag_x0 = mx; seq_ui_sdrag_y0 = my; );
      _sd_hov && rmb_down ? seq_ui_region_menu_open(_sd_ord);
      _sd_hov ? swing_tooltip_check(1450, "A region of the song, drawn to its length, with the pattern it plays (a region keeps its pattern when it moves). Click: that pattern on screen. Drag it onto the chain to add it there. Right-click: play from it, the chain, zoom, rename, delete.");
      _sd_end = max(_sd_end, _sd_cx + _sd_cw + 2);
    );
    _sd_i += 1;
  );
  // the playhead across the song while it plays synced (the engine's beat, in 64ths)
  seq_playing && seq_opt_sync && _sd_n > 0 ? (
    _sd_cx = _sd_bx + (seq_pos_q / 64 - _sd_t0) * _sd_sc;
    _sd_cx >= _sd_bx && _sd_cx <= _sd_rx - swing_px(26) ? ( gfx_set(1, 1, 1, 0.95); gfx_rect(_sd_cx, _sd_by - 1, 1, _sd_bh + 2); );
  );
  _sd_bx = _sd_n > 0 ? min(_sd_end + swing_px(4), _sd_rx - swing_px(24)) : _sd_bx;
  _sd_on ? (
    seq_ui_btn(_sd_bx, _sd_by, swing_px(20), _sd_bh, "+", 0) && lmb_down ? seq_ui_region_req(16, 0);
    mx >= _sd_bx && mx < _sd_bx + swing_px(20) && my >= _sd_by && my < _sd_by + _sd_bh ? swing_tooltip_check(1452, "A new region after the last, playing the lowest pattern no region plays yet.");
  );
  _sd_n == 0 ? (
    rk_font(1, _sd_fs, 0); gfx_set(0.55, 0.62, 0.72, 0.8); gfx_x = _sd_bx + swing_px(26); gfx_y = _sd_by + (_sd_bh - _sd_fs) * 0.5;
    gfx_drawstr(_sd_on ? "no regions yet: + makes one, or adopt REAPER's in the Drum Matrix" : "the regions need the Kit Bridge");
  );
);
// The bridge takes the small things round's requests (SEQ_UI_SONG_LEVEL: ops 16 / 17, CMD 53): 1, else 0 and the footer
// says why -- no bridge, or one older than the files (a ReaPack sync runs the old one until REAPER restarts).
function seq_ui_song_new_ok() (
  gmem[KIT_GMEM_BRIDGE_ALIVE] <= 0 ? ( seq_ui_say("That needs the Kit Bridge"); 0; )
  : gmem[GS_BRIDGE_LEVEL] < SEQ_UI_SONG_LEVEL ? ( seq_ui_say("That needs the newer Kit Bridge: restart REAPER to load the version you installed"); 0; )
  : 1;
);
function seq_pc_name(_pn_c) ( _pn_c == 0 ? "C" : _pn_c == 1 ? "C#" : _pn_c == 2 ? "D" : _pn_c == 3 ? "D#" : _pn_c == 4 ? "E" : _pn_c == 5 ? "F" : _pn_c == 6 ? "F#" : _pn_c == 7 ? "G" : _pn_c == 8 ? "G#" : _pn_c == 9 ? "A" : _pn_c == 10 ? "A#" : "B"; );
// A pitch's name the way the pads say it (36 = C2) -> #seq_ui_gstr. (Above the KEYS menu, which uses it: EEL2 knows a
// function only from its definition on.)
function seq_ui_note_name(_nn_p) ( sprintf(#seq_ui_gstr, "%s%d", seq_pc_name(_nn_p % 12), floor(_nn_p / 12) - 1); );
// The first playable pad whose notes overlap the trigger range, -1 none (those pads cannot be played by MIDI while
// the trigger is on: the trigger eats the notes first).
function seq_ui_trig_overlap_at(_to_b) local(_to_i, _to_hit) (
  _to_hit = -1; _to_i = 0;
  loop(NUM_SLOTS,
    _to_hit < 0 && pad_is_playable(_to_i) && p_note[_to_i] + p_rng_hi[_to_i] >= _to_b && p_note[_to_i] - p_rng_lo[_to_i] < _to_b + SEQ_TRIG_N ? _to_hit = _to_i;
    _to_i += 1;
  );
  _to_hit;
);
function seq_ui_trig_overlap() ( seq_ui_trig_overlap_at(seq_trig_base); );
// one range row of the KEYS menu: the tick, the label, and the pad it covers when one sits on its notes (round two C)
function seq_ui_trig_range_row(_tr_b, _tr_lbl) local(_tr_o) (
  _tr_o = seq_ui_trig_overlap_at(_tr_b);
  sprintf(#seq_ui_lbl2, "|%s%s", seq_trig_base == _tr_b ? "!" : "", _tr_lbl); strcat(#seq_ui_menu, #seq_ui_lbl2);
  _tr_o >= 0 ? ( sprintf(#seq_ui_lbl2, ": covers pad %c%d", 65 + floor(_tr_o / NUM_PADS), _tr_o - NUM_PADS * floor(_tr_o / NUM_PADS) + 1); strcat(#seq_ui_menu, #seq_ui_lbl2); );
);
// The TRIG menu (S3): rows 1..4 the mode (off, change, change + resync, change + resync on the beat), 5..9 the
// trigger notes' base (C-1, C0, G#0, E7, E8 = notes 0, 12, 20, 100, 112: sixteen notes up from it pick patterns
// 1..16); the current ones ticked.
// Round two C (the user, on a full four-bank kit: "where are the keys starting at?" -> "Yes change them"): the ranges keep
// clear of a default kit's sixty-four pads (C2..D#7) -- C1 (24-39) took bank A's first four, C7 (96-111) bank D's top
// four; now G#0 (20-35) ends just below the pads and E7 (100-115) starts just above bank D. Any row whose notes a playable
// pad sits on says which (a moved root or a locked note can still land there), and the range in use landing on a pad
// adds a red header row at the END, so the rows' numbers never move.
function seq_ui_trig_menu_open() (
  sprintf(#seq_ui_menu, "%sOff|%sChange the pattern at the next step|%sChange + restart from step 1 at the switch|%sChange + restart on the beat",
          seq_trig_mode == 0 ? "!" : "", seq_trig_mode == 1 ? "!" : "", seq_trig_mode == 2 ? "!" : "", seq_trig_mode >= 3 ? "!" : "");
  seq_ui_trig_range_row(0, "Notes from C-1 (0-15)");
  seq_ui_trig_range_row(12, "from C0 (12-27)");
  seq_ui_trig_range_row(SEQ_TRIG_G0S, "from G#0 (20-35)");
  seq_ui_trig_range_row(SEQ_TRIG_E7, "from E7 (100-115)");
  seq_ui_trig_range_row(SEQ_TRIG_E8, "from E8 (112-127)");
  // Rows 10..12 (the owner, 2026-10-27: "can we change the keys from where it starts?" -- any start note): LEARN, ticked
  // while it waits for a key (rk_seq_core seq_trig_learn_take; picked again it stops waiting), and an octave up / down,
  // each naming where it lands (clamped to C-1 .. SEQ_TRIG_TOP, so base + 15 <= 127). A start that is none of the five
  // above shows as a ticked row after them (it picks nothing), ahead of the warning: the rows' numbers never move.
  sprintf(#seq_ui_lbl2, "||%sLearn: play the key the notes start from", seq_trig_lrn_on ? "!" : ""); strcat(#seq_ui_menu, #seq_ui_lbl2);
  seq_ui_note_name(min(SEQ_TRIG_TOP, seq_trig_base + 12)); sprintf(#seq_ui_lbl2, "|An octave up: from %s", #seq_ui_gstr); strcat(#seq_ui_menu, #seq_ui_lbl2);
  seq_ui_note_name(max(0, seq_trig_base - 12));            sprintf(#seq_ui_lbl2, "|An octave down: from %s", #seq_ui_gstr); strcat(#seq_ui_menu, #seq_ui_lbl2);
  seq_trig_base != 0 && seq_trig_base != 12 && seq_trig_base != SEQ_TRIG_G0S && seq_trig_base != SEQ_TRIG_E7 && seq_trig_base != SEQ_TRIG_E8 ? (
    seq_ui_note_name(seq_trig_base); sprintf(#seq_ui_lbl, "from %s (%d-%d)", #seq_ui_gstr, seq_trig_base, seq_trig_base + SEQ_TRIG_N - 1);
    seq_ui_trig_range_row(seq_trig_base, #seq_ui_lbl);
  );
  seq_ui_trig_ovl = seq_ui_trig_overlap();
  seq_ui_trig_ovl >= 0 ? (
    sprintf(#seq_ui_lbl2, "|#Pad %c%d sits on the notes in use: it won't play from MIDI while KEYS is on", 65 + floor(seq_ui_trig_ovl / NUM_PADS), seq_ui_trig_ovl - NUM_PADS * floor(seq_ui_trig_ovl / NUM_PADS) + 1);
    strcat(#seq_ui_menu, #seq_ui_lbl2);
  );
  swing_popup_open(mx, my, #seq_ui_menu, SP_POPUP_CALLER_SEQ_TRIG);
);
// The TRIG menu's answer, row k of seq_ui_trig_menu_open (consumed in swing_seq_panel_draw): the mode, or the trigger
// notes' base; project state, no undo point. 2026-10-27: Learn (arm / disarm; the footer says which), an octave up /
// down (clamped to 0 .. SEQ_TRIG_TOP); a later row (the custom start's, the warning) picks nothing.
function seq_ui_trig_pick(_tp_k) (
  _tp_k <= 4 ? seq_trig_mode = _tp_k - 1
  : _tp_k == 5 ? seq_trig_base = 0 : _tp_k == 6 ? seq_trig_base = 12 : _tp_k == 7 ? seq_trig_base = SEQ_TRIG_G0S : _tp_k == 8 ? seq_trig_base = SEQ_TRIG_E7 : _tp_k == 9 ? seq_trig_base = SEQ_TRIG_E8   // round two C: G#0, E7
  : _tp_k == 10 ? (
    // through the op queue: @block owns the armed flag (rk_seq_core seq_trig_lrn_on)
    !seq_post_op(SEQ_OP_LEARN, !seq_trig_lrn_on, 0) ? seq_ui_say("Busy: try again")
    : seq_trig_lrn_on ? seq_ui_say("KEYS: stopped waiting for a key")
    : seq_ui_say("KEYS: play the key the patterns should start from (it plays nothing)");
  )
  : _tp_k == 11 ? seq_trig_base = min(SEQ_TRIG_TOP, seq_trig_base + 12) : _tp_k == 12 ? seq_trig_base = max(0, seq_trig_base - 12);
  _tp_k != 10 ? mark_dirty();   // arming Learn changes nothing saved; the take marks it (seq_trig_learn_take)
);
// The lane columns' menu (the polish pass; the user: "I want all the colomns in the lans collapasable like they were in
// steppa"): rows 1 the icon, 2 M / S, 3 the name, 4 the length, 5 the division, 6 the swing (ticked when shown), 7 all of them.
function seq_ui_cols_menu_open() (
  sprintf(#seq_ui_menu, "%sLane icons|%sMute / Solo|%sName|%sLength|%sDivision|%sSwing|Show every column",
          seq_opt_icons ? "!" : "", (seq_col_hide & 1) ? "" : "!", (seq_col_hide & 2) ? "" : "!",
          (seq_col_hide & 4) ? "" : "!", (seq_col_hide & 8) ? "" : "!", (seq_col_hide & 16) ? "" : "!");
  swing_popup_open(mx, my, #seq_ui_menu, SP_POPUP_CALLER_SEQ_COLS);
);
// A column's label on the ruler (the polish pass): dim, brighter under the mouse; a click hides the column, a right-click
// opens the column menu. A hidden column (_cl_x < 0) has no label: the menu brings it back. _cl_bit: the column's bit index.
function seq_ui_col_label(_cl_x, _cl_w, _cl_y, _cl_h, _cl_s, _cl_bit) local(_cl_hov, _cl_tw, _cl_th) (
  _cl_x >= 0 && _cl_w > 0 ? (
    _cl_hov = mx >= _cl_x && mx < _cl_x + _cl_w && my >= _cl_y && my < _cl_y + _cl_h;
    rk_font(1, swing_fs(7), 0); gfx_set(0.75, 0.82, 0.9, _cl_hov ? 1 : 0.45);
    gfx_measurestr(_cl_s, _cl_tw, _cl_th); gfx_x = _cl_x + (_cl_w - _cl_tw) * 0.5; gfx_y = _cl_y + (_cl_h - _cl_th) * 0.5; gfx_drawstr(_cl_s);
    _cl_hov && lmb_down ? ( !seq_bit(seq_col_hide, _cl_bit) ? seq_col_hide += 2 ^ _cl_bit; mark_dirty(); );
    _cl_hov && rmb_down ? seq_ui_cols_menu_open();
    _cl_hov ? swing_tooltip_check(1456, "Click to hide this column; the menu at the left (or a right-click here) brings columns back.");
  );
);
// The OPTIONS menu (the toolbar pass): the three switches, MIDI out and its channel, the bank re-aim, re-aim on load,
// bottom-up, the placements. Rows 1..3 the switches, 4 MIDI out, 5 its channel (the channel menu), 6..9 the banks,
// 10 re-aim, 11 bottom-up, 12 sequencer at the side, 13 browser below, 14 pad editor below.
function seq_ui_options_open() (
  sprintf(#seq_ui_menu, "%sLane icons|%sFollow the playhead|%sTransport buttons|%sMIDI out: every hit as a note on channel %d|MIDI out channel ...|Aim this pattern at bank A|Aim this pattern at bank B|Aim this pattern at bank C|Aim this pattern at bank D|%sRe-aim the lanes when a kit load moves the pads|%sLanes bottom-up, like the pads|%sSequencer at the side of the pads|%sBrowser below the pads|%sPad editor below the pads",
          seq_opt_icons ? "!" : "", seq_opt_follow ? "!" : "", seq_opt_transport ? "!" : "", seq_opt_midiout ? "!" : "", max(1, min(16, seq_opt_midich | 0)), seq_opt_adapt ? "!" : "", seq_opt_topdown ? "" : "!",
          seq_place == 1 ? "!" : "", fb_place == 3 ? "!" : "", fx_place == 3 ? "!" : "");   // the placements (round two J's swap, 2026-10-22; Spec 7.1's cells; the editor's the same day)
  swing_popup_open(mx, my, #seq_ui_menu, SP_POPUP_CALLER_SEQ_OPTIONS);
);
// The right-click lane menu (S3a): the fills from step 1 (rows 1..4: every step, every 2nd, 4th, 8th), the lane cleared
// (5), the piano roll (6), MIDI out on a channel (7) and aim at another pad (8).
function seq_ui_lane_menu_open() (
  sprintf(#seq_ui_menu, "Every step|Every 2nd step|Every 4th step|Every 8th step|Clear the lane|%sPiano roll: notes, chords, lengths|MIDI out on a channel ...|Aim at another pad ...",
          seq_ui_rc_l >= 0 && seq_ui_rc_l < SEQ_LANES && seq_lane_roll(seq_lane_at(max(0, min(SEQ_PATS - 1, seq_cur | 0)), seq_ui_rc_l)) ? "!" : "");
  swing_popup_open(mx, my, #seq_ui_menu, SP_POPUP_CALLER_SEQ_LANE);
);
// S5: the channel menu (a lane aimed at a MIDI channel plays its notes out as MIDI) and the scale menu (a roll's rows).
function seq_ui_chan_menu_open() local(_cm_i, _cm_t) (
  _cm_t = seq_ui_chan_lane == -2 ? -max(1, min(16, seq_opt_midich | 0))   // the drum mirror's channel (S6)
        : seq_ui_chan_lane >= 0 ? seq_lane_at(max(0, min(SEQ_PATS - 1, seq_cur | 0)), seq_ui_chan_lane)[0] | 0 : 0;
  strcpy(#seq_ui_menu, "");
  _cm_i = 1; loop(16, sprintf(#seq_ui_lbl, "%s%sMIDI channel %d", _cm_i > 1 ? "|" : "", _cm_t == -_cm_i ? "!" : "", _cm_i); strcat(#seq_ui_menu, #seq_ui_lbl); _cm_i += 1; );
  swing_popup_open(mx, my, #seq_ui_menu, SP_POPUP_CALLER_SEQ_CHAN);
);
function seq_scale_mask(_sm_m) ( _sm_m == 1 ? 2741 : _sm_m == 2 ? 1453 : _sm_m == 3 ? 1709 : _sm_m == 4 ? 1717 : _sm_m == 5 ? 661 : _sm_m == 6 ? 1193 : _sm_m == 7 ? 2477 : _sm_m == 8 ? 1257 : 4095; );
function seq_scale_name(_sn_m) ( _sn_m == 1 ? "major" : _sn_m == 2 ? "minor" : _sn_m == 3 ? "dorian" : _sn_m == 4 ? "mixolydian" : _sn_m == 5 ? "pent. major" : _sn_m == 6 ? "pent. minor" : _sn_m == 7 ? "harm. minor" : _sn_m == 8 ? "blues" : "chromatic"; );
// (seq_pc_name and seq_ui_note_name sit above the KEYS menu, which names its octave rows with them: 2026-10-27)
// Is the pitch on the lane's scale (lane field 11 = mode + 16 x root; mode 0 = every note)? And the nearest pitch that is.
function seq_in_scale(_is_lb, _is_p) local(_is_c) (
  _is_c = _is_lb[11] | 0;
  (_is_c % 16) == 0 ? 1 : seq_bit(seq_scale_mask(_is_c % 16), (_is_p - (floor(_is_c / 16) % 12) + 120) % 12);
);
function seq_scale_snap(_ss_lb, _ss_p) local(_ss_d, _ss_q) (
  _ss_q = _ss_p; _ss_d = 0;
  while(_ss_d < 7 && !seq_in_scale(_ss_lb, _ss_q)) ( _ss_d += 1; _ss_q = seq_in_scale(_ss_lb, _ss_p - _ss_d) ? _ss_p - _ss_d : _ss_p + _ss_d; );
  max(0, min(127, _ss_q));
);
function seq_ui_scale_menu_open() local(_sc_c, _sc_i) (
  _sc_c = seq_ui_scale_lane >= 0 ? seq_lane_at(max(0, min(SEQ_PATS - 1, seq_cur | 0)), seq_ui_scale_lane)[11] | 0 : 0;
  strcpy(#seq_ui_menu, "");
  _sc_i = 0; loop(9, sprintf(#seq_ui_lbl, "%s%sScale: %s", _sc_i ? "|" : "", (_sc_c % 16) == _sc_i ? "!" : "", seq_scale_name(_sc_i)); strcat(#seq_ui_menu, #seq_ui_lbl); _sc_i += 1; );
  _sc_i = 0; loop(12, sprintf(#seq_ui_lbl, "|%sRoot %s", (floor(_sc_c / 16) % 12) == _sc_i ? "!" : "", seq_pc_name(_sc_i)); strcat(#seq_ui_menu, #seq_ui_lbl); _sc_i += 1; );
  swing_popup_open(mx, my, #seq_ui_menu, SP_POPUP_CALLER_SEQ_SCALE);
);
// SNAP's grid in steps (0 = free), and a note length's step (a third has no quarter-step length: a quarter then).
function seq_ui_snap_q() ( seq_opt_snap == 0 ? 1 : seq_opt_snap == 1 ? 0.5 : seq_opt_snap == 2 ? 1 / 3 : 0; );
function seq_ui_len_q() ( seq_opt_snap == 0 ? 1 : seq_opt_snap == 1 ? 0.5 : 0.25; );
// A step's first free note slot (-1 when six notes are there), and a note written into a slot: the velocity and the packed
// cell first, the pitch LAST (@block takes a slot as live once its pitch is set).
function seq_note_free(_nf_p, _nf_l, _nf_s) local(_nf_b, _nf_k, _nf_hit) (
  _nf_b = seq_note_at(_nf_p, _nf_l, _nf_s); _nf_hit = -1; _nf_k = 0;
  loop(SEQ_CHORD_N, _nf_hit < 0 && _nf_b[_nf_k * SEQ_NOTE_F] == 0 ? _nf_hit = _nf_k; _nf_k += 1; );
  _nf_hit;
);
function seq_note_put(_nt_p, _nt_l, _nt_s, _nt_k, _nt_pitch, _nt_vel, _nt_len, _nt_nud) local(_nt_b) (
  _nt_b = seq_note_at(_nt_p, _nt_l, _nt_s) + _nt_k * SEQ_NOTE_F;
  _nt_b[1] = max(1, min(127, _nt_vel | 0)); _nt_b[2] = seq_npack(_nt_len, _nt_nud); _nt_b[0] = max(0, min(127, _nt_pitch | 0)) + 1;
);
// A lane switched to the roll with no notes yet takes its hits along: each step that is on becomes a note on the pad's
// root, a step long, with the step's velocity and nudge -- the lane sounds the same the moment it switches. Back to the
// grid, the step grid (never touched meanwhile) plays again and the notes wait in the store.
function seq_ui_roll_adopt(_ra_p, _ra_l) local(_ra_lb, _ra_s, _ra_sb, _ra_n, _ra_b, _ra_root) (
  _ra_lb = seq_lane_at(_ra_p, _ra_l); _ra_n = 0;
  _ra_b = seq_note_at(_ra_p, _ra_l, 0); loop(SEQ_STEPS * SEQ_CHORD_N, _ra_b[0] > 0 ? _ra_n += 1; _ra_b += SEQ_NOTE_F; );
  _ra_root = (_ra_lb[0] | 0) >= 0 && (_ra_lb[0] | 0) < NUM_SLOTS ? p_note[_ra_lb[0] | 0] : 60;
  _ra_n == 0 ? (
    _ra_s = 0;
    loop(SEQ_STEPS, _ra_sb = seq_step_at(_ra_p, _ra_l, _ra_s); _ra_sb[0] ? seq_note_put(_ra_p, _ra_l, _ra_s, 0, _ra_root, _ra_sb[1], 1, _ra_sb[5]); _ra_s += 1; );
  );
);
// The right-click step menu: the step's own roll, probability, nudge and accent ticked. Rows: 1 hear the pad, 2..5
// roll off / x2 / x3 / x4, 6..9 probability 25 / 50 / 75 / 100, 10..12 nudge early / late / none, 13 accent, 14 clear,
// 15..17 a fill from this step every 2nd / 4th / 8th, 18 clear the lane (S3a).
function seq_ui_step_menu_open(_sm_b) local(_sm_on, _sm_rt, _sm_pr, _sm_nu) (
  _sm_on = _sm_b[0]; _sm_rt = _sm_on ? max(1, min(4, _sm_b[3] | 0)) : 0; _sm_pr = _sm_on ? _sm_b[2] : -1; _sm_nu = _sm_on ? _sm_b[5] : 0;
  sprintf(#seq_ui_menu, "Hear the pad|%sRoll off|%sRoll x2|%sRoll x3|%sRoll x4|%sProbability 25 %%|%sProbability 50 %%|%sProbability 75 %%|%sProbability 100 %%|%sNudge early|%sNudge late|%sNudge none|%sAccent|Clear the step|Every 2nd step from here|Every 4th step from here|Every 8th step from here|Clear the lane",
          _sm_rt == 1 ? "!" : "", _sm_rt == 2 ? "!" : "", _sm_rt == 3 ? "!" : "", _sm_rt == 4 ? "!" : "",
          _sm_pr == 25 ? "!" : "", _sm_pr == 50 ? "!" : "", _sm_pr == 75 ? "!" : "", _sm_pr == 100 ? "!" : "",
          (_sm_on && _sm_nu < 0) ? "!" : "", (_sm_on && _sm_nu > 0) ? "!" : "", (_sm_on && _sm_nu == 0) ? "!" : "",
          (_sm_on && _sm_b[8]) ? "!" : "");
  swing_popup_open(mx, my, #seq_ui_menu, SP_POPUP_CALLER_SEQ_STEP);
);
// The lane whose length is the longest (FOLLOW with no step selected follows its playhead).
function seq_ui_longest_lane(_ll_p) local(_ll_l, _ll_best, _ll_len, _ll_n) (
  _ll_best = 0; _ll_len = 0;
  _ll_l = 0; loop(SEQ_LANES, _ll_n = seq_lane_at(_ll_p, _ll_l)[1] | 0; _ll_n > _ll_len ? ( _ll_len = _ll_n; _ll_best = _ll_l; ); _ll_l += 1; );
  _ll_best;
);
// A pad's category for the lane icon: the band for the bank on screen, else the name (the pad grid's own order).
function seq_ui_pad_cat(_pc_t) local(_pc_c, _pc_n) (
  _pc_c = -1;
  _pc_t >= 0 && _pc_t < NUM_SLOTS ? (
    floor(_pc_t / NUM_PADS) == bank_cur ? _pc_c = swing_lcd_padcat_eff(_pc_t);
    _pc_c < 0 && _pc_c != PADCAT_NONE ? (
      _pc_n = get_cname_slot(_pc_t); strlen(_pc_n) == 0 ? _pc_n = get_name_slot(_pc_t);
      _pc_c = strlen(_pc_n) ? eon_cat_for_name(_pc_n) : -1;
    );
  );
  _pc_c;
);
// "Hear the pad": the pad grid's own click road -- the voice launch posted to @block's ring (swing_gt_post, the one road
// a mouse launch takes; rk_drumkit_dsp) and the press cells held for a short while so the host's frame-end release
// (which waits for seq_ui_tap_until) ends a gate-mode pad after it. Until 2026-10-21 (round two D, the user: "the track
// icon is not playing the pad") this set the held cells only, and the step menu's "Hear the pad" was silent since P0a:
// the cells are the release's bookkeeping, not a launch (FINDINGS_LOG). An empty pad does nothing, as on the grid.
function seq_ui_tap_pad(_tp_pad) (
  _tp_pad >= 0 && _tp_pad < NUM_SLOTS && gui_held_pad < 0 && pad_is_playable(_tp_pad) ? (
    swing_gt_post(_tp_pad, p_note[_tp_pad], 127, 8);
    p_held[_tp_pad] = 1; p_held_vel[_tp_pad] = 127; p_held_note[_tp_pad] = p_note[_tp_pad]; gui_held_pad = _tp_pad;
    seq_ui_tap_until = time_precise() + 0.12;
  );
);
// Release, then tap (the small things round): the host's frame-end release (Swing_ReaKit's "Release GUI-held pad on
// mouse-up": a gate-mode pad's release posted, its held cell cleared, gui_held_pad back to -1) done NOW for the pad
// held, then the tap. seq_ui_tap_pad refuses while a pad is held, and the frame-end release waits for the button to come
// up: a scrub holds the button, and the picker's hover moves on inside the tap's 0.12 s hold -- without this every lane
// after the first, every tile after the first, was silent. A pad that cannot play is released and nothing sounds.
function seq_ui_retap(_rt_pad) local(_rt_eos) (
  gui_held_pad >= 0 ? (
    _rt_eos = p_oneshot[gui_held_pad];
    (_rt_eos == 0 || (_rt_eos < 0 && !oneshot_global)) ? swing_gt_post_release(gui_held_pad);
    p_held[gui_held_pad] = 0;
    gui_held_pad = -1;
  );
  seq_ui_tap_pad(_rt_pad);
);
// A scrub starts (a press on a lane's icon, or its chip): that lane's pad sounds; a MIDI channel lane has none and the
// scrub starts silent. The lane loop carries it on (swing_seq_panel_draw) until the button comes up.
function seq_ui_scrub_start(_sk_l, _sk_t) (
  seq_ui_scrub = 1; seq_ui_scrub_l = _sk_l;
  _sk_t >= 0 && _sk_t < NUM_SLOTS ? seq_ui_retap(_sk_t);
);

// The panel's background (the toolbar pass; the user: "the background is always blue"): the theme's PANEL colour, held
// dark -- the same hue and saturation, the value capped at the LCD's depth -- so the panel follows the theme (slate in EON,
// grey in a grey theme, warm in a warm one) while the face's light ink stays readable on it, in a light theme too.
// Without a theme band the LCD's own teal, as before.
function seq_ui_theme_bg() local(_tb_r, _tb_g, _tb_b, _tb_v, _tb_k) (
  gmem[GS_THEME_ID] > 0 ? ( _tb_r = pad_well_r; _tb_g = pad_well_g; _tb_b = pad_well_b; ) : ( _tb_r = lcd_bg_r; _tb_g = lcd_bg_g; _tb_b = lcd_bg_b; );
  _tb_v = max(_tb_r, max(_tb_g, _tb_b));
  _tb_k = _tb_v > 0.36 ? 0.36 / _tb_v : 1;
  seq_ui_bg_r = _tb_r * _tb_k; seq_ui_bg_g = _tb_g * _tb_k; seq_ui_bg_b = _tb_b * _tb_k;
  // a near-black theme panel still reads as a surface: lift it to a floor
  max(seq_ui_bg_r, max(seq_ui_bg_g, seq_ui_bg_b)) < 0.14 ? ( seq_ui_bg_r += 0.08; seq_ui_bg_g += 0.09; seq_ui_bg_b += 0.11; );
);
// ─── Round two H: the pattern chips' helpers ───
// the region bound to a pattern while SONG is on (the map: region i plays seq_map[i * 4 + 2]); -1 none
function seq_ui_region_of(_ro_p) local(_ro_i, _ro_hit) (
  _ro_hit = -1; _ro_i = 0;
  loop(max(0, min(64, seq_map_n | 0)), _ro_hit < 0 && (seq_map[_ro_i * 4 + 2] | 0) == _ro_p ? _ro_hit = _ro_i; _ro_i += 1; );
  _ro_hit;
);
// a chip's colour into _hsl_r / g / b: the pattern's own, else its region's while SONG is on, else a hue from its number
function seq_ui_pat_rgb(_pr_p) local(_pr_c, _pr_i, _pr_h) (
  _pr_c = seq_meta_col(_pr_p);
  _pr_c == 0 && seq_opt_sync ? ( _pr_i = seq_ui_region_of(_pr_p); _pr_i >= 0 ? _pr_c = seq_map[_pr_i * 4 + 3] | 0; );
  _pr_c > 0 ? ( _hsl_r = floor(_pr_c / 65536) / 255; _hsl_g = (floor(_pr_c / 256) - 256 * floor(_pr_c / 65536)) / 255; _hsl_b = (_pr_c - 256 * floor(_pr_c / 256)) / 255; )
            : ( _pr_h = _pr_p * 137.508; _pr_h = (_pr_h - 360 * floor(_pr_h / 360)) / 360; hsl_to_rgb(_pr_h, 0.5, 0.42); );
);
// a chip's name into #seq_ui_gstr: the pattern's own, else its region's while SONG is on; 1 when there is one
function seq_ui_pat_name(_pn_p) local(_pn_i) (
  seq_meta_has_name(_pn_p) ? ( seq_meta_name(_pn_p); strcpy(#seq_ui_gstr, #seq_meta_str); 1; )
  : ( _pn_i = seq_opt_sync ? seq_ui_region_of(_pn_p) : -1; _pn_i >= 0 ? ( seq_ui_map_name(_pn_i); strlen(#seq_ui_gstr) > 0; ) : ( strcpy(#seq_ui_gstr, ""); 0; ); );
);
function seq_ui_ren_commit() ( seq_ui_ren_p >= 0 ? ( seq_meta_name_set(seq_ui_ren_p, #seq_ui_ren_buf); seq_ui_ren_p = -1; seq_ui_edited(); ); );
// the colour menu (caller 47): auto, then the menu library's own seven colours (the rows wear them)
function seq_ui_colour_menu_open() (
  swing_popup_open(mx, my, "Auto: a hue from the number|^r Red|^a Orange|^G Green|^c Cyan|^b Blue|^p Purple|^g Grey", SP_POPUP_CALLER_SEQ_COLOUR);
);
// The PATTERN menu (the toolbar pass; the user: the five bare words "come across confusing... maybe we need those in a
// menu?"): rows 1 copy, 2 paste (greyed with nothing copied), 3 duplicate, 4 halve, 5 double, 6 clear this pattern,
// 7 clear all, 8..11 aim at bank A..D, 12 rename, 13 colour, 14 remove the last pattern (greyed unless it is empty and
// no region plays it). From the PATTERN button for the pattern on screen, from a chip's right-click for that chip's
// pattern.
function seq_ui_pattern_menu_open(_pm_p) (
  seq_ui_pmenu_pat = max(0, min(SEQ_PATS - 1, _pm_p | 0));
  sprintf(#seq_ui_menu, "Copy pattern %d|%sPaste over pattern %d|Duplicate into the next empty slot|Halve: half the steps, each twice as long|Double: twice the steps, each half as long|Clear pattern %d|Clear ALL %d patterns|Aim pattern %d at bank A|Aim pattern %d at bank B|Aim pattern %d at bank C|Aim pattern %d at bank D|Rename pattern %d ...|Colour of pattern %d ...|%sRemove the last pattern (%d)",
          seq_ui_pmenu_pat + 1, seq_clip_full ? "" : "#", seq_ui_pmenu_pat + 1, seq_ui_pmenu_pat + 1, SEQ_PATS, seq_ui_pmenu_pat + 1, seq_ui_pmenu_pat + 1, seq_ui_pmenu_pat + 1, seq_ui_pmenu_pat + 1,
          seq_ui_pmenu_pat + 1, seq_ui_pmenu_pat + 1, (seq_npat > 1 && !seq_pat_used(seq_npat - 1) && !(seq_opt_sync && seq_ui_region_of(seq_npat - 1) >= 0)) ? "" : "#", seq_npat);   // round two H: rename, colour, remove
  swing_popup_open(mx, my, #seq_ui_menu, SP_POPUP_CALLER_SEQ_PATTERN);
);
// The key row (round two C; the toolbar pass's strip until then -- the user: "We deffinetley need a way to see the keys
// better than that. Its far too small"): while KEYS is on, a keyboard of the sixteen trigger notes across the panel under
// the chips, white and black keys where the notes fall (an end that is a black key gets half a white key's room, so it
// never hangs outside). Each key of a pattern on show carries that pattern's chip colour and number at its foot; keys past
// the count are dim and do nothing. The pattern on screen's key is lit blue; a switch waiting for its step (seq_sw_pat)
// lights its key amber and the right end says NEXT and its number; the left end says where the notes start. A click on a
// key puts its pattern on screen; hovering one names its note and its pattern.
function seq_pc_black(_pb) ( _pb == 1 || _pb == 3 || _pb == 6 || _pb == 8 || _pb == 10; );
function seq_ui_keystrip_draw(_ks_x, _ks_y, _ks_w, _ks_h, _ks_pat)
local(_ks_k, _ks_nw, _ks_ww, _ks_wi, _ks_kx, _ks_kw, _ks_blk, _ks_hov, _ks_tw, _ks_th, _ks_lit, _ks_next, _ks_lw, _ks_ax, _ks_aw,
      _ks_x0, _ks_bh, _ks_hk, _ks_band, _ks_on) (
  gfx_set(0, 0, 0, 0.22); gfx_rect(_ks_x, _ks_y, _ks_w, _ks_h);
  _ks_lw = swing_px(SEQ_UI_KEYS_LBL_B);
  _ks_ax = _ks_x + _ks_lw; _ks_aw = max(swing_px(80), _ks_w - 2 * _ks_lw);   // the keys' area between the two label zones
  seq_ui_keys_x = _ks_ax; seq_ui_keys_w = _ks_aw;
  _ks_nw = 0; _ks_k = 0; loop(SEQ_TRIG_N, seq_pc_black((seq_trig_base + _ks_k) % 12) ? 0 : _ks_nw += 1; _ks_k += 1; );
  _ks_ww = _ks_aw / max(1, _ks_nw + (seq_pc_black(seq_trig_base % 12) ? 0.5 : 0) + (seq_pc_black((seq_trig_base + SEQ_TRIG_N - 1) % 12) ? 0.5 : 0));
  _ks_x0 = _ks_ax + (seq_pc_black(seq_trig_base % 12) ? _ks_ww * 0.5 : 0);
  _ks_bh = floor(_ks_h * 0.62);
  _ks_next = seq_sw_pat >= 0 && seq_sw_pat < SEQ_PATS ? seq_sw_pat : -1;
  _ks_hk = -1;
  // the white keys, then the black ones over their seams (a press on a black key wins: it is handled last)
  _ks_wi = 0; _ks_k = 0;
  loop(SEQ_TRIG_N,
    !seq_pc_black((seq_trig_base + _ks_k) % 12) ? (
      _ks_kx = _ks_x0 + _ks_wi * _ks_ww; _ks_kw = _ks_ww;
      _ks_on = _ks_k < seq_npat; _ks_lit = _ks_k == _ks_pat;
      _ks_hov = mx >= _ks_kx && mx < _ks_kx + _ks_kw && my >= _ks_y && my < _ks_y + _ks_h;
      _ks_hov ? _ks_hk = _ks_k;
      _ks_k == _ks_next ? gfx_set(0.95, 0.70, 0.25, 1) : _ks_lit ? gfx_set(0.42, 0.68, 0.92, 1) : gfx_set(0.86, 0.88, 0.91, !_ks_on ? 0.3 : (_ks_hov ? 1 : 0.9));
      gfx_rect(_ks_kx + 1, _ks_y, _ks_kw - 2, _ks_h);
      _ks_band = floor(_ks_h * 0.38);
      _ks_on ? ( seq_ui_pat_rgb(_ks_k); gfx_set(_hsl_r, _hsl_g, _hsl_b, 1); gfx_rect(_ks_kx + 3, _ks_y + _ks_h - _ks_band - 2, _ks_kw - 6, _ks_band); );
      sprintf(#seq_ui_lbl, "%d", _ks_k + 1); rk_font(1, swing_fs(11), 'b');
      _ks_on ? ( (_hsl_r + _hsl_g + _hsl_b) * 0.333 > 0.55 ? gfx_set(0.08, 0.09, 0.12, 1) : gfx_set(1, 1, 1, 1); ) : gfx_set(0.12, 0.14, 0.17, 0.45);
      gfx_measurestr(#seq_ui_lbl, _ks_tw, _ks_th); gfx_x = _ks_kx + (_ks_kw - _ks_tw) * 0.5; gfx_y = _ks_y + _ks_h - 2 - (_ks_band + _ks_th) * 0.5; gfx_drawstr(#seq_ui_lbl);
      _ks_hov && lmb_down && _ks_k != _ks_pat && _ks_on ? ( seq_cur = _ks_k; seq_ui_sel_l = -1; mark_dirty(); seq_ui_loop_follow(_ks_k, 0); );
      _ks_wi += 1;
    );
    _ks_k += 1;
  );
  _ks_wi = 0; _ks_k = 0;
  loop(SEQ_TRIG_N,
    seq_pc_black((seq_trig_base + _ks_k) % 12) ? (
      _ks_kw = _ks_ww * 0.62; _ks_kx = _ks_x0 + _ks_wi * _ks_ww - _ks_kw * 0.5;
      _ks_on = _ks_k < seq_npat; _ks_lit = _ks_k == _ks_pat;
      _ks_hov = mx >= _ks_kx && mx < _ks_kx + _ks_kw && my >= _ks_y && my < _ks_y + _ks_bh;
      _ks_hov ? _ks_hk = _ks_k;
      _ks_k == _ks_next ? gfx_set(0.95, 0.70, 0.25, 1) : _ks_lit ? gfx_set(0.30, 0.56, 0.84, 1) : gfx_set(0.12, 0.14, 0.17, !_ks_on ? 0.45 : (_ks_hov ? 0.85 : 1));
      gfx_rect(_ks_kx, _ks_y, _ks_kw, _ks_bh);
      _ks_band = floor(_ks_bh * 0.48);
      _ks_on ? ( seq_ui_pat_rgb(_ks_k); gfx_set(_hsl_r, _hsl_g, _hsl_b, 1); gfx_rect(_ks_kx + 2, _ks_y + _ks_bh - _ks_band - 2, _ks_kw - 4, _ks_band); );
      sprintf(#seq_ui_lbl, "%d", _ks_k + 1); rk_font(1, swing_fs(9), 'b');
      _ks_on ? ( (_hsl_r + _hsl_g + _hsl_b) * 0.333 > 0.55 ? gfx_set(0.08, 0.09, 0.12, 1) : gfx_set(1, 1, 1, 1); ) : gfx_set(0.92, 0.94, 0.97, 0.45);
      gfx_measurestr(#seq_ui_lbl, _ks_tw, _ks_th); gfx_x = _ks_kx + (_ks_kw - _ks_tw) * 0.5; gfx_y = _ks_y + _ks_bh - 2 - (_ks_band + _ks_th) * 0.5; gfx_drawstr(#seq_ui_lbl);
      _ks_hov && lmb_down && _ks_k != _ks_pat && _ks_on ? ( seq_cur = _ks_k; seq_ui_sel_l = -1; mark_dirty(); seq_ui_loop_follow(_ks_k, 0); );
    ) : _ks_wi += 1;
    _ks_k += 1;
  );
  // the left end: where the notes start; the right end: the pattern waiting for its step
  rk_font(1, swing_fs(8), 'b'); gfx_set(0.75, 0.82, 0.9, 0.6); gfx_x = _ks_x + swing_px(8); gfx_y = _ks_y + swing_px(5); gfx_drawstr("KEYS FROM");
  seq_ui_note_name(seq_trig_base); rk_font(1, swing_fs(14), 'b'); gfx_set(0.92, 0.95, 0.98, 0.95);
  gfx_x = _ks_x + swing_px(8); gfx_y = _ks_y + _ks_h - swing_fs(14) - swing_px(5); gfx_drawstr(#seq_ui_gstr);
  _ks_next >= 0 ? (
    rk_font(1, swing_fs(8), 'b'); gfx_set(0.95, 0.70, 0.25, 0.85); gfx_measurestr("NEXT", _ks_tw, _ks_th);
    gfx_x = _ks_x + _ks_w - swing_px(8) - _ks_tw; gfx_y = _ks_y + swing_px(5); gfx_drawstr("NEXT");
    sprintf(#seq_ui_lbl, "%d", _ks_next + 1); rk_font(1, swing_fs(16), 'b'); gfx_set(0.95, 0.70, 0.25, 1); gfx_measurestr(#seq_ui_lbl, _ks_tw, _ks_th);
    gfx_x = _ks_x + _ks_w - swing_px(8) - _ks_tw; gfx_y = _ks_y + _ks_h - _ks_th - swing_px(3); gfx_drawstr(#seq_ui_lbl);
  );
  // a key's tooltip names its note and its pattern
  _ks_hk >= 0 ? (
    seq_ui_note_name(seq_trig_base + _ks_hk); strcpy(#seq_ui_ks_note, #seq_ui_gstr);
    _ks_hk < seq_npat ? (
      seq_ui_pat_name(_ks_hk) ? sprintf(#seq_ui_lbl, "%s plays pattern %d, %s. Click to put it on screen.", #seq_ui_ks_note, _ks_hk + 1, #seq_ui_gstr)
                              : sprintf(#seq_ui_lbl, "%s plays pattern %d. Click to put it on screen.", #seq_ui_ks_note, _ks_hk + 1);
    ) : sprintf(#seq_ui_lbl, "%s would play pattern %d. Add patterns with + to use it.", #seq_ui_ks_note, _ks_hk + 1);
    swing_tooltip_check(1465, #seq_ui_lbl);
  ) : mx >= _ks_x && mx < _ks_x + _ks_w && my >= _ks_y && my < _ks_y + _ks_h ?
    swing_tooltip_check(1465, "The trigger notes, one key per pattern: play one on your keyboard and that pattern plays next (amber while it waits for its step).");
);
// PRINT (S6): the pattern on screen as a MIDI item, through the bridge (CMD 96: the cycles, and one cycle in beats --
// the longest lane's -- so the bridge can snap the edit cursor to a cycle boundary; the band's state gates one print at
// a time). Returns 1 when posted; the footer says why not otherwise.
function seq_ui_print(_pn_n) local(_pn_p) (
  _pn_p = max(0, min(SEQ_PATS - 1, seq_cur | 0));
  gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 && gmem[KIT_GMEM_CMD] == 0 && !kit_busy && (gmem[KIT_GMEM_LOCK] == 0 || gmem[KIT_GMEM_LOCK] == instance_id)
    && gmem[EON_SEQ_PRINT_BASE] == 0 ? (
    gmem[KIT_GMEM_LOCK] = instance_id; gmem[KIT_GMEM_PARAM1] = max(1, _pn_n | 0); gmem[KIT_GMEM_NPADS] = seq_pat_cycle_beats(_pn_p);
    gmem[KIT_GMEM_CMD] = 96;
    sprintf(#seq_ui_lbl, "Writing pattern %d as a MIDI item, %d cycle%s of the longest lane, from the cursor's bar ...", _pn_p + 1, max(1, _pn_n | 0), _pn_n > 1 ? "s" : ""); seq_ui_say(#seq_ui_lbl); 1;
  ) : ( seq_ui_say(gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? "TO ITEM: the bridge is busy, or an item is still on its way -- try again in a moment" : "TO ITEM needs the Kit Bridge"); 0; );
);
// Round two G (the user: "in song mode in steppa the patterns matched the regions 1:1 ... should it?" -> "Both: every region
// in place by default, and a right-click choice to write the chain from the edit cursor"; an empty region gets no item):
// with SONG on, TO ITEM writes the song through the bridge. Mode 1 = one MIDI item under every region, in place, named
// after it, holding the pattern the region plays (the map's link) over its length, anchored at its start as it plays;
// mode 2 = the chain in play order with its repeats, laid out from the edit cursor. The walks go one at a time through the
// print band; the bridge keeps the hits and builds every item in one tick, one undo point. Returns 1 when posted.
// The small things round (2026-10-23, the user's PRINT SONG): each drum onto its own track where the kit has one (else
// this track), the span cleared first, the sequencer standing aside over what was printed -- the bridge's side. The
// command moved from 97 to 53: 97 is the bridge's "a dialog is open" park on the same cell, so a print and an open Save
// form read alike (the round's notes, Notes_print section "CMD 97 has two meanings"). A bridge older than the round
// (SEQ_UI_SONG_LEVEL) knows no 53: refused with a word, never raised into it (it would sit until the bridge's sweep).
function seq_ui_print_song(_ps_mode) (
  gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 && gmem[GS_BRIDGE_LEVEL] < SEQ_UI_SONG_LEVEL ? ( seq_ui_say("TO ITEM with SONG on needs the newer Kit Bridge: restart REAPER to load the version you installed"); 0; )
  : gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 && gmem[KIT_GMEM_CMD] == 0 && !kit_busy && (gmem[KIT_GMEM_LOCK] == 0 || gmem[KIT_GMEM_LOCK] == instance_id)
    && gmem[EON_SEQ_PRINT_BASE] == 0 ? (
    gmem[KIT_GMEM_LOCK] = instance_id; gmem[KIT_GMEM_PARAM1] = _ps_mode == 2 ? 2 : 1; gmem[KIT_GMEM_NPADS] = 0;
    gmem[KIT_GMEM_CMD] = 53;
    _ps_mode == 2 ? seq_ui_say("Writing the chain from the edit cursor, one MIDI item per entry ...") : seq_ui_say("Writing the song: one MIDI item under every region ..."); 1;
  ) : ( seq_ui_say(gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? "TO ITEM: the bridge is busy, or an item is still on its way -- try again in a moment" : "TO ITEM needs the Kit Bridge"); 0; );
);
function seq_ui_print_menu_open() local(_pm_sb) (
  seq_opt_sync ? (   // SONG on: the song's two shapes; the chain's row is a header (no pick) while the chain is empty
    _pm_sb = EON_SS_SONG_BASE + max(0, _reg_my_slot) * EON_SS_SONG_STRIDE;
    sprintf(#seq_ui_menu, "Every region, in place|%sThe chain from the edit cursor", (gmem[_pm_sb + 1] | 0) > 0 && _reg_my_slot >= 0 ? "" : "#");
  ) : strcpy(#seq_ui_menu, "1 cycle|2 cycles|4 cycles|8 cycles");
