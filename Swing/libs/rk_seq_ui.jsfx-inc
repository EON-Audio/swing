  _rb_bx = _rb_x + swing_px(12); _rb_bw = min(swing_px(76), _rb_kx - swing_px(4) - _rb_bx); _rb_by = _rb_y + swing_px(4); _rb_bh = swing_px(18);
  _rb_bw >= swing_px(40) ? (
