    seq_print_job > 0 ? (   // a song job (round two G): mode x 10000 + count x 100 + k
      seq_print_n > 0 ? sprintf(#seq_ui_lbl, "%s %d of %d written as a MIDI item: %d notes%s", floor(seq_print_job / 10000) == 2 ? "Chain entry" : "Region", seq_print_job - 100 * floor(seq_print_job / 100), floor(seq_print_job / 100) - 100 * floor(seq_print_job / 10000), seq_print_n, seq_print_over ? " -- the list was full, the rest were cut" : "")
