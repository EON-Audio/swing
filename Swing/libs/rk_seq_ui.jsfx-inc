      seq_ui_btn(_rb_bx, _rb_by, _rb_bw, _rb_bh, #seq_ui_lbl, (_rb_sc % 16) > 0) && lmb_down ? ( seq_ui_scale_lane = _rb_l; seq_ui_scale_menu_open(); );
      _rb_by += _rb_bh + 5;
