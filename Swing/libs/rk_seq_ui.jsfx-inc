  strlen(_ln_nm) == 0 ? ( _ln_tgt < 0 ? sprintf(#seq_ui_nm, "MIDI ch %d", -_ln_tgt) : sprintf(#seq_ui_nm, "Pad %d", _ln_tgt + 1); _ln_nm = #seq_ui_nm; );
  _ln_tgt >= NUM_PADS && _ln_tgt < NUM_SLOTS ? ( sprintf(#seq_ui_nm2, "%c%d %s", 65 + floor(_ln_tgt / NUM_PADS), _ln_tgt - NUM_PADS * floor(_ln_tgt / NUM_PADS) + 1, _ln_nm); _ln_nm = #seq_ui_nm2; );
  _ln_nm;
);
function seq_ui_roll_body(_rb_pat, _rb_l, _rb_lb, _rb_x, _rb_y, _rb_w, _rb_h, _rb_gx, _rb_cw, _rb_n0, _rb_shown, _rb_len, _rb_tgt, _rb_r, _rb_g, _rb_b)
local(_rb_rows, _rb_rp, _rb_root, _rb_base, _rb_bx, _rb_by, _rb_bh, _rb_bw, _rb_i, _rb_p, _rb_ry, _rb_rh, _rb_blk, _rb_s, _rb_st, _rb_nb, _rb_k, _rb_c,
