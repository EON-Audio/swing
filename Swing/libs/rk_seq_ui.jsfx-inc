  lw = swing_px(32) + swing_px(32) + swing_px(50) + swing_px(40) + 2;   // LOOP: its label's zone, Off, Region, Song, the seams
  zw = swing_px(34) + swing_px(50) + swing_px(40) + 1;                  // ZOOM: its label's zone, Region, Song, the seam
  lzs = 0;                                                              // 1: the short labels
  pw < arw + nmin + lzg1 + lw + lzg2 + zw ? ( lzs = 1; lw = swing_px(32) + swing_px(28) + swing_px(32) + swing_px(36) + 2; zw = swing_px(34) + swing_px(32) + swing_px(36) + 1; );
  pw < arw + nmin + lzg1 + lw + lzg2 + zw ? zw = 0;
