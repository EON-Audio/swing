  _k_nav && seq_ui_sel_l >= 0 && seq_ui_nvis > 0 && seq_ui_nvis < SEQ_LANES ? (
    seq_ui_sel_l < seq_ui_lscr ? seq_ui_lscr = seq_ui_sel_l
    : seq_ui_sel_l >= seq_ui_lscr + seq_ui_nvis ? seq_ui_lscr = seq_ui_sel_l - seq_ui_nvis + 1;
  );
  _k_used ? _char = 0;   // consumed: the popup / overlay ESC checks and the browser filter never see it
  );
);

// SNAP (S5): where a moved hit or a dragged note lands, and a note length's step. In the footer and beside the folded
// roll (the user, 2026-10-20: "Where is snap?"). Click: the next, right-click: the previous. Returns 1 under the mouse.
function seq_ui_snap_btn(_sn_x, _sn_y, _sn_w, _sn_h) local(_sn_hov) (
  sprintf(#seq_ui_lbl, "SNAP %s", seq_opt_snap == 0 ? "step" : seq_opt_snap == 1 ? "1/2" : seq_opt_snap == 2 ? "1/3" : "off");
  _sn_hov = seq_ui_btn(_sn_x, _sn_y, _sn_w, _sn_h, #seq_ui_lbl, seq_opt_snap == 3);
  _sn_hov && lmb_down ? ( seq_opt_snap = seq_opt_snap >= 3 ? 0 : seq_opt_snap + 1; mark_dirty(); );
  _sn_hov && rmb_down ? ( seq_opt_snap = seq_opt_snap <= 0 ? 3 : seq_opt_snap - 1; mark_dirty(); );
  _sn_hov ? swing_tooltip_check(1461, "SNAP: where a moved hit or note lands -- a whole step, a half, a third (triplets), or off (free). Click: the next, right-click: the previous.");
  _sn_hov;
);
// ── S5: the piano roll, a lane folded out (spec 2.10, decision 14) ──────────────────────────────────────────────────
// Drawn at the bottom of the lane area under its lane's own row, the fifteen other lanes compacted above it and a grabber
// between (the user, 2026-10-20: "Can we get adjustable height grabbers for when the piano lane is used"). Its left
// column is the lane header's room (held to SEQ_UI_ROLL_LEFT_B at least while a roll is open, columns hidden or not):
// the lane's colour strip, the buttons -- FOLD, SNAP, < OCT >, SCALE -- the lane's name, and a keyboard against the grid
// ("the actual piano is ugly"): white keys the strip's width, black keys set in from the left, the white keys' seams
// showing from under them, the C's named, the pad's root tinted amber, the key under the mouse lit. The rows are pitches,
// SEQ_UI_ROLL_ROW_B design px each (twelve at least); the grid's bands follow the keys. OCT moves the window an octave,
// the wheel over an empty spot a semitone; it opens around the pad's root. A press on an empty spot puts a note (the row's
// pitch snapped to the lane's scale, the last length) and the drag draws its length; a press on a note selects it and
// drags it (SNAP's grid; another step needs a free slot) or, from its right third, its length; a right-click deletes it;
// the wheel over a note sets its velocity. Up to six notes start on one step: a chord.
function seq_scale_abbr(_sa_m) ( _sa_m == 1 ? "maj" : _sa_m == 2 ? "min" : _sa_m == 3 ? "dor" : _sa_m == 4 ? "mixo" : _sa_m == 5 ? "pent+" : _sa_m == 6 ? "pent-" : _sa_m == 7 ? "harm" : _sa_m == 8 ? "blues" : "chrom"; );
