  _rb_bkw = floor(_rb_kw * 0.58);
  _rb_i = 0;
  loop(_rb_rows,
    _rb_p = _rb_base + _rb_rows - 1 - _rb_i; _rb_ry = _rb_y + _rb_i * _rb_rp; _rb_rh = max(1, _rb_rp - 1);
    _rb_blk = (_rb_p % 12) == 1 || (_rb_p % 12) == 3 || (_rb_p % 12) == 6 || (_rb_p % 12) == 8 || (_rb_p % 12) == 10;
    !seq_in_scale(_rb_lb, _rb_p) ? gfx_set(0, 0, 0, 0.30) : _rb_p == _rb_root ? gfx_set(0.95, 0.80, 0.45, 0.10) : _rb_blk ? gfx_set(0, 0, 0, 0.16) : gfx_set(1, 1, 1, 0.05);
    gfx_rect(_rb_gx, _rb_ry, _rb_shown * _rb_cw, _rb_rh);
    _rb_p == _rb_hp ? ( gfx_set(1, 1, 1, 0.06); gfx_rect(_rb_gx, _rb_ry, _rb_shown * _rb_cw, _rb_rh); );
    (_rb_p % 12) == 0 ? ( gfx_set(1, 1, 1, 0.16); gfx_rect(_rb_gx, _rb_ry, _rb_shown * _rb_cw, 1); );
    // the key: white the row's full height (the seams below), the black one set in from the left
    _rb_p == _rb_root ? gfx_set(0.95, 0.74, 0.32, 1) : gfx_set(0.86, 0.88, 0.91, 1);
