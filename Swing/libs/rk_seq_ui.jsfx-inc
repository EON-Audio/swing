    _rb_by + _rb_bh <= _rb_y + _rb_h ? ( seq_ui_snap_btn(_rb_bx, _rb_by, _rb_bw, _rb_bh); _rb_by += _rb_bh + 3; );
    _rb_by + _rb_bh <= _rb_y + _rb_h ? (
      seq_ui_btn(_rb_bx, _rb_by, swing_px(22), _rb_bh, "<", 0) && lmb_down ? seq_ui_rbase[_rb_l] = max(0, _rb_base - 12);
