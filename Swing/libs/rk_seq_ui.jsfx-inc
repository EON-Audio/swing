      seq_ui_note_name(_rb_p); rk_font(1, swing_fs(7), 0); gfx_set(0.18, 0.20, 0.24, 0.95);
      gfx_measurestr(#seq_ui_gstr, _rb_tw, _rb_th); gfx_x = _rb_kx + _rb_kw - 3 - _rb_tw; gfx_y = _rb_ry + (_rb_rp - _rb_th) * 0.5; gfx_drawstr(#seq_ui_gstr);
    );
    _rb_i += 1;
  );
  gfx_set(0, 0, 0, 0.55); gfx_rect(_rb_kx - 1, _rb_y, 1, _rb_h); gfx_rect(_rb_gx - 1, _rb_y, 1, _rb_h);   // the strip's edges
