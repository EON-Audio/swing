// rk_seq_ui.jsfx-inc -- the step sequencer's face (Spec_Swing_Seq_View 7). Two homes for one grid:
//   * the PANEL UNDER THE PADS, full width, the default placement of decision 18 (built 2026-10-19 after the
//     user tried S1's full-window grid in REAPER: "i thought the seq would open in another handle the way the
//     mini browser does?"). A gutter with a chevron sits at the bottom of the full UI at all times; opening the
//     panel asks the bridge to grow the WINDOW taller (the browser's width mechanism, now for height), and the
//     panel takes exactly the height the window gains, so the pads never move. Where the window cannot grow
//     (docked, embedded, no js_ReaScriptAPI, no bridge, a screen too short) it takes the height from the pads
//     instead, down to their floor: the pads never hide (spec 7.1).
//   * the same grid as a full-window big view (VIEW_SEQ): the dock face, the embeds and the action script.
// S1: sixteen lanes, steps on / off with a velocity, each lane its length (LEN) and division (DIV), lane M / S,
// eight pattern tabs, PLAY, CLR, the page of steps shown.
// P0a, chunk 2: the KEYBOARD (arrows move the selection, Enter toggles, Delete clears, + / - velocity, PgUp / PgDn the page,
// S V P R N A the views, Space = REAPER's play / stop through the bridge; only while the panel owns the last click and
// no text box has the keys; read from _char the browser filter's way; never in an embed) and the TRANSPORT ROW (|<,
// play, stop, a bar : beat readout: the presses go to the bridge as CMD 95, the bar : beat comes back through the
// browser band, so it is REAPER's own; without the bridge the row shows the state. Its loop button went to row 2's
// LOOP in the small things round).
// The small things round (2026-10-23, the user's list; .docs/specs/Swing_Small_Things_Round_Build_Spec_2026-10-23.md):
// the lane SCRUB (press a lane's icon or chip and slide: each lane's pad sounds), the drawn PICKER (a lane's pad by pad
// or by note, right-click on the icon), toolbar row 2's LOOP and ZOOM and the cut-down preset name box, the song strip's
// DRAGS (a pattern or a region onto the chain, a chain chip along it or off it), the song print's own CMD 53, the gate
// reading the user's face (the compact switch draws the rack face over an open panel) and a closed panel no longer
// lingering after the window was enlarged.
// P0a (2026-10-20, decision 23): the lane's OWN swing (the SW box), the lane icons (the pad's category glyph, an
// option), the OPTIONS menu (icons / FOLLOW / the transport row / aim the pattern at a bank), FOLLOW (the page turns
// with the selected lane's playhead), the right-click step menu (hear the pad, roll, probability, nudge, accent, clear).
// S2a (2026-10-20, "Fix that fall thru first"): the gate claims the mouse for the gutter and the panel ahead of the face.
// Self-audit 2026-10-20: a step switched on from the grid also clears its roll's sub-velocities (seq_step_on_at);
// the target picker's menu is safe against a '|' in a pad's name.
// S2 (2026-10-19, "Go: start the per-step features"): the LANE VIEWS -- STEPS, VEL, PROB, RTCH (rolls), NUDGE, ACC
// -- each changing what a cell shows and what a click, a drag and the wheel edit (spec 14); the STEP EDITOR row
// for the selected step (velocity, probability, roll with its sub-velocities, nudge, accent) and the pattern's
// SWING, GATE, HUM V, HUM T and ACC offset; the lane's TARGET picked from its name (the bank's pads, then the other
// banks); and one REAPER undo point per finished gesture (seq_ui_undo_tick -> the bridge's CMD 94).
// Edits are single-cell writes straight into the model (spec 9): the walker reads a lane's record once per
// block, so a cell written here lands between two blocks. The one structural edit, CLR, is posted
// (seq_post_op, the op queue) and applied in @block. Pattern edits mark the project dirty (spec 8: patterns are project
// state; the SAVE KIT dot is not theirs), and so does a setting that changes what plays or what leaves the plugin (ON,
// SONG, the pattern picked, KEYS, MIDI out and its channel, re-aim on a kit load, a roll's scale) and SNAP (the owner's
// D8, 2026-10-29: "only real edits but snap is a real one i wanna keep saved"); the panel's open state, height, page,
// view, columns, icons, FOLLOW, transport buttons, lane order, the placements and the roll's height are view state,
// like fb_open: they mark nothing and are saved with the project's next save. Imported AFTER rk_swing_ui_minibrowser
// (swing_fb_band, swing_fb_can_grow, FB_REQ_GROWH) and
// rk_swing_ui_state (swing_bigview_close, lcd_bg_*). (c) EON Studios -- All Rights Reserved

@init

SEQ_UI_HDR_B  = 212;   // the lane header column, design px: chip, M, S, name, LEN, DIV, SW (P0a); + the icon column with the icons on
SEQ_UI_ICON_B = 16;    // the lane icon's column at its smallest (the pad's category glyph, an option); it grows with the rows up to 34
SEQ_UI_ROW_B  = 72;    // a lane row's height cap: the sixteen rows FILL the height they are given up to this (26 until the user's look
                       // at the full face, 2026-10-20: "can the grid scale better ... because we are limited to 16 lanes")
SEQ_UI_ROW_MIN_B = 11; // ...and its floor (sixteen rows must fit the smallest window; wiki 4.11)
SEQ_UI_ROW_SCROLL_B = 24; // ...but the rows FILL only while each gets this much; shorter, they keep it and the lanes scroll
                          //   (the owner, 2026-10-27: "scroll up and down instead of trying to fit all the lanes in"; until then
                          //   the rows squeezed to the 11 px floor first). SEQ_UI_ROW_MIN_B stays the floor of the one row
                          //   shown where not even this fits.
SEQ_UI_ROW_SLIVER_B = 6;  // S5: beside an open piano roll the other lanes may shrink to this (the chip and the cells only)
SEQ_UI_ROLL_ROW_B = 18;   // S5: a roll row's height, design px (twelve rows at least, so a short roll packs them tighter)
SEQ_UI_ROLL_LEFT_B = 136; // S5: the roll's left column -- the chip 12, the buttons 76 + 4, the keyboard SEQ_UI_KEYS_B -- the lane
                          //   header is held to this while a roll is open, so the keyboard has its room with the columns hidden
SEQ_UI_KEYS_B = 44;       // S5: the keyboard's strip against the grid
SEQ_UI_RGRIP_B = 6;       // S5: the grabber's band between the compacted lanes and the roll's lane
SEQ_UI_ROLL_MIN_PC = 15;  // S5: the roll's share of the lane area, per cent, as the grabber may set it
SEQ_UI_ROLL_MAX_PC = 92;
SEQ_UI_BAR_B  = 24;    // the toolbar's first row: the title, the pattern tabs, the page, PLAY, CLR, OPT, the transport, X
SEQ_UI_BAR2_B = 22;    // its second row (P0b): the pattern tools, TRIG, the preset strip, SYNC, PRINT, MIDI -- each lit by its step
SEQ_UI_SONG_B = 22;    // the song strip's band under the toolbar (S4): the region chips and the chain; shown while SONG is on
SEQ_UI_KEYS_ROW_B = 40; // the key row under the pattern chips while KEYS is on: sixteen keys, one per pattern, across the panel
                       // (round two C; 18 px and over the tabs only until then -- the user: "far too small"); the lanes give it
                       // their height (the user's choice: "The lanes shrink to make room for the key row, as now")
SEQ_UI_KEYS_LBL_B = 62; // the key row's label zones at each end: the trigger notes' root at the left, the next pattern at the right
SEQ_TRIG_G0S = 20; SEQ_TRIG_E7 = 100; SEQ_TRIG_E8 = 112;   // KEYS ranges' first notes: G#0 (ends just below a kit's pads at 36), E7 (just above bank D's 99), E8
SEQ_UI_RUL_B  = 14;    // the step ruler
SEQ_UI_FOOT_B = 46;    // the footer: the view row (18) and the editor row (24), plus their gaps
SEQ_UI_FOOT3_B = 24;   // ...and a third row on a narrow panel: the pattern's feel under the step editor (P0b)
SEQ_UI_FOOT_ONE_B = 760; // the step editor and the pattern's feel share one row from this panel width (design px: the
                       // editor with a four-hit roll ends at 748); narrower, the feel takes the third row. The WIDTH
                       // decides, never the selection, so the lanes never jump on a click.
SEQ_UI_CELL_B = 32;    // the narrowest step cell before fewer steps are shown
SEQ_UI_VIEWS  = 6;     // STEPS, VEL, PROB, RTCH, NUDGE, ACC
SEQ_PANEL_H_B   = 424; // the panel's default height, design px (seq_h = 0): sixteen lanes at 19 px under the two toolbar rows
                       // (4 + 24 + 2 + 22 + 4), the ruler (14) and the two-row footer (46 + 4); was 400 before the second row (P0b).
                       // With SONG on the song strip takes 22 of the lanes' height (the user turns it on knowingly).
SEQ_GUTTER_H_B  = 18;  // the strip between the pads and the panel: the chevron, the status line, the drag handle
SEQ_PADS_MIN_H_B = 240; // the pads' floor under a panel that takes its height from them (the squeeze)
SEQ_H_MIN_B     = 120; // the smallest panel the handle drags to
SEQ_UI_UNDO_SETTLE = 0.35;   // s without an edit (and no button held) before a finished gesture asks for its undo point
SEQ_CLOSE_SETTLE = 1.5;      // s a closed panel's hold waits for the window to take its height back (swing_seq_gate)
seq_ui_paint = -1;     // -1 none, 0 painting steps off, 1 painting them on (a drag across cells, STEPS view)
seq_ui_last = -1;      // the last cell painted (lane * 64 + step), so a drag toggles each cell once
seq_ui_drag_l = -1;    // the lane whose LEN box is being dragged (-1 none)
seq_ui_sel_l = -1;     // the selected step (the editor row's subject): lane and step, -1 none
seq_ui_sel_s = -1;
seq_ui_cdrag = 0;      // a drag begun on a cell: 1 = a value set from the mouse's height (VEL / PROB), 2 = a nudge set sideways
seq_ui_vdrag_id = 0;   // the editor box being dragged (its id), 0 none
seq_ui_pick_lane = -1; // the lane whose target picker is open
seq_ui_drag_sw = -1;   // the lane whose SW box is being dragged (-1 none)
seq_ui_rc_l = -1;      // the step the right-click menu is open on: lane and step
seq_ui_rc_s = -1;
seq_ui_tap_until = 0;  // "hear the pad" from the step menu: the face holds the pad until this time (the host's frame-end release waits)
seq_ui_focus = 0;      // the panel owns the last click: the keyboard goes to it (cleared by a click on the face)
seq_ui_shown = 16;     // steps on a page, as of the last panel draw (the keys turn the page by it)
seq_ui_chip0 = 0;      // the first pattern chip on show (round two H): the row scrolls when the chips outgrow their room
seq_ui_chip_pat = -1;  // the pattern the row was last pulled to (the chip on screen in view); between changes the ‹ › ends and the wheel scroll it freely (audit K9)
seq_ui_cdrag_live = 0; // the MOVE view's drag went live (4 px of travel): a plain click on a hit leaves its nudge alone (audit K11)
seq_ui_ren_p = -1;     // the pattern being renamed in the face's own box on its chip (-1 none)
seq_ui_chips_x = 0; seq_ui_chips_w = 0;   // the chip area this frame (a fixed footprint: the key strip under it, the rigs)
seq_ui_plus_x = -1;   // the "+" chip's x this frame (-1 none; the rigs)
seq_ui_keys_x = 0; seq_ui_keys_w = 0;   // the key row's keys area this frame (between its label zones; the rigs)
seq_ui_trig_ovl = -1; // the first playable pad on the trigger notes in use, as of the KEYS menu's last opening (-1 none; the rigs)
seq_ui_npat_seen = 0; // the last kit-landing request taken (seq_npat_req_n, rk_seq_core)
seq_ui_msg_until = 0;  // the footer shows #seq_ui_msg until this time (a pattern tool's answer: copied, pasted, refused and why)
seq_ui_cursor = 0;     // the gutter set the resize cursor last frame (so the arrow is put back once when the mouse leaves)
seq_ui_roll_lane = -1; // S5: the lane folded out into its piano roll (one at a time; view state)
seq_ui_ns_l = -1; seq_ui_ns_s = -1; seq_ui_ns_k = -1;   // the selected note: lane, step, slot
seq_ui_nd = 0;         // a note drag: 1 move, 2 length
seq_ui_nd_grab = 0; seq_ui_nd_nx = 0;   // where in the note the mouse took it (steps); the note's left edge (px) for a length drag
seq_ui_last_len = 1;   // the length a new note takes: the last one set
seq_ui_nd_mx0 = 0; seq_ui_nd_my0 = 0; seq_ui_nd_live = 0;   // where a note press began (x and y); 1 once it moved 4 px (a click alone neither moves nor sizes)
seq_ui_want_cur = 0;  // the cursor the panel wants this frame (0 = none): sizing over a note's end, moving over a note
seq_ui_rdrag = 0; seq_ui_rdrag_t = 0;   // the roll's grabber held; the last press on it (a double-click resets the split)
seq_ui_rgrip_y = 0; seq_ui_fold_ry = 0;  // the grabber's y and the roll's lane's row y as of the last draw (the rig reads them)
seq_ui_roll_hov = 0;   // the mouse is over a roll this frame (the footer's hint)
seq_ui_chan_lane = -1; seq_ui_scale_lane = -1;   // the lane the channel / scale menu is open for
seq_ui_cdrag_s0 = 0;   // the MOVE view: the step a dragged hit started on
seq_ui_roll_y0 = 0; seq_ui_roll_rowp = 0; seq_ui_roll_base = 0; seq_ui_roll_rows = 0;   // the roll's geometry as of the last draw (the rig reads it)
seq_ui_pnav_seq = 0;   // the preset strip's NAV counter, this instance's (S3b; the bridge edge-detects it per slot)
seq_ui_preset_ack = 0; // the last seq_preset_seq the face answered with an undo point and a message
seq_ui_kit_seen = 0;   // the last seq_kit_adopted the face answered (S3c)
seq_ui_kit_pub_seen = 0;   // the last seq_kit_pubs the face looked at (a refused record is said)
seq_ui_print_seen = 0;     // the last seq_print_done the face answered (S6)
seq_ui_pmenu_pat = 0;      // the pattern the PATTERN menu was opened for (the button: the one on screen; a tab's right-click: that tab's)
seq_ui_mo_seen = 0; seq_ui_mo_t = -10;   // the mirror's pulse the face last saw, and when: the header's lamp blinks for a tenth of a second
seq_ui_bg_r = 0.10; seq_ui_bg_g = 0.26; seq_ui_bg_b = 0.35;   // the panel's background this frame (seq_ui_theme_bg)
seq_ui_pidx = 0; seq_ui_pcount = 0;   // the preset index and count the bridge published for this slot
seq_ui_plist = 0;         // the preset list is open inside the panel (S3b; view state, not saved)
seq_ui_plist_scroll = 0;  // its first visible row (of the filtered rows)
seq_ui_plist_genre = -1;  // the chips: -1 = all
seq_ui_plist_feel = -1; seq_ui_plist_role = -1;
seq_ui_plist_n = 0;       // the filtered rows (their flat indices in seq_ui_plist_ix) and the list stamp they were built for
seq_ui_plist_seq = -1; seq_ui_plist_dirty = 1;
seq_ui_psel_seq = 0;      // this instance's SELECT counter (the bridge edge-detects it per slot)
seq_ui_plist_x = 0; seq_ui_plist_row0_y = 0; seq_ui_plist_rowh = 0;   // the rows' geometry as of the last draw (the rig reads it)
seq_ui_songreq_seq = 0;   // the song commands' counter (S4; seeded above gmem's so a reload replays nothing)
seq_ui_rc_ord = 0;        // the region chip the menu is open on (its 1-based ordinal)
seq_ui_adapt_ack = 0;     // the last seq_adapt_seq the face answered (an undo point and a word)
seq_ui_song_x0 = 0; seq_ui_song_y = 0; seq_ui_song_chipw = 0;   // the strip's chips' geometry as of the last draw (the rig reads it)
// ── The small things round (2026-10-23; .docs/specs/Swing_Small_Things_Round_Build_Spec_2026-10-23.md) ──
// The lane scrub (the user: "just click the icon up and down like I could in Stepa and hear it"): a press on a lane's
// icon, or its colour chip, held -- each lane's pad sounds as the pointer crosses its row, the one before released first
seq_ui_scrub = 0;      // a scrub is held
seq_ui_scrub_l = -1;   // the lane the pointer was over last (a MIDI channel lane counts, and sounds nothing)
// The drawn picker (the user: "show like a piano and or pad view so people can make that change quickly"): a lane's pad
// chosen from the pads laid out like the grid, or by note; modal inside the panel; view state, never saved
seq_ui_pk_lane = -1;   // the lane it chooses for, -1 closed
seq_ui_pk_pat = 0;     // the pattern that lane is in (the one on screen when it opened)
seq_ui_pk_bank = 0; seq_ui_pk_tab = 0;   // the bank shown; 0 PADS, 1 PIANO
seq_ui_pk_oct = 36;    // the PIANO's lowest note (two octaves up from it)
seq_ui_pk_hov = -1;    // the pad under the pointer last frame (hover = hear, once per pad entered)
seq_ui_pk_just = 0;    // it opened this frame: the press that opened it is not one of its own
seq_ui_pk_ax = 0; seq_ui_pk_ay = 0;   // where it was opened (it opens beside that point)
seq_ui_pk_x = 0; seq_ui_pk_y = 0; seq_ui_pk_w = 0; seq_ui_pk_h = 0;   // its rect, its tile and its body's corner as of the last
seq_ui_pk_tile = 0; seq_ui_pk_gx = 0; seq_ui_pk_gy = 0;              // draw (the rigs read them)
SEQ_UI_PK_TILE_MIN_B = 36;   // a tile's smallest side, design px: below it the panel is too small and the text menu opens instead
SEQ_UI_PK_TILE_MAX_B = 64;   // ...and its largest
SEQ_UI_PK_MIN_W_B = 200;     // the picker's narrowest (the tab row: PADS PIANO and the four banks)
// The song strip's drags (the user: "The ability to drag the patterns in song mode, we never put that inside the
// sequencer"; Steppa's rules): 1 a pattern tab pressed (a drag past 6 px down), 2 a pattern or a region dragged (it is
// inserted where it drops ON THE CHAIN; dropped anywhere else, nothing), 3 a chain chip dragged (moved where it drops on
// the chain, removed when dropped well clear), 4 a region chip pressed (a drag once it moves past 6 px, like a tab: a
// click's drift is still a click)
seq_ui_sdrag = 0;
seq_ui_sdrag_pat = -1; seq_ui_sdrag_ord = 0;   // the pattern, and its region's ordinal (0 = no region: refused)
seq_ui_sdrag_from = 0; seq_ui_sdrag_v = 0;     // the chain entry dragged (1-based) and its cell when it was taken (stale check)
seq_ui_sdrag_x0 = 0; seq_ui_sdrag_y0 = 0; seq_ui_sdrag_moved = 0;
seq_ui_chn = 0;                                // the chain's chips drawn (their x and w in seq_ui_chgeo, the host's claim)
seq_ui_ch_x0 = 0; seq_ui_ch_x1 = 0;            // the chain's area along the strip
seq_ui_song_by = -100000; seq_ui_song_bh = 0;  // the strip's band (its y and height) as of the last draw
seq_ui_lf_pat = -1;    // the pattern the LOOP's region last followed (-1: not seen yet, so opening the panel moves nothing)
seq_ui_wh_pos = 0; seq_ui_wh_rep = 1; seq_ui_wh_t = -10;   // the chain chip the wheel last set (1-based), the repeats it asked, when
// toolbar row 2's geometry as of the last draw (the rigs): the name box, LOOP and ZOOM (x, w; w 0 = not shown), SONG's x
seq_ui_t2_nx = 0; seq_ui_t2_nw = 0; seq_ui_t2_lx = 0; seq_ui_t2_lw = 0; seq_ui_t2_zx = 0; seq_ui_t2_zw = 0; seq_ui_t2_rx = 0;
seq_ui_t2_kx = 0; seq_ui_t2_tx = -1;           // KEYS' right edge; the transport's x on row 2 (-1: on row 1, or off)
seq_ui_t2_lit = -1;                            // the LOOP button drawn lit (0 Off, 1 Region, 2 Song; -1 none) as of the last draw
seq_ui_t2_ax = -1;                             // the preset's < arrow's x (the > sits after the name box; -1: the arrows yielded)
// the transport's loop icon (back 2026-10-26; the owner: "bring back looping icon in the transport. With some icon options
// maybe an r or s when its looping the region vs song"), as of the last draw (the rigs): its x and y (-1: not drawn), lit,
// the letter in its ring (0 none, 'R' the region, 'S' the song); and the mode it turns on from Off (1 Region, 2 Song): the
// one last seen lit or picked, Region until then (view state: not saved)
seq_ui_tr_lx = -1; seq_ui_tr_ly = 0; seq_ui_tr_lit = 0; seq_ui_tr_ch = 0; seq_ui_loop_last = 1;
seq_ui_x_x = -1;                               // the close X's x as of the last draw (the far right of the top row since 2026-10-27; the rigs)
seq_ui_lscr = 0;                               // the lanes' scroll (2026-10-27): the first lane shown, in lane order, where they do not all fit
seq_ui_nvis = 16;                              // ...and how many are shown, as of the last draw (16: all; the rigs)
seq_ui_lsb_drag = 0; seq_ui_lsb_y0 = 0; seq_ui_lsb_k0 = 0;   // the lanes' scroll bar: its thumb dragged, from (y0, the rows above then)
seq_ui_t1_ox = 0; seq_ui_t1_fx = 0;            // row 1 as of the last draw (the rigs): OPT's right edge, the full-face button's x
seq_ui_pk_seen = 0;    // the picker was drawn since the last window pass's gate (a picker no home draws is closed there)
seq_ui_pk_rawr = 0;    // a right press on the face this window pass, taken from it while the picker is up (it closes the picker)
// The bridge level that takes the round's new requests: song ops 16 (LOOP_MODE) and 17 (INSERT_AT) and the song print's
// CMD 53. Older bridges ignore an unknown op without a word and sweep an unknown CMD, so below it LOOP is dimmed, a drop
// that would insert says so, and TO ITEM's song print refuses (the house rule: BRIDGE_LEVEL_WIRED, Swing_ReaKit).
// 319: the level the round's Kit Bridge publishes (EON_BRIDGE_LEVEL, the SONG builder's; the two must agree at the merge).
SEQ_UI_SONG_LEVEL = 319;
// The transport's own mailbox (FU-T, 2026-10-26; the owner: STOP always works, even while a kit loads). A press rides
// this Swing's slot of the SYNC band, never the kit bus a load holds: +61 the press counter (written LAST), +62 / +63 the
// action of an even / odd press (two presses inside one bridge tick both arrive). The bridge serves it every tick
// whatever the bus, LOCK or a load are doing. A bridge below SEQ_UI_TR_LEVEL knows no mailbox: CMD 95 as before.
SEQ_UI_TR_LEVEL = 321;
SEQ_UI_TR_REQ = 61; SEQ_UI_TR_ACT = 62;
seq_ui_trreq_seq = 0;     // this instance's press counter (seeded above gmem's, so a slot's earlier owner replays nothing)
function seq_ui_plist_init(_pi_base) ( seq_ui_plist_ix = _pi_base; );
seq_tr_rpt = 0;        // the transport row (P0a): REAPER's repeat state, the bar and the beat, from the bridge each frame
seq_tr_meas = 0;
seq_tr_beat = 0;
SEQ_KEY_UP = 30064; SEQ_KEY_DOWN = 1685026670; SEQ_KEY_LEFT = 1818584692; SEQ_KEY_RIGHT = 1919379572;   // gfx_getchar's names
SEQ_KEY_PGUP = 1885828464; SEQ_KEY_PGDN = 1885824110; SEQ_KEY_DEL = 6579564;
seq_h_cur = 0;         // the panel's height THIS frame, 0 closed (swing_seq_gate)
seq_gut_h = 0;         // the gutter's height this frame (0 in the rack face and the embeds)
seq_ui_take_win = 0;   // gutter + panel as of the last WINDOW pass: what _ui_sc leaves out of its height
seq_ui_mouse_own = 0;  // a press that began in the gutter or the panel: theirs until the button comes up (swing_seq_gate)
_seq_claim = 0;        // this frame's claim: the face sees nothing of the mouse, swing_seq_under_draw hands it to the panel
_seq_g_lmbdown = 0; _seq_g_rmbdown = 0; _seq_g_lmbclick = 0; _seq_g_rmbclick = 0; _seq_g_wheel = 0;   // the stash

function seq_ui_div_name(d) (
  d == 0 ? "1/4" : d == 1 ? "1/8" : d == 2 ? "1/16" : d == 3 ? "1/32" : d == 4 ? "1/4T" : d == 5 ? "1/8T" :
  d == 6 ? "1/16T" : d == 7 ? "1/8." : d == 8 ? "1/16." : "?";
);
function seq_ui_view_name(v) (
  v == 0 ? "STEPS" : v == 1 ? "VEL" : v == 2 ? "PROB" : v == 3 ? "RTCH" : v == 4 ? "MOVE" : "ACC";   // MOVE was NUDGE until S5
);

// A pattern edit happened: the project is dirty, and once the gesture settles it earns an undo point.
function seq_ui_edited() (
  mark_dirty();
  seq_ui_edit_t = time_precise();
  seq_ui_undo_wait = 1;
);
// One REAPER undo point per finished gesture, through the bridge (CMD 94: a block around the hidden counter's
// nudge, named for the pattern -- wiki 6.23: a JSFX's own state change is invisible to REAPER until something
// makes it read the state again). Posted once the edits have settled and no button is held, on an idle bus.
// Without the bridge there is no point to make: the edit is saved with the project all the same.
function seq_ui_undo_tick() (
  seq_ui_undo_wait && !LMB && time_precise() - seq_ui_edit_t > SEQ_UI_UNDO_SETTLE ? (
    gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 ? (
      gmem[KIT_GMEM_CMD] == 0 && !kit_busy && (gmem[KIT_GMEM_LOCK] == 0 || gmem[KIT_GMEM_LOCK] == instance_id) ? (
        gmem[KIT_GMEM_LOCK] = instance_id;
        gmem[KIT_GMEM_PARAM1] = max(0, min(SEQ_PATS - 1, seq_cur | 0));
        // PARAM2 (the printed-mute job, 2026-10-30; a bridge of BRIDGE_LEVEL_PRINT_LANES): the lanes that sound, as
        // -(1 + the mask), when they changed since the last 94 that carried them -- the bridge then mutes / unmutes the
        // printed notes inside this same undo block -- else 0 (nothing to do; an older bridge reads nothing here). Not
        // saved: after an undo puts an older mask back the next 94 carries it again, and the bridge finds the items
        // already matching (the same undo put them back).
        gmem[GS_BRIDGE_LEVEL] >= BRIDGE_LEVEL_PRINT_LANES && seq_live_mask() != seq_live_sent ? (
          seq_live_sent = seq_live_mask();
          gmem[KIT_GMEM_NPADS] = -1 - seq_live_sent;
        ) : gmem[KIT_GMEM_NPADS] = 0;
        gmem[KIT_GMEM_CMD] = 94;
        seq_ui_undo_wait = 0;
      );
    ) : ( seq_ui_undo_wait = 0; );
  );
);
// A line in the footer for three seconds: what a pattern tool did, or why it refused. (Defined here, above the gate, since
// audit K8: the acks below say their word from the gate.)
function seq_ui_say(_sy_s) ( strcpy(#seq_ui_msg, _sy_s); seq_ui_msg_until = time_precise() + 3; );
// The name, index and count the bridge published for this slot (the name 0-ended, 31 chars at most) -> #seq_ui_pname.
function seq_ui_preset_read() local(_pr_b, _pr_i, _pr_c) (
  strcpy(#seq_ui_pname, ""); seq_ui_pidx = 0; seq_ui_pcount = 0;
  _reg_my_slot >= 0 ? (
    _pr_b = EON_SS_PCTRL_BASE + _reg_my_slot * EON_SS_PCTRL_STRIDE;
    seq_ui_pidx = gmem[_pr_b + 2] | 0; seq_ui_pcount = gmem[_pr_b + 3] | 0;
    _pr_i = 0; _pr_c = gmem[_pr_b + 16] | 0;
    while(_pr_c > 0 && _pr_i < 31) (
      sprintf(#seq_ui_pname2, "%s%c", #seq_ui_pname, _pr_c); strcpy(#seq_ui_pname, #seq_ui_pname2);
      _pr_i += 1; _pr_c = gmem[_pr_b + 16 + _pr_i] | 0;
    );
  );
);
// The engine's acks the face answers with an undo point and a word, taken on every window pass (swing_seq_gate) and not
// only while the panel draws (audit K8, 2026-10-26: with the sequencer closed a kit load's ADAPT re-aim, or a preset the
// bridge staged, left its undo point waiting for the panel to open, and the count a kit's record wants was not raised):
// a kit's patterns in (USE THEM), a preset taken, ADAPT's re-aim, the landed count. The panel draw calls it too (the rigs
// drive the draw alone); every ack compares a counter, so a second call in a frame does nothing.
function seq_ui_ack_tick() (
  seq_npat_req_n != seq_ui_npat_seen ? ( seq_ui_npat_seen = seq_npat_req_n; seq_npat = max(seq_npat, min(SEQ_PATS, seq_npat_req_v | 0)); );   // a kit landed (round two H)
  seq_kit_adopted != seq_ui_kit_seen ? (   // a kit's patterns arrived (S3c): the undo point and the word
    seq_ui_kit_seen = seq_kit_adopted; seq_ui_sel_l = -1; seq_ui_roll_lane = -1; seq_ui_edited(); seq_ui_say("The kit's patterns are in");
  );
  seq_preset_seq != seq_ui_preset_ack ? (   // the engine took a preset: the undo point and the word (S3b)
    seq_ui_preset_ack = seq_preset_seq; seq_ui_sel_l = -1; seq_ui_edited(); seq_ui_preset_read();
    sprintf(#seq_ui_lbl, "Preset: %s (%d of %d) into pattern %d", #seq_ui_pname, seq_ui_pidx + 1, seq_ui_pcount, max(0, min(SEQ_PATS - 1, seq_cur | 0)) + 1); seq_ui_say(#seq_ui_lbl);
  );
  // ADAPT took the lanes along with a kit load (S4): the undo point and the word
  seq_adapt_seq != seq_ui_adapt_ack ? ( seq_ui_adapt_ack = seq_adapt_seq; seq_ui_edited(); seq_ui_say("Kit loaded: the lanes followed the pads that moved"); );
);

// A song command to the bridge's chain engine (S4; Steppa's eon_song_cmd): the payload first, the op, the counter LAST.
// Ops: 1 append region A1, 2 remove chain entry A1, 3 move entry A1 to A2, 4 repeats of entry A1 = A2, 5 play the chain
// (or the transport), 6 stop, 7 loop, 8 clear the chain, 10 zoom to the song, 11 zoom to region A1, 13 play from region
// A1, 14 append A1 with A2 repeats, 16 LOOP_MODE (A1 0 off / 1 region A2 / 2 the song), 17 insert region A1 at chain
// position A2 (the small things round, 2026-10-23).
// ONE request per bridge tick: the mailbox has one cell per field and the bridge edge-detects the counter, so a second
// post before it looked lost the first (the loop following a pattern tab's press, then the tab's drop on the chain a
// moment later). The ops queue here, three deep, and go out SEQ_UI_SONG_GAP apart (the bridge polls ~30 times a second;
// there is no ack to wait on). The gate pumps the queue every window pass, so a closed panel still sends what it queued.
SEQ_UI_SONG_GAP = 0.2;
seq_ui_sq_n = 0; seq_ui_sq_t = -10;
function seq_ui_song_post(_sp_op, _sp_a1, _sp_a2) local(_sp_b) (
  _reg_my_slot >= 0 ? (
    _sp_b = EON_SS_SYNC_BASE + _reg_my_slot * EON_SS_SYNC_STRIDE;
    gmem[_sp_b + 45] = _sp_a1; gmem[_sp_b + 46] = _sp_a2; gmem[_sp_b + 44] = _sp_op;
    seq_ui_songreq_seq = max(seq_ui_songreq_seq, gmem[_sp_b + 47] | 0) + 1;
    gmem[_sp_b + 47] = seq_ui_songreq_seq;
  );
  seq_ui_sq_t = time_precise();
);
// A request that waited SEQ_UI_SONG_STALE (the window was shut before its turn: no pass pumped it) is dropped with the
// rest, never sent long after the click (a three-deep queue drains in 0.6 s).
SEQ_UI_SONG_STALE = 2;
function seq_ui_song_pump() (
  seq_ui_sq_n > 0 && time_precise() - seq_ui_sq_e0 > SEQ_UI_SONG_STALE ? seq_ui_sq_n = 0;
  seq_ui_sq_n > 0 && time_precise() - seq_ui_sq_t >= SEQ_UI_SONG_GAP ? (
    seq_ui_song_post(seq_ui_sq_op0, seq_ui_sq_a10, seq_ui_sq_a20);
    seq_ui_sq_op0 = seq_ui_sq_op1; seq_ui_sq_a10 = seq_ui_sq_a11; seq_ui_sq_a20 = seq_ui_sq_a21; seq_ui_sq_e0 = seq_ui_sq_e1;
    seq_ui_sq_op1 = seq_ui_sq_op2; seq_ui_sq_a11 = seq_ui_sq_a12; seq_ui_sq_a21 = seq_ui_sq_a22; seq_ui_sq_e1 = seq_ui_sq_e2;
    seq_ui_sq_n -= 1;
  );
);
// A request that only restates the last one waiting -- the repeats of the same entry (op 4: a wheel spun faster than the
// gap), the loop's mode (op 16: the latest click wins) -- takes its place instead of queueing behind it.
function seq_ui_song_cmd(_sc_op, _sc_a1, _sc_a2) local(_sc_l) (
  _reg_my_slot >= 0 ? (
    _sc_l = seq_ui_sq_n == 3 ? seq_ui_sq_op2 : seq_ui_sq_n == 2 ? seq_ui_sq_op1 : seq_ui_sq_n == 1 ? seq_ui_sq_op0 : 0;   // the last waiting
    _sc_l == _sc_op && (_sc_op == 16 || (_sc_op == 4 && (seq_ui_sq_n == 3 ? seq_ui_sq_a12 : seq_ui_sq_n == 2 ? seq_ui_sq_a11 : seq_ui_sq_a10) == _sc_a1)) ? (
      seq_ui_sq_n == 3 ? ( seq_ui_sq_a12 = _sc_a1; seq_ui_sq_a22 = _sc_a2; )
      : seq_ui_sq_n == 2 ? ( seq_ui_sq_a11 = _sc_a1; seq_ui_sq_a21 = _sc_a2; )
      : ( seq_ui_sq_a10 = _sc_a1; seq_ui_sq_a20 = _sc_a2; );
    )
    : seq_ui_sq_n == 0 ? ( seq_ui_sq_op0 = _sc_op; seq_ui_sq_a10 = _sc_a1; seq_ui_sq_a20 = _sc_a2; seq_ui_sq_e0 = time_precise(); seq_ui_sq_n = 1; )
    : seq_ui_sq_n == 1 ? ( seq_ui_sq_op1 = _sc_op; seq_ui_sq_a11 = _sc_a1; seq_ui_sq_a21 = _sc_a2; seq_ui_sq_e1 = time_precise(); seq_ui_sq_n = 2; )
    : seq_ui_sq_n == 2 ? ( seq_ui_sq_op2 = _sc_op; seq_ui_sq_a12 = _sc_a1; seq_ui_sq_a22 = _sc_a2; seq_ui_sq_e2 = time_precise(); seq_ui_sq_n = 3; )
    : ( strcpy(#seq_ui_msg, "Too quick: that change was not sent. Wait a moment and do it again."); seq_ui_msg_until = time_precise() + 3; );   // a fourth while three wait: dropped, with a word (seq_ui_say's two writes: it is defined further down)
    seq_ui_song_pump();   // at once when the last post had its time
  );
);
// LOOP Region follows the pattern the face put on screen (the small things round; the spec: "a chip click, a tab click,
// keys"): while the bridge reads REAPER's loop as a region (SONG band +5 == 1), the region playing pattern _lf_p becomes
// the loop -- one op 16, and only when it is another region than the one looped (+6). Every gesture that puts a pattern
// on screen calls this at once, with the pattern it chose: playing synced, the engine turns the screen to the
// playhead's region on the next block, so a check made a frame later would see the playhead's pattern, not the click.
// The panel's own check (swing_seq_panel_draw) takes the other changes -- a trigger note, the Drum Matrix -- while the
// song is stopped; seq_ui_lf_pat is the pattern it last took. _lf_ord: the region clicked (a region chip), 0 = the region
// playing the pattern (seq_ui_region_of's rule: the first in time).
function seq_ui_loop_follow(_lf_p, _lf_ord) local(_lf_sb, _lf_o, _lf_i) (
  seq_ui_lf_pat = _lf_p;
  seq_opt_sync && _reg_my_slot >= 0 && gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 && gmem[GS_BRIDGE_LEVEL] >= SEQ_UI_SONG_LEVEL ? (
    _lf_sb = EON_SS_SONG_BASE + _reg_my_slot * EON_SS_SONG_STRIDE;
    _lf_o = _lf_ord; _lf_i = 0;   // 1-based
    _lf_o < 1 ? ( _lf_o = 0; loop(max(0, min(64, seq_map_n | 0)), !_lf_o && (seq_map[_lf_i * 4 + 2] | 0) == _lf_p ? _lf_o = _lf_i + 1; _lf_i += 1; ); );
    (gmem[_lf_sb + 5] | 0) == 1 && _lf_o > 0 && _lf_o != (gmem[_lf_sb + 6] | 0) ? seq_ui_song_cmd(16, 1, _lf_o);
  );
);

// The panel's ask, canvas px: the user's dragged height (seq_h, saved with the project) or the default.
function swing_seq_req_h() (
  seq_h > 0 ? max(swing_px(SEQ_H_MIN_B), min(2000, seq_h | 0)) : swing_px(SEQ_PANEL_H_B);
);
// The browser's ask when it is placed below the pads (fb_place 3; round two J's swap, 2026-10-22): its dragged height
// (fb_h, gate 81, 0 = the default) or the default.
FB_BOTTOM_H_B = 300;
function swing_fb_req_h() (
  fb_h > 0 ? max(swing_px(SEQ_H_MIN_B), min(2000, fb_h | 0)) : swing_px(FB_BOTTOM_H_B);
);
// The handle's reach above the gutter (2026-10-27; the owner: "Resizing the side and bottom panels: hard to grab"). With a
// panel open below, the grab (the press, the wheel, the lit edge, the resize cursor) also takes the SEQ_GRIP_EXT px just
// above the gutter over the PADS' column: the pad well's own bottom margin (rk_swing_ui_grid_pads: the well ends 4 px
// above ui_bot and no pad control reaches into it), so no control loses a click there. The left column (the MASTER VOL
// label) and the side slot's column (its controls reach its bottom) are not taken -- there the control wins -- nor the
// corner where the side seam's own reach is (swing_side_seam_ext), nor while a gesture on the pads is live (a pad swap,
// a mini knob: the drag is theirs). Fixed px, not scaled: the well's margin does not scale.
SEQ_GRIP_EXT = 4;
function seq_ui_grip_ext(_ge_mx, _ge_my) (
  seq_gut_h > 0 && bot_panel > 0 && big_view_id == VIEW_NONE && !_grid_gesture_live && _ge_my >= ui_bot - SEQ_GRIP_EXT && _ge_my < ui_bot
    && _ge_mx >= right_x && _ge_mx < right_x + right_w - SEQ_GRIP_EXT;
);

// ── The panel's height, once per pass (the host calls this right after swing_fb_gate) ────────────────
// The browser's rule for width (swing_fb_gate_window; read its comments first), applied to height: the panel
// only ever occupies height the WINDOW HAS ALREADY BEEN GIVEN. It asks for the whole height at once -- a
// CONSTANT request, never one derived from gfx_h, which would feed back -- and takes nothing until that height
// arrives, so the pads never move and the panel appears in space that did not exist a frame earlier. The
// bridge grows the floating window downward (eon_fb_grow, the FB_REQ_GROWH word of this instance's browser
// band); a project that loads with the panel open comes with its window already tall, so the first frame
// ADOPTS that height rather than asking again, and a dock or undock re-baselines (the window means something
// else on the other side of it). Where the window cannot grow -- docked, embedded, no js_ReaScriptAPI, a bridge
// that never answers, a screen too short for the whole ask -- the panel takes the height from the pads instead,
// immediately where that is knowable and after twenty frames where it is not, down to the pads' floor.
// Window passes only; an embed pass gets no gutter and no panel. Sets seq_gut_h, seq_h_cur and ui_bot, the main
// face's bottom edge (gfx_h in the rack face and the embeds), which the layout reads instead of gfx_h.
function swing_seq_gate() local(_cap, _got, _cangrow, _req, _b, _full, _seq_in) (
  // the panel lives in the full UI; the rack face keeps the big view. The USER's face (dock_face_user: the choice or Auto's
  // pick), not the face drawn: the compact switch (the small things round, 2026-10-23) draws the rack face while the panel
  // leaves too little room, and the panel must stay -- reading dock_face here dropped the grow request, the window shrank,
  // the room came back and the face flipped back and forth. Since 2026-10-27 the rack face Auto picks from a floating
  // window's shape keeps the slot too (rk_swing_ui_state swing_bot_slot; the owner: the handle must not disappear when
  // the window is resized to the compact face); the dock rig's capture and the user's own Rack pick keep none.
  _full = swing_bot_slot();
  seq_gut_h = _full ? swing_px(SEQ_GUTTER_H_B) : 0;
  // the bottom slot's panel (round two J's swap, 2026-10-22): the sequencer unless it is placed at the side (seq_place 1),
  // the browser when it is placed below (fb_place 3), the pad editor when it is (fx_place 3; the user: "I want it all").
  // The slot's logic below reads _bot_on where it read seq_shown; the keys and the focus stay the sequencer's own.
  // Two or three below and open: the LAST OPENED is the one shown -- each takes a stamp the frame it becomes open-and-
  // below (the strip's chips and the PAD FX button re-stamp an open one to bring it to the front); the sequencer is
  // stamped last here, so a project that opens with all of them below shows the sequencer.
  _bot_sq = seq_shown && seq_place != 1; _bot_fb = fb_open && fb_place == 3; _bot_fx = pfx_open && fx_place == 3;
  _bot_fx && !_bot_fx_prev ? pfx_bstamp = (bot_stamp += 1); _bot_fb && !_bot_fb_prev ? fb_bstamp = (bot_stamp += 1); _bot_sq && !_bot_sq_prev ? seq_bstamp = (bot_stamp += 1);
  _bot_fx_prev = _bot_fx; _bot_fb_prev = _bot_fb; _bot_sq_prev = _bot_sq;
  bot_panel = 0; _bot_best = -1;
  _bot_sq && seq_bstamp > _bot_best ? ( bot_panel = 1; _bot_best = seq_bstamp; );
  _bot_fb && fb_bstamp > _bot_best ? ( bot_panel = 2; _bot_best = fb_bstamp; );
  _bot_fx && pfx_bstamp > _bot_best ? ( bot_panel = 3; _bot_best = pfx_bstamp; );
  _bot_on = bot_panel > 0;
  _req = bot_panel == 2 ? swing_fb_req_h() : bot_panel == 3 ? swing_pfx_req_h() : swing_seq_req_h();
  !is_embedded ? (
    _b = swing_fb_band();
    // canvas px; moves only with the bottom panel and its height. Only with a slot of its own (audit K16): swing_fb_band
    // clamps a slotless Swing -- the seventeenth, the first frames before @block claims one -- onto slot 0's band, where
    // its ask fought that Swing's; with no slot the bridge cannot answer and the pads give the height (the squeeze)
    _reg_my_slot >= 0 ? gmem[_b + FB_REQ_GROWH] = (_full && _bot_on) ? _req : 0;
    seq_tr_rpt = gmem[_b + FB_TR_RPT]; seq_tr_meas = gmem[_b + FB_TR_MEAS]; seq_tr_beat = gmem[_b + FB_TR_BEAT];
    seq_ui_ack_tick();    // the engine's acks (a kit's patterns, a preset, ADAPT, the landed count), panel open or not (K8)
    seq_ui_undo_tick();
    seq_ui_song_pump();   // a queued song op goes out once the last one had its time (seq_ui_song_cmd)
    // the sequencer gone from every home: its picker and its drags go with it (the big view counts as a home), and the
    // LOOP's follow forgets the pattern (opened again, the panel only notes it); a gesture ends with the button (window
    // passes only: an embed's own button says nothing about the window's press)
    !seq_shown && big_view_id != VIEW_SEQ ? ( seq_ui_pk_lane = -1; seq_ui_sdrag = 0; seq_ui_scrub = 0; seq_ui_lf_pat = -1; );
    !_raw_LMB ? seq_ui_scrub = 0;
  );
  _full ? (
    // What the panel may take this frame: the ask, but never past the pads' floor.
    // ... and never into the room a panel at the SIDE needs (the editor's 560 + its tab row): the panel below gives way
    // first, the editor's bottom is never cut while the window has the height for both (2026-10-22)
    // DOCKED (the dock rig holds this Swing: the window cannot grow; 2026-10-27, the owner: what was open stays open
    // once docked): the pads give the height down to their floor under the face actually drawn -- the rack face's own
    // header (rk_swing_ui_state's rack_hdr_h), not the full face's LCD bar -- and the side panels' height is not held
    // back: a docker is never tall enough for the editor's 560 and the panel below together, and holding it left the
    // panel below at 0 (only its handle) whenever the pad editor was open at the side.
    _cangrow = swing_fb_can_grow();
    _cap = max(0, min(_req, gfx_h - 28 - swing_px(LCD_BAR_H) - swing_px(BANK_STRIP_H) - max(swing_px(SEQ_PADS_MIN_H_B), swing_side_need_h()) - seq_gut_h));
    !_cangrow ? _cap = max(0, min(_req, gfx_h - (dock_face_user ? max(26, min(40, (gfx_h * 0.12) | 0)) : 28 + swing_px(LCD_BAR_H))
                                            - swing_px(BANK_STRIP_H) - swing_px(SEQ_PADS_MIN_H_B) - seq_gut_h));
    // ... at its own smallest height or not at all: under it the panel's toolbars and footer draw over each other (seen
    // at 56 px in a 380 px docker); the gutter -- its handle, its status line -- stays and says it is open
    !_cangrow && _cap < (bot_panel == 3 ? swing_px(PFX_BOTTOM_MIN_B) : swing_px(SEQ_H_MIN_B)) ? _cap = 0;
    _seq_h_init ? 0 : (
      _seq_base_h = _bot_on ? (gfx_h - _cap) : gfx_h;   // first frame: a window restored tall already carries the panel
      _seq_base_set = 1; _seq_h_init = 1; _seq_growp = _cangrow;
    );
    // a dock or an undock re-bases on what the window CARRIED (_seq_carry_h: all of the panel's height, or the part the
    // screen gave -- then the pads gave the rest, so they do again at once; 2026-10-27, the dock's one-to-one, the side
    // slot's twin in rk_swing_ui_minibrowser)
    _seq_growp != _cangrow ? (
      _seq_growp = _cangrow;
      _seq_base_h = (_bot_on && _seq_carry_h > 0) ? (gfx_h - _seq_carry_h) : gfx_h;
      _seq_base_set = 1; _seq_squeeze = (_bot_on && _seq_carry_h > 0 && !_seq_carry) ? 1 : 0; _seq_wait = 0;
    );
    _bot_on && !_seq_base_set ? ( _seq_base_h = gfx_h; _seq_base_set = 1; _seq_wait = 0; );
    // The closing edge (audit 2026-10-22, READ_HIGH_MEDIUM:160): the bridge gives back exactly the height it GREW, so the
    // window stops at its old height PLUS whatever the user dragged it taller by meanwhile -- and measured from the old
    // base that extra read as the panel's: _got stayed above 0, part of the panel stayed on screen with nothing open and
    // the face stayed short. The panel holds what it showed, so the base becomes the height minus that hold; the window's
    // give-back then lands _got on 0. A hold the window never takes back (no bridge, a resize during it) ends after
    // SEQ_CLOSE_SETTLE seconds. The squeeze holds nothing once closed and keeps its base (the grant comes back off it).
    !_bot_on && _seq_on_prev && _seq_base_set ? (
      !_seq_squeeze ? _seq_base_h = gfx_h - _seq_hold_prev;
      _seq_close_t = time_precise();
    );
    _got = _seq_base_set ? max(0, gfx_h - _seq_base_h) : 0;
    _bot_on ? (
      _seq_wait += 1;
      // Immediate where growth is impossible; after twenty frames where the window gave nothing or not all of it
      // (a bridge that does not answer, a screen too short): the pads give the rest.
      (!_cangrow || (_seq_wait > 20 && _got < _cap - 2)) ? _seq_squeeze = 1;
    ) : ( _seq_wait = 0; );
    // 2026-10-27 (the dock's one-to-one; the side slot's twin, rk_swing_ui_minibrowser swing_fb_gate), after the squeeze:
    // with no dock rig up the window is ours and this follows it squeezed or not (_seq_carry_h, the height carried, for
    // the relatch above); with a rig up, a squeezed frame is frozen: the dock's first frames have the canvas in the
    // docker already and slider42 not yet set ("can grow"), and in a docker shorter than the float the shrink read as
    // "the window no longer carries the panel" (tb_test.py D, through the harness).
    _cangrow && (!_seq_squeeze || !swing_dock_rig_up()) ? (
      _seq_carry   = (_bot_on && _got >= _cap - 2) ? 1 : 0;
      _seq_carry_h = _bot_on ? min(_got, _cap) : 0;
    );
    seq_h_cur = _seq_squeeze ? (_bot_on ? _cap : 0) : min(_cap, _got);
    // closed: the hold ends when the window took it back, or when it waited SEQ_CLOSE_SETTLE for that in vain
    !_bot_on && _seq_base_set && (_got < 1 || time_precise() - _seq_close_t > SEQ_CLOSE_SETTLE) ? ( _seq_base_set = 0; _seq_squeeze = 0; seq_h_cur = 0; );
    _seq_hold_prev = seq_h_cur; _seq_on_prev = _bot_on;
    seq_ui_take_win = seq_gut_h + seq_h_cur;
  ) : (
    seq_h_cur = 0;
    !is_embedded ? ( seq_ui_take_win = 0; _seq_hold_prev = 0; _seq_on_prev = 0; );   // the rack face (the user's) holds nothing: no closing edge on the way back
  );
  ui_bot = gfx_h - seq_gut_h - seq_h_cur;

  // ── The mouse claim (S2a, 2026-10-20; the user: "we have some click thru when the step seq is open") ──
  // The gutter and the panel own everything from ui_bot down, the browser strip's way (swing_fb_gate_window):
  // a press, a wheel notch or a right click that lands there is stashed here and ZEROED for the face, whose
  // handlers run between this gate and swing_seq_under_draw -- which hands the stash back to the panel and
  // leaves the rest of the frame with nothing. Before this the panel drew last and read the same globals the
  // face had already acted on, so a click on a step also landed on whatever the face keeps under that pixel.
  // A press that BEGAN here keeps the claim until the button comes up wherever the cursor goes (a cell drag, a
  // value box, the gutter's grab); a press that began on the face is never taken (a knob or a pad swap
  // wandering over the panel: _fb_yield's _grid_gesture_live, and any held button that did not start here).
  // A modal -- an overlay, a big view, a popup -- owns the frame before this gate and the claim stands down.
  // Window passes only: an embed pass in between must not reset the window's own press. Spelled lmbdown /
  // lmbclick because EEL2 names are case-insensitive (the strip's own trap).
  _full ? (
    !LMB ? seq_ui_mouse_own = 0;
    _seq_in = big_view_id == VIEW_NONE && !_ui_modal_up && !swing_popup_active && !_fb_yield
             && mx >= 0 && mx < gfx_w && ((my >= ui_bot && my < gfx_h) || seq_ui_grip_ext(mx, my));   // + the handle's reach above the gutter
    _seq_in && lmb_down ? ( seq_ui_mouse_own = 1; seq_ui_focus = bot_panel == 1 ? 1 : 0; );   // the keys follow a press on the SEQUENCER's panel; one on the browser placed below (bot_panel 2) or on the bare strip gives them up (the swap's audit)
    !_seq_in && lmb_down ? seq_ui_focus = 0;   // a click on the face takes the keys back
    !seq_shown ? seq_ui_focus = 0;
    _seq_claim = seq_ui_mouse_own || (_seq_in && !LMB);   // SEQ MOUSE CLAIM
  ) : ( _seq_claim = 0; );
  _seq_claim ? (
    _seq_g_lmbdown = lmb_down; _seq_g_rmbdown = rmb_down;
    _seq_g_lmbclick = LMB;     _seq_g_rmbclick = RMB;
    _seq_g_wheel = frame_wheel;
    lmb_down = 0; rmb_down = 0; LMB = 0; RMB = 0; frame_wheel = 0;
  ) : (
    _seq_g_lmbdown = 0; _seq_g_rmbdown = 0; _seq_g_lmbclick = 0; _seq_g_rmbclick = 0; _seq_g_wheel = 0;
  );
  // The drawn picker up (the small things round): modal for the whole WINDOW, as the popup it replaced was -- a press, a
  // right press or a wheel notch on the face outside the sequencer's home closes it and is nobody else's (the spec: "a
  // press outside closes it (the press is consumed)"). The home's own share is already stashed (the claim above; the side
  // column's by the browser's gate); the big view has the modal gate's. The picker reads the raw button (and the right
  // press kept here) to close. Only a picker drawn since the last window pass holds the face: one no home draws any more
  // (the side column folded, the panel moved) is closed here instead, so an unseen picker never takes the face's mouse.
  !is_embedded ? (
    seq_ui_pk_lane >= 0 && !seq_ui_pk_seen ? seq_ui_pk_lane = -1;
    seq_ui_pk_seen = 0; seq_ui_pk_rawr = 0;
    seq_ui_pk_lane >= 0 && !_ui_modal_up ? (
      seq_ui_pk_rawr = rmb_down;
      lmb_down = 0; rmb_down = 0; LMB = 0; RMB = 0; frame_wheel = 0;
    );
  );
);

