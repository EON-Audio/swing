      seq_ui_btn(_rb_bx + _rb_bw - swing_px(22), _rb_by, swing_px(22), _rb_bh, ">", 0) && lmb_down ? seq_ui_rbase[_rb_l] = min(128 - _rb_rows, _rb_base + 12);
