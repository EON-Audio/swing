    );
    tw = 0; th = 0; gfx_measurestr(#seq_ui_fit, tw, th); gfx_x = bx + (nw - tw) * 0.5; gfx_y = by2 + (bh2 - th) * 0.5; gfx_drawstr(#seq_ui_fit);
    hov ? (
      pk && strlen(#seq_ui_pname) ? sprintf(#seq_ui_lbl, "%s -- the factory preset in the pattern on screen (%d of %d). Click for the list, by genre, feel and role; the arrows or the wheel step through them. A preset replaces the pattern on screen, aimed at the bank shown (one undo step).", #seq_ui_pname, seq_ui_pidx + 1, seq_ui_pcount)
      : pk ? sprintf(#seq_ui_lbl, "Factory presets (%d): click for the list, by genre, feel and role; the arrows or the wheel step through them. A preset replaces the pattern on screen, aimed at the bank shown (one undo step).", seq_ui_pcount)
      : strcpy(#seq_ui_lbl, "Presets need the Kit Bridge.");
