      gfx_set(0.52, 0.55, 0.60, 1); gfx_rect(_rb_kx + _rb_bkw, _rb_ry + floor(_rb_rp * 0.5), _rb_kw - _rb_bkw, 1);   // the two white keys' seam from under it
    ) : (
