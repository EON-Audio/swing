  _rb_rows = max(12, min(49, floor(_rb_h / swing_px(SEQ_UI_ROLL_ROW_B)))); _rb_rp = _rb_h / _rb_rows;
  _rb_root = _rb_tgt >= 0 && _rb_tgt < NUM_SLOTS ? p_note[_rb_tgt] : 60;
  _rb_base = seq_ui_rbase[_rb_l]; _rb_base < 0 ? _rb_base = _rb_root - floor(_rb_rows / 2);
  _rb_base = max(0, min(128 - _rb_rows, _rb_base | 0)); seq_ui_rbase[_rb_l] = _rb_base;
  seq_ui_roll_y0 = _rb_y; seq_ui_roll_rowp = _rb_rp; seq_ui_roll_base = _rb_base; seq_ui_roll_rows = _rb_rows;
  // the keyboard's strip against the grid; the buttons stacked in the column left of it, as many as the height takes
