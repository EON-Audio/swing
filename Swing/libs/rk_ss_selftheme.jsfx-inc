// rk_ss_selftheme.jsfx-inc -- EON Steppa paints EON / Dark / Light by itself when no Kit Bridge runs.
//
// Steppa's THEME menu only ever REQUESTED a theme (gmem[GS_THEME_REQ]); Swing's Kit Bridge painted it into the theme
// band. Installed without Swing the menu was dead (the Steppa-alone survey, 2026-11-10). Decision D4 of
// Plan_Steppa_First_Release (the owner, 2026-11-06): the free effects' rule -- the first three themes paint without
// a bridge, the other eleven stay listed, greyed "- Swing". Steppa only: no other plugin imports this file.
//
// The method is the free effects' (EON/ReaKit/rk_theme.jsfx-inc, "STANDALONE themes"). ⚠ The free effects live in
// the SAME gmem segment (Swing_Media_Transfer) and paint the SAME band, so Steppa must paint exactly their way or a
// free effect beside it takes Steppa's paint for a bridge (it then lists themes nobody paints and stops serving its
// own picks): the generation is counted in THEIR cell (RKTH_SELF_GEN, 2755: "the generation the self-painter wrote
// last") and written there before GS_THEME_ID. Steppa claims no cell of its own. Two differences remain:
//   - "a bridge is here" also asks the Kit Bridge's heartbeat, and a self-painted generation is told by its size
//     (they start at SSTH_GEN0; a bridge's is a small counter), so a band left by a bridge that has gone still reads
//     as a bridge's until someone repaints it.
//   - nothing is painted until a theme is picked or a saved one comes back: Steppa's built-in look IS the EON look.
// The palette lines below are VERBATIM from that file (which has them from rk_lua_theme.lua T.FIXED);
// .dev_tests/steppa_selftheme_check.py fails when they differ.
//
// Import AFTER libs/rk_theme.jsfx-inc (the GS_THEME_* cells). Host: call ssth_tick() once per @gfx frame; the look
// this instance last saw painted is kept in slider58 (theme 1..3 + 4 * (knob style + 1); 0 = none).

@init

SSTH_N    = 3;            // themes 1..3 (EON, Dark, Light) paint without a bridge
SSTH_WAIT = 4;            // frames a request may sit undrained before we paint it (a live bridge drains it in ~30 ms)
SSTH_GEN0 = 1000000001;   // self-painted generations: odd and large, never a bridge's small monotonic counter
SSTH_KB_ALIVE = 99;       // the Kit Bridge's heartbeat cell (EON_KB_ALIVE in EON_StepSeq.jsfx; 0 = none, or it left)
SSTH_SELF_GEN = 2755;     // == RKTH_SELF_GEN in EON/ReaKit/rk_theme.jsfx-inc: the generation a self-painter wrote last
ssth_applied = 0;         // zeroed here; @init runs before the saved sliders come back
ssth_alone = 0;

function ssth_self_col(t, slot, ch) local(_c) (
  _c =
    t == 1 ? (slot==0?0xD6CFC2:slot==1?0xC2BDB3:slot==2?0x2B2822:slot==3?0x4F4B43:slot==4?0xFF8C32:slot==5?0x4D4D52:0x938A78) :
    t == 2 ? (slot==0?0x1E1E22:slot==1?0x2A2A30:slot==2?0xDDDDE0:slot==3?0x91919A:slot==4?0xFF8C32:slot==5?0x4A4A55:0x414148) :
             (slot==0?0xF0F0F2:slot==1?0xE0E0E5:slot==2?0x222228:slot==3?0x626268:slot==4?0xFF8C32:slot==5?0xC0C0CC:0xC0C0C8);
  (ch == 0 ? floor(_c / 65536) : ch == 1 ? floor(_c / 256) % 256 : _c % 256) / 255;
);
// The EON role hues (drive, gain, freq, shape, dynamics, time), shared by the three.
function ssth_self_role(role, ch) local(_c) (
  _c = role==0?0xFF8C32:role==1?0xC8CED6:role==2?0x4FA3D8:role==3?0x8E7BD6:role==4?0xE0606B:0x4FC08A;
  (ch == 0 ? floor(_c / 65536) : ch == 1 ? floor(_c / 256) % 256 : _c % 256) / 255;
);

// Paint theme t (1..SSTH_N) into the band the way the bridge does: roles and knobs first, colours, CUR, then
// GS_THEME_ID LAST as the handshake.
function ssth_paint(t) local(_i, _g) (
  _i = 0; loop(18, gmem[GS_THEME_ROLE_BASE + _i] = ssth_self_role(floor(_i / 3), _i % 3); _i += 1; );
  _i = 0; loop(24, gmem[GS_THEME_BASE + _i] = ssth_self_col(t, floor(_i / 3), _i % 3); _i += 1; );
  gmem[GS_THEME_KNOB_P] > 0 ? 0 : ( gmem[GS_THEME_KNOB_P] = 1; gmem[GS_THEME_KNOB_S] = 1; );
  gmem[GS_THEME_CUR] = t;
  _g = gmem[SSTH_SELF_GEN]; _g = (_g >= SSTH_GEN0) ? _g + 2 : SSTH_GEN0;
  gmem[SSTH_SELF_GEN] = _g;
  gmem[GS_THEME_ID] = _g;
);

// Every @gfx frame. Alone = no bridge heartbeat AND the band does not carry a bridge's generation. Then:
// a saved look is painted back ONCE after a load; the look the band carries (whichever Steppa painted it) is
// remembered in slider58; a theme or knob request that sat SSTH_WAIT frames is ours to serve. A request for a theme
// past SSTH_N is dropped (its row is greyed).
function ssth_tick() local(_r, _k, _v) (
  ssth_alone = gmem[SSTH_KB_ALIVE] <= 0 && !(gmem[GS_THEME_ID] > 0 && gmem[GS_THEME_ID] < SSTH_GEN0);
  !ssth_alone ? ( ssth_pend = 0; ssth_kpend = 0; ) : (
    !ssth_applied ? (
      ssth_applied = 1;
      _v = slider58 | 0; _r = _v % 4; _k = floor(_v / 4);
      _r >= 1 && _r <= SSTH_N && (gmem[GS_THEME_ID] <= 0 || (gmem[GS_THEME_CUR] | 0) != _r
                                  || (_k >= 1 && (gmem[GS_THEME_KNOB_P] | 0) != _k - 1)) ? (
        _k >= 1 ? ( gmem[GS_THEME_KNOB_P] = _k - 1; gmem[GS_THEME_KNOB_S] = _k - 1; );
        ssth_paint(_r);
      );
    );
    gmem[GS_THEME_ID] >= SSTH_GEN0 ? (
      _v = (gmem[GS_THEME_CUR] | 0) + 4 * ((gmem[GS_THEME_KNOB_P] | 0) + 1);
      _v != (slider58 | 0) ? sliderchange(slider58 = _v);
    );
    _r = gmem[GS_THEME_REQ] | 0;
    _r > 0 ? (
      ssth_pend += 1;
      ssth_pend >= SSTH_WAIT ? (
        _r <= SSTH_N ? ssth_paint(_r);
        gmem[GS_THEME_REQ] = 0; ssth_pend = 0;
      );
    ) : ssth_pend = 0;
    _k = gmem[GS_THEME_KNOB_REQ] | 0;
    _k > 0 ? (
      ssth_kpend += 1;
      ssth_kpend >= SSTH_WAIT ? (
        gmem[GS_THEME_KNOB_P] = _k - 1; gmem[GS_THEME_KNOB_S] = _k - 1;
        // a knob pick with no theme painted yet: paint the one showing (EON), so the band is live and the knob shows
        gmem[GS_THEME_ID] <= 0 ? ssth_paint(1);
        gmem[GS_THEME_KNOB_REQ] = 0; ssth_kpend = 0;
      );
    ) : ssth_kpend = 0;
  );
);
