// knobs_kbsg_p4.jsfx-inc -- part 4 of knobs_kbsg.jsfx-inc (4 parts), cut at a function boundary by
// .dev_tests/split_big_incs.py: REAPER's load time grows with the square of a file's size. Edit freely;
// keep each file under about 40 KB.

// ⚠️ @init IS LOAD-BEARING (.docs/wiki/02-file-structure.md).
@init

function rk_knob_draw(style, cx, cy, radius, value, vmin, vmax, is_sym, hover_t,
                      cr, cg, cb, n_det, bgr, bgg, bgb)
local(_h, _r)
(
  // Hover level, chosen by the host through the global rk_hover_mode. Unset
  // reads 0 in EEL2 and 0 is Normal, so a plugin that never sets it draws as
  // before. 1 = None (the knob rests), 2 = Moderate (the hover value halved,
  // which reads as a softer response: about half for a style that uses it as
  // is, a quarter for one that squares it), 3 = Dramatic (the full response,
  // and the whole knob grows 8%). The hit area stays the caller's radius.
  _h = rk_hover_mode == 1 ? 0 : rk_hover_mode == 2 ? hover_t * 0.5 : hover_t;
  _r = rk_hover_mode == 3 ? radius * (1 + 0.08 * hover_t) : radius;
  // Every style now takes real units; nothing is pre-normalised here any more.
  style == 2  ? varimu_knob_draw(cx, cy, _r, value, vmin, vmax, _h, cr, cg, cb) :
  style == 3  ? api_knob_draw(cx, cy, _r, value, vmin, vmax, is_sym, _h, cr, cg, cb) :
  style == 4  ? ws_knob_draw(cx, cy, _r, value, vmin, vmax, is_sym, _h, cr, cg, cb, bgr, bgg, bgb) :
  style == 5  ? neve_knob_draw(cx, cy, _r, value, vmin, vmax, _h, cr, cg, cb, n_det) :
  style == 6  ? jo_knob_draw(cx, cy, _r, value, vmin, vmax, _h, cr, cg, cb) :
  style == 7  ? mpc_knob_draw(cx, cy, _r, value, vmin, vmax, is_sym, _h, cr, cg, cb, bgr, bgg, bgb) :
  // The jog's arc ring sits at R + 3 .. R + 3 + max(3, 0.14 R) and its hover glow at
  // R + max(3, 0.14 R) + 5, so it gets the radius that puts the glow ON the footprint, as
  // the encoder below gets R / 1.38 (sweep LIB127: the mini pad knobs' rings overlapped).
  // Below 8 px nothing fits; a floor keeps a body to draw.
  style == 8  ? jog_knob_draw(cx, cy, _r >= 29.43 ? (_r - 5) / 1.14 : max(_r * 0.4, _r - 8), value, vmin, vmax, _h, cr, cg, cb) :
  style == 9  ? rainbow_knob_draw(cx, cy, _r, value, vmin, vmax, _h) :
  style == 10 ? sp_knob_draw(cx, cy, _r, value, vmin, vmax, _h, is_sym, cr, cg, cb, bgr, bgg, bgb) :
  style == 12 ? pultec_knob_draw(cx, cy, _r, value, vmin, vmax, _h) :
  style == 13 ? ableton_knob_draw(cx, cy, _r, value, vmin, vmax, is_sym, _h, cr, cg, cb, bgr, bgg, bgb) :
  style == 14 ? fl_knob_draw(cx, cy, _r, value, vmin, vmax, is_sym, _h, cr, cg, cb, bgr, bgg, bgb) :
  style == 15 ? pt_knob_draw(cx, cy, _r, value, vmin, vmax, is_sym, _h, cr, cg, cb, bgr, bgg, bgb) :
  // The encoder's LED collar reaches 1.38 R (its well; the bloom a hair past it), so it
  // gets R / 1.38 here and fills the same footprint as every other style. Direct
  // callers (Swing's FX-overlay send knobs) size it themselves.
  style == 11 ? encoder_draw(cx, cy, _r / 1.38, value, vmin, vmax, _h, cr, cg, cb) :
  style == 16 ? fabfilter_knob_draw(cx, cy, _r, value, vmin, vmax, is_sym, _h, cr, cg, cb, bgr, bgg, bgb) :
  style == 17 ? serum_knob_draw(cx, cy, _r, value, vmin, vmax, is_sym, _h, cr, cg, cb, bgr, bgg, bgb) :
  style == 18 ? roland_knob_draw(cx, cy, _r, value, vmin, vmax, is_sym, _h, cr, cg, cb, bgr, bgg, bgb) :
  style == 19 ? pultec_cream_knob_draw(cx, cy, _r, value, vmin, vmax, _h) :
  style == 20 ? neve_alt_knob_draw(cx, cy, _r, value, vmin, vmax, _h, cr, cg, cb, n_det) :
  style == 21 ? sslg_knob_draw(cx, cy, _r, value, vmin, vmax, is_sym, _h, cr, cg, cb, n_det) :
                ssl_knob_draw(cx, cy, _r, value, vmin, vmax, is_sym, _h, cr, cg, cb, n_det);
);

// Uniform interaction for every style (visual dispatch only — see above).
function rk_knob_interact(style, mem, cx, cy, radius, cur_val, vmin, vmax, vdefault, n_detents) (
  ssl_knob_interact(mem, cx, cy, radius, cur_val, vmin, vmax, vdefault, n_detents);
);
