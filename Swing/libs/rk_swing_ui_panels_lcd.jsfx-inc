// rk_swing_ui_panels_lcd.jsfx-inc
// Swing LCD pages: EQ visualizer, Delay, Reverb, Compressor
// Extracted from rk_swing_ui_panels.jsfx-inc — zero behavioral change
// (c) EON Studios — All Rights Reserved

@init
// ── EQ band palette ── ONE definition, referenced by name everywhere a
// band is drawn. The bands were hand-typed RGB triples in three files, and
// three pairs had drifted into each other: HPF and LO both orange, HI and
// LPF both blue, LO and MID both yellowish. With each band now filling its
// own shape those pairs would smear together, so the colours run in
// FREQUENCY ORDER, low to high like a spectrum, and neighbours never share
// a hue. (Requested 2026-09-21.)
// Defined HERE, at the top level of this file's @init, because the master
// EQ (this file) and the per-pad EQ (rk_swing_ui_grid_overlay_fx) both read
// it. Not in swing_ui_set_colors: that runs in @gfx, every frame.
// ⚠️ EON_Tone.jsfx carries the same values for the master EQ -- keep in step.

EQC_HPF_R = 0.92; EQC_HPF_G = 0.30; EQC_HPF_B = 0.30;   // red
EQC_LO_R = 0.96; EQC_LO_G = 0.60; EQC_LO_B = 0.18;   // orange
EQC_MID_R = 0.38; EQC_MID_G = 0.86; EQC_MID_B = 0.36;   // green
EQC_MID2_R = 0.22; EQC_MID2_G = 0.82; EQC_MID2_B = 0.70;   // teal (per-pad EQ only)
EQC_HI_R = 0.30; EQC_HI_G = 0.66; EQC_HI_B = 0.96;   // blue-cyan
EQC_LPF_R = 0.68; EQC_LPF_G = 0.44; EQC_LPF_B = 0.96;   // violet

// The cached dB the graph shows in pixel column `c` of `cw`, from the cache row
// at `row`. The cache holds MEQ_CV_N log-spaced points whatever the width, so
// this is the one place a point becomes a pixel: when the points outnumber the
// columns each column takes the value FURTHEST from 0 dB among its points (a
// narrow bell keeps its tip; a plain sample at the column's centre would shave
// it), and when the columns outnumber the points it interpolates. Drawing per
// column, not per point, is what keeps a narrow embed from stair-stepping --
// segments a fraction of a pixel long give the antialiasing nothing to work
// with (learned on Apex's mixer-strip embed, 2026-09-21).
// ⚠️ Same as tn_cv_at in EON_Tone.jsfx -- keep in step.
function swing_panels_meq_cv_at(row, c, cw)
  local(t, j, j1, fr, v)
(
  MEQ_CV_N - 1 > cw ? (
    j  = min(floor(c * (MEQ_CV_N - 1) / max(cw - 1, 1)), MEQ_CV_N - 1);
    j1 = min(floor((c + 1) * (MEQ_CV_N - 1) / max(cw - 1, 1)), MEQ_CV_N - 1);
    v  = meq_cv[row + j];
    j += 1;
    while (j <= j1) ( abs(meq_cv[row + j]) > abs(v) ? v = meq_cv[row + j]; j += 1; );
    v;
  ) : (
    t  = c / max(cw - 1, 1) * (MEQ_CV_N - 1);
    j  = floor(t);
    fr = t - j;
    j >= MEQ_CV_N - 1 ? ( j = MEQ_CV_N - 2; fr = 1; );
    meq_cv[row + j] + (meq_cv[row + j + 1] - meq_cv[row + j]) * fr;
  );
);

// One band's fill between two sweep points: every column once, (x0, x1], y
// interpolated along the segment, from the 0 dB line to the band's own curve.
// The column rule is the one that fixed the stripes -- within a band, a column
// painted twice at this alpha would bring them back. Different bands DO share
// columns; that overlap is the point. A band that is off has a flat row, so
// its fill has no height and draws nothing.
// ⚠️ Same rule as tn_band_fill in EON_Tone.jsfx -- keep in step.
function swing_panels_meq_band_fill(x0, y0, x1, y1)
  local(fx, fxe, fdx, fy, fy1, fy2)
(
  fx  = (x0 | 0) + 1;
  fxe = x1 | 0;
  fdx = max(1, x1 - x0);
  loop(max(0, fxe - fx + 1),
    fy  = y0 + (y1 - y0) * (fx - x0) / fdx;
    fy1 = min(_lcd_mid_y, fy);
    fy2 = max(_lcd_mid_y, fy);
    fy2 - fy1 > 0 ? gfx_rect(fx, fy1, 1, fy2 - fy1);
    fx += 1;
  );
);

// A master-EQ node's label: its gain, plus its Q once the Q has been moved
// off its mode's default -- the per-pad EQ's convention, so a Q you scrolled
// is something you can read. Defaults: shelf 1/sqrt(2), bell 0.8.
function swing_panels_meq_node_label(gain, q, qdef) (
  abs(q - qdef) > 0.005 ? sprintf(#_lv, "%+.0f dB Q%.1f", gain, q)
                        : sprintf(#_lv, "%+.0f dB", gain);
);

function swing_panels_draw_eq() (
    // ⚠️ ONE dB SCALE for this graph: _lcd_dbr dB maps to _lcd_yr, the
    // drawable half-height. The curve, its clamp, the node dots, the +/-6 lines
    // AND the node drag all read it. They used to carry their own numbers --
    // curve 14, drag 12, clamp 18 -- and every bug in this graph was two of
    // them disagreeing: the curve ran 29% past the floor (18 vs 14), and a
    // dragged node moved at 86% of the cursor (12 vs 14).
    // 24 is derived, not picked: LO tops out at 500 Hz and HI starts at 2 kHz,
    // so all three bands can never overlap -- at most TWO sum at any frequency,
    // +/-12 each. So the bands' combined curve always fits and nothing audible
    // changed (the band GAIN range is still +/-12). Only a filter's stopband
    // goes deeper, and that flattens along the floor as on any EQ display.
    _lcd_dbr = 24;
    // ── Graph geometry: the knob strip comes OUT of the curve's height ──
    // HPF and LPF used to sit INSIDE the bottom of the graph, so a filter
    // stopband flattening along the floor ran behind them (user-reported
    // 2026-09-21). They now live in a strip below it. The curve, its fill, the
    // node dots, the +/-6 lines, the frequency labels AND the node drag all use
    // _lcd_gh / _lcd_mid_y / _lcd_yr from HERE, computed once, so none of them
    // can disagree about where the graph ends -- that disagreement is what
    // every earlier bug in this graph was. _lcd_mid_y is re-derived over the
    // curve area: every caller sets it fresh before calling, and the big-view
    // callers save and restore it around the call.
    _meq_kr    = 12;
    // The strip must hold the HPF/LPF label as well as the knob, and a 9 px
    // bold label MEASURES 11-12 px, so it is measured rather than guessed: a
    // fixed margin put the label 1-4 px over the divider line below. Every
    // piece of text drawn before the label sets its own font, so measuring
    // here disturbs nothing.
    rk_font(1, 9, 'b');
    gfx_measurestr("HPF", _meq_lw, _meq_lh);
    _lcd_ks    = 2 * _meq_kr + _meq_lh + 6;  // knob + label + 2 px under the line
    _lcd_gh    = max(10, _lcd_ch - _lcd_ks);
    _lcd_mid_y = _lcd_cy + _lcd_gh / 2;
    _lcd_yr    = _lcd_gh / 2 - 4;
    // Shift+click the graph opens the full-size EQ over the pad grid (compact
    // page only; the node hit-test below is guarded !SHIFT so it won't drag).
    big_view_id != VIEW_EQ && lmb_down && SHIFT && mx >= _lcd_cx && mx <= _lcd_cx + _lcd_cw && my >= _lcd_cy && my <= _lcd_cy + _lcd_ch ? (
      swing_bigview_open(VIEW_EQ);
      _ov_lmb_down = 0; _ov_rmb_down = 0; _ov_LMB = 0; _ov_RMB = 0; _ov_wheel = 0;
    );
    // 0dB center line
    gfx_set(lcd_tx_r * 0.3, lcd_tx_g * 0.3, lcd_tx_b * 0.3, 0.5);
    gfx_line(_lcd_cx, _lcd_mid_y, _lcd_cx + _lcd_cw, _lcd_mid_y);
    // ±6dB reference lines
    // The LABEL says 6 dB, so the line goes where 6 dB is on the curve's own
    // scale. (0.25 * _lcd_ch, the original, drew it where 7 dB sits.)
    _lcd_6db = (6 / _lcd_dbr) * _lcd_yr;
    // The graph ends here and the knob strip begins: say so with a line, or the
    // floor of the curve and the top of the knobs read as one space.
    _lcd_ks > 0 ? (
      gfx_set(lcd_tx_r * 0.3, lcd_tx_g * 0.3, lcd_tx_b * 0.3, 0.5);
      gfx_line(_lcd_cx, _lcd_cy + _lcd_gh, _lcd_cx + _lcd_cw, _lcd_cy + _lcd_gh);
    );
    gfx_set(lcd_tx_r * 0.15, lcd_tx_g * 0.15, lcd_tx_b * 0.15, 0.4);
    gfx_line(_lcd_cx, _lcd_mid_y - _lcd_6db, _lcd_cx + _lcd_cw, _lcd_mid_y - _lcd_6db);
    gfx_line(_lcd_cx, _lcd_mid_y + _lcd_6db, _lcd_cx + _lcd_cw, _lcd_mid_y + _lcd_6db);
    // Freq labels
    rk_font(1, 9, 0);
    gfx_set(lcd_tx_r * 0.55, lcd_tx_g * 0.55, lcd_tx_b * 0.55, 0.7);
    _lcd_log_lo = 1.301; _lcd_log_range = 3.0;
    _rf100 = _lcd_cx + (log10(100) - _lcd_log_lo) / _lcd_log_range * _lcd_cw;
    _rf1k  = _lcd_cx + (log10(1000) - _lcd_log_lo) / _lcd_log_range * _lcd_cw;
    _rf10k = _lcd_cx + (log10(10000) - _lcd_log_lo) / _lcd_log_range * _lcd_cw;
    gfx_x = _rf100; gfx_y = _lcd_cy + _lcd_gh - 9; gfx_drawstr("100");
    gfx_x = _rf1k;  gfx_y = _lcd_cy + _lcd_gh - 9; gfx_drawstr("1k");
    gfx_x = _rf10k; gfx_y = _lcd_cy + _lcd_gh - 9; gfx_drawstr("10k");
    // dB labels
    gfx_set(lcd_tx_r * 0.5, lcd_tx_g * 0.5, lcd_tx_b * 0.5, 0.6);
    gfx_x = _lcd_cx + 1; gfx_y = _lcd_mid_y - _lcd_6db - 4; gfx_drawstr("+6");
    gfx_x = _lcd_cx + 1; gfx_y = _lcd_mid_y + _lcd_6db - 4; gfx_drawstr("-6");

    // ── Process EQ node drags BEFORE drawing curve (avoid 1-frame lag) ──
    active_id == 230 ? ( LMB ? (
      // Clamp mouse to graph area
      _cmx = max(_lcd_cx, min(_lcd_cx + _lcd_cw, mx));
      _cmy = max(_lcd_cy, min(_lcd_cy + _lcd_gh, my));
      gfx_eq_lo = max(-12, min(12, meq_drag_val_lo - (_cmy - meq_drag_my) / _lcd_yr * _lcd_dbr));
      // Delta-based freq in log space
      _dx = _cmx - meq_drag_mx;
      _logf = log10(meq_drag_freq_lo) + (_dx / _lcd_cw) * _lcd_log_range;
      gfx_eq_lo_freq = max(40, min(500, pow(10, _logf)));
      recalc_master_eq(); mark_dirty_kit();
    ) : active_id = -1; );
    active_id == 231 ? ( LMB ? (
      _cmx = max(_lcd_cx, min(_lcd_cx + _lcd_cw, mx));
      _cmy = max(_lcd_cy, min(_lcd_cy + _lcd_gh, my));
      gfx_eq_mid = max(-12, min(12, meq_drag_val_md - (_cmy - meq_drag_my) / _lcd_yr * _lcd_dbr));
      _dx = _cmx - meq_drag_mx;
      _logf = log10(meq_drag_freq_md) + (_dx / _lcd_cw) * _lcd_log_range;
      gfx_eq_mid_freq = max(200, min(8000, pow(10, _logf)));
      recalc_master_eq(); mark_dirty_kit();
    ) : active_id = -1; );
    active_id == 232 ? ( LMB ? (
      _cmx = max(_lcd_cx, min(_lcd_cx + _lcd_cw, mx));
      _cmy = max(_lcd_cy, min(_lcd_cy + _lcd_gh, my));
      gfx_eq_hi = max(-12, min(12, meq_drag_val_hi - (_cmy - meq_drag_my) / _lcd_yr * _lcd_dbr));
      _dx = _cmx - meq_drag_mx;
      _logf = log10(meq_drag_freq_hi) + (_dx / _lcd_cw) * _lcd_log_range;
      gfx_eq_hi_freq = max(2000, min(16000, pow(10, _logf)));
      recalc_master_eq(); mark_dirty_kit();
    ) : active_id = -1; );

    // Draw combined frequency response curve
    // Phase 4 (D O-2, 2026-09-15): the MEQ_CV_N-point sweep, the three node magnitudes
    // and the three node abscissae are cached in meq_cv against the sixteen values they
    // depend on (the Drum Strip's EQ-graph cache is the model). A page left open costs
    // sixteen compares per frame; the sweep's ~18k transcendentals run only when a band,
    // a Q, a bell flag or the rate moves. The sweep's frequencies are fixed (log points,
    // 20 Hz - 20 kHz), so the cache is width-independent and the compact page and the
    // big view share it; swing_panels_meq_cv_at turns it into pixel columns.
    _lcd_prev_x = -1; _lcd_prev_y = -1;
    (!meq_cv_valid || meq_cv_p0 != gfx_hpf_freq || meq_cv_p1 != gfx_lpf_freq
     || meq_cv_p2 != gfx_eq_lo || meq_cv_p3 != gfx_eq_lo_freq || meq_cv_p4 != meq_lo_bell
     || meq_cv_p5 != gfx_eq_mid || meq_cv_p6 != gfx_eq_mid_freq
     || meq_cv_p7 != gfx_eq_hi || meq_cv_p8 != gfx_eq_hi_freq || meq_cv_p9 != meq_hi_bell
     // Q (ser_ver 75) is part of the curve, so it is part of the KEY -- miss it
     // here, or in the store below, and turning Q would never redraw the graph.
     || meq_cv_pq0 != gfx_eq_lo_sq || meq_cv_pq1 != gfx_eq_lo_bq || meq_cv_pq2 != gfx_eq_mid_q
     || meq_cv_pq3 != gfx_eq_hi_sq || meq_cv_pq4 != gfx_eq_hi_bq
     || meq_cv_sr != srate) ? (
      // ⚠️ SNAPSHOT FIRST. The key is taken HERE, before any coefficient, and the
      // whole rebuild below reads the snapshot, never the live values. Those
      // live values are also written off this thread: the Tone link receiver
      // runs in @block, and @serialize restores them. When the key was stored
      // AFTER the sweep, a value that changed mid-sweep went into the key while
      // the curve still held the old one, the key then matched, and the graph
      // kept a stale curve until the next edit (Codex pack 7). Now the curve and
      // its key are the same numbers by construction, and a change that lands
      // mid-sweep fails the key compare next frame and rebuilds.
      meq_cv_p0 = gfx_hpf_freq; meq_cv_p1 = gfx_lpf_freq;
      meq_cv_p2 = gfx_eq_lo; meq_cv_p3 = gfx_eq_lo_freq; meq_cv_p4 = meq_lo_bell;
      meq_cv_p5 = gfx_eq_mid; meq_cv_p6 = gfx_eq_mid_freq;
      meq_cv_p7 = gfx_eq_hi; meq_cv_p8 = gfx_eq_hi_freq; meq_cv_p9 = meq_hi_bell;
      meq_cv_pq0 = gfx_eq_lo_sq; meq_cv_pq1 = gfx_eq_lo_bq; meq_cv_pq2 = gfx_eq_mid_q;
      meq_cv_pq3 = gfx_eq_hi_sq; meq_cv_pq4 = gfx_eq_hi_bq;
      meq_cv_sr = srate;

      // Pre-compute all biquad coefficients ONCE (not once per point)
      // HPF coefficients
      _cv_hpf_on = meq_cv_p0 > 25;
      _cv_hpf_on ? (
        bq_calc_highpass(meq_cv_p0, 0.707);
        _hpf_b0 = _tb0; _hpf_b1 = _tb1; _hpf_b2 = _tb2;
        _hpf_a1 = _ta1; _hpf_a2 = _ta2;
      );
      // LPF coefficients
      _cv_lpf_on = meq_cv_p1 < 19500;
      _cv_lpf_on ? (
        bq_calc_lowpass(meq_cv_p1, 0.707);
        _lpf_b0 = _tb0; _lpf_b1 = _tb1; _lpf_b2 = _tb2;
        _lpf_a1 = _ta1; _lpf_a2 = _ta2;
      );
      // Lo band coefficients — NO ternary, fully flat if-blocks
      _cv_lo_on = meq_cv_p2 != 0;
      _lo_use_shelf = _cv_lo_on && (meq_cv_p4 == 0);
      _lo_use_bell  = _cv_lo_on && (meq_cv_p4 != 0);
      _lo_use_shelf ? (
        bq_calc_lowshelf_q(meq_cv_p3, meq_cv_p2, meq_cv_pq0);
        _lo_b0 = _tb0; _lo_b1 = _tb1; _lo_b2 = _tb2;
        _lo_a1 = _ta1; _lo_a2 = _ta2;
      );
      _lo_use_bell ? (
        bq_calc_peaking(meq_cv_p3, meq_cv_p2, meq_cv_pq1);
        _lo_b0 = _tb0; _lo_b1 = _tb1; _lo_b2 = _tb2;
        _lo_a1 = _ta1; _lo_a2 = _ta2;
      );
      // Mid band coefficients
      _cv_md_on = meq_cv_p5 != 0;
      _cv_md_on ? (
        bq_calc_peaking(meq_cv_p6, meq_cv_p5, meq_cv_pq2);
        _md_b0 = _tb0; _md_b1 = _tb1; _md_b2 = _tb2;
        _md_a1 = _ta1; _md_a2 = _ta2;
      );
      // Hi band coefficients — NO ternary, fully flat if-blocks
      _cv_hi_on = meq_cv_p7 != 0;
      _hi_use_shelf = _cv_hi_on && (meq_cv_p9 == 0);
      _hi_use_bell  = _cv_hi_on && (meq_cv_p9 != 0);
      _hi_use_shelf ? (
        bq_calc_highshelf_q(meq_cv_p8, meq_cv_p7, meq_cv_pq3);
        _hi_b0 = _tb0; _hi_b1 = _tb1; _hi_b2 = _tb2;
        _hi_a1 = _ta1; _hi_a2 = _ta2;
      );
      _hi_use_bell ? (
        bq_calc_peaking(meq_cv_p8, meq_cv_p7, meq_cv_pq4);
        _hi_b0 = _tb0; _hi_b1 = _tb1; _hi_b2 = _tb2;
        _hi_a1 = _ta1; _hi_a2 = _ta2;
      );

      // Sweep MEQ_CV_N frequency points into the cache (magnitudes only)
      _lcd_px = 0;
      loop(MEQ_CV_N,
        _lcd_f = pow(10, _lcd_log_lo + (_lcd_px / (MEQ_CV_N - 1)) * _lcd_log_range);
        _lcd_f = min(20000, _lcd_f);
        // Each band's OWN response, kept apart so it can fill its own shape in
        // its own colour. The combined curve is their sum, exactly as before.
        _bd_hp = _cv_hpf_on ? bq_mag_db(_lcd_f, _hpf_b0, _hpf_b1, _hpf_b2, _hpf_a1, _hpf_a2) : 0;
        _bd_lp = _cv_lpf_on ? bq_mag_db(_lcd_f, _lpf_b0, _lpf_b1, _lpf_b2, _lpf_a1, _lpf_a2) : 0;
        _bd_lo = _cv_lo_on  ? bq_mag_db(_lcd_f, _lo_b0, _lo_b1, _lo_b2, _lo_a1, _lo_a2) : 0;
        _bd_md = _cv_md_on  ? bq_mag_db(_lcd_f, _md_b0, _md_b1, _md_b2, _md_a1, _md_a2) : 0;
        _bd_hi = _cv_hi_on  ? bq_mag_db(_lcd_f, _hi_b0, _hi_b1, _hi_b2, _hi_a1, _hi_a2) : 0;
        meq_cv[MEQ_CV_SUM + _lcd_px] = max(-_lcd_dbr, min(_lcd_dbr, _bd_hp + _bd_lp + _bd_lo + _bd_md + _bd_hi));
        // ...and each band's own curve, for its own fill: rows of MEQ_CV_N from
        // MEQ_CV_BANDS. Same validity key as the combined curve above -- they
        // depend on exactly the same settings.
        meq_cv[MEQ_CV_BANDS +                _lcd_px] = max(-_lcd_dbr, min(_lcd_dbr, _bd_hp));
        meq_cv[MEQ_CV_BANDS +     MEQ_CV_N + _lcd_px] = max(-_lcd_dbr, min(_lcd_dbr, _bd_lp));
        meq_cv[MEQ_CV_BANDS + 2 * MEQ_CV_N + _lcd_px] = max(-_lcd_dbr, min(_lcd_dbr, _bd_lo));
        meq_cv[MEQ_CV_BANDS + 3 * MEQ_CV_N + _lcd_px] = max(-_lcd_dbr, min(_lcd_dbr, _bd_md));
        meq_cv[MEQ_CV_BANDS + 4 * MEQ_CV_N + _lcd_px] = max(-_lcd_dbr, min(_lcd_dbr, _bd_hi));
        _lcd_px += 1;
      );
      // Node magnitudes at the band frequencies (0 dB when a band is off: the node sits on
      // the centre line) and the node abscissae in log space (the layout scales them per frame)
      meq_cv[80] = _cv_lo_on ? max(-_lcd_dbr, min(_lcd_dbr, bq_mag_db(meq_cv_p3, _lo_b0, _lo_b1, _lo_b2, _lo_a1, _lo_a2))) : 0;
      meq_cv[81] = _cv_md_on ? max(-_lcd_dbr, min(_lcd_dbr, bq_mag_db(meq_cv_p6, _md_b0, _md_b1, _md_b2, _md_a1, _md_a2))) : 0;
      meq_cv[82] = _cv_hi_on ? max(-_lcd_dbr, min(_lcd_dbr, bq_mag_db(meq_cv_p8, _hi_b0, _hi_b1, _hi_b2, _hi_a1, _hi_a2))) : 0;
      meq_cv[83] = log10(meq_cv_p3); meq_cv[84] = log10(meq_cv_p6); meq_cv[85] = log10(meq_cv_p8);
      meq_cv_valid = 1;
    );

    // Draw the cached curve, one pixel column at a time (see swing_panels_meq_cv_at)
    _lcd_ncol = max(2, floor(_lcd_cw));
    _lcd_px = 0;
    loop(_lcd_ncol,
      _lcd_cur_x = _lcd_cx + _lcd_px;
      _lcd_db    = swing_panels_meq_cv_at(MEQ_CV_SUM, _lcd_px, _lcd_ncol);
      _lcd_cur_y = _lcd_mid_y - (_lcd_db / _lcd_dbr) * _lcd_yr;
      _by_hp = _lcd_mid_y - (swing_panels_meq_cv_at(MEQ_CV_BANDS,                _lcd_px, _lcd_ncol) / _lcd_dbr) * _lcd_yr;
      _by_lp = _lcd_mid_y - (swing_panels_meq_cv_at(MEQ_CV_BANDS +     MEQ_CV_N, _lcd_px, _lcd_ncol) / _lcd_dbr) * _lcd_yr;
      _by_lo = _lcd_mid_y - (swing_panels_meq_cv_at(MEQ_CV_BANDS + 2 * MEQ_CV_N, _lcd_px, _lcd_ncol) / _lcd_dbr) * _lcd_yr;
      _by_md = _lcd_mid_y - (swing_panels_meq_cv_at(MEQ_CV_BANDS + 3 * MEQ_CV_N, _lcd_px, _lcd_ncol) / _lcd_dbr) * _lcd_yr;
      _by_hi = _lcd_mid_y - (swing_panels_meq_cv_at(MEQ_CV_BANDS + 4 * MEQ_CV_N, _lcd_px, _lcd_ncol) / _lcd_dbr) * _lcd_yr;

      _lcd_prev_x >= 0 ? (
        // Each band fills its own shape, from the 0 dB line to its own curve, in
        // a shade of its own colour. They replace the single grey fill under the
        // combined curve (requested 2026-09-21); where two bands overlap they
        // layer translucently, the way Pro-Q draws them. The combined curve is
        // still the white line drawn over them all. Dimmer when bypassed.
        _meq_ba = meq_bypass ? 0.07 : 0.20;
        gfx_set(EQC_HPF_R, EQC_HPF_G, EQC_HPF_B, _meq_ba); swing_panels_meq_band_fill(_lcd_prev_x, _pby_hp, _lcd_cur_x, _by_hp);
        gfx_set(EQC_LPF_R, EQC_LPF_G, EQC_LPF_B, _meq_ba); swing_panels_meq_band_fill(_lcd_prev_x, _pby_lp, _lcd_cur_x, _by_lp);
        gfx_set(EQC_LO_R,  EQC_LO_G,  EQC_LO_B,  _meq_ba); swing_panels_meq_band_fill(_lcd_prev_x, _pby_lo, _lcd_cur_x, _by_lo);
        gfx_set(EQC_MID_R, EQC_MID_G, EQC_MID_B, _meq_ba); swing_panels_meq_band_fill(_lcd_prev_x, _pby_md, _lcd_cur_x, _by_md);
        gfx_set(EQC_HI_R,  EQC_HI_G,  EQC_HI_B,  _meq_ba); swing_panels_meq_band_fill(_lcd_prev_x, _pby_hi, _lcd_cur_x, _by_hi);
        // Combined line
        gfx_set(lcd_tx_r, lcd_tx_g, lcd_tx_b, 0.85);
        gfx_line(_lcd_prev_x, _lcd_prev_y, _lcd_cur_x, _lcd_cur_y);
      );
      _lcd_prev_x = _lcd_cur_x;
      _lcd_prev_y = _lcd_cur_y;
      _pby_hp = _by_hp; _pby_lp = _by_lp; _pby_lo = _by_lo; _pby_md = _by_md; _pby_hi = _by_hi;
      _lcd_px += 1;
    );

    // Draggable EQ nodes (larger in LCD, with frequency+gain X+Y drag)
    _lcd_nr = 6;
    // Node positions: X from frequency (log scale, cached), Y from the cached biquad magnitude.
    // Nodes sit ON the curve line -- for shelves the turnover freq shows ~half the set gain (correct)
    _lcd_lo_nx = _lcd_cx + (meq_cv[83] - _lcd_log_lo) / _lcd_log_range * _lcd_cw;
    _lcd_md_nx = _lcd_cx + (meq_cv[84] - _lcd_log_lo) / _lcd_log_range * _lcd_cw;
    _lcd_hi_nx = _lcd_cx + (meq_cv[85] - _lcd_log_lo) / _lcd_log_range * _lcd_cw;
    _lcd_lo_ny = _lcd_mid_y - (meq_cv[80] / _lcd_dbr) * _lcd_yr;
    _lcd_md_ny = _lcd_mid_y - (meq_cv[81] / _lcd_dbr) * _lcd_yr;
    _lcd_hi_ny = _lcd_mid_y - (meq_cv[82] / _lcd_dbr) * _lcd_yr;

    // Node circles
    gfx_set(EQC_LO_R, EQC_LO_G, EQC_LO_B, 1); gfx_circle(_lcd_lo_nx, _lcd_lo_ny, _lcd_nr, 1);
    gfx_set(0, 0, 0, 0.4); gfx_circle(_lcd_lo_nx, _lcd_lo_ny, _lcd_nr, 0);
    gfx_set(EQC_MID_R, EQC_MID_G, EQC_MID_B, 1); gfx_circle(_lcd_md_nx, _lcd_md_ny, _lcd_nr, 1);
    gfx_set(0, 0, 0, 0.4); gfx_circle(_lcd_md_nx, _lcd_md_ny, _lcd_nr, 0);
    gfx_set(EQC_HI_R, EQC_HI_G, EQC_HI_B, 1); gfx_circle(_lcd_hi_nx, _lcd_hi_ny, _lcd_nr, 1);
    gfx_set(0, 0, 0, 0.4); gfx_circle(_lcd_hi_nx, _lcd_hi_ny, _lcd_nr, 0);

    // Node hover tooltips — independent of click state
    dist(mx, my, _lcd_lo_nx, _lcd_lo_ny) <= _lcd_nr + 5 ? swing_tooltip_check(1100, "Low band EQ node — drag Y for gain (-12 to +12 dB), drag X for frequency (40-500 Hz). Double-click to reset.");
    dist(mx, my, _lcd_md_nx, _lcd_md_ny) <= _lcd_nr + 5 ? swing_tooltip_check(1103, "Mid band EQ node — drag Y for gain (-12 to +12 dB), drag X for frequency (200-8000 Hz). Double-click to reset.");
    dist(mx, my, _lcd_hi_nx, _lcd_hi_ny) <= _lcd_nr + 5 ? swing_tooltip_check(1105, "High band EQ node — drag Y for gain (-12 to +12 dB), drag X for frequency (2-16 kHz). Double-click to reset.");

    // ── Wheel over a node: that band's Q (ser_ver 75) ────────────────
    // The per-pad EQ's rule VERBATIM (rk_swing_ui_grid_overlay_fx), so the
    // wheel feels the same on every EQ in Swing: 12% a notch, 3% with SHIFT,
    // clamped 0.3..6. LO and HI change the Q of whichever MODE they are in --
    // shelf or bell each keep their own. Placed after the nodes are laid out
    // and BEFORE the hit-test and the knobs, and the notch is consumed, so the
    // same notch cannot also turn a knob. Not while a node is being dragged.
    // !_srf_foreign: Swing has foreign passes too when embedded twice, and a
    // second embed is handed the owner's pointer. 0 on any other surface.
    frame_wheel != 0 && active_id == -1 && !_srf_foreign ? (
      _meq_wq = dist(mx, my, _lcd_md_nx, _lcd_md_ny) <= _lcd_nr + 4 ? 2 :
            dist(mx, my, _lcd_lo_nx, _lcd_lo_ny) <= _lcd_nr + 4 ? 1 :
            dist(mx, my, _lcd_hi_nx, _lcd_hi_ny) <= _lcd_nr + 4 ? 3 : 0;
      _meq_wq ? (
        _meq_wf = 1 + frame_wheel * (SHIFT ? 0.03 : 0.12);
        // Explicit parenthesised branches, house style for reading; a bare
        // `c ? a = x : b = y` would work too (wiki 01: assignments in ternary
        // branches work).
        _meq_wq == 1 ? (
          meq_lo_bell ? ( gfx_eq_lo_bq = max(0.3, min(6, gfx_eq_lo_bq * _meq_wf)); )
                      : ( gfx_eq_lo_sq = max(0.3, min(6, gfx_eq_lo_sq * _meq_wf)); );
        ) : _meq_wq == 2 ? (
          gfx_eq_mid_q = max(0.3, min(6, gfx_eq_mid_q * _meq_wf));
        ) : (
          meq_hi_bell ? ( gfx_eq_hi_bq = max(0.3, min(6, gfx_eq_hi_bq * _meq_wf)); )
                      : ( gfx_eq_hi_sq = max(0.3, min(6, gfx_eq_hi_sq * _meq_wf)); );
        );
        recalc_master_eq(); mark_dirty_kit();   // same commit as a node drag
        frame_wheel = 0; mouse_wheel = 0;
      );
    );

    // Node hit detect (BEFORE knobs so EQ nodes get click priority over HPF/LPF knobs)
    active_id == -1 && lmb_down && !SHIFT && mx >= _lcd_cx && mx <= _lcd_cx + _lcd_cw && my >= _lcd_cy && my <= _lcd_cy + _lcd_gh ? (
      meq_drag_my = my; meq_drag_mx = mx;
      _hit_node = -1;
      dist(mx, my, _lcd_lo_nx, _lcd_lo_ny) <= _lcd_nr + 5 ? ( _hit_node = 230; meq_drag_val_lo = gfx_eq_lo; meq_drag_freq_lo = gfx_eq_lo_freq; ) :
      dist(mx, my, _lcd_md_nx, _lcd_md_ny) <= _lcd_nr + 5 ? ( _hit_node = 231; meq_drag_val_md = gfx_eq_mid; meq_drag_freq_md = gfx_eq_mid_freq; ) :
      dist(mx, my, _lcd_hi_nx, _lcd_hi_ny) <= _lcd_nr + 5 ? ( _hit_node = 232; meq_drag_val_hi = gfx_eq_hi; meq_drag_freq_hi = gfx_eq_hi_freq; );

      _hit_node >= 0 ? (
        _eq_now = time_precise();
        _dbl_click_id == _hit_node && (_eq_now - _dbl_click_time) < DBL_CLICK_T ? (
          // Double-click: reset gain to 0 dB and freq to default
          _hit_node == 230 ? ( gfx_eq_lo = 0; gfx_eq_lo_freq = 200; ) :
          _hit_node == 231 ? ( gfx_eq_mid = 0; gfx_eq_mid_freq = 1000; ) :
          ( gfx_eq_hi = 0; gfx_eq_hi_freq = 5000; );
          recalc_master_eq(); mark_dirty_kit();
          _dbl_click_id = -1;
          // Don't set active_id — suppress drag on double-click
        ) : (
          active_id = _hit_node;
          _dbl_click_id = _hit_node; _dbl_click_time = _eq_now;
        );
      );
    );

    // ── HPF / LPF knobs (the strip's two ends, under the EQ graph) ──
    _meq_hpf_cx = _lcd_cx + _meq_kr + 4;
    _meq_hpf_cy = _lcd_cy + _lcd_ch - _meq_kr - 3;
    _meq_lpf_cx = _lcd_cx + _lcd_cw - _meq_kr - 4;
    _meq_lpf_cy = _meq_hpf_cy;

    // HPF knob interact + draw (skip interaction when EQ node is being dragged)
    // Use log-space mapping so low frequencies get fine resolution (avoids jumps)
    _lcd_hpf_active = gfx_hpf_freq > 25;
    active_id < 230 || active_id > 232 ? (
      _hpf_log = log10(max(20, gfx_hpf_freq));
      _hpf_log_nv = mpc_knob_interact(km_gfx_hpf, _meq_hpf_cx, _meq_hpf_cy, _meq_kr, _hpf_log, log10(20), log10(8000), log10(20), 0);
      _hpf_log_nv != _hpf_log ? (
        gfx_hpf_freq = pow(10, _hpf_log_nv);
        gfx_hpf_freq <= 25 ? gfx_hpf_freq = 20;
        mark_dirty_kit();
      );
    );
    mpc_knob_draw(_meq_hpf_cx, _meq_hpf_cy, _meq_kr, log10(max(20, gfx_hpf_freq)), log10(20), log10(8000), 0, km_gfx_hpf[0],
      _lcd_hpf_active ? 0.85 : 0.40, _lcd_hpf_active ? 0.35 : 0.38, _lcd_hpf_active ? 0.20 : 0.40,
      0.08, 0.08, 0.10);
    dist(mx, my, _meq_hpf_cx, _meq_hpf_cy) <= _meq_kr + 4 ? swing_tooltip_check(1108, "Master HPF (high-pass filter, 20-8000 Hz, log). Removes low-end rumble before EQ. OFF at minimum.");
    // HPF label + value
    rk_font(1, 9, 'b');
    gfx_set(EQC_HPF_R, EQC_HPF_G, EQC_HPF_B, _lcd_hpf_active ? 0.9 : 0.5);
    gfx_measurestr("HPF",tw,th);
    gfx_x = _meq_hpf_cx - tw/2; gfx_y = _meq_hpf_cy - _meq_kr - th - 1; gfx_drawstr("HPF");
    _lcd_hpf_active ? (
      gfx_hpf_freq >= 1000 ? sprintf(#_lv,"%.1fk",gfx_hpf_freq/1000) : sprintf(#_lv,"%.0f",gfx_hpf_freq);
    ) : strcpy(#_lv, "OFF");
    // The values are regular: a bold 9 px "5" draws as a "6" (wiki 4.7). The
    // HPF / LPF labels stay bold.
    rk_font(1, 9, 0);
    gfx_set(1, 1, 1, _lcd_hpf_active ? 0.9 : 0.5);
    gfx_measurestr(#_lv,tw,th);
    gfx_x = _meq_hpf_cx - tw/2; gfx_y = _meq_hpf_cy - th/2; gfx_drawstr(#_lv);

    // LPF knob interact + draw (skip interaction when EQ node is being dragged)
    // Use log-space mapping (same as HPF)
    _lcd_lpf_active = gfx_lpf_freq < 19500;
    active_id < 230 || active_id > 232 ? (
      _lpf_log = log10(max(200, gfx_lpf_freq));
      _lpf_log_nv = mpc_knob_interact(km_gfx_lpf, _meq_lpf_cx, _meq_lpf_cy, _meq_kr, _lpf_log, log10(200), log10(20000), log10(20000), 0);
      _lpf_log_nv != _lpf_log ? (
        gfx_lpf_freq = pow(10, _lpf_log_nv);
        gfx_lpf_freq >= 19500 ? gfx_lpf_freq = 20000;
        mark_dirty_kit();
      );
    );
    mpc_knob_draw(_meq_lpf_cx, _meq_lpf_cy, _meq_kr, log10(max(200, gfx_lpf_freq)), log10(200), log10(20000), 0, km_gfx_lpf[0],
      _lcd_lpf_active ? 0.20 : 0.40, _lcd_lpf_active ? 0.55 : 0.38, _lcd_lpf_active ? 0.85 : 0.40,
      0.08, 0.08, 0.10);
    dist(mx, my, _meq_lpf_cx, _meq_lpf_cy) <= _meq_kr + 4 ? swing_tooltip_check(1109, "Master LPF (low-pass filter, 200-20000 Hz, log). Tames high frequencies after EQ. OFF at maximum.");
    // LPF label + value
    rk_font(1, 9, 'b');
    gfx_set(EQC_LPF_R, EQC_LPF_G, EQC_LPF_B, _lcd_lpf_active ? 0.9 : 0.5);
    gfx_measurestr("LPF",tw,th);
    gfx_x = _meq_lpf_cx - tw/2; gfx_y = _meq_lpf_cy - _meq_kr - th - 1; gfx_drawstr("LPF");
    _lcd_lpf_active ? (
      gfx_lpf_freq >= 1000 ? sprintf(#_lv,"%.1fk",gfx_lpf_freq/1000) : sprintf(#_lv,"%.0f",gfx_lpf_freq);
    ) : strcpy(#_lv, "OFF");
    rk_font(1, 9, 0);
    gfx_set(1, 1, 1, _lcd_lpf_active ? 0.9 : 0.5);
    gfx_measurestr(#_lv,tw,th);
    gfx_x = _meq_lpf_cx - tw/2; gfx_y = _meq_lpf_cy - th/2; gfx_drawstr(#_lv);

    // dB + Hz labels on nodes (numbers: regular, wiki 4.7)
    rk_font(1, 9, 0);
    gfx_eq_lo != 0 ? (
      gfx_set(EQC_LO_R, EQC_LO_G, EQC_LO_B, 1); swing_panels_meq_node_label(gfx_eq_lo, meq_lo_bell ? gfx_eq_lo_bq : gfx_eq_lo_sq, meq_lo_bell ? 0.8 : sqrt(0.5));
      gfx_measurestr(#_lv,tw,th);
      gfx_x = _lcd_lo_nx - tw/2; gfx_y = _lcd_lo_ny < _lcd_mid_y ? _lcd_lo_ny - th - 2 : _lcd_lo_ny + _lcd_nr + 1;
      gfx_drawstr(#_lv);
    );
    gfx_eq_mid != 0 ? (
      gfx_set(EQC_MID_R, EQC_MID_G, EQC_MID_B, 1); swing_panels_meq_node_label(gfx_eq_mid, gfx_eq_mid_q, 0.8);
      gfx_measurestr(#_lv,tw,th);
      gfx_x = _lcd_md_nx - tw/2; gfx_y = _lcd_md_ny < _lcd_mid_y ? _lcd_md_ny - th - 2 : _lcd_md_ny + _lcd_nr + 1;
      gfx_drawstr(#_lv);
    );
    gfx_eq_hi != 0 ? (
      gfx_set(EQC_HI_R, EQC_HI_G, EQC_HI_B, 1); swing_panels_meq_node_label(gfx_eq_hi, meq_hi_bell ? gfx_eq_hi_bq : gfx_eq_hi_sq, meq_hi_bell ? 0.8 : sqrt(0.5));
      gfx_measurestr(#_lv,tw,th);
      gfx_x = _lcd_hi_nx - tw/2; gfx_y = _lcd_hi_ny < _lcd_mid_y ? _lcd_hi_ny - th - 2 : _lcd_hi_ny + _lcd_nr + 1;
      gfx_drawstr(#_lv);
    );

    // (Node drag moved before curve drawing — IDs 230-232 processed above)
    // (Node hit detect moved before knobs — see above)
    // (HPF/LPF are now knobs — IDs 233/234 no longer used)

    // "MASTER EQ" label + BYPASS pill
    rk_font(1, 8, 'b');
    gfx_set(lcd_tx_r * 0.5, lcd_tx_g * 0.5, lcd_tx_b * 0.5, 0.6);
    gfx_x = _lcd_cx + 2; gfx_y = _lcd_cy;
    meq_bypass ? gfx_drawstr("MASTER EQ [BYP]") : gfx_drawstr("MASTER EQ");
    // Bypass clickable pill
    rk_font(1, 9, 'b');
    _byp_w = 22; _byp_h = 10;
    _byp_x = _lcd_cx + _lcd_cw - 28 * 2 - 8 - _byp_w - 4;
    _byp_y = _lcd_cy + 1;
    meq_bypass ? gfx_set(btn_red_r, btn_red_g, btn_red_b, 0.8) : gfx_set(0.30, 0.65, 0.35, 0.5);
    gfx_rect(_byp_x, _byp_y, _byp_w, _byp_h);
    gfx_set(1, 1, 1, 0.9);
    meq_bypass ? strcpy(#_byp, "BYP") : strcpy(#_byp, "ON");
    gfx_measurestr(#_byp, tw, th);
    gfx_x = _byp_x + (_byp_w - tw) / 2; gfx_y = _byp_y + (_byp_h - th) / 2;
    gfx_drawstr(#_byp);
    mx >= _byp_x && mx <= _byp_x + _byp_w && my >= _byp_y && my <= _byp_y + _byp_h ? swing_tooltip_check(1110, "Bypass the entire master EQ section.");
    // The three pills take a PLAIN click that no node took this frame: a Shift+click opens the big
    // view (above) and used to toggle a pill too, and a node whose hit circle reaches a pill
    // started its drag and flipped the pill in the same frame (sweep LIB137).
    lmb_down && !SHIFT && active_id == -1 && mx >= _byp_x && mx <= _byp_x + _byp_w && my >= _byp_y && my <= _byp_y + _byp_h ? (
      meq_bypass = !meq_bypass; mark_dirty_kit();
    );

    // ── Shelf / Bell toggle pills for Lo and Hi bands ──
    rk_font(1, 9, 'b');
    // Lo band toggle (near gold node label area, top-right of graph)
    _tgl_w = 28; _tgl_h = 10;
    _tgl_lo_x = _lcd_cx + _lcd_cw - _tgl_w * 2 - 8;
    _tgl_lo_y = _lcd_cy + 1;
    meq_lo_bell ? strcpy(#_tgl_lo, "BELL") : strcpy(#_tgl_lo, "SHELF");
    gfx_set(EQC_LO_R, EQC_LO_G, EQC_LO_B, meq_lo_bell ? 0.7 : 0.35);
    gfx_rect(_tgl_lo_x, _tgl_lo_y, _tgl_w, _tgl_h);
    gfx_set(0, 0, 0, 0.9);
    gfx_measurestr(#_tgl_lo, tw, th);
    gfx_x = _tgl_lo_x + (_tgl_w - tw) / 2; gfx_y = _tgl_lo_y + (_tgl_h - th) / 2;
    gfx_drawstr(#_tgl_lo);
    mx >= _tgl_lo_x && mx <= _tgl_lo_x + _tgl_w && my >= _tgl_lo_y && my <= _tgl_lo_y + _tgl_h ? swing_tooltip_check(1102, "Low band shape — SHELF boosts/cuts everything below the freq; BELL peaks around the freq.");
    lmb_down && !SHIFT && active_id == -1 && mx >= _tgl_lo_x && mx <= _tgl_lo_x + _tgl_w && my >= _tgl_lo_y && my <= _tgl_lo_y + _tgl_h ? (
      meq_lo_bell = !meq_lo_bell;
      recalc_master_eq(); mark_dirty_kit();
    );
    // Hi band toggle
    _tgl_hi_x = _lcd_cx + _lcd_cw - _tgl_w - 4;
    _tgl_hi_y = _lcd_cy + 1;
    meq_hi_bell ? strcpy(#_tgl_hi, "BELL") : strcpy(#_tgl_hi, "SHELF");
    gfx_set(EQC_HI_R, EQC_HI_G, EQC_HI_B, meq_hi_bell ? 0.7 : 0.35);
    gfx_rect(_tgl_hi_x, _tgl_hi_y, _tgl_w, _tgl_h);
    gfx_set(0, 0, 0, 0.9);
    gfx_measurestr(#_tgl_hi, tw, th);
    gfx_x = _tgl_hi_x + (_tgl_w - tw) / 2; gfx_y = _tgl_hi_y + (_tgl_h - th) / 2;
    gfx_drawstr(#_tgl_hi);
    mx >= _tgl_hi_x && mx <= _tgl_hi_x + _tgl_w && my >= _tgl_hi_y && my <= _tgl_hi_y + _tgl_h ? swing_tooltip_check(1107, "High band shape — SHELF boosts/cuts everything above the freq; BELL peaks around the freq.");
    lmb_down && !SHIFT && active_id == -1 && mx >= _tgl_hi_x && mx <= _tgl_hi_x + _tgl_w && my >= _tgl_hi_y && my <= _tgl_hi_y + _tgl_h ? (
      meq_hi_bell = !meq_hi_bell;
      recalc_master_eq(); mark_dirty_kit();
    );
);

function swing_panels_draw_delay() (
    // ── Shared layout for FX rows ──
    _fx_y0 = _lcd_cy + 2;
    _fx_avail_h = _lcd_ch - 6;
    _fx_label_w = (_lcd_cw * 0.38)|0;
    _fx_bar_x = _lcd_cx + _fx_label_w;
    _fx_bar_w = _lcd_cw - _fx_label_w - 4;
    rk_font(1, 9, 'b');

    // ═══════════════════════════════════════════════════════════════════
    // DELAY — Params: DIV (tempo sync), FB, MIX, HPF, LPF, PING
    // ═══════════════════════════════════════════════════════════════════
    // Every row's hit test is [ry, ry + row_h): the pixel row between two rows used to belong to
    // both, so one click (or wheel notch) there acted on two controls (sweep LIB138; the reverb page
    // too). And no row calls dly_recalc / rvb_recalc itself any more: @block's drift watcher
    // (swing_block_sync_fx_params) performs both on the edit, as A-9a moved the other recalcs --
    // run from here as well they overlapped the watcher's run and shared its function-static
    // locals, so the HP could land at the LPF's corner until the next edit (sweep LIB139).
    1 ? (
      _fx_row_h = (_fx_avail_h / 7)|0;

      // ── Row 0: DELAY ON/OFF ──
      // The bus enable (ser_ver 57), matching the COMP page's top row. "Off"
      // used to mean SYNC = OFF, which threw the division away and cut the
      // repeats dead; this rings them out and leaves every param set.
      _fx_ry = _fx_y0;
      gfx_set(lcd_tx_r, lcd_tx_g, lcd_tx_b, 0.85);
      gfx_x = _lcd_cx + 2; gfx_y = _fx_ry; gfx_drawstr("DELAY:");
      dly_on ? gfx_set(0.25, 0.65, 0.35, 0.8) : gfx_set(0.06, 0.16, 0.20, 0.6);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_bar_w, _fx_row_h - 3);
      gfx_set(1, 1, 1, 0.9);
      dly_on ? strcpy(#_fxv, "ON") : strcpy(#_fxv, "OFF");
      rk_font(1, 9, swing_txt_wt(9, #_fxv));   // a value with a digit: regular (wiki 4.7)
      gfx_measurestr(#_fxv, tw, th);
      gfx_x = _fx_bar_x + (_fx_bar_w - tw) / 2; gfx_y = _fx_ry; gfx_drawstr(#_fxv);
      rk_font(1, 9, 'b');
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? swing_tooltip_check(1206, "Delay bus on/off. OFF rings the repeats out and keeps the division, feedback and mix exactly where you left them.");
      lmb_down && mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? (
        dly_on = !dly_on; mark_dirty_kit();
      );

      // Row 1: SYNC (click to cycle divisions)
      _fx_ry += _fx_row_h;
      gfx_set(lcd_tx_r, lcd_tx_g, lcd_tx_b, 0.85);
      gfx_x = _lcd_cx + 2; gfx_y = _fx_ry; gfx_drawstr("SYNC:");
      // Division name (uses expanded 16-value system)
      get_rpt_div_name(dly_div); strcpy(#_dly_dn, #_rpt_name);
      // Button background
      // Amber when this division does not fit the delay buffer at the current
      // tempo and sample rate (dly_clamped, rk_delay.jsfx-inc): the time is
      // clamped, so it is NOT the division it says it is. Silently sounding
      // wrong is what this replaces.
      dly_clamped ? gfx_set(0.62, 0.42, 0.10, 0.8) :
        (dly_on ? gfx_set(0.20, 0.55, 0.80, 0.7) : gfx_set(0.06, 0.16, 0.20, 0.6));
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_bar_w, _fx_row_h - 3);
      dly_clamped ? gfx_set(1, 0.85, 0.45, 0.98) : gfx_set(1, 1, 1, 0.95);
      rk_font(1, 9, swing_txt_wt(9, #_dly_dn));   // a value with a digit: regular (wiki 4.7)
      gfx_measurestr(#_dly_dn, tw, th);
      gfx_x = _fx_bar_x + (_fx_bar_w - tw) / 2; gfx_y = _fx_ry; gfx_drawstr(#_dly_dn);
      rk_font(1, 9, 'b');
      // Left-click: cycle straight divisions, right-click: full menu
      _in_sync = mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h;
      _in_sync ? (dly_clamped ?
        swing_tooltip_check(1200, "This division is longer than the delay buffer at this tempo and sample rate, so the time is clamped and no longer in tempo. Pick a shorter division, raise the tempo, or work at a lower sample rate.") :
        swing_tooltip_check(1200, "Tempo-sync delay division. Left-click cycles straight; right-click for triplet/dotted; scroll for fine step."));
      _in_sync && lmb_down ? (
        dly_div == 1  ? dly_div = 4  :
        dly_div == 4  ? dly_div = 7  :
        dly_div == 7  ? dly_div = 10 :
        dly_div == 10 ? dly_div = 13 :
        dly_div = 1;
        mark_dirty_kit();
      );
      // Right-click: delay sync division picker (migrated to popup).
      // Separator rows '||' don't consume a result index — '1/8' is at
      // resp=5 (matches gfx_showmenu and the dly_div lookup table in
      // rk_delay.jsfx-inc: dly_div=4 → 1/8).
      _in_sync && rmb_down ? (
        swing_popup_open(mx, my,
          "OFF|1/4|1/4 T|1/4 D||1/8|1/8 T|1/8 D||1/16|1/16 T|1/16 D||1/32|1/32 T|1/32 D||1/64|1/64 T|1/64 D",
          SP_POPUP_CALLER_DLY_SYNC);
      );
      swing_popup_result > 0 && swing_popup_caller_id == SP_POPUP_CALLER_DLY_SYNC ? (
        swing_popup_result == 1 ? (
          dly_on = 0;             // entry 0 = OFF: the bus enable, division kept
        ) : (
          dly_div = swing_popup_result - 1;
          dly_on = 1;             // picking a time you cannot hear is never meant
        );
        swing_popup_result = 0;
        mark_dirty_kit();
      );
      swing_popup_result == -1 && swing_popup_caller_id == SP_POPUP_CALLER_DLY_SYNC ? (
        swing_popup_result = 0;
      );
      _in_sync && frame_wheel != 0 ? (
        dly_div = dly_div + sign_of(frame_wheel);
        dly_div < 1 ? dly_div = RPT_NUM_DIVS;
        dly_div > RPT_NUM_DIVS ? dly_div = 1;
        mark_dirty_kit();
      );

      // Row 2: FEEDBACK
      _fx_ry += _fx_row_h;
      gfx_set(lcd_tx_r, lcd_tx_g, lcd_tx_b, 0.85);
      gfx_x = _lcd_cx + 2; gfx_y = _fx_ry; gfx_drawstr("FB:");
      gfx_set(0.06, 0.16, 0.20, 0.6);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_bar_w, _fx_row_h - 3);
      _fx_fill = ((dly_fb / 0.95) * _fx_bar_w)|0;
      gfx_set(0.30, 0.60, 0.90, 0.7);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_fill, _fx_row_h - 3);
      gfx_set(1, 1, 1, 1);
      sprintf(#_fxv, "%.0f%%", dly_fb * 100);
      rk_font(1, 9, swing_txt_wt(9, #_fxv));   // a value with a digit: regular (wiki 4.7)
      gfx_measurestr(#_fxv, tw, th);
      gfx_x = _fx_bar_x + (_fx_bar_w - tw) / 2; gfx_y = _fx_ry; gfx_drawstr(#_fxv);
      rk_font(1, 9, 'b');
      active_id == 281 ? ( LMB ? (
        dly_fb = max(0, min(0.95, (mx - _fx_bar_x) / _fx_bar_w * 0.95));
        mark_dirty_kit();
      ) : active_id = -1; );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? swing_tooltip_check(1201, "Delay feedback (0-95%). 0=single tap, 95%=dense self-feeding repeats. Drag or scroll.");
      active_id == -1 && lmb_down && mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? (
        active_id = 281;
      );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h && frame_wheel != 0 ? (
        dly_fb = max(0, min(0.95, dly_fb + frame_wheel * 0.02)); mark_dirty_kit();
      );

      // Row 3: MIX
      _fx_ry += _fx_row_h;
      gfx_set(lcd_tx_r, lcd_tx_g, lcd_tx_b, 0.85);
      gfx_x = _lcd_cx + 2; gfx_y = _fx_ry; gfx_drawstr("MIX:");
      gfx_set(0.06, 0.16, 0.20, 0.6);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_bar_w, _fx_row_h - 3);
      _fx_fill = (dly_mix * _fx_bar_w)|0;
      gfx_set(0.30, 0.60, 0.90, 0.7);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_fill, _fx_row_h - 3);
      gfx_set(1, 1, 1, 1);
      sprintf(#_fxv, "%.0f%%", dly_mix * 100);
      rk_font(1, 9, swing_txt_wt(9, #_fxv));   // a value with a digit: regular (wiki 4.7)
      gfx_measurestr(#_fxv, tw, th);
      gfx_x = _fx_bar_x + (_fx_bar_w - tw) / 2; gfx_y = _fx_ry; gfx_drawstr(#_fxv);
      rk_font(1, 9, 'b');
      active_id == 280 ? ( LMB ? (
        dly_mix = max(0, min(1, (mx - _fx_bar_x) / _fx_bar_w));
        mark_dirty_kit();
      ) : active_id = -1; );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? swing_tooltip_check(1202, "Delay wet/dry blend (0=dry, 100%=full delay). Drag or scroll.");
      active_id == -1 && lmb_down && mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? (
        active_id = 280;
      );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h && frame_wheel != 0 ? (
        dly_mix = max(0, min(1, dly_mix + frame_wheel * 0.02)); mark_dirty_kit();
      );

      // Row 4: HPF
      _fx_ry += _fx_row_h;
      gfx_set(lcd_tx_r, lcd_tx_g, lcd_tx_b, 0.85);
      gfx_x = _lcd_cx + 2; gfx_y = _fx_ry; gfx_drawstr("HPF:");
      gfx_set(0.06, 0.16, 0.20, 0.6);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_bar_w, _fx_row_h - 3);
      _hpf_norm = (log(max(20, dly_hpf_hz)) - log(20)) / (log(2000) - log(20));
      _fx_fill = (_hpf_norm * _fx_bar_w)|0;
      gfx_set(0.25, 0.50, 0.75, 0.7);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_fill, _fx_row_h - 3);
      gfx_set(1, 1, 1, 1);
      // OFF where the engine is off (rk_delay: dly_hp_on = dly_hpf_hz > 25); it read "20 Hz" while off (sweep LIB140)
      dly_hpf_hz <= 25 ? strcpy(#_fxv, "OFF") : sprintf(#_fxv, "%.0f Hz", dly_hpf_hz);
      rk_font(1, 9, swing_txt_wt(9, #_fxv));   // a value with a digit: regular (wiki 4.7)
      gfx_measurestr(#_fxv, tw, th);
      gfx_x = _fx_bar_x + (_fx_bar_w - tw) / 2; gfx_y = _fx_ry; gfx_drawstr(#_fxv);
      rk_font(1, 9, 'b');
      active_id == 284 ? ( LMB ? (
        _hpf_norm = max(0, min(1, (mx - _fx_bar_x) / _fx_bar_w));
        dly_hpf_hz = exp(log(20) + _hpf_norm * (log(2000) - log(20)));
        dly_hpf_hz = max(20, min(2000, dly_hpf_hz));
        mark_dirty_kit();
      ) : active_id = -1; );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? swing_tooltip_check(1203, "High-pass filter on the delay signal (20-2000 Hz, log). Removes low-end mud from repeats.");
      active_id == -1 && lmb_down && mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? (
        active_id = 284;
      );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h && frame_wheel != 0 ? (
        _hpf_norm = (log(max(20, dly_hpf_hz)) - log(20)) / (log(2000) - log(20));
        _hpf_norm = max(0, min(1, _hpf_norm + frame_wheel * 0.03));
        dly_hpf_hz = max(20, min(2000, exp(log(20) + _hpf_norm * (log(2000) - log(20)))));
        mark_dirty_kit();
      );

      // Row 5: LPF
      _fx_ry += _fx_row_h;
      gfx_set(lcd_tx_r, lcd_tx_g, lcd_tx_b, 0.85);
      gfx_x = _lcd_cx + 2; gfx_y = _fx_ry; gfx_drawstr("LPF:");
      gfx_set(0.06, 0.16, 0.20, 0.6);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_bar_w, _fx_row_h - 3);
      _lpf_norm = (log(max(1000, dly_lpf_hz)) - log(1000)) / (log(20000) - log(1000));
      _fx_fill = (_lpf_norm * _fx_bar_w)|0;
      gfx_set(0.25, 0.50, 0.75, 0.7);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_fill, _fx_row_h - 3);
      gfx_set(1, 1, 1, 1);
      dly_lpf_hz >= 19500 ? strcpy(#_fxv, "OFF") : sprintf(#_fxv, "%.0f Hz", dly_lpf_hz);
      rk_font(1, 9, swing_txt_wt(9, #_fxv));   // a value with a digit: regular (wiki 4.7)
      gfx_measurestr(#_fxv, tw, th);
      gfx_x = _fx_bar_x + (_fx_bar_w - tw) / 2; gfx_y = _fx_ry; gfx_drawstr(#_fxv);
      rk_font(1, 9, 'b');
      active_id == 285 ? ( LMB ? (
        _lpf_norm = max(0, min(1, (mx - _fx_bar_x) / _fx_bar_w));
        dly_lpf_hz = exp(log(1000) + _lpf_norm * (log(20000) - log(1000)));
        dly_lpf_hz = max(1000, min(20000, dly_lpf_hz));
        mark_dirty_kit();
      ) : active_id = -1; );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? swing_tooltip_check(1204, "Low-pass filter on the delay signal (1k-20kHz, log). OFF above 19.5kHz. Tames bright repeats.");
      active_id == -1 && lmb_down && mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? (
        active_id = 285;
      );
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h && frame_wheel != 0 ? (
        _lpf_norm = (log(max(1000, dly_lpf_hz)) - log(1000)) / (log(20000) - log(1000));
        _lpf_norm = max(0, min(1, _lpf_norm + frame_wheel * 0.03));
        dly_lpf_hz = max(1000, min(20000, exp(log(1000) + _lpf_norm * (log(20000) - log(1000)))));
        mark_dirty_kit();
      );

      // Row 6: PING-PONG (toggle)
      _fx_ry += _fx_row_h;
      gfx_set(lcd_tx_r, lcd_tx_g, lcd_tx_b, 0.85);
      gfx_x = _lcd_cx + 2; gfx_y = _fx_ry; gfx_drawstr("PING:");
      dly_ping ? gfx_set(0.20, 0.55, 0.80, 0.7) : gfx_set(0.06, 0.16, 0.20, 0.6);
      gfx_rect(_fx_bar_x, _fx_ry + 1, _fx_bar_w, _fx_row_h - 3);
      gfx_set(1, 1, 1, 0.9);
      dly_ping ? strcpy(#_fxv, "ON") : strcpy(#_fxv, "OFF");
      rk_font(1, 9, swing_txt_wt(9, #_fxv));   // a value with a digit: regular (wiki 4.7)
      gfx_measurestr(#_fxv, tw, th);
      gfx_x = _fx_bar_x + (_fx_bar_w - tw) / 2; gfx_y = _fx_ry; gfx_drawstr(#_fxv);
      rk_font(1, 9, 'b');
      mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? swing_tooltip_check(1205, "Ping-pong delay mode — alternates repeats between L and R channels for stereo motion.");
      lmb_down && mx >= _fx_bar_x && mx <= _fx_bar_x + _fx_bar_w && my >= _fx_ry && my < _fx_ry + _fx_row_h ? (
        dly_ping = !dly_ping; mark_dirty_kit();
      );
    );
);

