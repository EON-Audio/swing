//     Permission is hereby granted, free of charge, to any person obtaining a
//     copy of this software and associated documentation files (the "Software"),
//     to deal in the Software without restriction, including without limitation
//     the rights to use, copy, modify, merge, publish, distribute, sublicense,
//     and/or sell copies of the Software, subject to inclusion of the above
//     copyright notice and this permission notice in all copies.
//
//   Reused and modified WITH THANKS under the MIT License.
//   EON Studios additions (c) EON Studios.
//
//
//   2026-08-12: trimmed to the four functions EON_StepSeq (the only importer)
//   actually calls -- roundRect / drawSelectionButton / eon_nice_button, plus
//   updateHintTime which drawSelectionButton's body needs. The rest of the
//   SEQS kit (knobs, sliders, combobox, panels, toggles, text input, theme
//   setter) and the rk_widgets_data import had zero call sites anywhere and
//   were removed; git history keeps them.
//
//   CONTRACT NOTES:
//   * drawSelectionButton edge-detects clicks against `lcap`, which StepSeq
//     never writes -- so detection degrades to level-triggered while held.
//     Harmless for its one radio-pill use (rewrites the same slider value),
//     but wire `lcap = mouse_cap;` at end-of-frame before reusing it for
//     anything stateful.
//   * the hinter.* queue updateHintTime feeds has NO renderer in StepSeq;
//     the hint strings go nowhere by design.
// ============================================================================

@init

/* Hover-hint timer (queue only -- see contract note above). */
function updateHintTime(hint)
  global(gfx_x, gfx_y, mouse_x, mouse_y)
  local()
  instance(lx, ly, hintTime, currentHint, delta_time)
  (
    ( ( abs(lx - mouse_x) + abs( ly - mouse_y ) ) > 0 ) ? (
      hintTime = 0;
    ) : (      
      (hint != 0) ? (
        currentHint = hint;
        hintTime = hintTime + delta_time;
        hintTime = min(1, hintTime)
      ) : (
        0
      )
    );
    
    lx = mouse_x;
    ly = mouse_y;
  );   

function roundRect(x, y, w, h, radius, aa)
local()
instance()
global(gfx_a)
(
  x = floor(x);
  y = floor(y);
  w = floor(w);
  h = floor(h);
  
  gfx_circle(x+radius, y+radius, radius, 1, aa);
  gfx_circle(x+w-radius-1, y+radius, radius, 1, aa);
  gfx_circle(x+w-radius-1, y+h-radius-1, radius, 1, aa);
  gfx_circle(x+radius, y+h-radius-1, radius, 1, aa);
  
  gfx_rect(x, y+radius, radius*2, h-radius*2, aa);
  gfx_rect(x+w-radius*2, y+radius, radius*2, h-radius*2, aa);
  gfx_rect(x+radius, y, w-radius*2, radius*2, aa);
  gfx_rect(x+radius, y+h-radius*2, w-radius*2, aa*2, aa);
  gfx_rect(x+radius, y+radius, w-radius*2, h-radius, aa);
);

// Defaults
selection_button_r = 0.1;
selection_button_g = 0.13;
selection_button_b = 0.1;

// When slider_idx is positive, it will just directly connect to the slider.
// If it is negative, then it will use that value as the currently selected value.
function drawSelectionButton(str, x, y, w, h, idx, slider_idx, hint)
local(ww, hh, over, selected_value, clicked)
global(knob_font_color_r, knob_font_color_g, knob_font_color_b, knob_font_color_a, gfx_x, gfx_y,
       mouse_cap, mouse_x, mouse_y, lcap, hinter.updateHintTime
       selection_button_r, selection_button_g, selection_button_b)
instance()
(
  x = floor(x);
  y = floor(y);
  w = floor(w);
  h = floor(h);
  over = mouse_x > x && mouse_x < (x+w) && mouse_y > y && mouse_y < (y+h);
  
  clicked = 0;
  (lcap == 0) && (mouse_cap & 1 == 1) ? (
    over ? (
      clicked = 1;
      slider_idx > 0 ? (
        slider(slider_idx) = idx;
      );
    );
  );
  
  selected_value = slider_idx > 0 ? slider(slider_idx) : - slider_idx;
  idx == selected_value ? (
    gfx_set(knob_font_color_r, knob_font_color_g, knob_font_color_b, knob_font_color_a);
    gfx_roundrect(x, y, w, h, 2);
  ) : (
    gfx_set(selection_button_r, selection_button_g, selection_button_b, 1);
    roundrect(x, y, w, h, 2, 1);
    gfx_set(selection_button_r * 2, selection_button_g * 2, selection_button_b * 2, 1);
    gfx_roundrect(x, y, w, h, 2);
  );
  
  gfx_set(knob_font_color_r, knob_font_color_g, knob_font_color_b, knob_font_color_a);
  gfx_measurestr(str, ww, hh);
  gfx_x = x + .5 * (w - ww);
  gfx_y = y + .5 * (h - hh);
  gfx_printf(str);
  
  ( mouse_cap & 1 == 0 ) ? (
    ( over == 1 ) ? (
      hinter.updateHintTime(hint);
    ) : ( 
      hinter.updateHintTime(0);
    );
  );
  
  clicked
);

// EON addition: rounded, beveled button (filled body + soft lighter top edge).
// Pure-draw (no theme globals needed); uses Saike's roundRect above. Colors 0..1.
function eon_nice_button(x, y, w, h, br, bg, bb, er, eg, eb) local(rad) (
  rad = 4;
  gfx_set(br, bg, bb, 1.0);
  roundRect(x, y, w, h, rad, 1);                                  // filled body
  gfx_set(er, eg, eb, 1.0);
  gfx_roundrect(x, y, w-1, h-1, rad, 1);                          // crisp lighter rounded border
  gfx_set(min(br*1.7,1), min(bg*1.7,1), min(bb*1.7,1), 0.75);     // top highlight (bevel)
  gfx_line(x+rad, y+1, x+w-rad-1, y+1, 1);
);
