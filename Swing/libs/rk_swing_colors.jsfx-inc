// rk_swing_colors.jsfx-inc
// Swing color system — themes, auto-color, intensity, pre-computed RGBA
// v2.1 color system
// (c) EON Studios — All Rights Reserved

@init

// ─── Auto-color mode constants ─────────────────────────────────────────
COL_AUTO_OFF       = 0;
COL_AUTO_DRUMTYPE  = 1;
COL_AUTO_OUTPUT    = 2;
COL_AUTO_RAINBOW   = 3;
COL_NUM_AUTO_MODES = 4;

// ─── Init: allocate freemem ────────────────────────────────────────────
function swing_color_init(mem_base)
local(_base)
(
  _base = mem_base;
  col_rgba     = _base; _base += 16 * 3;  // 48: R,G,B per pad
  col_rgba_dim = _base; _base += 16 * 3;  // 48: dimmed variant (muted pads)
  col_auto_hue = _base; _base += 16;      // 16: auto-color hue buffer
  memset(col_rgba, 0, 112);

  // col_theme_id retained for legacy serialize compat (the value is
  // ignored — themes/palettes were removed in the v43 color system
  // simplification). Kept so old projects don't get a "field missing"
  // mismatch on read; new projects just write 0.
  col_theme_id     = 0;
  // Default auto-color mode = DRUMTYPE (1) so fresh instances categorize
  // pads by filename out of the box (kick → red, snare → orange, etc.).
  // Existing projects keep whatever mode they had via swing_color_serialize.
  col_auto_mode_id = 1;
  col_intensity    = 1.0;
  col_dirty        = 1;
  col_panel_open   = 0;
  // Mono toggle (new in v43). 0 = full color (default), 1 = grayscale.
  // Replaces the old Mono THEME — single binary toggle in Color Panel.
  col_mono         = 0;

  _base;
);

// ─── Serialize ─────────────────────────────────────────────────────────
function swing_color_serialize() (
  // col_theme_id retained for backward-compat with v<43 projects that
  // wrote it. Read consumes/discards; write keeps the slot populated so
  // we don't drift the @serialize byte layout downstream.
  file_var(0, col_theme_id);
  file_var(0, col_auto_mode_id);
  file_var(0, col_intensity);
  // Migration: v43 had 5 modes (Folder=3, Rainbow=4).
  // v44+ drops Folder → Rainbow moves to slot 3, 4 modes total.
  is_read && ser_ver < 44 ? (
    col_auto_mode_id == 3 ? col_auto_mode_id = 0    // Folder → Off
    : col_auto_mode_id == 4 ? col_auto_mode_id = 3; // Rainbow(4) → Rainbow(3)
  );
  is_read ? (
    col_auto_mode_id >= COL_NUM_AUTO_MODES ? col_auto_mode_id = 0;  // invalid → Off
  );
  // v43+: mono toggle. EEL2 zero-inits col_mono on fresh instance =
  // full color (correct default). Old projects on first load: read
  // skips this slot via the ser_ver gate in @serialize main block,
  // and col_mono stays 0.
);

// ─── Get effective S/L (replaces the old multi-theme getter) ──────────
// Themes were removed in v43. Effective saturation = baseline × intensity,
// or 0.08 (Mono) when col_mono is on. Lightness is a fixed baseline.
// Sets _sc_s and _sc_l like the old swing_color_get_theme_sl did, so
// downstream code (swing_color_rebuild, render) works unchanged.
// The baselines as pure functions: the rebuild (on @block too, LIB327) takes them into locals and never reads the
// _sc_* globals the @gfx readers (Swing_ReaKit's col_dirty block) still take from the setter below.
function swing_color_base_s() ( col_mono ? 0.08 : 0.75; );   // grayscale / baseline saturation (was Rainbow theme's S)
function swing_color_base_l() ( col_mono ? 0.50 : 0.55; );   // baseline lightness (was Rainbow theme's L)
function swing_color_get_theme_sl(tid)
(
  // tid argument retained for legacy callers; ignored (kept to preserve
  // the existing call signature so we don't have to chase down every
  // call site this commit). col_mono and col_intensity drive everything.
  _sc_s = swing_color_base_s();
  _sc_l = swing_color_base_l();
);

// ─── Drum type hue from pad name (46-category vocabulary) ─────────────
// Mirrors eon_filename_categorizer.lua's CATEGORY_KEYWORDS in the same
// CATEGORY_ORDER priority — specific categories win on tie-break.
// Each category gets a unique hue (0..1) so kicks→red, snares→orange,
// claps→green, closed hats→teal, open hats→violet. The 5 core types are
// spread across the full color wheel for maximum distinction.
// The browser's CATEGORY_COLORS in the categorizer
// uses the equivalent RGB for these same hues, so colors stay consistent
// between the browser file list and the JSFX pad grid.
function swing_color_drumtype_hue_s(pad_idx, _ct)
local(_cn, _len, _i, _ch, _h)
(
  _cn = get_cname_slot(pad_idx);
  _len = strlen(_cn);
  _len == 0 ? (
    _cn = get_name_slot(pad_idx);
    _len = strlen(_cn);
  );

  // Lowercase + normalize separators '_' '-' '.' '(' ')' AND digits to
  // spaces (REVIEW 2026-07-27: mirrors rk_cat_glyphs.jsfx-inc's
  // "digits -> space" str_setchar rule — the
  // Lua frontier patterns treat digits as word boundaries, so "HH1"/"CH2"
  // must word-match here too; no keyword contains a digit).
  strcpy(_ct, _cn);
  _i = 0; loop(_len,
    _ch = str_getchar(_ct, _i);
    _ch >= 65 && _ch <= 90 ? str_setchar(_ct, _i, _ch + 32) :
    (_ch == 95 || _ch == 45 || _ch == 46 || _ch == 40 || _ch == 41) ? str_setchar(_ct, _i, 32) :
    (_ch >= 48 && _ch <= 57) ? str_setchar(_ct, _i, 32);
    _i += 1;
  );

  // Default: "other" (hue 0.90 — pink, distinct from any category)
  _h = 0.90;

  // ⭐ The glyph table's word rule (rk_cat_glyphs eon_wordm, the Lua's frontier rule for keywords of 3 chars or
  // fewer): a short keyword matches as a WORD -- exact, "kw *", "* kw", "* kw *" -- never as a bare substring, so
  // "Phantom Pad" is not a tom, "What" not a hat, "Prime Snare" not a rimshot; and the rows run in the table's
  // order (snare before sidestick and rimshot) with its "sd". Until 2026-10-26 the colour and the icon of such a pad
  // disagreed (LIB325). Written out per keyword: a pattern built into a scratch string would be one more cell
  // shared between @gfx and the @block rebuild.
  // ── Drums (red zone) ──
  match("*kick*", _ct) ||
  match("kck", _ct) || match("kck *", _ct) || match("* kck", _ct) || match("* kck *", _ct) ||
  match("kik", _ct) || match("kik *", _ct) || match("* kik", _ct) || match("* kik *", _ct) ||
  match("*bassdrum*", _ct) || match("*bass drum*", _ct) ||
  // digits now normalize to spaces (above), so "808kick"/"909 kick" reduce
  // to "*kick*" and "808bd"/"909bd" reduce to a bare "bd" word — match it
  // (and "kk") the word-sim way, mirroring eon_wordm("bd")/("kk") in glyphs:
  match("bd", _ct) || match("bd *", _ct) ||
  match("* bd", _ct) || match("* bd *", _ct) ||
  match("kk", _ct) || match("kk *", _ct) ||
  match("* kk", _ct) || match("* kk *", _ct) ? (
    _h = 0.00;  // kick — RED
  ) :
  match("*snare*", _ct) ||
  match("snr", _ct) || match("snr *", _ct) || match("* snr", _ct) || match("* snr *", _ct) ||
  match("sd", _ct) || match("sd *", _ct) || match("* sd", _ct) || match("* sd *", _ct) ? (
    _h = 0.12;  // snare — ORANGE
  ) :
  match("*sidestick*", _ct) || match("*side stick*", _ct) ||
  match("*cross stick*", _ct) || match("*crosstick*", _ct) ||
  match("*xstick*", _ct) || match("*stick*", _ct) ? (
    _h = 0.08;  // sidestick (orange — between rimshot and snare)
  ) :
  match("*rimshot*", _ct) || match("*rim shot*", _ct) ||
  match("rim", _ct) || match("rim *", _ct) || match("* rim", _ct) || match("* rim *", _ct) ? (
    _h = 0.06;  // rimshot (orange-red)
  ) :
  match("*clap*", _ct) ||
  match("clp", _ct) || match("clp *", _ct) || match("* clp", _ct) || match("* clp *", _ct) ||
  match("*handclap*", _ct) || match("*hand clap*", _ct) ? (
    _h = 0.30;  // clap — GREEN
  ) :
  match("*snap*", _ct) || match("*fingersnap*", _ct) ||
  match("*finger snap*", _ct) ? (
    _h = 0.32;  // snap (green, clap family)
  ) :

  // ── Cymbals (gold zone) ──
  match("*splash*", _ct) ? (
    _h = 0.20;  // splash (gold, cymbal family)
  ) :
  match("*china*", _ct) || match("*trash*", _ct) ||
  match("*stack*", _ct) ? (
    _h = 0.22;  // china (gold, cymbal family — also trash/stack)
  ) :
  match("*ride*", _ct) ? (
    _h = 0.17;  // ride (yellow)
  ) :
  match("*crash*", _ct) || match("*crsh*", _ct) ? (
    _h = 0.19;  // crash (warm gold)
  ) :
  match("*cymbal*", _ct) ||
  match("cym", _ct) || match("cym *", _ct) || match("* cym", _ct) || match("* cym *", _ct) ? (
    _h = 0.21;  // cymbal (gold)
  ) :

  // ── Brass (chartreuse) ──
  match("*brass*", _ct) || match("*trumpet*", _ct) ||
  match("*trombone*", _ct) || match("*horn*", _ct) ||
  match("*tuba*", _ct) || match("*flugelhorn*", _ct) ||
  match("*cornet*", _ct) ? (
    _h = 0.23;  // brass (chartreuse)
  ) :

  // ── Hand percussion (yellow-green to green) ──
  match("*cowbell*", _ct) || match("*cow bell*", _ct) ? (
    _h = 0.25;  // cowbell (yellow-green)
  ) :
  match("*clave*", _ct) ? (
    _h = 0.27;  // clave (lime)
  ) :
  match("*tambourine*", _ct) || match("*tamb*", _ct) ||
  match("*tambou*", _ct) ? (
    _h = 0.33;  // tambourine (green)
  ) :
  match("*shaker*", _ct) || match("*shake*", _ct) ? (
    _h = 0.35;  // shaker (forest green)
  ) :
  match("*maraca*", _ct) ? (
    _h = 0.37;  // maraca (green)
  ) :
  match("*conga*", _ct) ? (
    _h = 0.95;  // conga (pink-red)
  ) :
  match("*bongo*", _ct) ? (
    _h = 0.97;  // bongo (magenta-red)
  ) :
  match("tom", _ct) || match("tom *", _ct) || match("* tom", _ct) || match("* tom *", _ct) ||
  match("*toms*", _ct) ? (
    _h = 0.03;  // tom (red-orange) — a word, so "bottom" / "phantom" stay out (the plural stays a substring, as the Lua has it)
  ) :
  // ── Promoted world/hand percussion (2026-07-03; hues = CATEGORY_COLORS) ──
  match("*triangle*", _ct) ? (
    _h = 0.34;  // triangle (green, small-metal family)
  ) :
  match("*woodblock*", _ct) || match("*wood block*", _ct) ||
  match("*click*", _ct) ? (
    _h = 0.10;  // woodblock (warm wood)
  ) :
  match("*cabasa*", _ct) ? (
    _h = 0.38;  // cabasa (green, shaker family)
  ) :
  match("*guiro*", _ct) ? (
    _h = 0.41;  // guiro (green)
  ) :
  match("*timbale*", _ct) ? (
    _h = 0.92;  // timbale (pink-red, latin family)
  ) :
  match("*agogo*", _ct) ? (
    _h = 0.26;  // agogo (yellow-green, bell family)
  ) :
  match("*djembe*", _ct) || match("*jembe*", _ct) ? (
    _h = 0.93;  // djembe (pink-red, latin family)
  ) :
  match("*cajon*", _ct) ? (
    _h = 0.99;  // cajon (red, bass-box)
  ) :
  match("*vibraslap*", _ct) || match("*vibra slap*", _ct) ? (
    _h = 0.50;  // vibraslap (cyan)
  ) :
  match("*whistle*", _ct) ? (
    _h = 0.61;  // whistle (blue)
  ) :
  match("*perc*", _ct) ? (
    _h = 0.40;  // percussion (deep green — pure catch-all now)
  ) :

  // ── Strings family (teal-cyan) ──
  match("*guitar*", _ct) ||
  match("gtr", _ct) || match("gtr *", _ct) || match("* gtr", _ct) || match("* gtr *", _ct) ||
  match("*guit*", _ct) || match("*strat*", _ct) ||
  match("*tele*", _ct) || match("*les paul*", _ct) ||
  match("*nylon*", _ct) || match("*ukulele*", _ct) ? (
    _h = 0.43;  // guitar (teal)
  ) :
  match("*strings*", _ct) || match("*violin*", _ct) ||
  match("*viola*", _ct) || match("*cello*", _ct) ||
  match("*contrabass*", _ct) || match("*orchestral*", _ct) ||
  match("*ensemble*", _ct) || match("*chamber*", _ct) ||
  match("*pizzicato*", _ct) ? (
    _h = 0.46;  // strings (cyan)
  ) :

  // ── Hi-hat family (teal-cyan zone — distinct from drums) ──
  // ⭐ 2026-07-27 user rule (mirrors eon_filename_categorizer): generic
  // hi-hat names (hihat / hi hat / high hat / hh) hue as CLOSED; only bare
  // *hat* keeps the generic teal — and must never hue as open.
  match("*closed hat*", _ct) || match("*closedhat*", _ct) ||
  match("*closed*", _ct) ||
  match("*hat closed*", _ct) || match("*pedal hat*", _ct) ||
  match("*pedalhat*", _ct) ||
  // "ch"/"chh" — word-boundary simulation (JSFX match has no frontier
  // patterns): exact token, or "tok ..." / "... tok" / "... tok ..." forms.
  match("ch", _ct) || match("ch *", _ct) ||
  match("* ch", _ct) || match("* ch *", _ct) ||
  match("chh", _ct) || match("chh *", _ct) ||
  match("* chh", _ct) || match("* chh *", _ct) ? (
    _h = 0.52;  // closed_hat — TEAL-CYAN
  ) :
  match("*open hat*", _ct) || match("*openhat*", _ct) ||
  match("*hat open*", _ct) || match("*open*", _ct) ||
  // "oh"/"ohh" — word-boundary simulation (same approach as "ch" above):
  match("oh", _ct) || match("oh *", _ct) ||
  match("* oh", _ct) || match("* oh *", _ct) ||
  match("ohh", _ct) || match("ohh *", _ct) ||
  match("* ohh", _ct) || match("* ohh *", _ct) ? (
    _h = 0.72;  // open_hat — VIOLET
  ) :
  match("*hihat*", _ct) || match("*hi hat*", _ct) ||
  match("*high hat*", _ct) || match("*highhat*", _ct) ||
  match("hh", _ct) || match("hh *", _ct) ||
  match("* hh", _ct) || match("* hh *", _ct) ? (
    _h = 0.52;  // generic hi-hat name = closed articulation (user rule)
  ) :
  match("hat", _ct) || match("hat *", _ct) || match("* hat", _ct) || match("* hat *", _ct) ||
  match("*hats*", _ct) ? (
    _h = 0.49;  // the word "hat" (or "hats") — hihat generic (teal); the old unbounded
                // "*hh*" is GONE (it mis-hued CHH/OHH against every other
                // surface — 2026-07-27 audit).
  ) :

  // ── Keys (cyan-blue) ──
  match("*piano*", _ct) || match("*keys*", _ct) ||
  match("*keyboard*", _ct) || match("*organ*", _ct) ||
  match("*rhodes*", _ct) || match("*wurlitzer*", _ct) ||
  match("*epiano*", _ct) || match("*e piano*", _ct) ||
  match("*clav*", _ct) || match("*marimba*", _ct) ||
  match("*vibraphone*", _ct) || match("*xylophone*", _ct) ||
  match("*glockenspiel*", _ct) || match("*celesta*", _ct) ||
  match("*harp*", _ct) || match("*mallet*", _ct) ? (
    _h = 0.55;  // keys (cyan-blue)
  ) :

  // ── Atmospheres (blue zone) ──
  match("pad", _ct) || match("pad *", _ct) || match("* pad", _ct) || match("* pad *", _ct) ||
  match("*pads*", _ct) || match("*ambient*", _ct) ||
  match("*atmosphere*", _ct) || match("*atmo*", _ct) ||
  match("*drone*", _ct) || match("*texture*", _ct) ||
  match("*evolving*", _ct) || match("*soundscape*", _ct) ? (
    _h = 0.58;  // pad (sky blue)
  ) :
  match("*vocal*", _ct) ||
  match("vox", _ct) || match("vox *", _ct) || match("* vox", _ct) || match("* vox *", _ct) ||
  match("*voice*", _ct) || match("*choir*", _ct) ||
  match("*acapella*", _ct) || match("*a capella*", _ct) ||
  match("*singing*", _ct) || match("*spoken*", _ct) ||
  match("*speech*", _ct) || match("*adlib*", _ct) ||
  match("*chant*", _ct) ? (
    _h = 0.62;  // vocal (blue)
  ) :
  match("*synth*", _ct) ||
  match("arp", _ct) || match("arp *", _ct) || match("* arp", _ct) || match("* arp *", _ct) ||
  match("*arpeggio*", _ct) ||
  match("*pluck*", _ct) || match("*stab*", _ct) ||
  match("*chord*", _ct) ||
  match("saw", _ct) || match("saw *", _ct) || match("* saw", _ct) || match("* saw *", _ct) ||
  match("*square*", _ct) || match("*sine*", _ct) ||
  match("*supersaw*", _ct) || match("*hoover*", _ct) ? (
    _h = 0.66;  // synth (indigo)
  ) :

  // ── Bass (purple) ──
  match("*bass*", _ct) ||
  match("sub", _ct) || match("sub *", _ct) || match("* sub", _ct) || match("* sub *", _ct) ||
  match("*reese*", _ct) ? (
    _h = 0.76;  // bass (purple)
  ) :

  // ── Effects / loops (magenta-pink) ──
  match("sfx", _ct) || match("sfx *", _ct) || match("* sfx", _ct) || match("* sfx *", _ct) ||
  match("*effect*", _ct) ||
  match("*riser*", _ct) || match("*impact*", _ct) ||
  match("*whoosh*", _ct) || match("*sweep*", _ct) ||
  match("*noise*", _ct) || match("*glitch*", _ct) ||
  match("*stutter*", _ct) || match("*transition*", _ct) ||
  match("*reverse*", _ct) || match("*buildup*", _ct) ||
  match("*build up*", _ct) || match("*drop*", _ct) ||
  match("*explosion*", _ct) || match("*boom*", _ct) ||
  match("*siren*", _ct) || match("*foley*", _ct) ||
  match("*cinematic*", _ct) ? (
    _h = 0.82;  // fx (magenta)
  ) :
  match("*loop*", _ct) || match("*break*", _ct) ||
  match("*groove*", _ct) || match("*pattern*", _ct) ||
  match("*beat*", _ct) ? (
    _h = 0.86;  // loop (pink)
  );

  _h;
);
// The scratch string is the CALLER's: @gfx's painters go through swing_color_drumtype_hue (#_ct_tmp), the
// @block rebuild through its own (#_ct_blk, swing_color_rebuild_blk). One shared scratch was written by both
// threads at once -- the window-closed mirror in @block rebuilds while @gfx's COLORS and MAPPING views match
// per frame -- and a torn name gave a pad the wrong category's hue until the next colour event (LIB327).
function swing_color_drumtype_hue(pad_idx) ( swing_color_drumtype_hue_s(pad_idx, #_ct_tmp); );

// ─── Apply auto-color → col_auto_hue[] ─────────────────────────────────
// `_ct` = the matcher's scratch string, the rebuild's (LIB327: one per thread).
function swing_color_apply_auto(mode_id, _ct)
local(_i, _i_s)
(
  _i = 0; loop(NUM_PADS,
    _i_s = swing_bp(_i);
    mode_id == COL_AUTO_DRUMTYPE ? (
      col_auto_hue[_i] = swing_color_drumtype_hue_s(_i_s, _ct);
    ) :
    mode_id == COL_AUTO_OUTPUT ? (
      col_auto_hue[_i] = swing_out_hue(_i_s);   // where it plays (a bank B-D pad: its bank's track or its own, Outputs step 3)
    ) :
    mode_id == COL_AUTO_RAINBOW ? (
      col_auto_hue[_i] = _i / 16.0;
    ) : (
      col_auto_hue[_i] = p_color[_i_s];
    );
    _i += 1;
  );
);

// ─── Rebuild pre-computed RGBA arrays ──────────────────────────────────
// --- Pad hue for direct painters -----------------------------------------
// swing_color_rebuild() below bakes the pad faces into col_rgba[], and anything
// drawing a pad the normal way reads that cache. The overlays (MAPPING, CATEGORY,
// RANGE, note picker, macro editor) cannot: each wants the pad's hue at its OWN
// saturation/lightness, so they call hsl_to_rgb themselves.
//
// They must still take the HUE from where the cache takes it. p_color is only the
// MANUAL hue; with an auto-colour mode on -- and col_auto_mode_id defaults to 1 --
// col_auto_hue[] is what actually drives every pad face, while p_color holds
// whatever the kit chunk carried, which for a kit nobody hand-coloured is 0 on all
// sixteen pads. Reading p_color raw there paints the whole overlay at hue 0:
// sixteen identical pink pads. (Reported 2026-08-26 against MAPPING in the dock
// rack face. The fault was never face-specific -- the rack header's MAP chip just
// made it one click away instead of buried in the KIT tab.)
//
// Returns -2 blank / -1 white / 0..1 hue, the same specials swing_color_rebuild uses.
// Pad Banks step 5c: `pad` is ABSOLUTE; col_auto_hue[] holds the bank on screen's sixteen tiles, so another bank's
// pad (the mapping view's other-bank keys, 4d) derives its auto hue the way swing_color_apply_auto does -- it read
// col_auto_hue[pad] past the buffer.
// Explicit branches, each a block (2026-10-26, sweep LIB1): the one value chain this was -- array
// cells, calls with locals and an arithmetic leaf under one ?: -- runs in REAPER but crashes the
// ysfx harness every offline test runs through, so nothing that reached it could be tested. Same
// result in every branch.
function swing_color_auto_hue(pad) local(_h) (
  swing_pad_bank(pad) == bank_cur ? ( _h = col_auto_hue[swing_pad_tile(pad)]; ) :
  col_auto_mode_id == COL_AUTO_DRUMTYPE ? ( _h = swing_color_drumtype_hue(pad); ) :
  col_auto_mode_id == COL_AUTO_OUTPUT ? ( _h = swing_out_hue(pad); ) :
  col_auto_mode_id == COL_AUTO_RAINBOW ? ( _h = swing_pad_tile(pad) / 16.0; ) : ( _h = p_color[pad]; );
  _h;
);
function swing_color_pad_hue(pad) (
  pad < 0 || !pad_is_playable(pad) ? -2 :
  col_auto_mode_id > 0 ? swing_color_auto_hue(pad) : p_color[pad];
);

// ─── Switch to MANUAL colors without changing what's on screen ─────────
// A manual pad-color edit while auto-color is active flips the WHOLE kit
// to manual mode. Seed every OTHER loaded pad's manual color from its
// current auto hue FIRST, so only the edited pad visibly changes (user
// report 2026-06-12: "changed the Sub color and all the other pads
// changed"). exclude_pad = the pad being edited (its new color is applied
// by the caller); no-op when already in manual mode.
// Every SLOT, not the sixteen tiles on screen: the mode flips for all four banks, so a bank B..D pad seeded from
// nothing dropped from its auto hue to its raw p_color (the kit's value, or clear_pad's tile hue) the next time its
// bank was shown -- the 2026-06-12 bug again, one bank over (LIB32). swing_color_auto_hue (above: EEL2 binds a call
// at definition time) derives the other banks' hues the way swing_color_apply_auto does for the bank on screen.
function swing_color_manualize(exclude_pad)
local(_i, _x)
(
  col_auto_mode_id > 0 ? (
    _x = swing_bp(swing_pad_tile(exclude_pad));   // callers pass a tile or a slot (step 4d): the tile's slot on screen
    _i = 0;
    loop(NUM_SLOTS,
      _i != _x && pad_is_playable(_i) ? p_color[_i] = swing_color_auto_hue(_i);
      _i += 1;
    );
    col_auto_mode_id = 0;
  );
);

// hsl_to_rgb for a pad at a caller-chosen S/L, with the achromatic specials
// resolved to greys at that same lightness -- so a blank or white pad still reads
// as blank or white in an overlay that draws light keys and dark keys differently.
// Writes _hsl_r / _hsl_g / _hsl_b, exactly like hsl_to_rgb.
function swing_color_pad_hsl(pad, s, l) local(_h) (
  _h = swing_color_pad_hue(pad);
  _h < 0 ? ( _hsl_r = _hsl_g = _hsl_b = (_h <= -1.5 ? l * 0.34 : min(1, l * 1.18)); )
         : hsl_to_rgb(_h, s, l);
);

// hsl_to_rgb's maths (rk_drumkit_dsp) written into _dst[0..2] instead of the shared _hsl_r / _hsl_g / _hsl_b: the
// rebuild runs on @block too (the window-closed mirror, Swing_ReaKit), while @gfx's painters call hsl_to_rgb every
// frame, so a rebuild that read the globals back could take another hue's G and B for a pad, and col_dirty was
// clear by then (LIB327). Keep in step with hsl_to_rgb.
function swing_color_hsl_at(h, s, l, _dst)
local(_c, _x, _m, _hp, _r1, _g1, _b1, _hp_mod2)
(
  _c = (1.0 - abs(2.0 * l - 1.0)) * s;
  _hp = h * 6.0;
  _hp_mod2 = _hp - floor(_hp * 0.5) * 2.0;
  _x = _c * (1.0 - abs(_hp_mod2 - 1.0));
  _r1 = 0; _g1 = 0; _b1 = 0;
  _hp < 1 ? ( _r1 = _c; _g1 = _x; ) :
  _hp < 2 ? ( _r1 = _x; _g1 = _c; ) :
  _hp < 3 ? ( _g1 = _c; _b1 = _x; ) :
  _hp < 4 ? ( _g1 = _x; _b1 = _c; ) :
  _hp < 5 ? ( _r1 = _x; _b1 = _c; ) :
             ( _r1 = _c; _b1 = _x; );
  _m = l - _c * 0.5;
  _dst[0] = _r1 + _m;
  _dst[1] = _g1 + _m;
  _dst[2] = _b1 + _m;
);

// `_ct` = the drum-type matcher's scratch string: #_ct_tmp on @gfx and @init (swing_color_rebuild), #_ct_blk on
// @block (swing_color_rebuild_blk) -- the two run at once and a string torn between them named the wrong
// category (LIB327).
function swing_color_rebuild_s(_ct)
local(_i, _h, _cb, _eff_s, _l, _i_s)
(
  // Apply auto-color if active
  col_auto_mode_id > 0 ? swing_color_apply_auto(col_auto_mode_id, _ct);

  // Theme S/L: the setter for the @gfx readers of _sc_s / _sc_l (Swing_ReaKit's col_dirty block), the pure
  // helpers for this rebuild's own use (locals: no shared cell read, LIB327).
  swing_color_get_theme_sl(col_theme_id);
  _eff_s = swing_color_base_s() * col_intensity;
  _l = swing_color_base_l();

  // Publish effective S/L to gmem so the browser can match the JSFX
  // pad-face colors exactly (theme + intensity, not a fixed S=0.75/L=0.55).
  gmem[GS_COL_EFFECTIVE_S] = _eff_s;
  gmem[GS_COL_EFFECTIVE_L] = _l;

  _i = 0; loop(NUM_PADS,
    _i_s = swing_bp(_i);
    // Hue source: auto buffer or manual p_color
    _h = col_auto_mode_id > 0 ? col_auto_hue[_i] : p_color[_i_s];

    // Blank pads render in the neutral dark-grey "black" achromatic special
    // (_h = -2 → handled by the _h <= -1.5 branch below) instead of a vivid
    // assigned hue, so an empty pad looks empty everywhere it's drawn.
    // Playable = sample OR enabled synth — a synth-only pad is NOT blank
    // (the all-black synth pads bug, 2026-07-29).
    !pad_is_playable(_i_s) ? _h = -2;

    _cb = _i * 3;
    _h < 0 ? (
      // Achromatic specials: -1 = white, -2 = black
      _h <= -1.5 ? (
        col_rgba[_cb] = 0.20; col_rgba[_cb+1] = 0.20; col_rgba[_cb+2] = 0.22;
        col_rgba_dim[_cb] = 0.15; col_rgba_dim[_cb+1] = 0.15; col_rgba_dim[_cb+2] = 0.16;
      ) : (
        col_rgba[_cb] = 0.82; col_rgba[_cb+1] = 0.82; col_rgba[_cb+2] = 0.85;
        col_rgba_dim[_cb] = 0.44; col_rgba_dim[_cb+1] = 0.44; col_rgba_dim[_cb+2] = 0.45;
      );
    ) : (
      // Normal HSL → RGB, straight into the pad's cells (no shared scratch: LIB327)
      swing_color_hsl_at(_h, _eff_s, _l, col_rgba + _cb);
      col_rgba_dim[_cb]     = col_rgba[_cb]     * 0.35 + 0.15;
      col_rgba_dim[_cb + 1] = col_rgba[_cb + 1] * 0.35 + 0.15;
      col_rgba_dim[_cb + 2] = col_rgba[_cb + 2] * 0.35 + 0.15;
    );

    _i += 1;
  );

  col_dirty = 0;
);
function swing_color_rebuild()     ( swing_color_rebuild_s(#_ct_tmp); );   // @gfx and @init
function swing_color_rebuild_blk() ( swing_color_rebuild_s(#_ct_blk); );   // @block's window-closed mirror (Swing_ReaKit)

// ─── Color panel UI (inline below COLORS button) ──────────────────────
function swing_color_draw_panel(_cp_x, _cp_y, _cp_w)
local(_row_h, _row_y, _ti, _tx, _tw_btn, _tw_m, _th_m, _lbl,
      _is_active, _bar_x, _bar_w, _bar_h, _fill_w, _knob_x,
      _mi, _mx_lbl, _slider_id, _lp_pub, _lp_base, _lp_live)
(
  _row_h = 24;

  // ── Row 1+2: AUTO-COLOR mode (4 buttons: Off / DrumType / Output / Rainbow) ──
  // Themes and palettes were removed in v43. The panel draws, top to bottom:
  // auto-color mode (these rows), MONO (Row 2), PAD FACE (Row 3), LANE TRACKS
  // (Row 4) and Intensity (Row 5).
  _row_y = _cp_y + 4;
  rk_font(1, 8, 0);
  gfx_set(0.85, 0.92, 0.95, 1.0);
  gfx_x = _cp_x + 4; gfx_y = _row_y;
  gfx_drawstr("AUTO-COLOR");

  _row_y += 12;
  _tw_btn = ((_cp_w - 12) / 3)|0;
  _mi = 0; loop(COL_NUM_AUTO_MODES,
    _tx = _cp_x + 4 + (_mi % 3) * (_tw_btn + 2);
    _mi >= 3 ? _row_y = _cp_y + 4 + 12 + 16;
    _is_active = col_auto_mode_id == _mi;

    _is_active ? (
      gfx_set(0.15, 0.65, 0.55, 0.9);
    ) : (
      gfx_set(0.15, 0.25, 0.30, 0.8);
    );
    gfx_rect(_tx, _row_y, _tw_btn, 14);

    _mi == 0 ? _mx_lbl = "Off" :
    _mi == 1 ? _mx_lbl = "DrumType" :
    _mi == 2 ? _mx_lbl = "Output" :
               _mx_lbl = "Rainbow";
    rk_font(1, 9, 0);
    // Brighter inactive text for readability (was 0.70/0.85/0.88 at 0.8α).
    _is_active ? gfx_set(1, 1, 1, 1) : gfx_set(0.92, 0.96, 0.98, 1.0);
    gfx_measurestr(_mx_lbl, _tw_m, _th_m);
    gfx_x = _tx + (_tw_btn - _tw_m) * 0.5;
    gfx_y = _row_y + (14 - _th_m) * 0.5;
    gfx_drawstr(_mx_lbl);

    // mark_dirty_kit: the mode, Mono and Intensity are serialized, so an edit here must raise the project-dirty flag
    // and the kit's SAVE dot as the COLORS big view's own buttons do (rk_swing_ui_colors); until 2026-10-26 a
    // session that changed only these closed without a save prompt and reopened in the old mode (LIB328).
    mx >= _tx && mx <= _tx + _tw_btn && my >= _row_y && my <= _row_y + 14 && lmb_down ? (
      col_auto_mode_id = _mi;
      col_dirty = 1; mark_dirty_kit();
    );

    _mi += 1;
  );

  // ── Row 2: MONO toggle (single button — grayscale vs full color) ──
  _row_y = _cp_y + 4 + 12 + 16 + 18;
  rk_font(1, 8, 0);
  gfx_set(0.85, 0.92, 0.95, 1.0);
  gfx_x = _cp_x + 4; gfx_y = _row_y;
  gfx_drawstr("MONO");

  _row_y += 12;
  _tx = _cp_x + 4;
  _tw_btn = _cp_w - 8;
  col_mono ? (
    gfx_set(0.65, 0.65, 0.68, 0.9);  // grayscale-themed active state
  ) : (
    gfx_set(0.15, 0.25, 0.30, 0.8);
  );
  gfx_rect(_tx, _row_y, _tw_btn, 14);

  _mx_lbl = col_mono ? "Mono ON" : "Mono OFF";
  rk_font(1, 9, 'b');
  col_mono ? gfx_set(1, 1, 1, 1) : gfx_set(0.92, 0.96, 0.98, 1.0);
  gfx_measurestr(_mx_lbl, _tw_m, _th_m);
  gfx_x = _tx + (_tw_btn - _tw_m) * 0.5;
  gfx_y = _row_y + (14 - _th_m) * 0.5;
  gfx_drawstr(_mx_lbl);

  mx >= _tx && mx <= _tx + _tw_btn && my >= _row_y && my <= _row_y + 14 && lmb_down ? (
    col_mono = !col_mono;
    col_dirty = 1; mark_dirty_kit();   // serialized: see the mode buttons above (LIB328)
  );

  // ── Row 3: PAD FACE (waveform vs category icon in the pad centre) ──
  // slider25 pad_icon_mode: 0 Waveform / 1 Icon. FX-chunk persisted hidden
  // slider (slider22 precedent): set the named var, slider_automate the token,
  // mark_dirty for the chunk-diff undo.
  _row_y = _cp_y + 4 + 12 + 16 + 18 + 12 + 16 + 4;
  rk_font(1, 8, 0);
  gfx_set(0.85, 0.92, 0.95, 1.0);
  gfx_x = _cp_x + 4; gfx_y = _row_y;
  gfx_drawstr("PAD FACE");

  _row_y += 12;
  _mi = 0;
  loop(2,
    _tw_btn = ((_cp_w - 8) / 2)|0;
    _tx = _cp_x + 4 + _mi * _tw_btn;
    _is_active = (pad_icon_mode|0) == _mi;
    _is_active ? gfx_set(0.20, 0.65, 0.70, 0.9) : gfx_set(0.15, 0.25, 0.30, 0.8);
    gfx_rect(_tx, _row_y, _tw_btn - 2, 14);
    _mx_lbl = _mi == 0 ? "Waveform" : "Icon";
    rk_font(1, 9, 0);
    _is_active ? gfx_set(1, 1, 1, 1) : gfx_set(0.92, 0.96, 0.98, 1.0);
    gfx_measurestr(_mx_lbl, _tw_m, _th_m);
    gfx_x = _tx + (_tw_btn - 2 - _tw_m) * 0.5;
    gfx_y = _row_y + (14 - _th_m) * 0.5;
    gfx_drawstr(_mx_lbl);
    mx >= _tx && mx <= _tx + _tw_btn - 2 && my >= _row_y && my <= _row_y + 14 && lmb_down ? (
      pad_icon_mode = _mi; slider_automate(slider25); mark_dirty();
    );
    _mi += 1;
  );

  // ── Row 4: LANE TRACKS — who owns the multi-out/MIDI lane track colors ──
  // Pure VIEW over the bridge-owned P_EXT policy (see Spec_Lane_Color_
  // Ownership.md): current mode is read from the per-slot PUB cell the bridge
  // republishes every identity pass; a click posts a request into the REQ
  // mailbox (payload FIRST, flag LAST) that the bridge consumes and writes to
  // P_EXT:EON_LANE_COLOR_POLICY on this track. Nothing here is serialized —
  // no ser_ver involvement. Greyed out until a bridge has published (fresh
  // instance, no bridge running, or pre-identity build).
  _row_y = _cp_y + 4 + 12 + 16 + 18 + 12 + 16 + 4 + 12 + 16 + 4;
  rk_font(1, 8, 0);
  gfx_set(0.85, 0.92, 0.95, 1.0);
  gfx_x = _cp_x + 4; gfx_y = _row_y;
  gfx_drawstr("LANE TRACKS");

  _row_y += 12;
  _lp_base = INST_INCMD_BASE + _reg_my_slot * INST_INCMD_STRIDE;
  _lp_pub  = _reg_my_slot >= 0 ? gmem[_lp_base + INCMD_LANEPOL_PUB] : 0;   // 0=unpublished 1=swing 2=reaper 3=none
  _lp_live = _lp_pub >= 1 && gmem[KIT_GMEM_BRIDGE_ALIVE] > 0;
  _tw_btn = ((_cp_w - 12) / 3)|0;
  _mi = 0; loop(3,
    _tx = _cp_x + 4 + _mi * (_tw_btn + 2);
    _is_active = _lp_live && _lp_pub == _mi + 1;
    _is_active ? (
      gfx_set(0.15, 0.65, 0.55, 0.9);
    ) : (
      gfx_set(0.15, 0.25, 0.30, _lp_live ? 0.8 : 0.35);
    );
    gfx_rect(_tx, _row_y, _tw_btn, 14);
    _mi == 0 ? _mx_lbl = "Swing" :
    _mi == 1 ? _mx_lbl = "REAPER" :
               _mx_lbl = "None";
    rk_font(1, 9, 0);
    _is_active ? gfx_set(1, 1, 1, 1) : gfx_set(0.92, 0.96, 0.98, _lp_live ? 1.0 : 0.4);
    gfx_measurestr(_mx_lbl, _tw_m, _th_m);
    gfx_x = _tx + (_tw_btn - _tw_m) * 0.5;
    gfx_y = _row_y + (14 - _th_m) * 0.5;
    gfx_drawstr(_mx_lbl);
    _lp_live && mx >= _tx && mx <= _tx + _tw_btn && my >= _row_y && my <= _row_y + 14 && lmb_down ? (
      gmem[_lp_base + INCMD_LANEPOL_REQ + 1] = _mi + 1;  // payload FIRST
      gmem[_lp_base + INCMD_LANEPOL_REQ] = 1;            // flag LAST — bridge consumes + writes P_EXT
    );
    _mi += 1;
  );

  // ── Row 5: Intensity slider ──
  _row_y = _cp_y + 4 + 12 + 16 + 18 + 12 + 16 + 4 + 12 + 16 + 4 + 12 + 16 + 4;
  rk_font(1, 8, 0);
  gfx_set(0.85, 0.92, 0.95, 1.0);
  gfx_x = _cp_x + 4; gfx_y = _row_y;
  gfx_drawstr("INTENSITY");

  _bar_x = _cp_x + 4;
  _bar_w = _cp_w - 40;
  _bar_h = 10;
  _row_y += 12;

  // Background track
  gfx_set(0.10, 0.18, 0.22, 1);
  gfx_rect(_bar_x, _row_y, _bar_w, _bar_h);

  // Filled portion
  _fill_w = (col_intensity * _bar_w)|0;
  gfx_set(0.20, 0.65, 0.70, 1);
  gfx_rect(_bar_x, _row_y, _fill_w, _bar_h);

  // Knob/handle
  _knob_x = _bar_x + _fill_w;
  gfx_set(0.90, 0.92, 0.90, 1);
  gfx_rect(_knob_x - 2, _row_y - 1, 5, _bar_h + 2);

  // Percentage label
  rk_font(1, 8, 0);
  gfx_set(0.70, 0.90, 0.92, 1);
  gfx_x = _bar_x + _bar_w + 4;
  gfx_y = _row_y;
  sprintf(#_int_pct, "%d%%", (col_intensity * 100 + 0.5)|0);
  gfx_drawstr(#_int_pct);

  // Drag interaction (ID 260)
  _slider_id = 260;
  active_id == _slider_id ? ( LMB ? (
    col_intensity = max(0.0, min(1.0, (mx - _bar_x) / _bar_w));
    col_dirty = 1;
  ) : ( active_id = -1; mark_dirty_kit(); ); );   // once, on the release, as the big view's hue bar does (LIB328)
  active_id == -1 && mx >= _bar_x - 2 && mx <= _bar_x + _bar_w + 2 &&
  my >= _row_y - 2 && my <= _row_y + _bar_h + 2 && lmb_down ? (
    active_id = _slider_id;
    col_intensity = max(0.0, min(1.0, (mx - _bar_x) / _bar_w));
    col_dirty = 1;
  );

  // Return total panel height
  _row_y + _bar_h + 6 - _cp_y;
);
