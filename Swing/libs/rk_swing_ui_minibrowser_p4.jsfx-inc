// rk_swing_ui_minibrowser_p4.jsfx-inc -- part 4 of rk_swing_ui_minibrowser.jsfx-inc (4 parts), cut at a function boundary by
// .dev_tests/split_big_incs.py: REAPER's load time grows with the square of a file's size. Edit freely;
// keep each file under about 40 KB.

// ⚠️ @init IS LOAD-BEARING (.docs/wiki/02-file-structure.md).
@init

// ── The side slot's WIDTH HANDLE (the user, 2026-10-22: "a handle for the side panel that will allow it to adjust like
// the bottom's handle" / "in between the pads and where the pad FX is"): the SEAM between the pads and the side panel
// (rk_swing_ui_padfx_side swing_side_seam_draw paints it; this reads it): drag LEFT for a wider slot, right for
// narrower, the wheel for small steps; a right-click puts the panels' own widths back (side_w 0). side_w is the slot's
// panels' width in canvas px (gate 83); the slot's cap follows it and the pads give or take the difference inside the
// window that is there (never a window resize). The frame's copies of the mouse (mx, my, the stash), so the rig's fake mouse drives
// it; the gate keeps the column claimed while a drag is in flight. (x, y, w, h) = the seam; _sh_open: the slot has a
// width to drag. Returns 1 while the seam is under the mouse. Called once a frame from the side slot's draw. ──
function swing_side_handle(_sh_x, _sh_y, _sh_w, _sh_h, _sh_open) local(_sh_hot) (
  _sh_hot = (mx >= _sh_x && mx < _sh_x + _sh_w && my >= _sh_y && my < _sh_y + _sh_h) || swing_side_seam_ext(mx, my);   // + its reach over the pads' margin
  side_cur_want = 0;
  _sh_open ? (
    _sh_hot && _fb_g_lmbdown ? ( side_gdrag = 1; side_gdrag_x0 = mx; side_gdrag_w0 = max(0, fb_w_cur - FB_GUTTER_W - swing_px(FB_SEAM_W)); );
    // the ceiling is a sanity bound only (8000 canvas px; it was 2000, under what a docker across a wide screen gives:
    // 2026-10-27, docked the pads' minimum is the limit, swing_side_share_w); the cap clamps what draws
    side_gdrag && _fb_g_lmbclick ? side_w = max(swing_px(SIDE_W_MIN_B), min(8000, side_gdrag_w0 + (side_gdrag_x0 - mx)));
    !_fb_g_lmbclick ? side_gdrag = 0;
    // the wheel steps from the width SHOWN: a width dragged past the limit (stored, not drawn) took notches that moved nothing
    _sh_hot && _fb_g_wheel != 0 ? side_w = max(swing_px(SIDE_W_MIN_B), min(8000, (side_w > 0 ? min(side_w, max(0, fb_w_cur - FB_GUTTER_W - swing_px(FB_SEAM_W))) : max(0, fb_w_cur - FB_GUTTER_W - swing_px(FB_SEAM_W))) + (_fb_g_wheel > 0 ? swing_px(20) : -swing_px(20))));
    _sh_hot && _fb_g_rmbdown ? side_w = 0;
    (_sh_hot || side_gdrag) ? side_cur_want = 32644;   // the left / right arrows (IDC_SIZEWE)
    _sh_hot ? swing_tooltip_check(1493, "The side panel's width: drag left for wider, right for narrower (wheel for small steps); right-click for the panels' own widths. The pads give the room; the window stays.");
  ) : side_gdrag = 0;
  _sh_hot && _sh_open;
);

// ══ THE REDRAW'S PARTS (P1a, 2026-10-27; spec §2) ═════════════════════════════════════════════════════════════════
// The breadcrumb, the deck's facts, the transport and the card, each its own function so swing_fb_draw stays a layout.
// All draw from the palette swing_fb_ground computed this frame.

// One run of the published cwd's cells, [a, b), into string dest.
function swing_fb_cwdstr(dest, a, b) local(k) (
  strcpy(dest, "");
  k = a; loop(max(0, b - a), str_setchar(dest, strlen(dest), max(32, _fb_cwd[k])); k += 1; );
);

// The breadcrumb: the folder you are in, its parents dim, the separators lighter, the leaf bold. Segments are the runs
// between "\" and "/" (a "parent / leaf" label splits the same way, its spaces trimmed). Parents that do not fit drop
// off the FRONT -- never a "..." prefix: three dots in front read as an overflow menu (the bridge's own rule for this
// string) -- and a leaf wider than the room is cut at a character.
function swing_fb_crumbs(bx, by, bw, bh) local(n, i, c, s0, k, first, tot, tw, th, sepw, yy) (
  n = 0; i = 0; s0 = 0;
  loop(_fb_cwd_len + 1,
    c = i < _fb_cwd_len ? _fb_cwd[i] : 47;
    (c == 92 || c == 47) ? (
      k = i;
      while (k > s0 && _fb_cwd[k - 1] == 32) ( k -= 1; );
      while (s0 < k && _fb_cwd[s0] == 32) ( s0 += 1; );
      k > s0 && n < 32 ? ( _fb_cseg[n * 2] = s0; _fb_cseg[n * 2 + 1] = k; n += 1; );
      s0 = i + 1;
    );
    i += 1;
  );
  sepw = 14;
  n < 1 ? (
    swing_fb_font(FB_FS_HDR, 0); gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.5);
    swing_fb_clipstr("(no folder)", bx, by + (bh - gfx_texth) * 0.5, bw);
  ) : (
    // the leaf first, then the parents in front of it while they fit
    swing_fb_font(FB_FS_HDR, 1);
    swing_fb_cwdstr(#fb_cstr, _fb_cseg[(n - 1) * 2], _fb_cseg[(n - 1) * 2 + 1]);
    tw = 0; th = 0; gfx_measurestr(#fb_cstr, tw, th);
    tot = tw; first = n - 1;
    swing_fb_font(FB_FS_HDR, 0);
    while (first > 0 && (swing_fb_cwdstr(#fb_cstr, _fb_cseg[(first - 1) * 2], _fb_cseg[(first - 1) * 2 + 1]);
                         tw = 0; gfx_measurestr(#fb_cstr, tw, th); tot + sepw + tw <= bw)) (
      tot += sepw + tw; first -= 1;
    );
    gfx_x = bx;
    k = first;
    loop(n - first,
      k < n - 1 ? (
        swing_fb_font(FB_FS_HDR, 0); gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.50);
        swing_fb_cwdstr(#fb_cstr, _fb_cseg[k * 2], _fb_cseg[k * 2 + 1]);
        gfx_y = by + (bh - gfx_texth) * 0.5; gfx_drawstr(#fb_cstr);
        gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.28);      // the separator: a small light chevron
        c = gfx_x + sepw * 0.5; yy = by + bh * 0.5;
        gfx_line(c - 2, yy - 3, c + 1, yy, 1); gfx_line(c + 1, yy, c - 2, yy + 3, 1);
        gfx_x += sepw;
      ) : (
        swing_fb_font(FB_FS_HDR, 1); gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.95);
        swing_fb_cwdstr(#fb_cstr, _fb_cseg[k * 2], _fb_cseg[k * 2 + 1]);
        swing_fb_clipstr(#fb_cstr, gfx_x, by + (bh - gfx_texth) * 0.5, max(0, bx + bw - gfx_x));
      );
      k += 1;
    );
  );
);

// The deck's facts: "2 ch . 44.1 kHz . 0.4 s . 72 KB" in a small face, a drawn dot between (no font is trusted with a
// middle dot: P7's question), wrapping to a second line when the card is narrow. The "longer than a pad holds" warning
// keeps its place at the end, warm. draw 0 = measure only. Returns the lines it takes (1 or 2).
function swing_fb_facts(p, fx, fy, maxw, lh, draw) local(nt, k, tw, th, xx, line, ms, sr, s) (
  swing_fb_font(FB_FS_STAT - 1, 0);
  sr = p[FB_R_SR]; ms = p[FB_R_MS];
  nt = (p[FB_R_KIND] > 0 || p[FB_R_EXT] == 10 || sr <= 0) ? 1
     : 4 + ((p[FB_R_KIND] == 0 && p[FB_R_EXT] != 10 && ms > SLOT_SIZE * 500 / sr) ? 1 : 0);
  xx = fx; line = 0; k = 0;
  loop(nt,
    p[FB_R_KIND] > 0 ? strcpy(#fb_tok, "folder") :
    p[FB_R_EXT] == 10 ? strcpy(#fb_tok, "SFZ kit - import it from the big browser") :   // nothing in the strip loads one (sweep BRW40)
    sr <= 0 ? strcpy(#fb_tok, "sample") :
    k == 0 ? sprintf(#fb_tok, "%d ch", p[FB_R_CH]) :
    k == 1 ? ( (sr % 1000) == 0 ? sprintf(#fb_tok, "%d kHz", (sr / 1000) | 0) : sprintf(#fb_tok, "%.1f kHz", sr / 1000); ) :
    k == 2 ? ( s = (ms / 1000) | 0;
               ms >= 60000 ? sprintf(#fb_tok, "%d:%d%d", (s / 60) | 0, ((s % 60) / 10) | 0, s % 10)
                           : sprintf(#fb_tok, "%.1f s", ms / 1000); ) :
    k == 3 ? ( p[FB_R_SIZE_KB] >= 1000 ? sprintf(#fb_tok, "%.1f MB", p[FB_R_SIZE_KB] / 1024) : sprintf(#fb_tok, "%d KB", p[FB_R_SIZE_KB]); ) :
             strcpy(#fb_tok, "longer than a pad holds");
    // Before the drop (Spec_Swing_Pad_Banks §8.1, 2026-09-23): a file longer than a pad holds at its own rate
    // (SLOT_SIZE cells of interleaved stereo) is trimmed on load -- said here, where it can still be avoided.
    tw = 0; th = 0; gfx_measurestr(#fb_tok, tw, th);
    xx > fx && xx + 12 + tw > fx + maxw && line == 0 ? ( line = 1; xx = fx; );   // a token that does not fit goes down
    xx > fx ? (
      draw ? ( gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.32); gfx_circle(xx + 6, fy + line * lh + lh * 0.5, 1.5, 1, 1); );
      xx += 12;
    );
    draw ? (
      k == 4 ? gfx_set(fb_wrm_r, fb_wrm_g, fb_wrm_b, 1) : gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.62);
      swing_fb_clipstr(#fb_tok, xx, fy + line * lh + (lh - th) * 0.5, max(0, fx + maxw - xx));
    );
    xx += tw;
    k += 1;
  );
  line + 1;
);

// The transport: a round PLAY (STOP while it plays), the LOOP pill, VOL at the right. These are real controls, not a
// side effect of loading: the browser has its own player, so PLAY means play and STOP means stop. A row too narrow
// for all of them takes two (VOL goes down); `draw` 0 = measure only. Returns the rows. The knob's centre goes out in
// _fb_kx / _fb_ky: its interaction stays in swing_fb_draw, where the hand-over writes a LOCAL `lmb`.
FB_TR_H = 30;     // one transport row
FB_ST_W = 78;     // P5's stepper: minus, the value, plus
function swing_fb_transport(ix, yt, iw, draw, edge) local(lw, tw, th, need, rows, cx, cy, hot, vlw, stx, sty, volrow, need2) (
  swing_fb_font(FB_FS_BTN, 1);
  tw = 0; th = 0; gfx_measurestr("LOOP", tw, th);
  lw = max(44, tw + 16);
  swing_fb_font(10, 1);
  vlw = 0; gfx_measurestr("VOL", vlw, th);
  // one row for PLAY, LOOP, the pitch stepper (P5) and VOL when it fits; else the stepper goes down a row, and when
  // even PLAY, LOOP and VOL do not fit, VOL goes down beside it
  need  = 28 + 8 + lw + 8 + FB_ST_W + 8 + vlw + 6 + 26;
  need2 = 28 + 8 + lw + 8 + vlw + 6 + 26;
  rows = need > iw ? 2 : 1;
  volrow = (rows == 1 || need2 <= iw) ? 0 : 1;
  stx = rows == 1 ? ix + 34 + lw + 8 : ix;
  sty = rows == 1 ? yt : yt + FB_TR_H;
  draw ? (
    // ── P5: the PITCH NUDGE (spec §7): minus, the value in semitones, plus; one semitone a step, -12..+12; a double-click
    //    on the value (or the wheel over it) -- 0. The audition only: @block makes the rate's multiplier from it, a load
    //    never carries it, and it is not saved. ──
    swing_fb_btn(stx, sty + 6, 20, FB_TR_H - 12, "-", 0, edge) ? fb_prv_semi = max(-12, fb_prv_semi - 1);
    swing_fb_btn(stx + FB_ST_W - 20, sty + 6, 20, FB_TR_H - 12, "+", 0, edge) ? fb_prv_semi = min(12, fb_prv_semi + 1);
    hot = mouse_x >= stx + 20 && mouse_x < stx + FB_ST_W - 20 && mouse_y >= sty + 4 && mouse_y < sty + FB_TR_H - 4;
    hot && edge ? ( time_precise() - _fb_semi_t < 0.35 ? fb_prv_semi = 0; _fb_semi_t = time_precise(); );
    hot && _fb_g_wheel != 0 ? ( fb_prv_semi = max(-12, min(12, fb_prv_semi + (_fb_g_wheel > 0 ? 1 : -1))); _fb_g_wheel = 0; );
    hot ? swing_tooltip_check(1703, "The audition's pitch, in semitones (-12..+12; double-click for 0). The audition only: a load keeps the file's own pitch.");
    swing_fb_font(FB_FS_BTN, fb_prv_semi != 0 && FB_FS_BTN + fb_fsz >= 10);   // digits under 10 px stay regular (wiki §4.7)
    fb_prv_semi == 0 ? strcpy(#fb_semi, "0 st") : sprintf(#fb_semi, fb_prv_semi > 0 ? "+%d st" : "%d st", fb_prv_semi);
    tw = 0; gfx_measurestr(#fb_semi, tw, th);
    fb_prv_semi != 0 ? gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, 1) : gfx_set(_fb_tc, _fb_tc, _fb_tc, hot ? 0.95 : 0.62);
    gfx_x = stx + (FB_ST_W - tw) * 0.5; gfx_y = sty + (FB_TR_H - th) * 0.5; gfx_drawstr(#fb_semi);
    // PLAY / STOP
    cx = ix + 13; cy = yt + FB_TR_H * 0.5;
    hot = (mouse_x - cx) * (mouse_x - cx) + (mouse_y - cy) * (mouse_y - cy) <= 14 * 14;
    gfx_set(fb_acc_r * (hot ? 1.08 : 1), fb_acc_g * (hot ? 1.08 : 1), fb_acc_b * (hot ? 1.04 : 1), 1);
    gfx_circle(cx, cy, 13, 1, 1);
    gfx_set(fb_acc_t, fb_acc_t, fb_acc_t, 1);
    _prv_on ? gfx_rect(cx - 4, cy - 4, 8, 8) : gfx_triangle(cx - 3, cy - 6, cx - 3, cy + 6, cx + 6, cy);
    hot && edge ? (
      // PLAY on a LONG file whose stream has ended or was cancelled: frame 0 has left the
      // ring, so the row is asked for again (verb 12, the row the player last loaded). A
      // short file, or a long one still streaming, replays / restarts from the ring.
      _prv_on ? fb_prv_cmd = 2 :
      (_prv_long && fb_prv_name >= 0) ? swing_fb_request(12, fb_prv_name, -1) : fb_prv_cmd = 1;
    );
    swing_fb_btn(ix + 34, yt + 6, lw, FB_TR_H - 12, "LOOP", fb_prv_loop, edge) ? fb_prv_loop = !fb_prv_loop;
    // VOL: the knob at the right end of its row, its word in front of it
    _fb_kx = ix + iw - 13; _fb_ky = volrow ? yt + FB_TR_H + FB_TR_H * 0.5 : yt + FB_TR_H * 0.5;
    swing_fb_font(10, 1);
    gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.5);
    gfx_x = _fb_kx - 13 - 6 - vlw; gfx_y = _fb_ky - th * 0.5; gfx_drawstr("VOL");
  );
  rows;
);

// The deck as a CARD: rounded, a hairline border, a faint shadow. Its top line: the file's name, bold; the facts under
// it; the wave in the accent (the peaks' outline, the loudness body inside it at about 28 %, on a pale track, the
// playhead warm); the transport at the bottom. (cx0, cy0, cw, ch) = the card; p = the selected row or 0; wv = the
// wave's height (0: no room); nf = the facts' lines; trn = the transport's rows.
function swing_fb_card(cx0, cy0, cw, ch, p, wv, nf, trn, edge)
  local(ix, iw, yy, lh1, lh2, _pkb, _wx, _wy, _ww, _wh, _pst, _plh, _pnx, _pc, _ply, _pmid, _pi, _pk0, _pk1,
        _pmx, _pmn, _pbd, _pj, _pkv, _pcx, _pcw, _ppx, _ptop, _pbot, ow, oh, cw2, infw, nw, nh, pw2, _pyt, _pyb,
        cfw, fx, fhot)
(
  // the faint shadow, the hairline border, the card
  gfx_set(0, 0, 0, fb_light ? 0.07 : 0.22); gfx_rect(cx0 + 6, cy0 + ch, cw - 12, 1);
  gfx_set(0, 0, 0, fb_light ? 0.035 : 0.11); gfx_rect(cx0 + 9, cy0 + ch + 1, cw - 18, 1);
  gfx_set(fb_hln_r, fb_hln_g, fb_hln_b, 1); swing_fb_rr(cx0, cy0, cw, ch, 9);
  gfx_set(fb_crd_r, fb_crd_g, fb_crd_b, 1); swing_fb_rr(cx0 + 1, cy0 + 1, cw - 2, ch - 2, 8);
  ix = cx0 + 10; iw = cw - 20;
  lh1 = FB_FS_ROW + fb_fsz + 7;
  lh2 = FB_FS_STAT + fb_fsz + 3;
  yy = cy0 + 8;
  // ── FOLDED (2026-10-29, the owner: a collapsible bottom card) ── the narrow card's arrow at its top line's right end
  // folds it to that line (the name, "n of N"; swing_fb_draw gives the list the room) and opens it again; the top line
  // keeps the arrow's room (cfw), the lines under it the card's whole width. Not in the wide layout: its card is a
  // column of its own. fb_card_fold is saved (gate 88) and kept by an undo (view).
  cfw = _fb_cnarrow ? 18 : 0;
  _fb_cnarrow ? (
    fx = cx0 + cw - 10 - 14;
    fb_card_ax = fx + 7; fb_card_ay = yy + lh1 * 0.5;   // the arrow's centre, for the rig (mb_test k06)
    fhot = mouse_x >= fx - 2 && mouse_x < cx0 + cw - 4 && mouse_y >= cy0 + 2 && mouse_y < cy0 + 8 + lh1 + 2;
    gfx_set(_fb_tc, _fb_tc, _fb_tc, fhot ? 0.90 : 0.45);
    fb_card_fold ? gfx_triangle(fx + 4, yy + lh1 * 0.5 - 5, fx + 4, yy + lh1 * 0.5 + 5, fx + 10, yy + lh1 * 0.5)   // ▸ folded
                 : gfx_triangle(fx + 2, yy + lh1 * 0.5 - 3, fx + 12, yy + lh1 * 0.5 - 3, fx + 7, yy + lh1 * 0.5 + 3); // ▾ open
    fhot ? swing_tooltip_check(1704, fb_card_fold ? "Open the card (the sample's facts, its wave, PLAY)" : "Fold the card to one line: the list takes the room");
    fhot && edge ? fb_card_fold = !fb_card_fold;
    iw -= cfw;
  );
  // ── the shared command channel's watchdog ──
  // BROWSE, kit loads and every sample load are gated on `gmem[KIT_GMEM_CMD]
  // == 0` and do NOTHING, silently, when it is not. One stuck command makes
  // half the instrument look broken with no clue anywhere. Say so instead.
  _fb_cmd_stuck > 120 ? (
    swing_fb_font(FB_FS_STAT, 1);
    gfx_set(fb_wrm_r, fb_wrm_g, fb_wrm_b, 1);
    swing_fb_clipstr(sprintf(#fb_tok, "command channel busy (%d) - loads blocked", gmem[KIT_GMEM_CMD]), ix, yy + 2, iw);
  ) : p ? (
    // At the right, "n of N . Category" (P1b's count, P2's category; FMT 2): dropped when the name needs the room.
    swing_fb_font(FB_FS_STAT - 1, 0);
    strcpy(#fb_dord, ""); strcpy(#fb_dcat, "");
    _fb_fmt >= 2 && _fb_dkr == fb_sel + 1 && _fb_dko > 0 ? sprintf(#fb_dord, "%d of %d", _fb_dko, _fb_fshown);
    _fb_fmt >= 2 && p[FB_R_KIND] == 0 && p[FB_R_CAT] > 0 ? eon_catname(#fb_dcat, p[FB_R_CAT] - 1);
    ow = 0; oh = 0; strlen(#fb_dord) ? gfx_measurestr(#fb_dord, ow, oh);
    cw2 = 0; strlen(#fb_dcat) ? gfx_measurestr(#fb_dcat, cw2, oh);
    infw = ow + cw2 + ((ow > 0 && cw2 > 0) ? 12 : 0);
    // the name, bold; in front of it the group's trimmed prefix, dim, when it fits (P1b: the row shows the remainder)
    swing_fb_font(FB_FS_ROW, 1);
    swing_fb_rowstr(p, #fb_dname, 0, min(p[FB_R_LEN], FB_R_NAME_MAX));
    nw = 0; nh = 0; gfx_measurestr(#fb_dname, nw, nh);
    infw > 0 && nw + 14 + infw > iw ? infw = 0;
    pw2 = 0;
    strlen(#fb_dpre) && p[FB_R_KIND] == 0 ? (
      swing_fb_font(FB_FS_ROW, 0);
      gfx_measurestr(#fb_dpre, pw2, nh);
      pw2 + nw + (infw > 0 ? infw + 14 : 0) > iw ? pw2 = 0;
      pw2 > 0 ? ( gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.45); gfx_x = ix; gfx_y = yy + (lh1 - gfx_texth) * 0.5; gfx_drawstr(#fb_dpre); );
    );
    swing_fb_font(FB_FS_ROW, 1);
    gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.95);
    swing_fb_clipstr(#fb_dname, ix + pw2, yy + (lh1 - gfx_texth) * 0.5, iw - pw2 - (infw > 0 ? infw + 14 : 0));
    infw > 0 ? (
      swing_fb_font(FB_FS_STAT - 1, 0);
      gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.50);
      gfx_x = ix + iw - infw; gfx_y = yy + (lh1 - oh) * 0.5 + 1;
      ow > 0 ? gfx_drawstr(#fb_dord);
      ow > 0 && cw2 > 0 ? ( gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.32); gfx_circle(gfx_x + 6, yy + lh1 * 0.5 + 1, 1.5, 1, 1); gfx_x += 12; );
      cw2 > 0 ? ( gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.50); gfx_drawstr(#fb_dcat); );
    );
    iw += cfw; cfw = 0;   // the lines under the top one: the card's whole width
    !_fb_cfold ? swing_fb_facts(p, ix, yy + lh1 + 2, iw - _fb_rootw, lh2, 1);
    // P4: the root note, a pill at the facts line's right end ("root F#3"; "root -" when no pitch was found; nothing
    // while it is worked out, on a failure, or for an answer that names another row or listing)
    _fb_rootw > 0 && !_fb_cfold ? (
      swing_fb_mixset(fb_crd_r, fb_crd_g, fb_crd_b, fb_acc_r, fb_acc_g, fb_acc_b, fb_light ? 0.14 : 0.24);
      swing_fb_rr(ix + iw - _fb_rootw + 4, yy + lh1 + 2 + (lh2 - 16) * 0.5, _fb_rootw - 4, 16, 8);
      swing_fb_font(FB_FS_STAT - 1, 1);
      gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.85);
      ow = 0; gfx_measurestr(#fb_root, ow, oh);
      gfx_x = ix + iw - _fb_rootw + 4 + (_fb_rootw - 4 - ow) * 0.5; gfx_y = yy + lh1 + 2 + (lh2 - oh) * 0.5;
      gfx_drawstr(#fb_root);
      mouse_x >= ix + iw - _fb_rootw && mouse_x < ix + iw && mouse_y >= yy + lh1 && mouse_y < yy + lh1 + 2 + lh2
        ? swing_tooltip_check(1702, "The sample's root note (the pads' own detector). A dash: no clear pitch.");
    );
    // ── the wave: ALWAYS its place on the card ──
    // It holds its place whether or not a row is selected. A panel that appears
    // and disappears makes the whole strip jump every time you click, and an empty
    // frame reads as "nothing selected" perfectly well on its own.
    // Peaks over the track. Fetched once per SELECTION, never per row -- that is
    // what lets the list itself stay a plain list.
    // 2026-10-15 (the user: "can we draw the wave forms any better?"): the band
    // holds 512 columns and a loudness BODY per column (the bridge folds 8 finer
    // peaks into each: extremes -> the outline, their mean amplitude -> the body).
    // Drawn one column per PIXEL of the strip -- the old 128 bars stepped visibly --
    // and the preview's playhead over the file while it plays. No library: a
    // waveform is min / max per pixel, and the meter libs draw meters.
    wv >= 18 ? (
      _wx = ix; _wy = yy + lh1 + 2 + nf * lh2 + 6; _ww = iw; _wh = wv;
      swing_fb_mixset(fb_crd_r, fb_crd_g, fb_crd_b, fb_acc_r, fb_acc_g, fb_acc_b, fb_light ? 0.06 : 0.08);
      swing_fb_rr(_wx, _wy, _ww, _wh, 5);
      p[FB_R_KIND] == 0 && p[FB_R_EXT] != 10 ? (
        _pkb = EON_SWBPK_BASE + max(0, min(EON_SWBROWSE_SLOTS - 1, _reg_my_slot)) * EON_SWBPK_STRIDE;
        // ⭐ STEREO DRAWS AS STEREO. A stereo file gets two stacked lanes with a
        // hairline between them; mono keeps the full height and one lane. Folding
        // two channels into one hid the very thing you open a stereo sample to
        // look at -- and the facts line right above already says "2 ch", so a
        // single trace was actively contradicting it.
        _pst = p[FB_R_CH] >= 2 ? 1 : 0;
        _plh = _pst ? (_wh * 0.5 - 1) : _wh;
        _pnx = max(1, min(FB_PK_N, (_ww - 4) | 0));      // pixel columns: the track's width, at most the band's
        _pc  = 0;
        loop(_pst ? 2 : 1,
          _ply = _wy + _pc * (_wh * 0.5 + 1);
          _pmid = _ply + _plh * 0.5;
          gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.10);
          gfx_rect(_wx + 2, _pmid, _ww - 4, 1);              // this lane's centre line
          _pi = 0;
          loop(_pnx,
            // the band columns this pixel folds: [_pk0, _pk1)
            _pk0 = (_pi * FB_PK_N / _pnx) | 0;
            _pk1 = max(_pk0 + 1, ((_pi + 1) * FB_PK_N / _pnx) | 0);
            _pmx = -1; _pmn = 1; _pbd = 0; _pj = _pk0;
            loop(_pk1 - _pk0,
              _pkv = gmem[_pkb + _pc * 2 * FB_PK_N + _pj];           _pkv > _pmx ? _pmx = _pkv;
              _pkv = gmem[_pkb + _pc * 2 * FB_PK_N + FB_PK_N + _pj]; _pkv < _pmn ? _pmn = _pkv;
              _pbd += gmem[_pkb + 4 * FB_PK_N + _pc * FB_PK_N + _pj];
              _pj += 1;
            );
            _pbd /= (_pk1 - _pk0);
            _pcx = _wx + 2 + _pi * (_ww - 4) / _pnx;
            _pcw = max(1, (_ww - 4) / _pnx);
            _ptop = _pmid - max(0.5, _pmx * _plh * 0.48);
            _pbot = _pmid - min(-0.5, _pmn * _plh * 0.48);
            // the shape at a whisper, the loudness body inside it at ~28 %, the outline's two edges solid
            gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, _pc ? 0.10 : 0.12);
            gfx_rect(_pcx, _ptop, _pcw, max(1, _pbot - _ptop));
            _pbd > 0 ? (
              gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, _pc ? 0.24 : 0.28);
              gfx_rect(_pcx, _pmid - _pbd * _plh * 0.48, _pcw, max(1, _pbd * _plh * 0.96));
            );
            // the outline: one continuous line along the tops and one along the bottoms (a pixel per column reads as
            // dots wherever the shape moves faster than a pixel a column)
            gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, _pc ? 0.85 : 0.95);
            _pi > 0 ? ( gfx_line(_pcx - _pcw, _pyt, _pcx, _ptop, 1); gfx_line(_pcx - _pcw, _pyb, _pcx, _pbot - 1, 1); )
                    : ( gfx_rect(_pcx, _ptop, _pcw, 1); gfx_rect(_pcx, _pbot - 1, _pcw, 1); );
            _pyt = _ptop; _pyb = _pbot - 1;
            _pi += 1;
          );
          _pc += 1;
        );
        _pst ? (
          gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.12);
          gfx_rect(_wx + 2, _wy + _wh * 0.5, _ww - 4, 1);    // the channel split
        );
        // The playhead while the preview of THIS row plays: the player publishes its read
        // position every block (PP_PRV_RD, interleaved cells, climbing past one pass on a long
        // LOOP), shown as a fraction of one pass; the part already heard is tinted faintly.
        _prv_on && fb_prv_name == fb_sel && _prv_total_frames > 0 ? (
          _ppx = ((gmem[EON_PADPCM_HDR + PP_PRV_RD] * 0.5) % _prv_total_frames) / _prv_total_frames;
          gfx_set(fb_wrm_r, fb_wrm_g, fb_wrm_b, 0.10);
          gfx_rect(_wx + 2, _wy + 1, _ppx * (_ww - 4), _wh - 2);
          gfx_set(fb_wrm_r, fb_wrm_g, fb_wrm_b, 0.95);
          gfx_rect(_wx + 2 + _ppx * (_ww - 4), _wy + 1, 2, _wh - 2);
        );
      );
    );
  ) : (
    swing_fb_font(FB_FS_STAT, 0);
    gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.55);
    swing_fb_clipstr(_fb_fmt >= 2 ? sprintf(#fb_tok, "%d files", _fb_fshown) : sprintf(#fb_tok, "%d items", _fb_total), ix, yy + 2, iw);
    iw += cfw; cfw = 0;
    !_fb_cfold ? (
      swing_fb_font(FB_FS_STAT - 1, 0);
      gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.38);
      swing_fb_clipstr("Click a sample to hear it; drag it onto a pad", ix, yy + lh1 + 2, iw);
    );
    wv >= 18 ? (
      swing_fb_mixset(fb_crd_r, fb_crd_g, fb_crd_b, fb_acc_r, fb_acc_g, fb_acc_b, fb_light ? 0.06 : 0.08);
      swing_fb_rr(ix, yy + lh1 + 2 + nf * lh2 + 6, iw, wv, 5);
    );
  );
  iw += cfw;   // the stuck-command line kept the arrow's room too
  !_fb_cfold ? swing_fb_transport(ix, cy0 + ch - 6 - trn * FB_TR_H, iw, 1, edge);
);

function swing_fb_draw(x, y, w, h)
  local(gx, px, pw, i, ry, p, kind, nlen, ci, hot, sel, listy, listh,
        vis, maxs, alive, lmb, edge, ext, _lum, _tc, _gr, _gg, _gb,
        _dc, _dr, _di, _dcx, _dcy, _dox, _doy, _dpw, _dph,
        _fy, _rh, _tw, _th, _sx, _shot, _gy, _gi, _gw, _my, _dtk, _dtf,
        _wide, _hh, _bh, _fh, _cw, _lw, _bin, _sbw, _hr, _plw, _plx, _crx, _crw, _bh2, _rfx,
        _ciw, _lh1, _lh2, _nf, _trn, _cmin, _cx0, _cy0, _ch, _wv, _rowsfit, _rx1, _rp, _chh, _tagw, _foy, _lin, _fax, _faw, _oax, _oaw)
(
  // Ground colour is the user's choice. Default takes the pad TRAY, so the strip
  // reads as part of the chassis. LCD mode takes the theme's SCREEN instead --
  // that is the retro-hardware look, and on the SSL theme it is a light grey
  // panel, which is exactly the vibe rather than a bug.
  swing_fb_ground();   // the globals (the tree's own draw and the side slot read them); the locals below are this draw's copies
  _gr = _fb_gr; _gg = _fb_gg; _gb = _fb_gb; _tc = _fb_tc;
  _lum = _gr * 0.299 + _gg * 0.587 + _gb * 0.114;

  // Keys first, so a filter change is on the wire before the rows are drawn.
  swing_fb_menu_result();
  // ⛔⛔ SAY HELLO. A STRIP THAT COMES BACK OPEN NEVER ASKED FOR ANYTHING.
  // The bridge marks a slot `active` in ONE place -- eon_fb_handle_req, on the
  // first REQ_SEQ it has not seen -- and it only writes that slot's heartbeat
  // while it is active. Every swing_fb_request call site is behind a click, a
  // key or a drag; the chevron's is the one that used to open the conversation.
  // Since ser_ver 66 the strip RESTORES open, so on a project reload nobody
  // clicks anything: no request, no active slot, no heartbeat, and the face
  // reports "Browser bridge not running" at a bridge that is running perfectly.
  // ⭐ The tree has the identical bug one band over (ser_ver 67 restores fb_tree,
  // and only the TREE button posts a rebuild) -- which is why the rail came back
  // saying "No folders" rather than showing the drive it was left on.
  //
  // ⚠️⚠️ GUARDED ON `_reg_my_slot >= 0`. It starts at -1 and @block claims it on
  // first run, and swing_fb_band() CLAMPS with max(0, ...) -- so asking before
  // the claim would post this instance's request into SLOT 0, i.e. into another
  // Swing's mailbox. Waiting a frame costs nothing.
  // ⭐ ONCE PER SLOT, NOT ONCE PER LIFE (2026-10-27): `_fb_hello` holds the slot it was said in, plus one. A face can
  // leave that slot -- a peer takes it while this instance is away (swing_registry_check_owner), the copy duel mints a
  // new id, or @block's first claim lands after @gfx drew -- and the bridge heartbeats the new slot unasked because
  // the instance is live there (S7), so the dead-bridge re-ask below never fires. The rail stayed "No folders" and
  // the list showed the bridge's default folder instead of an answer (fbhello_e2e leg 3).
  fb_open && _fb_hello != _reg_my_slot + 1 && _reg_my_slot >= 0 ? (
    _fb_hello = _reg_my_slot + 1;
    swing_fb_request(0, 0, -1);
    fb_tree ? ( fbt_scroll = 0; _fbt_pagereq = -1; _fbt_flw = -1; swing_fb_tree_request(3, 0); );
  );


  // Keys: the filter box owns them while it has focus, otherwise the LIST does.
  // ⚠️ An embedded instance gets no keyboard at all, so neither runs there.
  // ⚠️ And neither runs under a MODAL (decision 6, 2026-09-15): an overlay, a
  // popup or the macro editor owns the keyboard while it is up. Without this
  // the arrows walked the list behind a popup, Enter loaded the focused row
  // onto the selected pad, and a focused filter box ate every keystroke a
  // modal's own text field was waiting for. _ui_modal_up is the modal gate's
  // own verdict (swing_ui_modal_gate), so the two can never disagree.
  // The docked keyboard: a click inside the strip gives it the keyboard, a click anywhere else in Swing takes it
  // back (the dock then hands focus back too); while it holds it, a key the dock queued stands in for `_char`
  // when REAPER delivered none (it delivers none to a docked Swing).
  // ⚠️ Against the ARGUMENTS, not px / pw: those are locals this call has not
  // assigned yet, so they held LAST call's list rect (after `px += _tw` with
  // the tree on) and a click in the rail never claimed the keys -- Down went
  // to the sequencer (sweep BRW13, 2026-10-26; the `_fy` note below has the
  // same class). The gutter is left out: its click is the chevron's.
  (mouse_cap & 1) && !fb_kbd_prev ? fb_kbd = mouse_x >= x && mouse_x < x + w - FB_GUTTER_W && mouse_y >= y && mouse_y < y + h;
  fb_kbd_prev = mouse_cap & 1;
  !_char && fb_kbd ? _char = swing_fb_dock_key();
  // The list's keys YIELD to the step sequencer while it owns the last click (seq_ui_focus): Up / Down / PgUp / PgDn /
  // Enter are both of theirs, and with the sequencer below and the strip at the side the strip draws first and ate them
  // (found in the swap's audit, round two J, 2026-10-22, with both panels on screen at once). A click in the strip
  // (fb_kbd) or anywhere else on the face takes them back; the filter box's focus is its own as ever.
  !is_embedded && !_ui_modal_up ? ( fb_filt_focus ? swing_fb_filter_keys() : (fb_kbd || !seq_ui_focus) ? _fb_want_keys = 1; );

  // The old pad-triggered audition is GONE. It loaded onto a pad and played the
  // pad, which is why it fought AUTOLOAD, overwrote the kit, and failed silently
  // when the length-change it watched for never came. AUDITION now drives the
  // browser's OWN voice (_prv_*), so it never touches a pad at all.

  // ══ MOUSE EDGES ═══════════════════════════════════════════════════════════
  // ⚠️⚠️ These went MISSING once already: a slice that removed the old audition
  // machinery took them with it, and because `edge` and `rel` are declared in
  // local() they silently read 0 rather than failing to compile. Every control
  // in the strip died at once -- chevron, AUTOLOAD, AUDITION, PLACES, the star --
  // while the panel still drew perfectly and still opened when forced. If the
  // strip ever goes visible-but-dead again, look HERE first.
  //
  // ⭐ The press edge comes from SWING, not from a shadow of our own. Swing
  // computes `lmb_down = LMB && !prev_LMB` once per @gfx pass
  // (Swing_ReaKit.jsfx:5964) and every widget in the plugin uses it;
  // swing_fb_gate stashed the real value before zeroing it for this column, so
  // _fb_g_lmbdown IS that edge, unmodified. A second shadow of the same state
  // is just a second thing that can be wrong.
  lmb  = (mouse_cap & 1) ? 1 : 0;
  // ⚠️ Nothing reads `lmb`, but it is NOT dead: EEL2 names are case-insensitive, so the
  // `LMB = ...` hand-over around the VOL knob below writes THIS local, not the global LMB.
  // Taking it out of local() would make that block zero the global LMB on every frame.
  edge = _fb_g_lmbdown;
  // Release has no house equivalent (nothing else needs one), so a shadow stays
  // for that -- and ONLY for that.
  // ⚠️⚠️ A GLOBAL, not the `rel` local. `lmb` -- declared in the same local()
  // list -- was measured reading 0 at the drag test while mouse_cap read 1 at
  // both ends of the same call, and moving the promotion off that local is what
  // finally made drag-to-pad promote. The release edge is the other half of the
  // same gesture and rides on the same kind of variable, so it moves too rather
  // than waiting to be the next thing that mysteriously does nothing.
  _fb_rel = (!(mouse_cap & 1) && _fb_lmb_prev) ? 1 : 0;
  _fb_lmb_prev = (mouse_cap & 1) ? 1 : 0;

  gx = x + w - FB_GUTTER_W;             // gutter PINNED to the window's right edge
  px = x;                               // panel opens leftward, toward the pads
  // Derived from the ANIMATED width, not from fb_open: on a close, `fb_open` is
  // already 0 while the window is still giving the width back, and a panel that
  // vanishes in one frame while its window keeps shrinking is the other half of
  // the reshape.
  pw = max(0, w - FB_GUTTER_W);

  // ── gutter + chevron ── (the redraw: drawn thinner, swing_fb_gutter_paint; the side slot's own gutter is the same)
  hot = mouse_x >= gx && mouse_x < gx + FB_GUTTER_W && mouse_y >= y && mouse_y < y + h;
  swing_fb_gutter_paint(gx, y, h, hot, fb_open);
  hot && edge ? ( fb_open = !fb_open; fb_open ? swing_fb_request(0, 0, -1); );

  // ── panel body ──
  // Three states, not two. While the strip is MOVING it draws as a plain
  // filling ground with a lit leading edge: running a breadcrumb, a toolbar,
  // 40 rows and a waveform through a dozen widths they hold for one frame each
  // is what made opening read as a blink instead of an expansion.
  (pw < 2) ? ( 0; ) : (
    // ── the folder tree takes the left of the panel ──
    // Everything below draws from px/pw, so moving them HERE is the whole
    // integration: breadcrumb, toolbar, list, status strip and every hit test
    // reflow into what is left without knowing the tree exists.
    // The width test is the fallback that matters: a docked or embedded
    // instance cannot grow its window, and a rail that leaves 60 px for
    // filenames is worse than no rail.
    // Width the rail is DRAWN at this frame: the live drag value while the
    // splitter is held, the committed one otherwise -- and never more than the
    // panel can spare. The clamp is what makes the docked case fall out for
    // free: there is no window to grow, so a wide rail simply gives the list
    // its floor back instead of squeezing it to nothing.
    _tw = max(FB_TREE_MIN,
              min(fb_split_drag ? _fb_tw_live : swing_fb_tree_w(),
                  pw - FB_LIST_MIN));
    fb_tree && pw > _tw + 90 ? (
      _sx   = px + _tw;                      // the seam, in absolute canvas px
      _shot = mouse_x >= _sx - FB_SPLIT_HIT && mouse_x < _sx + FB_SPLIT_HIT
           && mouse_y >= y && mouse_y < y + h;

      // ⚠️⚠️ THE RAIL MUST NOT SEE THE CLICK THAT GRABS THE SEAM. The seam sits
      // INSIDE the rail's own rect, and a rail row's "select" zone runs all the
      // way out to it -- so without suppressing the edge here, every grab of the
      // splitter also jumped the file list to whatever folder you grabbed next
      // to. Passing 0 costs the row nothing: 3 px is not a row click.
      swing_fb_tree_draw(px, y, _tw, h, (_shot || fb_split_drag) ? 0 : edge);

      // ⭐⭐ THE HANDLE IS ALWAYS THERE. The first version only lit the seam on
      // hover, which is backwards: a control you cannot see is a control nobody
      // knows they have, and at 26% alpha of the TEXT colour it was invisible on
      // a light theme anyway (SSL's panel is near-white, so _tc goes DARK and a
      // 2 px line at a quarter alpha disappears into the divider that was
      // already there). A grip you can see at rest is the whole affordance.
      //
      // Three states, and each one has to be obvious at a glance:
      //   rest  -- a quiet grip, enough to say "this moves"
      //   hover -- grip and seam brighten, the handle widens
      //   drag  -- the seam becomes a full-height lit rule
      //
      // ⭐ The grip is the GUTTER CHEVRON's idiom (short parallel marks), because
      // that is already the plugin's word for "grab me" and a second vocabulary
      // for the same gesture would just be noise.
      // ⚠️ This seam has no resize cursor. The side slot's width handle does
      // (swing_side_handle sets side_cur_want = IDC_SIZEWE, applied through
      // seq_ui_cursor_apply); giving this seam one too is its own decision.
      _gy = y + h * 0.5;

      // ⛔⛔ BUILT FROM LIGHT AND SHADOW, NOT FROM A TINT OF `_tc`. The first two
      // attempts both drew this as low-alpha `_tc` and both came out too faint to
      // see -- which is not bad luck, it is the method. `_tc` is chosen to be a
      // READABLE TEXT colour against the ground, so on the SSL theme it is near
      // BLACK on near-WHITE; a 1 px shape at half alpha of that lands right on
      // top of the hairline divider already there and adds nothing. Black and
      // white hairlines make a GROOVE, and a groove reads on any of the 14
      // themes because it is the same physics on all of them.
      gfx_set(0, 0, 0, fb_split_drag ? 0.42 : _shot ? 0.34 : 0.26);
      gfx_rect(_sx - 1, y, 1, h);
      gfx_set(1, 1, 1, fb_split_drag ? 0.18 : _shot ? 0.14 : 0.10);
      gfx_rect(_sx, y, 1, h);

      // Dragging: the whole rule goes to the chevron's blue, so the edge being
      // PLACED is the brightest thing on screen. Drawn under the grip, not over
      // it -- the handle has to stay legible while it is the thing you are using.
      fb_split_drag ? (
        gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, 0.9);
        gfx_rect(_sx - 1, y, 2, h);
      );

      // ── the grip: a raised PART, not a smudge ──
      // The pad takes its contrast from the GROUND's luminance, the same way the
      // text does -- lifted on a dark theme, sunk on a light one. Either way it
      // is a different value from what it sits on, which is the only thing that
      // makes a shape appear.
      // ⭐⭐ THREE STATES THAT ARE ACTUALLY THREE. The first cut separated them by
      // one pixel of width and a few points of alpha, which rendered as ONE
      // state wearing three names -- rest and hover were indistinguishable side
      // by side. The PAD ITSELF carries the state now:
      //   rest  -- neutral, a part of the chassis
      //   hover -- wider, and warmed a quarter of the way to the drag colour, so
      //            hovering PREVIEWS what grabbing will do
      //   drag  -- the pad goes fully blue with its marks knocked out dark. The
      //            handle you are holding is the brightest thing on the strip,
      //            which is the whole answer to "show me that I am dragging".
      _gw = (fb_split_drag || _shot) ? 7 : 5;
      fb_split_drag ? gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, 1) :
      _shot ? (
        _lum > 0.55 ? gfx_set(_gr * 0.80 + 0.10, _gg * 0.82 + 0.12, _gb * 0.86 + 0.16, 1)
                    : gfx_set(_gr * 1.20 + 0.14, _gg * 1.22 + 0.16, _gb * 1.26 + 0.21, 1);
      ) : (
        _lum > 0.55 ? gfx_set(_gr * 0.86, _gg * 0.86, _gb * 0.88, 1)
                    : gfx_set(_gr * 1.34 + 0.05, _gg * 1.34 + 0.05, _gb * 1.34 + 0.06, 1);
      );
      gfx_rect(_sx - _gw, _gy - FB_SPLIT_GRIP, _gw * 2, FB_SPLIT_GRIP * 2);
      // bevel: dark on the top/left, light on the bottom/right
      gfx_set(0, 0, 0, 0.38);
      gfx_rect(_sx - _gw, _gy - FB_SPLIT_GRIP, 1, FB_SPLIT_GRIP * 2);
      gfx_rect(_sx - _gw, _gy - FB_SPLIT_GRIP, _gw * 2, 1);
      gfx_set(1, 1, 1, 0.16);
      gfx_rect(_sx + _gw - 1, _gy - FB_SPLIT_GRIP, 1, FB_SPLIT_GRIP * 2);
      gfx_rect(_sx - _gw, _gy + FB_SPLIT_GRIP - 1, _gw * 2, 1);

      // Three EMBOSSED marks: a dark bar with a light one under its lip. 2 px
      // wide, because a 1 px mark at any alpha is a rounding error on screen.
      // Spanning -11..+11 so they sit centred in the 40 px pad.
      _gi = 0;
      loop(3,
        _my = _gy - 11 + _gi * 9;
        gfx_set(0, 0, 0, fb_split_drag ? 0.62 : _shot ? 0.72 : 0.60);
        gfx_rect(_sx - 3, _my, 2, 4); gfx_rect(_sx + 1, _my, 2, 4);
        gfx_set(1, 1, 1, fb_split_drag ? 0.34 : 0.28);
        gfx_rect(_sx - 3, _my + 4, 2, 1); gfx_rect(_sx + 1, _my + 4, 2, 1);
        _gi += 1;
      );

      _shot && edge ? ( fb_split_drag = 1; _fb_tw_live = _tw; );
      fb_split_drag ? (
        // Clamped against `pw`, the width the panel HAS -- so the drag can only
        // ever redistribute what is already on screen. Growing the window to
        // match happens once, on release, when the committed width steps.
        _fb_tw_live = max(FB_TREE_MIN,
                          min(min(FB_TREE_MAX, mouse_x - px), pw - FB_LIST_MIN));
        _fb_rel ? ( fb_tw_off = _fb_tw_live - FB_TREE_W; fb_split_drag = 0; );
      );

      px += _tw; pw -= _tw;
    ) : ( fb_split_drag = 0; );

  // ── the panel: the list's surface (the rail beside it is the ground itself) ──
  gfx_set(fb_lst_r, fb_lst_g, fb_lst_b, 1);
  gfx_rect(px, y, pw, h);
  gfx_set(0, 0, 0, fb_light ? 0.10 : 0.30);
  gfx_rect(px, y, 1, h);          // shadow line against the pad grid

  // ── the layout (the redraw, P1a; spec §2 "Fit") ──
  // NARROW (the side slot): the breadcrumb, the switch bar, the filter, the list, the card at the bottom. WIDE (620 px
  // and up: the browser placed below the pads, a slot dragged wide): the card takes a column at the right, the whole
  // height, and with the room the switch bar shares the breadcrumb's row. Heights grow with fb_fsz as the type does.
  // The card gives up its wave before the list goes under two rows; at the list's floor (FB_LIST_MIN) and the
  // smallest window the segment labels shorten (two rows of two at the last), the facts wrap to a second line and the
  // transport to a second row -- nothing is cut mid-control.
  _wide = pw >= 620;
  _fb_cnarrow = !_wide; _fb_cfold = _fb_cnarrow && fb_card_fold;   // the card's fold (swing_fb_card): narrow only
  _hh = FB_HDR_H + max(0, fb_fsz);
  _bh = FB_TOOL_H + max(0, fb_fsz);
  _fh = FB_FILT_H + max(0, fb_fsz);
  _rh   = FB_ROW_H + fb_fsz;     // rows grow with the type, or it clips
  _cw = _wide ? max(280, min(380, (pw * 0.36) | 0)) : pw - 12;
  _lw = _wide ? pw - _cw - 18 : pw;            // the list's column
  _bin = _wide && _lw >= 600;                  // the switch bar on the breadcrumb's row
  _sbw = _bin ? min(380, (_lw * 0.46) | 0) : _lw - 16;

  // ── breadcrumb: BACK and UP, the folder you are in, the star and PLACES at its tail ──
  // BACK and UP are different journeys: up walks the TREE, back walks what you
  // actually DID. Jumping in via PLACES has no parent at all, so up alone leaves
  // you stranded. Both dim rather than silently doing nothing.
  swing_fb_iconbtn(px + 6, y + 4, 24, _hh - 8, 2, 0, !(_fb_flags & 32), edge)
    ? ( swing_fb_relist(); fb_scroll = 0; swing_fb_request(13, 0, -1); );
  swing_fb_iconbtn(px + 30, y + 4, 24, _hh - 8, 3, 0, (_fb_flags & 4), edge)
    ? ( swing_fb_relist(); fb_scroll = 0; swing_fb_request(2, 0, -1); );
  _hr = px + (_bin ? _lw - _sbw - 16 : _lw) - 6;     // the breadcrumb row's right end
  // PLACES sits at the tail of the breadcrumb, where a home button belongs: a pin, and its word when there is room.
  // Without it the only navigation is up and down, so reaching another library
  // means walking to the drive root and back down again.
  swing_fb_font(FB_FS_BTN, 1);
  _tw = 0; _th = 0; gfx_measurestr("PLACES", _tw, _th);
  _plw = (_lw >= 250 && _tw + 30 <= _lw * 0.32) ? _tw + 30 : 26;   // the word only where it fits beside the path
  _plx = _hr - _plw;
  hot = mouse_x >= _plx && mouse_x < _hr && mouse_y >= y + 5 && mouse_y < y + _hh - 5;
  (_fb_flags & 16) ? ( gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, 1); swing_fb_rr(_plx, y + 5, _plw, _hh - 10, (_hh - 10) * 0.5); )
                   : ( swing_fb_mixset(fb_lst_r, fb_lst_g, fb_lst_b, _tc, _tc, _tc, hot ? 0.14 : 0.07); swing_fb_rr(_plx, y + 5, _plw, _hh - 10, (_hh - 10) * 0.5); );
  (_fb_flags & 16) ? gfx_set(fb_acc_t, fb_acc_t, fb_acc_t, 1) : gfx_set(_tc, _tc, _tc, hot ? 1 : 0.75);
  swing_fb_glyph(2, _plx + 13, y + _hh * 0.5, 11);
  _plw > 30 ? (
    swing_fb_font(FB_FS_BTN, 1);
    _tw = 0; _th = 0; gfx_measurestr("PLACES", _tw, _th);
    gfx_x = _plx + 22; gfx_y = y + (_hh - _th) * 0.5; gfx_drawstr("PLACES");
  );
  hot && edge ? ( swing_fb_relist(); fb_scroll = 0; swing_fb_request(6, 0, -1); );
  // STAR the folder you are in. Without this, PLACES could only ever SHOW
  // favourites and never make one -- half a feature. FLAGS bit3 is the bridge
  // telling us whether this folder is already starred.
  // A drawn star, solid: the accent when the folder IS starred, a dim grey when
  // not, so the button states its own answer instead of just being pressable.
  swing_fb_iconbtn(_plx - 28, y + 4, 26, _hh - 8, 0,
                   (_fb_flags & 8) ? 1 : 0, 0, edge)
    ? ( swing_fb_relist(); fb_scroll = 0; swing_fb_request(11, 0, -1); );   // the bridge shows PLACES after: a new listing (sweep BRW10)
  // The path itself stays clickable as an "up" target -- same destination,
  // much bigger than the arrow.
  _crx = px + 58; _crw = max(0, _plx - 32 - _crx);
  hot = mouse_x >= _crx && mouse_x < _crx + _crw && mouse_y >= y && mouse_y < y + _hh;
  hot && !(_fb_flags & 4) ? ( swing_fb_mixset(fb_lst_r, fb_lst_g, fb_lst_b, _tc, _tc, _tc, 0.05); swing_fb_rr(_crx - 4, y + 4, _crw + 8, _hh - 8, 6); );
  // The bridge publishes the TAIL of a long path — the deepest folders are the
  // half that says where you are.
  swing_fb_crumbs(_crx, y, _crw, _hh);
  hot && edge && !(_fb_flags & 4) ? ( swing_fb_relist(); fb_scroll = 0; swing_fb_request(2, 0, -1); );

  // ── the switch bar: AUTOLOAD, AUDITION, SUBFOLDERS, TREE in one rounded track, the gear at its end ──
  _bh2 = swing_fb_segbar(_bin ? px + _lw - _sbw - 8 : px + 8, _bin ? y + 4 : y + _hh, _sbw, _bin ? _hh - 8 : _bh - 6, edge);

  // ── filter box ──
  // ⚠️⚠️ `_fy` IS SET BEFORE THE FIRST THING THAT READS IT. RF used to be drawn
  // four lines ABOVE this assignment, and an EEL2 local() persists between calls
  // rather than resetting -- so RF was placed from LAST frame's `_fy`: at y=0 on
  // the first frame the strip ever drew (button and hit box up outside the
  // panel), and one frame stale on every rack-face <-> normal-face switch, which
  // passes a different `y` into this function. Same class as the `lmb`/`edge`
  // locals that killed every control in the strip; validate.py and
  // eel_unassigned_locals both pass it, because the name IS assigned -- just
  // later than it is read.
  _fy = _bin ? y + _hh : y + _hh + _bh2 + 4;
  // Rounded, a magnifier, the placeholder "Filter this folder"; the box is the card's colour inside a hairline.
  gfx_set(fb_hln_r, fb_hln_g, fb_hln_b, 1);
  swing_fb_rr(px + 8, _fy + 3, _lw - 16, _fh - 6, (_fh - 6) * 0.5);
  gfx_set(fb_crd_r, fb_crd_g, fb_crd_b, 1);
  swing_fb_rr(px + 9, _fy + 4, _lw - 18, _fh - 8, (_fh - 8) * 0.5);
  // REFRESH sits inside the box at its right end (beside the clear cross while there is text): it is a rescan, not a
  // mode. Drawn AFTER the box's ground, which painted over it at alpha 1: a button nobody could see that still took the
  // click (sweep BRW14, 2026-10-26); the box's own hit test leaves its rect alone.
  _rfx = px + _lw - 14 - 22 - (fb_filt_len > 0 ? 22 : 0);
  swing_fb_iconbtn(_rfx, _fy + 5, 22, _fh - 10, 5, 0, 0, edge)
    ? ( swing_fb_relist(); swing_fb_request(4, 0, -1); );
  hot = mouse_x >= px + 8 && mouse_x < px + _lw - 8
        && mouse_y >= _fy + 3 && mouse_y < _fy + _fh - 3
        && !(mouse_x >= _rfx && mouse_x < _rfx + 22 + (fb_filt_len > 0 ? 22 : 0));
  // is_embedded gets no keyboard at all, so never take focus there
  hot && edge ? fb_filt_focus = is_embedded ? 0 : 1;
  edge && !hot ? fb_filt_focus = 0;
  fb_filt_focus ? (
    gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, 1);
    gfx_roundrect(px + 8, _fy + 3, _lw - 17, _fh - 7, ((_fh - 6) * 0.5) | 0, 1);
  );
  gfx_set(_tc, _tc, _tc, 0.45);
  swing_fb_glyph(0, px + 22, _fy + _fh * 0.5, 12);
  swing_fb_font(FB_FS_ROW, 0);
  fb_filt_len > 0 ? (
    gfx_set(_tc, _tc, _tc, 0.95);
    swing_fb_clipstr(#fb_filt, px + 33, _fy + (_fh - gfx_texth) * 0.5, max(0, _rfx - px - 37));
    // clear
    swing_fb_iconbtn(_rfx + 22, _fy + 5, 22, _fh - 10, 6, 0, 0, edge) ? (
      strcpy(#fb_filt, ""); fb_filt_len = 0; fb_scroll = 0; swing_fb_relist();
      swing_fb_send_filter();
    );
  ) : (
    gfx_set(_tc, _tc, _tc, 0.38);
    swing_fb_clipstr(is_embedded ? "filter needs a floating window" : "Filter this folder",
                     px + 33, _fy + (_fh - gfx_texth) * 0.5, max(0, _rfx - px - 37));
  );
  gfx_set(fb_hln_r, fb_hln_g, fb_hln_b, 1);
  gfx_rect(px + 1, _fy + _fh, _lw - 1, 1);           // the hairline that seats the list under the top block

  listy = _fy + _fh + 2;

  // P2: the chips under the filter (FMT 2; none from an older bridge, none on the places list)
  _chh = (_fb_flags & 16) ? 0 : swing_fb_chips(px + 8, listy + 3, _lw - 16, edge, 1);
  _chh > 0 ? listy += _chh + 3;

  // FOLD ALL / OPEN ALL (the owner, 2026-10-28: "a way to collapse and open all folders"), only while the view holds
  // folder labels (FLAGS bit7): verb 19, REQ_RIDX 1 folds every label -- the drum machines and the folders inside
  // them -- and 0 opens them all. Ctrl+click on one label still folds / opens every label of its kind.
  _fb_fmt >= 2 && (_fb_flags & 128) ? (
    swing_fb_font(FB_FS_BTN - 1, 1);
    _faw = 0; _th = 0; gfx_measurestr("FOLD ALL", _faw, _th);
    _oaw = 0; gfx_measurestr("OPEN ALL", _oaw, _th);
    _fax = px + 12; _oax = _fax + _faw + 18;
    hot = mouse_x >= px && mouse_x < px + _lw && mouse_y >= listy && mouse_y < listy + 16;
    gfx_set(_tc, _tc, _tc, hot && mouse_x >= _fax && mouse_x < _fax + _faw ? 0.95 : 0.55);
    gfx_x = _fax; gfx_y = listy + ((16 - _th) * 0.5) | 0; gfx_drawstr("FOLD ALL");
    gfx_set(_tc, _tc, _tc, hot && mouse_x >= _oax && mouse_x < _oax + _oaw ? 0.95 : 0.55);
    gfx_x = _oax; gfx_y = listy + ((16 - _th) * 0.5) | 0; gfx_drawstr("OPEN ALL");
    hot && edge ? (
      mouse_x >= _fax - 4 && mouse_x < _fax + _faw + 4 ? swing_fb_request(19, 1, -1) :
      mouse_x >= _oax - 4 && mouse_x < _oax + _oaw + 4 ? swing_fb_request(19, 0, -1);
    );
    listy += 18;
  );

  // PLACES explains itself. It is a jump list -- starred folders, folders you
  // were in recently, and your drives -- and without a caption it just looks
  // like a folder full of oddly-named things.
  (_fb_flags & 16) ? (
    swing_fb_font(9, 1);
    gfx_set(_tc, _tc, _tc, 0.55);
    gfx_x = px + 12; gfx_y = listy + 4; gfx_drawstr("JUMP TO");
    swing_fb_font(10, 0);
    gfx_set(_tc, _tc, _tc, 0.40);
    swing_fb_clipstr("starred folders, recent ones, and your drives", px + 12, listy + 17, _lw - 20);
    listy += 32;
  );

  // ── the card's size, and so the list's ──
  // The selected row on this page (the card describes it). A selection scrolled off the page shows the count.
  p = 0; i = 0;
  loop(_fb_n,
    !p && _fb_rows[i * FB_REC + FB_R_LEN] > 0
       && _fb_rows[i * FB_REC + FB_R_RIDX] == fb_sel ? p = _fb_rows + i * FB_REC;
    i += 1;
  );
  fb_sel < 0 ? p = 0;
  _ciw = _cw - 20;
  _lh1 = FB_FS_ROW + fb_fsz + 7;
  _lh2 = FB_FS_STAT + fb_fsz + 3;
  // P4: the root pill for the deck's row (its width comes off the facts line); P1b: the group's prefix, dim in front of
  // the deck's name, when the row's label is on this page
  _fb_rootw = 0;
  p && swing_fb_root_text(fb_sel) > 0 ? (
    swing_fb_font(FB_FS_STAT - 1, 1);
    _tw = 0; _th = 0; gfx_measurestr(#fb_root, _tw, _th); _fb_rootw = _tw + 18;
  );
  strcpy(#fb_dpre, "");
  p ? (
    i = ((p - _fb_rows) / FB_REC) | 0;
    while (i > 0 && _fb_rows[(i - 1) * FB_REC + FB_R_KIND] == 0) ( i -= 1; );
    i > 0 && _fb_rows[(i - 1) * FB_REC + FB_R_KIND] == 5
      ? swing_fb_rowstr(_fb_rows + (i - 1) * FB_REC, #fb_dpre, 0, min(_fb_rows[(i - 1) * FB_REC + FB_R_LEN], FB_R_NAME_MAX));
  );
  _nf  = p ? swing_fb_facts(p, 0, 0, _ciw - _fb_rootw, _lh2, 0) : 1;
  _trn = swing_fb_transport(0, 0, _ciw, 0, 0);
  _cmin = 8 + _lh1 + 2 + _nf * _lh2 + 6 + 6 + _trn * FB_TR_H + 6;   // the card with no wave
  _wide ? (
    _cx0 = px + pw - _cw - 6; _cy0 = y + 6; _ch = h - 12;
    _wv = min(150, _ch - _cmin - 6);
    _wv < 18 ? _wv = 0;
    listh = y + h - 4 - listy;
  ) : (
    _ch = min(_cmin + 6 + 56, max(_cmin, y + h - 6 - listy - 4 - 2 * _rh));
    _wv = _ch - _cmin - 6;
    _wv < 18 ? ( _wv = 0; _ch = _cmin; );
    _fb_cfold ? ( _wv = 0; _ch = 8 + _lh1 + 6; );   // folded: the top line only; the list takes the rest
    _cx0 = px + 6; _cy0 = y + h - 6 - _ch;
    listh = _cy0 - 4 - listy;
  );
  vis   = max(1, (listh / _rh) | 0);
  _rowsfit = max(0, (listh / _rh) | 0);             // the rows drawn and hit: whole ones only
  fb_list_rows = _rowsfit;                           // for the rig (mb_test k06: the folded card gives the list rows)
  _rx1 = px + _lw - 4;                               // the rows' right end

  // ── bridge-not-running state, designed in rather than bolted on ──
  // The heartbeat is a counter the bridge bumps every tick. If it stops moving
  // for ~2 seconds of frames, say so plainly instead of showing a stale list
  // that looks live. (FXP_HB precedent.)
  _fb_hb == _fb_hb_last ? _fb_hb_still += 1 : _fb_hb_still = 0;
  _fb_hb_last = _fb_hb;
  alive = _fb_hb_still < 120;

  // ⭐ AND RE-ARM THE HELLO WHILE IT LOOKS DEAD. A bridge that RESTARTS mid-session
  // comes back with a fresh slot table -- `active` false again -- so it sits
  // waiting for a request that will never come. That is the same handshake
  // failure as a restored-open strip, just from the other end, and without this
  // the only cure is for the user to go and click something.
  // ⚠️ It re-asks on a TIMER rather than resetting _fb_hb_still, so a genuinely
  // dead bridge still reads as dead -- the message stays put and only the
  // question is repeated.
  !alive ? ( _fb_reask += 1;
             _fb_reask > 300 ? ( _fb_reask = 0; _fb_hello = 0; ); )
         : ( _fb_reask = 0; );

  _reg_my_slot < 0 ? (
    // no registry slot (the seventeenth Swing, or one whose slot was taken):
    // nothing of the band is ours to read or write (sweep BRW39/41)
    swing_fb_font(FB_FS_ROW, 0);
    gfx_set(fb_wrm_r, fb_wrm_g, fb_wrm_b, 1);
    swing_fb_clipstr("Registry full - no browser slot", px + 12, listy + 14, _lw - 20);
    gfx_set(_tc, _tc, _tc, 0.45);
    swing_fb_clipstr("16 Swings at most share the bridge", px + 12, listy + 32, _lw - 20);
  ) : !alive ? (
    swing_fb_font(FB_FS_ROW, 0);
    gfx_set(fb_wrm_r, fb_wrm_g, fb_wrm_b, 1);
    swing_fb_clipstr("Browser bridge not running", px + 12, listy + 14, _lw - 20);
    gfx_set(_tc, _tc, _tc, 0.45);
    swing_fb_clipstr("Start Swing's bridge script", px + 12, listy + 32, _lw - 20);
  ) : _fb_n < 1 ? (
    gfx_set(_tc, _tc, _tc, 0.45);
    swing_fb_font(FB_FS_ROW, 0);
    swing_fb_clipstr((_fb_flags & 1) ? "Reading folder..." :
                     (_fb_flags & 2) ? "Nothing playable here" : "...", px + 12, listy + 14, _lw - 20);
  ) : fb_settings_open ? ( 0; ) : (

    // ── rows ──
    // Keys here rather than at the top of the function: paging needs `vis`, and
    // `vis` is not known until the list geometry is.
    // A keyboard move that ran off the loaded page asked for a new one and
    // remembered where it was heading; land the selection now the page is here.
    // ⚠️ Here and not in swing_fb_snapshot: the snapshot sits ABOVE these
    // functions and EEL2 resolves names at parse time, so calling down from
    // there is a whole-file compile kill, not a warning.
    _fb_kbwant > 0 && (_fb_kbwant - 1) >= _fb_off
                   && (_fb_kbwant - 1) < _fb_off + min(_fb_n, vis) ? (
      swing_fb_kb_select(_fb_kbwant - 1 - _fb_off);
      _fb_kbwant = 0;
    );
    _fb_want_keys ? ( _fb_want_keys = 0; swing_fb_list_keys(vis); );
    maxs = max(0, _fb_total - vis);
    fb_scroll = max(0, min(maxs, fb_scroll));
    _fb_total > vis ? _rx1 = px + _lw - 10;          // the scrollbar's room
    _fb_fmt >= 2 ? swing_fb_pad_hashes();             // P3: what is on the pads, refreshed twice a second
    i = 0;
    loop(min(_fb_n, _rowsfit),
      _rp  = _fb_rows + i * FB_REC;
      nlen = _rp[FB_R_LEN];
      nlen > 0 ? (
        ry   = listy + i * _rh;
        kind = _rp[FB_R_KIND];   // 0 file, 1 folder, 2 parent, 3 place, 5 a group label (P1b)
        hot  = mouse_x >= px && mouse_x < px + _lw && mouse_y >= ry && mouse_y < ry + _rh;
        sel  = fb_sel >= 0 && _rp[FB_R_RIDX] >= min(fb_sel, fb_sel_b)
                           && _rp[FB_R_RIDX] <= max(fb_sel, fb_sel_b);
        // A LABEL is never selected, never gets the row menu or a drag (P1b, spec §3; the keyboard walk steps over it
        // in swing_fb_kb_select); a click on it folds / unfolds its group, so it keeps its hover. Its RIDX is -1 and
        // never meets fb_sel >= 0 anyway.
        kind == 5 ? sel = 0;

        // Selection = a tinted band inset 4 px with rounded ends and a 3 px accent edge on the left; hover a faint
        // tint. The rail's current folder wears the same band.
        sel ? (
          swing_fb_mixset(fb_lst_r, fb_lst_g, fb_lst_b, fb_acc_r, fb_acc_g, fb_acc_b, fb_light ? 0.16 : 0.26);
          swing_fb_rr(px + 4, ry + 1, _rx1 - px - 4, _rh - 2, (_rh - 2) * 0.5);
          gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, 1);
          swing_fb_rr(px + 5, ry + 4, 3, _rh - 8, 1.5);
        ) : hot ? (
          swing_fb_mixset(fb_lst_r, fb_lst_g, fb_lst_b, _tc, _tc, _tc, 0.06);
          swing_fb_rr(px + 4, ry + 1, _rx1 - px - 4, _rh - 2, (_rh - 2) * 0.5);
        );

        // ⚠️ `ext` is read by the icon, by the drag arming and by the click
        // handler. My icon rewrite dropped this assignment and the
        // unassigned-local guard caught it immediately -- without it every file
        // reads as extension 0, so an SFZ would load like a plain sample.
        ext = _rp[FB_R_EXT];
        kind == 5 ? (
          // ── a group LABEL (P1b): a fold arrow, the folder bold, the trimmed file-name start dim after it (one-folder
          //    mode has no folder: the start is the label, bold), its files' count at the right, a hairline under it.
          //    The folder LEADS on every label so they all read alike (the owner, 2026-10-28). FR_PLKIND 1 = folded.
          //    The wire keeps prefix, char 31, folder: the deck reads the prefix as the first part.
          //    NESTED (2026-10-28): FR_CH 1 = a folder INSIDE a top label (a drum machine's "Kick"): indented 14 px,
          //    a shade dimmer than the top label above it ──
          _lin = _rp[FB_R_CH] == 1 ? 14 : 0;
          swing_fb_font(FB_FS_BTN - 1, 0);
          sprintf(#fb_chipn, "%d", _rp[FB_R_SIZE_KB]);
          _tw = 0; _th = 0; gfx_measurestr(#fb_chipn, _tw, _th);
          gfx_set(_tc, _tc, _tc, 0.40);
          gfx_x = _rx1 - 8 - _tw; gfx_y = ry + (_rh - _th) * 0.5; gfx_drawstr(#fb_chipn);
          gfx_set(fb_hln_r, fb_hln_g, fb_hln_b, 1);
          gfx_rect(px + 10 + _lin, ry + _rh - 2, max(0, _rx1 - px - 14 - _lin), 1);
          gfx_set(_tc, _tc, _tc, hot ? 0.85 : 0.50);
          _foy = ry + _rh * 0.5;   // ⚠️ not `_fy`: that is the filter row's y, read again after the rows
          _rp[FB_R_PLKIND] == 1 ? gfx_triangle(px + 12 + _lin, _foy - 4, px + 12 + _lin, _foy + 4, px + 16 + _lin, _foy)  // folded: right
                                : gfx_triangle(px + 10 + _lin, _foy - 2, px + 18 + _lin, _foy - 2, px + 14 + _lin, _foy + 2); // open: down
          ci = swing_fb_rowstr(_rp, #fb_rname, 0, min(nlen, FB_R_NAME_MAX));
          ci < nlen ? swing_fb_rowstr(_rp, #fb_rfold, ci + 1, min(nlen, FB_R_NAME_MAX)) : strcpy(#fb_rfold, "");
          swing_fb_font(FB_FS_ROW - 1, 1);
          gfx_set(_tc, _tc, _tc, _lin ? 0.68 : 0.85);
          strlen(#fb_rfold) ? (
            _sx = swing_fb_clipstr(#fb_rfold, px + 22 + _lin, ry + (_rh - gfx_texth) * 0.5, max(0, _rx1 - px - 42 - _lin - _tw));
            strlen(#fb_rname) ? (
              swing_fb_font(FB_FS_ROW - 1, 0);
              gfx_set(_tc, _tc, _tc, 0.46);
              swing_fb_clipstr(#fb_rname, _sx + 8, ry + (_rh - gfx_texth) * 0.5, max(0, _rx1 - 16 - _tw - _sx - 8));
            );
          ) : swing_fb_clipstr(#fb_rname, px + 22 + _lin, ry + (_rh - gfx_texth) * 0.5, max(0, _rx1 - px - 42 - _lin - _tw));
        ) : (
        // Row icon. Colour still carries the TYPE, but the shape carries the
        // meaning -- a coloured block told you nothing on its own.
        // P2 (FMT 2): a file's glyph is its CATEGORY'S DOT, in the category's colour (the pads' hues); a ring when it
        // has none (or is not classified yet). SFZ, folders, places and ".." keep their shapes.
        kind == 0 && ext != 10 && _fb_fmt >= 2 ? (
          _rp[FB_R_CAT] > 0 ? (
            gfx_set(((_rp[FB_R_CCOL] / 65536) | 0) / 255, (((_rp[FB_R_CCOL] / 256) | 0) & 255) / 255, (_rp[FB_R_CCOL] & 255) / 255, 1);
            gfx_circle(px + 18, ry + _rh * 0.5, 4.5, 1, 1);
          ) : (
            gfx_set(_tc, _tc, _tc, 0.32);
            gfx_circle(px + 18, ry + _rh * 0.5, 4, 0, 1);
          );
        ) : (
        kind == 3 ? (
          _rp[FB_R_PLKIND] == 1 ? gfx_set(0.95, 0.70, 0.22, sel ? 1 : 0.9) :   // starred
          _rp[FB_R_PLKIND] == 3 ? gfx_set(0.55, 0.62, 0.72, sel ? 1 : 0.8)     // drive
                                : gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, sel ? 1 : 0.85);   // recent
        ) :
        kind >  0 ? ( fb_light ? gfx_set(0.80, 0.56, 0.16, sel ? 1 : 0.9) : gfx_set(0.86, 0.70, 0.38, sel ? 1 : 0.85); ) :
        ext == 10 ? ( fb_light ? gfx_set(0.28, 0.58, 0.32, 1) : gfx_set(0.55, 0.80, 0.55, sel ? 1 : 0.88); )
                  : gfx_set(fb_acc_r, fb_acc_g, fb_acc_b, sel ? 1 : 0.82);
        // For a place row the second argument carries the PLACE kind, not a
        // file extension -- a place has no extension and the icon needs to know
        // star from recent from drive.
        swing_fb_icon(kind, kind == 3 ? _rp[FB_R_PLKIND] : ext,
                      px + 18, ry + _rh * 0.5, 13);
        );

        // P3 (FMT 2): the file is on a pad -- that pad's tag at the row's right end
        _tagw = 0;
        kind == 0 && _fb_fmt >= 2 && swing_fb_tag_of(_rp[FB_R_PHASH]) >= 0 ? (
          _tagw = swing_fb_tag_draw(_fb_tag_ap, _fb_tag_n, _rx1 - 6, ry + _rh * 0.5) + 6;
          hot && mouse_x >= _rx1 - _tagw ? swing_tooltip_check(1701, "On a pad: that pad's note (a letter in front: a pad in another bank; + more pads).");
        );

        swing_fb_font(FB_FS_ROW, 0);
        gfx_set(_tc, _tc, _tc, sel ? 1 : (kind > 0 ? 0.88 : 0.80));
        swing_fb_rowstr(_rp, #fb_rname, 0, min(nlen, FB_R_NAME_MAX));
        swing_fb_clipstr(#fb_rname, px + 31, ry + (_rh - gfx_texth) * 0.5, max(0, _rx1 - px - 31 - 6 - _tagw));
        );

        // Right-click opens the row menu. Selecting first, so the menu always
        // acts on the row you actually pointed at.
        hot && _fb_g_rmbdown && kind != 5 ? (
          fb_menu_ridx = _rp[FB_R_RIDX]; fb_menu_kind = kind; fb_menu_ext = ext;
          fb_sel = fb_menu_ridx; fb_sel_b = fb_sel;
          strcpy(#fb_menu_name, "");
          ci = 0; loop(min(nlen, 30),
            str_setchar(#fb_menu_name, ci, _rp[FB_R_NAME + ci]); ci += 1;);
          swing_fb_menu_open(mouse_x, mouse_y);
        );

        hot && edge && kind == 5 ? (
          // a LABEL folds / unfolds its group (verb 18); CTRL folds / unfolds every group in the listing with it. The
          // listing's GEN rides along: a click on a page whose listing was just replaced folds nothing.
          swing_fb_request(18, _fb_gen * 1048576 + _rp[FB_R_SR], CTRL ? 1 : 0);
        ) : hot && edge ? (
          // SHIFT keeps the anchor and moves the far end: that is a range. A
          // plain press on a file INSIDE the range keeps it too (fb_drag_keep):
          // it may be the start of a drag that carries the whole range, and it
          // was collapsed to the row here, before the drag could arm, so five
          // selected files travelled as one (sweep BRW15, 2026-10-26); a click
          // that never moves collapses it at the release. Anything else starts
          // a fresh single-row selection.
          fb_drag_keep = (!SHIFT && sel && kind == 0) ? 1 : 0;
          SHIFT && fb_sel >= 0 && kind == 0 ? fb_sel_b = _rp[FB_R_RIDX]
          : fb_drag_keep ? 0
                         : ( fb_sel = _rp[FB_R_RIDX]; fb_sel_b = _rp[FB_R_RIDX]; );
          sel = fb_sel >= 0 && _rp[FB_R_RIDX] >= min(fb_sel, fb_sel_b)
                            && _rp[FB_R_RIDX] <= max(fb_sel, fb_sel_b);   // the press moved it
          kind > 0 ? (
            // folder or ".." — walk into it and start the list again at the top
            fb_scroll = 0; swing_fb_relist();
            swing_fb_request(1, _rp[FB_R_RIDX], -1);
          ) : (
            // A press on a file only ARMS. Whether it was a click or a drag is
            // not knowable yet, so the load waits for the release -- otherwise
            // every drag would also load onto the focused pad on the way past.
            fb_drag_state = 1;
            fb_drag_press = _rp[FB_R_RIDX];
            // Dragging a row that is INSIDE the selection carries the whole
            // range; dragging any other row carries just that one and resets
            // the selection to it -- otherwise a stray drag would silently
            // move files the user had forgotten were still selected.
            sel ? (
              fb_drag_ridx  = min(fb_sel, fb_sel_b);
              fb_drag_count = abs(fb_sel_b - fb_sel) + 1;
            ) : (
              fb_drag_ridx  = _rp[FB_R_RIDX];
              fb_drag_count = 1;
            );
            fb_drag_row   = i;
            fb_drag_ext   = ext;
            fb_drag_pad   = -1;
            fb_drag_x0    = mouse_x;
            fb_drag_y0    = mouse_y;
          );
        );
      );
      i += 1;
    );

    // ── scrollbar, only when it means something: a thin rounded thumb ──
    _fb_total > vis ? (
      swing_fb_mixset(fb_lst_r, fb_lst_g, fb_lst_b, _tc, _tc, _tc, 0.06);
      swing_fb_rr(px + _lw - 7, listy + 2, 4, listh - 4, 2);
      swing_fb_mixset(fb_lst_r, fb_lst_g, fb_lst_b, _tc, _tc, _tc, 0.32);
      swing_fb_rr(px + _lw - 7,
                  listy + 2 + (fb_scroll / max(1, _fb_total)) * (listh - 4),
                  4, max(14, (vis / max(1, _fb_total)) * (listh - 4)), 2);
    );

    // ── wheel: consume it so the pane behind cannot also act on it ──
    // _fb_g_wheel is the copy the gate took before it zeroed the frame global.
    // Reading mouse_wheel here would find nothing -- and would ALSO mean the
    // pane behind had already been free to act on it.
    _fb_g_wheel != 0 &&
    mouse_x >= px && mouse_x < px + _lw && mouse_y >= listy && mouse_y < listy + listh ? (
      fb_scroll = max(0, min(maxs, fb_scroll - (_fb_g_wheel > 0 ? 3 : -3)));
      swing_fb_request(0, 0, -1);
    );
  );

  // ── settings ──
  // Over the list rather than beside it: the strip is 292 px and a second
  // column would leave neither usable. Things that belong to the STRIP live
  // here; things you flip while working (autoload, audition, subfolders) stay
  // out on the switch bar where they can be reached without a detour.
  fb_settings_open ? (
    gfx_set(fb_lst_r, fb_lst_g, fb_lst_b, 1);
    gfx_rect(px + 1, listy, _lw - 1, max(0, listh));

    swing_fb_font(9, 1);
    gfx_set(_tc, _tc, _tc, 0.55);
    gfx_x = px + 12; gfx_y = listy + 10; gfx_drawstr("TYPEFACE");
    swing_fb_font(FB_FS_ROW, 0);
    gfx_set(_tc, _tc, _tc, 0.95);
    gfx_x = px + 12; gfx_y = listy + 28; gfx_drawstr(swing_fb_font_name(fb_font));
    swing_fb_btn(px + _lw - 74, listy + 25, 30, 20, "<", 0, edge)
      ? fb_font = (fb_font + FB_FONT_N - 1) % FB_FONT_N;
    swing_fb_btn(px + _lw - 40, listy + 25, 30, 20, ">", 0, edge)
      ? fb_font = (fb_font + 1) % FB_FONT_N;

    swing_fb_font(9, 1);
    gfx_set(_tc, _tc, _tc, 0.55);
    gfx_x = px + 12; gfx_y = listy + 58; gfx_drawstr("SIZE");
    swing_fb_font(FB_FS_ROW, 0);
    gfx_set(_tc, _tc, _tc, 0.95);
    gfx_x = px + 12; gfx_y = listy + 76;
    gfx_drawstr(sprintf(#, "%s%d", fb_fsz >= 0 ? "+" : "", fb_fsz));
    // the browser's text size: saved as ui_tsz, gate 87 (fb_fsz follows it each frame); the pad editor's own since 2026-10-29 (pfx_tsz)
    swing_fb_btn(px + _lw - 74, listy + 73, 30, 20, "-", 0, edge)
      ? ( ui_tsz = max(-4, ui_tsz - 1); fb_fsz = 2 + ui_tsz; );
    swing_fb_btn(px + _lw - 40, listy + 73, 30, 20, "+", 0, edge)
      ? ( ui_tsz = min(6, ui_tsz + 1); fb_fsz = 2 + ui_tsz; );

    swing_fb_font(9, 1);
    gfx_set(_tc, _tc, _tc, 0.55);
    gfx_x = px + 12; gfx_y = listy + 106; gfx_drawstr("SKIN");
    swing_fb_btn(px + 12, listy + 124, 90, 22, "CHASSIS", !fb_lcd, edge) ? fb_lcd = 0;
    swing_fb_btn(px + 108, listy + 124, 90, 22, "LCD",     fb_lcd,  edge) ? fb_lcd = 1;

    gfx_set(_tc, _tc, _tc, 0.40);
    swing_fb_font(10, 0);
    swing_fb_clipstr("LCD paints the strip in the theme's screen", px + 12, listy + 156, _lw - 20);
    swing_fb_clipstr("colours instead of the pad tray.", px + 12, listy + 170, _lw - 20);

    swing_fb_btn(px + 12, listy + max(190, listh - 32), _lw - 24, 24, "DONE", 0, edge)
      ? fb_settings_open = 0;
  );

  // ── the deck: a card. Full detail on ONE file beats thin detail on all of them -- that is what earns it its room,
  //    and it is why there are no per-row columns above. ──
  gmem[KIT_GMEM_CMD] != 0 ? _fb_cmd_stuck += 1 : _fb_cmd_stuck = 0;
  swing_fb_card(_cx0, _cy0, _cw, _ch, p, _wv, _nf, _trn, edge);

  // The house knob so it matches the rest of the instrument.
  // ⚠️ jo_knob_interact reads lmb_down, which swing_fb_gate ZEROES over this
  // column -- hand it the copy the gate took, then put the zero back. The strip
  // paints last, but the overlays after it still read these globals.
  // The WHEEL and the RIGHT button too (sweep BRW42, 2026-10-26): the gate
  // zeroes those as well, and with only the press handed over the knob never
  // saw a wheel notch or the right-click reset while the strip was at the side.
  // (The LMB half lands in the local `lmb` -- see the top of this function -- and
  // jo_knob_interact reads mouse_cap, not LMB, so the knob does not depend on it.)
  lmb_down = _fb_g_lmbdown; LMB = _fb_g_lmbclick; rmb_down = _fb_g_rmbdown; frame_wheel = _fb_g_wheel;
  fb_prv_gain = jo_knob_interact(_fb_knob, _fb_kx, _fb_ky, 11, fb_prv_gain,
                                 0, 1, 0.7, 0);   // range, default (init at 213), no detents
  lmb_down = 0; LMB = 0; rmb_down = 0; frame_wheel = 0;
  jo_knob_draw(_fb_kx, _fb_ky, 11, fb_prv_gain, 0, 1, 0, fb_acc_r, fb_acc_g, fb_acc_b);

  // ══ drag-to-pad ═══════════════════════════════════════════════════════════
  // Last in the function, so the ghost and the target highlight land on top of
  // the pad grid -- the strip as a whole already paints after it.

  // 1 -> 2 once the pointer has actually travelled. Without the slop a shaky
  // click would register as a drag and drop somewhere the user never aimed.
  // ⚠️⚠️ READS mouse_cap DIRECTLY, not the `lmb` local set at the top of this
  // function. Measured 2026-08-29 with an injected-mouse probe: at the top of
  // the frame mouse_cap was 1 and (mouse_cap & 1) was 1, yet by the time this
  // line ran `lmb` read 0 -- so a press ARMED (state 1) and then never promoted
  // to a drag, which is exactly "nothing happens, no ghost". Whatever is
  // clobbering that local between the two points, the button state is right
  // here for the asking and a cached copy buys nothing.
  fb_drag_state == 1 && (mouse_cap & 1) &&
    (abs(mouse_x - fb_drag_x0) + abs(mouse_y - fb_drag_y0)) > FB_DRAG_SLOP ?
      fb_drag_state = 2;

  fb_drag_state == 2 ? (
    // Hit-test the pad grid. Geometry mirrors swing_grid_draw_pads exactly --
    // same origin, same stride, same face size as swing_grid_extdrag uses for
    // the big browser's OS drag, so the lit pad is the one that will receive it.
    fb_drag_pad = -1;
    _dox = grid_x + 2; _doy = grid_y + 2;
    _dpw = cell_w - 4; _dph = pad_h;
    _dr = 0;
    loop(4,
      _dc = 0;
      loop(4,
        _dcx = _dox + _dc * cell_w;
        _dcy = _doy + _dr * cell_h;
        mouse_x >= _dcx && mouse_x <= _dcx + _dpw &&
        mouse_y >= _dcy && mouse_y <= _dcy + _dph ? fb_drag_pad = (3 - _dr) * 4 + _dc;
        _dc += 1;
      );
      _dr += 1;
    );

    // The pad editor's layer tabs (published by the editor within the last quarter second): a drop there lands on that
    // layer (the user, 2026-10-22: "a very cool gesture"); over a tab the pad grid is not the target. The tabs light
    // themselves from ovl_drag_* (the run the drop fills).
    fb_drag_tab = -1;
    time_precise() - ovl_tabs_t < 0.25 && mouse_y >= ovl_tabs_y && mouse_y <= ovl_tabs_y + ovl_tabs_h ? (
      _dtk = 0; loop(MAX_LAYERS,
        mouse_x >= ovl_tabs_x + _dtk * ovl_tabs_w && mouse_x <= ovl_tabs_x + _dtk * ovl_tabs_w + ovl_tabs_w - 2 ? fb_drag_tab = _dtk;
        _dtk += 1;
      );
    );
    // ...and its waveform: the layer shown, as if dropped on that layer's tab (the owner, 2026-10-27)
    fb_drag_tab < 0 && time_precise() - ovl_wave_t < 0.25 && ovl_wave_pad == ovl_tabs_pad
      && mouse_x >= ovl_wave_x && mouse_x <= ovl_wave_x + ovl_wave_w && mouse_y >= ovl_wave_y && mouse_y <= ovl_wave_y + ovl_wave_h
      ? fb_drag_tab = ovl_wave_layer;
    // ...and the layer mixer's strips: the strip's layer (2026-10-28; read here, not through swing_lmix_layer_at --
    // rk_swing_ui_layer_mixer is imported after this file)
    fb_drag_tab < 0 && time_precise() - ovl_lmix_t < 0.25 && ovl_lmix_pad == ovl_tabs_pad && ovl_lmix_u > 0
      && mouse_y >= ovl_lmix_y && mouse_y <= ovl_lmix_y + ovl_lmix_h && mouse_x >= ovl_lmix_x ? (
      _dtk = ((mouse_x - ovl_lmix_x) / (ovl_lmix_u + ovl_lmix_g)) | 0;
      _dtk < MAX_LAYERS && mouse_x - ovl_lmix_x - _dtk * (ovl_lmix_u + ovl_lmix_g) <= ovl_lmix_u ? fb_drag_tab = _dtk;
    );
    fb_drag_tab >= 0 ? (
      fb_drag_pad = -1;
      _dtf = swing_layer_drop_first(ovl_tabs_pad, fb_drag_tab);
      ovl_drag_l0 = max(0, _dtf); ovl_drag_n = min(fb_drag_count, MAX_LAYERS - ovl_drag_l0); ovl_drag_t = time_precise();
    );

    // Light the landing pad, same treatment the OS-drag path uses so the two
    // gestures read identically.
    // Light the landing pad AND the run a multi-drop would fill, so the reach
    // of the gesture is visible before committing to it. A layer drop stays on
    // one pad however many files are held -- it stacks, it does not spread.
    fb_drag_pad >= 0 ? (
      _di = 0;
      loop(ALT ? 1 : min(fb_drag_count, NUM_PADS - fb_drag_pad),
        _dr  = 3 - (((fb_drag_pad + _di) / 4)|0);
        _dc  = (fb_drag_pad + _di) - ((((fb_drag_pad + _di) / 4)|0) * 4);
        _dcx = _dox + _dc * cell_w;
        _dcy = _doy + _dr * cell_h;
        gfx_set(1, 1, 1, _di == 0 ? 0.28 : 0.14);
        gfx_rect(_dcx, _dcy, _dpw, _dph);
        _di == 0 ? (
          gfx_set(1, 1, 1, 0.85);
          gfx_roundrect(_dcx - 1, _dcy - 1, _dpw + 2, _dph + 2, 4);
        );
        _di += 1;
      );
    );

    // Ghost, carrying the name. Follows the cursor even outside the canvas --
    // probe 2 proved the coordinates stay true out there.
    _di = _fb_rows + fb_drag_row * FB_REC;
    swing_fb_font(11, 0);
    // the redraw: a small card (the hairline, the card's colour), its state edge on the left
    gfx_set(fb_hln_r, fb_hln_g, fb_hln_b, 1); swing_fb_rr(mouse_x + 10, mouse_y - 10, 176, 22, 7);
    gfx_set(fb_crd_r, fb_crd_g, fb_crd_b, 1); swing_fb_rr(mouse_x + 11, mouse_y - 9, 174, 20, 6);
    // Green = will land. Amber = will land as a LAYER (Alt). Grey = nowhere.
    fb_drag_pad < 0 && fb_drag_tab < 0 ? gfx_set(0.62, 0.66, 0.72, 1)
                    : (ALT || fb_drag_tab >= 0) ? gfx_set(0.95, 0.66, 0.22, 1)
                          : gfx_set(0.30, 0.74, 0.44, 1);
    swing_fb_rr(mouse_x + 14, mouse_y - 6, 3, 14, 1.5);
    gfx_set(_fb_tc, _fb_tc, _fb_tc, 0.95);
    fb_drag_count > 1 ? (
      gfx_x = mouse_x + 22; gfx_y = mouse_y - 1 - gfx_texth * 0.5;
      gfx_drawstr(sprintf(#, "%d files", fb_drag_count));
    ) : (
      swing_fb_rowstr(_di, #fb_gname, 0, min(_di[FB_R_LEN], FB_R_NAME_MAX));
      swing_fb_clipstr(#fb_gname, mouse_x + 22, mouse_y - 1 - gfx_texth * 0.5, 158);
    );
    fb_drag_pad >= 0 && ALT ? (
      swing_fb_font(11, 0);   // digits under 10 px stay regular (wiki §4.7)
      gfx_set(0.95, 0.72, 0.30, 1);
      gfx_x = mouse_x + 18; gfx_y = mouse_y + 14;
      _dtf = swing_pad_next_layer(swing_bp(fb_drag_pad));   // several files stack after it (the bridge's verb 7)
      fb_drag_count > 1 ? gfx_drawstr(sprintf(#, "+ LAYERS %d-%d", _dtf + 1, min(MAX_LAYERS, _dtf + fb_drag_count)))
                        : gfx_drawstr(sprintf(#, "+ LAYER %d", _dtf + 1));
    );
    fb_drag_tab >= 0 ? (
      swing_fb_font(11, 0);
      gfx_set(0.95, 0.72, 0.30, 1);
      gfx_x = mouse_x + 18; gfx_y = mouse_y + 14;
      ovl_drag_n > 1 ? gfx_drawstr(sprintf(#, "LAYERS %d-%d", ovl_drag_l0 + 1, ovl_drag_l0 + ovl_drag_n))
                     : gfx_drawstr(sprintf(#, "LAYER %d", ovl_drag_l0 + 1));
    );
  );

  // ── resolve on release ──
  _fb_rel && fb_drag_state > 0 ? (
    fb_drag_state == 2 && fb_drag_tab >= 0 && fb_drag_ext != 10 ? (
      // onto the pad editor's layer tab: the bridge takes REQ_COUNT files from the resolved layer
      // (swing_layer_drop_first; -1 = the first replaces the pad, the rest from layer 1), four layers at most
      fb_drag_layer = swing_layer_drop_first(ovl_tabs_pad, fb_drag_tab);
      swing_fb_request(7, fb_drag_ridx, ovl_tabs_pad);   // the editor's pad is a slot: absolute already
      overlay_layer = max(0, fb_drag_layer);              // the editor shows the layer the drop lands on
      sel_pad = ovl_tabs_pad;
    ) : fb_drag_state == 2 && fb_drag_pad >= 0 && fb_drag_ext != 10 ? (
      // ALT = stack as a LAYER instead of replacing the pad. Same convention
      // the big browser already uses (Swing_Browser.lua:4772), so the gesture
      // means the same thing in both places.
      // CMD 64 wants an explicit index, so pick the next free layer here --
      // clamped, because a full pad should stack on the last one rather than
      // silently do nothing; a PLAIN pad stacks on layer 1 (its sample is
      // layer 0 and gets promoted by the loader).
      ALT ? (
        fb_drag_layer = swing_pad_next_layer(swing_bp(fb_drag_pad));
        swing_fb_request(7, fb_drag_ridx, swing_bp(fb_drag_pad));   // the delivery names the ABSOLUTE pad (step 4a)
      ) : fb_drag_count > 1 ? swing_fb_request(8, fb_drag_ridx, swing_bp(fb_drag_pad))
                            : ( swing_fb_request(3, fb_drag_ridx, swing_bp(fb_drag_pad));
                                fb_preview ? fb_prv_name = fb_drag_ridx; );   // verb 3 carries REQ_AUD (sweep BRW16)
      // ⚠ The SLOT, both verbs (2026-10-15, the user: a drop on bank B..D landed on bank A). fb_drag_pad is
      // the 0..15 TILE from the hit test above; the bridge reads REQ_PAD as an absolute pad since step 4a
      // (verb 3 queues it as is, verb 8 fills from it to the end of ITS bank). Only the ALT branch had
      // been mapped. banks_adjacency_check's escape class now holds the 4x4 tile itself.
      sel_pad = swing_bp(fb_drag_pad);
      // No arming here any more: verb 3 carries REQ_AUD, so the bridge queues
      // the preview load right behind the pad load.
    ) : fb_drag_state == 1 ? (
      // Never moved, so it was a CLICK: on the row PRESSED (fb_drag_press; a
      // range press carries the range's first row in fb_drag_ridx), and a
      // range kept by a plain press inside it collapses to that row now
      // (sweep BRW15). Whether the click touches the kit is the LOAD switch's
      // business -- a drag always loads because it says where, but a click
      // should be able to mean "show me this one" and nothing more.
      // SFZ is never click-loaded either way: it is a 16-pad kit import.
      fb_drag_keep ? ( fb_sel = fb_drag_press; fb_sel_b = fb_drag_press; );
      (fb_autoload && fb_drag_ext != 10) ? (
        // verb 3 = load the pad, and (via REQ_AUD) queue the preview behind it
        swing_fb_request(3, fb_drag_press, sel_pad);
        fb_preview ? fb_prv_name = fb_drag_press;   // the row PLAY re-requests after a long file's end
      ) : (fb_preview && fb_drag_ext != 10) ? (
        // autoload OFF but audition ON: hear it without touching the kit. This
        // is the pairing the old pad-triggered audition could not express.
        swing_fb_request(12, fb_drag_press, -1);
        fb_prv_name = fb_drag_press;
      ) : swing_fb_request(5, fb_drag_press, -1);   // describe only
    );
    // dragged but released off the grid = CANCEL, deliberately doing nothing
    fb_drag_state = 0; fb_drag_pad = -1; fb_drag_tab = -1;
  );

  );  // fb_open

  // A drag must not survive the panel closing under it -- nor the audition (D-7):
  // the strip owns its player, so the frame it closes posts its STOP once.
  !fb_open ? ( fb_drag_state = 0; fb_drag_pad = -1; fb_drag_tab = -1; _fb_was_open ? fb_prv_cmd = 2; );
  _fb_was_open = fb_open;
);
