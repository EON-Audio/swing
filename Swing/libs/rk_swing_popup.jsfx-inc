// rk_swing_popup.jsfx-inc
// Swing-styled custom popup menu — replacement for gfx_showmenu.
// Locked to the Strip render style (user pick, 2026-05-24). A Card render
// path is retained behind SP_POPUP_SHOW_STYLE_TOGGLE (default 0) for A/B.
// (c) EON Studios — All Rights Reserved
//
// Usage:
//   1. Caller (e.g. MODE stepper right-click handler) calls
//        swing_popup_open(mx, my, "#Mode|^g Repitch|^b Tuned|^a Stretch",
//                         SP_POPUP_CALLER_xxx);
//      where the items string follows gfx_showmenu's format, plus our own
//      color extension:
//        '|'        separates items
//        '||'       produces a blank separator row (empty item)
//        '!'        prefix marks the item CHECKED (gfx_showmenu's own
//                   marker). Draws a tick at the left of the pill. When ANY
//                   item is checked the menu widens, so a tick can never
//                   collide with a centred label.
//                   ⚠️ Order when combined: '!' FIRST, then '#', then '^X'.
//        '#'        prefix marks the item as a disabled header
//                   (matches gfx_showmenu — always rendered Swing red)
//        '^X '      prefix tags the item with a palette color (X = single
//                   char). Recognised codes:
//                       g grey   b blue   a amber   r Swing red
//                       G green  p purple c cyan
//                   The optional trailing space after the code is stripped.
//                   '^' tags are OUR extension — gfx_showmenu would render
//                   them as literal text. Caller-side is unchanged either
//                   way (result indices are 1-based by visual row).
//      '#' and '^X' can appear together; if so, '#' goes first.
//   2. Each frame the caller checks:
//        swing_popup_result > 0 && swing_popup_caller_id == SP_POPUP_CALLER_xxx
//          → that's the 1-based pick (matches gfx_showmenu semantics).
//        After consuming the result the caller MUST set
//          swing_popup_result = 0;  // mark consumed
//   3. swing_popup_result == -1 indicates cancellation (click outside / ESC).
//
// Modal gating: when swing_popup_active is non-zero,
//   swing_ui_modal_gate() suppresses the underlying UI's mouse state, and
//   swing_popup_tick() (drawn LAST in @gfx) handles its own clicks via the
//   _raw_lmb_down / _raw_LMB copies the gate preserved.

@init

// ─── Caller IDs (extend as new sites adopt the popup) ────────────────────
SP_POPUP_CALLER_NONE        = 0;
SP_POPUP_CALLER_MODE_ALGO   = 1;
SP_POPUP_CALLER_OUTPUT_BUS  = 2;
SP_POPUP_CALLER_CHOKE_GROUP = 3;
SP_POPUP_CALLER_VEL_CURVE   = 4;
SP_POPUP_CALLER_EMBED_MENU  = 5;
SP_POPUP_CALLER_DLY_SYNC    = 6;
SP_POPUP_CALLER_RVB_SYNC    = 7;
SP_POPUP_CALLER_RPT_DIV     = 8;
SP_POPUP_CALLER_MAP_PRESET  = 9;
SP_POPUP_CALLER_MAP_ROOT    = 10;
SP_POPUP_CALLER_SAVE_KIT    = 11;
SP_POPUP_CALLER_LOAD_KIT    = 12;
SP_POPUP_CALLER_NEW_KIT     = 13;
SP_POPUP_CALLER_RESET_COLORS = 14;
SP_POPUP_CALLER_MULTIOUT    = 15;
SP_POPUP_CALLER_CLEAR_PADS  = 16;
SP_POPUP_CALLER_OVERLAY_CLEAR_LAYER = 17;
SP_POPUP_CALLER_OVERLAY_LAYER_MODE  = 18;
SP_POPUP_CALLER_OVERLAY_OUTPUT_BUS  = 19;
SP_POPUP_CALLER_OVERLAY_CHOKE       = 20;
SP_POPUP_CALLER_OVERLAY_ONESHOT     = 21;
SP_POPUP_CALLER_OVERLAY_CLEAR_PAD   = 22;
SP_POPUP_CALLER_PAD_GRID_OUTPUT     = 23;  // pad grid output bus picker
SP_POPUP_CALLER_PAD_GRID_NOTE       = 24;  // pad grid MIDI note re-assign
SP_POPUP_CALLER_PAD_GRID_RPT        = 25;  // pad grid per-pad repeat divisor
SP_POPUP_CALLER_ALGO        = 26;  // dedicated per-pad algo dropdown (Tuned/Stretch)
SP_POPUP_CALLER_THEME       = 27;  // THEME menu: one row's option list (rk_swing_ui_thememenu).
                                   // Was declared for a header right-click picker that was never
                                   // built and had no consumer anywhere; reclaimed 2026-09-22
                                   // rather than burning a new id. The row is thm_pick_row.
SP_POPUP_CALLER_KNOB_STYLE  = 28;  // left-panel KNOB button → pad-knob style picker
SP_POPUP_CALLER_DM_BUILD    = 29;  // left-panel MATRIX button right-click → build menu (Matrix/Multi-Out/Both)
SP_POPUP_CALLER_PREFS       = 30;  // header gear button → prefs toggles (MIDI Thru / Tooltips / Select-track-on-pad-click)
SP_POPUP_CALLER_PAD_RANGE   = 31;  // LCD RANGE pill → chromatic key-range presets (Spec_Swing_Chromatic_Pad Slice 1)
SP_POPUP_CALLER_PAD_GRID_KNOBS = 32;  // pad grid VOL/PAN knob right-click → knob style + colour override
SP_POPUP_CALLER_SAMPLES_MISSING = 33; // "Kit samples missing" banner click → Relink folder / Load kit / Dismiss (P4 step 3)
SP_POPUP_CALLER_PAD_CATEGORY = 34; // LCD CATEGORY pill → set the pad's category (kit-categories §9b; via bridge mailbox)
SP_POPUP_CALLER_MACRO_ASSIGN = 35; // right-click a macro-capable knob → "> <macro name>" ×8; consumed in Swing_ReaKit @gfx (adds a mapping to the picked macro)
SP_POPUP_CALLER_MACRO_PRESET = 36; // macro editor PRESET ▾ chip → template list; consumed in rk_swing_ui_macroed
SP_POPUP_CALLER_VIEW_MODE   = 37;  // SWING wordmark right-click → face override (Auto / Full UI / Rack face); consumed in swing_ui_viewmode_click. Rows 5..8 (DOCK LAYOUT) get sp_layout_glyph minis — index-coupled to EON Dock Layout.lua's LAYOUTS
SP_POPUP_CALLER_RACK_KIT    = 38;  // rack kit card ▾ / right-click → kit-file actions (Load / Save As / Explore); consumed in swing_ui_draw_rack_header
SP_POPUP_CALLER_RACK_MORE   = 39;  // rack header "⋯" chip → the workstation actions folded out of the row; consumed in swing_ui_draw_rack_header
SP_POPUP_CALLER_INS_SLOT    = 40;  // console strip insert slot right-click → open / embed TCP / embed MCP / bypass / offline / swap / delete; consumed in swing_panels_draw_mixer_big
SP_POPUP_CALLER_FB_ROW      = 41;  // mini browser row right-click -> load / layer / preview / reveal / copy / star; consumed in swing_fb_draw
SP_POPUP_CALLER_FB_LAYER    = 42;  // the "Add as layer" step of that menu -> next free or an explicit layer; consumed in swing_fb_draw
SP_POPUP_CALLER_FB_TREE     = 43;  // mini browser RAIL row right-click -> show / expand / remove from list / reveal; consumed in swing_fb_draw
SP_POPUP_CALLER_BANK_TAB    = 44;  // bank strip tab right-click -> load into / save bank / clear bank / clear all (Pad Banks step 4c); consumed in Swing_ReaKit @gfx
SP_POPUP_CALLER_KV_ROW      = 45;  // kits view row right-click -> load (all banks) / load into bank A..D (step 4c); consumed in swing_kitsview_draw
// RPT_FEEL was 44 until 2026-09-24 -- the bank tab menu's id too, so its consumer (drawn first) ate every tab-menu
// pick (Pad Banks audit M4). A new id takes the next free number; .dev_tests/popup_caller_ids_check.py fails a repeat.
SP_POPUP_CALLER_RPT_FEEL    = 46;  // the note-repeat feel rows (swing / probability / humanise / pressure) -> one shared percentage ladder; consumed in swing_panels_draw_controls
SP_POPUP_CALLER_SEQ_COLOUR  = 47;  // a pattern's colour (the PATTERN menu's row, round two H): auto, then the lib's seven colours; consumed in swing_seq_panel_draw (rk_seq_ui). (SEQ_CLEAR, the CLR button's, until the toolbar pass took the button.)
SP_POPUP_CALLER_SEQ_TARGET  = 48;  // the step sequencer's lane name -> the pad this lane aims at (a bank's sixteen pads, then the other banks); consumed in swing_seq_panel_draw (rk_seq_ui)
SP_POPUP_CALLER_SEQ_OPTIONS = 49;  // the step sequencer's OPTIONS button -> lane icons / FOLLOW / transport row, aim the pattern at a bank; consumed in swing_seq_panel_draw (rk_seq_ui)
SP_POPUP_CALLER_SEQ_STEP    = 50;  // a right-click on a step -> hear the pad, roll, probability, nudge, accent, clear; consumed in swing_seq_panel_draw (rk_seq_ui)
SP_POPUP_CALLER_SEQ_TRIG    = 51;  // the step sequencer's TRIG button -> the MIDI trigger mode and the trigger notes' base; consumed in swing_seq_panel_draw (rk_seq_ui)
SP_POPUP_CALLER_SEQ_LANE    = 52;  // a right-click on a lane's name -> fill every step / 2nd / 4th / 8th, clear the lane (S3a); consumed in swing_seq_panel_draw (rk_seq_ui)
SP_POPUP_CALLER_SEQ_CHAN    = 55;  // a lane to a MIDI channel (the lane menu or the pad picker's last row) -> channel 1..16 (S5); consumed in swing_seq_panel_draw (rk_seq_ui)
SP_POPUP_CALLER_SEQ_SCALE   = 56;  // a roll lane's SCALE -> the mode and the root (S5); consumed in swing_seq_panel_draw (rk_seq_ui)
SP_POPUP_CALLER_SEQ_PRINT   = 57;  // TO ITEM's right-click (PRINT until the toolbar pass): how many cycles (S6); consumed in swing_seq_panel_draw (rk_seq_ui)
SP_POPUP_CALLER_SEQ_PATTERN = 58;  // the PATTERN button and a pattern tab's right-click: copy, paste, duplicate, halve, double, clear, aim at a bank (the toolbar pass, 2026-10-21); consumed in swing_seq_panel_draw (rk_seq_ui)
SP_POPUP_CALLER_SEQ_COLS    = 54;  // the step sequencer's lane columns (the ruler's menu) -> show / hide the icon, M / S, name, length, division, swing (the polish pass); consumed in swing_seq_panel_draw (rk_seq_ui)
SP_POPUP_CALLER_SEQ_REGION  = 53;  // a right-click on a region chip of the song strip -> play from it, the chain, zoom, rename, delete (S4); consumed in swing_seq_panel_draw (rk_seq_ui)

// ─── Style enum + persisted default ──────────────────────────────────────
SP_POPUP_STYLE_CARD       = 0;   // PAD-dialog-like — rounded-ish, red header
SP_POPUP_STYLE_STRIP      = 1;   // LCD-pill-like   — flat, compact

// Style toggle row was a mockup-phase comparison aid (user picked Strip
// on 2026-05-24). Set to 1 again if you ever want to A/B styles again.
// The Card render path is preserved in case a future caller wants it.
SP_POPUP_SHOW_STYLE_TOGGLE = 0;

// Default style for every popup. Locked to Strip — flat pills with each
// item colored by its '^X' tag, matching the LCD pill language.
swing_popup_style          = SP_POPUP_STYLE_STRIP;

// ─── State ────────────────────────────────────────────────────────────────
swing_popup_active     = 0;
swing_popup_x          = 0;
swing_popup_y          = 0;
swing_popup_caller_id  = SP_POPUP_CALLER_NONE;
swing_popup_result     = 0;     // 0 = nothing, 1..N = picked, -1 = cancelled
swing_popup_hover_idx  = -1;
swing_popup_just_opened = 0;    // 1 for the first frame after open → swallows the click that triggered the popup
// Hover-scroll: when the wheel turns while the mouse is over an item, the tick
// publishes the wheel direction (+1 up / -1 down) and that item's 1-based result
// index. A caller can read these to change THAT option's value in place while
// the menu stays open (e.g. the header gear toggles). Reset each frame by tick.
swing_popup_wheel        = 0;
swing_popup_wheel_result = 0;

// Max items in one popup (Mode+Algo currently needs 9 + 2 separators = 11)
SP_POPUP_MAX_ITEMS = 64;   // was 32 (2026-10-21): the pad category menu has 48 rows -- lock, auto, the 46 names -- and the
                           // parser dropped the last sixteen silently (FINDINGS_LOG); the init chains freemem, so the four
                           // plugins that import this lib pay 192 cells more and nothing else moves
// ─── Size, in design px. The metrics and the draw read the SAME constants, so the measured box and the drawn rows
// cannot drift (they were separate numbers until 2026-10-21; see the metrics' warning). The user, 2026-10-21: "our menus
// are small and hard to read" -- rows a third taller, 14 px labels (were 18 / 11). The face's scale is the window's, never
// the monitor's DPI (Swing_ReaKit.jsfx, _ui_sc), so these are the pixels the user sees at the default window size.
SP_ROW_H_STRIP = 24; SP_FS_STRIP = 14; SP_FS_STRIP_HDR = 11; SP_SEP_H_STRIP = 6; SP_PAD_STRIP = 6;
SP_ROW_H_CARD  = 28; SP_FS_CARD  = 15; SP_FS_CARD_HDR  = 13; SP_SEP_H_CARD  = 8; SP_PAD_CARD  = 8;
SP_SCROLL_BAND = 14;   // the arrow bands over the top and bottom of a list taller than the window (it scrolls: the wheel,
                       // the mouse resting on a band, a click on a band = a row)
// ─── Scroll state: a list taller than the window keeps the box at the window's height and slides the rows under it ───
swing_popup_scroll_px  = 0;   // how far the rows are slid up, px (0 = the top)
swing_popup_scroll_max = 0;   // 0 = the whole list fits: no bands, and the wheel keeps its hover-scroll meaning
swing_popup_band_t     = 0;   // frames the mouse has rested on a band (the auto-scroll quickens after twenty)
swing_popup_box_x = 0; swing_popup_box_y = 0; swing_popup_box_w = 0; swing_popup_box_h = 0;   // the box as drawn this frame (rigs, callers)

// ─── Init: allocate per-item parse tables ────────────────────────────────
function swing_popup_init(_base)
local(_b)
(
  _b = _base;
  sp_popup_item_ofs   = _b; _b += SP_POPUP_MAX_ITEMS;
  sp_popup_item_len   = _b; _b += SP_POPUP_MAX_ITEMS;
  sp_popup_item_dis   = _b; _b += SP_POPUP_MAX_ITEMS;
  sp_popup_item_sep   = _b; _b += SP_POPUP_MAX_ITEMS;
  // Per-item color code (char from '^X' tag, or 0 if untagged → default
  // text color). Applied by swing_popup_apply_color() at draw time.
  sp_popup_item_color = _b; _b += SP_POPUP_MAX_ITEMS;
  // Per-item checked flag (from a '!' prefix). Separate array rather than a
  // bit in _dis: an item can be checked AND a header, and folding them would
  // make one un-representable.
  sp_popup_item_chk   = _b; _b += SP_POPUP_MAX_ITEMS;
  // Scratch slots for swing_popup_metrics_* out-params (width / height).
  // Two single-cell arrays; addressed as sp_popup_scratch_w[0] /
  // sp_popup_scratch_h[0] from the metrics functions.
  sp_popup_scratch_w  = _b; _b += 1;
  sp_popup_scratch_h  = _b; _b += 1;
  _b;
);

// ─── Palette: apply a tagged color via gfx_set ───────────────────────────
// `_alpha` lets callers tint backgrounds at low alpha while drawing text
// at full alpha with the same code. Code 0 → default LCD-text color.
function swing_popup_apply_color(_code, _alpha)
(
  _code == 'g' ? gfx_set(0.60, 0.63, 0.68, _alpha) :
  _code == 'b' ? gfx_set(0.22, 0.55, 1.00, _alpha) :
  _code == 'a' ? gfx_set(1.00, 0.62, 0.10, _alpha) :
  _code == 'r' ? gfx_set(0.92, 0.22, 0.14, _alpha) :
  _code == 'G' ? gfx_set(0.26, 0.85, 0.42, _alpha) :
  _code == 'p' ? gfx_set(0.70, 0.42, 0.95, _alpha) :
  _code == 'c' ? gfx_set(0.25, 0.85, 0.92, _alpha) :
  gfx_set(0.85, 0.92, 0.94, _alpha);  // default — same as LCD text
);

// ─── Parse items_str into the tables ─────────────────────────────────────
// Items string format mirrors gfx_showmenu plus our own extensions:
//   "a|b||c"          → items: ["a"], ["b"], [""], ["c"]
//                       (the empty one renders as a separator)
//   "#hdr|x"          → items: ["hdr" disabled], ["x"]
//   "^b Tuned|^a Hot" → items: ["Tuned" blue], ["Hot" amber]
// Disabled headers → sp_popup_item_dis. Empty separators → sp_popup_item_sep.
// Color tags → sp_popup_item_color. Markers (#, ^X, optional trailing space)
// are stripped from the displayed text via ofs/len adjustment so the parser
// stays single-pass.
function swing_popup_parse_items()
local(_n, _i, _start, _len, _ch, _is_dis, _color, _slen, _chk)
(
  _slen = strlen(#swing_popup_items);
  _n = 0;
  _start = 0;
  _is_dis = 0;
  _color  = 0;
  _chk    = 0;
  // Consume leading markers on the very first item. '!' first — see header.
  _slen > 0 && str_getchar(#swing_popup_items, _start) == '!' ? (
    _chk = 1; _start += 1;
  );
  _slen > 0 && str_getchar(#swing_popup_items, _start) == '#' ? (
    _is_dis = 1; _start += 1;
  );
  _start + 1 < _slen && str_getchar(#swing_popup_items, _start) == '^' ? (
    _color = str_getchar(#swing_popup_items, _start + 1);
    _start += 2;
    _start < _slen && str_getchar(#swing_popup_items, _start) == ' ' ? (
      _start += 1;
    );
  );
  _i = _start;
  loop(_slen + 1 - _start,
    _ch = _i < _slen ? str_getchar(#swing_popup_items, _i) : '|';
    _ch == '|' ? (
      _len = _i - _start;
      _n < SP_POPUP_MAX_ITEMS ? (
        sp_popup_item_ofs[_n]   = _start;
        sp_popup_item_len[_n]   = _len;
        sp_popup_item_dis[_n]   = _is_dis;
        sp_popup_item_sep[_n]   = (_len == 0);
        sp_popup_item_color[_n] = _color;
        sp_popup_item_chk[_n]   = _chk;
        _n += 1;
      );
      // Reset markers for the next item.
      _start = _i + 1;
      _is_dis = 0;
      _color  = 0;
      _chk    = 0;
      // Consume '!' (checked) — must come first of the three.
      _start < _slen && str_getchar(#swing_popup_items, _start) == '!' ? (
        _chk = 1; _start += 1;
      );
      // Consume '#' (disabled-header marker).
      _start < _slen && str_getchar(#swing_popup_items, _start) == '#' ? (
        _is_dis = 1; _start += 1;
      );
      // Consume '^X' (color tag) and optional trailing space.
      _start + 1 < _slen && str_getchar(#swing_popup_items, _start) == '^' ? (
        _color = str_getchar(#swing_popup_items, _start + 1);
        _start += 2;
        _start < _slen && str_getchar(#swing_popup_items, _start) == ' ' ? (
          _start += 1;
        );
      );
    );
    _i += 1;
  );
  sp_popup_item_count = _n;
);

// ─── Map visual index → 1-based gfx_showmenu-equivalent result ───────────
// gfx_showmenu numbers items starting at 1, including disabled headers but
// NOT empty separator rows (the '||' tokens render as horizontal lines and
// don't consume an index in the result). Replicate that exactly so the
// existing switch-on-resp-number caller code is a drop-in port:
//
//   "OFF|1/4|1/4 T|1/4 D||1/8|..."
//   → 1=OFF, 2=1/4, 3=1/4 T, 4=1/4 D, 5=1/8, ...   (sep at visual idx 4
//                                                    is skipped in result)
//
//   "#Mode|Repitch|Tuned|Stretch||#Algo|Drum|..."
//   → 1=#Mode, 2=Repitch, 3=Tuned, 4=Stretch,
//     5=#Algo, 6=Drum, ...                          (headers count,
//                                                    sep is skipped)
function swing_popup_visual_to_result(_vi)
local(_i, _result)
(
  _i = 0;
  _result = 0;
  loop(_vi + 1,
    !sp_popup_item_sep[_i] ? _result += 1;
    _i += 1;
  );
  _result;
);

// ─── Refresh the items of an already-open popup ──────────────────────────
// Re-parses a new items string WITHOUT moving/closing the popup. Lets a caller
// update labels live (e.g. after a hover-scroll toggled "ON" → "OFF") so the
// open menu reflects the new state on the next frame.
function swing_popup_refresh_items(_items_str)
(
  strcpy(#swing_popup_items, _items_str);
  swing_popup_parse_items();
);

// ─── Open ────────────────────────────────────────────────────────────────
function swing_popup_open(_x, _y, _items_str, _caller_id)
(
  strcpy(#swing_popup_items, _items_str);
  swing_popup_parse_items();
  swing_popup_x         = _x;
  swing_popup_y         = _y;
  swing_popup_caller_id = _caller_id;
  swing_popup_active    = 1;
  swing_popup_result    = 0;
  swing_popup_hover_idx = -1;
  swing_popup_just_opened = 1;
  swing_popup_wheel     = 0;
  swing_popup_scroll_px = 0; swing_popup_scroll_max = 0; swing_popup_band_t = 0;
);

function swing_popup_close(_result)
(
  swing_popup_active = 0;
  swing_popup_result = _result;
);

// ─── Layout metrics (returns total width + height for current style) ─────
function swing_popup_metrics_card(_w_out, _h_out)
local(_i, _max_w, _w, _h, _tw, _th, _has_items)
(
  // ⚠⚠ The row height, the pads, the separator and the fonts are the SP_*_CARD constants, the same ones
  // swing_popup_draw_card reads, so the measured box and the drawn rows cannot drift apart. (A metrics height SHORTER
  // than the drawn rows makes the lower rows read as "outside": the draw picks the item and the cancel check overwrites
  // it with -1 -- a menu that closes without applying. Caught in review 2026-09-18, when the two were separate numbers.)
  _max_w = swing_px(80);
  _h = swing_px(SP_PAD_CARD);          // top pad
  SP_POPUP_SHOW_STYLE_TOGGLE ? _h += 22;   // toggle row
  _i = 0;
  loop(sp_popup_item_count,
    sp_popup_item_sep[_i] ? (
      _h += swing_px(SP_SEP_H_CARD);
    ) : (
      sp_popup_item_dis[_i] ? gfx_setfont(1, "Arial", swing_fs(SP_FS_CARD_HDR), 'b') : gfx_setfont(1, "Arial", swing_fs(SP_FS_CARD));
      strcpy_substr(#sp_popup_tmp, #swing_popup_items, sp_popup_item_ofs[_i], sp_popup_item_len[_i]);
      gfx_measurestr(#sp_popup_tmp, _tw, _th);
      _tw + swing_px(34) > _max_w ? _max_w = _tw + swing_px(34);
      _h += swing_px(SP_ROW_H_CARD);
    );
    _i += 1;
  );
  _h += swing_px(SP_PAD_CARD);         // bottom pad
  _w_out[0] = _max_w;
  _h_out[0] = _h;
);

function swing_popup_metrics_strip(_w_out, _h_out)
local(_i, _max_w, _h, _tw, _th)
(
  // The SP_*_STRIP constants, shared with swing_popup_draw_strip (see the card's warning).
  _max_w = swing_px(70);
  _h = swing_px(SP_PAD_STRIP);
  SP_POPUP_SHOW_STYLE_TOGGLE ? _h += 20;
  _i = 0;
  loop(sp_popup_item_count,
    sp_popup_item_sep[_i] ? (
      _h += swing_px(SP_SEP_H_STRIP);
    ) : (
      sp_popup_item_dis[_i] ? gfx_setfont(1, "Arial", swing_fs(SP_FS_STRIP_HDR), 'b') : gfx_setfont(1, "Arial", swing_fs(SP_FS_STRIP));
      strcpy_substr(#sp_popup_tmp, #swing_popup_items, sp_popup_item_ofs[_i], sp_popup_item_len[_i]);
      gfx_measurestr(#sp_popup_tmp, _tw, _th);
      // +16 more when ANY item carries a tick: labels are CENTRED, so a glyph at the left of the pill would otherwise
      // meet the longest one.
      _tw + swing_px(28) + (sp_popup_item_chk[_i] ? swing_px(16) : 0) > _max_w ?
        _max_w = _tw + swing_px(28) + (sp_popup_item_chk[_i] ? swing_px(16) : 0);
      _h += swing_px(SP_ROW_H_STRIP);
    );
    _i += 1;
  );
  _h += swing_px(SP_PAD_STRIP);
  _w_out[0] = _max_w;
  _h_out[0] = _h;
);

// ─── Draw the [Card|Strip] toggle row + handle clicks on it ──────────────
// Returns the y-cursor moved past the toggle row.
function swing_popup_draw_toggle_row(_x, _y, _w, _lmb_edge, _mx_in, _my_in)
local(_btn_w, _gap, _btn_h, _cx, _label_w, _label_h, _active, _hover, _bx)
(
  _btn_h = 18;
  _gap = 4;
  _btn_w = (_w - 12 - _gap) / 2;
  _cx = _x + 6;

  // Card button
  _bx = _cx;
  _active = (swing_popup_style == SP_POPUP_STYLE_CARD);
  _hover  = (_mx_in >= _bx && _mx_in <= _bx + _btn_w && _my_in >= _y + 2 && _my_in <= _y + 2 + _btn_h);
  _active ? gfx_set(0.18, 0.30, 0.38, 0.95) : (_hover ? gfx_set(0.10, 0.18, 0.22, 0.95) : gfx_set(0.06, 0.10, 0.13, 0.95));
  gfx_rect(_bx, _y + 2, _btn_w, _btn_h);
  _active ? ( gfx_set(0.85, 0.20, 0.12, 1); gfx_rect(_bx, _y + 2 + _btn_h - 2, _btn_w, 2); );
  gfx_set(0.85, 0.92, 0.94, 1);
  gfx_setfont(1, "Arial", 11);
  gfx_measurestr("Card", _label_w, _label_h);
  gfx_x = _bx + (_btn_w - _label_w) / 2; gfx_y = _y + 2 + (_btn_h - _label_h) / 2;
  gfx_drawstr("Card");
  _hover && _lmb_edge ? swing_popup_style = SP_POPUP_STYLE_CARD;

  // Strip button
  _bx = _cx + _btn_w + _gap;
  _active = (swing_popup_style == SP_POPUP_STYLE_STRIP);
  _hover  = (_mx_in >= _bx && _mx_in <= _bx + _btn_w && _my_in >= _y + 2 && _my_in <= _y + 2 + _btn_h);
  _active ? gfx_set(0.18, 0.30, 0.38, 0.95) : (_hover ? gfx_set(0.10, 0.18, 0.22, 0.95) : gfx_set(0.06, 0.10, 0.13, 0.95));
  gfx_rect(_bx, _y + 2, _btn_w, _btn_h);
  _active ? ( gfx_set(0.85, 0.20, 0.12, 1); gfx_rect(_bx, _y + 2 + _btn_h - 2, _btn_w, 2); );
  gfx_set(0.85, 0.92, 0.94, 1);
  gfx_measurestr("Strip", _label_w, _label_h);
  gfx_x = _bx + (_btn_w - _label_w) / 2; gfx_y = _y + 2 + (_btn_h - _label_h) / 2;
  gfx_drawstr("Strip");
  _hover && _lmb_edge ? swing_popup_style = SP_POPUP_STYLE_STRIP;

  _y + 22;
);

// ─── Dock-layout mini glyphs (VIEW_MODE menu rows 5..8) ──────────────────
// One tiny SCREEN per layout: monitor frame, Swing + Steppa in the bottom
// dock, Browser as a left column, Pad FX as a right column. Included pane =
// filled block; dropped pane = dim outline. Positions are schematic — the
// ReaImGui picker (EON Dock Layout.lua) draws the user's real dock edges,
// but JSFX can't query dock positions and 24px doesn't earn bridge machinery.
// ⚠️ _ord 1..4 must track EON Dock Layout.lua's LAYOUTS table BY INDEX, the
// same contract the row labels already carry:
//   1 Full (all four) · 2 Beatmaking (swing+steppa) ·
//   3 Sound design (swing+browser+padfx) · 4 Pads only (swing).
// Pure rects, no text — leaves font state alone.
function sp_layout_glyph(_ord, _gx, _gy, _gw, _gh)
local(_bw, _dh, _px, _pw, _b_on, _p_on, _sw_on, _st_on)
(
  _b_on  = _ord == 1 || _ord == 3;         // browser
  _p_on  = _ord == 1 || _ord == 3;         // pad fx
  _sw_on = 1;                              // swing is in every layout
  _st_on = _ord == 1 || _ord == 2;         // steppa

  gfx_set(0.30, 0.32, 0.36, 1);            // monitor frame
  gfx_rect(_gx, _gy, _gw, _gh, 0);

  _bw = max((_gw * 0.16)|0, 3);            // side column width
  _dh = max((_gh * 0.5)|0, 4);             // bottom dock height

  // browser — left column
  _b_on ? ( gfx_set(0.62, 0.65, 0.70, 1);  gfx_rect(_gx + 1, _gy + 1, _bw, _gh - 2); )
        : ( gfx_set(0.27, 0.29, 0.32, 1);  gfx_rect(_gx + 1, _gy + 1, _bw, _gh - 2, 0); );
  // pad fx — right column
  _p_on ? ( gfx_set(0.62, 0.65, 0.70, 1);  gfx_rect(_gx + _gw - 1 - _bw, _gy + 1, _bw, _gh - 2); )
        : ( gfx_set(0.27, 0.29, 0.32, 1);  gfx_rect(_gx + _gw - 1 - _bw, _gy + 1, _bw, _gh - 2, 0); );
  // bottom dock: swing left half, steppa right half of the middle span
  _px = _gx + _bw + 2;
  _pw = ((_gw - 2*_bw - 5) / 2)|0;
  _sw_on ? ( gfx_set(0.62, 0.65, 0.70, 1); gfx_rect(_px, _gy + _gh - 1 - _dh, _pw, _dh); )
         : ( gfx_set(0.27, 0.29, 0.32, 1); gfx_rect(_px, _gy + _gh - 1 - _dh, _pw, _dh, 0); );
  _st_on ? ( gfx_set(0.62, 0.65, 0.70, 1); gfx_rect(_px + _pw + 1, _gy + _gh - 1 - _dh, _pw, _dh); )
         : ( gfx_set(0.27, 0.29, 0.32, 1); gfx_rect(_px + _pw + 1, _gy + _gh - 1 - _dh, _pw, _dh, 0); );
);

// ─── Render Card style ───────────────────────────────────────────────────
function swing_popup_draw_card(_x, _y, _w, _h, _lmb_edge, _mx_in, _my_in)
local(_i, _cy, _row_h, _hover, _tw, _th, _label_w, _label_h, _picked, _band, _vis)
(
  // Drop shadow
  gfx_set(0, 0, 0, 0.45);
  gfx_rect(_x + 3, _y + 3, _w, _h);

  // Main background
  gfx_set(0.06, 0.10, 0.13, 0.97);
  gfx_rect(_x, _y, _w, _h);

  // Top accent strip (Swing red)
  gfx_set(0.85, 0.20, 0.12, 1);
  gfx_rect(_x, _y, _w, 2);

  // Border
  gfx_set(0.20, 0.30, 0.36, 0.85);
  gfx_rect(_x, _y, _w, 1);
  gfx_rect(_x, _y + _h - 1, _w, 1);
  gfx_rect(_x, _y, 1, _h);
  gfx_rect(_x + _w - 1, _y, 1, _h);

  // A list taller than the window slides under the box (swing_popup_scroll_px): a row is drawn, hovered and picked only
  // when it lies whole inside the box, clear of the arrow bands.
  _band = swing_popup_scroll_max > 0 ? swing_px(SP_SCROLL_BAND) : 0;
  _cy = _y + _band + swing_px(SP_PAD_CARD) - swing_popup_scroll_px;

  // Toggle row (mockup phase)
  SP_POPUP_SHOW_STYLE_TOGGLE ? (
    _cy = swing_popup_draw_toggle_row(_x, _cy, _w, _lmb_edge, _mx_in, _my_in);
    // Subtle divider below toggle
    gfx_set(0.20, 0.30, 0.36, 0.55);
    gfx_rect(_x + 6, _cy + 1, _w - 12, 1);
    _cy += 4;
  );

  _picked = -1;
  _row_h = swing_px(SP_ROW_H_CARD);
  _i = 0;
  loop(sp_popup_item_count,
    sp_popup_item_sep[_i] ? (
      _cy >= _y + _band && _cy + swing_px(SP_SEP_H_CARD) <= _y + _h - _band ? (
        gfx_set(0.20, 0.30, 0.36, 0.45);
        gfx_rect(_x + swing_px(8), _cy + swing_px(2), _w - swing_px(16), 1);
      );
      _cy += swing_px(SP_SEP_H_CARD);
    ) : (
      _vis = _cy >= _y + _band && _cy + _row_h <= _y + _h - _band;
      sp_popup_item_dis[_i] ? (
        // Header — Swing red, slightly larger, no hover
        _vis ? (
          gfx_setfont(1, "Arial", swing_fs(SP_FS_CARD_HDR), 'b');
          gfx_set(0.85, 0.20, 0.12, 1);
          strcpy_substr(#sp_popup_tmp, #swing_popup_items, sp_popup_item_ofs[_i], sp_popup_item_len[_i]);
          gfx_measurestr(#sp_popup_tmp, _label_w, _label_h);
          gfx_x = _x + swing_px(10); gfx_y = _cy + (_row_h - _label_h) / 2;
          gfx_drawstr(#sp_popup_tmp);
        );
      ) : (
        _hover = _vis && (_mx_in >= _x && _mx_in <= _x + _w && _my_in >= _cy && _my_in <= _cy + _row_h);
        _hover ? (
          // Hover background tinted with the item's own color at low alpha.
          swing_popup_apply_color(sp_popup_item_color[_i], 0.35);
          gfx_rect(_x + swing_px(2), _cy, _w - swing_px(4), _row_h);
          swing_popup_hover_idx = _i;
        );
        _hover && _lmb_edge ? _picked = _i;
        _vis ? (
          gfx_setfont(1, "Arial", swing_fs(SP_FS_CARD));
          // Item text uses its tagged color at full alpha. Untagged → default.
          swing_popup_apply_color(sp_popup_item_color[_i], 1);
          strcpy_substr(#sp_popup_tmp, #swing_popup_items, sp_popup_item_ofs[_i], sp_popup_item_len[_i]);
          gfx_measurestr(#sp_popup_tmp, _label_w, _label_h);
          gfx_x = _x + swing_px(14); gfx_y = _cy + (_row_h - _label_h) / 2;
          gfx_drawstr(#sp_popup_tmp);
        );
      );
      _cy += _row_h;
    );
    _i += 1;
  );
  _picked >= 0 ? swing_popup_close(swing_popup_visual_to_result(_picked));
);

// ─── Render Strip style ──────────────────────────────────────────────────
function swing_popup_draw_strip(_x, _y, _w, _h, _lmb_edge, _mx_in, _my_in)
local(_i, _cy, _row_h, _hover, _label_w, _label_h, _picked, _pill_pad, _res, _band, _vis, _t)
(
  // Drop shadow
  gfx_set(0, 0, 0, 0.45);
  gfx_rect(_x + 2, _y + 2, _w, _h);

  // Main background — very dark, flat
  gfx_set(0.03, 0.05, 0.07, 0.97);
  gfx_rect(_x, _y, _w, _h);

  // Single-pixel border
  gfx_set(0.20, 0.30, 0.36, 0.70);
  gfx_rect(_x, _y, _w, 1);
  gfx_rect(_x, _y + _h - 1, _w, 1);
  gfx_rect(_x, _y, 1, _h);
  gfx_rect(_x + _w - 1, _y, 1, _h);

  // A list taller than the window slides under the box (see the card): a row is drawn, hovered and picked only when
  // it lies whole inside the box, clear of the arrow bands.
  _band = swing_popup_scroll_max > 0 ? swing_px(SP_SCROLL_BAND) : 0;
  _cy = _y + _band + swing_px(SP_PAD_STRIP) - swing_popup_scroll_px;

  // Toggle row (mockup phase)
  SP_POPUP_SHOW_STYLE_TOGGLE ? (
    _cy = swing_popup_draw_toggle_row(_x, _cy, _w, _lmb_edge, _mx_in, _my_in);
    _cy += 2;
  );

  _picked = -1;
  _row_h = swing_px(SP_ROW_H_STRIP);
  _pill_pad = 4;
  _i = 0;
  loop(sp_popup_item_count,
    sp_popup_item_sep[_i] ? (
      _cy >= _y + _band && _cy + swing_px(SP_SEP_H_STRIP) <= _y + _h - _band ? (
        gfx_set(0.20, 0.30, 0.36, 0.30);
        gfx_rect(_x + swing_px(6), _cy + swing_px(2), _w - swing_px(12), 1);
      );
      _cy += swing_px(SP_SEP_H_STRIP);
    ) : (
      _vis = _cy >= _y + _band && _cy + _row_h <= _y + _h - _band;
      sp_popup_item_dis[_i] ? (
        // Header — small caps, dimmer red. Bold unless it holds a digit and is
        // under 10 px ("Bank B's pads start 16 notes ..."): wiki 4.7.
        _vis ? (
          gfx_set(0.85, 0.20, 0.12, 0.85);
          strcpy_substr(#sp_popup_tmp, #swing_popup_items, sp_popup_item_ofs[_i], sp_popup_item_len[_i]);
          gfx_setfont(1, "Arial", swing_fs(SP_FS_STRIP_HDR), swing_txt_wt(swing_fs(SP_FS_STRIP_HDR), #sp_popup_tmp));
          gfx_measurestr(#sp_popup_tmp, _label_w, _label_h);
          gfx_x = _x + swing_px(6); gfx_y = _cy + (_row_h - _label_h) / 2;
          gfx_drawstr(#sp_popup_tmp);
        );
      ) : (
        // Pill background uses the item's tagged color — low-alpha when
        // resting, full-bodied on hover. Untagged → neutral dark fill.
        _hover = _vis && (_mx_in >= _x + 4 && _mx_in <= _x + _w - 4 && _my_in >= _cy && _my_in <= _cy + _row_h - 2);
        _vis ? (
          sp_popup_item_color[_i] ? (
            swing_popup_apply_color(sp_popup_item_color[_i], _hover ? 1.0 : 0.62);
          ) : (
            _hover ? gfx_set(0.18, 0.32, 0.42, 0.90) : gfx_set(0.08, 0.13, 0.16, 0.85);
          );
          gfx_rect(_x + 4, _cy, _w - 8, _row_h - 2);
          // Dock-layout rows (VIEW_MODE results 5..8, after the #DOCK LAYOUT
          // header which counts in results) carry a mini layout glyph at the
          // left edge of the pill; the centered label clears it comfortably
          // (the "Auto — follow window shape" row fixes the menu width).
          swing_popup_caller_id == SP_POPUP_CALLER_VIEW_MODE ? (
            _res = swing_popup_visual_to_result(_i);
            (_res >= 5 && _res <= 8) ? sp_layout_glyph(_res - 4, _x + 9, _cy + 2, 24, _row_h - 6);
          );
          _hover ? (
            // Red underline accent — consistent across colored / neutral pills
            gfx_set(0.85, 0.20, 0.12, 0.90);
            gfx_rect(_x + 4, _cy + _row_h - 4, _w - 8, 2);
          );
          // Tick for a checked item. Two strokes rather than a glyph: the
          // console cannot depend on a font having one, and a missing glyph is
          // an invisible state. Sized with the surface.
          sp_popup_item_chk[_i] ? (
            _t = swing_px(1);
            gfx_set(0.95, 0.97, 0.98, 0.95);
            gfx_line(_x + swing_px(10), _cy + _row_h / 2 - _t,     _x + swing_px(13), _cy + _row_h / 2 + 2 * _t);
            gfx_line(_x + swing_px(13), _cy + _row_h / 2 + 2 * _t, _x + swing_px(18), _cy + _row_h / 2 - 5 * _t);
            gfx_line(_x + swing_px(10), _cy + _row_h / 2,          _x + swing_px(13), _cy + _row_h / 2 + 3 * _t);
            gfx_line(_x + swing_px(13), _cy + _row_h / 2 + 3 * _t, _x + swing_px(18), _cy + _row_h / 2 - 4 * _t);
          );
          gfx_setfont(1, "Arial", swing_fs(SP_FS_STRIP));
          gfx_set(0.95, 0.97, 0.98, 1);   // always white-ish text — readable on any color
          strcpy_substr(#sp_popup_tmp, #swing_popup_items, sp_popup_item_ofs[_i], sp_popup_item_len[_i]);
          gfx_measurestr(#sp_popup_tmp, _label_w, _label_h);
          gfx_x = _x + (_w - _label_w) / 2; gfx_y = _cy + (_row_h - 2 - _label_h) / 2;
          gfx_drawstr(#sp_popup_tmp);
        );
        _hover ? swing_popup_hover_idx = _i;
        _hover && _lmb_edge ? _picked = _i;
      );
      _cy += _row_h;
    );
    _i += 1;
  );
  _picked >= 0 ? swing_popup_close(swing_popup_visual_to_result(_picked));
);

// ─── The arrow bands of a list that scrolls: dark bands over the box's top and bottom edges, a triangle each, lit
// while more rows lie that way ────────────────────────────────────────────
function swing_popup_draw_bands(_x, _y, _w, _h, _band) local(_cx, _ay) (
  _cx = _x + _w * 0.5;
  gfx_set(0.03, 0.05, 0.07, 0.97);
  gfx_rect(_x + 1, _y + 1, _w - 2, _band);
  gfx_rect(_x + 1, _y + _h - 1 - _band, _w - 2, _band);
  swing_popup_scroll_px > 0 ? gfx_set(0.85, 0.92, 0.94, 0.95) : gfx_set(0.85, 0.92, 0.94, 0.25);
  _ay = _y + 1 + _band * 0.5;
  gfx_triangle(_cx, _ay - _band * 0.25, _cx - _band * 0.35, _ay + _band * 0.2, _cx + _band * 0.35, _ay + _band * 0.2);
  swing_popup_scroll_px < swing_popup_scroll_max ? gfx_set(0.85, 0.92, 0.94, 0.95) : gfx_set(0.85, 0.92, 0.94, 0.25);
  _ay = _y + _h - 1 - _band * 0.5;
  gfx_triangle(_cx, _ay + _band * 0.25, _cx - _band * 0.35, _ay - _band * 0.2, _cx + _band * 0.35, _ay - _band * 0.2);
);

// ─── Per-frame tick — call LAST in @gfx so the popup renders on top ──────
function swing_popup_tick()
local(_w_arr, _h_arr, _w, _h, _x, _y, _lmb_edge, _esc, _click_outside, _mx_in, _my_in, _full, _lim, _row_h, _band, _on_top, _on_bot, _step)
(
  swing_popup_active ? (
    // Reserved scratch out-params (allocated in swing_popup_init).
    swing_popup_style == SP_POPUP_STYLE_STRIP ?
      swing_popup_metrics_strip(sp_popup_scratch_w, sp_popup_scratch_h)
    : swing_popup_metrics_card(sp_popup_scratch_w, sp_popup_scratch_h);
    _w = sp_popup_scratch_w[0];
    _full = sp_popup_scratch_h[0];
    // A list taller than the window (2026-10-21): the box is capped at the window's height and the rows slide under it
    // (swing_popup_scroll_px). The pad category menu's 48 rows never fit a 780 px window; the bigger rows made every
    // long menu need this.
    _row_h = swing_px(swing_popup_style == SP_POPUP_STYLE_STRIP ? SP_ROW_H_STRIP : SP_ROW_H_CARD);
    _lim = max(_row_h * 3, gfx_h - 8);
    _band = _full > _lim ? swing_px(SP_SCROLL_BAND) : 0;                    // the bands take their room from the rows'
    swing_popup_scroll_max = _full > _lim ? _full - (_lim - 2 * _band) : 0;   // so the last row clears the bottom band
    _h = _full > _lim ? _lim : _full;
    swing_popup_scroll_px = max(0, min(swing_popup_scroll_max, swing_popup_scroll_px));
    _x = swing_popup_x;
    _y = swing_popup_y;
    // Clamp to window so the popup never falls off-screen
    _x + _w > gfx_w ? _x = gfx_w - _w - 4;
    _y + _h > gfx_h ? _y = gfx_h - _h - 4;
    _x < 4 ? _x = 4;
    _y < 4 ? _y = 4;
    swing_popup_box_x = _x; swing_popup_box_y = _y; swing_popup_box_w = _w; swing_popup_box_h = _h;
    // Modal gate has zeroed lmb_down/LMB; read the preserved raw copies.
    // Suppress the click that opened the popup (just_opened latch).
    _lmb_edge = _raw_lmb_down && !swing_popup_just_opened;
    swing_popup_just_opened = 0;
    _mx_in = mx;
    _my_in = my;
    swing_popup_hover_idx = -1;
    swing_popup_wheel = 0;   // cleared each frame; set below only on a wheel-over-item
    // The scroll: the wheel moves a row a tick; the mouse resting on a band moves the rows (quicker after twenty
    // frames); a click on a band moves a row and is neither a pick nor a cancel.
    swing_popup_scroll_max > 0 ? (
      _on_top = _mx_in >= _x && _mx_in <= _x + _w && _my_in >= _y && _my_in < _y + _band;
      _on_bot = _mx_in >= _x && _mx_in <= _x + _w && _my_in > _y + _h - _band && _my_in <= _y + _h;
      _raw_wheel != 0 ? swing_popup_scroll_px -= _raw_wheel * _row_h;
      (_on_top || _on_bot) ? (
        swing_popup_band_t += 1;
        _step = swing_popup_band_t > 20 ? swing_px(6) : swing_px(2);
        _lmb_edge ? _step = _row_h;
        _on_top ? swing_popup_scroll_px -= _step : swing_popup_scroll_px += _step;
        _lmb_edge = 0;
      ) : swing_popup_band_t = 0;
      swing_popup_scroll_px = max(0, min(swing_popup_scroll_max, swing_popup_scroll_px));
    );
    swing_popup_style == SP_POPUP_STYLE_STRIP ?
      swing_popup_draw_strip(_x, _y, _w, _h, _lmb_edge, _mx_in, _my_in)
    : swing_popup_draw_card(_x, _y, _w, _h, _lmb_edge, _mx_in, _my_in);
    _band > 0 ? swing_popup_draw_bands(_x, _y, _w, _h, _band);
    // Hover-scroll: wheel turned while the mouse is over an item → publish the
    // direction + that item's 1-based result index for the caller to act on
    // (e.g. the gear menu toggles the hovered pref). The menu stays open. The
    // draw sets swing_popup_hover_idx above; _raw_wheel is preserved by the
    // modal gate (which zeroes frame_wheel so the underlying UI never reacts).
    // Not while the list scrolls: the wheel is the scroll's then.
    swing_popup_scroll_max == 0 && _raw_wheel != 0 && swing_popup_hover_idx >= 0 ? (
      swing_popup_wheel        = _raw_wheel > 0 ? 1 : -1;
      swing_popup_wheel_result = swing_popup_visual_to_result(swing_popup_hover_idx);
    );
    // Click outside → cancel
    _click_outside = _lmb_edge && (_mx_in < _x || _mx_in > _x + _w || _my_in < _y || _my_in > _y + _h);
    _click_outside ? swing_popup_close(-1);
    // ESC closes — uses _char which the main @gfx captures once via
    // gfx_getchar() at the top of every frame (the "Frame globals" block
    // that opens Swing_ReaKit.jsfx's @gfx).
    // Reading _char here is non-destructive (the queue was already drained).
    _esc = swing_popup_active && _char == 27;
    _esc ? swing_popup_close(-1);
  );
);
