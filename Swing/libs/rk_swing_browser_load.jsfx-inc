// rk_swing_browser_load.jsfx-inc
// Browser sample-load handlers (CMD 63 / 64) extracted from Swing_ReaKit.jsfx.
// (c) EON Studios — All Rights Reserved
//
// Both functions are DRIVEN FROM @block, with an @gfx pass as the fallback for
// a stalled audio thread. (The comment here said "@gfx" long after the primary
// dispatch moved, which in a file whose comments ARE the concurrency spec is a
// bug waiting to be written. Corrected 2026-09-09.) The browser companion writes
// the path chars + control fields to gmem and the JSFX consumes them; clear_pad
// and load_*_from_path touch shared sample buffers, so both sides observe the
// same CMD handshake rather than free-running. They share the same protocol:
//
//   GS_BROWSE_PAD          — target pad index
//   GS_BROWSER_PATH        — UTF-8 path chars (max GS_BROWSER_PATH_MAX)
//   GS_BROWSER_PATH_LEN    — path length
//   GS_BROWSE_LAYER        — (CMD 64 only) layer index 0..MAX_LAYERS-1
//
// Both kill any active voices on the target pad and arm a 10ms crossfade
// (#_browser_path / _xf_* / v_* live at file scope). Pad names come from
// auto_name_from_file() called inside load_from_path / load_layer_from_path
// and are pushed to gmem PADNAME unconditionally inside the handler (no
// gmem read, no dependency on sync_note_names firing).
//
// sync_note_names is called directly (not deferred) so CMD=52 clears
// before the user's next action. The multi-load queue waits one bridge
// round-trip per pad, but this avoids CMD=52 colliding with kit-load
// or other bridge commands the user triggers right after a drag.
//
// Undo coverage: the v2 internal undo (undo_begin_pad / undo_cap_end below)
// captures audio + meta + names for every drop, so Swing's own UNDO restores
// the whole pad. No REAPER undo point is minted for a drop -- the CMD 46 host
// block this comment once described was retired -- so Ctrl+Z right after a
// drop changes nothing (REAPER restores the previous point's snapshot, and
// an FX whose chunk did not differ between snapshots is not reloaded). When
// REAPER does reload this FX's chunk (undoing an older point that captured a
// Swing change), @serialize restores names AND audio together; the old
// "new sample with the old path label" limitation no longer exists.
// Measured 2026-09-08: .dev_tests/EON_Probe_Undo_probe.lua, verdicts C + A2.

@init
// Sliced loads (2026-09-07): the file read is pumped one bounded slice per
// @block by rk_swing_core's swing_ldr_*, so a handler may span several blocks.
// First entry does the setup and starts the load; while it is in flight the
// handler leaves CMD set, records the job in _bl_job_*, and returns; each later
// block re-enters (same dispatch gate), pumps, and on the block where the load
// lands runs the completion half below. The @gfx stall-fallback enters the same
// way and pumps the same job, so an engine that stopped mid-load still finishes.
// _bl_job_pending is also read by the stale-job guard in @block and by the
// import tick's capture-depth leak guard.
// ─── CMD 63 — single-pad sample load: completion half ───────────────────────
function swing_browser_load_pad_done(_bp_pad)
local(_ci, _cn, _cnl)
(
    // ④ FILL naming (consume-once): a requester that staged a DISPLAY name
    // (the kit pad's name) into KIT_GMEM_PADNAMES sets GS_BROWSE_NAME_ADOPT=1
    // just before CMD 63 — adopt it as cname over the auto_name_from_file
    // basename (store-extraction fills otherwise name every pad "padNN_layN").
    // The @block live-name mirror can stomp the staged chars in the µs gap
    // between the requester's name write and its CMD write (the mirror only
    // yields once CMD==63): failure mode is "pad keeps its previous name" —
    // rare and benign. Empty staged name -> keep the auto name.
    gmem[GS_BROWSE_NAME_ADOPT] > 0.5 ? (
      gmem[GS_BROWSE_NAME_ADOPT] = 0;
      _cnl = 0;
      while (_cnl < KIT_GMEM_PADNAME_LEN &&
             (gmem[KIT_GMEM_PADNAMES + _bp_pad * KIT_GMEM_PADNAME_LEN + _cnl]|0) > 0) (
        _cnl += 1;
      );
      _cnl > 0 ? (
        _cn = get_cname_slot(_bp_pad);
        str_setlen(_cn, _cnl);
        _ci = 0; loop(_cnl,
          str_setchar(_cn, _ci,
            gmem[KIT_GMEM_PADNAMES + _bp_pad * KIT_GMEM_PADNAME_LEN + _ci]|0);
          _ci += 1;
        );
      );
    );
    undo_cap_end();
    recalc_pad(_bp_pad);
    recalc_fx(_bp_pad);   // defensive: rebuild per-pad biquad coefs to match
                          // defaults clear_pad wrote (process_pad_fx gates on
                          // params so stale coefs are unreachable, but keep
                          // the state tree consistent for debugging/display).
    s_dirty[_bp_pad] = 1;
    // Pad name → gmem PADNAME: auto_name_from_file() (called inside the
    // loader) already set cname. Push it to gmem now so:
    //   (a) browser sees the new name on its very next read,
    //   (b) reverse-sync can't copy a stale @block-clobbered gmem
    //       value back into cname on the next @gfx frame.
    // sync_note_names does the same for ALL pads but its gate can
    // fail (BRIDGE_ALIVE=0). This per-pad write is unconditional.
    _cn = get_cname_slot(_bp_pad);
    _cnl = strlen(_cn);
    _ci = 0; loop(KIT_GMEM_PADNAME_LEN,
      gmem[KIT_GMEM_PADNAMES + _bp_pad * KIT_GMEM_PADNAME_LEN + _ci] =
        _ci < _cnl ? str_getchar(_cn, _ci) : 0;
      _ci += 1;
    );
    // Write actual audio length (non-layered) or sentinel 1 (layered) so the
    // bridge can read pad audio out of gmem without racing the @gfx mirror.
    gmem[KIT_GMEM_AUDIOLEN + _bp_pad] =
      s_len[_bp_pad] > 0 ? s_len[_bp_pad] :
      (pad_has_audio(_bp_pad) ? 1 : 0);
    mark_dirty_pad(_bp_pad);
    col_dirty = 1;  // Re-derive auto-color hue from new filename (CMD 63)
    // Immediate auto-color derive + gmem write so browser pads update on
    // the same @gfx cycle. Without this, the browser only sees the new
    // color on the NEXT frame (col_dirty → rebuild → sync runs before
    // CMD 63 in the @gfx order, so the per-frame sync writes stale hues
    // for the frame CMD 63 fires).
    col_auto_mode_id == COL_AUTO_DRUMTYPE ? (
      col_auto_hue[_bp_pad] = swing_color_drumtype_hue(_bp_pad);
    ) : col_auto_mode_id == COL_AUTO_OUTPUT ? (
      col_auto_hue[_bp_pad] = p_output[_bp_pad] / 16.0;
    ) : col_auto_mode_id == COL_AUTO_RAINBOW ? (
      col_auto_hue[_bp_pad] = _bp_pad / 16.0;
    );
    gmem[KIT_GMEM_META + _bp_pad * KIT_GMEM_META_PP + 12] =
      col_auto_mode_id > 0 ? col_auto_hue[_bp_pad] : p_color[_bp_pad];
    // Visual feedback: trigger the existing pad_flash fade (8-frame white
    // overlay → ~250ms confirmation that the drop landed and the category
    // color got assigned). Reuses rk_swing_ui_grid_pads.jsfx-inc:85-89.
    pad_flash[_bp_pad] = 12;
    // Consume CMD before sync_note_names: its gate requires CMD==0.
    gmem[KIT_GMEM_CMD] = 0;
    sync_note_names();
    // Ask the bridge to detect this pad's root note (EON_ROOTNOTE band).
    // A CMD-63 load is handled entirely JSFX-side — it never enters the
    // bridge's loader — so this mailbox is the ONLY way a browser or drag-drop
    // load ever gets analysed. Four gmem writes; the bridge does the work and
    // throttles it to one file per tick.
    swing_lcd_rootnote_request(_bp_pad);
);
// ─── CMD 63 — single-pad sample load ────────────────────────────────────
// Fully resets the pad (clear_pad) before loading: leaving stale layers
// would cause Sum-mode mixing with the previous sample, and stale per-pad
// gain/pan/tune would leak the old kit's mix into the new sound.
function swing_browser_load_pad()
local(_bp_pad, _bp_len, _xf_vi, _ci)
(
  // In-flight latch (2026-07-27 double-dispatch fix): both dispatch sites
  // (@block + @gfx stall-fallback) check !_bl_inflight, so a handler that is
  // mid-disk-load on one thread can't be re-entered from the other.
  _bl_inflight = 1;
  // Multi-instance gate: only respond if browser targets this instance
  // (or no specific target is set). Without this, a second Swing instance
  // would also load the sample, hijacking the user's intended target.
  _is_browser_target() ? (
  _bl_job_pending && _bl_job_cmd == 63 ? (
    // Resume: pump the load begun on an earlier block; complete when it lands.
    swing_ldr_step_pad(_bl_job_pad, #_browser_path) ? (
      _bl_job_pending = 0;
      swing_browser_load_pad_done(_bl_job_pad);
    );
  ) :
  // A level-204 Kit Bridge consumes CMD 63 itself and streams the decoded file
  // (EON_PADPCM, rk_swing_padpcm.jsfx-inc): the job begins on the stream's FIRST
  // chunk and resumes above. _bridge_state (decided once per block in
  // swing_padpcm_tick, 2026-09-10) splits the rest three ways: 1 = a bridge is
  // running but predates this JSFX (every ReaPack sync, until REAPER restarts)
  // -> REFUSE, the pad stays exactly as it was, the LCD says restart; 0 = no
  // bridge at all -> the file read below, the only way a fresh install can load
  // anything, and the LCD says so.
  _bridge_state == 2 ? ( 0; ) :
  _bridge_state == 1 ? (
    swing_ldr_bridge_notice(1);
    gmem[GS_BROWSE_NAME_ADOPT] = 0;   // a staged name must not rename a later load
    gmem[KIT_GMEM_CMD] = 0;           // consume it, or the browser waits for ever
  ) : (
  _bp_pad = gmem[GS_BROWSE_PAD]|0;
  _bp_len = gmem[GS_BROWSER_PATH_LEN]|0;
  _bp_pad >= 0 && _bp_pad < NUM_PADS && _bp_len > 0 && _bp_len < GS_BROWSER_PATH_MAX ? (
    swing_ldr_bridge_notice(0);   // no bridge: the file read it always could do, said on the LCD
    // Tukan-style undo: REAPER's chunk diff captures the load via
    // mark_dirty_pad(_bp_pad) below. Audio is in @serialize.
    // Kill any active voices on this pad + activate crossfade before overwriting buffer
    _xf_vi = 0; loop(MAX_VOICES + 1,
      v_slot[_xf_vi] == _bp_pad ? ( v_pos[_xf_vi] = -1; v_env[_xf_vi] = 0; v_stage[_xf_vi] = 0; );
      _xf_vi += 1;
    );
    // Gate threshold -40 dB: only arm crossfade when residue is clearly
    // audible. Below -40 dB, snap-cut is masked by noise floor — and arming
    // for sub-audible residue means the ramp attenuates the next hit's
    // transient before the @sample short-circuit (-80 dB) can deactivate.
    !_xf_active && abs(_xf_prev[0]) + abs(_xf_prev[1]) > 0.01 ? (
      _xf_pos = 0;
      _xf_len = max(1, (0.010 * srate)|0);  // 10ms crossfade for single pad
      _xf_active = 1;
    );
    strcpy(#_browser_path, "");
    _ci = 0; loop(_bp_len,
      str_setchar(#_browser_path, _ci, gmem[GS_BROWSER_PATH + _ci]);
      _ci += 1;
    );
    str_setlen(#_browser_path, _bp_len);
    // Single-sample drop semantics: fully reset the pad before loading.
    // (Leaving stale layers causes Sum-mode mixing with the old kit sound;
    //  leaving stale per-pad gain/pan/tune leaks kit mix into the new sample.)
    //
    // ⚠️ ONE outer undo bracket around clear_pad + the load. Without it,
    // each captures a structural snapshot at depth 0 independently, and
    // undo_capture_pad OVERWRITES on every depth-0 capture — so the surviving
    // snapshot is the state AFTER clear_pad (an EMPTY pad), and the in-plugin
    // UNDO restores the pad to empty instead of its prior content, dropping
    // the layer paths the 8435847 backup was meant to preserve (verified
    // 2026-07-13). The outer undo_begin_pad captures the pre-edit (layered)
    // state ONCE with names+LPATH; the inner clear_pad / loader calls run at
    // depth >= 1, so their captures no-op. The bracket closes in the
    // completion half — possibly several blocks later.
    undo_begin_pad(_bp_pad);
    clear_pad(_bp_pad);
    _bl_job_pending = 1; _bl_job_cmd = 63; _bl_job_pad = _bp_pad;
    swing_ldr_step_pad(_bp_pad, #_browser_path) ? (
      _bl_job_pending = 0;
      swing_browser_load_pad_done(_bp_pad);
    );
  ) : (
    // Validation failed (bad pad index or path length) — still consume CMD
    // so the bridge isn't stuck waiting on an in-flight command. Also drop
    // a staged-name flag so it can't rename a LATER unrelated browse load.
    gmem[GS_BROWSE_NAME_ADOPT] = 0;
    gmem[KIT_GMEM_CMD] = 0;
  );
  );  // resume / start
  );  // _is_browser_target gate
  _bl_inflight = 0;
);
// ─── CMD 64 — per-layer sample load: completion half ────────────────────
function swing_browser_load_layer_done(_bp_pad, _bp_layer)
local(_ci, _cn, _cnl)
(
    recalc_pad(_bp_pad);
    s_dirty[_bp_pad] = 1;
    // Pad name → gmem PADNAME (same as CMD 63 — see comment there).
    _cn = get_cname_slot(_bp_pad);
    _cnl = strlen(_cn);
    _ci = 0; loop(KIT_GMEM_PADNAME_LEN,
      gmem[KIT_GMEM_PADNAMES + _bp_pad * KIT_GMEM_PADNAME_LEN + _ci] =
        _ci < _cnl ? str_getchar(_cn, _ci) : 0;
      _ci += 1;
    );
    gmem[KIT_GMEM_AUDIOLEN + _bp_pad] =
      s_len[_bp_pad] > 0 ? s_len[_bp_pad] :
      (pad_has_audio(_bp_pad) ? 1 : 0);
    mark_dirty_pad(_bp_pad);
    col_dirty = 1;  // Re-derive auto-color hue from new filename (CMD 64)
    // Immediate auto-color derive + gmem write (same rationale as CMD 63)
    col_auto_mode_id == COL_AUTO_DRUMTYPE ? (
      col_auto_hue[_bp_pad] = swing_color_drumtype_hue(_bp_pad);
    ) : col_auto_mode_id == COL_AUTO_OUTPUT ? (
      col_auto_hue[_bp_pad] = p_output[_bp_pad] / 16.0;
    ) : col_auto_mode_id == COL_AUTO_RAINBOW ? (
      col_auto_hue[_bp_pad] = _bp_pad / 16.0;
    );
    gmem[KIT_GMEM_META + _bp_pad * KIT_GMEM_META_PP + 12] =
      col_auto_mode_id > 0 ? col_auto_hue[_bp_pad] : p_color[_bp_pad];
    // Visual feedback: trigger the existing pad_flash fade (8-frame white
    // overlay → ~250ms confirmation that the drop landed and the category
    // color got assigned). Reuses rk_swing_ui_grid_pads.jsfx-inc:85-89.
    pad_flash[_bp_pad] = 12;
    // Consume CMD before sync_note_names (see CMD 63 comment).
    gmem[KIT_GMEM_CMD] = 0;
    sync_note_names();
    // Root-note re-detect (see CMD 63). Layer 0 IS the pad's voice, so it
    // decides the root note; layers 1..n are velocity/RR variants of the same
    // drum and must not re-trigger analysis — same rule the category post uses.
    _bp_layer == 0 ? swing_lcd_rootnote_request(_bp_pad);
);
// ─── CMD 64 — per-layer sample load ─────────────────────────────────────
// Same protocol as CMD 63 with the addition of GS_BROWSE_LAYER. Does NOT
// clear the pad: layer load is additive. Pad name is only refreshed when
// layer 0 is targeted (layers 1..3 keep the existing display name).
function swing_browser_load_layer()
local(_bp_pad, _bp_layer, _bp_len, _xf_vi, _ci)
(
  _bl_inflight = 1;   // double-dispatch latch (see swing_browser_load_pad)
  // Multi-instance gate (see swing_browser_load_pad)
  _is_browser_target() ? (
  _bl_job_pending && _bl_job_cmd == 64 ? (
    // Resume: pump the load begun on an earlier block; complete when it lands.
    swing_ldr_step_layer(_bl_job_pad, _bl_job_layer, #_browser_path) ? (
      _bl_job_pending = 0;
      swing_browser_load_layer_done(_bl_job_pad, _bl_job_layer);
    );
  ) :
  // A level-204 Kit Bridge streams CMD 64 too; the same three-way split as
  // swing_browser_load_pad (refuse an old bridge, read the file when there is none).
  _bridge_state == 2 ? ( 0; ) :
  _bridge_state == 1 ? (
    swing_ldr_bridge_notice(1);
    gmem[KIT_GMEM_CMD] = 0;
  ) : (
  _bp_pad = gmem[GS_BROWSE_PAD]|0;
  _bp_layer = gmem[GS_BROWSE_LAYER]|0;
  _bp_len = gmem[GS_BROWSER_PATH_LEN]|0;
  _bp_pad >= 0 && _bp_pad < NUM_PADS && _bp_layer >= 0 && _bp_layer < MAX_LAYERS && _bp_len > 0 && _bp_len < GS_BROWSER_PATH_MAX ? (
    swing_ldr_bridge_notice(0);   // no bridge: the file read, said on the LCD
    // Tukan-style undo: REAPER's chunk diff captures the load via
    // mark_dirty_pad(_bp_pad) below. Audio is in @serialize.
    // Kill active voices on this pad + crossfade
    _xf_vi = 0; loop(MAX_VOICES + 1,
      v_slot[_xf_vi] == _bp_pad ? ( v_pos[_xf_vi] = -1; v_env[_xf_vi] = 0; v_stage[_xf_vi] = 0; );
      _xf_vi += 1;
    );
    // Gate threshold -40 dB (see CMD 63 above for rationale).
    !_xf_active && abs(_xf_prev[0]) + abs(_xf_prev[1]) > 0.01 ? (
      _xf_pos = 0;
      _xf_len = max(1, (0.010 * srate)|0);
      _xf_active = 1;
    );
    strcpy(#_browser_path, "");
    _ci = 0; loop(_bp_len,
      str_setchar(#_browser_path, _ci, gmem[GS_BROWSER_PATH + _ci]);
      _ci += 1;
    );
    str_setlen(#_browser_path, _bp_len);
    _bl_job_pending = 1; _bl_job_cmd = 64; _bl_job_pad = _bp_pad; _bl_job_layer = _bp_layer;
    swing_ldr_step_layer(_bp_pad, _bp_layer, #_browser_path) ? (
      _bl_job_pending = 0;
      swing_browser_load_layer_done(_bp_pad, _bp_layer);
    );
  ) : (
    // Validation failed (bad pad index or path length) — still consume CMD
    // so the bridge isn't stuck waiting on an in-flight command.
    gmem[KIT_GMEM_CMD] = 0;
  );
  );  // resume / start
  );  // _is_browser_target gate
  _bl_inflight = 0;
);
