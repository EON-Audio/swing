// rk_swing_ui_fxview.jsfx-inc — EON FX Picker, the big-view face.
//
// Spec: .docs/specs/Spec_FX_Picker.md   Plan: .docs/specs/Plan_FX_Picker_P2.md
// Engine (Lua, already built and REAPER-verified): Scripts/rk_lua_fxpicker.lua
//
// What this file owns (it began as the S1 shell -- chrome, title, close, three
// empty columns -- and grew): the picker's side of the gmem protocol with the
// FX picker bridge (EON_FXPicker_Bridge.lua) -- the page request (FXP_REQ_*),
// the search and filter cells, the action mailbox (FXP_ACT_*, one unacked verb
// at a time) and the target (FXP_TGT_*) -- plus the seqlocked snapshots of the
// published plugin page, the target chain and the banks table, and every face
// that draws them: the list and grid, the banks rail, the chain, the CHAINS
// (.RfxChain) browser, the FX tab (swing_fxview_lcd) and the rack.
//
// ── FULL-WINDOW, not the pad-grid rect ──────────────────────────────────────
// Every other big view paints into grid_x/grid_y/grid_w/grid_h (476×614 at the
// default 780×780). This one, and the console, take the whole area under the
// header: 764×736.
//
// Card sizes, measured rather than assumed (an earlier note here said 264×124
// and a 191×90 floor — both came from a 2.13:1 card, and the deck is 1.714:1).
// The sheet lays its card face out at 144×84, so the master is 576×336. From
// swing_fxview_layout() at the default 780×780 — panel 764×738, body 636 —
// a full-panel grid is 181×106, four across, five rows: 20 cards a page.
//
// ⭐ The old "191 px or it stops reading" floor was a RASTER limit and no
// longer binds: cards are DRAWN (rk_swing_fxcard.jsfx-inc), legible at 96 and
// readable at 48. So 145×85 three-across inside the 452 px list column is also
// viable, and it keeps the banks rail and the chain on screen while browsing.
// Inside the OLD 476 px grid rect the list was 215 px, which would have given
// four columns of 53 — that is what made full width necessary, and the list
// column more than doubling (215 → 460) came free with it.
//
// (c) EON Studios — All Rights Reserved

// ⚠️ @init IS LOAD-BEARING. A .jsfx-inc without it registers ZERO functions
// and still lints as "0 errors", because nothing was parsed at all. The
// importing file is where that shows up — Swing_ReaKit.jsfx reported
// "Unknown function swing_fxview_draw()" while this file passed its own
// audit. Absence of output is not a pass (.docs/wiki/02-file-structure.md).
@init

// ⚠️ NO freemem HERE. Imports are inlined at Swing_ReaKit.jsfx:153, but
// `freemem = 0` does not run until :298 — so an allocation in this file's
// @init would take address 0 and then be silently overwritten by every real
// allocation that follows. Not one sibling UI lib touches freemem for exactly
// this reason; they all expose an init(mem) that the main file calls in order.
// swing_fxview_init is that, and it is called beside swing_kitsview_init.
_fxv_rows = 0;
_fxv_seen = -1;      // last PUB_SEQ consumed
_fxv_req_seq = 0;
_fxv_n = 0; _fxv_total = 0; _fxv_off = 0; _fxv_hb = 0;
_fxv_hb_last = -1; _fxv_hb_t = 0; _fxv_live = 0;
FXV_ROW_H_B = 40;    // list row pitch; chip and text are sized off it
FXV_ROW_H  = FXV_ROW_H_B;   // rescaled per frame in swing_fxview_layout()
// The row's card. ⚠️ 1.714:1 is the deck's aspect and is NOT negotiable -- the
// motifs are drawn to it, and a card given the wrong shape does not letterbox,
// it deforms. 58/1.714 = 33.8, so 34.
FXV_CARD_W_B = 58;
FXV_CARD_H_B = 34;
FXV_CARD_W = FXV_CARD_W_B;
FXV_CARD_H = FXV_CARD_H_B;
// Chain-slot pitch. ⚠️ Was the literal 26 in FOUR places -- the slot loop, the
// "+N more" line, the + seat and the row-fit count -- which is the same drift
// the rail's own pitch had before it became a constant. One name, four users.
FXV_SLOT_H_B = 31;
FXV_SLOT_H = FXV_SLOT_H_B;
FXV_RAIL_H_B = 26;   // banks-rail row pitch. ⚠️ Was the literal 18, written in
                     // FOUR places across the row renderer and its loop -- one
                     // constant so the hit box and the paint cannot drift.
// ── the rail's own filter ───────────────────────────────────────────────────
// Deliberately SHORTER than the plugin query: this narrows a list of at most
// 96 bank names (FXP_TB_MAX), so it is a narrowing box, not a search field.
FXV_BQ_MAX = 24;
FXV_RAIL_H = FXV_RAIL_H_B;
FXV_BQ_H_B = 20;     // the filter row's height, and the rail's top inset
FXV_BQ_H   = FXV_BQ_H_B;

_fxv_bqn   = 0;      // rail filter length
_fxv_bqc   = 0;      // caret
_fxv_bqfoc = 0;      // 1 = the RAIL box is taking keys (never both at once)
_fxv_vn    = 0;      // visible rail rows built this frame

_fxv_mode  = 0;      // 0 = list, 1 = card grid
_fxv_want  = 0;      // rows the current mode wants; a change re-asks
_fxv_scroll = 0;     // FIRST VISIBLE ROW in the full result set
_fxv_reqoff = -1;    // offset of the window we last asked for
_fxv_wait   = 0;     // frames spent uncovered; re-asks if the answer is lost
_fxv_cseen  = -1;    // last CH_SEQ consumed
_fxv_cn     = 0;     // slots on the target track
_fxv_tlen   = 0;     // target track name length
_fxv_tnum   = 0;     // target's REAPER track number; 0 = no target
_fxv_tcol   = -1;    // target's track colour, packed rgb; -1 = none
// FX / INST filter. Session state, not serialized: a browsing mode, not a
// property of the project.
// ⚠️ INST STARTS OFF, and that is not the same call as before. It used to be ON
// because the registry held no instruments and both-on therefore showed exactly
// what the list always had. Now that instruments ARE in the registry, both-on
// would ADD hundreds of rows to a drum instrument's effect browser on first
// open -- so FX-only is what preserves the familiar view, and the button is
// there for the day you want them.
fxv_kf_fx   = 1;
fxv_kf_inst = 0;
// ⚠️ NOT initialised here — fxv_tnum_on is SERIALIZED (ser_ver 60) and an
// unconditional @init assignment would wipe the user's choice every time a
// sample-rate change re-runs @init. Its default lives in the read backfill.
_fxv_csel   = -1;    // focused chain slot; -1 = append instead of swap
_fxv_aseq   = 0;     // last action posted
_fxv_aslot  = -1;    // the registry slot _fxv_aseq counts in; -1 = re-seed from the band (PL H1)
_fxv_await  = 0;     // frames since; re-assert if the ack is lost
_fxv_qn     = 0;     // query length
_fxv_creln  = 0;     // CHAINS: length of the folder path being browsed
_fxv_chsel  = -1;    // CHAINS: the chain row selected, awaiting REPLACE
_fxv_chdeep = 0;     // CHAINS: frames left on the "path too long" notice (PL H2)
_fxv_qc     = 0;     // caret index
_fxv_qfoc   = 0;     // 1 = the box is taking keys
_fxv_qpost  = -1;    // frames since the query changed; -1 = settled
_fxv_paste  = 0;     // countdown on the 'no clipboard' notice
_fxv_sel    = -1;    // keyboard row selection; -1 = none yet
_fxv_selmv  = 0;     // 1 = the keys moved _fxv_sel: the next frame scrolls it into view (PL H9)
_fxv_bank   = -1;    // selected rail row; -1 = ALL
_fxv_bn     = 0;     // banks published
_fxv_bseen  = -1;    // last bank-table seq consumed
// ⚠️ A COUNTDOWN, not a latch. This was a one-shot: asked once, set to 1,
// never cleared. The bridge only publishes a chain for slots that have
// ASKED (last_req[slot]), and that table dies with the bridge -- so after
// any bridge restart the face never asked again and the chain froze at
// whatever it last saw. X and the arrows still WORKED; the display just
// never moved, which is indistinguishable from broken buttons.
// Re-asking twice a second is nothing and it heals itself.
_fxv_lcd_ask = 0;    // frames until the LCD tab re-registers with the bridge

// ── The category glyphs (37 marks, 0..36) ───────────────────────────────────
// One mark per bucket, in M.BUCKETS order (0..21; 21 = no-guess, the empty
// ring) -- the same order the bucket colours below use and the same the bridge
// sends indices from -- then 22..36, the extra shapes noted inline.
//
// ⭐ EACH ONE IS A TRANSFER CURVE, A SHAPE, OR A DEVICE -- never a letter.
// Letters at this size are unreadable and they would also be wrong: the rail is
// already showing the category's NAME beside the glyph, so a glyph that spells
// the name again says nothing the row did not already say. What earns the space
// is the thing a category DOES: what it makes the signal look like.
//
// ⚠️ THE BUDGET IS ~12 px. The spec is explicit that every one must survive at
// small size "with no text beside it", so they are built from 2-5 strokes and
// nothing has interior detail. Everything derives from s, so the same recipe
// draws in a 17 px rail seat and would draw at 40 px unchanged.
//
// ⚠️ Colour is the CALLER's -- gfx_set before calling. These only draw shape,
// so one glyph can be a rail icon, a row pip and a card mark without three
// copies deciding their own colour.
// ⚠️ MOVED UP 2026-08-29. These two were defined at ~742/807 but first CALLED
// at 521, and EEL2 resolves function names at PARSE time -- so the whole plugin
// stopped compiling. `eon_ell`, which cat_glyph needs, comes from
// rk_cat_glyphs.jsfx-inc at import 113, well above this file at 140.
function swing_fxview_cat_glyph(b, cx, cy, s) local(h) (
  h = s * 0.5;
  b ==  0 ? ( gfx_line(cx-s,cy+h,cx-h,cy,1); gfx_line(cx-h,cy,cx+s,cy-h*0.6,1); ) :                                  // comp: a knee -- rising, then held down
  b ==  1 ? ( gfx_line(cx-s,cy+h,cx-h,cy+h,1); gfx_line(cx-h,cy+h,cx,cy-s,1); gfx_line(cx,cy-s,cx+h,cy+h,1); gfx_line(cx+h,cy+h,cx+s,cy+h,1); ) :  // eq: a bell over the flat
  b ==  2 ? ( gfx_line(cx-s,cy+s,cx-h,cy+h*0.6,1); gfx_line(cx-h,cy+h*0.6,cx+h,cy-h*0.6,1); gfx_line(cx+h,cy-h*0.6,cx+s,cy-s,1); ) :  // sat: an S, flattening at both ends
  b ==  3 ? ( gfx_line(cx-s,cy-s,cx-s,cy+s,1); gfx_line(cx-h*0.6,cy-h,cx-h*0.6,cy+h,1); gfx_line(cx+h*0.3,cy-h*0.6,cx+h*0.3,cy+h*0.6,1); gfx_line(cx+s,cy-h*0.3,cx+s,cy+h*0.3,1); ) :  // verb: reflections dying away
  b ==  4 ? ( gfx_line(cx-s,cy-s,cx-s,cy+s,1); gfx_line(cx,cy-h,cx,cy+h,1); gfx_line(cx+s,cy-h*0.4,cx+s,cy+h*0.4,1); ) :  // delay: discrete repeats, evenly spaced
  b ==  5 ? ( gfx_line(cx-s,cy-h,cx+s,cy-h,1); gfx_line(cx-h,cy+s,cx-h,cy-h,1); gfx_line(cx+h,cy+s,cx+h,cy-h,1); ) :  // limit: a hard ceiling the signal stops at
  b ==  6 ? ( gfx_rect(cx-h*1.1,cy-s,s*1.1,s*2,0); gfx_line(cx-h*1.1,cy-h*0.6,cx+h*0.1,cy-h*0.6,1); gfx_line(cx-h*1.1,cy+h*0.6,cx+h*0.1,cy+h*0.6,1); ) :  // strip: a channel, in sections
  b ==  7 ? ( gfx_line(cx-h,cy+s,cx-h,cy-s,1); gfx_line(cx-s,cy-h,cx-h,cy-s,1); gfx_line(cx,cy-h,cx-h,cy-s,1); gfx_line(cx+h,cy-s,cx+h,cy+s,1); gfx_line(cx,cy+h,cx+h,cy+s,1); gfx_line(cx+s,cy+h,cx+h,cy+s,1); ) :  // pitch: up and down
  b ==  8 ? ( gfx_rect(cx-h*1.2,cy-s,s*1.2,s*2,0); gfx_circle(cx-h*0.35,cy,h*0.5,0,1); ) :                            // amp: a cabinet with a cone
  b ==  9 ? ( gfx_line(cx-s,cy,cx+s,cy,1); gfx_rect(cx-h*0.3,cy-h*0.7,h*0.6,s*0.7,1); ) :                             // util: a fader on its rail
  b == 10 ? ( gfx_line(cx-s,cy+s,cx-h*0.2,cy+s,1); gfx_line(cx-h*0.2,cy+s,cx-h*0.2,cy-s,1); gfx_line(cx-h*0.2,cy-s,cx+s,cy-s,1); ) :  // gate: shut, then open
  b == 11 ? ( gfx_line(cx-s,cy,cx-h,cy-h,1); gfx_line(cx-h,cy-h,cx,cy,1); gfx_line(cx,cy,cx+h,cy+h,1); gfx_line(cx+h,cy+h,cx+s,cy,1); ) :  // mod: an LFO
  b == 12 ? ( gfx_line(cx-s,cy-h,cx,cy-h,1); gfx_line(cx,cy-h,cx+s,cy+s,1); ) :                                       // filter: flat, then a slope
  b == 13 ? ( gfx_line(cx-s,cy+s,cx-s,cy-h*0.3,1); gfx_line(cx-h*0.4,cy+s,cx-h*0.4,cy-s,1); gfx_line(cx+h*0.4,cy+s,cx+h*0.4,cy,1); gfx_line(cx+s,cy+s,cx+s,cy-h,1); ) :  // meter: bars at different heights
  b == 14 ? ( gfx_line(cx-s,cy,cx-h*0.3,cy,1); gfx_line(cx-s,cy,cx-h*0.5,cy-h*0.5,1); gfx_line(cx-s,cy,cx-h*0.5,cy+h*0.5,1); gfx_line(cx+h*0.3,cy,cx+s,cy,1); gfx_line(cx+s,cy,cx+h*0.5,cy-h*0.5,1); gfx_line(cx+s,cy,cx+h*0.5,cy+h*0.5,1); ) :  // width: pushed apart
  b == 15 ? ( gfx_circle(cx,cy,s*0.85,0,1); gfx_circle(cx,cy,h*0.4,1,1); ) :                                          // tape: a reel and its hub
  b == 16 ? ( gfx_circle(cx,cy,s*0.85,0,1); gfx_line(cx,cy,cx,cy-h*0.9,1); gfx_line(cx,cy,cx+h*0.7,cy,1); ) :         // time: a clock
  b == 17 ? ( gfx_line(cx-s,cy+h,cx-h,cy+h,1); gfx_line(cx-h,cy+h,cx-h,cy-h,1); gfx_line(cx-h,cy-h,cx+h,cy-h,1); gfx_line(cx+h,cy-h,cx+h,cy+h,1); gfx_line(cx+h,cy+h,cx+s,cy+h,1); ) :  // clip: the top squared off
  b == 18 ? ( gfx_line(cx-s,cy,cx-h,cy+s,1); gfx_line(cx-h,cy+s,cx,cy,1); gfx_line(cx,cy,cx+h,cy-s,1); gfx_line(cx+h,cy-s,cx+s,cy,1); ) :  // bass: one long slow wave
  b == 19 ? ( gfx_line(cx-s,cy-h,cx-h*0.6,cy-h,1); gfx_line(cx-h*0.6,cy-h,cx,cy+s,1); gfx_line(cx,cy+s,cx+h*0.6,cy-h,1); gfx_line(cx+h*0.6,cy-h,cx+s,cy-h,1); ) :  // de-ess: one narrow notch
  b == 20 ? ( gfx_line(cx-s,cy-s,cx,cy,1); gfx_line(cx-s,cy+s,cx,cy,1); gfx_line(cx-s,cy,cx,cy,1); gfx_line(cx,cy,cx+s,cy,1); ) :  // summing: many into one
  // ── 22..27: shapes REAPER's own category set needs and ours has no word
  // for. Reached only through the bridge's RCAT_GLYPH map, which sends the
  // ones that DO match (Dynamics, EQ, Delay, Reverb, Gate, Analyzer, Pitch
  // Correction, Tools) to the equivalents above rather than redrawing them.
  b == 22 ? ( gfx_rect(cx-s,cy-h*1.1,s*2,s*1.5,0); gfx_line(cx-h*0.6,cy-h*1.1,cx-h*0.6,cy+h*0.4,1); gfx_line(cx,cy-h*1.1,cx,cy+h*0.4,1); gfx_line(cx+h*0.6,cy-h*1.1,cx+h*0.6,cy+h*0.4,1); ) :  // synth: a keyboard
  b == 23 ? ( gfx_rect(cx-s,cy-h,s*2,s,0); gfx_line(cx-h*0.9,cy-h*0.4,cx-h*0.9,cy+h*0.4,1); gfx_line(cx-h*0.2,cy-h*0.75,cx-h*0.2,cy+h*0.75,1); gfx_line(cx+h*0.5,cy-h*0.5,cx+h*0.5,cy+h*0.5,1); ) :  // sampler: a waveform held in a slot
  b == 24 ? ( gfx_rect(cx-s,cy-h*0.9,s*1.1,s*1.8,0); gfx_line(cx-h*0.2,cy,cx+s,cy,1); gfx_line(cx+s,cy,cx+h*0.4,cy-h*0.6,1); gfx_line(cx+s,cy,cx+h*0.4,cy+h*0.6,1); ) :  // external: signal leaving the box
  b == 25 ? ( gfx_circle(cx,cy,s*0.85,0,1); gfx_circle(cx-h*0.7,cy+h*0.2,1,1,1); gfx_circle(cx-h*0.4,cy-h*0.6,1,1,1); gfx_circle(cx+h*0.4,cy-h*0.6,1,1,1); gfx_circle(cx+h*0.7,cy+h*0.2,1,1,1); gfx_circle(cx,cy+h*0.5,1,1,1); ) :  // midi: the 5-pin DIN
  b == 26 ? ( gfx_circle(cx,cy,h*0.45,1,1); gfx_circle(cx-s*0.8,cy-h*0.8,1.2,0,1); gfx_circle(cx+s*0.8,cy-h*0.8,1.2,0,1); gfx_circle(cx-s*0.8,cy+h*0.9,1.2,0,1); gfx_circle(cx+s*0.8,cy+h*0.9,1.2,0,1); ) :  // surround: listener ringed by speakers
  b == 27 ? ( eon_ell(cx,cy+h*0.5,s*0.9,s*0.9,$pi,2*$pi); gfx_line(cx,cy+h*0.5,cx+h*0.5,cy-h*0.5,1); ) :               // tuner: a gauge and its needle
  // ── 28..30: the rail's STRUCTURAL rows. Not categories at all -- a folder
  // you made, everything, and what you reached for last -- so they are drawn
  // from the KIND rather than from a bucket, and in a neutral ink. They had no
  // mark at all, which made your own folders look like the unfinished rows.
  b == 28 ? ( gfx_line(cx-s,cy+h*0.9,cx-s,cy-h*0.5,1); gfx_line(cx-s,cy-h*0.5,cx-h*0.2,cy-h*0.5,1); gfx_line(cx-h*0.2,cy-h*0.5,cx+h*0.1,cy-h*0.95,1); gfx_line(cx+h*0.1,cy-h*0.95,cx+s,cy-h*0.95,1); gfx_line(cx+s,cy-h*0.95,cx+s,cy+h*0.9,1); gfx_line(cx-s,cy+h*0.9,cx+s,cy+h*0.9,1); ) :  // folder: a tab and a body
  b == 29 ? ( gfx_rect(cx-s,cy-s,s*0.85,s*0.85,0); gfx_rect(cx+h*0.15,cy-s,s*0.85,s*0.85,0); gfx_rect(cx-s,cy+h*0.15,s*0.85,s*0.85,0); gfx_rect(cx+h*0.15,cy+h*0.15,s*0.85,s*0.85,0); ) :  // all: everything, as a grid
  b == 30 ? ( eon_ell(cx,cy,s*0.82,s*0.82,0.9,2*$pi); gfx_line(cx,cy,cx,cy-h*0.8,1); gfx_line(cx,cy,cx+h*0.6,cy+h*0.2,1); gfx_line(cx-s*0.75,cy-h*0.5,cx-s*0.3,cy-h*0.75,1); gfx_line(cx-s*0.75,cy-h*0.5,cx-s*0.55,cy-h*0.05,1); ) :  // recent: a clock wound back
  // -- 31..32: the INSTRUMENT buckets that had no shape. Everything in
  // INSTRUMENT_BUCKETS was falling through to the empty ring, including synth,
  // sampler and midi, which have HAD marks since 22..25 -- the bridge simply
  // never looked them up, so finished art sat unreachable while the rail drew
  // rings. These two are the shapes that were genuinely missing.
  b == 31 ? ( eon_ell(cx,cy-h*0.5,s*0.95,h*0.5,0,2*$pi); gfx_line(cx-s*0.95,cy-h*0.5,cx-s*0.7,cy+s*0.75,1); gfx_line(cx+s*0.95,cy-h*0.5,cx+s*0.7,cy+s*0.75,1); gfx_line(cx-s*0.7,cy+s*0.75,cx+s*0.7,cy+s*0.75,1); ) :  // drums: a shell -- the head seen at an angle, sides tapering to the bottom hoop
  b == 32 ? ( gfx_rect(cx-s,cy-h*0.9,s*2,s*1.7,0); gfx_rect(cx-h*0.8,cy-h*0.9,2,s*0.95,1); gfx_rect(cx+h*0.1,cy-h*0.9,2,s*0.95,1); gfx_line(cx-h*0.3,cy+h*0.15,cx-h*0.3,cy+s*0.8,1); gfx_line(cx+h*0.7,cy+h*0.15,cx+h*0.7,cy+s*0.8,1); ) :  // keys: the BLACK keys, filled and standing proud -- at 12 px that, not the white ones, is what separates a piano from synth's plain key rail
  // -- 33..36: the last four INSTRUMENT buckets. The note above admitted
  // orchestral, world, sfx and other had "no shape yet" and let them keep the
  // ring -- but the ring is the mark for UNCLASSIFIED, so four perfectly well
  // named categories were wearing the badge for "we could not tell".
  b == 33 ? ( gfx_line(cx-h*0.8,cy-s,cx-h*0.8,cy+s,1); gfx_line(cx,cy-s,cx,cy+s,1); gfx_line(cx+h*0.8,cy-s,cx+h*0.8,cy+s,1); gfx_line(cx-s,cy+h*0.75,cx+s,cy-h*0.75,1); ) :  // orchestral: strings, and the bow drawn across them -- meter's bars are ragged and have no bow
  b == 34 ? ( gfx_circle(cx,cy,s*0.85,0,1); eon_ell(cx,cy,h*0.5,s*0.85,0,2*$pi); gfx_line(cx-s*0.85,cy,cx+s*0.85,cy,1); ) :  // world: a globe -- the sphere, one meridian, the equator
  b == 35 ? ( gfx_line(cx,cy-s,cx,cy+s,1); gfx_line(cx-s*0.87,cy-h,cx+s*0.87,cy+h,1); gfx_line(cx-s*0.87,cy+h,cx+s*0.87,cy-h,1); ) :  // sfx: a spark -- six rays off one point
  b == 36 ? ( gfx_circle(cx-s*0.7,cy,1.2,1,1); gfx_circle(cx,cy,1.2,1,1); gfx_circle(cx+s*0.7,cy,1.2,1,1); ) :  // other: three dots -- "and the rest", which is what the bucket means
            ( gfx_circle(cx,cy,s*0.8,0,1); );   // 21 no-guess: an empty ring -- nothing claimed
);

// A card for a plugin the deck has no recipe for: the varied blank face, then
// the CATEGORY MARK watermarked onto it.
// ⚠️ It has to live HERE and not in rk_swing_fxcard: that inc imports at 138,
// swing_fxview_cat_glyph is defined at 140, and EEL2 resolves function names at
// parse time. The card renderer draws the furniture; the view stamps the mark.
// ⭐ The 37 marks were already drawn for the rail. Putting them on the cards
// costs nothing and is the difference between "an unknown plugin" and "a delay
// we have not met".
function swing_fxview_blank_card(x, y, w, h, col, seed, bucket)
  local(cx2, cy2, sz)
(
  swing_fxcard_blank(x, y, w, h, col, seed);
  // Only worth stamping when there is room AND we actually classified it: 21 is
  // the no-guess bucket and its mark is an empty ring, which would say less
  // than the bare card already does.
  w >= 34 && h >= 20 && bucket >= 0 && bucket != 21 ? (
    sz  = min(w, h) * 0.26;
    cx2 = x + w - sz - max(3, w * 0.05);
    cy2 = y + h - sz - max(3, h * 0.07);
    gfx_set(0, 0, 0, 0.30);
    swing_fxview_cat_glyph(bucket, cx2 + 1, cy2 + 1, sz);
    gfx_set(1, 1, 1, 0.34);
    swing_fxview_cat_glyph(bucket, cx2, cy2, sz);
  );
);

// Returns the bumped pointer, matching every other *_init in the suite.
function swing_fxview_init(mem_start)
(
  _fxv_rows  = mem_start;
  _fxv_tgt   = mem_start + FXP_REC_MAX * FXP_REC + FXP_CHAIN_MAX * FXP_CREC;
  _fxv_q     = _fxv_tgt + 32;
  _fxv_banks = _fxv_q + FXP_Q_MAX + 1;
  // Folder path for CHAINS mode. One level plus a breadcrumb, so this only
  // ever holds a relative path, never a tree.
  _fxv_crel  = _fxv_banks + FXP_TB_MAX * FXP_TREC;
  // The rail filter text, and the VISIBLE-ROW MAP the rail is drawn from.
  // ⚠️ The map needs one cell per bank PLUS the three group headers and the
  // restore row -- +4, not +3, and getting that wrong overruns into _fxv_bq.
  _fxv_bq    = _fxv_crel + FXP_CHREL_MAX + 1;
  _fxv_vrow  = _fxv_bq + FXV_BQ_MAX + 1;
  _fxv_chain = mem_start + FXP_REC_MAX * FXP_REC;
  mem_start + FXP_REC_MAX * FXP_REC + FXP_CHAIN_MAX * FXP_CREC + 32
            + FXP_Q_MAX + 1 + FXP_TB_MAX * FXP_TREC + FXP_CHREL_MAX + 1
            + FXV_BQ_MAX + 1 + FXP_TB_MAX + 4;
);

// ── Layout ──────────────────────────────────────────────────────────────────
// Computed as fractions of the panel with pixel floors and caps, so the dock
// face (no left panel, different header height) and a stretched window both
// work. At 764 the caps bind, which is intended: a 168 px rail is wasted space.
function swing_fxview_layout()
  local(pad)
(
  // ── HiDPI: the six pitch constants are DESIGN pixels declared in @init,
  // where _ui_sc does not exist yet. Rescale them here, at the top of the
  // one function that runs per frame, so every reader downstream keeps
  // reading ONE name and cannot drift. At 1.00x this is the identity.
  FXV_ROW_H  = swing_px(FXV_ROW_H_B);
  FXV_CARD_W = swing_px(FXV_CARD_W_B);
  FXV_CARD_H = swing_px(FXV_CARD_H_B);   // 1.714:1 holds: both sides scale
  FXV_SLOT_H = swing_px(FXV_SLOT_H_B);
  FXV_RAIL_H = swing_px(FXV_RAIL_H_B);
  FXV_BQ_H   = swing_px(FXV_BQ_H_B);
  pad = swing_px(8);
  // Under the 28 px header AND the bank strip (step 4b), inset by pad on the other three sides.
  fxv_x = pad;
  fxv_y = 28 + swing_banktabs_h() + 6;
  fxv_w = gfx_w - pad * 2;
  fxv_h = gfx_h - fxv_y - pad;

  // ⚠️ THE CAP WAS THROWING SPACE AWAY -- the same bug the chain column had.
  // 0.22 of a 909 px panel is 199 and the 134 ceiling discarded 65 px of it,
  // while rail names were ALREADY clipping: after the glyph indent and the
  // count column a name got ~75 px, and "Pitch Correction" needs ~108. The
  // fraction decides now; the ceiling only catches the extremes.
  // ⭐ The FRACTION already scales; the CEILING did not, so above ~1.25x the
  // cap pinned the column again and names truncated -- exactly the bug the
  // comment above describes, re-entering through the back door on a big
  // surface. Both ends are design pixels and both scale.
  fxv_rail_w  = max(swing_px(110), min(swing_px(200), (fxv_w * 0.21) | 0));
  // ⚠️ THE CAP WAS DOING ALL THE WORK. 0.28 of a 900 px panel is 252, so the
  // 160 ceiling pinned it and the column stayed narrow no matter how much room
  // the window had -- while names truncated inside it. Raised so the fraction
  // decides on any real window and the ceiling only catches the extremes.
  // The list keeps the remainder and is still by far the widest column.
  fxv_chain_w = max(swing_px(150), min(swing_px(230), (fxv_w * 0.24) | 0));
  fxv_list_x  = fxv_x + pad + fxv_rail_w + pad;
  fxv_list_w  = fxv_w - pad * 4 - fxv_rail_w - fxv_chain_w;
  fxv_chain_x = fxv_x + fxv_w - pad - fxv_chain_w;

  // Vertical bands. Body is what is left after title, search, filters, footer.
  fxv_title_y  = fxv_y + swing_px(4);
  fxv_search_y = fxv_y + swing_px(28);
  fxv_filt_y   = fxv_y + swing_px(54);
  fxv_body_y   = fxv_y + swing_px(78);
  // ⚠️ The footer is TWO lines and both grew. At the old 24/16 the second line
  // started 7 px above the panel edge and ran past it -- which is what "the
  // bottom text is getting cut off" was. 34/30 fits both with a margin.
  // ⚠⚠ DERIVED FROM THE FOOTER, never from a second literal. The footer moves
  // up with scale; a fixed 34 px reserve did not, so at 1.75x the two lines of
  // instructions started ABOVE the last result row and printed over it.
  // Order matters: fxv_foot_y has to exist before this reads it.
  fxv_foot_y   = fxv_y + fxv_h - swing_px(30);
  fxv_body_h   = (fxv_foot_y - swing_px(4)) - fxv_body_y;
);

// ── Bucket colours ──────────────────────────────────────────────────────────
// Index matches M.BUCKETS in rk_lua_fx_recipes.lua, which the bridge sends as
// FXP_R_BUCKET. Same 22 values as the card sheet's pip vocabulary, so a row
// tag, a rail glyph and a card pip are never a different colour for the same
// category. Packed 0xRRGGBB, unpacked at draw.
function swing_fxview_bucket_hex(b)
(
  b ==  0 ? 0xdc5a50 : b ==  1 ? 0x6ec96e : b ==  2 ? 0xe08a2a :
  b ==  3 ? 0x9a6ad0 : b ==  4 ? 0x4a78d8 : b ==  5 ? 0xd0a848 :
  b ==  6 ? 0xb8bcc0 : b ==  7 ? 0xd84a9a : b ==  8 ? 0xc8703a :
  b ==  9 ? 0x3ac0d8 : b == 10 ? 0x3a9a7a : b == 11 ? 0x8a7ae0 :
  b == 12 ? 0xb0d84a : b == 13 ? 0x90a8b8 : b == 14 ? 0x50b8e0 :
  b == 15 ? 0xb09a6a : b == 16 ? 0xe05a78 : b == 17 ? 0xf05840 :
  b == 18 ? 0x5858c8 : b == 19 ? 0xe090b8 : b == 20 ? 0x7a3d8f :
  // -- 22..36: every glyph id that is NOT one of the first 21 buckets ------
  // These had no entry at all, so they fell through to the grey below and the
  // rail drew synth, sampler, drums, keys and sfx in the same dead slate as
  // "unclassified", sitting beside categories that were all in colour. Grey
  // read as unfinished, which is exactly what it was.
  //
  // ⭐ COLOUR HERE IS AN IDENTITY, NOT A METAPHOR. Thirty-four categories do
  // not map onto thirty-four "right" hues -- bass is already indigo and time
  // is already rose. These were chosen for SEPARATION: fitted against the
  // existing 22 in CIELAB so the closest pair in the whole set is ~17 apart,
  // which is what keeps two rows tellable apart at 12 px.
  b == 22 ? 0x3ad8a8 :   // synth       aqua
  b == 23 ? 0xd0e090 :   // sampler     pale chartreuse
  b == 24 ? 0xa0abe8 :   // external    periwinkle
  b == 25 ? 0x9a58e0 :   // midi        violet
  b == 26 ? 0x9ae8d0 :   // surround    pale mint
  b == 27 ? 0xe8b0a8 :   // tuner       pale salmon
  b == 31 ? 0xe8836e :   // drums       coral
  b == 32 ? 0xe8dca8 :   // keys        ivory
  b == 33 ? 0xd8c828 :   // orchestral  deep yellow
  b == 34 ? 0x4ac84a :   // world       green
  b == 35 ? 0x4a4ae0 :   // sfx         blue
  b == 36 ? 0xd050d8 :   // other       magenta
  // ⛔ 21 AND ANYTHING UNKNOWN STAY GREY. 21 is no-guess -- the plug-in was
  // never classified -- and 28..30 (folder / all / recent) are navigation
  // rather than categories and set their own neutral ink at the call site.
  // Colouring either would dress "we don't know" up as a claim.
            0x8a929a;
);

// Sets gfx from the same palette. Kept as a wrapper so the 22 values live in
// exactly one place -- they are the card pips, the row dots and the rail
// glyphs, and three copies would drift.
function swing_fxview_bucket_col(b)
  local(c)
(
  c = swing_fxview_bucket_hex(b);
  gfx_set(((c / 65536) | 0) / 255,
          (((c / 256) | 0) % 256) / 255,
          (c % 256) / 255, 1);
);

// Bucket NAME, in the same order as the colours above and as M.BUCKETS in
// rk_lua_fx_recipes.lua -- which is the authority the bridge sends indices
// from. ⚠️ Transcribed FROM that table, not from the rail (the rail is sorted
// by member count, so its order says nothing about the index).
function swing_fxview_bucket_name(b)
(
  b ==  0 ? "comp"  : b ==  1 ? "eq"     : b ==  2 ? "sat"    :
  b ==  3 ? "verb"  : b ==  4 ? "delay"  : b ==  5 ? "limit"  :
  b ==  6 ? "strip" : b ==  7 ? "pitch"  : b ==  8 ? "amp"    :
  b ==  9 ? "util"  : b == 10 ? "gate"   : b == 11 ? "mod"    :
  b == 12 ? "filter": b == 13 ? "meter"  : b == 14 ? "width"  :
  b == 15 ? "tape"  : b == 16 ? "time"   : b == 17 ? "clip"   :
  b == 18 ? "bass"  : b == 19 ? "de-ess" : b == 20 ? "summing":
  // The instrument buckets and REAPER's own shapes, at the same ids the
  // colours use. Without these a row under an instrument category drew a
  // coloured pip with a BLANK word beside it.
  b == 22 ? "synth"      : b == 23 ? "sampler" : b == 24 ? "external" :
  b == 25 ? "midi"       : b == 26 ? "surround": b == 27 ? "tuner"    :
  b == 31 ? "drums"      : b == 32 ? "keys"    : b == 33 ? "orchestral":
  b == 34 ? "world"      : b == 35 ? "sfx"     : b == 36 ? "other"    : "";
);

// 0 is what the bridge sends for anything without a plugin format -- REAPER's
// own Video processor, Container, ReWire. A "?" there says the picker does not
// know what they are; blank says there is nothing to say, which is the truth.
function swing_fxview_fmt_name(f)
(
  f == 1 ? "VST"  : f == 2 ? "VST3" : f == 3 ? "JS"  : f == 4 ? "CLAP" :
  f == 5 ? "AU"   : f == 6 ? "LV2"  : f == 7 ? "DX"  : "";
);

// ── Ask the bridge for a window of rows ─────────────────────────────────────
// PAYLOAD FIRST, SEQ LAST. The bridge is edge-triggered on FXP_REQ_SEQ, so the
// offset and count must already be in place when the seq announces them.
// REQ_SEQ is deliberately coalescing: if the user scrolls three times before
// the bridge ticks, answering only the last position is correct.
function swing_fxview_request(off, n)
  local(b)
(
  // C-5 (audit C 2026-09-14): with no registry slot the latch of -1 clamped to slot 0
  // and this posted into slot 0's band, so the picker bridge answered it as slot 0's
  // (and slot 0's FX tab showed the foreign page). Unslotted -- the registry full, or
  // the 50 ms re-claim settle -- nothing is posted; the page draws the notice instead.
  _reg_my_slot >= 0 ? (
    b = EON_FXPICK_BASE + max(0, min(EON_FXPICK_SLOTS - 1, _reg_my_slot)) * EON_FXPICK_STRIDE;
    gmem[b + FXP_REQ_OFF] = off;
    gmem[b + FXP_REQ_N]   = n;
    _fxv_req_seq += 1;
    gmem[b + FXP_REQ_SEQ] = _fxv_req_seq;    // LAST
    // PL H16: ANY ask replaces the one published page -- the FX tab's one-row
    // re-ask, the console's compact picker -- so the big view's "last asked"
    // no longer names what is there. Forgotten here, at the one door every ask
    // goes through; the big view's own asks set it again right after the call.
    // Without it a reopened picker sat on one row and ghosts for 45 frames.
    _fxv_reqoff = -1;
  );
);

// ── the search box ─────────────────────────────────────────────────────────
// True while the pointer is over the box. Exported because zeroing the mouse
// globals is NOT enough on its own -- the rows behind still compute hover from
// mx/my and would light up under the box (grid_pads does exactly this for the
// pad-name editor).
function swing_fxview_mouse_in_search()
(
  mx >= fxv_q_x && mx <= fxv_q_x + fxv_q_w &&
  my >= fxv_search_y && my <= fxv_search_y + 22;
);

function swing_fxview_q_ins(c)
  local(i)
(
  _fxv_qn < FXP_Q_MAX ? (
    i = _fxv_qn;
    while(i > _fxv_qc ? ( _fxv_q[i] = _fxv_q[i - 1]; i -= 1; 1; ) : 0);
    _fxv_q[_fxv_qc] = c;
    _fxv_qn += 1; _fxv_qc += 1; _fxv_qpost = 0;
  );
);

function swing_fxview_q_del(at)
  local(i)
(
  at >= 0 && at < _fxv_qn ? (
    i = at;
    while(i < _fxv_qn - 1 ? ( _fxv_q[i] = _fxv_q[i + 1]; i += 1; 1; ) : 0);
    _fxv_qn -= 1; _fxv_qpost = 0;
  );
);

function swing_fxview_q_clear()
(
  _fxv_qn = 0; _fxv_qc = 0; _fxv_qpost = 0;
);

// Push the query into the request half and re-ask from the top. A query change
// resets the scroll: the result set is a different list, so holding position
// in it would be meaningless.
function swing_fxview_q_send_do()
  local(b, i)
(
  b = EON_FXPICK_BASE + max(0, min(EON_FXPICK_SLOTS - 1, _reg_my_slot)) * EON_FXPICK_STRIDE;
  i = 0;
  loop(_fxv_qn, gmem[b + FXP_Q + i] = _fxv_q[i]; i += 1;);
  gmem[b + FXP_Q_LEN] = _fxv_qn;
  gmem[b + FXP_BANK]  = _fxv_bank;
  // Neither toggle on would mean "show nothing", which is not a state anyone
  // wants to be stuck in -- it reads as a broken list. Treat it as both.
  gmem[b + FXP_KINDF] = (fxv_kf_fx && fxv_kf_inst) ? 2 :
                        (fxv_kf_inst ? 1 : (fxv_kf_fx ? 0 : 2));
  // CHAINS rides the same request. The bridge fills the SAME rows band
  // from the FXChains folder instead of the registry, so everything
  // downstream -- paging, scrolling, the row renderer -- is unchanged.
  gmem[b + FXP_CHMODE] = _fxv_mode == 2 ? 1 : 0;
  gmem[b + FXP_CHREL_LEN] = _fxv_creln;
  i = 0;
  loop(_fxv_creln, gmem[b + FXP_CHREL + i] = _fxv_crel[i]; i += 1;);
  _fxv_scroll = 0;
  // PL H3/H6: the chosen chain is a ROW of the list this re-ask replaces. Kept,
  // REPLACE WHOLE CHAIN stayed armed on whatever the new list holds at that row
  // (a typed search, LIST then CHAINS) -- a chain nobody picked.
  _fxv_chsel = -1;
  // ⚠️ POST THE REQUEST HERE. The first version only reset the window state and
  // let the need-test in draw() notice -- but the snapshot runs later in the
  // same frame, re-reads the STALE published page and restores _fxv_n, so
  // `need` was false again by the next frame and no request was ever sent. The
  // query and the bank landed in gmem and nothing ever asked for a new page:
  // selecting a bank did visibly nothing.
  swing_fxview_request(0, min(FXP_REC_MAX, max(1, _fxv_want) * 2));
  _fxv_reqoff = 0;
);

// C-5: the query cells are slot 0's payload when this instance has no slot, so the push
// is dropped whole (a foreign query would ride slot 0's next request). The body above
// is unchanged under its _do name.
function swing_fxview_q_send() ( _reg_my_slot >= 0 ? swing_fxview_q_send_do(); );

// PL H1 (2026-10-26): our action count CONTINUES the band's. gmem outlives the
// instance and @init starts _fxv_aseq at 0, so a project reopened in the same
// REAPER met ACK = the old count and every action was refused for 60 frames --
// and an old count of exactly 1 made our first post (seq 1) equal the bridge's
// last_act, so it was dropped as already run. Re-seeded whenever the band we
// post into is not the one the count came from (@init, a new registry slot).
function swing_fxview_aseq_sync(b) (
  _fxv_aslot != _reg_my_slot ? (
    _fxv_aseq = gmem[b + FXP_ACT_SEQ] | 0;
    _fxv_aslot = _reg_my_slot;
  );
);

// Post one mutation. Refuses while an earlier action is unacknowledged --
// that is the whole point of the second mailbox. The 60-frame escape stops a
// lost ack from wedging the picker forever.
function swing_fxview_act(verb, a, bnum)
  local(b)
(
  b = EON_FXPICK_BASE + max(0, min(EON_FXPICK_SLOTS - 1, _reg_my_slot)) * EON_FXPICK_STRIDE;
  _reg_my_slot >= 0 ? swing_fxview_aseq_sync(b);
  // C-5: no slot, no action -- a verb posted into slot 0's band ran on slot 0's chain.
  _reg_my_slot >= 0 && (gmem[b + FXP_ACT_ACK] == _fxv_aseq || _fxv_await > 60) ? (
    gmem[b + FXP_ACT_VERB] = verb;
    gmem[b + FXP_ACT_A]    = a;
    gmem[b + FXP_ACT_B]    = bnum;
    _fxv_aseq += 1;
    gmem[b + FXP_ACT_SEQ]  = _fxv_aseq;      // PAYLOAD FIRST, SEQ LAST
    _fxv_await = 0;
    1;
  ) : 0;
);

// An ADD on a pad asks for Wired, the way the console's empty-slot click does
// (swing_panels_ins_aim). USER, 2026-09-14: "make the fx tab turn wired on too".
// In stereo a pad's inserts sit on Swing's own track pinned to the pad's pair,
// and only Wired makes them audible -- so an add with Wired off was silent.
// Pads only: the master's inserts are on the summed output and play either way.
// Call it only after swing_fxview_act returned 1 (the add was really posted).
// The consumer in Swing_ReaKit.jsfx sends the switch only while Wired is off
// and the kit is not multi-out, so asking on every add is safe.
function swing_fxview_want_wired() local(b, t) (
  b = EON_FXPICK_BASE + max(0, min(EON_FXPICK_SLOTS - 1, _reg_my_slot)) * EON_FXPICK_STRIDE;
  t = gmem[b + FXP_TGT_PAD];
  // Any SLOT 0..63 (step 5: a bank B-D pad's container is a Wired one too; the console aims slots since then).
  _reg_my_slot >= 0 && gmem[b + FXP_TGT_SEQ] > 0 && t >= 0 && t < NUM_SLOTS ? _ins_want_wired = 1;
);

// ── Snapshot the published page ─────────────────────────────────────────────
// Seqlock: read the seq, read the body, read the seq again. If it moved, or was
// odd, the bridge was mid-write and the body may be torn -- so drop it and try
// next frame rather than drawing half a page. Cheap: the face redraws at frame
// rate and the bridge publishes at defer rate, so a collision costs one frame.
function swing_fxview_snapshot()
  local(b, s1, s2, i, j, p, src, dst, n)
(
  b = EON_FXPICK_BASE + max(0, min(EON_FXPICK_SLOTS - 1, _reg_my_slot)) * EON_FXPICK_STRIDE;
  _fxv_hb = gmem[b + FXP_HB];
  s1 = gmem[b + FXP_PUB_SEQ];
  (s1 == _fxv_seen || (s1 % 2) == 1) ? (
    0;                                      // unchanged, or mid-write
  ) : (
    _fxv_total = gmem[b + FXP_TOTAL];
    _fxv_off   = gmem[b + FXP_WIN_OFF];
    n          = max(0, min(FXP_REC_MAX, gmem[b + FXP_WIN_N]));
    // ⚠️ CELL BY CELL — memcpy CANNOT cross from gmem into local memory.
    // They are separate address spaces; gmem is reachable only through gmem[].
    // memcpy(_fxv_rows, b + FXP_ROWS, ...) does not fail, because Swing's local
    // memory runs to ~72 MB and 26,345,664 is a perfectly valid local address —
    // it silently copied pad AUDIO into the row buffer. The symptom was names
    // drawn as box glyphs and rows starting two-thirds down the column, because
    // the first records held a length <= 0 and were skipped.
    // 1488 reads for a 31-row page, and only when the seq has actually moved.
    src = b + FXP_ROWS; dst = _fxv_rows;
    i = 0; loop(n * FXP_REC, dst[i] = gmem[src + i]; i += 1;);
    s2 = gmem[b + FXP_PUB_SEQ];
    s2 == s1 ? (
      // Resolve each row's card ONCE here, not per frame in the draw loop --
      // a miss scans all FXC_N_KEYS pairs, and FXC_N_KEYS x 31 rows x 60 fps
      // (~1.4M compares/sec at 758 keys) would buy a value that only changes
      // when the bridge publishes.
      j = 0;
      loop(n,
        p = _fxv_rows + j * FXP_REC;
        p[FXP_R_CARD] = p[FXP_R_LEN] > 0 ?
          swing_fxcard_lookup(
            swing_fxcard_hash(p + FXP_R_NAME, min(40, p[FXP_R_LEN]))) : -1;
        j += 1;
      );
      _fxv_seen = s1; _fxv_n = n; 1;
    ) : 0;                                              // torn -> discard
  );
);

// Navigate one folder deeper. The path is relative and one level at a time;
// the breadcrumb is what gets you back, not a stored tree.
function swing_fxview_crel_push(_rec) local(_p, _l, _i, _sep) (
  _p = _fxv_rows + _rec * FXP_REC;
  _l = min(40, _p[FXP_R_LEN] | 0);
  // PL H2: the '/' is added only below the root, and the path may FILL the 40
  // cells -- `creln + l + 1 < 40` refused a 39-character folder at the root.
  // A path that will not fit is SAID (the CHAINS bar), never a dead click.
  _l > 0 && _fxv_creln + (_fxv_creln > 0) + _l > FXP_CHREL_MAX ? _fxv_chdeep = 150;
  _l > 0 && _fxv_creln + (_fxv_creln > 0) + _l <= FXP_CHREL_MAX ? (
    // ⚠️ FORWARD slash, translated by the bridge into the platform's own.
    // This was a hardcoded BACKSLASH, which is a Windows-only path: the engine
    // joins with package.config's separator, so on Mac the folder would simply
    // never be found and a subfolder would look empty with no error.
    _fxv_creln > 0 ? ( _fxv_crel[_fxv_creln] = 47; _fxv_creln += 1; );  // '/'
    _i = 0;
    loop(_l, _fxv_crel[_fxv_creln] = _p[FXP_R_NAME + _i]; _fxv_creln += 1; _i += 1; );
    _fxv_chsel = -1;
    swing_fxview_q_send();
  );
);

// Back up one level. Truncating at the last separator IS the breadcrumb --
// there is no tree state to unwind because there was never a tree.
function swing_fxview_crel_pop() local(_i, _cut) (
  _cut = 0; _i = 0;
  loop(_fxv_creln, _fxv_crel[_i] == 47 ? _cut = _i; _i += 1; );
  _fxv_creln = _cut;
  _fxv_chsel = -1;
  swing_fxview_q_send();
);

// What a click on a result MEANS, in one place. LIST and GRID both call it,
// so a mode can never be handled in one renderer and forgotten in the other.
function swing_fxview_pick(_rec) local(_p) (
  _p = _fxv_rows + _rec * FXP_REC;
  _fxv_mode == 2 ? (
    // ⚠️ A single click NEVER applies a chain. Replacing a whole chain
    // destroys what is there, and a stray click on a list you were scrolling
    // must not be able to do that. The REPLACE button is a safety, not a
    // formality -- so a click on a chain only SELECTS it.
    (_p[FXP_R_KIND] | 0) == FXK_FOLDER ? swing_fxview_crel_push(_rec)
                                       : _fxv_chsel = _p[FXP_R_RIDX] | 0;
  ) : (
    // A SWAP replaces a plugin the pad already had, so like the console it
    // leaves Wired alone; an INSERT is an add.
    swing_fxview_act(_fxv_csel >= 0 ? FXA_SWAP : FXA_INSERT,
                     _fxv_csel, _p[FXP_R_RIDX] | 0) && _fxv_csel < 0 ?
      swing_fxview_want_wired();
  );
);

// One row: bucket dot, name, format tag.
// The CHAINS kinds' own art in a 40 x 23 box at (ax, ay): a chain file draws
// what is INSIDE it (up to four category pips and a count), a folder a folder
// mark, so a folder never reads as a chain you could apply. Shared by the row
// and the tile (PL H5: CHAINS draws as TILES -- `_fxv_mode ?` is true for 2 --
// so this art sat in the row renderer, unreachable, and every chain and folder
// was the same blank card).
function swing_fxview_kind_art(ax, ay, p) local(j, _fxv_stk, _fxv_stc) (
  (p[FXP_R_KIND] | 0) == FXK_CHAIN ? (
    _fxv_stk = p[FXP_R_CHSTK];
    gfx_set(0, 0, 0, 0.25); gfx_rect(ax, ay, 40, 23);
    j = 0;
    loop(4,
      // Unpacked by DIVISION, matching how the bridge multiplied it in.
      _fxv_stc = (_fxv_stk / (j == 0 ? 1 : j == 1 ? 32 :
                              j == 2 ? 1024 : 32768)) | 0;
      _fxv_stc = _fxv_stc - ((_fxv_stc / 32) | 0) * 32;
      _fxv_stc < 22 ? (
        swing_fxview_bucket_col(_fxv_stc);
        gfx_rect(ax + 3 + j * 9, ay + 5, 7, 13);
      );
      j += 1;
    );
    rk_font(1, swing_fs(10), 'b');
    gfx_set(0.70, 0.78, 0.84, 0.9);
    gfx_x = ax + 2; gfx_y = ay;
    gfx_drawnumber((_fxv_stk / 1048576) | 0, 0);
  ) : (
    gfx_set(0.62, 0.70, 0.78, 0.85);
    gfx_rect(ax + 4, ay + 6, 32, 12);
    gfx_rect(ax + 4, ay + 3, 14, 3);
    gfx_set(0.10, 0.14, 0.20, 1);
    gfx_rect(ax + 6, ay + 8, 28, 8);
  );
);

function swing_fxview_row(rx, ry, rw, rec, hot)
  local(p, len, i, j, tw, th, tx, cw)
(
  p = _fxv_rows + rec * FXP_REC;
  len = min(40, p[FXP_R_LEN] | 0);
  len > 0 ? (
    // ⚠️ HOT IS NOW LIGHTER THAN THE GROUND, NOT DARKER. This was a fixed
    // 0.10/0.14/0.20 -- lighter than the near-black panel it was written
    // against, and DARKER than the LCD face the panel wears now, so the
    // highlight would have inverted into a shadow. Derived from the ground so
    // it stays a highlight whatever the ground becomes.
    hot ? (
      gfx_set(lcd_bg_r + 0.10, lcd_bg_g + 0.10, lcd_bg_b + 0.10, 1);
      gfx_rect(rx, ry, rw, FXV_ROW_H);
      // ⚠️ A CLICK ALSO SELECTS. _fxv_sel was set by the KEYBOARD only, and
      // SWAP SLOT n / INSERT AFTER / the + seat all act on it -- so with a
      // mouse alone they had no subject and sat permanently disabled, which
      // is what "the + button doesn't work" was. rec is page-local; _fxv_sel
      // indexes the whole result set, hence the offset.
      lmb_down ? ( _fxv_sel = _fxv_off + rec; swing_fxview_pick(rec); );
    );
    // A drawn card where the deck has one, the category pip where it does not.
    // 24x14 keeps the deck's 1.714 aspect. This is the chip case the spec
    // always called for ("console chips = drawn not images") and the reason the
    // renderer is scale-free -- the SAME record draws here and at 288 px.
    // It also shows coverage at a glance: a pip means no art for that plugin.
    // CHAINS: a chain file has no card of its own -- it is a LIST. Draw what
    // is inside it instead: up to four category pips and a count. REPLACE
    // WHOLE CHAIN overwrites what you have, so choosing from filenames
    // alone was choosing blind.
    (p[FXP_R_KIND] | 0) == FXK_CHAIN || (p[FXP_R_KIND] | 0) == FXK_FOLDER ? (
      swing_fxview_kind_art(rx + 6, ry + 3, p);
    ) : p[FXP_R_CARD] >= 0 ? (
      swing_fxcard_draw(rx + 6, ry + 3, FXV_CARD_W, FXV_CARD_H, p[FXP_R_CARD]);
    ) : (
      swing_fxview_blank_card(rx + 6, ry + 3, FXV_CARD_W, FXV_CARD_H,
                              swing_fxview_bucket_hex(p[FXP_R_BUCKET] | 0),
                              p[FXP_R_RIDX], p[FXP_R_BUCKET] | 0);
    );

    // ⭐ ONE LINE, FLOWING LEFT TO RIGHT: name, then category, then vendor.
    // These used to be STACKED -- name above, category below -- which spent a
    // second line of height and still left a wide empty gap in the middle of
    // every row, because the format tag is pinned hard right. Running them
    // along one baseline uses the width that was already there and buys the
    // height back for a bigger card.
    // Everything after the name draws from wherever the pen was left, so the
    // three never drift into columns that misalign at different name lengths.
    // ⚠️ THE TAIL RESERVE FOLLOWS WHAT IS ACTUALLY DRAWN. It was a flat 130 px
    // held back for category + vendor + format tag -- so a long name stopped
    // early even with the vendor switched OFF and nothing there to protect.
    // With VEND off the reserve is the category and the tag alone.
    // PL H12: design pixels, like every other reserve here -- the fonts scale,
    // and an unscaled reserve let a 2x category run into the tag.
    _fxv_tail = swing_px(fxv_vend_on ? 130 : 74);
    // The format tag's seat, measured FIRST: the category and the vendor stop
    // short of it rather than of a guessed reserve.
    rk_font(1, swing_fs(13), 0);
    strcpy(#fxv_s, swing_fxview_fmt_name(p[FXP_R_FMT] | 0));
    gfx_measurestr(#fxv_s, tw, th);
    tx = rx + rw - swing_px(10) - tw;
    rk_font(1, swing_fs(17), 0);
    gfx_set(0.86, 0.90, 0.95, 1);
    gfx_x = rx + FXV_CARD_W + 14; gfx_y = ry + ((FXV_ROW_H - 17) / 2) | 0;
    i = 0;
    loop(len,
      gfx_x <= rx + rw - _fxv_tail ? gfx_drawchar(p[FXP_R_NAME + i] | 0);
      i += 1;
    );

    // Category, in the category's OWN colour -- the same vocabulary as the
    // rail pip and the card pip, so a row and its bank never disagree about
    // what a plugin is. Blank for 21 (no-guess): a label saying "we could not
    // tell" is worse than no label.
    strcpy(#fxv_s, swing_fxview_bucket_name(p[FXP_R_BUCKET] | 0));
    rk_font(1, swing_fs(13), 0);
    // ⚠️ SIT THEM ON THE NAME'S BASELINE, not its TOP. gfx_y is the top edge,
    // so 12 px text sharing the 16 px name's y rides visibly HIGH -- which is
    // what made the category look like a superscript instead of part of the
    // line. Push it down by the difference in cap height.
    gfx_y += 4;
    // PL H12: the WHOLE word must end before the tag, not merely start before a
    // reserve -- "   orchestral" started inside the 74 px and printed over VST3.
    strcat(strcpy(#fxv_s2, "   "), #fxv_s);
    gfx_measurestr(#fxv_s2, cw, i);
    strlen(#fxv_s) > 0 && gfx_x + cw <= tx - swing_px(6) ? (
      swing_fxview_bucket_col(p[FXP_R_BUCKET] | 0);
      gfx_a = 0.9;
      gfx_drawstr(#fxv_s2);
      gfx_a = 1;
    );
    // Vendor last: it answers "whose is this", which only matters once you
    // know what it is -- so it is the first thing a narrow panel drops.
    fxv_vend_on && (p[FXP_R_VLEN] | 0) > 0 && gfx_x <= rx + rw - swing_px(130) ? (
      gfx_set(0.55, 0.60, 0.68, 0.9);
      gfx_drawstr("  ·  ");
      j = 0;
      loop(min(FXP_VEND_MAX, p[FXP_R_VLEN] | 0),
        gfx_x <= tx - swing_px(14) ? gfx_drawchar(p[FXP_R_VEND + j] | 0);
        j += 1;
      );
    );

    rk_font(1, swing_fs(13), 0);
    gfx_set(0.46, 0.52, 0.60, 1);
    strcpy(#fxv_s, swing_fxview_fmt_name(p[FXP_R_FMT] | 0));
    gfx_x = tx; gfx_y = ry + ((FXV_ROW_H - th) / 2) | 0;
    gfx_drawstr(#fxv_s);
  );
);

