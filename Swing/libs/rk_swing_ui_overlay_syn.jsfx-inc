@init
// ═══════════════════════════════════════════════════════════════════════════
// rk_swing_ui_overlay_syn.jsfx-inc — shared synth-layer UI helpers
// (Spec_Swing_Synth_Layer §5): engine names / pills / colors, macro labels,
// engine defaults, autonaming, and the km_syn macro get/set pool — consumed
// by the SYNTH big view (rk_swing_ui_synthview). The overlay SYN pseudo-tab
// panel that lived here was retired 2026-08-12: grid_overlay clamps
// overlay_layer back below MAX_LAYERS, so the SYNTH view owns all synth
// editing. Edits still go through mark_dirty_pad (undo/automation).
// ═══════════════════════════════════════════════════════════════════════════

// engine FAMILY names (autoname + labels). Accepts a raw ps_engine value —
// family = value % 10 (Spec_Synthdrums_Parity §5.1).
function _syn_engine_name(_se_e)
global(#_syn_en)
(
  _se_e = (_se_e|0) % 10;
  _se_e == 0 ? strcpy(#_syn_en, "KICK") :
  _se_e == 1 ? strcpy(#_syn_en, "SNARE") :
  _se_e == 2 ? strcpy(#_syn_en, "CLAP") :
  _se_e == 3 ? strcpy(#_syn_en, "HAT") :
  _se_e == 4 ? strcpy(#_syn_en, "RIDE") :
  _se_e == 5 ? strcpy(#_syn_en, "TOM") :
  _se_e == 6 ? strcpy(#_syn_en, "RIM") :
  _se_e == 7 ? strcpy(#_syn_en, "COWBELL") :
               strcpy(#_syn_en, "SHAKER");
);

// compact names for the 9-wide pill row (COWBELL/SHAKER don't fit a pill)
function _syn_engine_pill(_sp_e)
global(#_syn_en)
(
  _sp_e = (_sp_e|0) % 10;
  _sp_e == 7 ? strcpy(#_syn_en, "CWBL") :
  _sp_e == 8 ? strcpy(#_syn_en, "SHKR") :
  _syn_engine_name(_sp_e);
);

// per-family accent colors (identity, not state — the grid SYN chip carries
// bright-on-dark variants of the same palette; keep the two in step).
// RIDE inherits the old CYM blue.
function _syn_engine_col(_ec_e, _ec_mul)
global(_syn_ecr, _syn_ecg, _syn_ecb)
(
  _ec_e = (_ec_e|0) % 10;
  _ec_e == 0 ? ( _syn_ecr = 0.80; _syn_ecg = 0.30; _syn_ecb = 0.20; ) :   // KICK
  _ec_e == 1 ? ( _syn_ecr = 0.85; _syn_ecg = 0.58; _syn_ecb = 0.15; ) :   // SNARE
  _ec_e == 2 ? ( _syn_ecr = 0.80; _syn_ecg = 0.38; _syn_ecb = 0.60; ) :   // CLAP
  _ec_e == 3 ? ( _syn_ecr = 0.16; _syn_ecg = 0.62; _syn_ecb = 0.66; ) :   // HAT
  _ec_e == 4 ? ( _syn_ecr = 0.42; _syn_ecg = 0.50; _syn_ecb = 0.85; ) :   // RIDE
  _ec_e == 5 ? ( _syn_ecr = 0.32; _syn_ecg = 0.65; _syn_ecb = 0.28; ) :   // TOM
  _ec_e == 6 ? ( _syn_ecr = 0.85; _syn_ecg = 0.45; _syn_ecb = 0.18; ) :   // RIM
  _ec_e == 7 ? ( _syn_ecr = 0.70; _syn_ecg = 0.66; _syn_ecb = 0.20; ) :   // COWBELL
               ( _syn_ecr = 0.58; _syn_ecg = 0.40; _syn_ecb = 0.78; );    // SHAKER
  _syn_ecr *= _ec_mul; _syn_ecg *= _ec_mul; _syn_ecb *= _ec_mul;
);

// macro captions per FAMILY — DD-101 parity semantics (Spec_Synthdrums_Parity
// §4.1: each macro is the normalized position of one of HIS sliders). Inert
// macros beyond rk_syn_dd_macro_count() are hidden by the panel; label "".
function _syn_macro_label(_sl_e, _sl_k)
global(#_syn_ml)
(
  _sl_e = (_sl_e|0) % 10;
  _sl_e == 0 ? (   // KICK: his tune / pitch decay / amp decay / pitch env / noise + shifter
    _sl_k == 0 ? strcpy(#_syn_ml, "TUNE") : _sl_k == 1 ? strcpy(#_syn_ml, "P.DEC") :
    _sl_k == 2 ? strcpy(#_syn_ml, "A.DEC") : _sl_k == 3 ? strcpy(#_syn_ml, "P.ENV") :
    _sl_k == 4 ? strcpy(#_syn_ml, "NOISE") : _sl_k == 5 ? strcpy(#_syn_ml, "SHIFT") :
    strcpy(#_syn_ml, "");
  ) :
  _sl_e == 1 ? (   // SNARE: tune / pitch decay / amp decay / pitch env / noise decay + shifter
    _sl_k == 0 ? strcpy(#_syn_ml, "TUNE") : _sl_k == 1 ? strcpy(#_syn_ml, "DECAY") :
    _sl_k == 2 ? strcpy(#_syn_ml, "A.DEC") : _sl_k == 3 ? strcpy(#_syn_ml, "P.ENV") :
    _sl_k == 4 ? strcpy(#_syn_ml, "N.DEC") : _sl_k == 5 ? strcpy(#_syn_ml, "SHIFT") :
    strcpy(#_syn_ml, "");
  ) :
  _sl_e == 2 ? (   // CLAP
    _sl_k == 0 ? strcpy(#_syn_ml, "ATTACK") : _sl_k == 1 ? strcpy(#_syn_ml, "DECAY") :
    strcpy(#_syn_ml, "");
  ) :
  _sl_e == 3 ? (   // HAT (mac4 = OPEN, same slot as pre-parity)
    _sl_k == 0 ? strcpy(#_syn_ml, "ATTACK") : _sl_k == 1 ? strcpy(#_syn_ml, "DECAY") :
    _sl_k == 2 ? strcpy(#_syn_ml, "TONE") : _sl_k == 3 ? strcpy(#_syn_ml, "BODY") :
    _sl_k == 4 ? strcpy(#_syn_ml, "OPEN") : strcpy(#_syn_ml, "");
  ) :
  _sl_e == 4 ? (   // RIDE (DUTY default = the measured 47.98%)
    _sl_k == 0 ? strcpy(#_syn_ml, "ATTACK") : _sl_k == 1 ? strcpy(#_syn_ml, "DECAY") :
    _sl_k == 2 ? strcpy(#_syn_ml, "TONE") : _sl_k == 3 ? strcpy(#_syn_ml, "DUTY") :
    strcpy(#_syn_ml, "");
  ) :
  _sl_e == 5 ? (   // TOM (WHICH = his hi/mid/low voicings)
    _sl_k == 0 ? strcpy(#_syn_ml, "TUNE") : _sl_k == 1 ? strcpy(#_syn_ml, "DECAY") :
    _sl_k == 2 ? strcpy(#_syn_ml, "WHICH") : strcpy(#_syn_ml, "");
  ) : (            // RIM / COWBELL / SHAKER
    _sl_k == 0 ? strcpy(#_syn_ml, "TUNE") : _sl_k == 1 ? strcpy(#_syn_ml, "DECAY") :
    strcpy(#_syn_ml, "");
  );
);

// engine-switch macro defaults — DD-101 parity: neutral == his slider
// defaults == the factory sound (Spec_Synthdrums_Parity §4.1). The table
// lives in the engine lib (rk_syn_dd_macro_default); this just applies it.
// _sd_e may carry a type (family + 10*type) — defaults are per-FAMILY.
function _syn_engine_defaults(_sd_p, _sd_e)
local(_sd_f)
global(ps_mac0, ps_mac1, ps_mac2, ps_mac3, ps_mac4, ps_mac5, ps_mac6, ps_mac7)
(
  _sd_f = (_sd_e|0) % 10;
  ps_mac0[_sd_p] = rk_syn_dd_macro_default(_sd_f, 0);
  ps_mac1[_sd_p] = rk_syn_dd_macro_default(_sd_f, 1);
  ps_mac2[_sd_p] = rk_syn_dd_macro_default(_sd_f, 2);
  ps_mac3[_sd_p] = rk_syn_dd_macro_default(_sd_f, 3);
  ps_mac4[_sd_p] = rk_syn_dd_macro_default(_sd_f, 4);
  ps_mac5[_sd_p] = rk_syn_dd_macro_default(_sd_f, 5);
  ps_mac6[_sd_p] = rk_syn_dd_macro_default(_sd_f, 6);
  ps_mac7[_sd_p] = rk_syn_dd_macro_default(_sd_f, 7);
);

// ── synth-only pad auto-naming (user request 2026-07-29) ───────────────────
// A sample-less pad with the synth enabled takes its ENGINE's name as the pad
// name — propagates through the normal cname plumbing (grid label, mixer
// strips, PADNAMES gmem → multi-out track names, DM lanes). Ownership guard:
// we only write when the cname is empty or is one of OUR six engine names, so
// a user-typed name is never clobbered; disabling/clearing removes only names
// we own.
function _syn_name_owned(_sn_p)
local(_sn_i, _sn_own)
global(#_syn_en)
(
  _sn_own = 0;
  _sn_i = 0;
  loop(9,
    _syn_engine_name(_sn_i);
    strcmp(get_cname_slot(_sn_p), #_syn_en) == 0 ? _sn_own = 1;
    _sn_i += 1;
  );
  // legacy grandfather: pads named by the pre-parity build ("CYM" engine 4)
  strcmp(get_cname_slot(_sn_p), "CYM") == 0 ? _sn_own = 1;
  _sn_own;
);

// is this published category one WE could have set? (the family glyphs:
// kick/snare/clap/closed-hat/open-hat/ride/tom/rimshot/cowbell/shaker — the
// cat-ownership guard, mirror of _syn_name_owned for names. 7 = Cymbal stays
// grandfathered: pre-parity builds published it for engine 4.)
function _syn_cat_owned(_co_c) (
  _co_c == 0 || _co_c == 1 || _co_c == 2 || _co_c == 3 || _co_c == 4 ||
  _co_c == 5 || _co_c == 7 || _co_c == 9 || _co_c == 12 || _co_c == 15 ||
  _co_c == 18;
);

function _syn_autoname(_sa_p)
local(_sa_c)
global(ps_enable, ps_engine, #_syn_en, #_syn_prev, col_dirty, _syn_name_sync,
       _syn_cat_pend)
(
  strcpy(#_syn_prev, get_cname_slot(_sa_p));
  ps_enable[_sa_p] > 0.5 && !pad_has_audio(_sa_p) ? (
    (strlen(get_cname_slot(_sa_p)) == 0 || _syn_name_owned(_sa_p)) ? (
      _syn_engine_name(ps_engine[_sa_p]|0);
      strcpy(get_cname_slot(_sa_p), #_syn_en);
    );
  ) : (
    // Strip only on SAMPLE-LESS pads. With audio present the name belongs to
    // the sample layer and must survive both enabling a synth under it and
    // disabling one — _syn_name_owned cannot tell "we wrote KICK" from "the
    // kit/user named it KICK" (drum pads legitimately wear engine names), so
    // stripping here wiped real sample-pad names (user repro 2026-08-10).
    !pad_has_audio(_sa_p) && _syn_name_owned(_sa_p) ? strcpy(get_cname_slot(_sa_p), "");
  );
  // Rename COMMIT parity with the CMD-51 handler: the cname alone stays
  // grid-local. col_dirty re-derives auto-color; the deferred flag fires ONE
  // CMD 52 (bridge note-name + multi-out track sync — consumed in the main
  // @gfx, see Swing_ReaKit) per batch. A direct sync_note_names() here would
  // let the ALL+/ALL− 16-pad loops fire once and gate out the other 15.
  strcmp(#_syn_prev, get_cname_slot(_sa_p)) != 0 ? (
    col_dirty = 1;
    _syn_name_sync = 1;
    // Icon parity: keep the PUBLISHED category (badge + PAD-tab chip +
    // StepSeq lane icons + DM — bridge-owned PADCAT band) in step with the
    // engine name. GIVE → queue the engine's glyph; STRIP → queue Auto
    // re-infer. Guards mirror the name guard: never clobber a user-picked
    // category (only uncategorised or one of OUR six), never a LOCKED pad.
    // Queued (not posted) — the main @gfx drains one per 4th frame; the
    // REQ mailbox is single-slot and 16 same-frame posts would lose 15.
    !swing_lcd_padcat_locked(_sa_p) ? (
      _sa_c = swing_lcd_padcat_eff(_sa_p);
      strlen(get_cname_slot(_sa_p)) > 0 ? (
        // == -1 (nothing published) not < 0: PADCAT_NONE is a USER pick, and the
        // guard's whole job is to never clobber one.
        (_sa_c == -1 || _syn_cat_owned(_sa_c)) ?
          _syn_cat_pend[_sa_p] = swing_grid_syn_cat(_sa_p);
      ) : (
        _syn_cat_owned(_sa_c) ? _syn_cat_pend[_sa_p] = -1;
      );
    );
  );
);

// read/write one macro by index (macros live as 8 separate per-pad arrays)
function _syn_mac_get(_sg_p, _sg_k)
global(ps_mac0, ps_mac1, ps_mac2, ps_mac3, ps_mac4, ps_mac5, ps_mac6, ps_mac7)
(
  _sg_k == 0 ? ps_mac0[_sg_p] : _sg_k == 1 ? ps_mac1[_sg_p] :
  _sg_k == 2 ? ps_mac2[_sg_p] : _sg_k == 3 ? ps_mac3[_sg_p] :
  _sg_k == 4 ? ps_mac4[_sg_p] : _sg_k == 5 ? ps_mac5[_sg_p] :
  _sg_k == 6 ? ps_mac6[_sg_p] : ps_mac7[_sg_p];
);

function _syn_mac_set(_ss_p, _ss_k, _ss_v)
global(ps_mac0, ps_mac1, ps_mac2, ps_mac3, ps_mac4, ps_mac5, ps_mac6, ps_mac7)
(
  _ss_k == 0 ? ps_mac0[_ss_p] = _ss_v : _ss_k == 1 ? ps_mac1[_ss_p] = _ss_v :
  _ss_k == 2 ? ps_mac2[_ss_p] = _ss_v : _ss_k == 3 ? ps_mac3[_ss_p] = _ss_v :
  _ss_k == 4 ? ps_mac4[_ss_p] = _ss_v : _ss_k == 5 ? ps_mac5[_ss_p] = _ss_v :
  _ss_k == 6 ? ps_mac6[_ss_p] = _ss_v : ps_mac7[_ss_p] = _ss_v;
);
