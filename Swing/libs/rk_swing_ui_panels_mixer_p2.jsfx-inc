// rk_swing_ui_panels_mixer_p2.jsfx-inc -- part 2 of rk_swing_ui_panels_mixer.jsfx-inc (3 parts), cut at a function boundary by
// .dev_tests/split_big_incs.py: REAPER's load time grows with the square of a file's size. Edit freely;
// keep each file under about 40 KB.

// ⚠️ @init IS LOAD-BEARING (.docs/wiki/02-file-structure.md).
@init

// Is ANY pad soloed? A pad that is not soloed while another is has gone
// silent without being muted, and a desk that does not show that is lying
// about fifteen channels at once.
function swing_panels_any_solo() local(_i, _r) (
  _r = 0; _i = 0;
  loop(NUM_SLOTS, p_solo[_i] ? _r = 1; _i += 1; );   // the instrument, not the bank (step 4a)
  _r;
);

// Desk finish for the console ground (con_bg). Sets gfx colour; no state.
// Kept as one function so the panel, its swatches, and anything later that
// needs to sit flush against the desk cannot drift apart.
// ⚠️ Defined ABOVE the mixer, not just above the sections panel: the mixer's
// own chrome reads the ink below, and EEL2 resolves top-down — a call to a
// function defined later is a compile error, not a forward reference. (That
// placement is exactly how the first light-grey build shipped an ink function
// that nothing could reach.)
function swing_panels_console_bg(_a) (
  con_bg == 1 ? gfx_set(0.149, 0.165, 0.188, _a) :   // graphite
  con_bg == 2 ? gfx_set(0.030, 0.032, 0.036, _a) :   // black
  con_bg == 3 ? gfx_set(0.200, 0.220, 0.250, _a) :   // slate
  con_bg == 4 ? gfx_set(0.130, 0.112, 0.096, _a) :   // walnut
  con_bg == 5 ? gfx_set(0.780, 0.790, 0.800, _a) :   // light grey
                gfx_set(0.045, 0.075, 0.100, _a);    // 0 = blue (the original)
);

// ⚠️ A LIGHT ground cannot keep dark-ground chrome. Every label, hairline
// and title in this panel was picked against a near-black desk; on light
// grey the pale ones vanish entirely. One flag, read wherever the console
// paints its OWN chrome -- the strips are self-coloured hardware and stay
// as they are, exactly as real hardware does on any desk.
function swing_panels_console_ink(_a) (
  con_bg == 5 ? gfx_set(0.12, 0.14, 0.17, _a) : gfx_set(0.60, 0.90, 0.95, _a);
);

// Row-label ink for the gutter. The four colours ARE the vocabulary — green
// pan, blue delay, purple reverb, red smash — and the hue has to survive every
// finish. But they were chosen against a near-black desk, and PAN's green and
// DLY's blue sit close to light grey's own luma, which is exactly where they
// went muddy.
// ⭐ DARKENED, NOT OUTLINED. Scaling toward black keeps the hue EXACTLY while
// buying real contrast; a 1 px outline at 11 px bold eats the letterforms and
// turns four crisp labels into four smudges. Full alpha on light too — 0.85
// over a pale ground throws away contrast that was just paid for.
function swing_panels_row_ink(_r, _g, _b) (
  _mix_ink ? gfx_set(_r * 0.52, _g * 0.52, _b * 0.52, 1)
           : gfx_set(_r, _g, _b, 0.85);
);

function swing_panels_draw_mixer() (
    // Guard: skip drawing if LCD content area isn't valid yet
    _lcd_cw > 20 && _lcd_ch > 20 ? (
    // CONSOLE mode: the same function renders both the compact LCD page and
    // the full-size overlay (swing_panels_draw_mixer_big re-points _lcd_c*
    // at the pad-grid rect). The big view gets real console hardware: four
    // rotary knobs (PAN / DLY / RVB / SMS) stacked per strip above a capped
    // fader, bigger fonts and a dB readout row. Knob radius is bounded by
    // the strip width so neighbours never touch (~11 px at the default
    // window — the pad mini-knob size). The compact LCD page keeps its flat
    // mini-sliders for the four rows (_mix_kr / _mix_db_h collapse to 0 there)
    // but gets the same capped fader, scaled down to its strip size.
    // ⚠⚠ THIS IS A MODE SWITCH, NOT A LAYOUT NUMBER -- get it wrong and the
    // compact LCD page silently becomes the CONSOLE, applying console-only
    // settings (sends vanish). _lcd_ch on the compact page is derived from
    // lcd_h, which now scales, so an unscaled 260 is crossed at ~2.17x by a
    // page that never grew in relative terms. A threshold compared against a
    // scaled quantity has to be scaled. Caught in review 2026-09-18.
    _mix_big = _lcd_ch > swing_px(260);
    // Dark ink this frame? Only when the CONSOLE view is what re-pointed us
    // here — the compact LCD page draws on the LCD's own dark ground no
    // matter what finish the desk wears, so con_bg must not reach it.
    _mix_ink = big_view_id == VIEW_CONSOLE && con_bg == 5;
    _mix_gut = _mix_big ? 30 : 10;   // left gutter: row labels (spelled out in the big view)
    // FOCUS STRIP: the selected channel drawn wide. This is the ONE per-strip
    // exception to the band rule, and it is allowed precisely because it
    // spends WIDTH. Height carries fader calibration -- two strips of
    // different height get faders of different throw, so the same mouse
    // travel is a different number of dB on each. Width costs only room, so
    // every strip keeps one zero and one throw.
    //
    // What wide BUYS: the pad name stops truncating, the Swing band's labels
    // have room, and the send knobs can carry a readout. What it cannot buy
    // is a section its neighbours have closed -- that would be height.
    // Column count, not a constant: the master strip is a 17th column when
    // it is on, and everything narrows to pay for it.
    _mix_g_mst = _mix_big && con_master;
    _mix_ncol = 16 + (_mix_g_mst ? 1 : 0);
    _mix_wtot = _lcd_cw - _mix_gut - 10;
    // sel_pad is a SLOT 0..63; the strips are TILES. min(15, slot) put the focus
    // on strip 16 for every pad of banks B-D (PL I2).
    _mix_fpad = (_mix_big && con_focus) ? swing_pad_tile(max(0, sel_pad | 0)) : -1;
    _mix_bwf  = _mix_fpad >= 0 ? ((_mix_wtot / _mix_ncol) * 22 / 10)|0 : 0;
    _mix_bw   = max(1, _mix_fpad >= 0
                    ? ((_mix_wtot - _mix_bwf) / (_mix_ncol - 1))|0
                    : (_mix_wtot / _mix_ncol));
    // A focus strip no wider than a normal one would be a lie; fall back.
    _mix_fpad >= 0 && _mix_bwf <= _mix_bw ? (
      _mix_fpad = -1; _mix_bwf = 0;
      _mix_bw = max(1, _mix_wtot / _mix_ncol); );
    // ⭐ THE CEILING IS THE BUG, not the floor: min(11) capped every knob at
    // 11 px however big the desk got, which is why the console CRUSHED at
    // 1.75x while the strips around it grew. A clamp in design pixels has
    // to be read in design pixels.
    _mix_kr = _mix_big ? max(swing_px(6), min(swing_px(11), ((_mix_bw - swing_px(4)) / 2)|0)) : 0;
    _mix_sl_h = _mix_big ? _mix_kr * 2 + swing_px(3) : swing_px(5);   // row height: knob diameter + pad / mini-slider height
    _mix_sl_gap = _mix_big ? swing_px(2) : swing_px(1);               // gap between rows

    // ── Section gates (con_*, ser_ver 58) ────────────────────────────────
    // The compact LCD page IGNORES them: these are settings for the DESK, and
    // the LCD page is not the desk. Everything downstream reads the _mix_g_*
    // gate, never con_* directly, so that exemption lives in exactly one place.
    _mix_g_pan   = !_mix_big || con_pan;
    _mix_g_sends = !_mix_big || con_sends;
    _mix_g_cut   = !_mix_big || con_cut;
    _mix_g_fader = !_mix_big || con_fader;
    _mix_g_meter = !_mix_big || con_meter;
    _mix_g_dbsc  = !_mix_big || con_dbsc;
    _mix_g_name  = !_mix_big || con_name;

    // Knob rows are PAN + three sends, and either group can be switched off,
    // so a row's y comes from how many rows precede it — not from a fixed
    // index. Drop PAN and the sends slide up into the space.
    _mix_nr_pan = _mix_g_pan   ? 1 : 0;
    _mix_nr_snd = _mix_g_sends ? 3 : 0;
    _mix_nrows  = _mix_nr_pan + _mix_nr_snd;
    // The divider only means something when there is a PAN above it and sends
    // below it; with either gone it is a line separating nothing.
    _mix_sep_h = (_mix_big && _mix_g_pan && _mix_g_sends) ? swing_px(7) : 0;
    _mix_top_h = _mix_nrows > 0
      ? (_mix_sl_h * _mix_nrows + _mix_sl_gap * (_mix_nrows - 1) + swing_px(2) + _mix_sep_h)
      : 0;
    // Everything above the fader well, so _mix_vol_y lands under the band too.
    // Set AFTER _mix_sw_h exists — see the band block a few lines down; this is
    // re-assigned there rather than reordered, because _mix_sep_h and the row
    // count have to be known first.
    _mix_ind_y = _lcd_cy + swing_px(13);  // top indicator area start

    // Swing's own chain band. Console only — the compact LCD page has no room
    // for it, and unlike the knob rows there is no smaller form that would
    // still say anything.
    _mix_g_sw   = _mix_big && con_sw;
    // ⭐⭐ FULL IS SEVEN KNOBS NOW, matching the pad FX page one for one:
    // HPF LPF RESO | RATE BITS DRIVE COMP. It used to be six read-only lamps,
    // which disagreed with the pad page in three ways at once -- RESO was
    // missing entirely, BIT was one lamp over two separate parameters (rate
    // and bits), and EQ was a lamp for something the pad page draws as a
    // CURVE, not a knob. The desk and the pad page are two views of one
    // channel and they must not disagree about what the channel has.
    //
    // ⚠️ EQ therefore leaves the knob grid and stays a LAMP in the band
    // header -- it is still the only place the desk can say the EQ is doing
    // something, and inventing a knob for a four-band curve would be a worse
    // lie than the lamp was.
    //
    // Two columns when a strip can seat two usable knobs, one when it cannot.
    // The band's height FOLLOWS that, so a narrow desk gets a tall thin band
    // rather than knobs too small to grab.
    _mix_sw_cols = _mix_bw >= swing_px(46) ? 2 : 1;
    _mix_sw_krr  = max(swing_px(5), min(swing_px(9), (((_mix_bw - swing_px(2)) / _mix_sw_cols - swing_px(6)) / 2) | 0));
    _mix_sw_nrow = _mix_sw_cols == 2 ? 4 : 7;
    _mix_sw_cellh = _mix_sw_krr * 2 + swing_px(11);   // knob + its cap
    _mix_sw_h   = _mix_g_sw ? (con_sw_full ? (swing_px(13) + _mix_sw_nrow * _mix_sw_cellh + swing_px(3)) : swing_px(16)) : 0;
    _mix_sw_gap = _mix_sw_h > 0 ? swing_px(5) : 0;

    // ── INSERTS band ────────────────────────────────────────────────────
    // Below Swing's own chain band: the pad leaves through its insert slots
    // AFTER its fixed chain (see the BAND ORDER note below).
    //
    // FIT is worked out from what the other sections have already taken,
    // which is why it is computed HERE and not with the rest of the gates —
    // it needs _mix_sw_h and the row height to exist first. 130 is the
    // fader's floor: a console whose slots ate the fader is not a console.
    // Snapshot ONCE per frame, before any strip draws — sixteen strips
    // reading the seqlock independently could each land on a different
    // version of the same publish.
    _mix_big && con_ins ? swing_panels_conins_read();
    _mix_g_ins  = _mix_big && con_ins;
    // Slot height follows the CARD's own 1.714:1 aspect off the strip width,
    // instead of a flat 14. At a 44 px strip that is ~26 px: the art gets a
    // card-shaped hole to sit in rather than a letterbox. Capped so a very
    // wide window does not turn eight slots into the whole strip, and FIT
    // (computed just below) absorbs the rest.
    // Cut row: real S and M buttons, not just the red mute stripe that was
    // there before. ⚠️ Set HERE, above the insert sizing, because that
    // sizing SUBTRACTS it -- computed after, it would have been reading
    // last frame's value and the band would settle a frame behind every
    // time you toggled cut/solo.
    _mix_cut_h = (_mix_big && _mix_g_cut) ? 17 : 0;

    // Name PILL row: the pad's name at the TOP of the strip, click to rename.
    // Rides the NAME toggle — with names off, no names anywhere. Big view
    // only; the compact page's strip has no row to give.
    _mix_pill_h   = (_mix_big && _mix_g_name) ? swing_px(15) : 0;
    _mix_pill_gap = _mix_pill_h > 0 ? 3 : 0;

    // ⭐ THE BAND GROWS WITH WHAT IS IN IT, AND THE CARDS GROW WITH THE ROOM.
    // The first version fixed the slot height and the slot COUNT, so collapsing
    // Swing FX only ever bought you MORE slots -- never bigger cards. That was
    // backwards: the point of being able to fold a section is to give the
    // remaining ones room, and a card is the thing that wants room.
    //
    // So: how many slots is driven by what is actually THERE (the fullest
    // channel, plus one empty slot to drop into), and the height left over is
    // divided between them. Two plugins on a tall window means two big cards,
    // not two small ones and six empty boxes.
    _mix_ins_rows_h = _mix_nrows > 0
      ? (_mix_sl_h * _mix_nrows + _mix_sl_gap * (_mix_nrows - 1) + swing_px(2) + _mix_sep_h)
      : 0;
    // What the band may spend: everything the other sections do not want, less
    // the fader's floor. A console whose slots ate the fader is not a console.
    // ⭐ THE WELL IS SHARED FURNITURE: the fader rides IN it and the meter
    // is drawn INSIDE it, so it survives while EITHER is on -- switching the
    // fader off must not take the meter's ground away. With BOTH off nothing
    // lives there, and a decorative well would be the largest block on the
    // strip; it collapses and the 130 px floor it reserved goes to the cards,
    // which is the same rule folding any other section follows.
    _mix_well_on = _mix_g_fader || _mix_g_meter;
    _mix_ins_avail = max(swing_px(20), _lcd_ch - swing_px(18) - _mix_sw_h - _mix_sw_gap
                             - _mix_ins_rows_h - _mix_cut_h
                             - _mix_pill_h - _mix_pill_gap
                             - ((_mix_big && _mix_g_fader) ? swing_px(13) : 0)
                             - (_mix_well_on ? swing_px(130) : 0));
    // ⚠️ Design pixels, like _mix_db_h and the row pitch below: unscaled, the dB row
    // and the fader floor shrank against a scaled window and a 2x desk got a SHORTER
    // fader than 1x (PL I9). 1x is unchanged.
    // +1 for the empty slot you drop the next plugin into (FIT).
    // The master's record (16) counts only while its strip is on screen: a hidden
    // MASTER's busy folder sized every pad strip's rows (PL I10).
    _mix_ins_want = min(CI_NSLOT, max(1, (_mix_g_mst ? _conins_maxn : _conins_padmax) + 1));
    // ⭐⭐ SLOTS MEANS SLOTS. It used to be a CEILING taken against "the
    // fullest channel plus one", so picking 8 showed 8 only if some channel
    // already held seven plugins -- the number on the button was almost never
    // the number of rows you got, and that reads as broken rather than as
    // clever. Now: a number means SHOW THAT MANY, and FIT (0) is where the
    // adaptive "as many as the chain needs" behaviour lives. Both are
    // available and the user picks; neither is imposed.
    _mix_ins_tot  = con_slots == 0 ? _mix_ins_want
                                   : min(CI_NSLOT, max(1, con_slots | 0));
    // ⭐ THE VIEWPORT. A card has a floor height (its own 1.714:1 aspect off
    // the strip width); how many of those the budget holds is how many rows
    // the band can honestly draw. Beyond that the band SCROLLS instead of
    // squashing -- shrinking cards below the floor is how a deck of eight
    // becomes eight letterboxes.
    _mix_ins_shf = _mix_big ? max(swing_px(16), (_mix_bw / 1.714) | 0) : swing_px(14);
    _mix_ins_vis = max(1, (_mix_ins_avail / (_mix_ins_shf + swing_px(2))) | 0);
    _mix_ins_n   = min(_mix_ins_tot, _mix_ins_vis);
    // ⚠️ ONE offset for all sixteen strips -- never per strip. Per-strip
    // scroll gives per-strip heights, and equal height is what makes every
    // fader share one zero and one throw. Clamped here, where the totals are
    // known, so nothing downstream can read a stale window.
    con_ins_scroll = max(0, min(max(0, _mix_ins_tot - _mix_ins_n),
                                con_ins_scroll | 0));
    // Card aspect is the FLOOR, the strip width is the ceiling: a lone card can
    // grow to square but not beyond, or one plugin would swallow the strip.
    _mix_ins_sh = _mix_big
      ? max(_mix_ins_shf,
            min(_mix_bw, ((_mix_ins_avail / _mix_ins_n) | 0) - swing_px(2)))
      : swing_px(14);
    _mix_ins_h  = _mix_g_ins
      ? (con_ins_full ? (_mix_ins_n * (_mix_ins_sh + swing_px(2)) - swing_px(2)) : swing_px(16)) : 0;
    _mix_pill_y  = _mix_ind_y;
    // ⭐ BAND ORDER IS SIGNAL ORDER (2026-09-09). Swing's own FX band sits ABOVE
    // the inserts because that is the path: the pad runs through its HPF/LPF/EQ/
    // drive/bitcrush/comp FIRST, and only then leaves on its channel pair through
    // whatever you pinned in the insert slots (Swing_ReaKit.jsfx: both wired tap
    // points send _pfx*, post-FX). Until today the strip stacked INS above FX and
    // read as the exact opposite. The one case this still simplifies is the BUS
    // tap, where the pad leaves post-pan so the honest order would be FX, PAN,
    // INS -- said in words in the band's message line rather than by rearranging
    // the strip under the user.
    _mix_ins_gap = _mix_ins_h > 0 ? swing_px(5) : 0;

    _mix_sw_y    = _mix_ind_y + _mix_pill_h + _mix_pill_gap;
    _mix_ins_y   = _mix_sw_y + _mix_sw_h + _mix_sw_gap;

    // The knob rows start BELOW both bands: on a desk the channel's own
    // EQ/dynamics sits above the aux sends, not beside them.
    _mix_rows_y = _mix_ins_y + _mix_ins_h + _mix_ins_gap;
    _mix_y_pan = _mix_rows_y;
    _mix_y_dly = _mix_rows_y + _mix_nr_pan * (_mix_sl_h + _mix_sl_gap) + _mix_sep_h;
    _mix_y_rvb = _mix_y_dly + (_mix_sl_h + _mix_sl_gap);
    _mix_y_sms = _mix_y_rvb + (_mix_sl_h + _mix_sl_gap);
    // Now that both bands' heights are known, fold them into the stack the
    // fader well measures itself against.
    _mix_top_h = _mix_top_h + _mix_sw_h + _mix_sw_gap
                            + _mix_ins_h + _mix_ins_gap
                            + _mix_pill_h + _mix_pill_gap;

    // The dB readout is the FADER's number, so it goes when the fader goes.
    _mix_db_h = (_mix_big && _mix_g_fader) ? swing_px(13) : 0;
    // ⚠⚠ THE STACK ABOVE STARTS AT _lcd_cy + swing_px(13). These once sat one
    // pixel above it and have to KEEP that relationship, not a literal 12 --
    // unscaled, Solo/Mute and the fader climbed into the send knobs as the
    // surface grew (overlap from ~1.27x, 6 px into the knobs at 1.75x).
    // Caught in review 2026-09-18.
    _mix_cut_y = _lcd_cy + swing_px(12) + _mix_top_h;
    _mix_vol_y = _lcd_cy + swing_px(12) + _mix_top_h + _mix_cut_h + _mix_db_h;
    // 0 when nothing lives in the well — every draw below is sized from this,
    // so the well, its fill and its scale all vanish from one number.
    _mix_vol_h = _mix_well_on
      ? max(swing_px(10), _lcd_ch - swing_px(18) - _mix_top_h - _mix_cut_h - _mix_db_h) : 0;
    // Fader travel: the cap CENTRE runs _mix_fy .. _mix_fy + _mix_fh, inset by
    // half a cap so the cap never overhangs the well. Fill, meter, unity tick,
    // click and drag all share this one map. Both pages get the capped fader;
    // the compact LCD page scales it down (smaller cap, 3 px slot, shorter
    // ticks and only every other one).
    _mix_cap_h = _mix_big ? max(16, min(28, (_mix_vol_h / 16)|0)) : max(10, min(14, (_mix_vol_h / 4)|0));
    _mix_slot_w = _mix_big ? 4 : 3;
    _mix_tl = _mix_big ? 4 : 2;       // scale tick length (unity tick is _mix_tl + 2)
    _mix_fy = _mix_vol_y + ((_mix_cap_h / 2)|0);
    _mix_fh = max(1, _mix_vol_h - _mix_cap_h);
    // Console knobs follow the pad PAN knob style (theme knob when unset) so
    // pan looks the same here as on the pad grid.
    _mix_kstyle = pad_pan_style > 0 ? pad_pan_style : sk_kp;
    _mix_lbl_dy = _mix_big ? (((_mix_sl_h - 10) / 2)|0) : -1;  // row labels: centred on the knob row / old letter offset

    // Expand button (compact LCD page only): opens the full-size console
    // overlay over the pad grid. Drawn as an outlined box with a filled
    // top-right corner — no font-glyph dependency.
    big_view_id != VIEW_CONSOLE ? (
      // Shared art — swing_lcd_expand_btn. The FX page uses the same mark in
      // the same corner, so the two cannot drift into different gestures.
      _mix_exb_x = _lcd_cx + _lcd_cw - swing_px(13); _mix_exb_y = _lcd_cy + 1;
      _mix_exb_hov = swing_lcd_expand_btn(_mix_exb_x, _mix_exb_y);
      _mix_exb_hov ? swing_tooltip_check(1050, "Open the full-size console view over the pad grid.");
      _mix_exb_hov && lmb_down && active_id == -1 ? (
        swing_bigview_open(VIEW_CONSOLE);  // sets id + zeros stale _ov_* gate saves
        _mix_dbl_id = -1;
      );
    );

    // Row labels. Compact page: single letters in the 10 px gutter. Big view:
    // the gutter widens and the rows are spelled out with the pad FX overlay's
    // own names (PAN / DLY / RVB / SMSH), right-aligned against the knob column
    // — "S" on its own read as saturation. Any overflow goes left into the
    // panel padding, never into strip 1.
    _mix_big ? (
      rk_font(1, swing_fs(11), 'b');
      _mix_lbl_x = _lcd_cx + _mix_gut - 4;   // right edge of the labels
      // ⚠️ A label for a row that is not DRAWN is a label for nothing — but a
      // FOLDED row is still drawn, and it was losing its name. INS and FX were
      // gated on their FULL flags, so switching either band to BAR left a
      // labelled gutter with an unlabelled 16 px bar sitting in it.
      _mix_g_ins ? (
        _conins_stale ? (_mix_ink ? gfx_set(0.55, 0.40, 0.08, 0.95)
                                  : gfx_set(0.72, 0.55, 0.18, 0.9))
                      : (_mix_ink ? swing_panels_console_ink(0.75)
                                  : gfx_set(0.55, 0.66, 0.72, 0.85));
        gfx_measurestr("INS", tw, th);
        gfx_x = _mix_lbl_x - tw; gfx_y = _mix_ins_y + 3;  gfx_drawstr("INS");
      );
      _mix_g_sw ? (
        _mix_ink ? swing_panels_console_ink(0.75) : gfx_set(0.50, 0.60, 0.66, 0.85);
        gfx_measurestr("FX", tw, th);
        gfx_x = _mix_lbl_x - tw; gfx_y = _mix_sw_y + 2;  gfx_drawstr("FX");
      );
      _mix_g_pan ? (
        swing_panels_row_ink(0.30, 0.85, 0.45);
        gfx_measurestr("PAN", tw, th);
        gfx_x = _mix_lbl_x - tw; gfx_y = _mix_y_pan + _mix_lbl_dy;  gfx_drawstr("PAN");
      );
      _mix_g_sends ? (
        swing_panels_row_ink(0.35, 0.65, 0.90);
        gfx_measurestr("DLY", tw, th);
        gfx_x = _mix_lbl_x - tw; gfx_y = _mix_y_dly + _mix_lbl_dy;  gfx_drawstr("DLY");
        swing_panels_row_ink(0.55, 0.35, 0.85);
        gfx_measurestr("RVB", tw, th);
        gfx_x = _mix_lbl_x - tw; gfx_y = _mix_y_rvb + _mix_lbl_dy;  gfx_drawstr("RVB");
        swing_panels_row_ink(0.90, 0.38, 0.32);
        gfx_measurestr("SMSH", tw, th);
        gfx_x = _mix_lbl_x - tw; gfx_y = _mix_y_sms + _mix_lbl_dy;  gfx_drawstr("SMSH");
      );
    ) : (
      rk_font(1, swing_fs(10), 0);
      gfx_set(0.30, 0.85, 0.45, 0.7);
      gfx_x = _lcd_cx + 1; gfx_y = _mix_y_pan + _mix_lbl_dy;  gfx_drawstr("P");
      gfx_set(0.35, 0.65, 0.90, 0.7);
      gfx_x = _lcd_cx + 1; gfx_y = _mix_y_dly + _mix_lbl_dy;  gfx_drawstr("D");
      gfx_set(0.55, 0.35, 0.85, 0.7);
      gfx_x = _lcd_cx + 1; gfx_y = _mix_y_rvb + _mix_lbl_dy;  gfx_drawstr("R");
      gfx_set(0.90, 0.38, 0.32, 0.7);
      gfx_x = _lcd_cx + 1; gfx_y = _mix_y_sms + _mix_lbl_dy;  gfx_drawstr("S");
    );

    // Divider under PAN (big view): an etched line across labels + strips,
    // centred in the extra _mix_sep_h gap, so the sends read as a group.
    // _mix_sep_h is 0 unless BOTH pan and sends are drawn, so this gate also
    // covers "one of them is switched off" without naming either.
    _mix_big && _mix_sep_h > 0 ? (
      _mix_sep_y = _mix_y_dly - _mix_sep_h + ((_mix_sep_h / 2)|0);
      gfx_set(0, 0, 0, 0.5);
      gfx_rect(_lcd_cx, _mix_sep_y, _mix_gut + _mix_bw * 16 - 2, 1);
      gfx_set(1, 1, 1, 0.14);
      gfx_rect(_lcd_cx, _mix_sep_y + 1, _mix_gut + _mix_bw * 16 - 2, 1);
    );

    // ── Drag continuations for all 4 types ──
    // _mix_drag_pad is the strip's TILE (it places the drag in the strip); the engine writes map it through
    // swing_bp -- a bank B fader drag moved bank A's pad until step 4d.
    // VOL drag (vertical, fader-law taper). _mix_drag_off = cap-grab offset
    // set on the press (big view only) so a grabbed cap follows the pointer
    // without jumping; 0 when the press landed in the open well.
    active_id == 290 ? ( LMB ? (
      _mix_nv = swing_panels_mix_p2g(max(0, min(1.0, 1.0 - (my - _mix_drag_off - _mix_fy) / _mix_fh)));
      p_gain[swing_bp(_mix_drag_pad)] = _mix_nv;
      s_dirty[swing_bp(_mix_drag_pad)] = 1;
      mark_dirty_pad(swing_bp(_mix_drag_pad));
    ) : active_id = -1; );

    // PAN drag (horizontal)
    active_id == 291 ? ( LMB ? (
      _mix_dx = _lcd_cx + _mix_gut + _mix_drag_pad * _mix_bw;
      _mix_dbw = _mix_bw - 2;
      p_pan[swing_bp(_mix_drag_pad)] = max(-1.0, min(1.0, ((mx - _mix_dx) / _mix_dbw) * 2.0 - 1.0));
      p_panL[swing_bp(_mix_drag_pad)] = 1.0 - max(0.0, p_pan[swing_bp(_mix_drag_pad)]);
      p_panR[swing_bp(_mix_drag_pad)] = 1.0 + min(0.0, p_pan[swing_bp(_mix_drag_pad)]);
      mark_dirty_pad(swing_bp(_mix_drag_pad));
    ) : active_id = -1; );

    // DLY send drag (horizontal)
    active_id == 292 ? ( LMB ? (
      _mix_dx = _lcd_cx + _mix_gut + _mix_drag_pad * _mix_bw;
      _mix_dbw = _mix_bw - 2;
      fx_snd_dly[swing_bp(_mix_drag_pad)] = max(0, min(1.0, (mx - _mix_dx) / _mix_dbw));
      mark_dirty_pad(swing_bp(_mix_drag_pad));
    ) : active_id = -1; );

    // RVB send drag (horizontal)
    active_id == 293 ? ( LMB ? (
      _mix_dx = _lcd_cx + _mix_gut + _mix_drag_pad * _mix_bw;
      _mix_dbw = _mix_bw - 2;
      fx_snd_rvb[swing_bp(_mix_drag_pad)] = max(0, min(1.0, (mx - _mix_dx) / _mix_dbw));
      mark_dirty_pad(swing_bp(_mix_drag_pad));
    ) : active_id = -1; );

    // SMS send drag (horizontal)
    active_id == 294 ? ( LMB ? (
      _mix_dx = _lcd_cx + _mix_gut + _mix_drag_pad * _mix_bw;
      _mix_dbw = _mix_bw - 2;
      fx_snd_smash[swing_bp(_mix_drag_pad)] = max(0, min(1.0, (mx - _mix_dx) / _mix_dbw));
      mark_dirty_pad(swing_bp(_mix_drag_pad));
    ) : active_id = -1; );

    // INSERT slot: latched on the press, decided on the release. Travel past
    // 4 px makes it a REORDER drag (FXA_MOVE — the bridge's best-evidenced
    // verb); release without travel is the float click. One gesture, two
    // meanings, and the menu stays on the right button.
    // ⚠️ _insd_live, and the mouse-up EDGE. active_id cannot carry this: the
    // frame globals run `!LMB && active_id >= 0 ? active_id = -1;` near the top
    // of @gfx while this page draws near the bottom, so on the release frame
    // the id was already gone and neither the float nor the reorder ever fired.
    // prev_LMB still holds last frame's state here (written at the end of
    // @gfx), so !LMB && prev_LMB is the release itself rather than "the button
    // happens to be up", which would fire a stale latch on some later frame.
    _insd_live ? (
      LMB ? (
        abs(my - _insd_y0) > 4 ? _insd_on = 1;
      ) : (
        prev_LMB ? (
        _insd_on && _insd_bank == bank_cur ? (   // a bank switched mid-drag: these records are another bank's
          // Target from the pointer, clamped to slots the chain OWNS —
          // count is the band's own published record for this pad.
          // Rows -> real slots through the record's visible map (house
          // plugins may be hidden), clamped to rows the pad actually shows.
          _insd_cnt = _conins_buf[_insd_pad * CIF_REC + CI_VISN] | 0;
          _insd_row = max(0, min(max(0, _insd_cnt - 1),
                        (((my - _mix_ins_y) / (_mix_ins_sh + swing_px(2))) | 0)
                        + con_ins_scroll));
          _insd_tgt = _insd_cnt > 0 ? (_conins_buf[_insd_pad * CIF_REC + CI_VIS + _insd_row] | 0) : _insd_slot;
          _insd_tgt != _insd_slot ? (
            swing_panels_ins_aim(_insd_ap, _insd_slot, 1);
            swing_fxview_act(FXA_MOVE, _insd_slot, _insd_tgt);
          );
        ) : !_insd_on ? (
          swing_panels_ins_aim(_insd_ap, _insd_slot, 1);
          swing_fxview_act(FXA_FLOAT, _insd_slot, -1);
        );
        );
        _insd_live = 0;
        // Only ours to clear -- the frame globals may already have released it.
        active_id == 308 ? active_id = -1;
      );
    );

    // ═══ INSERT VIEWPORT: the wheel, and the bar that says where you are ═══
    // ⚠️ ALL SIXTEEN STRIPS TOGETHER. The offset is one number for the whole
    // desk, so scrolling never changes a strip's height relative to its
    // neighbours -- equal height is what makes every fader share one zero and
    // one throw. A per-strip viewport would break that on the first notch.
    _mix_g_ins && con_ins_full && _mix_ins_tot > _mix_ins_n ? (
      _insv_hov = mx >= _lcd_cx + _mix_gut - 6 &&
                  mx <= _lcd_cx + _mix_gut + _mix_wtot &&
                  my >= _mix_ins_y && my <= _mix_ins_y + _mix_ins_h;
      _insv_hov && frame_wheel != 0 ? (
        con_ins_scroll = max(0, min(_mix_ins_tot - _mix_ins_n,
                             con_ins_scroll - (frame_wheel > 0 ? 1 : -1)));
        frame_wheel = 0;                       // consumed
      );
      // A bar in the gutter, not a number: the gutter is 30 px and "INS"
      // already owns most of it. It reads as position, which is the whole
      // question a viewport raises.
      _insv_th = max(6, (_mix_ins_h * _mix_ins_n / _mix_ins_tot) | 0);
      _insv_ty = ((_mix_ins_h - _insv_th) * con_ins_scroll
                  / max(1, _mix_ins_tot - _mix_ins_n)) | 0;
      gfx_set(0, 0, 0, 0.28);
      gfx_rect(_lcd_cx + _mix_gut - 5, _mix_ins_y, 3, _mix_ins_h);
      _mix_ink ? gfx_set(0.20, 0.24, 0.30, 0.9) : gfx_set(0.45, 0.72, 0.82, 0.8);
      gfx_rect(_lcd_cx + _mix_gut - 5, _mix_ins_y + _insv_ty, 3, _insv_th);
      // No silent truncation -- say which slots these are and how to move.
      _insv_hov ? (
        strcpy(#_insv_tip, "Insert slots ");
        sprintf(#_insv_n, "%d", con_ins_scroll + 1);
        strcat(#_insv_tip, #_insv_n);
        strcat(#_insv_tip, "–");
        sprintf(#_insv_n, "%d", con_ins_scroll + _mix_ins_n);
        strcat(#_insv_tip, #_insv_n);
        strcat(#_insv_tip, " of ");
        sprintf(#_insv_n, "%d", _mix_ins_tot);
        strcat(#_insv_tip, #_insv_n);
        strcat(#_insv_tip, " — the wheel scrolls every strip together.");
        swing_tooltip_check(1096, #_insv_tip);
      );
    ) : con_ins_scroll = 0;   // nothing to scroll: never hold a stale window

    _mix_i = 0;
    loop(16,
      _mix_i_s = swing_bp(_mix_i);
      _mix_x = _lcd_cx + _mix_gut + _mix_i * _mix_bw
             + ((_mix_fpad >= 0 && _mix_i > _mix_fpad) ? (_mix_bwf - _mix_bw) : 0);
      _mix_bar_w = (_mix_i == _mix_fpad ? _mix_bwf : _mix_bw) - 2;
      // ⚠️⚠️ THE KNOB COLUMN BELONGS TO THE STRIP, NOT TO THE PAN ROW.
      // This was assigned ONLY inside the `_mix_g_pan` block, and DLY / RVB /
      // SMSH read it while setting nothing but their own y. Switch PAN off and
      // it was never written for any strip this frame, so all three send knobs
      // on all sixteen strips drew at one stale x -- and dist(mx,my,_mix_kcx,..)
      // made them unclickable too. It read as "PAN removes the send knobs".
      _mix_kcx = _mix_x + ((_mix_bar_w / 2)|0);

      // Focus backing: a faint wash and a hairline top and bottom, so the
      // wide channel reads as chosen rather than as a layout accident.
      _mix_i == _mix_fpad ? (
        gfx_set(0.30, 0.75, 0.85, 0.055);
        gfx_rect(_mix_x - 2, _mix_ind_y - 4, _mix_bar_w + 4,
                 _mix_vol_y + _mix_vol_h + 14 - _mix_ind_y);
        gfx_set(0.40, 0.82, 0.90, 0.32);
        gfx_rect(_mix_x - 2, _mix_ind_y - 4, _mix_bar_w + 4, 1);
        gfx_rect(_mix_x - 2, _mix_vol_y + _mix_vol_h + 9, _mix_bar_w + 4, 1);
      );
      // Empty pads grey out the entire strip so it matches the pad grid's
      // empty-pad appearance. Playable = sample OR enabled synth.
      _mix_has_audio = pad_is_playable(_mix_i_s);

      // ═══ NAME PILL: the pad's name, editable, top of the strip ═══
      // ONE name per pad, everywhere: this edits the PAD through the same
      // in-place editor the pad grid uses (rk_swing_padname_edit) — no
      // console-only label, no second edit path.
      _mix_pill_h > 0 ? (
        pne_pad == _mix_i_s && pne_host_con ? (
          // This pill is the editor's seat: publish the box geometry — wider
          // than a 44 px strip and clamped inside the console, because the
          // box scrolls horizontally but typing wants room — and let
          // swing_pne_draw paint it over everything later this frame.
          pne_pw = max(90, _mix_bar_w);
          pne_px = max(_con_x + 4, min(_con_x + _con_w - pne_pw - 4,
                       _mix_x + (((_mix_bar_w - pne_pw) / 2) | 0)));
          pne_py = _mix_pill_y - 1;
          pne_geom_ok = 1;
        ) : (
          _pill_hv = mx >= _mix_x && mx <= _mix_x + _mix_bar_w &&
                     my >= _mix_pill_y && my <= _mix_pill_y + _mix_pill_h - 1;
          // ⭐ THE PILL WEARS THE PAD'S COLOUR, filled. That is what a scribble
          // strip looks like on a real desk, and it ties the name to the cap
          // inlay and the well further down the same channel. An empty pad has
          // no colour to wear, so it keeps the dark seat.
          _mix_has_audio ? (
            _cb = _mix_i * 3;
            gfx_set(col_rgba[_cb], col_rgba[_cb+1], col_rgba[_cb+2],
                    _pill_hv ? 1 : 0.88);
          ) : (
            gfx_set(0.05, 0.06, 0.08, _pill_hv ? 0.95 : 0.8);
          );
          gfx_rect(_mix_x, _mix_pill_y, _mix_bar_w, _mix_pill_h - 1);
          gfx_set(0, 0, 0, 0.30);
          gfx_rect(_mix_x, _mix_pill_y + _mix_pill_h - 2, _mix_bar_w, 1);
          gfx_set(1, 1, 1, _pill_hv ? 0.30 : 0.14);
          gfx_rect(_mix_x, _mix_pill_y, _mix_bar_w, 1);
          // Name: custom → sample → number, the scribble's own ladder.
          _cn = get_cname_slot(_mix_i_s);
          strlen(_cn) == 0 ? _cn = get_name_slot(_mix_i_s);
          strlen(_cn) == 0 || !_mix_has_audio ? (
            sprintf(#_mn, "%d", _mix_i + 1); _cn = #_mn;
          );
          // ⚠️ The scribble's size-12 lesson: "COWBEL" is ~42 px in a 44 px
          // strip. The pill SOLVES it — measure at 10, drop to 8 when it
          // clips, clip what still overflows: the full name is one hover
          // away (tooltip) and the rename one click away (the editor).
          rk_font(1, swing_fs(10), 'b');
          gfx_measurestr(_cn, tw, th);
          tw > _mix_bar_w - 6 ? (
            // at 8 px a name with a digit goes regular (wiki 4.7: bold 8 px 5 reads 6)
            rk_font(1, swing_fs(8), swing_txt_wt(swing_fs(8), _cn)); gfx_measurestr(_cn, tw, th);
          );
          _pill_tx = _mix_x + max(3, ((_mix_bar_w - tw) / 2) | 0);
          _pill_ty = _mix_pill_y + (((_mix_pill_h - th) / 2) | 0);
          // ⚠️ ONE INK ACROSS SIXTEEN COLOURS. This is `rk_ink_label`'s rule
          // and its exact idiom -- a per-pad black/white flip would make the
          // name row read as sixteen unrelated labels instead of one strip.
          // Inlined only because the helper takes no clip bounds, and a long
          // name must stop at the strip edge rather than run into its
          // neighbour.
          gfx_set(0, 0, 0, 0.72);
          gfx_x = _pill_tx + 1; gfx_y = _pill_ty + 1;
          gfx_drawstr(_cn, 0, _mix_x + _mix_bar_w - 2, _mix_pill_y + _mix_pill_h);
          gfx_set(0.96, 0.96, 0.97, _mix_has_audio ? 1 : 0.55);
          gfx_x = _pill_tx; gfx_y = _pill_ty;
          gfx_drawstr(_cn, 0, _mix_x + _mix_bar_w - 2, _mix_pill_y + _mix_pill_h);
          _pill_hv ? (
            strcpy(#_cpk_tip, _cn);
            strcat(#_cpk_tip, " — click to rename the pad (everywhere).");
            swing_tooltip_check(1300 + _mix_i, #_cpk_tip);
          );
          _pill_hv && lmb_down && active_id == -1 ? (
            swing_pne_open(_mix_i_s) ? pne_host_con = 1;
            lmb_down = 0; LMB = 0;      // the pill owns this click
          );
        );
      );

      // ═══ INSERTS: the pad's own REAPER track chain ═══
      // Drawn per strip, but when NOTHING can own a track the band says so
      // ONCE (below the loop) instead of 128 dead boxes explaining nothing.
      _mix_g_ins && ((_conins_flags & 1) || _conins_stale) && !_conins_oldfmt
        && (_conins_bankok || _conins_stale) ? (
        swing_panels_ins_band(_mix_i, _mix_x, _mix_ins_y,
                       _mix_bar_w, _mix_ins_n, _mix_ins_sh, con_ins_full);
        // ⭐ WIRED OFF = THIS pad's inserts are not in the path (2026-09-09).
        // In stereo with Wired off a pad never leaves on its own channel pair,
        // so anything pinned here is silent and a fully lit card says otherwise.
        // ⚠ Only strips that actually HOLD something: an empty slot with Wired
        // off is not a lie, it is the invitation -- clicking one is what adds the
        // plugin AND switches Wired on, so greying it would dim the very control
        // that fixes the state. First cut veiled the whole band and did exactly
        // that. Flags, not patch_on/multi_out, so this can never disagree with
        // the message line below: bit2 = stereo, bit3 = Wired off, and both are
        // published by the same bridge tick that filled these records.
        // Painted here rather than inside swing_panels_ins_band because
        // swing_panels_console_bg is defined AFTER that function, and an EEL2
        // forward reference is a silent whole-file compile kill (wiki 01).
        (_conins_flags & 4) && (_conins_flags & 8) && !_conins_stale &&
        (_conins_buf[_mix_i * CIF_REC + CI_VISN] | 0) > 0 ? (
          swing_panels_console_bg(0.62);
          gfx_rect(_mix_x, _mix_ins_y, _mix_bar_w, _mix_ins_h);
        );
      );

      // ═══ SWING chain band: the channel's own EQ/dynamics section ═══
      _mix_g_sw ? swing_panels_sw_band(_mix_i_s, _mix_x, _mix_sw_y, _mix_bar_w,
                                       _mix_sw_h, con_sw_full);

      // ═══ PAN: rotary knob (big view) / green centre-referenced mini-slider (LCD page) ═══
      // Gated by the section toggle (ser_ver 58). _mix_g_* already folds in
      // the "compact LCD page ignores console settings" exemption.
      _mix_g_pan ? (
      _pan_sy = _mix_y_pan;
      _mix_big ? (
        // Faint strip backing ties the four knobs to the fader below as one channel.
        _mix_ink ? gfx_set(0, 0, 0, 0.05) : gfx_set(1, 1, 1, 0.035);
        gfx_rect(_mix_x, _mix_ind_y, _mix_bar_w, _mix_top_h - 2);
        _mix_kcy = _pan_sy + ((_mix_sl_h / 2)|0);   // _mix_kcx: strip loop head
        _mix_km = km_console + (_mix_i * KM_CON_PER_PAD + 0) * KS;
        _mix_has_audio ? ( _mix_kc_r = 0.30; _mix_kc_g = 0.90; _mix_kc_b = 0.50; )
                       : ( _mix_kc_r = 0.50; _mix_kc_g = 0.48; _mix_kc_b = 0.46; );
        rk_knob_draw(_mix_kstyle, _mix_kcx, _mix_kcy, _mix_kr, p_pan[_mix_i_s], -1.0, 1.0, 1, _mix_km[0],
                     _mix_kc_r, _mix_kc_g, _mix_kc_b, 0, 0.36, 0.34, 0.32);
        dist(mx, my, _mix_kcx, _mix_kcy) <= _mix_kr + 2 ?
          swing_tooltip_check(800 + _mix_i, "Pad pan in mixer view — drag, scroll, or double-click to center.");
        // Same feel as the pad-grid knobs: vertical drag, CTRL = fine, wheel,
        // double-click = centre. The knob lib owns its drag state (mem[1]), so
        // active_id stays -1 — nothing else in the console starts on a held
        // button, and the click-outside close only fires on a fresh press.
        _mix_knv = ssl_knob_interact(_mix_km, _mix_kcx, _mix_kcy, _mix_kr, p_pan[_mix_i_s], -1.0, 1.0, 0, 0);
        _mix_knv != p_pan[_mix_i_s] ? (
          p_pan[_mix_i_s] = _mix_knv;
          p_panL[_mix_i_s] = 1.0 - max(0.0, _mix_knv); p_panR[_mix_i_s] = 1.0 + min(0.0, _mix_knv);
          mark_dirty_pad(_mix_i_s);
        );
      ) : (
        _pan_norm = (p_pan[_mix_i_s] + 1.0) / 2.0;  // 0..1
        _pan_mid = _mix_x + _mix_bar_w / 2;
        _pan_px = (_mix_x + _pan_norm * _mix_bar_w)|0;
        // Background
        gfx_set(0.12, 0.14, 0.18, 0.6);
        gfx_rect(_mix_x, _pan_sy, _mix_bar_w, _mix_sl_h);
        // Center tick
        gfx_set(0.30, 0.32, 0.35, 0.7);
        gfx_rect(_pan_mid, _pan_sy, 1, _mix_sl_h);
        // Fill from center to position
        _pan_fill_x = min(_pan_mid, _pan_px);
        _pan_fill_w = abs(_pan_px - _pan_mid);
        _pan_fill_w > 0 ? (
          _mix_has_audio ? gfx_set(0.25, 0.70, 0.38, 0.7) : gfx_set(0.42, 0.40, 0.38, 0.55);
          gfx_rect(_pan_fill_x, _pan_sy, _pan_fill_w, _mix_sl_h);
        );
        // Thumb (bright green dot, greyed if empty)
        _mix_has_audio ? gfx_set(0.30, 0.90, 0.50, 1.0) : gfx_set(0.50, 0.48, 0.46, 0.85);
        gfx_rect(max(_mix_x, min(_mix_x + _mix_bar_w - 2, _pan_px - 1)), _pan_sy, 3, _mix_sl_h);
        swing_panels_mix_bevel(_mix_x, _pan_sy, _mix_bar_w, _mix_sl_h);

        // PAN interaction
        _in_pan = mx >= _mix_x && mx <= _mix_x + _mix_bar_w && my >= _pan_sy && my <= _pan_sy + _mix_sl_h;
        _in_pan ? swing_tooltip_check(800 + _mix_i, "Pad pan in mixer view — drag, scroll, or double-click to center.");
        active_id == -1 && lmb_down && _in_pan ? (
          _mix_now = time_precise();
          _mix_dbl_id == (100 + _mix_i) && (_mix_now - _mix_dbl_time) < DBL_CLICK_T ? (
            p_pan[_mix_i_s] = 0;
            p_panL[_mix_i_s] = 1.0; p_panR[_mix_i_s] = 1.0;
            mark_dirty_pad(_mix_i_s); _mix_dbl_id = -1;
          ) : (
            active_id = 291; _mix_drag_pad = _mix_i;
            p_pan[_mix_i_s] = max(-1.0, min(1.0, ((mx - _mix_x) / _mix_bar_w) * 2.0 - 1.0));
            p_panL[_mix_i_s] = 1.0 - max(0.0, p_pan[_mix_i_s]);
            p_panR[_mix_i_s] = 1.0 + min(0.0, p_pan[_mix_i_s]);
            mark_dirty_pad(_mix_i_s);
            _mix_dbl_time = _mix_now; _mix_dbl_id = 100 + _mix_i;
          );
        );
        _in_pan && frame_wheel != 0 ? (
          p_pan[_mix_i_s] = max(-1.0, min(1.0, p_pan[_mix_i_s] + frame_wheel * 0.05));
          p_panL[_mix_i_s] = 1.0 - max(0.0, p_pan[_mix_i_s]);
          p_panR[_mix_i_s] = 1.0 + min(0.0, p_pan[_mix_i_s]);
          mark_dirty_pad(_mix_i_s);
        );
      );
      );

      // ═══ DLY send: rotary knob (big view) / blue fill mini-slider (LCD page) ═══
      // Gated by the section toggle (ser_ver 58). _mix_g_* already folds in
      // the "compact LCD page ignores console settings" exemption.
      _mix_g_sends ? (
      _dly_sy = _mix_y_dly;
      _mix_big ? (
        _mix_kcy = _dly_sy + ((_mix_sl_h / 2)|0);
