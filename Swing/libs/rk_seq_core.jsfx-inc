// The patterns and the song back to empty: a kit's record arrives into a clean slate; the settings stay the project's.
function seq_kit_clear() local(_kc_p) (
  _kc_p = 0; loop(SEQ_PATS, seq_clear_pattern(_kc_p); _kc_p += 1; );
  seq_meta_clear_all();   // round two H: the names and colours are the kit's too
