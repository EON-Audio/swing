            seq_srz_a = seq_pack_a(_sp_b, _sp_rs);  seq_srz_a = seq_io_var(seq_srz_a, _ch);
            seq_srz_w = seq_pack_b(_sp_b);          seq_srz_w = seq_io_var(seq_srz_w, _ch);
