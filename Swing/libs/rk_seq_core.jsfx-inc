    : seq_sync_was ? ( gmem[_st_b + 11] = 0; gmem[_st_b + 60] = 0; seq_sync_was = 0; seq_map_n = 0; seq_map_gen = -1; seq_rs_i = -1; seq_sync_sil = 0; seq_span_n = 0; seq_map[SEQ_MAP_SPAN] = 0; );
