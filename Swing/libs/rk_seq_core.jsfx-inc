// rk_seq_core.jsfx-inc -- the Swing step sequencer's engine (Spec_Swing_Seq_View.md; phases S1 + S2, 2026-10-19).
// The data model (spec 6), the walker (spec 12, host mode), the note-off schedule and the project save
// (spec 8). No gfx here: the grid is rk_seq_ui.jsfx-inc. The host claims the memory and calls seq_init;
// this inc never claims freemem itself (wiki 2.4). Imported AFTER rk_swing_block (swing_pad_blocked) and
// rk_swing_core (the launcher, the voice schedule): EEL2 binds a call at definition time.
//
// S1 (the user: "Go: build the first step (the part that plays steps in time, the project save, a plain
// full-window grid)"): sixteen lanes aimed at pads, each lane its length and division, steps on / off with a
// velocity, lane mute / solo, GATE on gate-mode pads, the sequencer's own PLAY switch.
// P0.0 (2026-10-20, the release plan's groundwork): the walk per lane (seq_walk_lane) with an ANCHOR and a SINK, the
// pattern SELECTOR (seq_eng_pat / seq_eng_anchor) and the OP QUEUE (seq_post_op) -- no change of behaviour.
// S2 (the user: "Go: start the per-step features"): per step probability, rolls (ratchets 1..4 with their own
// sub-velocities), nudge and accent; per pattern swing, humanize (velocity and time), the accent offset; per
// lane the offset in ms and the swing strength W. Every one of these was already in the data model and the
// stream, so no new serialize gate. Not yet read by the walker: tie / slide, per-step pitch / pan (1b), the
// groove slot and LINK (S4), the song chain (S4, the regions).
// S3 (2026-10-20, the user: "go"): thirty-two patterns and a clipboard slot; the pattern ops (clear all, copy, paste,
// duplicate, halve, double) through the op queue; the MIDI triggers (seq_trig_note from the host's MIDI loop: a note in
// the trigger range picks a pattern at the next 1/16 boundary -- change, change + resync, change + resync on the beat)
// with the switch inside the block: the outgoing pattern plays to the switch beat and its later hits are cut.
// (c) EON Studios -- All Rights Reserved

@init

SEQ_PATS     = 32;   // patterns held live (16 until S3, 2026-10-20). The stream carries its own pattern count
                     // (seq_serialize), so this constant can grow without a new gate; a stream with more patterns
                     // than this build holds is read to the end and the extra patterns dropped. The host claims one
                     // slot MORE: SEQ_CLIP, the clipboard (never walked, never saved).
SEQ_LANES    = 16;
SEQ_STEPS    = 64;
SEQ_ATTR     = 10;   // per step: 0 on, 1 vel 1..127, 2 prob 0..100, 3 ratchet 1..4, 4 tie (0 none 1 tie 2 slide),
                     //           5 nudge -50..50 (% of a step), 6 pitch -48..48, 7 pan -100..100, 8 acc 0/1, 9 cond (reserved)
SEQ_RSUB_N   = 3;    // per step: the velocities of a roll's 2nd, 3rd and 4th hit (0 = the step's own velocity).
                     // _N because EEL2 names are case-insensitive: SEQ_RSUB would BE the array seq_rsub (wiki 1.13)
SEQ_LANE_F   = 13;   // per lane record: 0 target (a pad slot 0..NUM_SLOTS-1; -1..-16 = a MIDI channel, phase 4b),
                     //   1 len 1..64, 2 div (index, seq_div_beats), 3 offset_ms (-500..500), 4 / 5 the pattern's own mute / solo
                     //   until the polish pass (2026-10-20: now one mute and one solo per LANE for every pattern, seq_gmute /
                     //   seq_gsolo; these two cells stay in the record and the stream, read once to migrate an older file), 6 vol, 7 pan,
                     //   8 SW: the lane's OWN swing 0..100 % (odd steps late by SW % of half a step), or -1 = the pattern's
                     //     SWING (P0a, 2026-10-20, the user: "swing per lane" = "its own swing per lane"; until P0a this
                     //     cell was W, a strength 0..100 % OF the pattern's swing, default 100 -- a 78 stream is converted),
                     //   9 link_src (-1 none), 10 piano, 11 scale, 12 groove_slot
SEQ_PAT_F    = 12;   // per pattern record: 0 len, 1 rate, 2 feel, 3 swing 0..100 % (100 = odd steps half a step late),
                     //   4 gate %, 5 hum_v % (velocity, +-), 6 hum_t % (time, +- half a step at 100), 7 acc (the accent
                     //   offset, -127..127), 8 used, 9 seed, 10 fill_src (-1 none), 11 reserved
SEQ_SONG_MAX = 64;   // song chain slots (pattern, repeats) -- nothing fills them (decision 23: the song is the regions'); an
                     //   older stream's SONG tag is still read into them, the writer dropped it (D9, 2026-10-29)
SEQ_WK_F     = 16;   // per lane runtime: 0 the first step index not yet done (the window's start), 1 the step under the
                     //   playhead (-1 none), 2 the division that index was counted in, 3 fresh (1 right after a jump: hits
                     //   already past are skipped, not fired late), 4..6 unused since S5's window, neither written nor
                     //   read (were the roll hit, the roll count and the die of one step), 7 the lane's kind last walked (1 grid, 2 roll; a change
                     //   resets the walker), 8..11 the window's steps' judged hits (a bit per roll hit or note slot), 12 the
                     //   pad the lane's last FIRE hit went to (item g, seq_ms_edge_tick; read while its seq_ms_hit bit is
                     //   set; seq_wk_reset leaves it), 13..15 spare
SEQ_WIN      = 4;    // S5 (Codex): the walker judges this many steps at once (a step's hits within [-1, +2.25] steps)
SEQ_HB_MAX   = 512;  // S5 (Codex): the walk's hits per block, sorted by time before they fire (entries of SEQ_HB_F)
SEQ_HB_F     = 8;    //   0 time (beats), 1 lane, 2 step index, 3 hit / slot, 4 the step on the lane, 5 hold (beats), 6 kind
SEQ_NOQ_MAX  = 256;  // note-off schedule: entries of SEQ_NOQ_F (pad, note, due beat, the mirror; pad < 0 = a MIDI channel lane's
                     // note, -channel). 32 until S5: chords and held notes need the room
SEQ_NOQ_F    = 4;    // S6: [3] = the drum mirror's channel owed a note-off (0 none) + 100 x mirror-only (a one-shot pad: no voice release)
SEQ_PRINT_F  = 5;    // S6: a printed hit in the EON_SEQ_PRINT band: beat, note, velocity, length (beats), channel: 100 + the
                     // absolute pad 0..63 for a pad hit (the small-things round: PRINT SONG puts each drum on its own track;
                     // an older bridge maps anything outside 1..16 to channel 1), 1..16 a channel lane's note, 0 a roll note
                     // on a pad lane (it prints at its own pitch: the item's channel 1)
SEQ_MAP_SPAN = 452;  // the small-things round: the map band's tail per slot (and the mirror's, the same offsets): +452 the count
SEQ_SPAN_MAX = 29;   //   of the spans the bridge's PRINT SONG items cover (0..29), pairs (start, end) in quarter notes from +454
                     //   -- the region entries' units; the engine plays no hit inside one while SONG is on (seq_span_at)
SEQ_ECHO_WIN = 0.25; // S6: seconds -- a note arriving on the mirror's channel this soon after its mirror went out is the mirror's own echo
SEQ_CHORD_N  = 6;    // S5, the piano roll: up to six notes start on one step of a roll lane (a chord)
SEQ_NOTE_F   = 3;    // per note: 0 pitch + 1 (0 = an empty slot; written LAST), 1 velocity, 2 length in quarter steps x 128 +
                     //   (nudge + 50) -- one cell, an integer under 2^16. Notes live in a store of their own, per pattern, lane,
                     //   step and slot (seq_note_at); a roll lane's step grid is not played
SEQ_MO_CAP     = 512;  // S5: MIDI out this block (channel lanes): entries of 4, sorted by offset before they are sent. Room
                       // for SEQ_NOQ_MAX note-offs is always kept (seq_midi_note): an owed note-off is never lost (Codex)
SEQ_DIV_N    = 9;    // divisions: 0 1/4, 1 1/8, 2 1/16, 3 1/32, 4 1/4T, 5 1/8T, 6 1/16T, 7 1/8., 8 1/16.
SEQ_DIV_DEFAULT  = 2;
SEQ_LEN_DEFAULT  = 16;
SEQ_VEL_DEFAULT  = 100;
SEQ_GATE_DEFAULT = 100;
SEQ_LSW_FOLLOW   = -1;   // lane field 8: "the pattern's swing" (the default)
SEQ_EPS = 0.000000001;   // a billionth of a beat: the walker's boundary tolerance (0.003 samples at 1000 BPM)
SEQ_LAND_SPL = 2;        // samples: after a jump (a loop wrap, a seek, a start) a hit this close BEFORE the landing still
                         // plays, on its first sample. REAPER starts every lap of a loop whose length is not a whole number
                         // of samples ONE sample past the loop start (measured in the owner's REAPER 7.83, 2026-10-28:
                         // 140 BPM, 48 k, the cut block before the wrap ending +0.2857 samples past the loop end), so step 1
                         // sat a sample "in the past" and was skipped on every lap whose pre-wrap block had not already
                         // fired it -- every lap of a two-bar pattern under a one-bar loop (seq_endf_*: no double)
SEQ_SRZ_PATS_MAX = 256;  // the static bound on a stream's pattern count (wiki 3.5)
SEQ_REACH = 2.6;         // steps: how far a hit can sit past its boundary -- swing 0.5 + nudge 0.5 + humanize 0.5 and a
                         // roll's last hit 0.75, with margin (the lane offset is added separately) -- so the walker knows
                         // how far behind a jump to start judging (self-audit 2026-10-20 finding 3: 1.6 lost a x4 roll's
                         // late hits right after a jump at the extremes)

// A bit of a lane mask (lanes 0..15): pow and floor, no variable shift (the shift_32bit rule).
function seq_bit(_bi_m, _bi_b) ( floor(_bi_m / (2 ^ _bi_b)) & 1; );
function seq_bit_flip(_bf_m, _bf_b) ( seq_bit(_bf_m, _bf_b) ? _bf_m - 2 ^ _bf_b : _bf_m + 2 ^ _bf_b; );

// Beats (quarter notes) per step for a division index. beat_position counts quarter notes, as the note
// repeat's grid does (rk_swing_block swing_block_process_note_repeat).
function seq_div_beats(d) (
  d == 0 ? 1 : d == 1 ? 0.5 : d == 2 ? 0.25 : d == 3 ? 0.125 :
  d == 4 ? 2 / 3 : d == 5 ? 1 / 3 : d == 6 ? 1 / 6 : d == 7 ? 0.75 : d == 8 ? 0.375 : 0.25;
);

// A repeatable die, 0..1: the same (seed, lane, step index, salt) always rolls the same, so a render and the
// playback agree and a probability or a humanized hit lands the same way every time the project plays from the
// same place (spec 12: "seeded per bar, repeatable"). Integer mixing in doubles, every product under 2^53.
function seq_hash01(_h_a, _h_b, _h_c, _h_d) local(_h_x) (
  _h_x = (_h_a + 1) * 73856093 + (_h_b + 1) * 19349663 + (_h_c + 1) * 83492791 + (_h_d + 1) * 50331653;
  _h_x = _h_x - floor(_h_x / 16777213) * 16777213;
  _h_x = (_h_x + 1) * 48271;
  _h_x = _h_x - floor(_h_x / 2147483647) * 2147483647;
  _h_x = (_h_x + 1) * 16807;
  _h_x = _h_x - floor(_h_x / 2147483647) * 2147483647;
  _h_x / 2147483647;
);

// ─── Addresses ───────────────────────────────────────────────────────────────
function seq_step_at(p, l, s) ( seq_step + ((p * SEQ_LANES + l) * SEQ_STEPS + s) * SEQ_ATTR; );
function seq_rsub_at(p, l, s) ( seq_rsub + ((p * SEQ_LANES + l) * SEQ_STEPS + s) * SEQ_RSUB_N; );
function seq_lane_at(p, l)    ( seq_lane + (p * SEQ_LANES + l) * SEQ_LANE_F; );
function seq_pat_at(p)        ( seq_pat + p * SEQ_PAT_F; );
function seq_note_at(p, l, s) ( seq_note + ((p * SEQ_LANES + l) * SEQ_STEPS + s) * SEQ_CHORD_N * SEQ_NOTE_F; );   // S5: the step's six slots
// A roll lane plays its notes, not its step grid: switched to ROLL (lane field 10), or aimed at a MIDI channel (target < 0).
function seq_lane_roll(_lr_lb) ( _lr_lb[10] || (_lr_lb[0] | 0) < 0; );
// A note's length in steps and its nudge (% of a step), out of the packed cell; and the cell from them.
function seq_nlen(_nl_c) ( floor(_nl_c / 128) * 0.25; );
function seq_nnud(_nn_c) ( (_nn_c - 128 * floor(_nn_c / 128)) - 50; );
function seq_npack(_np_len, _np_nud) ( max(1, min(256, floor(_np_len * 4 + 0.5))) * 128 + max(0, min(100, floor(_np_nud + 50.5))); );

// ─── Defaults and clears ─────────────────────────────────────────────────────
// A lane aims at its own slot index (bank A for a one-bank kit; spec 6.1), sixteen steps of 1/16, the pattern's swing.
function seq_lane_default(p, l) local(_ld_b) (
  _ld_b = seq_lane_at(p, l);
  _ld_b[0] = l; _ld_b[1] = SEQ_LEN_DEFAULT; _ld_b[2] = SEQ_DIV_DEFAULT; _ld_b[3] = 0;
  _ld_b[4] = 0; _ld_b[5] = 0; _ld_b[6] = 1; _ld_b[7] = 0; _ld_b[8] = SEQ_LSW_FOLLOW; _ld_b[9] = -1;
  _ld_b[10] = 0; _ld_b[11] = 0; _ld_b[12] = 0;
);
function seq_pat_default(p) local(_pd_b) (
  _pd_b = seq_pat_at(p);
  _pd_b[0] = SEQ_LEN_DEFAULT; _pd_b[1] = SEQ_DIV_DEFAULT; _pd_b[2] = 0; _pd_b[3] = 0;
  _pd_b[4] = SEQ_GATE_DEFAULT; _pd_b[5] = 0; _pd_b[6] = 0; _pd_b[7] = 0; _pd_b[8] = 0;
  _pd_b[9] = 0; _pd_b[10] = -1; _pd_b[11] = 0;
);
function seq_clear_pattern(p) local(_cp_l) (
  memset(seq_step_at(p, 0, 0), 0, SEQ_LANES * SEQ_STEPS * SEQ_ATTR);
  memset(seq_note_at(p, 0, 0), 0, SEQ_LANES * SEQ_STEPS * SEQ_CHORD_N * SEQ_NOTE_F);   // S5: the notes
  memset(seq_rsub_at(p, 0, 0), 0, SEQ_LANES * SEQ_STEPS * SEQ_RSUB_N);
  _cp_l = 0; loop(SEQ_LANES, seq_lane_default(p, _cp_l); _cp_l += 1; );
  seq_pat_default(p);
);
// Everything the stream carries, back to a fresh instance: every pattern, the song, the settings.
// seq_cur / seq_page / seq_off and the placement cells are zero by design (the fb_open rule: zero is
// the default and is assigned nowhere else in @init).
function seq_clear_all() local(_ca_p) (
  _ca_p = 0; loop(SEQ_PATS, seq_clear_pattern(_ca_p); _ca_p += 1; );
  memset(seq_song, 0, SEQ_SONG_MAX * 2);
  seq_song_len = 0; seq_song_loop = 0; seq_song_pos = 0;
  seq_cur = 0; seq_page = 0; seq_view = 0; seq_off = 0; seq_run = 0; seq_h = 0; seq_shown = 0;
  seq_place = 0; fb_place = 0; fx_place = 0; seq_trig_mode = 0; seq_trig_base = 0;
  seq_opt_icons = 0; seq_opt_follow = 0; seq_opt_transport = 1; seq_opt_sync = 0; seq_opt_midiout = 1; seq_opt_midich = 10;
  seq_opt_adapt = 0;   // S4: re-aim the lanes when a kit load moves the pads (the bridge's ADAPT permutation); off, Steppa's default
  seq_gmute = 0; seq_gsolo = 0;   // the polish pass: one mute and one solo per lane, for every pattern (bit l = lane l)
  seq_gms_srz = 0;                // the stream carried them (SETTINGS cell 21); 0 after a read = an older file: migrate
  seq_col_hide = 0;               // the lane columns hidden (bit 0 M / S, 1 name, 2 length, 3 division, 4 swing; the icon is seq_opt_icons)
  seq_opt_snap = 0;               // S5: SNAP -- where a moved hit or note lands: 0 a step, 1 a half, 2 a third, 3 free
  seq_opt_rollh = 0;              // S5: the piano roll's share of the lane area, per cent (0 = half); the grabber sets it
  seq_opt_topdown = 0;            // 0 = the lanes bottom-up like the pads, lane 1 (the kick) at the bottom -- the default (the user, 2026-10-20:
                                  // "can we change the order to match our pads. the kick starting at the bottom"); 1 = lane 1 at the top
);
// The walker forgets where it was (a jump in the timeline, a stop, a division change).
function seq_wk_reset(_wr_l) local(_wr_b) (
  _wr_b = seq_wk + _wr_l * SEQ_WK_F;
  _wr_b[0] = 0; _wr_b[1] = -1; _wr_b[3] = 1;   // index 0 + fresh: the tick re-aims it
  _wr_b[8] = 0; _wr_b[9] = 0; _wr_b[10] = 0; _wr_b[11] = 0;   // the window: nothing judged
);
// Called once from the host's @init with the thirteen bases it claimed (in this order: steps, lane records,
// pattern records, song, runtime, the note-off schedule, a 64-cell serialize scratch, the roll sub-velocities,
// the op queue's ring, the note store, the MIDI out buffer, the walk's hit list, the stream's two channels).
function seq_init(_si_step, _si_lane, _si_pat, _si_song, _si_wk, _si_noq, _si_tmp, _si_rsub, _si_opq, _si_note, _si_mo, _si_hb, _si_io) local(_si_l) (
  seq_io = _si_io; memset(seq_io, 0, 2 * SEQ_IO_F);   // S3c: the stream's two channels
  seq_note = _si_note; seq_mo = _si_mo; seq_mo_n = 0;   // S5: the note store, the MIDI out buffer
  seq_hb = _si_hb; seq_hb_n = 0;                        // S5 (Codex): the walk's hit list
  seq_step = _si_step; seq_lane = _si_lane; seq_pat = _si_pat; seq_song = _si_song;
  seq_wk = _si_wk; seq_noq = _si_noq; seq_srz_tmp = _si_tmp; seq_rsub = _si_rsub; seq_opq = _si_opq;
  seq_clear_all();
  _si_l = 0; loop(SEQ_LANES, seq_wk_reset(_si_l); seq_wk[_si_l * SEQ_WK_F + 2] = -1; _si_l += 1; );
  seq_noq_n = 0; seq_prev_b1 = -1000000; seq_playing = 0;
  memset(seq_opq, 0, SEQ_OPQ_N * 4); seq_opq_r = 0; seq_eng_pat = 0; seq_eng_anchor = 0;
  seq_wk_anchor = 0;   // the anchor the walkers last walked with (seq_walk_all; the host branch's reset, audit H19)
  seq_trig_pat = -1; seq_sw_pat = -1; seq_sw_beat = 0; seq_sw_resync = 0; seq_clip_full = 0; seq_blk_w0 = 0;
  seq_ap_primed = 0;   // the presets' baseline is taken again after a re-init (S3b)
  seq_rs_pat = -1; seq_rs_anchor = 0; seq_rs_edge = 0; seq_rs_i = -1; seq_sync_was = 0;   // the regions (S4)
  seq_rs_prev_i = -2; seq_rs_prev_a = 0;   // the region (and its anchor) the last block walked; -2 = none
  seq_adapt_primed = 0; seq_adapt_seq = 0; seq_dm_patseq_primed = 0;
  seq_endf_cur = 0; seq_endf_prev = 0; seq_blk_land = SEQ_EPS;   // the landing tolerance's state (SEQ_LAND_SPL)
  // seq_opq_w is @gfx's alone (a global starts at 0): one writer per counter is what makes the ring race-free
);

// ─── Step edits (single-cell writes; @gfx calls these directly, spec 9) ─────
// A step switched on gets every attribute's neutral value, so the fields the walker reads later never find a
// zero left by the clear. This one takes the step's address alone (the rigs' hooks call it so); the grid calls
// seq_step_on_at below, which also puts the roll's sub-velocities back to "the step's own" -- this one cannot,
// it has no address for them (self-audit 2026-10-20 finding 2).
function seq_step_on(_so_b, _so_vel) (
  _so_b[1] = max(1, min(127, _so_vel | 0)); _so_b[2] = 100; _so_b[3] = 1; _so_b[4] = 0; _so_b[5] = 0;
  _so_b[6] = 0; _so_b[7] = 0; _so_b[8] = 0; _so_b[9] = 0;
  _so_b[0] = 1;
);
function seq_step_off(_sf_b) ( _sf_b[0] = 0; );
// Aim every lane of a pattern at bank _ap_bank: a lane keeps its pad number inside the bank (P0a; the OPTIONS menu).
// Sixteen single-cell writes; the walker reads a lane's record once per block, so a half-done set lasts one block
// and every lane lands whole.
function seq_aim_pattern(_ap_p, _ap_bank) local(_ap_l, _ap_lb, _ap_t) (
  _ap_bank = max(0, min(NUM_BANKS - 1, _ap_bank | 0));
  _ap_l = 0; loop(SEQ_LANES,
    _ap_lb = seq_lane_at(_ap_p, _ap_l); _ap_t = _ap_lb[0] | 0;
    _ap_t >= 0 ? _ap_lb[0] = _ap_bank * NUM_PADS + (_ap_t - NUM_PADS * floor(_ap_t / NUM_PADS));
    _ap_l += 1;
  );
);
// The grid's switch-on: the step by its indices, its attributes neutral AND its three sub-velocities cleared, so a
// step switched off and on again does not carry the HIT 2..4 values of a roll it no longer has.
function seq_step_on_at(_sa_p, _sa_l, _sa_s, _sa_vel) (
  seq_step_on(seq_step_at(_sa_p, _sa_l, _sa_s), _sa_vel);
  memset(seq_rsub_at(_sa_p, _sa_l, _sa_s), 0, SEQ_RSUB_N);
);

// ─── The walker: once per @block, after the MIDI loop, before the note repeat ─
// Host mode: the step grid IS the project timeline. Step n of a lane at division d starts at beat n * d
// (quarter notes from the project start), so a lane's phase never depends on when play began, the swung
// step always lands in the same place of the bar, and every lane is polymetric by construction: after len
// steps it wraps (step = n mod len). A hit's own time is its boundary plus, in this order, the pattern's
// swing on odd steps (the lane's own SW %, or the pattern's SWING when the lane follows it), the lane's offset, the
// step's nudge and the humanize of its time;
// a roll puts its hits evenly across the step. Each hit fires at its own sample offset inside the block that
// holds it, the sub-block accuracy MIDI and the note repeat have.
// Hits are judged in order of their step index (and roll hit) per lane, each exactly once: the lane's next
// (index, hit) is kept in seq_wk, judged when its time falls before the block's end, left for a later block
// otherwise. Right after a jump in the timeline (play start, a seek, a loop) the hits already past are
// skipped rather than fired late; the one case where a hit is heard late -- by less than a block -- is two
// neighbours nudged at each other so hard that their order reverses, and it is heard once, never lost.
// The queued note-offs survive a PLAY-off and a jump while the transport runs: they are released at once
// (the reset block below); a transport stop leaves them to the host's stop pass.
// Reads the lane's record ONCE per block into locals: @gfx writes those cells directly (single cells), and
// one read keeps the walk consistent for the block.
//
// P0.0 (2026-10-20, the release plan's groundwork; no change of behaviour): the walk of ONE lane is its own
// function, seq_walk_lane, fed by the block's context (the seq_blk_* cells, set once per block, @block's alone),
// told where the pattern's step 0 sits -- the ANCHOR in beats, 0 = the project's start, host mode exactly as built;
// the MIDI triggers (S3) and the regions (S4) move it -- and what a hit DOES -- the SINK: 0 fires the pad; later 1
// lists the hits for a MIDI item (S6) and 2 feeds the note pool (S5), through seq_emit. The pattern and the anchor
// come from the SELECTOR (seq_eng_pat / seq_eng_anchor: today the pattern on screen at anchor 0), so the later
// steps change the selector and add sinks and never fork this loop. The structural edits ride an OP QUEUE
// (seq_post_op from @gfx, consumed here) instead of the one-word mailbox CLR had.

SEQ_SINK_FIRE = 0;    // the hit plays its pad (seq_fire)
SEQ_SINK_PRINT = 1;   // S6: the hit goes to the print list (seq_print_push), the beat and the length kept
SEQ_OPQ_N     = 8;    // the op queue's ring: SEQ_OPQ_N slots of 4 cells (op, a, b, spare)
SEQ_OP_CLEAR  = 1;    // clear pattern a
SEQ_OP_CLEAR_ALL = 2; // clear every pattern (S3)
SEQ_OP_COPY   = 3;    // pattern a -> the clipboard
SEQ_OP_PASTE  = 4;    // the clipboard -> pattern a (nothing when the clipboard is empty)
SEQ_OP_DUP    = 5;    // pattern a -> pattern b (the face picked b with seq_dup_target and selects it)
SEQ_OP_HALVE  = 6;    // pattern a: every lane one division coarser, half the steps, the hits re-mapped (seq_halve_check first)
SEQ_OP_DOUBLE = 7;    // pattern a: every lane one division finer, twice the steps, the hits re-mapped (seq_double_check first)
SEQ_OP_FILL   = 8;    // lane fill (S3a): a = pattern, b = lane + 16 x (start + 64 x every): from `start` a hit every `every` steps
                      //   to the lane's end, the steps between cleared, the steps before `start` untouched
SEQ_OP_LANE_CLEAR = 9; // a = pattern, b = lane: every step of the lane off
SEQ_OP_LEARN  = 10;   // KEYS' Learn (2026-10-27): a = 1 arm, 0 disarm (seq_trig_learn_take below)
SEQ_CLIP      = SEQ_PATS;   // the clipboard: the pattern slot after the live ones (the host claims SEQ_PATS + 1)
SEQ_TRIG_N    = 16;   // the trigger range: SEQ_TRIG_N notes up from seq_trig_base pick patterns 1..SEQ_TRIG_N

// ─── S5: firing a note (the piano roll) ─────────────────────────────────────────────────────────────────────
// A note-off owed: the schedule's entry; on overflow a pad note rings to its sample's end, a MIDI note is ended at
// once (never left hanging). Returns 1 when scheduled.
function seq_noq_push(_qp_pad, _qp_note, _qp_due, _qp_mir) local(_qp_b) (
  seq_noq_n < SEQ_NOQ_MAX ? (
    _qp_b = seq_noq + seq_noq_n * SEQ_NOQ_F;
    _qp_b[0] = _qp_pad; _qp_b[1] = _qp_note; _qp_b[2] = _qp_due; _qp_b[3] = _qp_mir;
    seq_noq_n += 1; 1;
  ) : 0;
);
// A MIDI event for this block's output (sent sorted by offset at the block's end, seq_mo_flush).
function seq_mo_push(_mp_ofs, _mp_s, _mp_d1, _mp_d2) (
  seq_mo_n < SEQ_MO_CAP ? (
    seq_mo[seq_mo_n * 4] = _mp_ofs; seq_mo[seq_mo_n * 4 + 1] = _mp_s; seq_mo[seq_mo_n * 4 + 2] = _mp_d1; seq_mo[seq_mo_n * 4 + 3] = _mp_d2;
    seq_mo_n += 1; 1;
  ) : 0;
);
// The sort key: the offset, and on one sample a note-off before a note-on (a note ending where the next of the same key
// begins must end FIRST, or a receiver ends the new one at once: Codex S5 finding 3).
function seq_mo_key(_mk_i) ( seq_mo[_mk_i * 4] * 2 + (((seq_mo[_mk_i * 4 + 1] | 0) & 0xF0) == 0x90 && (seq_mo[_mk_i * 4 + 3] | 0) > 0 ? 1 : 0); );
function seq_mo_flush() local(_mf_i, _mf_j, _mf_k) (
  // insertion sort by offset, note-offs first on a sample (a handful of events a block), stable otherwise
  _mf_i = 1;
  while(_mf_i < seq_mo_n) (
    _mf_j = _mf_i;
    while(_mf_j > 0 && seq_mo_key(_mf_j - 1) > seq_mo_key(_mf_j)) (
      _mf_k = 0; loop(4, seq_mo[SEQ_MO_CAP * 4 + _mf_k] = seq_mo[(_mf_j - 1) * 4 + _mf_k]; seq_mo[(_mf_j - 1) * 4 + _mf_k] = seq_mo[_mf_j * 4 + _mf_k]; seq_mo[_mf_j * 4 + _mf_k] = seq_mo[SEQ_MO_CAP * 4 + _mf_k]; _mf_k += 1; );
      _mf_j -= 1;
    );
    _mf_i += 1;
  );
  _mf_i = 0; loop(seq_mo_n, midisend(seq_mo[_mf_i * 4] | 0, seq_mo[_mf_i * 4 + 1] | 0, seq_mo[_mf_i * 4 + 2] | 0, seq_mo[_mf_i * 4 + 3] | 0); _mf_i += 1; );
  seq_mo_n = 0;
);
// ─── S6: the drum mirror (spec 2.7) ──────────────────────────────────────────────────────────────────────────────
// Every pad hit the sequencer fires also goes out as MIDI on seq_opt_midich (the pad's note; a roll note its pitch; the
// velocity; the note-off at the hit's gate), so REAPER's record-output prints a pattern with no bridge and a send drives
// a second instrument. THRU is untouched. The note-off rides the pad's own release entry when it has one (a gate-mode
// pad), else an entry of its own (a one-shot pad: mirror-only, no voice release). A note goes out only when its note-off
// is guaranteed -- the schedule and the block's MIDI out keep the room (seq_midi_note's rule). seq_echo_on_t /
// seq_echo_off_t[note] (the host's cells) remember when the mirror sent each note's on and off, in samples, so the host's
// MIDI loop can tell the mirror's own echo (a loopback send) from a player's note and swallow it (seq_echo_is): a note
// of the mirror's channel within SEQ_ECHO_WIN of its mirror. seq_echo_pos counts the samples (the block's first).
// A note outside 0..127 is not mirrored (round 1 S2 item c, 2026-10-29): a pad hit sends the pad's own note, which every
// writer clamps -- except a project stream read back for a LOCKED pad (Swing_ReaKit.jsfx's p_note file_var: a damaged or
// hand-edited file). Mirrored, it put a byte above 127 on the wire and its echo cells past the 128 of each table, into
// the kit offer's copy that follows them. Not mirrored, it owes no note-off either (the queue entry carries no mirror).
seq_echo_pos = 0;
seq_mirror_pulses = 0;   // the toolbar pass: bumped per mirrored note-on, so the face's lamp can blink (a whole number)
function seq_mirror_on(_mo_note, _mo_vel, _mo_ofs) (
  seq_opt_midiout && _mo_note >= 0 && _mo_note <= 127 && seq_noq_n < SEQ_NOQ_MAX && seq_mo_n < SEQ_MO_CAP - SEQ_NOQ_MAX ? (
    seq_mo_push(_mo_ofs, 0x90 + max(1, min(16, seq_opt_midich | 0)) - 1, _mo_note, max(1, min(127, _mo_vel | 0)));
    seq_echo_on_t[_mo_note] = seq_echo_pos + _mo_ofs;
    seq_mirror_pulses += 1;
    max(1, min(16, seq_opt_midich | 0));
  ) : 0;
);
function seq_mirror_off(_mf_ch, _mf_note, _mf_ofs) (   // -> 1 when it went out (0: no room this block, the entry waits)
  seq_mo_push(_mf_ofs, 0x80 + _mf_ch - 1, _mf_note, 0) ? ( seq_echo_off_t[_mf_note] = seq_echo_pos + _mf_ofs; 1; ) : 0;
);
function seq_echo_is(_ei_on, _ei_note, _ei_ofs) (
  seq_opt_midiout && seq_echo_pos + _ei_ofs - (_ei_on ? seq_echo_on_t[_ei_note] : seq_echo_off_t[_ei_note]) <= SEQ_ECHO_WIN * srate;
);

// ─── Firing ──────────────────────────────────────────────────────────────────
// The same gate and the same launcher as a MIDI hit (Swing_ReaKit.jsfx's midirecv loop): a muted,
// soloed-out, empty or skipped pad stays silent; a second hit on a pad inside one block plays only
// when it starts later in the block and the pad is not Stretch (one trigger per buffer there). The hit
// is marked in _blk_trig like a MIDI hit, so the note repeat does not double it this block.
// A gate-mode pad (its one-shot off) ends after GATE % of its step: queued by its beat here, released
// at its sample in seq_block_tick; the mirror's note-off rides the same entry (S6).
function seq_fire(_sq_pad, _sq_vel, _sq_ofs, _sq_due) local(_sq_eos, _sq_rel, _sq_mir) (
  !swing_pad_blocked(_sq_pad)
    && (!_blk_trig[_sq_pad] || (_sq_ofs > _blk_trig_ofs[_sq_pad] && swing_pitch_eff(_sq_pad) != SP_PITCH_MODE_STRETCH)) ? (
    launch_voices_for_pad_ofs(_sq_pad, p_note[_sq_pad], _sq_vel, 8, _sq_ofs);
    _blk_trig[_sq_pad] = 1; _blk_trig_ofs[_sq_pad] = _sq_ofs;
    _sq_eos = p_oneshot[_sq_pad];
    _sq_rel = (_sq_eos == 0 || (_sq_eos < 0 && !oneshot_global)) ? 1 : 0;
    _sq_mir = seq_mirror_on(p_note[_sq_pad], _sq_vel, _sq_ofs);
    _sq_rel || _sq_mir ? seq_noq_push(_sq_pad, p_note[_sq_pad], _sq_due, _sq_mir + (_sq_rel ? 0 : 100));
  );
);
// A note on a pad: the pad's own launch at the note's pitch (Repitch / Tuned pitch it from the pad's root). The MIDI
// path's one-trigger-a-sample rule is not applied -- a chord's notes start on one sample -- except on a Stretch pad,
// which plays one note at a time. A pad with a key range is monophonic by design (the manual; swing_voice_choke_pass):
// a chord's notes start together and survive each other, a LATER note on the pad ends them.
function seq_fire_note(_fn_pad, _fn_pitch, _fn_vel, _fn_ofs, _fn_due) local(_fn_eos, _fn_rel, _fn_mir) (
  _fn_pad >= 0 && _fn_pad < NUM_SLOTS && !swing_pad_blocked(_fn_pad)
    && (swing_pitch_eff(_fn_pad) != SP_PITCH_MODE_STRETCH || !_blk_trig[_fn_pad] || _fn_ofs > _blk_trig_ofs[_fn_pad]) ? (
    launch_voices_for_pad_ofs(_fn_pad, max(0, min(127, _fn_pitch | 0)), _fn_vel, 8, _fn_ofs);
    _blk_trig[_fn_pad] = 1; _blk_trig_ofs[_fn_pad] = _fn_ofs;
    _fn_eos = p_oneshot[_fn_pad];
    _fn_rel = (_fn_eos == 0 || (_fn_eos < 0 && !oneshot_global)) ? 1 : 0;
    _fn_mir = seq_mirror_on(max(0, min(127, _fn_pitch | 0)), _fn_vel, _fn_ofs);   // S6: the mirror, at the note's pitch
    _fn_rel || _fn_mir ? seq_noq_push(_fn_pad, max(0, min(127, _fn_pitch | 0)), _fn_due, _fn_mir + (_fn_rel ? 0 : 100));
  );
);
// A note out as MIDI on a channel (a channel lane): note-on now, its note-off from the schedule at its due beat. It goes
// out only when the schedule can owe its note-off AND the block's MIDI out keeps room for every note-off the schedule can
// hold; else the note is not played at all (never a note-on without its note-off: Codex S5 finding 1).
function seq_midi_note(_mn_ch, _mn_pitch, _mn_vel, _mn_ofs, _mn_due) (
  _mn_ch = max(1, min(16, _mn_ch | 0)); _mn_pitch = max(0, min(127, _mn_pitch | 0));
  seq_noq_n < SEQ_NOQ_MAX && seq_mo_n < SEQ_MO_CAP - SEQ_NOQ_MAX ? (
    seq_noq_push(-_mn_ch, _mn_pitch, _mn_due, 0);
    seq_mo_push(_mn_ofs, 0x90 + _mn_ch - 1, _mn_pitch, max(1, min(127, _mn_vel | 0)));
  );
);
// S6: a hit for the PRINT list (the EON_SEQ_PRINT band, SEQ_PRINT_F cells each, from +8): the beat, the note, the velocity,
// the length in beats and the channel (0 = a pad hit: the item's channel 1). A full list is cut and says so (+5).
seq_print_n = 0; seq_print_over = 0; seq_print_done = 0;
// The printed-mute job (2026-10-30; a bridge of BRIDGE_LEVEL_PRINT_LANES): a print walks every lane, the muted and the
// soloed-out ones too (seq_walk_unmuted, seq_walk_lane), and each hit's channel cell carries its lane and whether that
// lane sounds now in its FRACTION -- ((lane + 1) + 20 if silent) / 100, so 0.01..0.16 or 0.21..0.36 -- which an older
// bridge drops (it floors the cell). The bridge prints a silent lane's notes MUTED and mutes / unmutes them as the
// lanes change. seq_emit_lane = the lane whose hit is being emitted (seq_hits_emit); all three are @block's.
seq_walk_unmuted = 0; seq_emit_lane = 0; seq_print_lanes = 0;
seq_live_sent = -1;   // @gfx's: the lanes' state the last CMD 94 carried (seq_ui_undo_tick), -1 = none yet
// The lanes that sound now, bit l = lane l: not muted, and soloed when any lane is (the walk's rule, seq_walk_lane).
function seq_lane_sounds(_ls_l) ( !seq_bit(seq_gmute, _ls_l) && (seq_gsolo == 0 || seq_bit(seq_gsolo, _ls_l)); );
function seq_live_mask() local(_lm_l, _lm_m) (
  _lm_m = 0; _lm_l = 0; loop(SEQ_LANES, seq_lane_sounds(_lm_l) ? _lm_m += 2 ^ _lm_l; _lm_l += 1; ); _lm_m;
);
seq_print_pat = 0; seq_print_job = 0;   // round two G: the pattern the last walk printed; the song job's label (mode x 10000 + count x 100 + k; 0 = a plain print)
function seq_print_push(_pp_t, _pp_note, _pp_vel, _pp_len, _pp_ch) local(_pp_b) (
  seq_print_n < EON_SEQ_PRINT_CAP ? (
    _pp_b = EON_SEQ_PRINT_BASE + 8 + seq_print_n * SEQ_PRINT_F;
    gmem[_pp_b] = _pp_t; gmem[_pp_b + 1] = _pp_note; gmem[_pp_b + 2] = max(1, min(127, _pp_vel | 0)); gmem[_pp_b + 3] = max(0.01, _pp_len);
    gmem[_pp_b + 4] = _pp_ch + (seq_print_lanes ? ((seq_emit_lane | 0) + 1 + (seq_lane_sounds(seq_emit_lane | 0) ? 0 : 20)) * 0.01 : 0);
    seq_print_n += 1;
  ) : seq_print_over = 1;
);
// What a note does, by sink (the roll's counterpart of seq_emit): a pad lane plays its pad, a channel lane sends MIDI.
function seq_emit_note(_sn_sink, _sn_tgt, _sn_pitch, _sn_vel, _sn_ofs, _sn_due, _sn_t) (
  _sn_sink == SEQ_SINK_FIRE ? ( _sn_tgt >= 0 ? seq_fire_note(_sn_tgt, _sn_pitch, _sn_vel, _sn_ofs, _sn_due) : seq_midi_note(-_sn_tgt, _sn_pitch, _sn_vel, _sn_ofs, _sn_due); )
  : _sn_sink == SEQ_SINK_PRINT ? (   // S6: a pad note prints when the pad would sound; a channel note on its channel
    _sn_tgt >= 0 ? ( !swing_pad_blocked(_sn_tgt) ? seq_print_push(_sn_t, max(0, min(127, _sn_pitch | 0)), _sn_vel, _sn_due - _sn_t, 0); )
                 : seq_print_push(_sn_t, max(0, min(127, _sn_pitch | 0)), _sn_vel, _sn_due - _sn_t, -_sn_tgt);
  );
);

// What a hit does, by sink (the only place the walk hands a hit on). A printed pad hit carries its drum: the channel
// cell is 100 + the absolute pad (the small-things round), so the bridge can put it on that pad's own track.
function seq_emit(_se_sink, _se_pad, _se_vel, _se_ofs, _se_due, _se_t) (
  _se_sink == SEQ_SINK_FIRE ? seq_fire(_se_pad, _se_vel, _se_ofs, _se_due)
  : _se_sink == SEQ_SINK_PRINT ? ( _se_pad >= 0 && _se_pad < NUM_SLOTS && !swing_pad_blocked(_se_pad) ? seq_print_push(_se_t, p_note[_se_pad], _se_vel, _se_due - _se_t, 100 + _se_pad); );   // S6
);

// The op queue: @gfx posts (payload first, the op, then the write counter LAST -- the consumer reads a slot only once
// the counter has moved past it), @block consumes in order. One writer per counter (seq_opq_w is @gfx's, seq_opq_r is
// @block's), so nothing is ever lost or applied twice; a full ring refuses the post (returns 0) rather than overwrite.
function seq_post_op(_po_op, _po_a, _po_b) local(_po_i) (
  seq_opq_w - seq_opq_r < SEQ_OPQ_N ? (
    _po_i = (seq_opq_w & (SEQ_OPQ_N - 1)) * 4;
    seq_opq[_po_i + 1] = _po_a; seq_opq[_po_i + 2] = _po_b; seq_opq[_po_i] = _po_op;
    seq_opq_w += 1;
    1;
  ) : 0;
);

// ─── The pattern ops (S3): whole-pattern moves, applied in @block from the op queue ──────────────────────
// A pattern's four blocks copied whole (the steps, the roll sub-velocities, the lane records, the pattern record).
function seq_copy_pattern(_cy_src, _cy_dst) (
  memcpy(seq_step_at(_cy_dst, 0, 0), seq_step_at(_cy_src, 0, 0), SEQ_LANES * SEQ_STEPS * SEQ_ATTR);
  memcpy(seq_rsub_at(_cy_dst, 0, 0), seq_rsub_at(_cy_src, 0, 0), SEQ_LANES * SEQ_STEPS * SEQ_RSUB_N);
  memcpy(seq_lane_at(_cy_dst, 0), seq_lane_at(_cy_src, 0), SEQ_LANES * SEQ_LANE_F);
  memcpy(seq_pat_at(_cy_dst), seq_pat_at(_cy_src), SEQ_PAT_F);
  memcpy(seq_note_at(_cy_dst, 0, 0), seq_note_at(_cy_src, 0, 0), SEQ_LANES * SEQ_STEPS * SEQ_CHORD_N * SEQ_NOTE_F);   // S5
);
// The division one step finer / coarser in its own family (straight, triplet, dotted); -1 = none.
function seq_div_finer(_df_d)   ( _df_d == 0 ? 1 : _df_d == 1 ? 2 : _df_d == 2 ? 3 : _df_d == 4 ? 5 : _df_d == 5 ? 6 : _df_d == 7 ? 8 : -1; );
function seq_div_coarser(_dc_d) ( _dc_d == 1 ? 0 : _dc_d == 2 ? 1 : _dc_d == 3 ? 2 : _dc_d == 5 ? 4 : _dc_d == 6 ? 5 : _dc_d == 8 ? 7 : -1; );
// Can the pattern be doubled? Every lane needs a finer division and no more than 32 steps. Returns 0 = yes, else
// the first lane in the way + 1 (the face names it). The whole pattern or nothing.
function seq_double_check(_dk_p) local(_dk_l, _dk_lb, _dk_bad, _dk_b) (
  _dk_bad = 0; _dk_l = 0;
  loop(SEQ_LANES,
    _dk_lb = seq_lane_at(_dk_p, _dk_l);
    !_dk_bad && (seq_div_finer(_dk_lb[2] | 0) < 0 || (_dk_lb[1] | 0) > SEQ_STEPS / 2) ? _dk_bad = _dk_l + 1;
    // S5: a note longer than 32 steps would double past the longest length a note holds (64 steps)
    _dk_b = seq_note_at(_dk_p, _dk_l, 0);
    !_dk_bad ? loop(SEQ_STEPS * SEQ_CHORD_N, _dk_b[0] > 0 && floor(_dk_b[2] / 128) > 128 ? _dk_bad = _dk_l + 1; _dk_b += SEQ_NOTE_F; );
    _dk_l += 1;
  );
  _dk_bad;
);
// Can the pattern be halved? Every lane needs a coarser division, an even number of steps, and no hit on an odd
// step (it would be lost: halve then double is the identity whenever halve is allowed). 0 = yes, else lane + 1.
function seq_halve_check(_hk_p) local(_hk_l, _hk_lb, _hk_bad, _hk_s, _hk_len, _hk_b) (
  _hk_bad = 0; _hk_l = 0;
  loop(SEQ_LANES,
    _hk_lb = seq_lane_at(_hk_p, _hk_l); _hk_len = max(1, min(SEQ_STEPS, _hk_lb[1] | 0));
    !_hk_bad && (seq_div_coarser(_hk_lb[2] | 0) < 0 || (_hk_len & 1)) ? _hk_bad = _hk_l + 1;
    !_hk_bad ? (
      _hk_b = seq_step_at(_hk_p, _hk_l, 0);
      _hk_s = 1; loop(_hk_len / 2, _hk_b[_hk_s * SEQ_ATTR] ? _hk_bad = _hk_l + 1; _hk_s += 2; );
      // S5: a note on an odd step, or one whose length is an odd number of quarter steps (half of it is no length the
      // coarser step can hold: 3/4 of a step would come back a whole step after DOUBLE)
      _hk_b = seq_note_at(_hk_p, _hk_l, 0); _hk_s = 0;
      loop(_hk_len * SEQ_CHORD_N, _hk_b[0] > 0 && ((floor(_hk_s / SEQ_CHORD_N) & 1) || (floor(_hk_b[2] / 128) & 1)) ? _hk_bad = _hk_l + 1; _hk_b += SEQ_NOTE_F; _hk_s += 1; );
    );
    _hk_l += 1;
  );
  _hk_bad;
);
// Double: step s -> step 2 s (the odd steps emptied), the division one finer, the length doubled. Top down, in
// place: a step's new home is never below it. The nudge (% of a step) and the swing stay as they are.
function seq_double_pattern(_dp_p) local(_dp_l, _dp_lb, _dp_len, _dp_s, _dp_b, _dp_rb, _dp_nb, _dp_k) (
  _dp_l = 0;
  loop(SEQ_LANES,
    _dp_lb = seq_lane_at(_dp_p, _dp_l); _dp_len = max(1, min(SEQ_STEPS / 2, _dp_lb[1] | 0));
    _dp_b = seq_step_at(_dp_p, _dp_l, 0); _dp_rb = seq_rsub_at(_dp_p, _dp_l, 0);
    _dp_s = _dp_len - 1;
    loop(_dp_len,
      memcpy(_dp_b + 2 * _dp_s * SEQ_ATTR, _dp_b + _dp_s * SEQ_ATTR, SEQ_ATTR);
      memcpy(_dp_rb + 2 * _dp_s * SEQ_RSUB_N, _dp_rb + _dp_s * SEQ_RSUB_N, SEQ_RSUB_N);
      memset(_dp_b + (2 * _dp_s + 1) * SEQ_ATTR, 0, SEQ_ATTR);
      memset(_dp_rb + (2 * _dp_s + 1) * SEQ_RSUB_N, 0, SEQ_RSUB_N);
      memcpy(seq_note_at(_dp_p, _dp_l, 2 * _dp_s), seq_note_at(_dp_p, _dp_l, _dp_s), SEQ_CHORD_N * SEQ_NOTE_F);   // S5: the notes move too
      memset(seq_note_at(_dp_p, _dp_l, 2 * _dp_s + 1), 0, SEQ_CHORD_N * SEQ_NOTE_F);
      _dp_s -= 1;
    );
    // the notes' lengths double with the steps (the same time); the nudge is a % of the step and stays
    _dp_nb = seq_note_at(_dp_p, _dp_l, 0); _dp_k = 0;
    loop(2 * _dp_len * SEQ_CHORD_N, _dp_nb[0] > 0 ? _dp_nb[2] = seq_npack(seq_nlen(_dp_nb[2]) * 2, seq_nnud(_dp_nb[2])); _dp_nb += SEQ_NOTE_F; _dp_k += 1; );
    _dp_lb[1] = _dp_len * 2; _dp_lb[2] = seq_div_finer(_dp_lb[2] | 0);
    _dp_l += 1;
  );
);
// Halve: step 2 s -> step s (bottom up, in place: a step's new home is never above it), the upper half emptied,
// the division one coarser, the length halved. Only after seq_halve_check said yes.
function seq_halve_pattern(_hp_p) local(_hp_l, _hp_lb, _hp_len, _hp_s, _hp_b, _hp_rb, _hp_nb) (
  _hp_l = 0;
  loop(SEQ_LANES,
    _hp_lb = seq_lane_at(_hp_p, _hp_l); _hp_len = max(2, min(SEQ_STEPS, _hp_lb[1] | 0)) / 2;
    _hp_b = seq_step_at(_hp_p, _hp_l, 0); _hp_rb = seq_rsub_at(_hp_p, _hp_l, 0);
    _hp_s = 0;
    loop(_hp_len,
      memcpy(_hp_b + _hp_s * SEQ_ATTR, _hp_b + 2 * _hp_s * SEQ_ATTR, SEQ_ATTR);
      memcpy(_hp_rb + _hp_s * SEQ_RSUB_N, _hp_rb + 2 * _hp_s * SEQ_RSUB_N, SEQ_RSUB_N);
      memcpy(seq_note_at(_hp_p, _hp_l, _hp_s), seq_note_at(_hp_p, _hp_l, 2 * _hp_s), SEQ_CHORD_N * SEQ_NOTE_F);   // S5
      _hp_s += 1;
    );
    memset(seq_note_at(_hp_p, _hp_l, _hp_len), 0, _hp_len * SEQ_CHORD_N * SEQ_NOTE_F);
    _hp_nb = seq_note_at(_hp_p, _hp_l, 0);
    loop(_hp_len * SEQ_CHORD_N, _hp_nb[0] > 0 ? _hp_nb[2] = seq_npack(max(0.25, seq_nlen(_hp_nb[2]) * 0.5), seq_nnud(_hp_nb[2])); _hp_nb += SEQ_NOTE_F; );
    memset(_hp_b + _hp_len * SEQ_ATTR, 0, _hp_len * SEQ_ATTR);
    memset(_hp_rb + _hp_len * SEQ_RSUB_N, 0, _hp_len * SEQ_RSUB_N);
    _hp_lb[1] = _hp_len; _hp_lb[2] = seq_div_coarser(_hp_lb[2] | 0);
    _hp_l += 1;
  );
);

// ─── The lane fill (S3a; the user, 2026-10-20: "Where are the options for every 2, 4, 8, steps") ──────────────
// From step `start`, a hit every `every` steps to the lane's end at the default velocity, the steps between cleared;
// the steps before `start` are left alone. The lane menu fills from step 1, the step menu from the clicked step.
function seq_lane_clear(_lc_p, _lc_l) (
  memset(seq_step_at(_lc_p, _lc_l, 0), 0, SEQ_STEPS * SEQ_ATTR);
  memset(seq_note_at(_lc_p, _lc_l, 0), 0, SEQ_STEPS * SEQ_CHORD_N * SEQ_NOTE_F);   // S5: a roll lane's notes too
  memset(seq_rsub_at(_lc_p, _lc_l, 0), 0, SEQ_STEPS * SEQ_RSUB_N);
);
function seq_lane_fill(_lf_p, _lf_l, _lf_start, _lf_every) local(_lf_len, _lf_s) (
  _lf_len = max(1, min(SEQ_STEPS, seq_lane_at(_lf_p, _lf_l)[1] | 0));
  _lf_every = max(1, _lf_every | 0);
  _lf_start = max(0, min(SEQ_STEPS - 1, _lf_start | 0));
  _lf_s = _lf_start;
  while(_lf_s < _lf_len) (
    memset(seq_step_at(_lf_p, _lf_l, _lf_s), 0, SEQ_ATTR); memset(seq_rsub_at(_lf_p, _lf_l, _lf_s), 0, SEQ_RSUB_N);
    ((_lf_s - _lf_start) % _lf_every) == 0 ? seq_step_on_at(_lf_p, _lf_l, _lf_s, SEQ_VEL_DEFAULT);
    _lf_s += 1;
  );
);

// ─── The factory presets (S3b; decision 23: the bridge's hand-off) ─────────────────────────────────────────
// The face asks on this instance's registry slot (a NAV bump on EON_SS_PCTRL, or the browser's SELECT); the bridge
// stages the preset -- the velocity plane, the ratchet list, the feel -- into EON_SS_APPLY tagged with the slot and
// bumps its seq LAST; seq_preset_tick takes it into the pattern on screen: every lane's steps off, then plane row r
// lands on the lane aimed at pad r of the bank on screen (else lane r, re-aimed there), with the preset's length and
// division (steps per beat 4 = 1/16, 3 = 1/8T, 2 = 1/8, 6 = 1/16T, 8 = 1/32); a ratchet cell becomes a roll of up to
// four hits with its own sub-velocities; the preset's swing becomes the pattern's SWING and its hat swing the hat
// lanes' own (the bridge marks the hat rows). A request older than this instance (a seq left in gmem) is baselined on
// the first block and never applied (Steppa's rule); @init re-baselines. The face sees seq_preset_seq move and makes
// the undo point.
seq_ap_last = 0; seq_ap_primed = 0;
seq_preset_seq = 0;
seq_pa_used = 0;   // the lanes this apply has put a row on (bit l = lane l)
// The lane plane row r lands on: the lane aimed at pad r of the bank, else lane r re-aimed there -- unless an earlier
// row already sits on lane r (a lane aimed at that row's pad), then the first lane no row has taken: re-aiming it would
// move that row's hits onto pad r (the audit's factory rig, 2026-10-22).
function seq_preset_lane(_pl_p, _pl_r, _pl_bank) local(_pl_l, _pl_hit, _pl_pad) (
  _pl_pad = _pl_bank * NUM_PADS + _pl_r; _pl_hit = -1; _pl_l = 0;
  loop(SEQ_LANES, _pl_hit < 0 && (seq_lane_at(_pl_p, _pl_l)[0] | 0) == _pl_pad ? _pl_hit = _pl_l; _pl_l += 1; );
  _pl_hit < 0 ? (
    _pl_hit = _pl_r;
    seq_pa_used & 2^_pl_r ? (
      _pl_hit = -1; _pl_l = 0;
      loop(SEQ_LANES, _pl_hit < 0 && !(seq_pa_used & 2^_pl_l) ? _pl_hit = _pl_l; _pl_l += 1; );
      _pl_hit < 0 ? _pl_hit = _pl_r;
    );
    seq_lane_at(_pl_p, _pl_hit)[0] = _pl_pad;
  );
  // the row's steps must PLAY: a lane left in ROLL mode (field 10, or re-aimed here from a MIDI channel) walks its notes --
  // just cleared -- and not its grid, so the preset's row was silent and the face showed an empty roll (audit K1, 2026-10-26)
  seq_lane_at(_pl_p, _pl_hit)[10] = 0;
  seq_pa_used |= 2^_pl_hit;
  _pl_hit;
);
