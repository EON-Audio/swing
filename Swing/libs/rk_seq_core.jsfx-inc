function seq_meta_init(_mi_base) ( seq_meta = _mi_base; memset(seq_meta, 0, SEQ_PATS * SEQ_META_F); );
function seq_meta_clear_all() ( seq_meta ? memset(seq_meta, 0, SEQ_PATS * SEQ_META_F); );
function seq_meta_col(_mc_p) ( seq_meta[max(0, min(SEQ_PATS - 1, _mc_p | 0)) * SEQ_META_F] | 0; );
function seq_meta_col_set(_ms_p, _ms_c) ( seq_meta[max(0, min(SEQ_PATS - 1, _ms_p | 0)) * SEQ_META_F] = max(0, min(16777215, _ms_c | 0)); );
