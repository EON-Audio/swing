);
// ─── Gate 79: the TAGGED stream (P0a, 2026-10-20, decision 23) ───────────────
// `[tag, len, cells...]` sections, a count first. A reader takes the tags it knows and SKIPS the others by their
// length (a count-bounded skip), so a later build can add a section (the note pool, S5; the kit record's
// revision) without a new gate number, and a missing tag means defaults: the stream cannot desync a positional
// reader, which is what the wiki's "a new gate for every layout change, in ship order" rule exists to prevent.
// The writer states every length (a counting pass mirrors the pattern writer). Tags: 1 SETTINGS (a fixed block
// of SEQ_SRZ_SET_N cells, the spares written as 0 and ignored on read), 2 SONG, 3 PATTERNS (the sparse body as
// gate 78 wrote it). A file written by gate 78 (the user's own test projects; nothing shipped) is read by the
// 78 body below and converted: lane W (a strength of the pattern's swing) -> the lane's own swing.
SEQ_SRZ_TAG_SET  = 1;
SEQ_SRZ_TAG_SONG = 2;
SEQ_SRZ_TAG_PATS = 3;
SEQ_SRZ_SET_N    = 32;      // the SETTINGS block: 27 used (19..23 the polish pass; 24-25 the roll; 26 the patterns on show, round two H: the lanes' mute and solo masks, their marker,
                            // the hidden columns, the lane order), the rest spare (read into the 64-cell scratch)
SEQ_SRZ_TAGS_MAX = 64;      // static bounds (wiki 3.5)
SEQ_SRZ_LEN_MAX  = 4000000;

// How many cells the PATTERNS body will take (mirrors seq_srz_pattern's writer exactly).
function seq_srz_count_pats() local(_cn_p, _cn_l, _cn_s, _cn_b, _cn_rb, _cn_n) (
  _cn_n = 1;   // the pattern count
  _cn_p = 0; loop(SEQ_PATS,
    _cn_n += 1;   // the used flag
    seq_pat_used(_cn_p) ? (
      _cn_n += SEQ_PAT_F;
      _cn_l = 0; loop(SEQ_LANES,
        _cn_n += SEQ_LANE_F + 1;   // the lane record and the on-step count
        _cn_b = seq_step_at(_cn_p, _cn_l, 0); _cn_rb = seq_rsub_at(_cn_p, _cn_l, 0);
        _cn_s = 0; loop(SEQ_STEPS,
          _cn_b[0] ? ( _cn_n += 3; ((_cn_rb[0] | 0) || (_cn_rb[1] | 0) || (_cn_rb[2] | 0)) ? _cn_n += SEQ_RSUB_N; );
          _cn_b += SEQ_ATTR; _cn_rb += SEQ_RSUB_N; _cn_s += 1;
        );
        _cn_l += 1;
      );
    );
    _cn_p += 1;
  );
  _cn_n;
);
// Skip _sk_n cells of a tag this build does not know (read into the scratch, 16 at a time; count-bounded).
function seq_srz_skip(_sk_n, _ch) local(_sk_k, _sk_b) (
  _sk_n = max(0, min(SEQ_SRZ_LEN_MAX, _sk_n | 0));
  _sk_b = seq_io + _ch * SEQ_IO_F;
  _sk_b[0] == 0 ? ( while(_sk_n > 0) ( _sk_k = min(16, _sk_n); seq_io_mem(seq_srz_tmp, _sk_k, _ch); _sk_n -= _sk_k; ); )
  : ( _sk_b[1] + _sk_n > _sk_b[2] ? _sk_b[3] = 1; _sk_b[1] += _sk_n; );
);
// The SETTINGS block, both directions, through the scratch (64 cells; the first SEQ_SRZ_SET_N carry the block).
function seq_srz_settings(_st_len, _ch) local(_st_k) (
  !seq_io_rd(_ch) ? (
    memset(seq_srz_tmp, 0, SEQ_SRZ_SET_N);
    seq_srz_tmp[0] = seq_shown; seq_srz_tmp[1] = seq_h; seq_srz_tmp[2] = seq_view; seq_srz_tmp[3] = seq_cur;
    seq_srz_tmp[4] = seq_page; seq_srz_tmp[5] = seq_off; seq_srz_tmp[6] = seq_run; seq_srz_tmp[7] = seq_place;
    seq_srz_tmp[8] = fb_place; seq_srz_tmp[9] = fx_place; seq_srz_tmp[10] = seq_trig_mode; seq_srz_tmp[11] = seq_trig_base;
    seq_srz_tmp[12] = seq_opt_icons; seq_srz_tmp[13] = seq_opt_follow; seq_srz_tmp[14] = seq_opt_transport;
    seq_srz_tmp[15] = seq_opt_sync; seq_srz_tmp[16] = seq_opt_midiout; seq_srz_tmp[17] = seq_opt_midich;
    seq_srz_tmp[18] = seq_opt_adapt;
    seq_srz_tmp[19] = seq_gmute; seq_srz_tmp[20] = seq_gsolo; seq_srz_tmp[21] = 1; seq_srz_tmp[22] = seq_col_hide;   // the polish pass
    seq_srz_tmp[23] = seq_opt_topdown; seq_srz_tmp[24] = seq_opt_snap; seq_srz_tmp[25] = seq_opt_rollh;
    seq_srz_tmp[26] = seq_npat;   // round two H: the patterns on show
