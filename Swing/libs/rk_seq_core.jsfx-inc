    _sp_ok ? (
      !seq_io_rd(_ch) ? (
        _sp_s = 0; loop(SEQ_STEPS,
          _sp_b = seq_step_at(_sp_dst, _sp_l, _sp_s);
          _sp_b[0] ? (
            _sp_rb = seq_rsub_at(_sp_dst, _sp_l, _sp_s);
            _sp_rs = (_sp_rb[0] | 0) || (_sp_rb[1] | 0) || (_sp_rb[2] | 0);
