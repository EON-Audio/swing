// One pattern's body, both directions. _sp_dst < 0 = read and drop (a pattern past this build's count):
// its records land in the 16-cell scratch, its triples in the scratch scalars. Returns 1, or 0 when a
// count failed its bound (the caller then reads nothing more).
function seq_srz_pattern(_sp_dst, _ch) local(_sp_l, _sp_s, _sp_b, _sp_lb, _sp_pb, _sp_cnt, _sp_ok, _sp_k, _sp_rs, _sp_rb, seq_srz_a, seq_srz_cnt, seq_srz_s, seq_srz_w) (
  _sp_ok = 1;
