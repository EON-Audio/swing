);
// The adopt (@block, right before the walk; asked by the import's bank A pass of a whole-kit load, never by a preserve
// reload or a bank pass): the staged record replaces the patterns and the song; no record (an older kit, a kit saved
// with an empty sequencer) leaves them alone.
function seq_kit_adopt() local(_ka_n, _ka_ok, _ka_l, _ka_b) (
  seq_kit_adopt_req = 0;
  gmem[EON_SEQ_KIT_BASE] > 0.5 ? (
    gmem[EON_SEQ_KIT_BASE] = 0;
    _ka_n = gmem[EON_SEQ_KIT_BASE + 2] | 0;
    gmem[EON_SEQ_KIT_BASE + 1] >= 1 && _ka_n > 0 && _ka_n <= EON_SEQ_KIT_CAP ? (
      seq_kit_clear();
      _ka_b = seq_io + SEQ_IO_F;   // channel 1: the band, read
      _ka_b[0] = 2; _ka_b[1] = EON_SEQ_KIT_BASE + 8; _ka_b[2] = EON_SEQ_KIT_BASE + 8 + _ka_n; _ka_b[3] = 0; _ka_b[4] = 1;
      _ka_ok = seq_srz_tagged(1, 1);
      seq_npat_post();   // round two H: a kit's record has no count; the face raises it to every used pattern (a request: one writer per word)
      !_ka_ok || _ka_b[3] ? seq_srz_bad = 1;   // the diagnostic flag: a count past its bound, or the record short
      _ka_l = 0; loop(SEQ_LANES, seq_wk_reset(_ka_l); _ka_l += 1; );   // the walkers start the new patterns afresh
      seq_kit_adopted += 1;
      mark_dirty();
    );
  );
);
