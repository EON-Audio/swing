// rk_seq_core_p4.jsfx-inc -- part 4 of rk_seq_core.jsfx-inc (4 parts), cut at a function boundary by
// .dev_tests/split_big_incs.py: REAPER's load time grows with the square of a file's size. Edit freely;
// keep each file under about 40 KB.

// ⚠️ @init IS LOAD-BEARING (.docs/wiki/02-file-structure.md).
@init

// The kit's patterns on offer replace the user's (@block): the face's USE, the only way they ever do. One record, read
// from the plugin's copy (channel 1, mode 3); the offer is spent.
function seq_kit_apply() local(_kx_ok, _kx_l, _kx_b) (
  seq_kit_clear();
  _kx_b = seq_io + SEQ_IO_F;   // channel 1: the copy, read
  _kx_b[0] = 3; _kx_b[1] = 0; _kx_b[2] = seq_kit_pend_n; _kx_b[3] = 0; _kx_b[4] = 1;
  _kx_ok = seq_srz_tagged(1, 1);
  seq_kit_pend_n = 0;
  seq_npat_post();   // round two H: a kit's record has no count; the face raises it to every used pattern (a request: one writer per word)
  !_kx_ok || _kx_b[3] ? seq_srz_bad = 1;   // the diagnostic flag: a count past its bound, or the record short
  _kx_l = 0; loop(SEQ_LANES, seq_wk_reset(_kx_l); _kx_l += 1; );   // the walkers start the new patterns afresh
  seq_kit_adopted += 1;   // the face: the undo point (one) and the word
  mark_dirty();
);
// The adopt (@block, right before the walk; asked by the import's bank A pass of a whole-kit load, never by a preserve
// reload or a bank pass) -- since FU-P an OFFER, never a change: any offer still standing goes first (another kit
// loaded); the staged record is copied into the plugin's own cells, the band's flag consumed, and the record stands on
// offer (the face's notice). The user's patterns are not touched. No record (an older kit, a kit saved with an empty
// sequencer) offers nothing.
function seq_kit_adopt() local(_ka_n, _ka_k) (
  seq_kit_adopt_req = 0;
  seq_kit_pend_n = 0;
  gmem[EON_SEQ_KIT_BASE] > 0.5 ? (
    gmem[EON_SEQ_KIT_BASE] = 0;
    _ka_n = gmem[EON_SEQ_KIT_BASE + 2] | 0;
    gmem[EON_SEQ_KIT_BASE + 1] >= 1 && _ka_n > 0 && _ka_n <= EON_SEQ_KIT_CAP && seq_kit_pend > 0 ? (
      _ka_k = 0; loop(_ka_n, seq_kit_pend[_ka_k] = gmem[EON_SEQ_KIT_BASE + 8 + _ka_k]; _ka_k += 1; );
      seq_kit_pend_gen += 1; seq_kit_offered += 1;
      seq_kit_pend_n = _ka_n;   // LAST: the face shows the offer
    );
  );
);
// The face's answer to an offer (@block, before the adopt and the walk): USE replaces the patterns, DISMISS drops the
// offer; either only for the offer the face saw (a newer one stays).
function seq_kit_ui_tick() (
  seq_kit_ui_gen == seq_kit_pend_gen && seq_kit_pend_n > 0 ? (
    seq_kit_ui_act == 1 ? seq_kit_apply() : seq_kit_ui_act == 2 ? seq_kit_pend_n = 0;
  );
  seq_kit_ui_ack = seq_kit_ui_req;
);
