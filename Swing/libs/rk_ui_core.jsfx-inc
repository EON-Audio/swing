// ============================================================================
// rk_ui_core.jsfx-inc — ReaKit UI core: the per-frame contract, the palette,
//   the state allocator, and the panel chrome every ReaKit widget draws on.
//
//   (c) EON Studios. Part of ReaKit, released under the MIT License — see
//   ReaKit/LICENSE. Free to use in your own JSFX, commercial or not.
//
//   WHY THIS FILE EXISTS
//   The knob/slider libraries have always required ~10 globals to be set at the
//   top of every @gfx (mx, my, LMB, lmb_down, CTRL, SHIFT, dt, hv_speed,
//   frame_wheel, tau) plus the prev_* latches at the bottom. Every EON plugin
//   carried its own copy of that preamble, and every third-party plugin had to
//   reverse-engineer it out of one. rk_frame_begin() / rk_frame_end() are that
//   preamble, once, with the two non-obvious bits folded in: the embedded
//   stale-wheel-position workaround, and embed click-through re-arm.
//
//   MINIMUM PLUGIN
//     @init
//       import libs/rk_ui_core.jsfx-inc
//       rk_mem_init(freemem);              // hand the kit its memory
//       my_knob = rk_widget_mem();         // 16 slots per widget, once
//     @gfx 600 400
//       rk_frame_begin(600, 400);          // design size -> rk_sc
//       ... widgets ...
//       rk_frame_end();
//
//   WHAT rk_frame_begin() PUBLISHES (all globals, all read by the widget libs):
//     mx, my            mouse position (wheel-frame corrected when embedded)
//     LMB, RMB          button state; lmb_down/rmb_down/lmb_up are edges
//     CTRL, SHIFT, ALT  modifier state (CTRL = fine adjust by convention)
//     dt                frame delta, clamped to 50ms so a stalled UI can't jump
//     hv_speed          hover animation rate (11 = the house feel)
//     frame_wheel       wheel notches this frame (+1 / -1 per detent)
//     tau               2*pi, because knobs_kbsg wants it
//     rk_W, rk_H        gfx_w, gfx_h
//     rk_ret            retina/HiDPI factor (>= 1)
//     rk_micro          1 when embedded in a track panel / MCP strip
//     rk_sc             the one scale factor to multiply every dimension by
//     rk_key            this frame's gfx_getchar() (drained once, for you)
//     rk_live           0 while an overlay owns the input (see rk_modal)
// ============================================================================

@init

__rk_ui_core_loaded = 1;

// Widget state block size. Same 16-slot convention as knobs_kbsg/sliders_kbsg,
// so a ReaKit widget's memory and a KBSG widget's memory are interchangeable:
//   [0] hover_t   [1] dragging   [2] drag_ref   [3] drag_start_val
//   [4] last_click_time          [5] settled (value changed this frame)
//   [6] active (hover or drag)   [7] aux        [8..15] widget-specific
RK_SLOTS = 16;

// Theme-bridge addresses — the same gmem block rk_theme.jsfx-inc publishes.
// Mirrored (not imported) so this file stands alone in a plugin that has no
// interest in EON's theme bridge. Same values, so importing both is harmless.
RK_GS_ID   = 2649;   // 0 = no bridge -> the built-in palette below is used
RK_GS_BASE = 2650;   // 8 semantic colours x 3 floats

// ─────────────────────────────────────────────────────────────────────────────
// PALETTE — 8 semantic slots, the same ones the EON theme bridge publishes:
//   0 BG   1 PANEL   2 TEXT   3 TEXT_DIM   4 ACCENT   5 ACCENT2   6 WARN
//   7 BORDER
// Defaults are a neutral dark console, so a plugin that never touches a theme
// still looks deliberate. rk_pal_adopt() takes the live EON theme when the
// bridge is running and leaves your colours alone when it isn't.
// ─────────────────────────────────────────────────────────────────────────────

rk_pal = 0;   // filled by rk_mem_init (needs 24 floats)

function rk_pal_set(slot, r, g, b) (
  rk_pal[slot * 3] = r; rk_pal[slot * 3 + 1] = g; rk_pal[slot * 3 + 2] = b;
);

function rk_pal_dark() (
  rk_pal_set(0, 0.090, 0.094, 0.110);   // BG       faceplate
  rk_pal_set(1, 0.135, 0.140, 0.160);   // PANEL    raised surface
  rk_pal_set(2, 0.930, 0.935, 0.950);   // TEXT     primary ink
  rk_pal_set(3, 0.555, 0.575, 0.615);   // TEXT_DIM labels, units
  rk_pal_set(4, 0.310, 0.680, 0.900);   // ACCENT   values, fills, active
  rk_pal_set(5, 0.900, 0.520, 0.220);   // ACCENT2  bipolar negative, alt state
  rk_pal_set(6, 0.950, 0.300, 0.280);   // WARN     clip, overload, danger
  rk_pal_set(7, 0.300, 0.320, 0.380);   // BORDER   hairlines, outlines
);

// Adopt the live EON theme band when the bridge is up; no-op when it isn't.
// Call once per frame, right after rk_frame_begin(), if you want theme support.
function rk_pal_adopt() local(i) (
  gmem[RK_GS_ID] > 0 ? (
    i = 0;
    loop(8,
      rk_pal_set(i, gmem[RK_GS_BASE + i * 3],
                    gmem[RK_GS_BASE + i * 3 + 1],
                    gmem[RK_GS_BASE + i * 3 + 2]);
      i += 1;
    );
  );
);

// gfx_set() straight from a palette slot.
function rk_col(slot, a) (
  gfx_set(rk_pal[slot * 3], rk_pal[slot * 3 + 1], rk_pal[slot * 3 + 2], a);
);

// Palette slot -> rk_cr/rk_cg/rk_cb, for when you need the numbers themselves
// (passing a knob its cap colour, mixing, drawing a gradient by hand).
function rk_pal_get(slot) (
  rk_cr = rk_pal[slot * 3]; rk_cg = rk_pal[slot * 3 + 1]; rk_cb = rk_pal[slot * 3 + 2];
);

// Slot colour lightened (t > 0) or darkened (t < 0) — the standard way to get
// a hover state, a recess, or a bevel out of one themed colour.
function rk_col_lift(slot, t, a) local(r, g, b) (
  r = rk_pal[slot * 3]; g = rk_pal[slot * 3 + 1]; b = rk_pal[slot * 3 + 2];
  t > 0 ? (
    gfx_set(r + (1 - r) * t, g + (1 - g) * t, b + (1 - b) * t, a);
  ) : (
    gfx_set(r * (1 + t), g * (1 + t), b * (1 + t), a);
  );
);

// ─────────────────────────────────────────────────────────────────────────────
// MEMORY — one bump allocator for every widget's state block.
// rk_mem_init(freemem) once in @init, then rk_widget_mem() per widget, also in
// @init. Never call rk_widget_mem() from @gfx: it would hand out a fresh block
// every frame and the widget would forget it was being dragged.
// ─────────────────────────────────────────────────────────────────────────────

function rk_alloc(n) local(p) (
  p = rk_mem_ptr;
  memset(p, 0, n);
  rk_mem_ptr += n;
  p;
);

function rk_widget_mem() ( rk_alloc(RK_SLOTS); );

// Returns the new top of memory — assign it back to your own allocation
// cursor: freemem = rk_mem_init(freemem);
function rk_mem_init(base) (
  rk_mem_ptr = base;
  rk_pal = rk_alloc(24);
  rk_pal_dark();
  rk_mem_ptr;
);

// ─────────────────────────────────────────────────────────────────────────────
// GEOMETRY / MATH
// ─────────────────────────────────────────────────────────────────────────────

function rk_clamp(x, lo, hi) ( min(max(x, lo), hi); );
function rk_lerp(a, b, t)    ( a + (b - a) * t; );
function rk_norm(v, lo, hi)  ( (v - lo) / max(0.0000001, hi - lo); );
function rk_denorm(t, lo, hi) ( lo + t * (hi - lo); );
function rk_hit(x, y, w, h)  ( mx >= x && mx < x + w && my >= y && my < y + h; );

// px(n): a design-space measurement in real pixels, never smaller than 1.
function rk_px(n) ( max(1, floor(n * rk_sc)); );

// ─────────────────────────────────────────────────────────────────────────────
// SHARED INTERACTION PRIMITIVES
// Every ReaKit widget animates hover the same way and claims the pointer the
// same way, which is most of why controls from different libraries feel like
// one instrument.
// ─────────────────────────────────────────────────────────────────────────────

// Advance mem[0] toward 1 while `over`, toward 0 otherwise. Returns hover_t.
function rk_hover(mem, over) (
  over ? (
    mem[0] = min(mem[0] + dt * hv_speed, 1);
  ) : (
    mem[0] = max(mem[0] - dt * hv_speed, 0);
  );
  mem[6] = over;
  mem[0];
);

// Tell the frame that something under the pointer is interactive. Embedded UIs
// use this to decide whether the click belongs to the plugin or should fall
// through to REAPER's track panel.
function rk_claim(active) ( active ? ( rk_hot = 1; ); );

// ─────────────────────────────────────────────────────────────────────────────
// AUTOMATION-SAFE WRITES
//
// The rule, and the whole reason a ReaKit control can be trusted with a
// parameter: the widget never writes anything. It RETURNS a value; you compare,
// assign to the slider's own variable, and tell the host. Named sliders make
// the variable and the parameter the same thing:
//
//   slider3:grain_size=40<1,500,0.1>Grain Size (ms)
//
//   nv = rk_knob_interact(...);                    // or any rk_*_interact
//   nv != grain_size ? ( grain_size = nv; rk_automate(3); recalc(); );
//
// Writing the variable without rk_automate() leaves the host's automation lane
// and any control surface stale; calling rk_automate() every frame instead of
// on change spams the undo history. The compare is the contract.
// ─────────────────────────────────────────────────────────────────────────────

function rk_automate(idx) ( slider_automate(2 ^ (idx - 1)); );

// Several parameters at once: rk_automate_mask(2^0 | 2^4) after a preset load,
// an X/Y drag that moved two sliders, or a section reset.
function rk_automate_mask(mask) ( slider_automate(mask); );

// ─────────────────────────────────────────────────────────────────────────────
// TEXT
// Font slots 9/10/11 are reserved for the kit so they never fight a host's own
// gfx_setfont() indices. Sizes are already scaled — pass design pixels.
// ─────────────────────────────────────────────────────────────────────────────

function rk_font(size, bold) (
  bold ? ( gfx_setfont(9, "Arial", max(7, floor(size * rk_sc)), 'b'); )
       : ( gfx_setfont(10, "Arial", max(7, floor(size * rk_sc))); );
);

// Left-aligned at (x, y).
function rk_text(x, y, txt) (
  gfx_x = x; gfx_y = y; gfx_drawstr(txt);
);

// Centred on cx, top at y.
function rk_text_c(cx, y, txt) local(tw, th) (
  gfx_measurestr(txt, tw, th);
  gfx_x = cx - tw * 0.5; gfx_y = y;
  gfx_drawstr(txt);
);

// Right-aligned, right edge at rx.
function rk_text_r(rx, y, txt) local(tw, th) (
  gfx_measurestr(txt, tw, th);
  gfx_x = rx - tw; gfx_y = y;
  gfx_drawstr(txt);
);

// Centred in the box (x, y, w, h) — the label form most widgets want.
function rk_text_box(x, y, w, h, txt) local(tw, th) (
  gfx_measurestr(txt, tw, th);
  gfx_x = x + (w - tw) * 0.5; gfx_y = y + (h - th) * 0.5;
  gfx_drawstr(txt);
);

// ─────────────────────────────────────────────────────────────────────────────
// CHROME — the surfaces widgets sit on.
// ─────────────────────────────────────────────────────────────────────────────

// Filled rounded rect. JSFX has no filled gfx_roundrect, so: body rect plus
// corner circles, then the outline. rad in real pixels.
function rk_fill_round(x, y, w, h, rad) (
  x = floor(x); y = floor(y); w = floor(w); h = floor(h); rad = floor(rad);
  rad = min(rad, min(w, h) * 0.5);
  gfx_rect(x + rad, y, w - rad * 2, h);
  gfx_rect(x, y + rad, rad, h - rad * 2);
  gfx_rect(x + w - rad, y + rad, rad, h - rad * 2);
  gfx_circle(x + rad, y + rad, rad, 1, 1);
  gfx_circle(x + w - rad - 1, y + rad, rad, 1, 1);
  gfx_circle(x + rad, y + h - rad - 1, rad, 1, 1);
  gfx_circle(x + w - rad - 1, y + h - rad - 1, rad, 1, 1);
);

// The faceplate: background wash plus the light-from-above sheen that stops a
// flat fill from reading as a hole.
function rk_backdrop() (
  rk_col(0, 1);
  gfx_rect(0, 0, rk_W, rk_H);
  gfx_set(1, 1, 1, 0.03);
  gfx_rect(0, 0, rk_W, floor(rk_H * 0.34));
);

// A raised panel: PANEL fill, BORDER hairline, top bevel.
function rk_panel(x, y, w, h, rad) (
  gfx_set(0, 0, 0, 0.25);
  rk_fill_round(x + 1, y + 2, w, h, rad);           // drop shadow
  rk_col(1, 1);
  rk_fill_round(x, y, w, h, rad);
  rk_col_lift(1, 0.12, 0.55);
  gfx_line(x + rad, y + 1, x + w - rad - 1, y + 1);  // bevel
  rk_col(7, 0.55);
  gfx_roundrect(floor(x), floor(y), floor(w) - 1, floor(h) - 1, floor(rad), 1);
);

// A panel with a title strip — the section container for a GRAIN / MOTION /
// DELAY block. Returns the y of the first free pixel INSIDE the section, so
// layout code can chain: cy = rk_section(x, y, w, h, "GRAIN", 10);
function rk_section(x, y, w, h, title, fontsz) local(hh) (
  rk_panel(x, y, w, h, rk_px(5));
  hh = rk_px(fontsz + 9);
  rk_col_lift(1, -0.25, 1);
  gfx_rect(floor(x) + 1, floor(y) + 1, floor(w) - 2, hh - 1);
  rk_col(7, 0.45);
  gfx_line(x + 1, y + hh, x + w - 2, y + hh);
  rk_font(fontsz, 1);
  rk_col(3, 0.95);
  rk_text(floor(x) + rk_px(8), floor(y) + floor((hh - rk_px(fontsz)) * 0.5) - 1, title);
  floor(y) + hh + rk_px(4);
);

// Engraved hairline — a dark line with a light one under it.
function rk_sep_h(x, y, w) (
  gfx_set(0, 0, 0, 0.45); gfx_rect(x, y, w, 1);
  gfx_set(1, 1, 1, 0.05); gfx_rect(x, y + 1, w, 1);
);

function rk_sep_v(x, y, h) (
  gfx_set(0, 0, 0, 0.45); gfx_rect(x, y, 1, h);
  gfx_set(1, 1, 1, 0.05); gfx_rect(x + 1, y, 1, h);
);

// LED value window — recessed black slot, coloured text, thin surround. The
// house readout: a number that reads as an instrument's display, not a label.
function rk_readout(cx, y, w, h, txt, r, g, b) local(tw, th) (
  gfx_set(0, 0, 0, 0.50);
  gfx_rect(cx - w * 0.5, y, w, h);
  gfx_set(r, g, b, 0.25);
  gfx_rect(cx - w * 0.5, y, w, h, 0);
  gfx_setfont(11, "Arial", max(8, floor(h * 0.62)), 'b');
  gfx_measurestr(txt, tw, th);
  gfx_set(r, g, b, 0.95);
  gfx_x = cx - tw * 0.5; gfx_y = y + floor((h - th) * 0.5);
  gfx_drawstr(txt);
);

// Readout in the accent colour, which is what you want nine times in ten.
function rk_readout_a(cx, y, w, h, txt) (
  rk_pal_get(4);
  rk_readout(cx, y, w, h, txt, rk_cr, rk_cg, rk_cb);
);

// ─────────────────────────────────────────────────────────────────────────────
// TOOLTIPS
// rk_widgets.jsfx-inc has always had a hint QUEUE (updateHintTime) and no
// renderer — the strings went nowhere. This is the renderer: arm a tip against
// any rectangle, and rk_frame_end() draws it on top after a dwell, clamped
// inside the window.
//
//   rk_knob_interact(...);
//   rk_tip(kx - kr, ky - kr, kr * 2, kr * 2, "Grain size — CTRL for fine");
// ─────────────────────────────────────────────────────────────────────────────

#rk_tip_s = "";

function rk_tip(x, y, w, h, txt) (
  rk_hit(x, y, w, h) ? (
    rk_tip_have = 1;
    strcpy(#rk_tip_s, txt);
  );
);

function rk_tips_draw() local(tw, th, bx, by, bw, bh, pad) (
  // Dwell: the pointer must sit still on the same target. Any real movement
  // restarts the clock, so tips never chase a moving cursor.
  (abs(mx - rk_tip_lx) + abs(my - rk_tip_ly)) > 1 ? ( rk_tip_t = 0; );
  rk_tip_lx = mx; rk_tip_ly = my;
  rk_tip_have ? ( rk_tip_t = min(rk_tip_t + dt, 1); ) : ( rk_tip_t = 0; );

  (rk_tip_have && rk_tip_t > 0.45 && !LMB) ? (
    gfx_setfont(10, "Arial", max(8, floor(10 * rk_sc)));
    gfx_measurestr(#rk_tip_s, tw, th);
    pad = rk_px(5);
    bw = tw + pad * 2; bh = th + pad * 2;
    bx = rk_clamp(mx + rk_px(12), 2, rk_W - bw - 2);
    by = ((my + rk_px(18) + bh) > rk_H) ? (my - rk_px(6) - bh) : (my + rk_px(18));
    by = rk_clamp(by, 2, rk_H - bh - 2);
    gfx_set(0, 0, 0, 0.45);
    gfx_rect(bx + 1, by + 2, bw, bh);
    rk_col_lift(1, 0.10, 0.97);
    gfx_rect(bx, by, bw, bh);
    rk_col(7, 0.85);
    gfx_rect(bx, by, bw, bh, 0);
    rk_col(2, 0.97);
    gfx_x = bx + pad; gfx_y = by + pad;
    gfx_drawstr(#rk_tip_s);
  );
);

// ─────────────────────────────────────────────────────────────────────────────
// THE FRAME
// ─────────────────────────────────────────────────────────────────────────────

// design_w/design_h: the window size your layout was drawn for. rk_sc is the
// factor that maps it onto the real window (and onto rk_ret when embedded).
// Pass 0, 0 to opt out and get rk_sc = rk_ret.
function rk_frame_begin(design_w, design_h) local(now) (
  rk_key = gfx_getchar();
  rk_W = gfx_w; rk_H = gfx_h;
  rk_micro = gfx_ext_flags & 1;
  rk_ret = max(1, gfx_ext_retina);
  rk_sc = (design_w > 0 && design_h > 0) ?
            (rk_micro ? rk_ret : max(0.7, min(rk_W / design_w, rk_H / design_h)))
          : rk_ret;

  mx = mouse_x; my = mouse_y;
  LMB = mouse_cap & 1;
  RMB = mouse_cap & 2;
  lmb_down = LMB && !prev_LMB;
  lmb_up   = !LMB && prev_LMB;
  rmb_down = RMB && !prev_RMB;
  CTRL  = mouse_cap & 4;
  SHIFT = mouse_cap & 8;
  ALT   = mouse_cap & 16;

  now = time_precise();
  dt = min(now - rk_last_t, 0.05);
  rk_last_t = now;
  hv_speed = 11;
  frame_wheel = mouse_wheel / 120;
  tau = 2 * $pi;

  // Embedded UIs get wheel events with a stale (often zero) mouse position, so
  // every hover test misses and the wheel does nothing. Remember the pointer on
  // ordinary frames and reuse it on wheel frames.
  rk_micro ? (
    frame_wheel == 0 ? ( rk_hmx = mx; rk_hmy = my; )
                     : ( mx = rk_hmx; my = rk_hmy; );
  );

  // Take clicks this frame; rk_frame_end() gives them back if nothing was hit.
  rk_micro ? ( gfx_ext_flags = (gfx_ext_flags | 0x200) - 0x200; );

  rk_hot = 0;
  rk_tip_have = 0;
  // Input is dead for ordinary controls while an overlay (a dropdown list) is
  // open, so a click meant for the list can't also land on whatever it covers.
  // The kit's own widgets honour this without the caller doing anything; see
  // rk_modal in rk_ui_widgets.jsfx-inc.
  rk_live = rk_modal ? 0 : 1;
);

// Draws the tooltip layer, latches the edge-detect state, consumes the wheel,
// and re-arms embed click-through when the pointer isn't over a control.
// Anything you want painted ON TOP of tooltips must be drawn after this.
function rk_frame_end() (
  rk_tips_draw();
  // Overlay layers (rk_ui_widgets' dropdowns) raise rk_modal_acc while open.
  // Publishing it here means input drawn EARLY next frame can be gated on an
  // overlay opened LATE this frame — see rk_modal in rk_ui_widgets.jsfx-inc.
  rk_modal = rk_modal_acc;
  rk_modal_acc = 0;
  prev_LMB = LMB;
  prev_RMB = RMB;
  mouse_wheel = 0;
  rk_micro && !rk_hot ? ( gfx_ext_flags |= 0x200; );
);
