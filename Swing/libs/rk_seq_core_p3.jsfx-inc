);
// The stream's size in cells as seq_srz_tagged(_sc_from) writes it: the count word, then each tag's two words and its body.
function seq_srz_count_all(_sc_from) local(_sc_n) (
  _sc_n = 1;
  _sc_from <= 0 ? _sc_n += 2 + SEQ_SRZ_SET_N;
  _sc_from <= 1 ? _sc_n += 2 + seq_srz_count_pats();
  _sc_from <= 2 ? _sc_n += 2 + seq_srz_count_notes();
  _sc_from <= 3 ? _sc_n += 2 + seq_srz_count_meta();
  _sc_n;
);
// The whole gate. Called by the host inside `ser_ver >= 78 ? ...` in both directions; the host's
// `is_read && ser_ver < 78` backfill is seq_clear_all. A write is always the tagged stream (ser_ver 79); a read
// takes the file's own gate: 79 tagged, 78 the positional body (seq_srz_body78, then the W conversion).
function seq_serialize() local(_ss_ok) (
  seq_io[0] = 0; seq_io[4] = is_read ? 1 : 0;   // channel 0: the project file, @serialize's alone
  is_read ? ( seq_clear_all(); seq_meta_clear_all(); seq_npat = 1; seq_ui_undo_wait = 0; );   // whatever the stream does not carry is empty, never the
                                                        // previous project's; and a read IS the state REAPER wants (an
                                                        // undo, a load): a point still pending for an edit before it
                                                        // would capture this state and drop the redo history (self-audit
                                                        // 2026-10-20 finding 9)
  is_read && ser_ver < 79 ? (
    seq_srz_body78(0);
    seq_srz_convert_78();
  ) : (
    _ss_ok = seq_srz_tagged(0, 0);
    is_read && !_ss_ok ? seq_srz_bad = 1;
  );
  is_read ? seq_npat_fix();   // round two H: an older stream has no count (a 78 file none at all -- only the tagged branch fixed it until audit K15); never below the last used pattern
  // An older file kept mute and solo per PATTERN (lane fields 4 / 5): the pattern it opens on gives the lanes theirs, the
  // way the user last heard it (the polish pass, 2026-10-20: "if the pattern changes the solos and mute changes").
  is_read && !seq_gms_srz ? seq_gms_migrate(seq_cur);
);

// ─── S3c: the patterns in a kit file (Spec_Swing_Seq_View decision 23, the plan's S3c; 2026-10-20) ─────────────────
// A whole-kit SAVE publishes the tagged stream from tag 1 (PATTERNS, NOTES, META -- no settings; SONG too until D9) into the EON_SEQ_KIT
// band and the bridge packs it as the kit file's tail record 7 (eon_seq_pack); a whole-kit LOAD stages it back
// (eon_seq_stage) and the plugin adopts it. The band: +0 the bridge's staged flag (written last, cleared on adopt),
// +1 the record's version, +2 the cells the publisher wrote (0 = no record: an empty sequencer or a bank-only save;
// -1 = refused, too big for the band: the kit is saved without, the face says so), +3 the overflow in cells when
// refused, +8.. the cells. One band for every instance: the kit bus's LOCK serializes a save and a load, the KMAC_KIT
// discipline. Both ends run in @block, the walk's thread (the patterns are its): seq_kit_pub_req (the export's state
// 11 asks by bumping it, with seq_kit_pub_only the kind; state 12 hands the bus over once seq_kit_pub_ack, @block's
// own cell, meets it -- one writer a cell) and seq_kit_adopt_req (the import's bank A pass, @block's) are the
// requests the host's @block answers right before the walk; rk_swing_ui_state is imported before this file.
seq_kit_pub_req = 0; seq_kit_pub_ack = 0; seq_kit_pub_only = 0;   // the request counter (@gfx's), its ack (@block's), the kind
seq_kit_adopt_req = 0;                                           // @block's alone (the import tick asks, the host answers)
seq_kit_last = 0; seq_kit_over = 0;   // the last publish: cells written, 0 none, -1 refused (seq_kit_over cells too many)
seq_kit_pubs = 0;                     // bumped per publish: the face says when one was refused
seq_kit_adopted = 0;                  // bumped per adopt: the face says so and makes the undo point
// FU-P (2026-10-26; the owner's decision on SQ-K question 1, the stricter version: "when you play the pattern and change
// the kit, the pattern keeps playing"): a kit load NEVER changes the user's patterns, the song, the names / colours or
// the pattern on screen -- not even an empty sequencer's. A whole-kit load whose kit CARRIES patterns only puts them ON
// OFFER, in the plugin's own copy (seq_kit_pend, EON_SEQ_KIT_CAP cells the host claims; the gmem band is one for every
// instance and the next save or load writes it), until the face's one click uses them, the user dismisses the offer, or
// the next whole-kit load replaces it. The copy is @block's alone; it is never saved: a reopen (or an @init re-run)
// drops the offer. The face asks through seq_kit_ui_req (its counter, bumped LAST after seq_kit_ui_act -- 1 use, 2
// dismiss -- and seq_kit_ui_gen, the offer it answers); @block answers in seq_kit_ui_tick and acks.
seq_kit_pend = 0;        // the copy's base (seq_kit_pend_init; 0 = the host claimed none: a kit's record is then dropped)
seq_kit_pend_n = 0;      // cells on offer (0 = no offer); written LAST when an offer is made, the face shows it while > 0
seq_kit_pend_gen = 0;    // bumped per offer: a click answers the offer it saw, never a newer one
seq_kit_offered = 0;     // bumped per offer (the tests' and the rig's count)
seq_kit_ui_req = 0; seq_kit_ui_act = 0; seq_kit_ui_gen = 0;   // @gfx's
seq_kit_ui_ack = 0;                                          // @block's
function seq_kit_pend_init(_kq_base) ( seq_kit_pend = _kq_base; seq_kit_pend_n = 0; );
// Is there anything for a kit's record? A used pattern (the song chain is not written since D9, so its length -- always
// 0: nothing fills it -- is no longer asked).
function seq_any_used() local(_au_p, _au_u) (
  _au_u = 0; _au_p = 0;
  loop(SEQ_PATS, !_au_u && seq_pat_used(_au_p) ? _au_u = 1; _au_p += 1; );
  _au_u;
);
// The patterns and the song back to empty: a kit's record arrives into a clean slate; the settings stay the project's.
function seq_kit_clear() local(_kc_p) (
  _kc_p = 0; loop(SEQ_PATS, seq_clear_pattern(_kc_p); _kc_p += 1; );
  seq_meta_clear_all();   // round two H: the names and colours are the kit's too
  memset(seq_song, 0, SEQ_SONG_MAX * 2);
  seq_song_len = 0; seq_song_loop = 0; seq_song_pos = 0;
  // the pattern on screen: back to 1 when stopped; while the transport plays it KEEPS its number (FU-P, the owner: never
  // jump the playing pattern mid-play) -- the walkers restart on that number's new content, in phase with the timeline
  !(play_state & 1) ? seq_cur = 0;   // (the page: the face clamps it to the pattern on screen)
);
// The publish (@block, the block after the export's state 11 asks): _kp_only = a bank-only save or a bank pass of the
// whole-kit walk, which carry no patterns (the walk's final pass is bank A's: that one carries them).
function seq_kit_publish() local(_kp_n, _kp_w, _kp_b, _kp_only) (
  _kp_only = seq_kit_pub_only;
  gmem[EON_SEQ_KIT_BASE + 1] = 1; gmem[EON_SEQ_KIT_BASE + 3] = 0; seq_kit_over = 0;
  _kp_only || !seq_any_used() ? ( gmem[EON_SEQ_KIT_BASE + 2] = 0; seq_kit_last = 0; ) : (
    _kp_n = seq_srz_count_all(1);
    _kp_n > EON_SEQ_KIT_CAP ? (
      gmem[EON_SEQ_KIT_BASE + 2] = -1; gmem[EON_SEQ_KIT_BASE + 3] = _kp_n - EON_SEQ_KIT_CAP;
      seq_kit_last = -1; seq_kit_over = _kp_n - EON_SEQ_KIT_CAP;
    ) : (
      _kp_b = seq_io + SEQ_IO_F;   // channel 1: the band, written
      _kp_b[0] = 1; _kp_b[1] = EON_SEQ_KIT_BASE + 8; _kp_b[2] = EON_SEQ_KIT_BASE + 8 + EON_SEQ_KIT_CAP; _kp_b[3] = 0; _kp_b[4] = 0;
      seq_srz_tagged(1, 1);
      _kp_w = _kp_b[1] - (EON_SEQ_KIT_BASE + 8);
      _kp_b[3] || _kp_w != _kp_n ? (   // the count and the write disagree: refused rather than a short record
        gmem[EON_SEQ_KIT_BASE + 2] = -1; gmem[EON_SEQ_KIT_BASE + 3] = max(1, _kp_w - EON_SEQ_KIT_CAP);
        seq_kit_last = -1; seq_kit_over = max(1, _kp_w - EON_SEQ_KIT_CAP);
      ) : ( gmem[EON_SEQ_KIT_BASE + 2] = _kp_w; seq_kit_last = _kp_w; );
    );
  );
  seq_kit_pubs += 1;
  seq_kit_pub_ack = seq_kit_pub_req;   // LAST: the export's state 12 hands the bus to the bridge once the ack meets the request
);
