            _sn_l = _sn_a % 16; _sn_s = floor(_sn_a / 16) % 64; _sn_q = floor(_sn_a / 1024);
            _sn_nb = seq_note_at(_sn_p, _sn_l, _sn_s); _sn_k = 0;
