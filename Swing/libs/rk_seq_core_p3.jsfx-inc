// rk_seq_core_p3.jsfx-inc -- part 3 of rk_seq_core.jsfx-inc (4 parts), cut at a function boundary by
// .dev_tests/split_big_incs.py: REAPER's load time grows with the square of a file's size. Edit freely;
// keep each file under about 40 KB.

// ⚠️ @init IS LOAD-BEARING (.docs/wiki/02-file-structure.md).
@init

// ─── The project save: the body of serialize gate 78 (spec 8) ───────────────
// Sparse in both axes. Header (the instance's settings, fixed scalars with two spares), the song chain
// (a count, then the slots), the pattern count, then per pattern a used flag; a used pattern carries its
// record, its sixteen lane records and, per lane, a count of switched-on steps followed by that many
// (step, word A, word B) triples. Presence in the list is "on". Word A = vel | prob<<7 | (ratchet-1)<<14 |
// tie<<16 | acc<<18 | rsub_follows<<19; word B = (nudge+50) | (pitch+48)<<7 | (pan+100)<<14 | cond<<22:
// both below 2^24, exact in the stream's 32-bit floats. rsub_follows = the roll's three sub-velocities
// follow the triple (S2 writes them when any is set; S1 never did and skipped them on read). Every count
// meets a STATIC bound before any file_mem or loop (wiki 3.5); a count past its bound ends the read --
// nothing after it in this gate is touched, so the reader never walks the stream out of alignment. file_var
// itself writes only seq_io_tmp (through seq_io_var, @serialize's channel 0); the seq_srz_* scratch scalars and
// the counters are locals of the functions that use them (seq_srz_bad, a diagnostic flag, is the one global).
function seq_pack_a(_pa_b, _pa_rs) (
  (max(1, min(127, _pa_b[1] | 0))) | ((max(0, min(100, _pa_b[2] | 0))) << 7)
    | ((max(0, min(3, (_pa_b[3] | 0) - 1))) << 14) | ((max(0, min(2, _pa_b[4] | 0))) << 16)
    | ((_pa_b[8] ? 1 : 0) << 18) | ((_pa_rs ? 1 : 0) << 19);
);
function seq_pack_b(_pb_b) (
  (max(0, min(100, (_pb_b[5] | 0) + 50))) | ((max(0, min(96, (_pb_b[6] | 0) + 48))) << 7)
    | ((max(0, min(200, (_pb_b[7] | 0) + 100))) << 14) | ((max(0, min(3, _pb_b[9] | 0))) << 22);
);
function seq_unpack(_up_b, _up_a, _up_w) (
  _up_a = _up_a | 0; _up_w = _up_w | 0;
  _up_b[1] = max(1, _up_a & 127); _up_b[2] = (_up_a >> 7) & 127; _up_b[3] = ((_up_a >> 14) & 3) + 1;
  _up_b[4] = (_up_a >> 16) & 3; _up_b[8] = (_up_a >> 18) & 1;
  _up_b[5] = (_up_w & 127) - 50; _up_b[6] = ((_up_w >> 7) & 127) - 48; _up_b[7] = ((_up_w >> 14) & 255) - 100;
  _up_b[9] = (_up_w >> 22) & 3;
  _up_b[0] = 1;   // last: the walker reads a whole step once it sees the flag
);
// ─── The stream's channel (S3c): the project file, or a gmem band for a kit's record ─────────────────────────────────
// Every serialize function reads and writes through these two, so the SAME code packs the project chunk (@serialize:
// file_var / file_mem) and the kit record (a band: EON_SEQ_KIT). Each channel keeps its state in its own cells of
// seq_io (SEQ_IO_F a channel: 0 mode -- 0 the file, 1 a band written, 2 a band read; 1 the next cell; 2 one past the
// band's end; 3 over -- a write past the end was refused, a read past it read 0; 4 reading) and every serialize function
// takes the channel (_ch): channel 0 is @serialize's alone, channel 1 the kit record's (@block), so the two never share
// a cell -- wiki 4.1: @serialize runs beside the audio thread, unmutexed. The functions' own counts are locals.
// Cell 5 counts the cells the channel has moved, either way (audit K14, 2026-10-26): the tagged reader holds every tag
// to its stated length by it (seq_srz_tagged).
SEQ_IO_F = 8;
seq_io_tmp = 0;   // the file channel's file_var cell (an lvalue: @serialize's alone)
function seq_io_rd(_ir_c) ( seq_io[_ir_c * SEQ_IO_F + 4]; );
// Mode 3 (FU-P, 2026-10-26): the kit's record read back from the plugin's own copy (seq_kit_pend, cells 1 and 2 are
// indices into it, not gmem addresses) -- a kit's patterns kept on offer while the user's stay.
function seq_io_var(_iv_v, _iv_c) local(_iv_b) (
  _iv_b = seq_io + _iv_c * SEQ_IO_F;
  _iv_b[5] += 1;
  _iv_b[0] == 0 ? ( seq_io_tmp = _iv_v; file_var(0, seq_io_tmp); seq_io_tmp )
  : _iv_b[0] == 1 ? ( _iv_b[1] < _iv_b[2] ? gmem[_iv_b[1]] = _iv_v : _iv_b[3] = 1; _iv_b[1] += 1; _iv_v )
  : ( _iv_b[1] < _iv_b[2] ? _iv_v = (_iv_b[0] == 3 ? seq_kit_pend[_iv_b[1]] : gmem[_iv_b[1]]) : ( _iv_v = 0; _iv_b[3] = 1; ); _iv_b[1] += 1; _iv_v );
);
function seq_io_mem(_im_p, _im_n, _im_c) local(_im_b, _im_k) (
  _im_b = seq_io + _im_c * SEQ_IO_F;
  _im_b[5] += _im_n;
  _im_b[0] == 0 ? file_mem(0, _im_p, _im_n)
  : _im_b[0] == 1 ? ( _im_k = 0; loop(_im_n, _im_b[1] < _im_b[2] ? gmem[_im_b[1]] = _im_p[_im_k] : _im_b[3] = 1; _im_b[1] += 1; _im_k += 1; ); )
  : ( _im_k = 0; loop(_im_n, _im_b[1] < _im_b[2] ? _im_p[_im_k] = (_im_b[0] == 3 ? seq_kit_pend[_im_b[1]] : gmem[_im_b[1]]) : ( _im_p[_im_k] = 0; _im_b[3] = 1; ); _im_b[1] += 1; _im_k += 1; ); );
);

// Is anything in this pattern worth writing? Any switched-on step, or any lane or pattern field off its default.
// The answer is an OR, so the walk stops after the first LANE that makes the pattern used (the R2 speed pass,
// 2026-11-02; FINDINGS 2026-10-22: the chip row asks this for every chip every frame, and it read all 16 lanes' 64
// steps after the first hit). A lane's cells are still read with loop() to the lane's end: a cell-by-cell while()
// measured twice as slow per cell (ysfx), so stopping at the cell lost on an empty pattern. Each cell is tested in the
// same form as before (a truth test where it was one, > 0 for a note's pitch); only where the reads stop changed.
// r2_seq_patused_test.py holds the old one beside it, case by case. An empty pattern is still read to its end.
function seq_pat_used(p) local(_pu_l, _pu_b, _pu_lb, _pu_pb, _pu_u) (
  _pu_u = 0;
  _pu_pb = seq_pat_at(p);
  (_pu_pb[0] != SEQ_LEN_DEFAULT || _pu_pb[1] != SEQ_DIV_DEFAULT || _pu_pb[2] || _pu_pb[3] || _pu_pb[4] != SEQ_GATE_DEFAULT
    || _pu_pb[5] || _pu_pb[6] || _pu_pb[7]) ? _pu_u = 1;
  _pu_l = 0;
  while(!_pu_u && _pu_l < SEQ_LANES) (   // the lanes: their fields, then their steps
    _pu_lb = seq_lane_at(p, _pu_l);
    (_pu_lb[0] != _pu_l || _pu_lb[1] != SEQ_LEN_DEFAULT || _pu_lb[2] != SEQ_DIV_DEFAULT || _pu_lb[3] || _pu_lb[4] || _pu_lb[5]
      || _pu_lb[6] != 1 || _pu_lb[7] || _pu_lb[8] != SEQ_LSW_FOLLOW || _pu_lb[9] != -1 || _pu_lb[10] || _pu_lb[11] || _pu_lb[12]) ? _pu_u = 1;
    _pu_b = seq_step_at(p, _pu_l, 0);
    loop(SEQ_STEPS, _pu_b[0] ? _pu_u = 1; _pu_b += SEQ_ATTR; );
    _pu_l += 1;
  );
  _pu_l = 0;
  while(!_pu_u && _pu_l < SEQ_LANES) (   // S5: the notes, a lane's slots at a time (each lane's are contiguous)
    _pu_b = seq_note_at(p, _pu_l, 0);
    loop(SEQ_STEPS * SEQ_CHORD_N, _pu_b[0] > 0 ? _pu_u = 1; _pu_b += SEQ_NOTE_F; );
    _pu_l += 1;
  );
  _pu_u;
);
// The slot a duplicate lands in: the first unused pattern after p, wrapping round; -1 when every slot is used.
function seq_dup_target(_dt_p) local(_dt_k, _dt_q, _dt_hit) (
  _dt_hit = -1; _dt_k = 1;
  loop(SEQ_PATS - 1,
    _dt_q = _dt_p + _dt_k; _dt_q >= SEQ_PATS ? _dt_q -= SEQ_PATS;
    _dt_hit < 0 && !seq_pat_used(_dt_q) ? _dt_hit = _dt_q;
    _dt_k += 1;
  );
  _dt_hit;
);
// Clamp a lane record read from a file (another program's numbers). The target keeps a MIDI-channel value
// (-1..-16, phase 4b) so a later build's lane survives a round trip through this one; the walker ignores it.
function seq_srz_clamp_lane(_cl_b, _cl_l) (
  _cl_b[0] = max(-16, min(NUM_SLOTS - 1, _cl_b[0] | 0));
  _cl_b[1] = max(1, min(SEQ_STEPS, _cl_b[1] | 0)); _cl_b[2] = max(0, min(SEQ_DIV_N - 1, _cl_b[2] | 0));
  _cl_b[3] = max(-500, min(500, _cl_b[3])); _cl_b[4] = _cl_b[4] ? 1 : 0; _cl_b[5] = _cl_b[5] ? 1 : 0;
  _cl_b[6] = max(0, min(2, _cl_b[6])); _cl_b[7] = max(-1, min(1, _cl_b[7])); _cl_b[8] = max(-1, min(100, _cl_b[8] | 0));
  _cl_b[9] = max(-1, min(SEQ_LANES - 1, _cl_b[9] | 0)); _cl_b[10] = _cl_b[10] ? 1 : 0;
  _cl_b[11] = max(0, min(32, _cl_b[11] | 0)); _cl_b[12] = max(0, min(15, _cl_b[12] | 0));
);
function seq_srz_clamp_pat(_cq_b) (
  _cq_b[0] = max(1, min(SEQ_STEPS, _cq_b[0] | 0)); _cq_b[1] = max(0, min(SEQ_DIV_N - 1, _cq_b[1] | 0));
  _cq_b[2] = max(0, min(2, _cq_b[2] | 0)); _cq_b[3] = max(0, min(100, _cq_b[3])); _cq_b[4] = max(1, min(100, _cq_b[4]));
  _cq_b[5] = max(0, min(100, _cq_b[5])); _cq_b[6] = max(0, min(100, _cq_b[6])); _cq_b[7] = max(-127, min(127, _cq_b[7]));
  // field 8 (used) stays what the writer stored: nothing reads it yet, and a value the reader invents breaks the
  // round trip (the rig's checksums differed by exactly 8 * 31^3 until this read it as 1, 2026-10-19)
  _cq_b[8] = _cq_b[8] ? 1 : 0; _cq_b[10] = max(-1, min(SEQ_SRZ_PATS_MAX - 1, _cq_b[10] | 0));
);
// One pattern's body, both directions. _sp_dst < 0 = read and drop (a pattern past this build's count):
// its records land in the 64-cell scratch, its triples in the scratch scalars. Returns 1, or 0 when a
// count failed its bound (the caller then reads nothing more).
function seq_srz_pattern(_sp_dst, _ch) local(_sp_l, _sp_s, _sp_b, _sp_lb, _sp_pb, _sp_cnt, _sp_ok, _sp_k, _sp_rs, _sp_rb, seq_srz_a, seq_srz_cnt, seq_srz_s, seq_srz_w) (
  _sp_ok = 1;
  _sp_pb = _sp_dst >= 0 ? seq_pat_at(_sp_dst) : seq_srz_tmp;
  seq_io_mem(_sp_pb, SEQ_PAT_F, _ch);
  seq_io_rd(_ch) && _sp_dst >= 0 ? seq_srz_clamp_pat(_sp_pb);
  _sp_l = 0;
  while(_sp_ok && _sp_l < SEQ_LANES) (
    _sp_lb = _sp_dst >= 0 ? seq_lane_at(_sp_dst, _sp_l) : seq_srz_tmp;
    seq_io_mem(_sp_lb, SEQ_LANE_F, _ch);
    seq_io_rd(_ch) && _sp_dst >= 0 ? seq_srz_clamp_lane(_sp_lb, _sp_l);
    _sp_cnt = 0;
    !seq_io_rd(_ch) ? (
      _sp_b = seq_step_at(_sp_dst, _sp_l, 0);
      _sp_s = 0; loop(SEQ_STEPS, _sp_b[0] ? _sp_cnt += 1; _sp_b += SEQ_ATTR; _sp_s += 1; );
    );
    seq_srz_cnt = _sp_cnt;
    seq_srz_cnt = seq_io_var(seq_srz_cnt, _ch);
    seq_io_rd(_ch) ? ( _sp_cnt = seq_srz_cnt | 0; (_sp_cnt < 0 || _sp_cnt > SEQ_STEPS) ? _sp_ok = 0; );
    _sp_ok ? (
      !seq_io_rd(_ch) ? (
        _sp_s = 0; loop(SEQ_STEPS,
          _sp_b = seq_step_at(_sp_dst, _sp_l, _sp_s);
          _sp_b[0] ? (
            _sp_rb = seq_rsub_at(_sp_dst, _sp_l, _sp_s);
            _sp_rs = (_sp_rb[0] | 0) || (_sp_rb[1] | 0) || (_sp_rb[2] | 0);
            seq_srz_s = _sp_s;                      seq_srz_s = seq_io_var(seq_srz_s, _ch);
            seq_srz_a = seq_pack_a(_sp_b, _sp_rs);  seq_srz_a = seq_io_var(seq_srz_a, _ch);
            seq_srz_w = seq_pack_b(_sp_b);          seq_srz_w = seq_io_var(seq_srz_w, _ch);
            _sp_rs ? ( seq_io_mem(_sp_rb, SEQ_RSUB_N, _ch); );
          );
          _sp_s += 1;
        );
      ) : (
        _sp_k = 0; loop(_sp_cnt,
          seq_srz_s = seq_io_var(seq_srz_s, _ch); seq_srz_a = seq_io_var(seq_srz_a, _ch); seq_srz_w = seq_io_var(seq_srz_w, _ch);
          _sp_s = seq_srz_s | 0;
          _sp_dst >= 0 && _sp_s >= 0 && _sp_s < SEQ_STEPS ? seq_unpack(seq_step_at(_sp_dst, _sp_l, _sp_s), seq_srz_a, seq_srz_w);
          ((seq_srz_a | 0) & 524288) ? (
            // the roll's sub-velocities: three cells, into the step (or the scratch for a dropped pattern)
            _sp_rb = (_sp_dst >= 0 && _sp_s >= 0 && _sp_s < SEQ_STEPS) ? seq_rsub_at(_sp_dst, _sp_l, _sp_s) : seq_srz_tmp;
            seq_io_mem(_sp_rb, SEQ_RSUB_N, _ch);
            _sp_rb[0] = max(0, min(127, _sp_rb[0] | 0)); _sp_rb[1] = max(0, min(127, _sp_rb[1] | 0)); _sp_rb[2] = max(0, min(127, _sp_rb[2] | 0));
          );
          _sp_k += 1;
        );
      );
    );
    _sp_l += 1;
  );
  _sp_ok;
);
// ─── Gate 79: the TAGGED stream (P0a, 2026-10-20, decision 23) ───────────────
// `[tag, len, cells...]` sections, a count first. A reader takes the tags it knows and SKIPS the others by their
// length (a count-bounded skip), so a later build can add a section (the note pool, S5; the kit record's
// revision) without a new gate number, and a missing tag means defaults: the stream cannot desync a positional
// reader, which is what the wiki's "a new gate for every layout change, in ship order" rule exists to prevent.
// The writer states every length (a counting pass mirrors the pattern writer). Tags: 1 SETTINGS (a fixed block
// of SEQ_SRZ_SET_N cells, the spares written as 0 and ignored on read), 2 SONG, 3 PATTERNS (the sparse body as
// gate 78 wrote it). A file written by gate 78 (the user's own test projects; nothing shipped) is read by the
// 78 body below and converted: lane W (a strength of the pattern's swing) -> the lane's own swing.
// SONG is READ ONLY since 2026-10-29 (the owner's D9): nothing ever filled the chain (decision 23 made the song the
// regions' and the bridge's chain engine), so the writer no longer writes its 134 cells of zeros into every project
// save and kit record; a stream that carries it (every save before) still reads it, and one without it reads as an
// empty chain -- in an older build too (a missing tag means defaults; seq_serialize / seq_kit_apply clear first).
SEQ_SRZ_TAG_SET  = 1;
SEQ_SRZ_TAG_SONG = 2;
SEQ_SRZ_TAG_PATS = 3;
SEQ_SRZ_SET_N    = 32;      // the SETTINGS block: 27 used (19..23 the polish pass; 24-25 the roll; 26 the patterns on show, round two H: the lanes' mute and solo masks, their marker,
                            // the hidden columns, the lane order), the rest spare (read into the 64-cell scratch)
SEQ_SRZ_TAGS_MAX = 64;      // static bounds (wiki 3.5)
SEQ_SRZ_LEN_MAX  = 4000000;

// How many cells the PATTERNS body will take (mirrors seq_srz_pattern's writer exactly).
function seq_srz_count_pats() local(_cn_p, _cn_l, _cn_s, _cn_b, _cn_rb, _cn_n) (
  _cn_n = 1;   // the pattern count
  _cn_p = 0; loop(SEQ_PATS,
    _cn_n += 1;   // the used flag
    seq_pat_used(_cn_p) ? (
      _cn_n += SEQ_PAT_F;
      _cn_l = 0; loop(SEQ_LANES,
        _cn_n += SEQ_LANE_F + 1;   // the lane record and the on-step count
        _cn_b = seq_step_at(_cn_p, _cn_l, 0); _cn_rb = seq_rsub_at(_cn_p, _cn_l, 0);
        _cn_s = 0; loop(SEQ_STEPS,
          _cn_b[0] ? ( _cn_n += 3; ((_cn_rb[0] | 0) || (_cn_rb[1] | 0) || (_cn_rb[2] | 0)) ? _cn_n += SEQ_RSUB_N; );
          _cn_b += SEQ_ATTR; _cn_rb += SEQ_RSUB_N; _cn_s += 1;
        );
        _cn_l += 1;
      );
    );
    _cn_p += 1;
  );
  _cn_n;
);
// Skip _sk_n cells of a tag this build does not know (read into the scratch, 16 at a time; count-bounded).
function seq_srz_skip(_sk_n, _ch) local(_sk_k, _sk_b) (
  _sk_n = max(0, min(SEQ_SRZ_LEN_MAX, _sk_n | 0));
  _sk_b = seq_io + _ch * SEQ_IO_F;
  _sk_b[0] == 0 ? ( while(_sk_n > 0) ( _sk_k = min(16, _sk_n); seq_io_mem(seq_srz_tmp, _sk_k, _ch); _sk_n -= _sk_k; ); )
  : ( _sk_b[1] + _sk_n > _sk_b[2] ? _sk_b[3] = 1; _sk_b[1] += _sk_n; _sk_b[5] += _sk_n; );
);
// The SETTINGS block, both directions, through the scratch (64 cells; the first SEQ_SRZ_SET_N carry the block).
function seq_srz_settings(_st_len, _ch) local(_st_k) (
  !seq_io_rd(_ch) ? (
    memset(seq_srz_tmp, 0, SEQ_SRZ_SET_N);
    seq_srz_tmp[0] = seq_shown; seq_srz_tmp[1] = seq_h; seq_srz_tmp[2] = seq_view; seq_srz_tmp[3] = seq_cur;
    seq_srz_tmp[4] = seq_page; seq_srz_tmp[5] = seq_off; seq_srz_tmp[6] = seq_run; seq_srz_tmp[7] = seq_place;
    seq_srz_tmp[8] = fb_place; seq_srz_tmp[9] = fx_place; seq_srz_tmp[10] = seq_trig_mode; seq_srz_tmp[11] = seq_trig_base;
    seq_srz_tmp[12] = seq_opt_icons; seq_srz_tmp[13] = seq_opt_follow; seq_srz_tmp[14] = seq_opt_transport;
    seq_srz_tmp[15] = seq_opt_sync; seq_srz_tmp[16] = seq_opt_midiout; seq_srz_tmp[17] = seq_opt_midich;
    seq_srz_tmp[18] = seq_opt_adapt;
    seq_srz_tmp[19] = seq_gmute; seq_srz_tmp[20] = seq_gsolo; seq_srz_tmp[21] = 1; seq_srz_tmp[22] = seq_col_hide;   // the polish pass
    seq_srz_tmp[23] = seq_opt_topdown; seq_srz_tmp[24] = seq_opt_snap; seq_srz_tmp[25] = seq_opt_rollh;
    seq_srz_tmp[26] = seq_npat;   // round two H: the patterns on show
    seq_io_mem(seq_srz_tmp, SEQ_SRZ_SET_N, _ch);
  ) : (
    memset(seq_srz_tmp, 0, 64);
    _st_k = max(0, min(SEQ_SRZ_SET_N, _st_len | 0));
    _st_k > 0 ? seq_io_mem(seq_srz_tmp, _st_k, _ch);
    _st_len > _st_k ? seq_srz_skip(_st_len - _st_k, _ch);   // a later build's longer block: the rest is its own
    seq_shown = seq_srz_tmp[0] ? 1 : 0; seq_h = max(0, min(4096, seq_srz_tmp[1])); seq_view = max(0, min(6, seq_srz_tmp[2] | 0));
    seq_cur = max(0, min(SEQ_PATS - 1, seq_srz_tmp[3] | 0)); seq_page = max(0, min(3, seq_srz_tmp[4] | 0));
    seq_off = seq_srz_tmp[5] ? 1 : 0; seq_run = seq_srz_tmp[6] ? 1 : 0;
    seq_place = (seq_srz_tmp[7] >= 0 && seq_srz_tmp[7] <= 4) ? seq_srz_tmp[7] | 0 : 0;
    fb_place = (seq_srz_tmp[8] >= 0 && seq_srz_tmp[8] <= 4) ? seq_srz_tmp[8] | 0 : 0;
    fx_place = (seq_srz_tmp[9] >= 0 && seq_srz_tmp[9] <= 4) ? seq_srz_tmp[9] | 0 : 0;
    seq_trig_mode = max(0, min(5, seq_srz_tmp[10] | 0)); seq_trig_base = max(0, min(127, seq_srz_tmp[11] | 0));
    seq_opt_icons = seq_srz_tmp[12] ? 1 : 0; seq_opt_follow = seq_srz_tmp[13] ? 1 : 0; seq_opt_transport = seq_srz_tmp[14] ? 1 : 0;
    seq_opt_sync = seq_srz_tmp[15] ? 1 : 0; seq_opt_midiout = seq_srz_tmp[16] ? 1 : 0; seq_opt_midich = max(1, min(16, seq_srz_tmp[17] | 0));
    seq_opt_adapt = seq_srz_tmp[18] ? 1 : 0;
    seq_gmute = max(0, min(65535, seq_srz_tmp[19] | 0)); seq_gsolo = max(0, min(65535, seq_srz_tmp[20] | 0));
    seq_gms_srz = seq_srz_tmp[21] ? 1 : 0; seq_col_hide = max(0, min(31, seq_srz_tmp[22] | 0));
    seq_opt_topdown = seq_srz_tmp[23] ? 1 : 0; seq_opt_snap = max(0, min(3, seq_srz_tmp[24] | 0));
    seq_opt_rollh = max(0, min(100, seq_srz_tmp[25] | 0));
    seq_npat = max(0, min(SEQ_PATS, seq_srz_tmp[26] | 0));   // 0 = an older stream: seq_npat_fix derives it after the read
  );
);
// The SONG block, both directions (the count first, then the three scalars, then the slots).
function seq_srz_song(_ch) local(_sg_ok, seq_srz_n) (
  seq_srz_n = SEQ_SONG_MAX; seq_srz_n = seq_io_var(seq_srz_n, _ch);
  seq_song_len = seq_io_var(seq_song_len, _ch); seq_song_loop = seq_io_var(seq_song_loop, _ch); seq_song_pos = seq_io_var(seq_song_pos, _ch);
  _sg_ok = (seq_srz_n | 0) >= 0 && (seq_srz_n | 0) <= SEQ_SONG_MAX;
  _sg_ok ? seq_io_mem(seq_song, (seq_srz_n | 0) * 2, _ch);
  seq_io_rd(_ch) ? (
    seq_song_len = max(0, min(SEQ_SONG_MAX, seq_song_len | 0)); seq_song_loop = seq_song_loop ? 1 : 0;
    seq_song_pos = max(0, min(SEQ_SONG_MAX - 1, seq_song_pos | 0));
  );
  _sg_ok;
);
// The PATTERNS block, both directions (the count, then per pattern a used flag and its body). Returns 1, or 0
// when a count failed its bound (the caller reads nothing more).
function seq_srz_pats(_ch) local(_sp_p, _sp_np, _sp_ok, _sp_dst, seq_srz_n, seq_srz_u) (
  seq_srz_n = SEQ_PATS; seq_srz_n = seq_io_var(seq_srz_n, _ch);
  _sp_np = seq_srz_n | 0;
  _sp_ok = _sp_np >= 0 && _sp_np <= SEQ_SRZ_PATS_MAX;
  _sp_p = 0;
