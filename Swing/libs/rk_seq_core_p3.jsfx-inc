    _mn_k += 1; _mn_c = _mn_k < SEQ_NAME_LEN ? _mn_b[_mn_k] | 0 : 0;
  );
  _mn_k;
);
function seq_meta_name_set(_ns_p, _ns_str) local(_ns_b, _ns_k, _ns_n, _ns_c) (
  _ns_b = seq_meta + max(0, min(SEQ_PATS - 1, _ns_p | 0)) * SEQ_META_F + 1;
  _ns_n = min(SEQ_NAME_LEN, strlen(_ns_str)); _ns_k = 0;
