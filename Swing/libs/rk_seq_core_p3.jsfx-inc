    _cn_n += 1;
    _cn_b = seq_note_at(_cn_p, 0, 0); loop(SEQ_LANES * SEQ_STEPS * SEQ_CHORD_N, _cn_b[0] > 0 ? _cn_n += 2; _cn_b += SEQ_NOTE_F; );
    _cn_p += 1;
  );
  _cn_n;
);
function seq_srz_notes(_ch) local(_sn_np, _sn_p, _sn_ok, _sn_n, _sn_b, _sn_k, _sn_l, _sn_s, _sn_nb, _sn_a, _sn_w, _sn_q, seq_srz_a, seq_srz_b, seq_srz_n, seq_srz_u) (
  seq_srz_n = SEQ_PATS; seq_srz_n = seq_io_var(seq_srz_n, _ch);
  _sn_np = seq_srz_n | 0; _sn_ok = _sn_np >= 0 && _sn_np <= SEQ_SRZ_PATS_MAX;
  _sn_p = 0;
  while(_sn_ok && _sn_p < _sn_np) (
    _sn_b = _sn_p < SEQ_PATS ? seq_note_at(_sn_p, 0, 0) : -1;
    !seq_io_rd(_ch) ? ( seq_srz_u = 0; _sn_nb = _sn_b; loop(SEQ_LANES * SEQ_STEPS * SEQ_CHORD_N, _sn_nb[0] > 0 ? seq_srz_u += 1; _sn_nb += SEQ_NOTE_F; ); );
    seq_srz_u = seq_io_var(seq_srz_u, _ch);
    _sn_n = seq_srz_u | 0;
    _sn_n < 0 || _sn_n > SEQ_LANES * SEQ_STEPS * SEQ_CHORD_N ? _sn_ok = 0 : (
      !seq_io_rd(_ch) ? (
        _sn_k = 0;
