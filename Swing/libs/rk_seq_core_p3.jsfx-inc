);
// ─── Round two H (2026-10-21): each pattern's own NAME and COLOUR, and the COUNT of patterns on show (META, 5) ───
// The user: "the chips that indicate which pattern we have selected, can those be color-coded as well? ... it did not
// show all the patterns at once. It allowed for there to be room until more patterns were created." A pattern keeps
// its own name (16 chars) and colour (packed RGB, 0 = none: the chip takes a hue from its number) in the META block,
// written as its own tag: the project file and a kit's record both carry it, and a build before this skips the tag
// by its length. The COUNT (seq_npat: the chips on show, 1..32; "+" adds one, DUP raises it, SONG on follows the
// regions) is SETTINGS cell 26 in the project; a kit's record has no settings, so after a kit lands the count is
// raised to show every used pattern (seq_npat_fix; the same for an older project's stream, which has no count). The
// face owns seq_npat and the meta; the engine reads the count for the trigger range only (a note past it does
// nothing, the user's choice).
SEQ_META_F   = 17;      // a pattern's record: +0 colour (packed RGB, 0 none), +1..16 the name's chars, 0-terminated
SEQ_NAME_LEN = 16;
SEQ_SRZ_TAG_META = 5;
seq_npat = 1;           // the patterns on show: a fresh sequencer shows one and "+"
seq_meta = 0;
function seq_meta_init(_mi_base) ( seq_meta = _mi_base; memset(seq_meta, 0, SEQ_PATS * SEQ_META_F); );
function seq_meta_clear_all() ( seq_meta ? memset(seq_meta, 0, SEQ_PATS * SEQ_META_F); );
function seq_meta_col(_mc_p) ( seq_meta[max(0, min(SEQ_PATS - 1, _mc_p | 0)) * SEQ_META_F] | 0; );
function seq_meta_col_set(_ms_p, _ms_c) ( seq_meta[max(0, min(SEQ_PATS - 1, _ms_p | 0)) * SEQ_META_F] = max(0, min(16777215, _ms_c | 0)); );
function seq_meta_has_name(_mh_p) ( seq_meta[max(0, min(SEQ_PATS - 1, _mh_p | 0)) * SEQ_META_F + 1] >= 32; );
// the name into #seq_meta_str (the caller copies it out); returns its length
function seq_meta_name(_mn_p) local(_mn_b, _mn_k, _mn_c) (
  _mn_b = seq_meta + max(0, min(SEQ_PATS - 1, _mn_p | 0)) * SEQ_META_F + 1;
  strcpy(#seq_meta_str, ""); _mn_k = 0; _mn_c = _mn_b[0] | 0;
  while(_mn_k < SEQ_NAME_LEN && _mn_c >= 32 && _mn_c < 127) (
