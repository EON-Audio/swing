      : _ss_tag == SEQ_SRZ_TAG_PATS ? _ss_ok = seq_srz_pats(_ch)
      : _ss_tag == SEQ_SRZ_TAG_NOTES ? _ss_ok = seq_srz_notes(_ch)
      : _ss_tag == SEQ_SRZ_TAG_META ? _ss_ok = seq_srz_meta(_ch)
