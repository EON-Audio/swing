    _ss_ok = _ss_np >= 0 && _ss_np <= SEQ_SRZ_PATS_MAX;
    _ss_p = 0;
    while(_ss_ok && _ss_p < _ss_np) (
      _ss_dst = _ss_p < SEQ_PATS ? _ss_p : -1;
      seq_srz_u = (!seq_io_rd(_ch) && _ss_dst >= 0) ? seq_pat_used(_ss_p) : 0;
      seq_srz_u = seq_io_var(seq_srz_u, _ch);
