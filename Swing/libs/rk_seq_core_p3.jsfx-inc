  _sp_ok;
);
// A 78 file's lanes: W (a strength 0..100 % of the pattern's swing, 100 the default) -> the lane's own swing:
// 100 -> follow the pattern (-1), anything else -> round(SWING x W / 100), the same timing the file played with.
function seq_srz_convert_78() local(_cv_p, _cv_l, _cv_lb, _cv_sw, _cv_w) (
  _cv_p = 0; loop(SEQ_PATS,
    _cv_sw = max(0, min(100, seq_pat_at(_cv_p)[3]));
    _cv_l = 0; loop(SEQ_LANES,
      _cv_lb = seq_lane_at(_cv_p, _cv_l);
