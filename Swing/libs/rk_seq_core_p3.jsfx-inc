      _sm_k += 1;
    );
  );
  _sm_ok;
);
// The lanes' mute and solo from one pattern's legacy fields 4 / 5 (an older file; the timing rig's passes too).
function seq_gms_migrate(_gm_p) local(_gm_l, _gm_lb) (
  seq_gmute = 0; seq_gsolo = 0; _gm_p = max(0, min(SEQ_PATS - 1, _gm_p | 0));
  _gm_l = 0; loop(SEQ_LANES, _gm_lb = seq_lane_at(_gm_p, _gm_l); _gm_lb[4] ? seq_gmute += 2 ^ _gm_l; _gm_lb[5] ? seq_gsolo += 2 ^ _gm_l; _gm_l += 1; );
);
// The tagged stream, both directions, on the channel seq_io_mode names. A WRITE gives the tags from _st_from on (0
