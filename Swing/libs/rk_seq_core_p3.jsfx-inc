);
function seq_meta_clear(_mx_p) ( memset(seq_meta + max(0, min(SEQ_PATS - 1, _mx_p | 0)) * SEQ_META_F, 0, SEQ_META_F); );
// the last used pattern + 1 (0 = none)
function seq_npat_used() local(_nu_p, _nu_u) (
  _nu_u = 0; _nu_p = 0; loop(SEQ_PATS, seq_pat_used(_nu_p) ? _nu_u = _nu_p + 1; _nu_p += 1; );
  _nu_u;
);
// the count after a project read (@serialize, which restores the face's words the same way): never below one, never
// below the last used pattern
function seq_npat_fix() ( seq_npat = max(1, min(SEQ_PATS, max(seq_npat | 0, seq_npat_used()))); );
// a kit landed (@block): @block never writes seq_npat (the face's word, written every frame); it posts the count the kit's
