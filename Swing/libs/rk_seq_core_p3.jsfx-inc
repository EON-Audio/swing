seq_npat_req_v = 0; seq_npat_req_n = 0;
function seq_npat_post() ( seq_npat_req_v = seq_npat_used(); seq_npat_req_n += 1; );
function seq_srz_count_meta() ( 1 + SEQ_PATS * SEQ_META_F; );
// the META block, both directions: the record count, then the records; a read clamps every cell to its kind. The count's
// bound is the stream's (SEQ_SRZ_PATS_MAX, as PATS and NOTES allow), not this build's: a later build holding more patterns
// writes more records, read here to this build's count and the rest dropped -- SEQ_PATS can grow (audit K14, 2026-10-26)
function seq_srz_meta(_ch) local(_sm_ok, _sm_k, _sm_v, _sm_n, seq_srz_n) (
  seq_srz_n = SEQ_PATS; seq_srz_n = seq_io_var(seq_srz_n, _ch);
  _sm_n = seq_srz_n | 0;
  _sm_ok = _sm_n >= 0 && _sm_n <= SEQ_SRZ_PATS_MAX;
  _sm_ok ? (
