    );
    _cv_p += 1;
  );
);
// The 78 body (the positional stream S1 wrote; a READER now: nothing writes 78 any more).
function seq_srz_body78(_ch) local(_ss_p, _ss_np, _ss_ok, _ss_dst, seq_srz_n, seq_srz_spare0, seq_srz_spare1, seq_srz_u) (
  // ── header (78's: the twelve scalars and two spares) ──
  seq_shown = seq_io_var(seq_shown, _ch); seq_h = seq_io_var(seq_h, _ch); seq_view = seq_io_var(seq_view, _ch); seq_cur = seq_io_var(seq_cur, _ch); seq_page = seq_io_var(seq_page, _ch);
  seq_off = seq_io_var(seq_off, _ch); seq_run = seq_io_var(seq_run, _ch); seq_place = seq_io_var(seq_place, _ch); fb_place = seq_io_var(fb_place, _ch); fx_place = seq_io_var(fx_place, _ch);
  seq_trig_mode = seq_io_var(seq_trig_mode, _ch); seq_trig_base = seq_io_var(seq_trig_base, _ch); seq_srz_spare0 = seq_io_var(seq_srz_spare0, _ch); seq_srz_spare1 = seq_io_var(seq_srz_spare1, _ch);
  seq_io_rd(_ch) ? (
    seq_shown = seq_shown ? 1 : 0; seq_h = max(0, min(4096, seq_h)); seq_view = max(0, min(6, seq_view | 0));
    seq_cur = max(0, min(SEQ_PATS - 1, seq_cur | 0)); seq_page = max(0, min(3, seq_page | 0));
    seq_off = seq_off ? 1 : 0; seq_run = seq_run ? 1 : 0;
    seq_place = (seq_place >= 0 && seq_place <= 4) ? seq_place | 0 : 0;
    fb_place = (fb_place >= 0 && fb_place <= 4) ? fb_place | 0 : 0;
    fx_place = (fx_place >= 0 && fx_place <= 4) ? fx_place | 0 : 0;
    seq_trig_mode = max(0, min(5, seq_trig_mode | 0)); seq_trig_base = max(0, min(127, seq_trig_base | 0));
