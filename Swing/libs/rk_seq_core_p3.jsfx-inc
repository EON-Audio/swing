// settings (the options, the lanes' mute and solo, the view are the project's). SONG is no longer written (D9, 2026-10-29;
// it was the second, between SETTINGS and PATTERNS). A READ takes whatever tags the stream carries, SONG included, in any
// order (_st_from is the writer's alone). Returns 1 when every count met its bound.
function seq_srz_tagged(_st_from, _ch) local(_ss_k, _ss_nt, _ss_tag, _ss_len, _ss_ok, _ss_pos, _ss_used, seq_srz_len, seq_srz_n, seq_srz_tag) (
  seq_srz_n = 4 - _st_from; seq_srz_n = seq_io_var(seq_srz_n, _ch);
  _ss_nt = seq_srz_n | 0; _ss_ok = _ss_nt >= 0 && _ss_nt <= SEQ_SRZ_TAGS_MAX;
