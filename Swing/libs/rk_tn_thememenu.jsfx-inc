// rk_tn_thememenu.jsfx-inc — EON Tone's THEME-menu rows
//
// The house rule: one menu holding every appearance option this face has.
// Tone's are THEME, KNOB and NAME BAR. The panel engine is
// rk_thememenu_core.jsfx-inc; read ITS header for the contract and the import
// order, which is load-bearing — this file must be imported BEFORE the core.
//
// ⚠️ This file is compiled BEFORE EON_Tone.jsfx's own @init, so it cannot call
// anything Tone defines (tn_apply, tn_draw_eq, rk_srf_load, …). It only uses rkth_* from
// rk_theme, swing_popup_* from rk_swing_popup, and plain globals.
//
// ⚠️ NEAR-TWIN of rk_ou_thememenu.jsfx-inc. They differ only in the name-bar
// slider variable, which EEL2 cannot parameterise without function pointers.
// Two explicit copies beat an indirection layer for two hosts — but if a THIRD
// face wants this exact 3-row set, merge them behind a host-mirrored global
// rather than adding a third copy.
//
// ⭐ THEME + KNOB are SUITE-WIDE, not per-instance: both write a request into the
// shared band and the bridge republishes, so picking here re-skins Swing, Steppa,
// Drum Strip and the rest in step. NAME BAR is the only per-instance row.

@init

THM_N_ROWS = 3;

THM_ROW_THEME   = 0;
THM_ROW_KNOB    = 1;
THM_ROW_NAMEBAR = 2;

// The knob-style names, in dispatcher order. Same list and same spelling as
// Swing's swing_ui_knob_name (rk_swing_ui_state.jsfx-inc), so a style reads the
// same wherever it is named.
function tn_knob_name(v) (
  v == 1  ? strcpy(#_thm_lbl, "SSL") :
  v == 2  ? strcpy(#_thm_lbl, "Vari-Mu") :
  v == 3  ? strcpy(#_thm_lbl, "API") :
  v == 4  ? strcpy(#_thm_lbl, "Witti") :
  v == 5  ? strcpy(#_thm_lbl, "Neve") :
  v == 6  ? strcpy(#_thm_lbl, "Joanny") :
  v == 7  ? strcpy(#_thm_lbl, "MPC") :
  v == 8  ? strcpy(#_thm_lbl, "Jog") :
  v == 9  ? strcpy(#_thm_lbl, "Rainbow") :
  v == 10 ? strcpy(#_thm_lbl, "Spice") :
  v == 11 ? strcpy(#_thm_lbl, "Encoder") :
  v == 12 ? strcpy(#_thm_lbl, "Pultec") :
  v == 13 ? strcpy(#_thm_lbl, "Ableton") :
  v == 14 ? strcpy(#_thm_lbl, "FL") :
  v == 15 ? strcpy(#_thm_lbl, "Pro Tools") :
  v == 16 ? strcpy(#_thm_lbl, "FabFilter") :
  v == 17 ? strcpy(#_thm_lbl, "Serum") :
  v == 18 ? strcpy(#_thm_lbl, "Roland") :
  v == 19 ? strcpy(#_thm_lbl, "Pultec Cr") :
  v == 20 ? strcpy(#_thm_lbl, "Neve Alt") :
  strcpy(#_thm_lbl, "Default");   // 0 and anything unexpected
);

function thm_cap(r) (
  r == THM_ROW_KNOB    ? strcpy(#_thm_lbl, "KNOB") :
  r == THM_ROW_NAMEBAR ? strcpy(#_thm_lbl, "NAME BAR") :
  strcpy(#_thm_lbl, "THEME");
);

function thm_val(r) (
  r == THM_ROW_THEME ? strcpy(#_thm_lbl, rkth_name(rkth_cur() - 1)) :
  r == THM_ROW_KNOB  ? tn_knob_name(gmem[GS_THEME_KNOB_P] | 0) :
  ( tn_name_bar ? strcpy(#_thm_lbl, "Shown") : strcpy(#_thm_lbl, "Hidden") );
);

function thm_count(r) (
  r == THM_ROW_THEME ? RKTH_N : r == THM_ROW_KNOB ? 21 : 2;
);

function thm_curidx(r) (
  r == THM_ROW_THEME ? rkth_cur() - 1 :
  r == THM_ROW_KNOB  ? (gmem[GS_THEME_KNOB_P] | 0) :
  tn_name_bar;
);

function thm_optname(r, k) (
  r == THM_ROW_THEME ? strcpy(#_thm_lbl, rkth_name(k)) :
  r == THM_ROW_KNOB  ? tn_knob_name(k) :
  ( k ? strcpy(#_thm_lbl, "Shown") : strcpy(#_thm_lbl, "Hidden") );
);

// '!' ticks the live value — swing_popup's per-item marker.
function thm_menu(r) local(_k, _n, _cur) (
  _n = thm_count(r); _cur = thm_curidx(r);
  strcpy(#_thm_items, "");
  _k = 0;
  loop(_n,
    _k > 0 ? strcat(#_thm_items, "|");
    _k == _cur ? strcat(#_thm_items, "!");
    thm_optname(r, _k);
    strcat(#_thm_items, #_thm_lbl);
    _k += 1;
  );
);

function thm_openlist(r, px, py) (
  thm_pick_row = r;
  thm_menu(r);
  swing_popup_open(px, py, #_thm_items, SP_POPUP_CALLER_THEME);
);

function thm_apply(r, res) local(_k) (
  _k = res - 1;   // swing_popup returns 1-based
  r == THM_ROW_THEME ? ( gmem[GS_THEME_REQ]      = _k + 1; ) :
  r == THM_ROW_KNOB  ? ( gmem[GS_THEME_KNOB_REQ] = _k + 1; ) :
  ( tn_name_bar = _k; slider_automate(tn_name_bar); );
);

// Called by the core every frame, open or shut: a list outlives the panel,
// because the click that picks an item can be the click that closes it.
// Wheel over a row's chip: step its value, wrapping, as a pick would. Every row
// here owns a value list, so none needs excluding the way Swing's EMBED does.
function thm_wheel(r, d) local(_n, _c) (
  _n = thm_count(r);
  _n >= 2 ? (
    _c = (thm_curidx(r) + d + _n) % _n;
    thm_apply(r, _c + 1);
  );
);

function thm_poll() (
  swing_popup_result > 0 && swing_popup_caller_id == SP_POPUP_CALLER_THEME ? (
    thm_apply(thm_pick_row, swing_popup_result);
    swing_popup_result = 0;
  );
  swing_popup_result == -1 && swing_popup_caller_id == SP_POPUP_CALLER_THEME ? (
    swing_popup_result = 0;
  );
);
