// rk_swing_ui_grid_overlay.jsfx-inc
// Swing overlay: panel frame, layer tabs, drop/close logic + orchestrator
// Sub-functions for swing_grid_draw_overlay() — zero behavioral change
// (c) EON Studios — All Rights Reserved

@init

// ── The 16 colours (the colour row's chip and its grid, 2026-10-29): 0..13 the hues k / 14, 14 black, 15 white, as
// p_color holds them (a hue 0..1, -2 black, -1 white); _at: the one a colour is (a hue between two: the nearest); _set:
// a pick, as the swatches' was (the colours go manual, the pad marked, the colours re-published); _w: the grid's width.
// pfx_cg_x / y: where it opened, in design px from the editor's corner (op_x, op_y), so it moves with the editor -- a
// page scrolled under it, another host (until the final audit, 2026-10-29, screen px: it stayed where it had opened)
pfx_cgrid = 0; pfx_cg_x = 0; pfx_cg_y = 0;
function swing_grid_cg_val(i) ( i == 14 ? -2 : i == 15 ? -1 : i / 14 );
function swing_grid_cg_at(c) ( c <= -1.5 ? 14 : c < 0 ? 15 : ((c * 14 + 0.5) | 0) % 14 );
function swing_grid_cg_set(p, i) ( p_color[p] = swing_grid_cg_val(i); swing_color_manualize(p); mark_dirty_pad(p); col_dirty = 1; );
function swing_grid_cg_w() ( ov_px(6) * 2 + 4 * ov_px(22) + 3 * ov_px(4) );

function _ov_draw_header_and_colorpicker() (
    // Panel background
    ov_set(0.15, 0.16, 0.19, 1); gfx_rect(op_x, op_y, op_w, op_h);
    // Accent border
    ov_set(pr * 0.6, pgg * 0.6, pb * 0.6, 1);
    gfx_rect(op_x, op_y, op_w, op_h, 0);
    gfx_rect(op_x+1, op_y+1, op_w-2, op_h-2, 0);

    // Header bar (every size at the editor's zoom: ov_px / ov_font, rk_swing_ui_layer_mixer). The LCD look (pfx_look 1,
    // step 3): a darker band of the screen with the pad's colour as a line under it; the chassis: the pad's colour, darkened.
    pfx_look == 1 ? (
      gfx_set(lcd_bg_r * 0.62, lcd_bg_g * 0.62, lcd_bg_b * 0.62, 1); gfx_rect(op_x, op_y, op_w, ov_px(26));
      gfx_set(pr, pgg, pb, 0.9); gfx_rect(op_x, op_y + ov_px(26) - max(2, ov_px(2)), op_w, max(2, ov_px(2)));
    ) : (
      ov_set(pr * 0.35, pgg * 0.35, pb * 0.35, 1); gfx_rect(op_x, op_y, op_w, ov_px(26));
    );
    // OPTIONS at the header's right (left of the floating editor's x; 2026-10-29, the owner: "Can pad fx get its own options
    // sepereate fromt the mini browser"; the approved render): it opens the editor's OWN sheet (swing_grid_opt_draw) -- its
    // text size, its look, the envelope's dots. It took the place of A- / A+ and LCD, which set the browser's too.
    _hd_bs = ov_px(18); _hd_by = op_y + ov_px(4);
    ov_font(9, 'b'); gfx_measurestr("OPTIONS", _hd_tw, _hd_th);
    _hd_lw = _hd_tw + ov_px(26); _hd_lx = op_x + op_w - ov_px(overlay_pad >= 0 ? 28 : 6) - _hd_lw;
    _hd_hot = mx >= _hd_lx && mx < _hd_lx + _hd_lw && my >= _hd_by && my < _hd_by + _hd_bs;
    pfx_opt ? gfx_set(0.88, 0.54, 0.17, 1) : ov_set(0, 0, 0, _hd_hot ? 0.45 : 0.25);
    gfx_rect(_hd_lx, _hd_by, _hd_lw, _hd_bs);
    !pfx_opt ? ( ov_set(1, 1, 1, _hd_hot ? 0.45 : 0.22); gfx_rect(_hd_lx, _hd_by, _hd_lw, _hd_bs, 0); );
    pfx_opt ? gfx_set(0.16, 0.09, 0.02, 1) : ov_set(1, 1, 1, _hd_hot ? 1 : 0.80);
    _hd_gx = _hd_lx + ov_px(10); _hd_gy = _hd_by + _hd_bs * 0.5;   // a gear: a ring and six teeth
    gfx_circle(_hd_gx, _hd_gy, 2.6 * ov_k, 0, 1);
    _hd_i = 0; loop(6,
      gfx_line(_hd_gx + cos(_hd_i * $pi / 3) * 3 * ov_k, _hd_gy + sin(_hd_i * $pi / 3) * 3 * ov_k,
               _hd_gx + cos(_hd_i * $pi / 3) * 5 * ov_k, _hd_gy + sin(_hd_i * $pi / 3) * 5 * ov_k, 1);
      _hd_i += 1;
    );
    gfx_x = _hd_lx + ov_px(19); gfx_y = _hd_by + (_hd_bs - _hd_th) * 0.5; gfx_drawstr("OPTIONS");
    _hd_hot ? swing_tooltip_check(1600, "The pad editor's own options: its typeface, text size, look (chassis, LCD or your theme's) and the envelope's dots.");
    _hd_hot && lmb_down ? ( pfx_opt = !pfx_opt; pfx_cgrid = 0; lmb_down = 0; );
    ov_opt_cx = _hd_lx + _hd_lw * 0.5; ov_opt_cy = _hd_by + _hd_bs * 0.5;   // OPTIONS' centre, for the rig (tb_test Z, C)
    // the sheet open (or the colour row's 16 colours): it takes the editor's mouse -- what is under it gets no press, no wheel and no pointer this frame;
    // swing_grid_opt_draw (each host's last, on top) gives the mouse back
    pfx_opt || pfx_cgrid ? ( pfx_os_mx = mx; pfx_os_my = my; pfx_os_ld = lmb_down; pfx_os_lb = LMB; pfx_os_wh = frame_wheel; pfx_os_rd = rmb_down; pfx_os_park = 1;
                mx = -10000; my = -10000; lmb_down = 0; LMB = 0; rmb_down = 0; frame_wheel = 0; );
    // PAD N -- name, the name cut to the room left of OPTIONS
    ov_font(11, 'b');
    ov_set(1, 1, 1, 0.85);
    sprintf(#oh, "PAD %d", swing_pad_num(oi));   // 1..16 (step 4d; oi is a slot)
    gfx_measurestr(#oh, _hd_tw, _hd_th);
    gfx_x = op_x + ov_px(10); gfx_y = op_y + (ov_px(26) - _hd_th) * 0.5; gfx_drawstr(#oh);
    nm = get_name_slot(oi);
    strlen(nm) > 0 ? (
      ov_set(pr + (1-pr)*0.5, pgg + (1-pgg)*0.5, pb + (1-pb)*0.5, 1);
      gfx_x = op_x + ov_px(14) + _hd_tw; gfx_drawstr("—");
      gfx_x += ov_px(4);
      ov_ltext(nm, gfx_x, gfx_y, _hd_lx - ov_px(6) - gfx_x);
    );

    // ── The colour row (2026-10-29, the owner: "i still dont love the color swatches. maybe just the rainbow slider and right
    // click it has the 16 color swatches"; the approved render) ──
    // The pad's colour as a CHIP at the left: a click on it -- or a right-click on the rainbow (an embed gets no
    // right-click, so the chip is the way in everywhere) -- opens the 16 colours, 14 hues and black and white
    // (swing_grid_opt_draw draws them last, on top; the header parks the mouse while they are open); the wheel over it steps
    // through them. Then one wide RAINBOW for every hue between: a drag picks, the wheel fine-tunes. Theme-effective S/L, so
    // the colours match the pad faces. (Until then 10 swatches and a 100 px rainbow.)
    _cp_y = op_y + ov_px(28);
    _cp_h = ov_px(16);
    _cp_eff_s = gmem[GS_COL_EFFECTIVE_S];
    _cp_eff_l = gmem[GS_COL_EFFECTIVE_L];
    (_cp_eff_s == 0 && _cp_eff_l == 0) ? ( _cp_eff_s = 0.75; _cp_eff_l = 0.55; );
    ov_set(0.08, 0.09, 0.11, 1); gfx_rect(op_x, _cp_y - 2, op_w, _cp_h + 4);   // the row's band

    // the chip: the pad's colour and an arrow
    _sw_x0 = op_x + ov_px(6); _sw_w = ov_px(34);
    _in_sw = mx >= _sw_x0 && mx < _sw_x0 + _sw_w && my >= _cp_y - 2 && my <= _cp_y + _cp_h + 2;
    ov_set(0.22, 0.23, 0.27, 1); gfx_rect(_sw_x0, _cp_y - 1, _sw_w, _cp_h + 2);
    (_in_sw || pfx_cgrid) ? ( ov_set(1, 1, 1, 0.14); gfx_rect(_sw_x0, _cp_y - 1, _sw_w, _cp_h + 2); );
    gfx_set(pr, pgg, pb, 1); gfx_rect(_sw_x0 + ov_px(3), _cp_y + ov_px(2), ov_px(18), _cp_h - ov_px(4));
    ov_set(0.36, 0.38, 0.42, 1); gfx_rect(_sw_x0 + ov_px(3), _cp_y + ov_px(2), ov_px(18), _cp_h - ov_px(4), 0);
    _cp_tx = _sw_x0 + ov_px(27); _cp_ty = _cp_y + _cp_h * 0.5;
    ov_set(0.80, 0.82, 0.85, 1);
    gfx_triangle(_cp_tx - 3 * ov_k, _cp_ty - 1.5 * ov_k, _cp_tx + 3 * ov_k, _cp_ty - 1.5 * ov_k, _cp_tx, _cp_ty + 2 * ov_k);
    pfx_cgrid ? ( ov_set(0.90, 0.92, 0.95, 1); gfx_rect(_sw_x0, _cp_y - 1, _sw_w, _cp_h + 2, 0); );
    _in_sw ? swing_tooltip_check(1601, "The pad's colour: a click shows 16 colours (a right-click on the rainbow too); the wheel steps through them.");
    _in_sw && lmb_down ? ( pfx_cgrid = !pfx_cgrid; pfx_cg_x = (_sw_x0 - op_x) / ov_k; pfx_cg_y = (_cp_y + _cp_h + ov_px(3) - op_y) / ov_k; lmb_down = 0; );
    _in_sw && frame_wheel != 0 ? (
      swing_grid_cg_set(oi, (swing_grid_cg_at(p_color[oi]) + (frame_wheel > 0 ? 1 : 15)) % 16);
      frame_wheel = 0;   // consumed (the pad panel's scroll takes a wheel no control took; 2026-10-27)
    );

    // the rainbow: every hue, across the rest of the row
    _hs_x = _sw_x0 + _sw_w + ov_px(6);
    _hs_w = max(ov_px(40), op_x + op_w - ov_px(6) - _hs_x);
    _hue_i = 0;
    loop(_hs_w,
      hsl_to_rgb(_hue_i / _hs_w, _cp_eff_s, _cp_eff_l);
      ov_set(_hsl_r, _hsl_g, _hsl_b, 1);
      gfx_rect(_hs_x + _hue_i, _cp_y, 1, _cp_h);
      _hue_i += 1;
    );
    // Current hue marker (only for chromatic colors)
    p_color[oi] >= 0 ? (
      _hue_mark_x = _hs_x + (p_color[oi] * _hs_w) | 0;
      ov_set(1, 1, 1, 0.9);
      gfx_rect(_hue_mark_x - 1, _cp_y - 1, 3, _cp_h + 2);
      ov_set(0, 0, 0, 0.5);
      gfx_rect(_hue_mark_x - 2, _cp_y - 1, 1, _cp_h + 2);
      gfx_rect(_hue_mark_x + 2, _cp_y - 1, 1, _cp_h + 2);
    );
    // Slider border
    ov_set(0.25, 0.26, 0.30, 0.6);
    gfx_rect(_hs_x - 1, _cp_y - 1, _hs_w + 2, _cp_h + 2, 0);

    // Slider drag (ID 250)
    _in_hs = mx >= _hs_x - 2 && mx <= _hs_x + _hs_w + 2 &&
             my >= _cp_y - 2 && my <= _cp_y + _cp_h + 2;
    _in_hs ? swing_tooltip_check(1602, "Drag for any hue; the wheel fine-tunes it. Right-click: the 16 colours.");
    active_id == 250 ? ( LMB ? (
      p_color[oi] = max(0.0, min(0.999, (mx - _hs_x) / _hs_w));
      swing_color_manualize(oi);
      mark_dirty_pad(oi);
      col_dirty = 1;
    ) : active_id = -1; );
    active_id == -1 && _in_hs && lmb_down ? (
      active_id = 250;
      p_color[oi] = max(0.0, min(0.999, (mx - _hs_x) / _hs_w));
      swing_color_manualize(oi);
      mark_dirty_pad(oi);
      col_dirty = 1;
    );
    // a right-click: the 16 colours, under the rainbow where it was pressed (kept inside the editor)
    _in_hs && rmb_down ? (
      pfx_cgrid = 1; pfx_cg_x = (max(op_x + ov_px(6), min(mx - ov_px(20), op_x + op_w - ov_px(6) - swing_grid_cg_w())) - op_x) / ov_k;
      pfx_cg_y = (_cp_y + _cp_h + ov_px(3) - op_y) / ov_k; rmb_down = 0;
    );
    // Wheel on slider → fine hue (1/64 step)
    _in_hs && frame_wheel != 0 ? (
      p_color[oi] < 0 ? p_color[oi] = 0;
      p_color[oi] += frame_wheel * 0.015625;
      p_color[oi] < 0 ? p_color[oi] += 1.0;
      p_color[oi] >= 1 ? p_color[oi] -= 1.0;
      swing_color_manualize(oi);
      mark_dirty_pad(oi);
      col_dirty = 1;
      frame_wheel = 0;   // consumed (2026-10-27, as the swatches')
    );

    // Close button [x] -- the FLOATING editor's (overlay_pad >= 0): only _ov_draw_drop_and_close tests it,
    // and the pad PANEL (rk_swing_ui_padfx_panel draws this header too) never calls that, so there the
    // red x was a dead button beside the slot's own X (sweep LIB135).
    cl_x = op_x + op_w - ov_px(22); cl_y = op_y + ov_px(4); cl_s = ov_px(18);
    overlay_pad >= 0 ? (
      ov_set(0.55, 0.20, 0.20, 1);
      gfx_rect(cl_x, cl_y, cl_s, cl_s);
      ov_set(1, 1, 1, 0.85);
      ov_font(11, 'b');
      gfx_measurestr("x", _hd_tw, _hd_th);
      gfx_x = cl_x + (cl_s - _hd_tw) * 0.5; gfx_y = cl_y + (cl_s - _hd_th) * 0.5; gfx_drawstr("x");
    );
);

// ── The pad editor's OPTIONS sheet (2026-10-29; the owner: "the browser has a whole options button. Can pad fx get its own
// options sepereate fromt the mini browser"; the approved render) ──
// Under the header, over the editor, drawn LAST by each host (the floating editor; the side panel's SOUND page, narrow
// and wide): the editor's own TYPEFACE (pfx_font 0..4: ov_font; saved, gate 91), TEXT SIZE (pfx_tsz -4 .. +6: the zoom,
// swing_ov_userk), its LOOK (pfx_look: CHASSIS / LCD / THEME, ov_set) -- both saved, gate 90, the browser keeping its
// TYPEFACE, SIZE and SKIN -- and the ENVELOPE DOTS (adsr_3node, slider31:
// the gear menu's switch, here too). The mouse the header parked comes back here: a press on the sheet is the sheet's, a
// press elsewhere in the editor closes it (spent), DONE closes it; it takes the wheel over it. Its sizes are the
// editor's (ov_px): a size step shows at once on the sheet itself.
function _pfx_os_btn(bx, by, bw, bh, lbl, on) local(hot, tw, th) (
  hot = mx >= bx && mx < bx + bw && my >= by && my < by + bh;
  on ? gfx_set(0.18, 0.44, 0.62, 1) : ov_set(0.22, 0.23, 0.27, 1);
  gfx_rect(bx, by, bw, bh);
  hot ? ( ov_set(1, 1, 1, 0.12); gfx_rect(bx, by, bw, bh); );
  on ? gfx_set(0.40, 0.68, 0.88, 1) : ov_set(0.36, 0.38, 0.42, 1);
  gfx_rect(bx, by, bw, bh, 0);
  ov_font(9, 'b'); on ? gfx_set(1, 1, 1, 1) : ov_set(0.86, 0.87, 0.90, 1);
  gfx_measurestr(lbl, tw, th); gfx_x = bx + (bw - tw) * 0.5; gfx_y = by + (bh - th) * 0.5; gfx_drawstr(lbl);
  hot && lmb_down ? ( lmb_down = 0; 1 ) : 0;
);
function swing_grid_opt_draw() local(x, y, w, h, in, bw, bh, cx, tw, th, cs, ch, cg, pd, gx, gy, gw, gh, cur, exact, i, cy, hot)
(
  pfx_os_park ? ( mx = pfx_os_mx; my = pfx_os_my; lmb_down = pfx_os_ld; LMB = pfx_os_lb; frame_wheel = pfx_os_wh; rmb_down = pfx_os_rd; pfx_os_park = 0; );   // (the right button too since the final audit: it was dropped)
  pfx_opt ? (
    // across the editor, under the header; compact (a row a setting, its label left, its buttons right) so a side panel of
    // the usual height shows it whole above the pinned mixer (the sandbox pictures: 200 tall, its DONE went under it)
    x = op_x + 1; w = op_w - 2; y = op_y + ov_px(27); h = ov_px(166);
    in = mx >= x && mx < x + w && my >= y && my < y + h;
    ov_set(0.11, 0.12, 0.14, 1); gfx_rect(x, y, w, h);
    ov_set(0.36, 0.38, 0.42, 1); gfx_rect(x, y, w, h, 0);
    bh = ov_px(20); bw = ov_px(70);
    // TYPEFACE (the same day, the owner: "And we dont get text options for pad fx?"): the browser's five faces, the
    // editor's own (pfx_font, gate 91; ov_font), its name shown in it, < / > round the five
    ov_font(9, 'b'); ov_set(0.66, 0.68, 0.72, 1); gfx_measurestr("TYPEFACE", tw, th);
    gfx_x = x + ov_px(10); gfx_y = y + ov_px(8) + (bh - th) * 0.5; gfx_drawstr("TYPEFACE");
    ov_font(12, 0); ov_set(0.86, 0.87, 0.90, 1);
    gfx_measurestr(rk_font_fname(pfx_font), tw, th); gfx_x = x + ov_px(100); gfx_y = y + ov_px(8) + (bh - th) * 0.5; gfx_drawstr(rk_font_fname(pfx_font));
    pfx_os_fx = x + w - ov_px(10) - ov_px(32);                     // > (and its centre, for the rig)
    _pfx_os_btn(pfx_os_fx - ov_px(38), y + ov_px(8), ov_px(32), bh, "<", 0) ? pfx_font = (pfx_font + 4) % 5;
    _pfx_os_btn(pfx_os_fx, y + ov_px(8), ov_px(32), bh, ">", 0) ? pfx_font = (pfx_font + 1) % 5;
    pfx_os_fx += ov_px(16); pfx_os_fy = y + ov_px(8) + bh * 0.5; pfx_os_fl = pfx_os_fx - ov_px(38);   // <'s centre
    // TEXT SIZE: the step and - / +
    ov_font(9, 'b'); ov_set(0.66, 0.68, 0.72, 1); gfx_measurestr("TEXT SIZE", tw, th);
    gfx_x = x + ov_px(10); gfx_y = y + ov_px(36) + (bh - th) * 0.5; gfx_drawstr("TEXT SIZE");
    ov_font(12, 'b'); ov_set(0.86, 0.87, 0.90, 1); sprintf(#pfx_os_t, "%s%d", pfx_tsz > 0 ? "+" : "", pfx_tsz);
    gfx_measurestr(#pfx_os_t, tw, th); gfx_x = x + ov_px(100); gfx_y = y + ov_px(36) + (bh - th) * 0.5; gfx_drawstr(#pfx_os_t);
    pfx_os_px = x + w - ov_px(10) - ov_px(32);                     // + (and its centre, for the rig)
    _pfx_os_btn(pfx_os_px - ov_px(38), y + ov_px(36), ov_px(32), bh, "-", 0) ? pfx_tsz = max(-4, pfx_tsz - 1);
    _pfx_os_btn(pfx_os_px, y + ov_px(36), ov_px(32), bh, "+", 0) ? pfx_tsz = min(6, pfx_tsz + 1);
    pfx_os_px += ov_px(16); pfx_os_py = y + ov_px(36) + bh * 0.5;
    // LOOK: CHASSIS / LCD / THEME (the owner, the same day: the editor "should match the theme" -- "Yes")
    ov_font(9, 'b'); ov_set(0.66, 0.68, 0.72, 1); gfx_measurestr("LOOK", tw, th);
    gfx_x = x + ov_px(10); gfx_y = y + ov_px(64) + (bh - th) * 0.5; gfx_drawstr("LOOK");
    _pfx_os_btn(x + w - ov_px(22) - 3 * ov_px(64), y + ov_px(64), ov_px(64), bh, "CHASSIS", pfx_look == 0) ? pfx_look = 0;
    _pfx_os_btn(x + w - ov_px(16) - 2 * ov_px(64), y + ov_px(64), ov_px(64), bh, "LCD", pfx_look == 1) ? pfx_look = 1;
    _pfx_os_btn(x + w - ov_px(10) - ov_px(64), y + ov_px(64), ov_px(64), bh, "THEME", pfx_look == 2) ? pfx_look = 2;
    pfx_os_lx = x + w - ov_px(16) - ov_px(96); pfx_os_ly = y + ov_px(64) + bh * 0.5;   // LCD's centre, for the rig
    pfx_os_tx = x + w - ov_px(10) - ov_px(32); pfx_os_ty = pfx_os_ly;                  // THEME's
    // ENVELOPE DOTS: 4 / 3 (the gear menu's own switch: sliderchange + mark_dirty, as there)
    ov_font(9, 'b'); ov_set(0.66, 0.68, 0.72, 1); gfx_measurestr("ENVELOPE DOTS", tw, th);
    gfx_x = x + ov_px(10); gfx_y = y + ov_px(92) + (bh - th) * 0.5; gfx_drawstr("ENVELOPE DOTS");
    _pfx_os_btn(x + w - ov_px(16) - 2 * bw, y + ov_px(92), bw, bh, "4 DOTS", !adsr_3node) && adsr_3node ? ( adsr_3node = 0; sliderchange(slider31); mark_dirty(); );
    _pfx_os_btn(x + w - ov_px(10) - bw, y + ov_px(92), bw, bh, "3 DOTS", adsr_3node) && !adsr_3node ? ( adsr_3node = 1; sliderchange(slider31); mark_dirty(); );
    pfx_os_dx = x + w - ov_px(10) - bw * 0.5; pfx_os_dy = y + ov_px(92) + bh * 0.5;   // 3 DOTS' centre, for the rig
    ov_font(9, 0); ov_set(0.64, 0.66, 0.70, 1);
    ov_ltext("The browser keeps its own TYPEFACE, SIZE and SKIN.", x + ov_px(10), y + ov_px(120), w - ov_px(20));
    // DONE
    _pfx_os_btn(x + ov_px(10), y + ov_px(138), w - ov_px(20), bh, "DONE", 0) ? pfx_opt = 0;
    pfx_os_ox = x + w * 0.5; pfx_os_oy = y + ov_px(138) + bh * 0.5;   // DONE's centre, for the rig
    // a press elsewhere in the editor closes it (spent); what is over the sheet is the sheet's
    lmb_down && !in && mx >= op_x && mx < op_x + op_w && my >= op_y && my < op_y + op_h ? ( pfx_opt = 0; lmb_down = 0; );
    in ? ( lmb_down = 0; rmb_down = 0; frame_wheel = 0; );
  );
  // ── the 16 colours (the colour row's chip, or a right-click on its rainbow): a 4 x 4 under where it opened -- the 14
  // hues, black, white, the pad's own framed; a press on one picks it and closes, a press elsewhere closes (spent in the
  // editor), a wheel over it is its own. Real colours: black and white stay black and white in every look; each cell is
  // outlined so white reads on a light theme too. ──
  pfx_cgrid ? (
    cs = ov_px(22); ch = ov_px(18); cg = ov_px(4); pd = ov_px(6);
    gx = op_x + floor(pfx_cg_x * ov_k + 0.5); gy = op_y + floor(pfx_cg_y * ov_k + 0.5); gw = swing_grid_cg_w(); gh = pd * 2 + 4 * ch + 3 * cg;
    in = mx >= gx && mx < gx + gw && my >= gy && my < gy + gh;
    ov_set(0.11, 0.12, 0.14, 1); gfx_rect(gx, gy, gw, gh);
    ov_set(0.36, 0.38, 0.42, 1); gfx_rect(gx, gy, gw, gh, 0);
    cur = swing_grid_cg_at(p_color[oi]);
    exact = p_color[oi] < 0 || abs(p_color[oi] * 14 - ((p_color[oi] * 14 + 0.5) | 0)) < 0.05;   // a hue between two: none framed
    i = 0;
    loop(16,
      cx = gx + pd + (i % 4) * (cs + cg); cy = gy + pd + ((i / 4) | 0) * (ch + cg);
      i == 14 ? gfx_set(0.20, 0.20, 0.22, 1) : i == 15 ? gfx_set(0.82, 0.82, 0.85, 1)
              : ( hsl_to_rgb(i / 14, _cp_eff_s, _cp_eff_l); gfx_set(_hsl_r, _hsl_g, _hsl_b, 1); );
      gfx_rect(cx, cy, cs, ch);
      ov_set(0.36, 0.38, 0.42, 1); gfx_rect(cx, cy, cs, ch, 0);
      hot = mx >= cx && mx < cx + cs && my >= cy && my < cy + ch;
      hot ? ( gfx_set(1, 1, 1, 0.25); gfx_rect(cx, cy, cs, ch); );
      i == cur && exact ? ( ov_set(0.95, 0.96, 0.98, 1); gfx_rect(cx - 2, cy - 2, cs + 4, ch + 4, 0); gfx_rect(cx - 1, cy - 1, cs + 2, ch + 2, 0); );
      hot && lmb_down ? ( swing_grid_cg_set(oi, i); pfx_cgrid = 0; lmb_down = 0; );
      i += 1;
    );
    pfx_cg_c0x = gx + pd + cs * 0.5; pfx_cg_c0y = gy + pd + ch * 0.5; pfx_cg_step = cs + cg; pfx_cg_stepy = ch + cg;   // for the rig
    lmb_down && !in ? ( pfx_cgrid = 0; mx >= op_x && mx < op_x + op_w && my >= op_y && my < op_y + op_h ? lmb_down = 0; );
    in ? ( lmb_down = 0; rmb_down = 0; frame_wheel = 0; );
  );
);

// Round-robin ORDER - / +: the orders stay a PERMUTATION. The layer that already holds the
// target order takes this layer's old one (a swap). Rewriting one layer's order alone left
// two layers on one order, and select_layer (rk_drumkit_dsp) then played the first of them
// at both positions and the other never (sweep LIB115). dir is -1 or +1; a pad with no
// layers is left alone (the old min(cnt - 1, ..) wrote -1 there).
function swing_grid_rr_order_step(ap, lidx, dir) local(_cnt, _old, _new, _k, _b, _done) (
  _cnt = p_layer_cnt[ap] | 0;
  _old = l_rr_order[lidx] | 0;
  _new = max(0, min(_cnt - 1, _old + dir));
  _cnt > 0 && _new != _old ? (
    _k = 0; _done = 0;
    while (_k < _cnt && !_done) (
      _b = ap * MAX_LAYERS + _k;
      (_b != lidx && (l_rr_order[_b] | 0) == _new) ? ( l_rr_order[_b] = _old; _done = 1; );
      _k += 1;
    );
    l_rr_order[lidx] = _new;
  );
);

function _ov_draw_layers_and_mode() (
    // ── Layer tabs + mode selector ─────────────────────────
      tab_y = op_y + ov_px(48);
      tab_x = op_x + ov_px(10);
      tab_w = ov_px(30);
      tab_h = ov_px(20);
      // Layer tabs (L1..L4). The SYN pseudo-tab moved to the SYNTH big view (2026-07-31).
      li = 0; loop(MAX_LAYERS,
        tab_xi = tab_x + li * tab_w;
        _ovl_lidx = oi * MAX_LAYERS + li;   // own name: @sample's voice loop owns _lidx (A-8)
        // Highlight if has audio
        p_layer_cnt[oi] > 0 ? (
          has_layer_audio = l_len[_ovl_lidx] > 0;
        ) : (
          has_layer_audio = (li == 0 && s_len[oi] > 0);
        );
        // Active tab highlight — bright orange when selected, medium when has audio, dim when empty
        is_active = (li == overlay_layer);
        is_active ? ov_set(0.90, 0.50, 0.12, 1) :
          (has_layer_audio ? ov_set(0.40, 0.42, 0.48, 1) : ov_set(0.18, 0.19, 0.22, 1));
        gfx_rect(tab_xi, tab_y, tab_w - 2, tab_h);
        // Border
        is_active ? ov_set(1.0, 0.65, 0.25, 0.8) : ov_set(0.45, 0.47, 0.50, 0.6);
        gfx_rect(tab_xi, tab_y, tab_w - 2, tab_h, 0);
        // a browser drag over the tabs lights the ones its drop fills (the mini browser's hover, the big browser's claim)
        time_precise() - ovl_drag_t < 0.15 && oi == ovl_tabs_pad && li >= ovl_drag_l0 && li < ovl_drag_l0 + ovl_drag_n ? (
          ov_set(0.95, 0.72, 0.30, 1);
          gfx_rect(tab_xi - 1, tab_y - 1, tab_w, tab_h + 2, 0);
          gfx_rect(tab_xi, tab_y, tab_w - 2, tab_h, 0);
        );
        // Tab label — larger font for readability
        ov_font(10, 'b');
        is_active ? ov_set(1, 1, 1, 1.0) :
          (has_layer_audio ? ov_set(0.90, 0.92, 0.95, 0.90) : ov_set(0.62, 0.64, 0.68, 0.95));   // an empty layer: dim, readable (2026-10-29)
        sprintf(#_tab_lbl, "L%d", li + 1);
        gfx_measurestr(#_tab_lbl, tw, th);
        gfx_x = tab_xi + ((tab_w - 2 - tw) / 2); gfx_y = tab_y + ((tab_h - th) / 2); gfx_drawstr(#_tab_lbl);
        // Click handling
        _in_tab = mx >= tab_xi && mx <= tab_xi + tab_w - 2 && my >= tab_y && my <= tab_y + tab_h;
        _in_tab && lmb_down ? (
          overlay_layer = li;
          _ov_last_tab = li;   // sticky: next overlay open starts here
        );
        // Right-click layer tab → delete menu (migrated to Swing popup).
        // Capture the layer index in _overlay_clear_layer_target since
        // the popup result fires on a later frame when the loop var li
        // has moved on. oi == overlay_pad in the overlay context, so we
        // don't need to capture it.
        _in_tab && rmb_down ? (
          _has_audio = l_len[oi * MAX_LAYERS + li] > 0;
          _has_audio ? (
            sprintf(#_tab_menu, "Clear Layer %d", li + 1);
            _overlay_clear_layer_target = li;
            swing_popup_open(mx, my, #_tab_menu, SP_POPUP_CALLER_OVERLAY_CLEAR_LAYER);
          );
        );
        li += 1;
      );
      // The tabs as a DROP target for Swing's own browsers, whose drags never become an OS drop: the mini browser's drag
      // and the big browser's drag-over hit-test these (fresh within a quarter second); what a tab means comes from
      // swing_layer_drop_first (the user, 2026-10-22: "a very cool gesture").
      ovl_tabs_t = time_precise(); ovl_tabs_pad = oi;
      ovl_tabs_x = tab_x; ovl_tabs_y = tab_y; ovl_tabs_w = tab_w; ovl_tabs_h = tab_h;
      // Mode selector dropdown (right of tabs)
      // ── SYNTH button: the way back ────────────────────────────────────
      // A synth-only pad's right-click opens the SYNTH view, and its PAD FX
      // button lands in this editor — without this there is no return except
      // closing and right-clicking again. Shown for ANY pad whose synth is
      // on, so a hybrid pad reaches either editor from the other.
      // Sits past the mode selector (which ends at op_x + 220) in a fixed
      // 420-wide panel, so the placement cannot collide.
      // The floating editor only (overlay_pad >= 0): the pad panel has its SYNTH page chip for this (the owner's polish
      // pass, 2026-10-28: one way there, not two side by side).
      ps_enable[oi] > 0.5 && overlay_pad >= 0 ? (
        _ov_synb_x = tab_x + MAX_LAYERS * tab_w + ov_px(100);
        _ov_synb_hov = mx >= _ov_synb_x && mx <= _ov_synb_x + ov_px(62) &&
                       my >= tab_y && my <= tab_y + tab_h;
        _syn_engine_col(ps_engine[oi] | 0, _ov_synb_hov ? 1.0 : 0.55);
        ov_set(_syn_ecr, _syn_ecg, _syn_ecb, 1);
        gfx_rect(_ov_synb_x, tab_y, ov_px(62), tab_h);
        ov_font(10, 'b');
        ov_set(1, 1, 1, _ov_synb_hov ? 1.0 : 0.85);
        gfx_measurestr("SYNTH", _ov_synb_tw, _ov_synb_th);
        gfx_x = _ov_synb_x + (ov_px(62) - _ov_synb_tw) / 2;
        gfx_y = tab_y + (tab_h - _ov_synb_th) / 2;
        gfx_drawstr("SYNTH");
        _ov_synb_hov && lmb_down ? swing_synthview_open(oi);
      );

      mode_x = tab_x + MAX_LAYERS * tab_w + ov_px(10);
      ov_set(0.22, 0.24, 0.30, 1);
      gfx_rect(mode_x, tab_y, ov_px(80), tab_h);
      ov_set(0.50, 0.52, 0.56, 0.7);
      gfx_rect(mode_x, tab_y, ov_px(80), tab_h, 0);
      ov_font(10, 'b');
      ov_set(1, 1, 1, 0.90);
      p_layer_mode[oi] == 1 ? strcpy(#_mode_str, "Vel-Split") :
        (p_layer_mode[oi] == 2 ? strcpy(#_mode_str, "RR") :
        strcpy(#_mode_str, "Sum"));
      gfx_measurestr(#_mode_str, tw, th);
      gfx_x = mode_x + ov_px(6); gfx_y = tab_y + (tab_h - th) * 0.5; gfx_drawstr(#_mode_str);
      mx >= mode_x && mx <= mode_x + ov_px(80) && my >= tab_y && my <= tab_y + tab_h && lmb_down ? (
        swing_popup_open(mx, my, "Vel-Split|Round-Robin|Sum", SP_POPUP_CALLER_OVERLAY_LAYER_MODE);
      );
      swing_popup_result > 0 && swing_popup_caller_id == SP_POPUP_CALLER_OVERLAY_LAYER_MODE ? (
        resp = swing_popup_result;
        swing_popup_result = 0;
        resp > 0 ? (
          p_layer_mode[oi] = resp; // 1=Vel-Split, 2=RR, 3=Sum
          // Mode change resets the round-robin cursor: when the user
          // switches into RR (or out of it and back), the next hit must
          // start from layer 1, not wherever the cursor was sitting from
          // a previous RR pass. Harmless when mode != RR (cursor is
          // unread in Sum/Vel-Split).
          p_rr_idx[oi] = 0;
          // A mode change never promotes a plain pad (it has nothing to sum or
          // split yet, and promoting a pad longer than a layer cuts it):
          // swing_pad_promote runs when a layer >= 1 lands
          // (Spec_Swing_Long_Pad_Layer_Cap).
          // Auto-assign even vel-split ranges when switching to Vel-Split
          // (only if all layers still have default 0-1 ranges)
          resp == 1 && p_layer_cnt[oi] > 1 ? (
            _all_default = 1; _ncnt = p_layer_cnt[oi];
            li = 0; loop(_ncnt,
              _base = oi * MAX_LAYERS + li;
              (l_vel_lo[_base] > 0.001 || l_vel_hi[_base] < 0.999) ? _all_default = 0;
              li += 1;
            );
            _all_default ? (
              li = 0; loop(_ncnt,
                _base = oi * MAX_LAYERS + li;
                l_vel_lo[_base] = li / _ncnt;
                l_vel_hi[_base] = (li + 1) / _ncnt;
                li += 1;
              );
            );
          );
          mark_dirty_pad(oi);
        );
      );
      swing_popup_result == -1 && swing_popup_caller_id == SP_POPUP_CALLER_OVERLAY_LAYER_MODE ? (
        swing_popup_result = 0;
      );
      // CLEAR-LAYER popup result handler — uses oi (= overlay_pad) and the
      // captured layer index _overlay_clear_layer_target (saved at click
      // time since the layer loop var has long since iterated past).
      swing_popup_result > 0 && swing_popup_caller_id == SP_POPUP_CALLER_OVERLAY_CLEAR_LAYER ? (
        swing_popup_result = 0;
        gmem[KIT_GMEM_BRIDGE_ALIVE] > 0 && gmem[KIT_GMEM_CMD] == 0 ? (
          // UNDO_DESC=7 → "Swing: Clear Layer" in the bridge.
          gmem[KIT_GMEM_UNDO_DESC] = 7; gmem[KIT_GMEM_CMD] = 46;
          _undo_pending = 3; _undo_pad = oi; _undo_layer = _overlay_clear_layer_target;
        ) : (
          // the layer, or a plain pad's sample (the Clear Layer button asks through this menu too, 2026-10-28, and a
          // plain pad's L1 is its one sample): the one copy the bridge's acked path runs (rk_swing_core, LIB314)
          clear_layer_eff(oi, _overlay_clear_layer_target);
          p_rr_idx[oi] = 0;   // the RR sequence changed: the next hit starts at position 1
          s_dirty[oi] = 1; mark_dirty_pad(oi);
        );
      );
      swing_popup_result == -1 && swing_popup_caller_id == SP_POPUP_CALLER_OVERLAY_CLEAR_LAYER ? (
        swing_popup_result = 0;
      );

      // Per-layer mode controls (below mode selector, with breathing room).
      // SYN tab: none of these apply (the SYN panel has its own level/vel) —
      // and overlay_layer == MAX_LAYERS must NEVER index the l_* arrays.
      // 6 under the tabs (10 until 2026-10-29, the owner: "tight and lose should not be overlapping the wave drop down
      // panel": the row ran to op_y + 100, the WAVE bar's top, and Vel-Split's 24 px bar 2 past it): the rows now end 4
      // above the bar (Vel-Split's 2)
      ctrl_y = tab_y + tab_h + ov_px(6);
      ovl_ctrl_b = ctrl_y;   // the row's bottom, each mode's below (for the rig: above the WAVE bar, ovl_wbar_y)
      overlay_layer < MAX_LAYERS ? (
      _cur_lidx = oi * MAX_LAYERS + overlay_layer;
      ov_font(11, 0);

      p_layer_mode[oi] == 1 ? (
        // Vel-Split: horizontal range bar with draggable Lo/Hi handles
        _vb_x = tab_x; _vb_w = op_w - ov_px(30); _vb_h = ov_px(24); ovl_ctrl_b = ctrl_y + _vb_h;
        _vlo_n = l_vel_lo[_cur_lidx]; _vhi_n = l_vel_hi[_cur_lidx];
        _vlo_px = _vb_x + (_vlo_n * _vb_w)|0;
        _vhi_px = _vb_x + (_vhi_n * _vb_w)|0;
        // Track background (full 0-127 range)
        ov_set(0.12, 0.12, 0.15, 1); gfx_rect(_vb_x, ctrl_y, _vb_w, _vb_h);
        // Active range fill
        ov_set(0.30, 0.55, 0.75, 0.6);
        gfx_rect(_vlo_px, ctrl_y, max(1, _vhi_px - _vlo_px), _vb_h);
        // Lo handle
        ov_set(0.85, 0.55, 0.20, 1); gfx_rect(_vlo_px - ov_px(2), ctrl_y, ov_px(5), _vb_h);
        // Hi handle
        ov_set(0.30, 0.70, 0.85, 1); gfx_rect(_vhi_px - ov_px(2), ctrl_y, ov_px(5), _vb_h);
        // Lo drag
        _near_lo = abs(mx - _vlo_px) < ov_px(8) && my >= ctrl_y - 2 && my <= ctrl_y + _vb_h + 2;
        _near_hi = abs(mx - _vhi_px) < ov_px(8) && my >= ctrl_y - 2 && my <= ctrl_y + _vb_h + 2;
        active_id == 490 ? ( LMB ? (
          l_vel_lo[_cur_lidx] = max(0, min(l_vel_hi[_cur_lidx] - 1/127,
            (mx - _vb_x) / _vb_w)); mark_dirty_pad(oi);
        ) : active_id = -1; );
        active_id == 491 ? ( LMB ? (
          l_vel_hi[_cur_lidx] = max(l_vel_lo[_cur_lidx] + 1/127, min(1.0,
            (mx - _vb_x) / _vb_w)); mark_dirty_pad(oi);
        ) : active_id = -1; );
        lmb_down && active_id < 0 ? (
          _near_lo && (!_near_hi || abs(mx - _vlo_px) <= abs(mx - _vhi_px)) ? active_id = 490 :
          _near_hi ? active_id = 491;
        );
        // The label: one caption at the bar's left, "VEL lo-hi" (the owner's polish pass, 2026-10-28: a lone "102" by
        // the low handle read as nothing, and the high number hid whenever the range ran to 127)
        ov_font(10, 0);   // regular: bold 9-10 px digits misread (wiki 4.7)
        sprintf(#_vr, "VEL %d-%d", (_vlo_n * 127)|0, (_vhi_n * 127)|0);
        gfx_measurestr(#_vr, tw, th);
        ov_set(0, 0, 0, 0.45); gfx_rect(_vb_x + ov_px(3), ctrl_y + (_vb_h - th) / 2 - 1, tw + ov_px(6), th + 2);
        ov_set(1, 1, 1, 0.92);
        gfx_x = _vb_x + ov_px(6); gfx_y = ctrl_y + (_vb_h - th) / 2; gfx_drawstr(#_vr);
      );

      p_layer_mode[oi] == 2 ? (
        // Round-Robin: show order for current layer
        _rr_ord = (l_rr_order[_cur_lidx])|0;
        ov_font(11, 'b');
        ov_set(0.8, 0.8, 0.8, 0.9);
        sprintf(#_rr, "Order: %d", _rr_ord + 1);
        gfx_x = tab_x; gfx_y = ctrl_y + ov_px(2); gfx_drawstr(#_rr);
        _rr_bw = ov_px(26); _rr_bh = ov_px(22); ovl_ctrl_b = ctrl_y + _rr_bh;
        // Order -
        _btn_x = tab_x + ov_px(80);
        ov_set(0.30, 0.32, 0.36, 1); gfx_rect(_btn_x, ctrl_y, _rr_bw, _rr_bh);
        ov_set(0.45, 0.47, 0.50, 0.7); gfx_rect(_btn_x, ctrl_y, _rr_bw, _rr_bh, 0);
        gfx_measurestr("-", tw, th);
        ov_set(1,1,1,0.9); gfx_x = _btn_x + (_rr_bw - tw) * 0.5; gfx_y = ctrl_y + (_rr_bh - th) * 0.5; gfx_drawstr("-");
        mx >= _btn_x && mx <= _btn_x + _rr_bw && my >= ctrl_y && my <= ctrl_y + _rr_bh && lmb_down ? (
          swing_grid_rr_order_step(oi, _cur_lidx, -1);
          // Reorder resets the cursor: the user reordered the sequence,
          // so the next hit must start from position 1 of the new order.
          p_rr_idx[oi] = 0;
          mark_dirty_pad(oi);
        );
        // Order +
        _btn_x += ov_px(30);
        ov_set(0.30, 0.32, 0.36, 1); gfx_rect(_btn_x, ctrl_y, _rr_bw, _rr_bh);
        ov_set(0.45, 0.47, 0.50, 0.7); gfx_rect(_btn_x, ctrl_y, _rr_bw, _rr_bh, 0);
        gfx_measurestr("+", tw, th);
        ov_set(1,1,1,0.9); gfx_x = _btn_x + (_rr_bw - tw) * 0.5; gfx_y = ctrl_y + (_rr_bh - th) * 0.5; gfx_drawstr("+");
        mx >= _btn_x && mx <= _btn_x + _rr_bw && my >= ctrl_y && my <= ctrl_y + _rr_bh && lmb_down ? (
          swing_grid_rr_order_step(oi, _cur_lidx, 1);
          p_rr_idx[oi] = 0;
          mark_dirty_pad(oi);
        );
      );

      p_layer_mode[oi] == 3 ? (
        // Sum: tight/loose slider. Laid out from the right (2026-10-28, the editor's zoom): the VOL knob and its dB at the
        // editor's right edge, TIGHT at the left, and the slider takes what is between (it was 120 px from a fixed x, and
        // the row ran past the editor's edge at the zoom)
        _sl_h = ov_px(22);
        _vl_r = ov_px(13);
        ovl_ctrl_b = max(ctrl_y + _sl_h, ctrl_y + ov_px(8) + _vl_r);   // the slider's bottom or the VOL knob's
        ov_font(11, 'b'); gfx_measurestr("+00.0 dB", _vldb_w, _vldb_h);
        _vl_cx = op_x + op_w - ov_px(10) - _vldb_w - ov_px(6) - _vl_r;
        ov_font(12, 'b'); gfx_measurestr("VOL", _vl_tw, _vl_th);
        _vl_lbl_x = _vl_cx - _vl_r - ov_px(6) - _vl_tw;
        ov_font(11, 'b');
        ov_set(0.8, 0.8, 0.8, 0.9);
        gfx_measurestr("TIGHT", tw, th); _sl_lh = th;
        gfx_x = tab_x; gfx_y = ctrl_y + (_sl_h - th) * 0.5; gfx_drawstr("TIGHT");
        // Slider bar
        _sl_x = tab_x + tw + ov_px(8);
        gfx_measurestr("LOOSE", tw, th);
        _sl_w = max(ov_px(40), _vl_lbl_x - ov_px(14) - tw - ov_px(6) - _sl_x);
        ov_set(0.20, 0.22, 0.26, 1); gfx_rect(_sl_x, ctrl_y, _sl_w, _sl_h);
        _sl_fill = (p_sum_tight[oi] * _sl_w)|0;
        ov_set(0.50, 0.35, 0.75, 0.7); gfx_rect(_sl_x, ctrl_y, _sl_fill, _sl_h);
        // Thumb
        _sl_fill > 0 ? (
          ov_set(0.70, 0.50, 1.0, 1.0);
          gfx_rect(_sl_x + _sl_fill - 1, ctrl_y, 3, _sl_h);
        );
        // "LOOSE" label on right
        ov_set(0.8, 0.8, 0.8, 0.9);
        gfx_x = _sl_x + _sl_w + ov_px(6); gfx_y = ctrl_y + (_sl_h - _sl_lh) * 0.5; gfx_drawstr("LOOSE");
        // Interaction: drag
        _in_tl = mx >= _sl_x && mx <= _sl_x + _sl_w && my >= ctrl_y && my <= ctrl_y + _sl_h;
        active_id == 295 ? ( LMB ? (
          p_sum_tight[oi] = max(0, min(1.0, (mx - _sl_x) / _sl_w));
          mark_dirty_pad(oi);
        ) : active_id = -1; );
        // Double-click reset to 0 (tight) — must check BEFORE single-click
        active_id == -1 && lmb_down && _in_tl ? (
          _now = time_precise();
          _mix_dbl_id == 295 && (_now - _mix_dbl_time) < DBL_CLICK_T ? (
            p_sum_tight[oi] = 0; mark_dirty_pad(oi); _mix_dbl_id = -1;
          ) : (
            _mix_dbl_time = _now; _mix_dbl_id = 295;
            active_id = 295;
            p_sum_tight[oi] = max(0, min(1.0, (mx - _sl_x) / _sl_w));
            mark_dirty_pad(oi);
          );
        );
        // Scroll wheel
        _in_tl && frame_wheel != 0 ? (
          p_sum_tight[oi] = max(0, min(1.0, p_sum_tight[oi] + frame_wheel * 0.05));
          mark_dirty_pad(oi);
          frame_wheel = 0;   // consumed (2026-10-27, as the swatches')
        );

        // ── Per-layer VOL knob (for current layer tab) ──
        // A KNOB since 2026-10-27 (the owner: "The pad FX Vol knob should be on big ass knob"; it was a 90 px slider
        // bar): the editor's main knob -- the ATK .. OFS row's style (ws_knob, knobs_kbsg) at its radius and in GAIN's
        // green, as big as the row holds (the tabs end at op_y + 68, the waveform starts at op_y + 100 = ctrl_y + 26),
        // the dB beside it. Drag, wheel, double-click or right-click = unity (the lib's gestures, as GAIN's). Its
        // hover / drag memory is the pad's FX knob slot 3, which no knob uses (km_fx: 12 per pad, _ov_draw_fx_knobs
        // takes 0-2 and 5-11), so the overlay's close (_ov_draw_drop_and_close) clears its drag flag with the pad's
        // other knobs'.
        _vl_lidx = oi * MAX_LAYERS + overlay_layer;
        _vl_cy = ctrl_y + ov_px(8);   // op_y + 69 .. op_y + 95 (design px); _vl_r, _vl_cx, _vl_lbl_x: above
        _vl_km = km_fx + (oi * KM_FX_PER_PAD + 3) * KS;
        // "VOL" label — bold, bright
        ov_font(12, 'b');
        ov_set(1.0, 1.0, 1.0, 0.95);
        gfx_x = _vl_lbl_x; gfx_y = ctrl_y + (_sl_h - _vl_th) * 0.5; gfx_drawstr("VOL");
        // in POSITION 0..1 on the gain knobs' taper (unity at 12 o'clock, +12 dB at the top, rk_swing_core swing_kgain_*; 0 .. 2 until 2026-10-29)
        _vl_gp = swing_kgain_g2p(l_gain[_vl_lidx]);
        _vl_nv = ws_knob_interact(_vl_km, _vl_cx, _vl_cy, _vl_r, _vl_gp, 0, 1, KGAIN_UNITY_P);
        _vl_nv != _vl_gp ? ( l_gain[_vl_lidx] = swing_kgain_p2g(_vl_nv); s_dirty[oi] = 1; mark_dirty_pad(oi); );
        ws_knob_draw(_vl_cx, _vl_cy, _vl_r, swing_kgain_g2p(l_gain[_vl_lidx]), 0, 1, 0, _vl_km[0], 0.40, 0.90, 0.45, 0.10, 0.24, 0.12);
        // dB readout right of the knob
        ov_font(11, 'b');
        l_gain[_vl_lidx] < 0.001 ? (
          ov_set(1.0, 1.0, 1.0, 0.7);
          sprintf(#_vldb, "-inf dB");
        ) : (
          _vl_db = 20.0 * log10(max(0.001, l_gain[_vl_lidx]));
          ov_set(1.0, 1.0, 1.0, 0.85);
          sprintf(#_vldb, "%+.1f dB", _vl_db);
        );
        gfx_measurestr(#_vldb, _vldb_w, _vldb_h);
        gfx_x = _vl_cx + _vl_r + ov_px(6); gfx_y = ctrl_y + (_sl_h - _vldb_h) * 0.5;
        gfx_drawstr(#_vldb);
      );

    // Vel range readout -- REMOVED 2026-10-29: "Vel lo-hi" for a layered pad outside Vel-Split (which has its full bar
    // above) was drawn at ctrl_y + 26 (mode 0: ctrl_y), always under the waveform's block, which painted over it -- it was
    // never seen; the WAVE bar there (a see-through bar) let it show through as a ghost (the sandbox pictures).
    );  // end overlay_layer < MAX_LAYERS gate
);

// A file dropped from the OS (Explorer, the Media Explorer) on the editor: onto the layer tab under it, else the layer
// shown. The overlay's own drop; since 2026-10-22 the pad panel's too (it took no drop at all).
function _ov_take_drop() (
    gfx_getdropfile(0, #df) ? (
      (
      // Tukan-style undo: REAPER's automatic chunk diff handles undo
      // via the mark_dirty_pad(oi) call at end of this block. Audio
      // is in @serialize (ser_ver >= 12). No CMD 46/48 dance.
      // Check if drop landed on a specific layer tab (L1-L4) — switch to it
      li = 0; loop(MAX_LAYERS,
        tab_xi = tab_x + li * tab_w;
        mx >= tab_xi && mx <= tab_xi + tab_w - 2 && my >= tab_y && my <= tab_y + tab_h ? (
          overlay_layer = li;
        );
        li += 1;
      );
      // ...or on a strip of the layer mixer: that strip's layer (2026-10-28)
      _ovd_lk = swing_lmix_layer_at(oi, mx, my);
      _ovd_lk >= 0 ? overlay_layer = _ovd_lk;

      // A plain or empty pad with L1 selected: plain load — the whole slot is
      // the sample, no promotion (Spec_Swing_Long_Pad_Layer_Cap). A layered
      // pad's L1, or any L2-L4, goes through the layer loader; a plain pad
      // receiving L2-L4 is promoted (and cut, with the banner) inside
      // swing_ldr_begin.
      // Either loader zeroes the length it replaces, so a sounding pad would cut
      // hard (A-3): end its voices and fade the output first, as the browser's
      // CMD 63/64 paths do (the layer path kills the whole pad's voices too).
      swing_voice_kill_pad_xf(oi);
      overlay_layer == 0 && p_layer_cnt[oi] == 0 ? (
        // The trim and mix are reset BEFORE the load, which can be refused for room (§5.4: the pad keeps its
        // old sample). A refusal puts them back, so the old sample does not come back untrimmed (sweep LIB136).
        _ovd_g = p_gain[oi]; _ovd_p = p_pan[oi]; _ovd_t = p_tune[oi]; _ovd_pl = p_panL[oi]; _ovd_pr = p_panR[oi];
        _ovd_s0 = s_start[oi]; _ovd_s1 = s_end[oi];
        s_len[oi] == 0 ? (
          // Empty pad: reset per-pad mix params so stale kit values don't leak
          // into the new sample. A replace keeps them, as a layer replace does.
          p_gain[oi] = 1.0; p_pan[oi] = 0; p_tune[oi] = 0;
          p_panL[oi] = 1.0; p_panR[oi] = 1.0;
        );
        s_start[oi] = 0; s_end[oi] = 1.0;   // a new sample starts untrimmed
        load_from_path(oi, #df);
        ldr_job1[LDR_F_REFUSED] ? (
          p_gain[oi] = _ovd_g; p_pan[oi] = _ovd_p; p_tune[oi] = _ovd_t; p_panL[oi] = _ovd_pl; p_panR[oi] = _ovd_pr;
          s_start[oi] = _ovd_s0; s_end[oi] = _ovd_s1;
        );
        swing_rcp_post_pad(oi);
        s_dirty[oi] = 1;
      ) : (
        // Layer-aware load — replace the selected layer
        load_layer_from_path(oi, overlay_layer, #df);
        p_layer_mode[oi] == 0 ? ( p_layer_mode[oi] = 3; );
        swing_rcp_post_pad(oi);
        s_dirty[oi] = 1;
      );
      mark_dirty_pad(oi);
      !ldr_job1[LDR_F_REFUSED] ? swing_rup_want(RUP_K_SAMPLE, oi, overlay_layer, -1, 1);   // its REAPER undo point (2026-10-27)
      sync_note_names();
      // The pad's JOB follows its new sample (a native drop never touches the
      // browser, so this is the only place that can classify it) — but LAYER 0
      // only: layers 1..n are velocity/RR variants of the SAME drum and must not
      // re-classify the pad. The browser's load_layer_to_pad draws the same line.
      overlay_layer == 0 ? swing_lcd_padcat_queue_drop(oi);
      overlay_layer == 0 ? swing_lcd_rn_drop_gen += 1;   // A2: and its root note (layer 0 decides it, as CMD 64)
      gfx_getdropfile(-1);
      );  // end drop-processing block
    );
);

function _ov_draw_drop_and_close() (
    // Drag-to-load into overlay pad
    _ov_take_drop();

    // Close on: click X, click outside panel, ESC. overlay_just_opened
    // swallows the LMB edge that OPENED the overlay (SYN chip / Alt+click —
    // same-frame click-through closed it instantly; mirrors the popup's
    // just_opened latch). RMB opens never hit this (different button).
    in_close = mx>=cl_x&&mx<=cl_x+cl_s&&my>=cl_y&&my<=cl_y+cl_s;
    in_panel  = mx>=op_x&&mx<=op_x+op_w&&my>=op_y&&my<=op_y+op_h;
    (_raw_lmb_down && !overlay_just_opened && (in_close || !in_panel)) || _char == 27 ? (
      // Clear knob drag flags (mem[1]) to prevent stuck dragging state (3.1/3.2)
      // Each knob uses KS=16 memory slots; mem[1] is the is_dragging flag.
      _ov_km = km_pads + oi * KM_PER_PAD * KS;
      _ov_ki = 0; loop(KM_PER_PAD, _ov_km[_ov_ki * KS + 1] = 0; _ov_ki += 1;);
      _ov_km = km_fx + oi * KM_FX_PER_PAD * KS;
      _ov_ki = 0; loop(KM_FX_PER_PAD, _ov_km[_ov_ki * KS + 1] = 0; _ov_ki += 1;);
      _ov_km = km_syn + oi * KM_SYN_PER_PAD * KS;
      _ov_ki = 0; loop(KM_SYN_PER_PAD, _ov_km[_ov_ki * KS + 1] = 0; _ov_ki += 1;);
      overlay_pad = -1; active_id = -1; overlay_layer = 0;
    );
    overlay_just_opened = 0;   // latch consumed — close arms from next frame
);

function swing_grid_draw_overlay() (
    oi = overlay_pad;
    // col_rgba holds the bank on screen's sixteen tiles; oi is a slot (a bank switch closes the editor, so its pad is on screen)
    _cb = swing_pad_tile(oi) * 3; pr = col_rgba[_cb]; pgg = col_rgba[_cb+1]; pb = col_rgba[_cb+2];

    // Backdrop — covers entire window including header for true modal feel
    ov_set(0, 0, 0, 0.55);
    gfx_rect(0, 0, gfx_w, gfx_h);

    // Panel dimensions: 420 x 560 (+ the layer mixer under the buttons where the window has the room) at the zoom the
    // window holds (swing_ov_fk: the user's text size, as far as the editor fits whole; the modal gate reads the same)
    ov_k = swing_ov_fk();
    op_w = swing_ov_w(); op_h = swing_ov_h();
    ov_lmix_h = swing_ov_lmix_fits() ? swing_lmix_h() : 0;   // the mixer, or folded its bar (design px)
    ov_lmix_on = ov_lmix_h > 0 && !lmix_fold;                 // the whole mixer: GAIN / PAN leave the knob row for its PAD strip
    op_x = (gfx_w - op_w) / 2;
    op_y = 28 + ((ui_bot - 28 - op_h) / 2);   // centred over the face (ui_bot: the sequencer's panel is under it); the gate's rect uses the same line

    // Restore mouse state inside overlay panel (was suppressed by modal gate)
    _in_ov ? (
      lmb_down = _ov_lmb_down; rmb_down = _ov_rmb_down;
      LMB = _ov_LMB; RMB = _ov_RMB;
      frame_wheel = _ov_wheel;
    );

    _ov_draw_header_and_colorpicker();
    // Safety: stale SYN pseudo-tab index from a pre-view build (serialized
    // _ov_last_tab or an interrupted session) — clamp to L1. The synth editor
    // is the SYNTH big view now; the overlay owns layers only.
    overlay_layer >= MAX_LAYERS ? overlay_layer = 0;
    _ov_draw_layers_and_mode();
    ov_wf_grow = 1;   // one column: the waveform takes the room left free above the buttons
    _ov_draw_waveform_and_adsr();
    _ov_draw_eq_and_filters();
    _ov_draw_fx_knobs();
    _ov_draw_buttons();
    ov_lmix_h > 0 ? swing_lmix_draw(op_x + ov_px(10), ov_mix_y, op_w - ov_px(20));   // under the buttons (ov_mix_y: _ov_draw_buttons)
    swing_grid_opt_draw();   // the OPTIONS sheet, last: on top (it gives back the mouse the header parked)
    _ov_draw_drop_and_close();
);
