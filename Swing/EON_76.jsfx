desc:EON 76 Bus Compressor
//tags: EON ReaKit bus compressor glue parallel smash
options:gfx_hz=60 gfx_idle no_meter gmem=Swing_Media_Transfer
// EON Studios — EON 76
// Stereo bus compressor around the house rk_compressor engine (Prism CLEAN/BUS
// VCA topology — the same core as Swing's master comp). Two hats, one plugin:
// serial glue on the multi-out drum submix, and the smasher on the EON Smash
// Return (parallel compression; the return fader is the blend).
//
// Native look = black 1176-style panel; under a live One Rack theme the panel,
// labels, accents, knob style and VU face all follow the suite (rk_theme).
//
// Smash-return link: when the strip-sync companion pushes a registry slot into
// slider9 (Link Slot), this instance publishes a param echo + GR onto its
// GS_BC_LINK row and consumes knob edits from the return viewer's deck. The
// drum-bus instance stays at slot -1 and never touches the band. All link I/O
// runs in @block, so it works with this UI closed.

slider1:ebc_thresh=-12<-40,0,0.1>-Threshold (dB)
slider2:ebc_ratio=4<1,20,0.1>-Ratio
slider3:ebc_attack=10<0.1,100,0.1>-Attack (ms)
slider4:ebc_release=200<10,1000,1>-Release (ms)
slider5:ebc_knee=6<0,12,0.5>-Knee (dB)
slider6:ebc_makeup=0<-12,12,0.1>-Makeup (dB)
slider7:ebc_mix=1<0,1,0.01>-Mix
slider8:ebc_bypass=0<0,1,1>-Bypass
slider9:ebc_link_slot=-1<-1,64,1>-Link Slot (internal; Lua-pushed)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import libs/rk_compressor.jsfx-inc
import libs/knobs_kbsg.jsfx-inc
import libs/vu_kbsg.jsfx-inc
import libs/rk_theme.jsfx-inc

@init
ext_noinit = 1.0;
gfx_ext_retina == 0 ? gfx_ext_retina = 1;
// Embed support — bit 0x100 MUST be set in @init (REAPER 7.45+).
// 0x400 = suppress REAPER's hover tooltip over the MCP embed (7.79+).
gfx_ext_flags |= 0x100 | 0x400;

M_LN10_20 = 8.68588963806503655302257837833210;  // 20/ln(10)

// ── Smash-return viewer link band ──────────────────────────────────────────
// Row per registry slot. MUST match EON_FX_Return_View.jsfx. Declared in
// .refs/swing_gmem_bridge_protocol.md (26170000-26171535, 64 slots x 24).
//   +0 heartbeat (bumped per @block) · +1..8 param echo (thresh, ratio, attack,
//   release, knee, makeup, mix, bypass) · +9 GR dB · +16 cmd_seq · +17 cmd_param
//   (1..8, same order as the echo) · +18 cmd_val. Seq bumped LAST by the writer.
GS_BC_LINK_BASE   = 26170000;
GS_BC_LINK_STRIDE = 24;
BC_OFF_HB    = 0;
BC_OFF_ECHO  = 1;
BC_OFF_GR    = 9;
BC_OFF_SEQ   = 16;
BC_OFF_PARAM = 17;
BC_OFF_VAL   = 18;

// vu_kbsg reserves memory addresses 0-437 for its scale + theme tables, so our
// own allocations start at 440 (house convention — Drum Strip / 1175).
freemem = 440;
freemem = cmp_init(freemem);          // engine state + 128-word GR history
KS = 16;                              // knobs_kbsg per-knob state stride
ebc_km = freemem; freemem += 8 * KS;  // 6 face knobs + bypass + spare

gr_vu.vu_init_gr(61);                 // house needle speed (ExpressBus/1175)

// Copy the slider params onto the engine globals (clamped — API writes can be
// out of range) . Call before cmp_recalc().
function ebc_params_to_engine() (
  cmp_thresh  = max(-40, min(0, ebc_thresh));
  cmp_ratio   = max(1, min(20, ebc_ratio));
  cmp_attack  = max(0.1, min(100, ebc_attack));
  cmp_release = max(10, min(1000, ebc_release));
  cmp_knee    = max(0, min(12, ebc_knee));
  cmp_makeup  = max(-12, min(12, ebc_makeup));
  cmp_mix     = max(0, min(1, ebc_mix));
);
function ebc_recalc() ( ebc_params_to_engine(); cmp_recalc(); );

// Needle position → GR dB (ExpressBus physics_gr_db shape): invert the vu lib's
// GR ballistics back to a decibel value for the readout + needle draw.
function ebc_gr_db() local(ratio_est) (
  gr_vu.nd_pos < 0.001 ? 0 : (
    ratio_est = 1 - (gr_vu.nd_pos * 0.1 + gr_vu.vu_offset) / gr_vu.vu_fact_up;
    ratio_est > 0.001 ? log(ratio_est) * M_LN10_20 : -40;
  );
);

// One Rack theme (gmem GS_THEME_CUR, 1..14) → vu_kbsg face (zm_theme 0..10).
// Same mapping as Drum Strip's strip_vu_theme.
function ebc_vu_theme() local(t) (
  t = gmem[GS_THEME_CUR] | 0;
  t == 1  ? 0  :    // EON cream → Classic
  t == 2  ? 1  :    // Dark → Knight
  t == 3  ? 6  :    // Light → Ivory
  t == 7  ? 7  :    // SSL → Trooper
  t == 8  ? 5  :    // Neve → Warm
  t == 9  ? 1  :    // API → Knight
  t == 10 ? 5  :    // Tube → Warm
  t == 11 ? 6  :    // Ableton → Ivory
  t == 12 ? 1  :    // FL → Knight
  t == 13 ? 1  :    // Pro Tools → Knight
  t == 14 ? 6  :    // PT Light → Ivory
  0;                // REAPER modes / idle → Classic
);

// Recessed LED value window centred on cx: dark inset + tinted hairline border,
// #ebc_val drawn in the tint. Same visual grammar as the return-deck readouts.
function ebc_readout(cx, ry, rw, rh, tr, tg, tb) local(tw, th) (
  gfx_set(0, 0, 0, 0.50);
  gfx_rect(cx - rw * 0.5, ry, rw, rh);
  gfx_set(tr, tg, tb, 0.25);
  gfx_rect(cx - rw * 0.5, ry, rw, rh, 0);
  gfx_setfont(6, "Arial", max(8, floor(rh * 0.62)), 'b');
  gfx_measurestr(#ebc_val, tw, th);
  gfx_set(tr, tg, tb, 0.95);
  gfx_x = cx - tw * 0.5; gfx_y = ry + floor((rh - th) * 0.5);
  gfx_drawstr(#ebc_val);
);

// Engraved hairline separator across the faceplate.
function ebc_sep(y) (
  gfx_set(0, 0, 0, 0.45);          gfx_rect(floor(24 * sc), y,     W - floor(48 * sc), 1);
  gfx_set(1, 1, 1, 0.05);          gfx_rect(floor(24 * sc), y + 1, W - floor(48 * sc), 1);
);

// Slotted rack-ear screw (same chrome as the return viewer).
function ebc_screw(cx, cy, r) (
  gfx_set(0.05, 0.05, 0.06, 1); gfx_circle(cx, cy, r, 1, 1);
  gfx_set(0.42, 0.44, 0.48, 1); gfx_circle(cx, cy, r * 0.7, 1, 1);
  gfx_set(0.12, 0.12, 0.14, 1);
  gfx_line(cx - r * 0.5, cy, cx + r * 0.5, cy);
);

@slider
ebc_recalc();

@block
// Sample-rate change → coefficients (attack/release/GR-smoother are srate-derived).
srate != ebc_last_srate ? ( ebc_recalc(); ebc_last_srate = srate; );

// ── Smash-return link (slot >= 0 only; the drum-bus instance never binds) ──
ebc_link_slot >= 0 ? (
  _bc_row = GS_BC_LINK_BASE + (ebc_link_slot | 0) * GS_BC_LINK_STRIDE;
  // Consume one deck edit per block. Adopt (don't apply) the first seq seen —
  // gmem persists across plugin reloads, so a stale mailbox must not fire; a
  // virgin row's seq is 0 and never fires (same discipline as Swing's strip CMD).
  _bc_seq = gmem[_bc_row + BC_OFF_SEQ];
  ebc_cmd_inited ? (
    _bc_seq != ebc_cmd_last && _bc_seq != 0 ? (
      ebc_cmd_last = _bc_seq;
      _bc_p = gmem[_bc_row + BC_OFF_PARAM] | 0;
      _bc_v = gmem[_bc_row + BC_OFF_VAL];
      _bc_p == 1 ? ( ebc_thresh  = max(-40, min(0, _bc_v));    slider_automate(1); ) :
      _bc_p == 2 ? ( ebc_ratio   = max(1, min(20, _bc_v));     slider_automate(2); ) :
      _bc_p == 3 ? ( ebc_attack  = max(0.1, min(100, _bc_v));  slider_automate(4); ) :
      _bc_p == 4 ? ( ebc_release = max(10, min(1000, _bc_v));  slider_automate(8); ) :
      _bc_p == 5 ? ( ebc_knee    = max(0, min(12, _bc_v));     slider_automate(16); ) :
      _bc_p == 6 ? ( ebc_makeup  = max(-12, min(12, _bc_v));   slider_automate(32); ) :
      _bc_p == 7 ? ( ebc_mix     = max(0, min(1, _bc_v));      slider_automate(64); ) :
      _bc_p == 8 ? ( ebc_bypass  = _bc_v >= 0.5;               slider_automate(128); );
      ebc_recalc();
    ) : ( ebc_cmd_last = _bc_seq; );
  ) : ( ebc_cmd_last = _bc_seq; ebc_cmd_inited = 1; );
  // Publish the echo the viewer deck draws from + a heartbeat it health-checks.
  gmem[_bc_row + BC_OFF_ECHO]     = ebc_thresh;
  gmem[_bc_row + BC_OFF_ECHO + 1] = ebc_ratio;
  gmem[_bc_row + BC_OFF_ECHO + 2] = ebc_attack;
  gmem[_bc_row + BC_OFF_ECHO + 3] = ebc_release;
  gmem[_bc_row + BC_OFF_ECHO + 4] = ebc_knee;
  gmem[_bc_row + BC_OFF_ECHO + 5] = ebc_makeup;
  gmem[_bc_row + BC_OFF_ECHO + 6] = ebc_mix;
  gmem[_bc_row + BC_OFF_ECHO + 7] = ebc_bypass;
  gmem[_bc_row + BC_OFF_GR]       = cmp_gr_db;
  ebc_hb += 1;
  gmem[_bc_row + BC_OFF_HB] = ebc_hb;
);

@sample
ebc_bypass ? (
  gr_vu.vu_gr_sample(1);   // needle relaxes to 0 GR; audio passes untouched
) : (
  cmp_process(spl0, spl1);
  spl0 = cmp_outL;
  spl1 = cmp_outR;
  // Feed the needle the engine's cached LINEAR gain (1.0 = no reduction) —
  // @sample-safe (pure mult/add in the vu lib) and immune to cmp_recalc()
  // zeroing the engine's own display smoother on every param move.
  gr_vu.vu_gr_sample(cmp_last_lin);
);

@gfx 420 900
// ⚠️ @gfx sets the EMBED ASPECT (house rule: portrait = tall MCP strip, the
// Drum Strip/1175 trick — 420x900 ≈ Drum Strip's 300x700 ratio, so the two
// strips sit at matching heights in the mixer). The floating layout stretches
// its section gaps to fill whatever height the window actually has.
// ── Frame globals (knobs_kbsg caller contract) ──────────────────────────────
micro = gfx_ext_flags & 1;
gfx_getchar();
ret = max(1, gfx_ext_retina);
W = gfx_w; H = gfx_h;
sc = micro ? ret : max(0.7, min(W / 420, H / 560));
// Floating vertical stretch — EXACT-FILL: distribute the remaining window
// height into the section gaps so the stack always lands just above the brand
// row (no dead bottom at any window size; element sizes stay on sc). Solved
// from: brand_row = vu_bot + 244*sc*vg + kr(30sc) + bypass(24sc), where 244 =
// the design gap budget (39+60+105+28+12). Computed after _vu_bot below.
_vg = 1;
mx = mouse_x; my = mouse_y;
LMB = mouse_cap & 1;
lmb_down = LMB && !prev_LMB;
RMB = mouse_cap & 2;
rmb_down = RMB && !prev_RMB;
CTRL  = mouse_cap & 4;
SHIFT = mouse_cap & 8;
dt = min(time_precise() - ebc_lt, 0.05); ebc_lt = time_precise();
hv_speed = 11;
frame_wheel = mouse_wheel / 120;
tau = 2 * $pi;
micro ? gfx_ext_flags = (gfx_ext_flags | 0x200) - 0x200;
// Embedded wheel events arrive with a STALE/zero mouse position, so every
// hover test misses and the wheel does nothing. Remember the cursor on normal
// frames, reuse it on wheel frames (Drum Strip's user-verified fix).
micro ? (
  frame_wheel == 0 ? ( ebc_hmx = mx; ebc_hmy = my; )
                   : ( mx = ebc_hmx; my = ebc_hmy; );
);

// ── Theme (One Rack): live band re-skins panel/text/accent/knobs/VU face;
// bridge idle → the native black 1176 look. Else-branch restores the native
// literals every frame so theme-off never leaves stale colours.
rk_theme_apply();
_th_live = gmem[GS_THEME_ID] > 0;
_th_live ? (
  ebc_bg_r = gmem[GS_THEME_BASE + 0]; ebc_bg_g = gmem[GS_THEME_BASE + 1]; ebc_bg_b = gmem[GS_THEME_BASE + 2];
  ebc_pn_r = gmem[GS_THEME_BASE + 3]; ebc_pn_g = gmem[GS_THEME_BASE + 4]; ebc_pn_b = gmem[GS_THEME_BASE + 5];
  ebc_tx_r = gmem[GS_THEME_BASE + 6]; ebc_tx_g = gmem[GS_THEME_BASE + 7]; ebc_tx_b = gmem[GS_THEME_BASE + 8];
  ebc_td_r = gmem[GS_THEME_BASE + 9]; ebc_td_g = gmem[GS_THEME_BASE + 10]; ebc_td_b = gmem[GS_THEME_BASE + 11];
  ebc_ac_r = gmem[GS_THEME_BASE + 12]; ebc_ac_g = gmem[GS_THEME_BASE + 13]; ebc_ac_b = gmem[GS_THEME_BASE + 14];
) : (
  ebc_bg_r = 0.090; ebc_bg_g = 0.094; ebc_bg_b = 0.110;   // black 1176 panel
  ebc_pn_r = 0.135; ebc_pn_g = 0.140; ebc_pn_b = 0.160;
  ebc_tx_r = 0.930; ebc_tx_g = 0.935; ebc_tx_b = 0.950;
  ebc_td_r = 0.555; ebc_td_g = 0.575; ebc_td_b = 0.615;
  ebc_ac_r = 0.905; ebc_ac_g = 0.915; ebc_ac_b = 0.940;   // white pointers/arcs
);
sk_kp = (_th_live && gmem[GS_THEME_KNOB_P] >= 1) ? (gmem[GS_THEME_KNOB_P] | 0) : 1;
zm_theme = _th_live ? ebc_vu_theme() : 0;

// ── Faceplate ────────────────────────────────────────────────────────────────
gfx_set(ebc_bg_r, ebc_bg_g, ebc_bg_b, 1); gfx_rect(0, 0, W, H);
gfx_set(1, 1, 1, 0.03); gfx_rect(0, 0, W, floor(H * 0.34));

show_chrome = !micro && H >= floor(96 * ret);
show_chrome ? (
  gfx_setfont(3, "Arial", max(11, floor(18 * sc)), 'b');
  gfx_set(ebc_tx_r, ebc_tx_g, ebc_tx_b, 1);
  gfx_x = floor(16 * sc); gfx_y = floor(9 * sc);
  gfx_drawstr("EON 76");
  gfx_setfont(4, "Arial", max(8, floor(10 * sc)));
  gfx_set(ebc_td_r, ebc_td_g, ebc_td_b, 0.9);
  gfx_drawstr("  BUS COMPRESSOR");
  ebc_screw(floor(10 * sc),     floor(11 * sc),     floor(4 * sc));
  ebc_screw(W - floor(10 * sc), floor(11 * sc),     floor(4 * sc));
  ebc_screw(floor(10 * sc),     H - floor(11 * sc), floor(4 * sc));
  ebc_screw(W - floor(10 * sc), H - floor(11 * sc), floor(4 * sc));
  // theme chip (floating only — the lib refuses the dropdown embedded anyway)
  ebc_chip_used = rkth_chip(W - floor(96 * sc), floor(8 * sc), floor(58 * sc), floor(15 * sc),
                            mx, my, lmb_down, rmb_down, frame_wheel, floor(14 * sc), max(8, floor(9 * sc)));
);

// ── Geometry ─────────────────────────────────────────────────────────────────
// Floating = fixed rack stack (VU · GR window · sep · 2 knob rows · sep ·
// bypass). Embedded = BOTTOM-UP budget: the knob grid anchors to the floor,
// labels/bypass appear as height allows, and the VU takes whatever remains up
// top (hidden when there is no honest room for a needle).
top = show_chrome ? floor(32 * sc) : floor(2 * sc);
_vu_cx = W * 0.5;
_grdb = ebc_bypass ? 0 : ebc_gr_db();
_kp = W / 3;
micro ? (
  // VU FIRST — the needle is the unit's face and always shows; the GR window
  // rides under it when there's slack; the knobs adapt to what remains:
  // a 3x2 grid when tall, a single row of six minis when short (hover shows
  // that knob's value — six always-on values collide at this pitch).
  _vu_show = 1;
  _vu_r  = max(24, floor(min(W / 2.8, H * 0.22)));
  _vu_cy = top + floor(2 * ret) + _vu_r * 1.4;
  _vu_bot = _vu_cy + _vu_r * 0.3;
  // Labeled knob GRID under the meter (Drum Strip's embed grammar: label above,
  // value below): 3 columns when the strip is wide, 2 when narrow; the GR
  // window only when it doesn't starve the grid rows.
  _kcols = W >= floor(150 * ret) ? 3 : 2;
  _krows = 6 / _kcols;
  _bp_show = H >= floor(330 * ret);
  _gr_show = (H - _vu_bot) >= floor(28 * ret) + _krows * floor(40 * ret);
  _kcur = _vu_bot + (_gr_show ? floor(28 * ret) : floor(4 * ret));
  _cellh = (H - _kcur - (_bp_show ? floor(32 * ret) : floor(2 * ret))) / _krows;
  _kr = max(7, floor(min(W / _kcols * 0.30, (_cellh - floor(20 * ret)) * 0.5)));
  _kr = min(_kr, floor(20 * ret));
  _val_show = _cellh >= _kr * 2 + floor(26 * ret);
  _lb_show = 1;
  ebc_sep1 = -1; ebc_sep2 = -1;
) : (
  ebc_krow = 0;
  _vu_show = 1; _gr_show = 1; _lb_show = 1; _bp_show = 1;
  _vu_r  = floor(96 * sc);
  _vu_cy = top + floor(8 * sc) + _vu_r * 1.4;
  _vu_bot = _vu_cy + _vu_r * 0.3;
  _kr  = floor(30 * sc);
  _vg = max(0.85, min(2.75, (H - floor(88 * sc) - _vu_bot) / (244 * sc)));
  ebc_sep1 = _vu_bot + floor(39 * sc * _vg);
  _ky1 = ebc_sep1 + floor(60 * sc * _vg);
  _ky2 = _ky1 + floor(105 * sc * _vg);
  ebc_sep2 = _ky2 + _kr + floor(28 * sc * _vg);
);

// ── GR needle (house VU, GR mode) ───────────────────────────────────────────
_vu_show ? (
  zm_force_floating = 1;
  zm_frame_r = ebc_bg_r; zm_frame_g = ebc_bg_g; zm_frame_b = ebc_bg_b;  // blend bezel into panel
  mtr_vu_real_draw_gr(_vu_cx, _vu_cy, _vu_r, _grdb, -21, gr_vu.over_g > 0);
  zm_force_floating = 0;
  zm_frame_r = -1;
);
_gr_show ? (
  sprintf(#ebc_val, "%.1f dB GR", _grdb);
  ebc_readout(_vu_cx, _vu_bot + (micro ? floor(4 * ret) : floor(9 * sc)),
              floor(min(110 * sc, W - 20)), floor(18 * sc),
              0.82, 0.68, 0.40);   // amber — semantic, stays native
);
ebc_sep1 >= 0 ? ebc_sep(ebc_sep1);

// ── Knobs: THR RAT ATK / REL MKP MIX ────────────────────────────────────────
// Interact in real units; every write pairs slider_automate(2^(N-1)) + recalc.
// Floating: LED value window ABOVE each knob (clear of the knob arc), engraved
// label below. Embedded: plain bright value text, short labels when tall.
ebc_hov = 0;

_ki = 0;
loop(6,
  micro ? (
    _kcx = W / _kcols * (_ki % _kcols) + W / (2 * _kcols);
    _kcy = _kcur + _cellh * ((_ki / _kcols) | 0) + floor(10 * ret) + _kr;
  ) : (
    _kcx = _kp * (_ki % 3) + _kp * 0.5;
    _kcy = _ki < 3 ? _ky1 : _ky2;
  );
  _km  = ebc_km + _ki * KS;
  _ki == 0 ? (
    _nv = ssl_knob_interact(_km, _kcx, _kcy, _kr, ebc_thresh, -40, 0, -12, 0);
    _nv != ebc_thresh ? ( ebc_thresh = _nv; slider_automate(1); ebc_recalc(); );
    _dv = ebc_thresh; _dmin = -40; _dmax = 0; _dsym = 0;
    strcpy(#ebc_lbl, "THRESHOLD"); sprintf(#ebc_val, "%.1fdB", ebc_thresh);
  ) :
  _ki == 1 ? (
    _nv = ssl_knob_interact(_km, _kcx, _kcy, _kr, ebc_ratio, 1, 20, 4, 0);
    _nv != ebc_ratio ? ( ebc_ratio = _nv; slider_automate(2); ebc_recalc(); );
    _dv = ebc_ratio; _dmin = 1; _dmax = 20; _dsym = 0;
    strcpy(#ebc_lbl, "RATIO");
    ebc_ratio >= 20 ? strcpy(#ebc_val, "LIM") : sprintf(#ebc_val, "%.1f:1", ebc_ratio);
  ) :
  _ki == 2 ? (
    _nv = ssl_knob_interact(_km, _kcx, _kcy, _kr, ebc_attack, 0.1, 100, 10, 0);
    _nv != ebc_attack ? ( ebc_attack = _nv; slider_automate(4); ebc_recalc(); );
    _dv = ebc_attack; _dmin = 0.1; _dmax = 100; _dsym = 0;
    strcpy(#ebc_lbl, "ATTACK"); sprintf(#ebc_val, "%.1fms", ebc_attack);
  ) :
  _ki == 3 ? (
    _nv = ssl_knob_interact(_km, _kcx, _kcy, _kr, ebc_release, 10, 1000, 200, 0);
    _nv != ebc_release ? ( ebc_release = _nv; slider_automate(8); ebc_recalc(); );
    _dv = ebc_release; _dmin = 10; _dmax = 1000; _dsym = 0;
    strcpy(#ebc_lbl, "RELEASE"); sprintf(#ebc_val, "%.0fms", ebc_release);
  ) :
  _ki == 4 ? (
    _nv = ssl_knob_interact(_km, _kcx, _kcy, _kr, ebc_makeup, -12, 12, 0, 0);
    _nv != ebc_makeup ? ( ebc_makeup = _nv; slider_automate(32); ebc_recalc(); );
    _dv = ebc_makeup; _dmin = -12; _dmax = 12; _dsym = 1;
    strcpy(#ebc_lbl, "MAKEUP"); sprintf(#ebc_val, "%+.1fdB", ebc_makeup);
  ) : (
    _nv = ssl_knob_interact(_km, _kcx, _kcy, _kr, ebc_mix, 0, 1, 1, 0);
    _nv != ebc_mix ? ( ebc_mix = _nv; slider_automate(64); ebc_recalc(); );
    _dv = ebc_mix; _dmin = 0; _dmax = 1; _dsym = 0;
    strcpy(#ebc_lbl, "MIX"); sprintf(#ebc_val, "%.0f%%", ebc_mix * 100);
  );
  // Native caps brightened so they read on the black panel (the old 0.24 grey
  // vanished, especially at embed sizes); themed caps take the accent.
  _th_live ? ( sk_kbr = ebc_ac_r; sk_kbg = ebc_ac_g; sk_kbb = ebc_ac_b; )
           : ( sk_kbr = 0.31; sk_kbg = 0.32; sk_kbb = 0.36; );
  rk_knob_draw(sk_kp, _kcx, _kcy, _kr, _dv, _dmin, _dmax, _dsym, _km[0],
               sk_kbr, sk_kbg, sk_kbb, 0, ebc_bg_r, ebc_bg_g, ebc_bg_b);
  micro ? (
    // Drum Strip grid grammar: value BELOW the knob — always when the cell
    // affords it, hover-only when squeezed (kept clear of the next row's label).
    (_val_show || _km[6]) ? (
      gfx_setfont(6, "Arial", max(7, floor(8 * ret)), 'b');
      gfx_set(ebc_tx_r, ebc_tx_g, ebc_tx_b, 0.95);
      gfx_measurestr(#ebc_val, _tw, _th);
      gfx_x = max(floor(2 * ret), min(W - _tw - floor(2 * ret), _kcx - _tw * 0.5));
      gfx_y = _kcy + _kr + floor(2 * ret);
      gfx_drawstr(#ebc_val);
    );
  ) : (
    // LED value window above the knob — clear of the arc, deck-matched look
    ebc_readout(_kcx, _kcy - _kr - floor(28 * sc), floor(64 * sc), floor(16 * sc),
                ebc_ac_r, ebc_ac_g, ebc_ac_b);
  );
  micro ? (
    _ki == 0 ? strcpy(#ebc_lbl, "THR") : _ki == 1 ? strcpy(#ebc_lbl, "RAT") :
    _ki == 2 ? strcpy(#ebc_lbl, "ATK") : _ki == 3 ? strcpy(#ebc_lbl, "REL") :
    _ki == 4 ? strcpy(#ebc_lbl, "MKP") :            strcpy(#ebc_lbl, "MIX");
  );
  _lb_show ? (
    gfx_setfont(5, "Arial", max(7, floor((micro ? 7 * ret : 9 * sc))), 'b');
    gfx_set(ebc_td_r, ebc_td_g, ebc_td_b, 0.9);
    gfx_measurestr(#ebc_lbl, _tw, _th);
    gfx_x = _kcx - _tw * 0.5;
    gfx_y = micro ? _kcy - _kr - floor(9 * ret) : _kcy + _kr + floor(6 * sc);
    gfx_drawstr(#ebc_lbl);
  );
  _km[6] ? ebc_hov = 1;
  _ki += 1;
);

// ── BYPASS pill (hidden in short embeds — no honest room below the knobs) ──
ebc_sep2 >= 0 ? ebc_sep(ebc_sep2);
_bp_show ? (
  _bp_w = floor(96 * sc); _bp_h = floor(24 * sc);
  _bp_x = W * 0.5 - _bp_w * 0.5;
  _bp_y = micro ? H - _bp_h - floor(4 * ret) : ebc_sep2 + floor(12 * sc * _vg);
  _bp_hov = mx >= _bp_x && mx <= _bp_x + _bp_w && my >= _bp_y && my <= _bp_y + _bp_h;
  _bp_hov && lmb_down ? (
    ebc_bypass = !ebc_bypass; slider_automate(128); ebc_recalc();
  );
  gfx_set(ebc_pn_r * 0.7, ebc_pn_g * 0.7, ebc_pn_b * 0.7, 1);
  gfx_rect(_bp_x, _bp_y, _bp_w, _bp_h);
  gfx_set(ebc_td_r, ebc_td_g, ebc_td_b, _bp_hov ? 0.9 : 0.55);
  gfx_rect(_bp_x, _bp_y, _bp_w, _bp_h, 0);
  ebc_bypass ? gfx_set(0.95, 0.60, 0.20, 0.95) : gfx_set(0.22, 0.24, 0.28, 1);
  gfx_circle(_bp_x + floor(13 * sc), _bp_y + _bp_h * 0.5, floor(5 * sc), 1, 1);
  gfx_setfont(5, "Arial", max(7, floor(9 * sc)), 'b');
  gfx_set(ebc_tx_r, ebc_tx_g, ebc_tx_b, ebc_bypass ? 1 : 0.75);
  gfx_measurestr("BYPASS", _tw, _th);
  gfx_x = _bp_x + _bp_w * 0.55 - _tw * 0.5; gfx_y = _bp_y + (_bp_h - _th) * 0.5;
  gfx_drawstr("BYPASS");
  _bp_hov ? ebc_hov = 1;
) : (
  // bypassed-but-hidden tell: a small amber LED in the corner so a muted comp
  // is never invisible in a short strip
  ebc_bypass ? ( gfx_set(0.95, 0.60, 0.20, 0.9); gfx_circle(W - floor(7 * ret), H - floor(7 * ret), floor(3 * ret), 1, 1); );
);

// brand corner (floating only)
show_chrome ? (
  gfx_setfont(4, "Arial", max(8, floor(9 * sc)), 'b');
  gfx_set(ebc_td_r, ebc_td_g, ebc_td_b, 0.6);
  gfx_x = W - floor(44 * sc); gfx_y = H - floor(22 * sc);
  gfx_drawstr("EON");
);

// theme dropdown paints on top of everything
show_chrome ? rkth_overlay_draw();

// ── End of frame: embed click-through re-arm + input latches ────────────────
micro && !ebc_hov ? gfx_ext_flags |= 0x200;
prev_LMB = LMB;
prev_RMB = RMB;
mouse_wheel = 0;
