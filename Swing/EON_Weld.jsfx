desc:EON Weld Bus Compressor
//tags: EON ReaKit bus compressor glue weld parallel smash
options:gfx_hz=60 gfx_idle no_meter gmem=Swing_Media_Transfer
// EON Studios — EON Weld  (shipped as EON 76 until 2026-08-24)
// Circuit-modelled console bus compressor on the shared rk_compressor engine
// (dummy-VCA feedback loop — the same engine as Swing's master comp; model,
// calibration and schematic provenance live in .dev_weld/). Two hats, one
// plugin: serial glue on the multi-out drum submix, and the smasher on the
// EON Smash Return (parallel compression; the return fader is the blend).
//
// The face is Weld's OWN: G-series knobs, cream GR meter, and ONE fixed
// vintage-console blue-grey — no light/dark switch (user decision
// 2026-08-26; the panel is the product, like the hardware). slider11
// survives as ebc_dark only so old saves still deserialize; it is parked
// dead and nothing reads it. Weld also does NOT follow One Rack themes.
//
// Smash-return link: when the strip-sync companion pushes a registry slot into
// slider9 (Link Slot), this instance publishes a param echo + GR onto its
// GS_BC_LINK row and consumes knob edits from the return viewer's deck. The
// drum-bus instance stays at slot -1 and never touches the band. All link I/O
// runs in @block, so it works with this UI closed.

slider1:ebc_thresh=-12<-40,0,0.1>-Threshold (dB)
slider2:ebc_ratio=4<1,20,0.1>-Ratio
slider3:ebc_attack=10<0.1,100,0.1>-Attack (ms)
slider4:ebc_release=200<100,1200,1>-Release (ms)
slider5:ebc_knee=6<0,12,0.5>-Knee (Diode Trim, 6 = stock part)
slider6:ebc_makeup=0<-12,12,0.1>-Makeup (dB)
slider7:ebc_mix=1<0,1,0.01>-Mix
slider8:ebc_bypass=0<0,1,1>-Bypass
slider9:ebc_link_slot=-1<-1,63,1>-Link Slot (internal; Lua-pushed)
slider10:ebc_auto=0<0,1,1>-Auto Release
slider11:ebc_dark=0<0,1,1>-Unused (parked; was panel wardrobe)
slider12:ebc_vu_face=0<0,19,1>-Meter Face

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import libs/rk_compressor.jsfx-inc
import libs/knobs_kbsg.jsfx-inc
import libs/rk_vu.jsfx-inc

@init
ext_noinit = 1.0;
gfx_ext_retina == 0 ? gfx_ext_retina = 1;
// Embed support — bit 0x100 MUST be set in @init (REAPER 7.45+).
// 0x400 = suppress REAPER's hover tooltip over the MCP embed (7.79+).
gfx_ext_flags |= 0x100 | 0x400;

M_LN10_20 = 8.68588963806503655302257837833210;  // 20/ln(10)
ebc_eps = pow(10, -9);

// ── Smash-return viewer link band ──────────────────────────────────────────
// Row per registry slot. MUST match EON_FX_Return_View.jsfx. Declared in
// .refs/swing_gmem_bridge_protocol.md (26170000-26171535, 64 slots x 24).
//   +0 heartbeat (bumped per @block) · +1..8 param echo (thresh, ratio, attack,
//   release, knee, makeup, mix, bypass) · +9 GR dB · +10 auto-release echo ·
//   +16 cmd_seq · +17 cmd_param (1..8 echo order; 9 = auto) · +18 cmd_val.
//   Seq bumped LAST by the writer.
GS_BC_LINK_BASE   = 26170000;
GS_BC_LINK_STRIDE = 24;
BC_OFF_HB    = 0;
BC_OFF_ECHO  = 1;
BC_OFF_GR    = 9;
BC_OFF_SEQ   = 16;
BC_OFF_PARAM = 17;
BC_OFF_VAL   = 18;

// rk_vu claims no memory and writes to no fixed address, so allocations start
// at 0. (vu_kbsg squatted on 0..437, which is why this used to be 440.)
freemem = 0;
freemem = cmp_init(freemem);          // engine state + tables
KS = 16;                              // knobs_kbsg per-knob state stride
ebc_km = freemem; freemem += 8 * KS;  // 6 face knobs + bypass + spare
ebc_km_e = freemem; freemem += 8 * KS; // embed surface's own drag anchors

gr_vu.rk_vu_init_gr();                // GR meter: fed linear gain, 1.0 = none

// NaN canonicalization at the WRAPPER (external audit 2026-08-25): the
// engine heals its own copies in cmp_recalc, but a poisoned ebc_* slider
// keeps feeding the UI text, the serializer and the link echo — and the
// link mailbox is an open ingress (a foreign gmem writer's NaN passes the
// min/max clamps below, which are argument-order-dependent on NaN in
// EEL2). Heal the sliders THEMSELVES to their defaults, then clamp-copy.
// Runs atop every ebc_recalc, so @slider, srate change and link consume
// are all covered.
function ebc_sanitize() (
  ebc_thresh    != ebc_thresh    ? ebc_thresh    = -12;
  ebc_ratio     != ebc_ratio     ? ebc_ratio     = 4;
  ebc_attack    != ebc_attack    ? ebc_attack    = 10;
  ebc_release   != ebc_release   ? ebc_release   = 200;
  ebc_knee      != ebc_knee      ? ebc_knee      = 6;
  ebc_makeup    != ebc_makeup    ? ebc_makeup    = 0;
  ebc_mix       != ebc_mix       ? ebc_mix       = 1;
  ebc_bypass    != ebc_bypass    ? ebc_bypass    = 0;
  ebc_auto      != ebc_auto      ? ebc_auto      = 0;
  ebc_dark      != ebc_dark      ? ebc_dark      = 0;
  ebc_link_slot != ebc_link_slot ? ebc_link_slot = -1;
  // RANGE canonicalization on the sliders THEMSELVES (2026-08-28): the raw
  // ebc_* values feed the value windows, the link echo and serialization,
  // and a finite out-of-range value can really arrive — EON_76 shipped
  // release as 10..1000, so old chunks restore values the engine clamps
  // but the face kept displaying ("50ms" printed, 100 ms running, 50
  // echoed to the deck and re-saved forever). Toggles snap to exact 0/1:
  // the engine tested >= 0.5 while the lamps tested truthiness, so an
  // envelope parked at 0.3 lit AUTO while running the manual release.
  // In-range values pass through bit-identical, so the @gfx writers
  // never fight these assignments.
  ebc_thresh    = max(-40, min(0, ebc_thresh));
  ebc_ratio     = max(1, min(20, ebc_ratio));
  ebc_attack    = max(0.1, min(100, ebc_attack));
  ebc_release   = max(100, min(1200, ebc_release));
  ebc_knee      = max(0, min(12, ebc_knee));
  ebc_makeup    = max(-12, min(12, ebc_makeup));
  ebc_mix       = max(0, min(1, ebc_mix));
  ebc_bypass    = ebc_bypass >= 0.5 ? 1 : 0;
  ebc_auto      = ebc_auto >= 0.5 ? 1 : 0;
  ebc_link_slot = max(-1, min(63, ebc_link_slot | 0));
);

// Copy the slider params onto the engine globals (clamped — API writes can be
// out of range) . Call before cmp_recalc().
function ebc_params_to_engine() (
  cmp_thresh  = max(-40, min(0, ebc_thresh));
  cmp_ratio   = max(1, min(20, ebc_ratio));
  cmp_attack  = max(0.1, min(100, ebc_attack));
  cmp_release = max(100, min(1200, ebc_release));
  cmp_knee    = max(0, min(12, ebc_knee));
  cmp_makeup  = max(-12, min(12, ebc_makeup));
  cmp_mix     = max(0, min(1, ebc_mix));
  cmp_auto    = ebc_auto >= 0.5 ? 1 : 0;
);
function ebc_recalc() (
  ebc_sanitize(); ebc_params_to_engine(); cmp_recalc();
  ebc_bp_k = 1 - exp(-1 / (max(srate, 1) * 0.005));   // 5 ms bypass blend
);

// Needle position → GR dB for the readout. rk_vu's `pos` on a GR meter IS the
// reduction in dB the needle shows (0 = none; the movement runs in dB so its
// ballistic is true on a dB scale). Readout and needle are the same number.
function ebc_gr_db() ( -gr_vu.pos; );

// Recessed LED value window centred on cx: dark inset + tinted hairline border,
// #ebc_val drawn in the tint. Same visual grammar as the return-deck readouts.
function ebc_readout(cx, ry, rw, rh, tr, tg, tb) local(tw, th) (
  gfx_set(0, 0, 0, 0.50);
  gfx_rect(cx - rw * 0.5, ry, rw, rh);
  gfx_set(tr, tg, tb, 0.25);
  gfx_rect(cx - rw * 0.5, ry, rw, rh, 0);
  gfx_setfont(6, "Arial", max(8, floor(rh * 0.62)), 'b');
  gfx_measurestr(#ebc_val, tw, th);
  gfx_set(tr, tg, tb, 0.95);
  gfx_x = cx - tw * 0.5; gfx_y = ry + floor((rh - th) * 0.5);
  gfx_drawstr(#ebc_val);
);

// Ladder mark: detent dot on the ring + printed value at sweep position
// t (0..1 across the -130..+130 house arc). Caller sets font + #ebc_lad.
function ebc_ladt(cx, cy, rr, t) local(_a, _tw, _th) (
  _a = (t * 260 - 130) * $pi / 180;
  // dots follow the theme's dim text so they read on cream AND charcoal
  gfx_set(ebc_td_r, ebc_td_g, ebc_td_b, 0.75);
  gfx_circle(cx + sin(_a) * rr * 1.24, cy - cos(_a) * rr * 1.24, max(1, rr * 0.055), 1);
  gfx_measurestr(#ebc_lad, _tw, _th);
  gfx_x = cx + sin(_a) * rr * 1.56 - _tw * 0.5;
  gfx_y = cy - cos(_a) * rr * 1.56 - _th * 0.5;
  gfx_set(ebc_td_r, ebc_td_g, ebc_td_b, 0.95);
  gfx_drawstr(#ebc_lad);
);

// Console push button: dark well, grey cap, lamp at the left. Returns hover.
function ebc_btn(bx, by, bw, bh, lit) local(_hv) (
  _hv = mx >= bx && mx <= bx + bw && my >= by && my <= by + bh;
  // well + border derive from the live palette: charcoal face keeps the
  // deep console well, a cream theme gets a softer recess, never a hard
  // black picture-frame on a light panel
  gfx_set(ebc_bg_r * 0.30, ebc_bg_g * 0.30, ebc_bg_b * 0.33, 1);
  gfx_rect(bx, by, bw, bh);
  gfx_set(ebc_bg_r * 0.55, ebc_bg_g * 0.55, ebc_bg_b * 0.58, 1);
  gfx_rect(bx, by, bw, bh, 0);
  gfx_set(_hv ? 0.86 : 0.78, _hv ? 0.87 : 0.79, _hv ? 0.89 : 0.81, 1);
  gfx_rect(bx + floor(bw * 0.11), by + floor(bh * 0.14),
           bw - floor(bw * 0.22), bh - floor(bh * 0.28));
  gfx_set(0.48, 0.49, 0.52, 1);
  gfx_rect(bx + floor(bw * 0.11), by + floor(bh * 0.14),
           bw - floor(bw * 0.22), bh - floor(bh * 0.28), 0);
  lit ? gfx_set(0.34, 0.88, 0.48, 1) : gfx_set(0.20, 0.22, 0.24, 1);
  gfx_circle(bx - floor(8 * sc), by + bh * 0.5 - floor(2 * sc), floor(4 * sc), 1);
  gfx_set(ebc_bg_r * 0.45, ebc_bg_g * 0.45, ebc_bg_b * 0.48, 1);
  gfx_circle(bx - floor(8 * sc), by + bh * 0.5 - floor(2 * sc), floor(6 * sc), 0);
  _hv;
);

// Engraved hairline separator across the faceplate.
function ebc_sep(y) (
  gfx_set(0, 0, 0, 0.45);          gfx_rect(floor(24 * sc), y,     W - floor(48 * sc), 1);
  gfx_set(1, 1, 1, 0.05);          gfx_rect(floor(24 * sc), y + 1, W - floor(48 * sc), 1);
);

// Slotted rack-ear screw (same chrome as the return viewer).
function ebc_screw(cx, cy, r) (
  gfx_set(0.05, 0.05, 0.06, 1); gfx_circle(cx, cy, r, 1, 1);
  gfx_set(0.42, 0.44, 0.48, 1); gfx_circle(cx, cy, r * 0.7, 1, 1);
  gfx_set(0.12, 0.12, 0.14, 1);
  gfx_line(cx - r * 0.5, cy, cx + r * 0.5, cy);
);

// Seat coefficients once at load so the very first @block has a real engine no
// matter what the host does with @slider. Anvil follows the same discipline
// (EON_Anvil.jsfx:1548). ebc_rc_rq is the request flag consumed in @block.
ebc_rc_rq = 0;
ebc_recalc();

@slider
// Requests only. Host-side automation, preset recall and TrackFX_SetParam land
// here on whatever thread the host chose -- they must not derive coefficients
// there. Same argument, same shape as Anvil's @slider (EON_Anvil.jsfx:1563).
atomic_set(ebc_rc_rq, 1);

@block
// GUI -> engine bridge (root cause of "knobs change nothing audibly", proven
// live 2026-08-27 with a tone through the chain): the face writes ebc_* and
// calls slider_automate(), but REAPER does NOT fire @slider for plugin-
// initiated slider_automate -- only host-side writes do. So the engine copies
// (cmp_*) stayed at load-time values while the panel displayed the new ones;
// TrackFX_SetParam sweeps (headless batteries) always recalced, which is why
// the engine kept getting exonerated. Every @gfx write now raises this flag;
// consumed here on the audio thread, same discipline as the link mailbox.
//
// ⭐ THE CONSUME IS GET-then-CAS, matching Anvil's audited pattern
// (EON_Anvil.jsfx:1638). A plain read-clear has the classic hole: @gfx writes
// 1 between the read and the clear, and the request is lost -- and the whole
// point of this bridge is that a lost request means a silently-stale engine,
// which is exactly the bug fb25ecb was chasing. atomic_setifequal consumes
// the 1 exactly if it is still there; a write landing between the get and the
// CAS is consumed WITH this pass; a write landing after the CAS survives for
// the next block. Argument order is (dest, COMPARAND, NEWVALUE) -- if dest
// equals comparand, set dest to newvalue. Never swap those; a NO-OP consume
// leaves the flag sticky and runs cmp_recalc() every block forever.
atomic_get(ebc_rc_rq) > 0.5 ? (
  atomic_setifequal(ebc_rc_rq, 1, 0);
  ebc_recalc();
);
// Sample-rate change → coefficients (attack/release/GR-smoother are srate-derived).
srate != ebc_last_srate ? ( ebc_recalc(); ebc_last_srate = srate; );

// ── Smash-return link (slot >= 0 only; the drum-bus instance never binds) ──
// Slot change (including -1 -> slot) restarts seq adoption: the previous
// row's consumed seq means nothing on the new row, and a stale mailbox
// there must adopt, never fire (audit 2026-08-24).
ebc_link_slot != ebc_last_link_slot ? (
  ebc_cmd_inited = 0;
  ebc_last_link_slot = ebc_link_slot;
);
ebc_link_slot >= 0 ? (
  _bc_slot = max(0, min(63, ebc_link_slot | 0));   // 64 slots: 0..63; clamp API writes
  _bc_row = GS_BC_LINK_BASE + _bc_slot * GS_BC_LINK_STRIDE;
  // Consume one deck edit per block. Adopt (don't apply) the first seq seen —
  // gmem persists across plugin reloads, so a stale mailbox must not fire; a
  // virgin row's seq is 0 and never fires (same discipline as Swing's strip CMD).
  _bc_seq = gmem[_bc_row + BC_OFF_SEQ];
  // Ingress validation (external audit 2026-08-25): the mailbox is foreign
  // memory. A NaN seq reads as "different" every block (NaN != x is always
  // true) and would re-fire this path at block rate — skip the row outright
  // and let a healthy writer restore it. A finite seq with a NaN payload is
  // CONSUMED (else the same corrupt command retries forever) but its
  // payload is discarded — validated BEFORE any slider write or
  // slider_automate(), so corruption can never reach the automation lane.
  // (x != x is the suite's NaN test — EEL2's fuzzy compare fails on NaN,
  // so != fires; auditor-blessed in cmp_recalc, wiki 07 for the cousin
  // hazard.)
  _bc_seq != _bc_seq ? 0 :
  ebc_cmd_inited ? (
    _bc_seq != ebc_cmd_last && _bc_seq != 0 ? (
      _bc_pr = gmem[_bc_row + BC_OFF_PARAM];
      _bc_v  = gmem[_bc_row + BC_OFF_VAL];
      // Seqlock re-read (2026-08-28): the writer stores param, val, seq —
      // seq LAST — from another plugin's @gfx thread. If seq moved while
      // we read the payload, the pair may straddle two transactions
      // (worst case: new param with the previous command's value for one
      // block). Skip WITHOUT consuming — next block reads the settled
      // row and applies it once. A NaN re-read also lands here.
      gmem[_bc_row + BC_OFF_SEQ] != _bc_seq ? 0 : (
      ebc_cmd_last = _bc_seq;
      _bc_pr != _bc_pr || _bc_v != _bc_v ? 0 : (
        _bc_p = _bc_pr | 0;
        _bc_p == 1 ? ( ebc_thresh  = max(-40, min(0, _bc_v));    slider_automate(1); ) :
        _bc_p == 2 ? ( ebc_ratio   = max(1, min(20, _bc_v));     slider_automate(2); ) :
        _bc_p == 3 ? ( ebc_attack  = max(0.1, min(100, _bc_v));  slider_automate(4); ) :
        _bc_p == 4 ? ( ebc_release = max(100, min(1200, _bc_v)); slider_automate(8); ) :
        _bc_p == 5 ? ( ebc_knee    = max(0, min(12, _bc_v));     slider_automate(16); ) :
        _bc_p == 6 ? ( ebc_makeup  = max(-12, min(12, _bc_v));   slider_automate(32); ) :
        _bc_p == 7 ? ( ebc_mix     = max(0, min(1, _bc_v));      slider_automate(64); ) :
        _bc_p == 8 ? ( ebc_bypass  = _bc_v >= 0.5;               slider_automate(128); ) :
        _bc_p == 9 ? ( ebc_auto    = _bc_v >= 0.5;               slider_automate(512); );
        ebc_recalc();
      );
      );
    ) : ( ebc_cmd_last = _bc_seq; );
  ) : ( ebc_cmd_last = _bc_seq; ebc_cmd_inited = 1; );
  // Publish the echo the viewer deck draws from + a heartbeat it health-checks.
  gmem[_bc_row + BC_OFF_ECHO]     = ebc_thresh;
  gmem[_bc_row + BC_OFF_ECHO + 1] = ebc_ratio;
  gmem[_bc_row + BC_OFF_ECHO + 2] = ebc_attack;
  gmem[_bc_row + BC_OFF_ECHO + 3] = ebc_release;
  gmem[_bc_row + BC_OFF_ECHO + 4] = ebc_knee;
  gmem[_bc_row + BC_OFF_ECHO + 5] = ebc_makeup;
  gmem[_bc_row + BC_OFF_ECHO + 6] = ebc_mix;
  gmem[_bc_row + BC_OFF_ECHO + 7] = ebc_bypass;
  gmem[_bc_row + BC_OFF_GR]       = cmp_gr_db;
  gmem[_bc_row + BC_OFF_ECHO + 9] = ebc_auto;
  ebc_hb += 1;
  gmem[_bc_row + BC_OFF_HB] = ebc_hb;
);

@sample
// The engine ALWAYS ticks and the audio blends over 5 ms so the toggle
// cannot click. HONESTY NOTE (2026-08-28, corrected against the 82E26
// drawing T82026-71 read at zoom — the earlier "SW2 bypasses audio, the
// sidechain keeps tracking" claim was the exact INVERSION of the card):
// on the hardware the main VCA is permanently in circuit and the one
// IN/OUT pole (SW 2a) gates a J175 shunt that mutes the SIDECHAIN feed.
// OUT = the CV decays through the release network, the needle falls to
// zero, audio passes through the unity VCA. What ships here is a good
// DAW bypass — detector keeps listening, re-engage grabs instantly from
// live GR (delta vs hardware bounded by one attack interval). A faithful
// hardware IN would feed the detector SILENCE while out and let the
// needle relax through the real network — deliberate product decision,
// not taken as of this note.
cmp_process(spl0, spl1);
_bp_t = ebc_bypass ? 0 : 1;
// Seat the blend on the first processing pass (same discipline as the
// engine's makeup/mix smoothers): a fresh instance must start ON the
// serialized bypass state, not fade toward it from EEL's zero — without
// this, inserting/loading with the comp engaged played 5 ms of dry first.
ebc_bp_seated ? (
  ebc_bp_w += (_bp_t - ebc_bp_w) * ebc_bp_k;
  abs(ebc_bp_w - _bp_t) < ebc_eps ? ebc_bp_w = _bp_t;
) : (
  ebc_bp_w = _bp_t;
  ebc_bp_seated = 1;
);
spl0 += (cmp_outL - spl0) * ebc_bp_w;
spl1 += (cmp_outR - spl1) * ebc_bp_w;
// Needle follows the engine's cached LINEAR gain (1.0 = no reduction) —
// @sample-safe (pure mult/add in the vu lib). Live in bypass too — which
// the HARDWARE needle is NOT (see the honesty note above: OUT mutes the
// sidechain, so the real meter decays to zero). Ours tracks the
// always-ticking detector instead.
gr_vu.rk_vu_sample_gr(cmp_last_lin);

@gfx 420 900
// ⚠️ @gfx sets the EMBED ASPECT (house rule: portrait = tall MCP strip, the
// Drum Strip/1175 trick — 420x900 ≈ Drum Strip's 300x700 ratio, so the two
// strips sit at matching heights in the mixer). The floating layout stretches
// its section gaps to fill whatever height the window actually has.
// (Budget 329 = 39 + 76 + 150 + 52 + 12 since the G-series redesign: label
// above, ladder ring around, value window below each knob.)
// ── Frame globals (knobs_kbsg caller contract) ──────────────────────────────
micro = gfx_ext_flags & 1;
gfx_getchar();
ret = max(1, gfx_ext_retina);
W = gfx_w; H = gfx_h;
sc = micro ? ret : max(0.7, min(W / 420, H / 560));
// Floating vertical stretch — EXACT-FILL: distribute the remaining window
// height into the section gaps so the stack always lands just above the brand
// row (no dead bottom at any window size; element sizes stay on sc). Solved
// from: brand_row = vu_bot + 244*sc*vg + kr(30sc) + bypass(24sc), where 244 =
// the design gap budget (39+60+105+28+12). Computed after _vu_bot below.
_vg = 1;
mx = mouse_x; my = mouse_y;
LMB = mouse_cap & 1;
// ⭐⭐ PER-SURFACE PRESS LATCHES. The FX window and the MCP embed each run
// @gfx, and prev_LMB was ONE shared variable. REAPER hands an unhovered embed
// a mouse_cap of 0, so that pass wrote prev_LMB = 0 while the button was still
// physically held -- and the next floating pass then saw LMB=1 with prev=0 and
// manufactured a SECOND press edge out of one physical click. An even number of
// toggles cancels (IN looks dead) and a re-fired edge re-anchors a knob drag
// every time it lands (knobs look frozen). One cause, both symptoms.
// ⛔ Do NOT re-add a cross-surface "gesture owner" on top of this (64697de,
// d4cf11f). Both arbitrated on a bounds test that the embed answers with a
// PARKED pointer, so both ended up muting whichever surface lost the race --
// which is how the buttons died. Per-surface state is the whole fix.
lmb_down = LMB && !(micro ? ebc_plmb_e : ebc_plmb_w);
// Face sheet open (rk_vu_picker, called last): widgets drawn before it must
// not see this click. Stash the press edge; the picker call restores it.
_ebc_pk_lmb = lmb_down; !micro && gr_vu.pk_open ? lmb_down = 0;
RMB = mouse_cap & 2;
rmb_down = RMB && !(micro ? ebc_prmb_e : ebc_prmb_w);
CTRL  = mouse_cap & 4;
SHIFT = mouse_cap & 8;
dt = min(time_precise() - ebc_lt, 0.05); ebc_lt = time_precise();
hv_speed = 11;
frame_wheel = mouse_wheel / 120;
tau = 2 * $pi;
// ⭐⭐ CLEAR 0x200 UNCONDITIONALLY -- house pattern, EON_Drum_Strip:1590 and
// Swing_ReaKit:5026 both do it this way and neither has ever gone deaf.
// gfx_ext_flags is ONE per-instance variable shared by BOTH @gfx passes. The
// re-arm below (micro && !ebc_hov) sets 0x200 = pass-the-mouse-through on every
// embed frame that hovers nothing -- and with the clear gated on `micro`, the
// FLOATING window's pass never undid it. One unhovered MCP frame therefore put
// the whole instance into click-through and LATCHED it there: no mouse => no
// hover => re-armed again next frame, forever. Both surfaces went stone dead --
// no hover highlight, no knob drag, no IN/AUTO. Clearing on every frame breaks
// the latch; the re-arm stays micro-gated so the strip still passes dead-space
// clicks to the track panel. (EEL2 has no unary ~, so clear via |= then -=.)
gfx_ext_flags = (gfx_ext_flags | 0x200) - 0x200;
// Embedded wheel events arrive with a STALE/zero mouse position, so every
// hover test misses and the wheel does nothing. Remember the cursor on normal
// frames, reuse it on wheel frames (Drum Strip's user-verified fix).
micro ? (
  frame_wheel == 0 ? ( ebc_hmx = mx; ebc_hmy = my; )
                   : ( mx = ebc_hmx; my = ebc_hmy; );
);

// ── The face, two flavours ── same geometry, same knobs, one lamp switch
// THE face (user-decided 2026-08-26, wardrobe dropped same day): the
// vintage console centre-section blue-grey. One panel, one identity --
// like the hardware. slider11 (ebc_dark) is parked-dead so saved
// projects keep their serialization shape; it changes nothing.
ebc_bg_r = 0.355; ebc_bg_g = 0.385; ebc_bg_b = 0.425;   // blue-grey
ebc_pn_r = 0.290; ebc_pn_g = 0.315; ebc_pn_b = 0.350;
ebc_tx_r = 0.940; ebc_tx_g = 0.950; ebc_tx_b = 0.960;
ebc_td_r = 0.780; ebc_td_g = 0.800; ebc_td_b = 0.840;
ebc_ac_r = 0.905; ebc_ac_g = 0.915; ebc_ac_b = 0.940;   // LED-window tint
sk_kp = 21;                                             // G-series knob, always
// Cream dial KEPT (user 2026-08-26: "revert the vu meter change") --
// the surround/frame takes the panel colour via zm_frame_*, the plate
// stays the classic cream face on both panel flavours.
// (rk_vu theme 0 = Cream; the bezel is blended into the panel at draw time)

// ── Faceplate ────────────────────────────────────────────────────────────────
gfx_set(ebc_bg_r, ebc_bg_g, ebc_bg_b, 1); gfx_rect(0, 0, W, H);
// (top-strip tint removed 2026-08-26 -- the panel is ONE flat colour;
// the shaded band read as a mismatched box around the meter)

show_chrome = !micro && H >= floor(96 * ret);
show_chrome ? (
  gfx_setfont(3, "Arial", max(14, floor(26 * sc)), 'b');
  gfx_set(ebc_tx_r, ebc_tx_g, ebc_tx_b, 1);
  gfx_x = floor(16 * sc); gfx_y = floor(5 * sc);
  gfx_drawstr("EON WELD");
  gfx_setfont(4, "Arial", max(10, floor(13 * sc)));
  gfx_set(ebc_td_r, ebc_td_g, ebc_td_b, 0.9);
  gfx_drawstr("  BUS COMPRESSOR");
  ebc_screw(floor(10 * sc),     floor(11 * sc),     floor(4 * sc));
  ebc_screw(W - floor(10 * sc), floor(11 * sc),     floor(4 * sc));
  ebc_screw(floor(10 * sc),     H - floor(11 * sc), floor(4 * sc));
  ebc_screw(W - floor(10 * sc), H - floor(11 * sc), floor(4 * sc));
);

// ── Geometry ─────────────────────────────────────────────────────────────────
// Floating = fixed rack stack (VU · GR window · sep · 2 knob rows · sep ·
// bypass). Embedded = BOTTOM-UP budget: the knob grid anchors to the floor,
// labels/bypass appear as height allows, and the VU takes whatever remains up
// top (hidden when there is no honest room for a needle).
top = show_chrome ? floor(32 * sc) : floor(2 * sc);
_vu_cx = W * 0.5;
_grdb = ebc_gr_db();
_kp = W / 3;
micro ? (
  // VU FIRST — the needle is the unit's face and always shows; the GR window
  // rides under it when there's slack; the knobs adapt to what remains:
  // a 3x2 grid when tall, a single row of six minis when short (hover shows
  // that knob's value — six always-on values collide at this pitch).
  _vu_show = 1;
  _vu_r  = max(24, floor(min(W / 2.8, H * 0.22)));
  _vu_cy = top + floor(2 * ret) + _vu_r * 1.4;
  _vu_bot = _vu_cy + _vu_r * 0.3;
  // Labeled knob GRID under the meter (Drum Strip's embed grammar: label above,
  // value below): 3 columns when the strip is wide, 2 when narrow; the GR
  // window only when it doesn't starve the grid rows.
  _kcols = W >= floor(150 * ret) ? 3 : 2;
  _krows = 6 / _kcols;
  _bp_show = H >= floor(330 * ret);
  _gr_show = (H - _vu_bot) >= floor(28 * ret) + _krows * floor(40 * ret);
  _kcur = _vu_bot + (_gr_show ? floor(28 * ret) : floor(4 * ret));
  _cellh = (H - _kcur - (_bp_show ? floor(32 * ret) : floor(2 * ret))) / _krows;
  _kr = max(7, floor(min(W / _kcols * 0.30, (_cellh - floor(20 * ret)) * 0.5)));
  _kr = min(_kr, floor(20 * ret));
  _val_show = _cellh >= _kr * 2 + floor(26 * ret);
  _lb_show = 1;
  ebc_sep1 = -1; ebc_sep2 = -1;
) : (
  ebc_krow = 0;
  _vu_show = 1; _gr_show = 1; _lb_show = 1; _bp_show = 1;
  _vu_r  = floor(96 * sc);
  _vu_cy = top + floor(8 * sc) + _vu_r * 1.4;
  _vu_bot = _vu_cy + _vu_r * 0.3;
  _kr  = floor(30 * sc);
  _vg = max(0.85, min(2.75, (H - floor(112 * sc) - _vu_bot) / (329 * sc)));
  ebc_sep1 = _vu_bot + floor(39 * sc * _vg);
  _ky1 = ebc_sep1 + floor(76 * sc * _vg);
  _ky2 = _ky1 + floor(150 * sc * _vg);
  ebc_sep2 = _ky2 + _kr + floor(52 * sc * _vg);
);

// ── GR needle (house VU, GR mode) ───────────────────────────────────────────
_vu_show ? (
  rk_vu_theme(ebc_vu_face);                                   // the face picked on the cover; Cream by default
  rk_vu_pal_rgb(2, ebc_bg_r, ebc_bg_g, ebc_bg_b);             // bezel blends into the panel
  gr_vu.rk_vu_draw_at(_vu_cx, _vu_cy, _vu_r, 1, -1, "GR");    // same box the old call used
);
_gr_show ? (
  sprintf(#ebc_val, "%.1f dB GR", _grdb);
  ebc_readout(_vu_cx, _vu_bot + (micro ? floor(4 * ret) : floor(9 * sc)),
              floor(min(110 * sc, W - 20)), floor(18 * sc),
              0.82, 0.68, 0.40);   // amber — semantic, stays native
);
ebc_sep1 >= 0 ? ebc_sep(ebc_sep1);

// ── Knobs: THR RAT ATK / REL MKP MIX ────────────────────────────────────────
// Interact in real units; every write pairs slider_automate(2^(N-1)) AND
// raises ebc_rc_rq -- @block runs the recalc on the audio thread. ⛔Do not
// lean on slider_automate for this: REAPER never fires @slider for plugin-
// initiated slider_automate, so without the flag the engine copies go stale
// while the face displays the new values (root cause, proven 2026-08-27).
// Floating: LED value window ABOVE each knob (clear of the knob arc), engraved
// label below. Embedded: plain bright value text, short labels when tall.
ebc_hov = 0;

_ki = 0;
loop(6,
  micro ? (
    _kcx = W / _kcols * (_ki % _kcols) + W / (2 * _kcols);
    _kcy = _kcur + _cellh * ((_ki / _kcols) | 0) + floor(10 * ret) + _kr;
  ) : (
    _kcx = _kp * (_ki % 3) + _kp * 0.5;
    _kcy = _ki < 3 ? _ky1 : _ky2;
  );
  _km  = (micro ? ebc_km_e : ebc_km) + _ki * KS;   // per-surface drag anchor
  _ki == 0 ? (
    _nv = ssl_knob_interact(_km, _kcx, _kcy, _kr, ebc_thresh, -40, 0, -12, 0);
    _nv != ebc_thresh ? ( ebc_thresh = _nv; slider_automate(1); atomic_set(ebc_rc_rq, 1); );
    _dv = ebc_thresh; _dmin = -40; _dmax = 0; _dsym = 0;
    strcpy(#ebc_lbl, "THRESHOLD"); sprintf(#ebc_val, "%.1fdB", ebc_thresh);
  ) :
  _ki == 1 ? (
    // LOG travel: the ladder (2/4/10/20) spreads across the sweep the way
    // the rotary switch spaces its positions, instead of crowding the
    // first fifth of a linear arc. Interact + draw both run in ln-space;
    // only the value window speaks real units.
    _lv = log(max(1, ebc_ratio));
    _nv = ssl_knob_interact(_km, _kcx, _kcy, _kr, _lv, 0, 2.99573227355, 1.38629436112, 0);
    _nv != _lv ? ( ebc_ratio = exp(_nv); slider_automate(2); atomic_set(ebc_rc_rq, 1); );
    _dv = _nv; _dmin = 0; _dmax = 2.99573227355; _dsym = 0;
    strcpy(#ebc_lbl, "RATIO");
    ebc_ratio >= 20 ? strcpy(#ebc_val, "LIM") : sprintf(#ebc_val, "%.1f:1", ebc_ratio);
  ) :
  _ki == 2 ? (
    _lv = log(max(0.1, ebc_attack));
    _nv = ssl_knob_interact(_km, _kcx, _kcy, _kr, _lv, -2.30258509299, 4.60517018599, 2.30258509299, 0);
    _nv != _lv ? ( ebc_attack = exp(_nv); slider_automate(4); atomic_set(ebc_rc_rq, 1); );
    _dv = _nv; _dmin = -2.30258509299; _dmax = 4.60517018599; _dsym = 0;
    strcpy(#ebc_lbl, "ATTACK"); sprintf(#ebc_val, "%.1fms", ebc_attack);
  ) :
  _ki == 3 ? (
    // 100..1200 ms IS the hardware switch's span (.1 to 1.2 s) — the
    // ladder fills the whole arc, nothing faster exists on the card
    _lv = log(max(100, ebc_release));
    _nv = ssl_knob_interact(_km, _kcx, _kcy, _kr, _lv, 4.60517018599, 7.09007683578, 5.29831736655, 0);
    _nv != _lv ? ( ebc_release = exp(_nv); slider_automate(8); atomic_set(ebc_rc_rq, 1); );
    _dv = _nv; _dmin = 4.60517018599; _dmax = 7.09007683578; _dsym = 0;
    strcpy(#ebc_lbl, "RELEASE");
    ebc_auto ? strcpy(#ebc_val, "AUTO") : sprintf(#ebc_val, "%.0fms", ebc_release);
  ) :
  _ki == 4 ? (
    _nv = ssl_knob_interact(_km, _kcx, _kcy, _kr, ebc_makeup, -12, 12, 0, 0);
    _nv != ebc_makeup ? ( ebc_makeup = _nv; slider_automate(32); atomic_set(ebc_rc_rq, 1); );
    _dv = ebc_makeup; _dmin = -12; _dmax = 12; _dsym = 1;
    strcpy(#ebc_lbl, "MAKEUP"); sprintf(#ebc_val, "%+.1fdB", ebc_makeup);
  ) : (
    _nv = ssl_knob_interact(_km, _kcx, _kcy, _kr, ebc_mix, 0, 1, 1, 0);
    _nv != ebc_mix ? ( ebc_mix = _nv; slider_automate(64); atomic_set(ebc_rc_rq, 1); );
    _dv = ebc_mix; _dmin = 0; _dmax = 1; _dsym = 0;
    strcpy(#ebc_lbl, "MIX"); sprintf(#ebc_val, "%.0f%%", ebc_mix * 100);
  );
  // Cap colours, G-series grammar: white THR, green RATIO, blue timing
  // pair, red MAKE-UP, magenta MIX (the EON addition, deliberately
  // off-ladder).
  _ki == 0 ? ( sk_kbr = 0.87; sk_kbg = 0.88; sk_kbb = 0.90; )
  : _ki == 1 ? ( sk_kbr = 0.18; sk_kbg = 0.62; sk_kbb = 0.34; )
  : _ki <= 3 ? ( sk_kbr = 0.20; sk_kbg = 0.45; sk_kbb = 0.76; )
  : _ki == 4 ? ( sk_kbr = 0.81; sk_kbg = 0.27; sk_kbb = 0.22; )
             : ( sk_kbr = 0.76; sk_kbg = 0.26; sk_kbb = 0.56; );
  rk_knob_draw(sk_kp, _kcx, _kcy, _kr, _dv, _dmin, _dmax, _dsym, _km[0],
               sk_kbr, sk_kbg, sk_kbb, 0, ebc_bg_r, ebc_bg_g, ebc_bg_b);
  // Printed ladders at the real hardware parts (floating face only; the
  // log knobs' t-positions are ln-mapped, so the detents spread evenly)
  !micro ? (
    // the full dot ring first (13 minors, hardware grammar), then the
    // printed majors land on top of their own positions
    _di = 0;
    loop(13,
      _la = (_di / 12 * 260 - 130) * $pi / 180;
      gfx_set(ebc_td_r, ebc_td_g, ebc_td_b, 0.5);
      gfx_circle(_kcx + sin(_la) * _kr * 1.24, _kcy - cos(_la) * _kr * 1.24,
                 max(1, _kr * 0.038), 1);
      _di += 1;
    );
    gfx_setfont(5, "Arial", max(7, floor(8 * sc)), 'b');
    _ki == 0 ? (
      strcpy(#ebc_lad, "-40"); ebc_ladt(_kcx, _kcy, _kr, 0);
      strcpy(#ebc_lad, "-30"); ebc_ladt(_kcx, _kcy, _kr, 0.25);
      strcpy(#ebc_lad, "-20"); ebc_ladt(_kcx, _kcy, _kr, 0.5);
      strcpy(#ebc_lad, "-10"); ebc_ladt(_kcx, _kcy, _kr, 0.75);
      strcpy(#ebc_lad, "0");   ebc_ladt(_kcx, _kcy, _kr, 1);
    ) :
    _ki == 1 ? (
      strcpy(#ebc_lad, "1");  ebc_ladt(_kcx, _kcy, _kr, 0);
      strcpy(#ebc_lad, "2");  ebc_ladt(_kcx, _kcy, _kr, 0.2314);
      strcpy(#ebc_lad, "4");  ebc_ladt(_kcx, _kcy, _kr, 0.4628);
      strcpy(#ebc_lad, "10"); ebc_ladt(_kcx, _kcy, _kr, 0.7686);
      strcpy(#ebc_lad, "20"); ebc_ladt(_kcx, _kcy, _kr, 1);
    ) :
    _ki == 2 ? (
      // Positions on the ACTUAL 0.1..100 ms ln travel — the six hardware
      // parts at their true spots, travel end printed like RATIO's "20"
      // (the old list used a 0.1..30 span: the pointer at "10" really
      // meant 26.4 ms — external audit 2026-08-25).
      strcpy(#ebc_lad, ".1");  ebc_ladt(_kcx, _kcy, _kr, 0);
      strcpy(#ebc_lad, ".3");  ebc_ladt(_kcx, _kcy, _kr, 0.15904);
      strcpy(#ebc_lad, "1");   ebc_ladt(_kcx, _kcy, _kr, 0.33333);
      strcpy(#ebc_lad, "3");   ebc_ladt(_kcx, _kcy, _kr, 0.49237);
      strcpy(#ebc_lad, "10");  ebc_ladt(_kcx, _kcy, _kr, 0.66667);
      strcpy(#ebc_lad, "30");  ebc_ladt(_kcx, _kcy, _kr, 0.82571);
      strcpy(#ebc_lad, "100"); ebc_ladt(_kcx, _kcy, _kr, 1);
    ) :
    _ki == 3 ? (
      strcpy(#ebc_lad, ".1");  ebc_ladt(_kcx, _kcy, _kr, 0);
      strcpy(#ebc_lad, ".3");  ebc_ladt(_kcx, _kcy, _kr, 0.4421);
      strcpy(#ebc_lad, ".6");  ebc_ladt(_kcx, _kcy, _kr, 0.7211);
      strcpy(#ebc_lad, "1.2"); ebc_ladt(_kcx, _kcy, _kr, 1);
    ) :
    _ki == 4 ? (
      strcpy(#ebc_lad, "-12"); ebc_ladt(_kcx, _kcy, _kr, 0);
      strcpy(#ebc_lad, "0");   ebc_ladt(_kcx, _kcy, _kr, 0.5);
      strcpy(#ebc_lad, "+12"); ebc_ladt(_kcx, _kcy, _kr, 1);
    ) : (
      strcpy(#ebc_lad, "0");   ebc_ladt(_kcx, _kcy, _kr, 0);
      strcpy(#ebc_lad, "50");  ebc_ladt(_kcx, _kcy, _kr, 0.5);
      strcpy(#ebc_lad, "100"); ebc_ladt(_kcx, _kcy, _kr, 1);
    );
  );
  micro ? (
    // Drum Strip grid grammar: value BELOW the knob — always when the cell
    // affords it, hover-only when squeezed (kept clear of the next row's label).
    (_val_show || _km[6]) ? (
      gfx_setfont(6, "Arial", max(7, floor(8 * ret)), 'b');
      gfx_set(ebc_tx_r, ebc_tx_g, ebc_tx_b, 0.95);
      gfx_measurestr(#ebc_val, _tw, _th);
      gfx_x = max(floor(2 * ret), min(W - _tw - floor(2 * ret), _kcx - _tw * 0.5));
      gfx_y = _kcy + _kr + floor(2 * ret);
      gfx_drawstr(#ebc_val);
    );
  ) : (
    // LED value window BELOW the knob (render v2 grammar), clear of the
    // ladder ring's lowest marks
    ebc_readout(_kcx, _kcy + _kr + floor(24 * sc), floor(64 * sc), floor(16 * sc),
                ebc_ac_r, ebc_ac_g, ebc_ac_b);
  );
  micro ? (
    _ki == 0 ? strcpy(#ebc_lbl, "THR") : _ki == 1 ? strcpy(#ebc_lbl, "RAT") :
    _ki == 2 ? strcpy(#ebc_lbl, "ATK") : _ki == 3 ? strcpy(#ebc_lbl, "REL") :
    _ki == 4 ? strcpy(#ebc_lbl, "MKP") :            strcpy(#ebc_lbl, "MIX");
  );
  _lb_show ? (
    gfx_setfont(5, "Arial", max(9, floor((micro ? 8 * ret : 13 * sc))), 'b');
    gfx_set(ebc_tx_r, ebc_tx_g, ebc_tx_b, 0.95);
    gfx_measurestr(#ebc_lbl, _tw, _th);
    gfx_x = _kcx - _tw * 0.5;
    gfx_y = micro ? _kcy - _kr - floor(9 * ret) : _kcy - _kr - floor(34 * sc);
    gfx_drawstr(#ebc_lbl);
  );
  _km[6] ? ebc_hov = 1;
  _ki += 1;
);

// ── IN / AUTO console buttons (hidden in short embeds) ──────────────────
// Console grammar: IN lit = the compressor is in circuit (the panel speaks
// hardware; the host slider stays a BYPASS flag underneath). AUTO lit = the
// dual-RC programme-dependent release owns the recovery.
ebc_sep2 >= 0 ? ebc_sep(ebc_sep2);
_bp_show ? (
  _bp_w = floor(74 * sc); _bp_h = micro ? floor(34 * ret) : floor(46 * sc);
  _bp_gap = floor(34 * sc);
  _bp_x = W * 0.5 - _bp_w - _bp_gap * 0.5;
  _au_x = W * 0.5 + _bp_gap * 0.5;
  _bp_y = micro ? H - _bp_h - floor(4 * ret) : ebc_sep2 + floor(12 * sc * _vg);

  _bp_hov = ebc_btn(_bp_x, _bp_y, _bp_w, _bp_h, !ebc_bypass);
  _bp_hov && lmb_down ? (
    ebc_bypass = !ebc_bypass; slider_automate(128); atomic_set(ebc_rc_rq, 1);
  );
  gfx_setfont(5, "Arial", max(10, floor(15 * sc)), 'b');
  gfx_set(0.15, 0.15, 0.17, 1);
  gfx_measurestr("IN", _tw, _th);
  gfx_x = _bp_x + _bp_w * 0.5 - _tw * 0.5;
  gfx_y = _bp_y + (_bp_h - _th) * 0.5 - floor(2 * sc);
  gfx_drawstr("IN");
  !micro ? (
    gfx_setfont(5, "Arial", max(7, floor(8 * sc)), 'b');
    gfx_set(ebc_td_r, ebc_td_g, ebc_td_b, 0.85);
    gfx_measurestr("COMP", _tw, _th);
    gfx_x = _bp_x + _bp_w * 0.5 - _tw * 0.5; gfx_y = _bp_y + _bp_h + floor(4 * sc);
    gfx_drawstr("COMP");
  );
  _bp_hov ? ebc_hov = 1;

  _au_hov = ebc_btn(_au_x, _bp_y, _bp_w, _bp_h, ebc_auto);
  _au_hov && lmb_down ? (
    ebc_auto = !ebc_auto; slider_automate(512); atomic_set(ebc_rc_rq, 1);
  );
  gfx_setfont(5, "Arial", max(9, floor(14 * sc)), 'b');
  gfx_set(0.15, 0.15, 0.17, 1);
  gfx_measurestr("AUTO", _tw, _th);
  gfx_x = _au_x + _bp_w * 0.5 - _tw * 0.5;
  gfx_y = _bp_y + (_bp_h - _th) * 0.5 - floor(2 * sc);
  gfx_drawstr("AUTO");
  !micro ? (
    gfx_setfont(5, "Arial", max(7, floor(8 * sc)), 'b');
    gfx_set(ebc_td_r, ebc_td_g, ebc_td_b, 0.85);
    gfx_measurestr("RELEASE", _tw, _th);
    gfx_x = _au_x + _bp_w * 0.5 - _tw * 0.5; gfx_y = _bp_y + _bp_h + floor(4 * sc);
    gfx_drawstr("RELEASE");
  );
  _au_hov ? ebc_hov = 1;
) : (
  // bypassed-but-hidden tell: a small amber LED in the corner so a muted comp
  // is never invisible in a short strip (auto shows via the RELEASE value)
  ebc_bypass ? ( gfx_set(0.95, 0.60, 0.20, 0.9); gfx_circle(W - floor(7 * ret), H - floor(7 * ret), floor(3 * ret), 1, 1); );
);

// brand corner (floating only)
show_chrome ? (
  gfx_setfont(4, "Arial", max(8, floor(9 * sc)), 'b');
  gfx_set(ebc_td_r, ebc_td_g, ebc_td_b, 0.6);
  gfx_x = W - floor(44 * sc); gfx_y = H - floor(22 * sc);
  gfx_drawstr("EON");
);

// ── End of frame: embed click-through re-arm + input latches ────────────────
micro && !ebc_hov ? gfx_ext_flags |= 0x200;
micro ? ( ebc_plmb_e = LMB; ebc_prmb_e = RMB; )
      : ( ebc_plmb_w = LMB; ebc_prmb_w = RMB; );
// Consume-once wheel (2026-08-28): mouse_wheel is ONE per-instance
// accumulator shared by BOTH @gfx passes, and the old unconditional zero
// here let whichever pass painted first eat a wheel aimed at the other
// surface (wheel intermittently dead on the strip while the window was
// open). Now only a pass whose hover actually LANDED consumes it; an
// unconsumed wheel survives for the other surface's next pass, with a
// 100 ms TTL so a missed event cannot fire on a phantom hover later.
// ⚠️Residual, deliberate: a pass whose PARKED pointer (or the embed's
// remembered wheel coords above) sits on a knob still applies first —
// that apply exists in the lib today and curing it needs a measured
// answer about floating-window pointer semantics, not another theory
// (see the latch archaeology at the top of @gfx).
frame_wheel != 0 ? (
  ebc_hov ? ( mouse_wheel = 0; ebc_wht = 0; )
  : (
    ebc_wht == 0 ? ebc_wht = time_precise();
    time_precise() - ebc_wht > 0.1 ? ( mouse_wheel = 0; ebc_wht = 0; );
  );
) : ebc_wht = 0;

// ── Face picker on the meter's coil cover: a sheet of live miniatures of this
// same face. LAST in the frame (it may open over everything), floating only,
// and only when the meter was drawn this frame. The pick lives on a hidden
// slider so it persists with the project. ──
!micro && _vu_show ? (
  lmb_down = _ebc_pk_lmb;
  _ebc_pk = rk_vu_picker(_vu_cx - _vu_r * 1.3, _vu_cy - _vu_r * 1.4, _vu_r * 2.6, _vu_r * 1.7, ebc_vu_face);
  _ebc_pk >= 0 ? ( ebc_vu_face = _ebc_pk; slider_automate(2^11); );   // 2^11 = slider12
);
